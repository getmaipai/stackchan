{
 "name": "new-games",
 "build_dir": "~/esp/stackchan-rebuild/b99/firmware/build-bench",
 "soak_s": 60,
 "settle_s": 2,
 "heap_interval_s": 10,
 "tolerance_file": "host/tests/golden/tolerance.json",
 "checks": [
  {
   "name": "heap-idle-before",
   "tool": "self.bench.heap_info",
   "expect": {
    "ok": true
   }
  },
  {
   "name": "heap-during-hilo",
   "pre": [
    {
     "tool": "self.privacy.set",
     "args": {
      "quiet": 0
     }
    },
    {
     "tool": "self.audio.set_sound_policy",
     "args": {
      "enabled": false,
      "muted": true,
      "quiet_now": false
     }
    },
    {
     "tool": "self.game.start",
     "args": {
      "name": "hilo"
     }
    }
   ],
   "tool": "self.bench.heap_info",
   "expect": {
    "ok": true,
    "total_free": {
     "min": 24000
    },
    "largest_free": {
     "min": 16000
    }
   },
   "post": [
    {
     "tool": "self.game.bench_request_stop",
     "args": {}
    },
    {
     "tool": "self.privacy.set",
     "args": {
      "quiet": 1
     }
    }
   ],
   "wait": 30
  },
  {
   "name": "stop-hilo",
   "tool": "self.game.stop",
   "args": {},
   "expect": {
    "ok": true
   }
