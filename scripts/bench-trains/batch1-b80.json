{
 "name": "batch1-b80",
 "build_dir": "~/esp/stackchan-rebuild/b80/firmware/build-bench",
 "soak_s": 630,
 "settle_s": 2,
 "heap_interval_s": 20,
 "tolerance_file": "host/tests/golden/tolerance.json",
 "checks": [
  {
   "name": "privacy-silent",
   "tool": "self.privacy.get",
   "expect": {
    "muted": {
     "min": 1
    }
   }
  },
  {
   "name": "asset-use",
   "tool": "self.bench.asset_use",
   "expect": {
    "ok": true
   }
  },
  {
   "name": "heap-info",
   "tool": "self.bench.heap_info",
   "expect": {
    "ok": true
   }
  },
  {
   "name": "sound-info-volume0",
   "tool": "self.audio.sound_info",
   "expect": {
    "volume_now": {
     "max": 10
    }
   }
  },
  {
   "name": "game-refused-in-quiet",
   "tool": "self.game.start",
   "args": {
    "name": "connect4"
   },
   "expect": {
    "ok": false
   }
  },
  {
   "name": "screen-page-clock",
   "pre": [
    {
     "tool": "self.screen.set_brightness",
     "args": {
      "brightness": 100
     },
     "optional": true
    },
    {
     "tool": "self.page.show",
     "args": {
      "name": "clock"
     }
    }
   ],
   "snapshot": "screen-page-clock",
   "settle_s": 1.2,
   "post": [
    {
     "tool": "self.page.show",
     "args": {
      "name": "face"
     }
    }
   ]
  },
  {
   "name": "screen-page-games",
   "pre": [
    {
     "tool": "self.screen.set_brightness",
     "args": {
      "brightness": 100
     },
     "optional": true
    },
    {
     "tool": "self.page.show",
     "args": {
      "name": "games"
     }
    }
   ],
   "snapshot": "screen-page-games",
   "settle_s": 1.2,
   "post": [
    {
     "tool": "self.page.show",
     "args": {
      "name": "face"
     }
    }
   ]
  },
  {
   "name": "screen-page-actions",
   "pre": [
    {
     "tool": "self.screen.set_brightness",
     "args": {
      "brightness": 100
     },
     "optional": true
    },
    {
     "tool": "self.page.show",
     "args": {
      "name": "actions"
     }
    }
   ],
   "snapshot": "screen-page-actions",
   "settle_s": 1.2,
   "post": [
    {
     "tool": "self.page.show",
     "args": {
      "name": "face"
     }
    }
   ]
  },
  {
   "name": "screen-control-sheet",
   "pre": [
    {
     "tool": "self.screen.set_brightness",
     "args": {
      "brightness": 100
     },
     "optional": true
    },
    {
     "tool": "self.page.show",
     "args": {
      "name": "sheet"
     }
    }
   ],
   "snapshot": "screen-control-sheet",
   "settle_s": 1.2,
   "post": [
    {
     "tool": "self.page.show",
     "args": {
      "name": "face"
     }
    }
   ]
  },
  {
   "name": "screen-settings-general",
   "pre": [
    {
     "tool": "self.screen.set_brightness",
     "args": {
      "brightness": 100
     },
     "optional": true
    },
    {
     "tool": "self.page.show",
     "args": {
      "name": "settings"
     }
    }
   ],
   "snapshot": "screen-settings-general",
   "settle_s": 1.2,
   "post": [
    {
     "tool": "self.page.show",
     "args": {
      "name": "face"
     }
    }
   ]
  },
  {
   "name": "more-menu",
   "pre": [
    {
     "tool": "self.screen.set_brightness",
     "args": {
      "brightness": 100
     },
     "optional": true
    },
    {
     "tool": "self.page.show",
     "args": {
      "name": "more"
     }
    }
   ],
   "snapshot": "more-menu",
   "settle_s": 1.2,
   "post": [
    {
     "tool": "self.page.show",
     "args": {
      "name": "face"
     }
    }
   ]
  },
  {
   "name": "actions-migrated",
   "tool": "self.pages.get",
   "expect": {
    "ok": true
   }
  },
  {
   "name": "lock-status",
   "tool": "self.lock.status",
   "expect": {
    "ok": true
   }
  },
  {
   "name": "brain-status",
   "tool": "self.brain.status",
   "expect": {
    "ok": true,
    "route": "custom",
    "cl_keys": {
     "max": 0
    }
   }
  },
  {
   "name": "heap-idle-before-games",
   "tool": "self.bench.heap_info",
   "expect": {
    "ok": true
   }
  },
  {
   "name": "heap-during-rps",
   "pre": [
    {
     "tool": "self.privacy.set",
     "args": {
      "quiet": 0
     }
    },
    {
     "tool": "self.audio.set_sound_policy",
     "args": {
      "enabled": false,
      "muted": true,
      "quiet_now": false
     }
    },
    {
     "tool": "self.game.start",
     "args": {
      "name": "rps"
     }
    }
   ],
   "tool": "self.bench.heap_info",
   "expect": {
    "ok": true,
    "total_free": {
     "min": 24000
    },
    "largest_free": {
     "min": 16000
    }
   },
   "post": [
    {
     "tool": "self.game.bench_request_stop",
     "args": {}
    },
    {
     "tool": "self.privacy.set",
     "args": {
      "quiet": 1
     }
    }
   ],
   "wait": 30
  },
  {
   "name": "heap-during-whack",
   "pre": [
    {
     "tool": "self.privacy.set",
     "args": {
      "quiet": 0
     }
    },
    {
     "tool": "self.audio.set_sound_policy",
     "args": {
      "enabled": false,
      "muted": true,
      "quiet_now": false
     }
    },
    {
     "tool": "self.game.start",
     "args": {
      "name": "whack"
     }
    }
   ],
   "tool": "self.bench.heap_info",
   "expect": {
    "ok": true,
    "total_free": {
     "min": 24000
    },
    "largest_free": {
     "min": 16000
    }
   },
   "post": [
    {
     "tool": "self.game.bench_request_stop",
     "args": {}
    },
    {
     "tool": "self.privacy.set",
     "args": {
      "quiet": 1
     }
    }
   ],
   "wait": 30
  },
  {
   "name": "heap-during-tictactoe",
   "pre": [
    {
     "tool": "self.privacy.set",
     "args": {
      "quiet": 0
     }
    },
    {
     "tool": "self.audio.set_sound_policy",
     "args": {
      "enabled": false,
      "muted": true,
      "quiet_now": false
     }
    },
    {
     "tool": "self.game.start",
     "args": {
      "name": "tictactoe"
     }
    }
   ],
   "tool": "self.bench.heap_info",
   "expect": {
    "ok": true,
    "total_free": {
     "min": 24000
    },
    "largest_free": {
     "min": 16000
    }
   },
   "post": [
    {
     "tool": "self.game.bench_request_stop",
     "args": {}
    },
    {
     "tool": "self.privacy.set",
     "args": {
      "quiet": 1
     }
    }
   ],
   "wait": 30
  }
 ],
 "person": [
  "keypad pause: lock the unit, type 5 wrong six-digit codes on the keypad: the sixth key does nothing for 30 s; power-cycle during the pause: still paused",
  "orientation: start a dance, lay the unit on its side: movement limits apply within a few seconds",
  "pairing confirm (build-linkpsk image only): pair with a host, type the code, the unit shows Keep this host? with Keep and Cancel",
  "locked unit: lock it, then self.wifi.list_saved and self.link.pair answer that the unit is locked",
  "SF107: with a game running, self.game.bench_tilt roll_pm 500 answers valid true and 500; clear answers 0, 0; gently tip the unit right: the reading grows positive",
  "pack-screen heap: the heap-during-rps, -whack and -tictactoe checks read total_free and largest_free while the game runs (floors 24,000 and 16,000, the memory gate's lowest values); the train's console memory lines give the lowest internal free over the whole run: if rps pulls it under 24,000 tell the coordinator at once"
 ],
 "goldens_ref": "origin/ux/unproven-games",
 "_notes": "Batch 1 as the coordinator defined it: review fixes SF103 to SF106, quick-actions migration SF101 and the analog tilt SF107 on top of main. (SF89 to SF99 are already on main.) The linkpsk image is build-linkpsk of the same tree."
}
