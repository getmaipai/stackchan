{
 "name": "bench-proof",
 "build_dir": "~/esp/stackchan-rebuild/b70/firmware/build-bench",
 "soak_s": 630,
 "settle_s": 2,
 "heap_interval_s": 20,
 "tolerance_file": "host/tests/golden/tolerance.json",
 "checks": [
  {
   "name": "privacy-silent",
   "tool": "self.privacy.get",
   "expect": {
    "muted": {
     "min": 1
    }
   }
  },
  {
   "name": "asset-use",
   "tool": "self.bench.asset_use",
   "expect": {
    "ok": true
   }
  },
  {
   "name": "heap-info",
   "tool": "self.bench.heap_info",
   "expect": {
    "ok": true
   }
  },
  {
   "name": "sound-info-volume0",
   "tool": "self.audio.sound_info",
   "expect": {
    "volume_now": {
     "max": 10
    }
   }
  },
  {
   "name": "game-refused-in-quiet",
   "tool": "self.game.start",
   "args": {
    "name": "connect4"
   },
   "expect": {
    "ok": false
   }
  },
  {
