 ],
 "person": [
  "look at the screen while level 0, 1 and 2 are on: the board should be the old one, the gradient board with rimmed discs, and the same with soft shadows; say if any level flickers or tears when a disc falls",
  "the three results that matter are in result.json: box times (us_per_redraw per technique), frame gaps per look (gaps_ms), and the heap numbers before, in the game, and per look"
 ]
}
