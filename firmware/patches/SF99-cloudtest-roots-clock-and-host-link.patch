     int retry_count = 0;
     int challenge_rounds = 0;
     int retry_delay = 10;  // Initial retry delay in seconds
@@ -555,6 +559,13 @@ void Application::CheckNewVersion() {
         display->SetStatus(Lang::Strings::CHECKING_NEW_VERSION);
 
         if (maipai_hosted_blocked()) return;   // patch SF98: the hosted link was left while the check was retrying
