+const char* maipai_ws_read_ns()
+{
+    if (maipai_hosted_blocked()) return "websocket";
+    Settings cl(MAIPAI_WS_NS, false);
+    return cl.GetString("url").empty() ? "websocket" : MAIPAI_WS_NS;
