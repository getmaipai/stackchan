diff --git a/firmware/main/hal/maipai_cloudtest.h b/firmware/main/hal/maipai_cloudtest.h
--- a/firmware/main/hal/maipai_cloudtest.h
+++ b/firmware/main/hal/maipai_cloudtest.h
@@ -12,6 +12,10 @@
 // The vendor link's settings live in their own namespaces, so the paired host's address and token (namespace "websocket") are never overwritten.
 #define MAIPAI_WS_NS "cl_websocket"
 #define MAIPAI_MQTT_NS "cl_mqtt"
+// The websocket namespace to read for the next connect: the vendor's (cl_websocket) when the route is hosted and the vendor reply stored an address, else the paired host's (websocket).
+const char* maipai_ws_read_ns();
+// The calendar year the unit believes (1970 when its clock is unset: it gets the time from the host, and the vendor's certificate needs a real date).
+int maipai_clock_year();
 // A permanent strip on the screen: "Cloud brain test". Call once at start-up.
 void maipai_cloudtest_start_banner();
 // Only these generic tools may be called by the vendor service (and the brain route tools): the unit's privacy, lock, update, asset, game and pantry tools stay out of its reach.
@@ -19,6 +23,8 @@ bool maipai_cloudtest_tool_allowed(const char* name);
 #else
 #define MAIPAI_WS_NS "websocket"
 #define MAIPAI_MQTT_NS "mqtt"
+inline const char* maipai_ws_read_ns() { return "websocket"; }
+inline int maipai_clock_year() { return 0; }
 inline void maipai_cloudtest_start_banner() {}
 inline bool maipai_cloudtest_tool_allowed(const char*) { return true; }
 #endif
