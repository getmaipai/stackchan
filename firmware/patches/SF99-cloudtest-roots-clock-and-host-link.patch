+            vTaskDelay(pdMS_TO_TICKS(10000));
+        }
+        ESP_LOGI(TAG, "CLOUDTEST check starts: clock_year=%d", maipai_clock_year());
+#endif
         auto check = ota_->CheckVersion();
         if (!check) {
             retry_count++;
