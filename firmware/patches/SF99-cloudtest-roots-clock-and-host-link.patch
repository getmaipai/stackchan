+# The following five lines of boilerplate have to be in your project's
+# CMakeLists in this exact order for cmake to work correctly
+cmake_minimum_required(VERSION 3.16)
+
+# Keep compiler and linker arguments below Windows command-line limits.
+if(CMAKE_GENERATOR MATCHES "^Ninja")
+    set(CMAKE_NINJA_FORCE_RESPONSE_FILE TRUE CACHE INTERNAL "Use Ninja response files")
+endif()
+
+set(PROJECT_VER "1.6.2-maipai.1")
+add_definitions(-DFIRMWARE_VERSION=\"${PROJECT_VER}\")
+
+# Add this line to disable the specific warning
+add_compile_options(-Wno-missing-field-initializers)
+
+# MaiPai Wi-Fi portal (patch P02): see portal/portal.cmake.
+include("${CMAKE_CURRENT_LIST_DIR}/portal/portal.cmake")
+
+# MaiPai Wi-Fi portal (patch P02): see portal/portal.cmake.
+include("${CMAKE_CURRENT_LIST_DIR}/portal/portal.cmake")
+
+# MaiPai Wi-Fi portal (patch P02): see portal/portal.cmake.
+include("${CMAKE_CURRENT_LIST_DIR}/portal/portal.cmake")
+
+# MaiPai Wi-Fi portal (patch P02): see portal/portal.cmake.
+include("${CMAKE_CURRENT_LIST_DIR}/portal/portal.cmake")
+
+# Camera driver start-up race (patch FI02): see vendor_fixes/camera_vsync.cmake.
+include("${CMAKE_CURRENT_LIST_DIR}/vendor_fixes/camera_vsync.cmake")
+
+# Wi-Fi roaming, the scan-done step (patch RM02): see vendor_fixes/wifi_roam.cmake.
+include("${CMAKE_CURRENT_LIST_DIR}/vendor_fixes/wifi_roam.cmake")
+
+# Encrypted link, the TLS client (patch SF33): see vendor_fixes/link_psk.cmake.
+include("${CMAKE_CURRENT_LIST_DIR}/vendor_fixes/link_psk.cmake")
+
+# Auto-load a local sdkconfig overlay (git-ignored) when present. Lets
+# self-hosted / custom deployments pin CONFIG_STACKCHAN_SERVER_URL,
+# CONFIG_OTA_URL, etc. without touching committed defaults.
+# Manual equivalent: SDKCONFIG_DEFAULTS="sdkconfig.defaults;sdkconfig.defaults.local" idf.py build
+if(EXISTS "${CMAKE_CURRENT_SOURCE_DIR}/sdkconfig.defaults.local")
+    set(SDKCONFIG_DEFAULTS
+        "${CMAKE_CURRENT_SOURCE_DIR}/sdkconfig.defaults;${CMAKE_CURRENT_SOURCE_DIR}/sdkconfig.defaults.local"
+        CACHE STRING "ESP-IDF sdkconfig default files (auto-extended with local overlay)" FORCE)
+    message(STATUS "StackChan: detected sdkconfig.defaults.local, applying overlay")
+endif()
+
+# MaiPai core trim (patch S01): sdkconfig.core.defaults (WARN log level, no IPv6) rides on every build.
+if(EXISTS "${CMAKE_CURRENT_SOURCE_DIR}/sdkconfig.core.defaults")
+    if(NOT SDKCONFIG_DEFAULTS)
+        set(SDKCONFIG_DEFAULTS "${CMAKE_CURRENT_SOURCE_DIR}/sdkconfig.defaults")
+    endif()
+    if(NOT SDKCONFIG_DEFAULTS MATCHES "sdkconfig.core.defaults")
+        list(APPEND SDKCONFIG_DEFAULTS "${CMAKE_CURRENT_SOURCE_DIR}/sdkconfig.core.defaults")
+    endif()
+endif()
+
+# Patch SF99: an image kind may override the core trim with sdkconfig.late.defaults, read after it (only the cloud brain test kind has one: it adds the public roots).
+if(EXISTS "${CMAKE_CURRENT_SOURCE_DIR}/sdkconfig.late.defaults")
+    list(APPEND SDKCONFIG_DEFAULTS "${CMAKE_CURRENT_SOURCE_DIR}/sdkconfig.late.defaults")
+endif()
+
+# Travel with the private network (patch TN01): scripts/fw-tailnet.sh downloads the pinned client into a folder outside
+# this tree and fw-env.sh names it. Without the variable nothing about it is built.
+if(DEFINED ENV{MAIPAI_MICROLINK_DIR} AND NOT "$ENV{MAIPAI_MICROLINK_DIR}" STREQUAL "")
+    list(APPEND EXTRA_COMPONENT_DIRS "$ENV{MAIPAI_MICROLINK_DIR}/components")
+endif()
+
+# Travel with the private network (patch TN01): sdkconfig.tailnet.defaults rides on the home preset
+# (MAIPAI_PRESET=home), on MAIPAI_TAILNET=y and, for the core preset, whenever the client has been downloaded
+# (scripts/fw-tailnet.sh); MAIPAI_TAILNET=n leaves it out of any build.
+set(MAIPAI_WANT_TAILNET OFF)
+if("$ENV{MAIPAI_PRESET}" STREQUAL "home" OR "$ENV{MAIPAI_TAILNET}" STREQUAL "y"
+   OR (DEFINED ENV{MAIPAI_MICROLINK_DIR} AND NOT "$ENV{MAIPAI_MICROLINK_DIR}" STREQUAL ""))
+    set(MAIPAI_WANT_TAILNET ON)
+endif()
+if("$ENV{MAIPAI_TAILNET}" STREQUAL "n")
+    set(MAIPAI_WANT_TAILNET OFF)
+endif()
+# Patch TN07: asking for the client (MAIPAI_TAILNET=y or the home preset) while its folder is missing stops the build here,
+# so an image never silently lacks travel because a folder outside this tree was not there.
+if(MAIPAI_WANT_TAILNET AND ("$ENV{MAIPAI_TAILNET}" STREQUAL "y" OR "$ENV{MAIPAI_PRESET}" STREQUAL "home"))
+    if(NOT DEFINED ENV{MAIPAI_MICROLINK_DIR} OR NOT EXISTS "$ENV{MAIPAI_MICROLINK_DIR}/components")
+        message(FATAL_ERROR "Travel is requested (MAIPAI_TAILNET=y or MAIPAI_PRESET=home) but the private-network client folder is missing. Run `bash scripts/fw-tailnet.sh` from the repo, then `source scripts/fw-env.sh`, then build again, or set MAIPAI_TAILNET=n to build without travel.")
+    endif()
+endif()
+if(MAIPAI_WANT_TAILNET)
+    message(STATUS "MaiPai travel: the private-network client is part of this image")
+else()
+    message(STATUS "MaiPai travel: NOT part of this image (no client folder, or MAIPAI_TAILNET=n)")
+endif()
+if(MAIPAI_WANT_TAILNET AND EXISTS "${CMAKE_CURRENT_SOURCE_DIR}/sdkconfig.tailnet.defaults")
+    list(APPEND SDKCONFIG_DEFAULTS "${CMAKE_CURRENT_SOURCE_DIR}/sdkconfig.tailnet.defaults")
+endif()
+
+include($ENV{IDF_PATH}/tools/cmake/project.cmake)
+project(maipai-stackchan)
+
+# Safety fix (patch 156): the build refuses any image that contains a key. MAIPAI_KEY_CHECK names the
+# checker (scripts/check-no-keys.py in the repo; scripts/fw-env.sh sets it). The step runs after the images exist.
+if(NOT DEFINED ENV{MAIPAI_KEY_CHECK} OR NOT EXISTS "$ENV{MAIPAI_KEY_CHECK}")
+    message(FATAL_ERROR "MAIPAI_KEY_CHECK does not name the key checker. Run `source scripts/fw-env.sh` from the repo, then build again.")
+endif()
+add_custom_command(TARGET app POST_BUILD
+    COMMAND ${PYTHON} "$ENV{MAIPAI_KEY_CHECK}"
+            "${CMAKE_BINARY_DIR}/bootloader/bootloader.bin"
+            "${CMAKE_BINARY_DIR}/partition_table/partition-table.bin"
+            "${CMAKE_BINARY_DIR}/ota_data_initial.bin"
+            "${CMAKE_BINARY_DIR}/generated_assets.bin"
+            "${CMAKE_BINARY_DIR}/${PROJECT_NAME}.bin"
+    COMMENT "Checking the images for keys"
+    VERBATIM)
