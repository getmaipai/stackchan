 #include <esp_log.h>
 #include <esp_timer.h>
 #include <lvgl.h>
@@ -48,6 +51,21 @@ void maipai_cloudtest_start_banner()
     if (esp_timer_create(&a, &timer) == ESP_OK) esp_timer_start_once(timer, 3ll * 1000 * 1000);   // after the display is up
 }
 
+const char* maipai_ws_read_ns()
+{
+    if (maipai_hosted_blocked()) return "websocket";
+    Settings cl(MAIPAI_WS_NS, false);
+    return cl.GetString("url").empty() ? "websocket" : MAIPAI_WS_NS;
+}
+
+int maipai_clock_year()
+{
+    time_t t = time(nullptr);
+    struct tm tmv;
+    gmtime_r(&t, &tmv);
+    return tmv.tm_year + 1900;
+}
