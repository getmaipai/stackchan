+// Patch SF02: the row and the strip (the camera and mic marks) stay above any page, sheet or game that was put on the top layer after them.
+void keep_on_top()
+{
+    lv_obj_t* top = lv_layer_top();
+    const int32_t n = static_cast<int32_t>(lv_obj_get_child_count(top));
+    if (n < 2 || (s_row == nullptr && s_strip == nullptr)) return;
+    const int32_t want_strip = n - 1;
+    const int32_t want_row = s_strip != nullptr ? n - 2 : n - 1;
+    const bool strip_ok = s_strip == nullptr || lv_obj_get_index(s_strip) == want_strip;
+    const bool row_ok = s_row == nullptr || lv_obj_get_index(s_row) == want_row;
+    if (strip_ok && row_ok) return;
+    if (s_row != nullptr) lv_obj_move_foreground(s_row);
+    if (s_strip != nullptr) lv_obj_move_foreground(s_strip);
+}
