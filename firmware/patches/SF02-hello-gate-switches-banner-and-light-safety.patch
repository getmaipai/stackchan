+/* Owner default 2026-11-18 (docs/plan/OPEN-DECISIONS.md, decision 3): a tap turns a privacy switch ON; turning one OFF needs a hold
+ * (500 ms or more, still, in the same place) or the quick settings sheet. */
+static inline int mtc_toggle_ok(mtc_kind_t kind, int switch_is_on)
+{
+    return (kind == MTC_KIND_TAP && !switch_is_on) || (kind == MTC_KIND_HOLD && switch_is_on);
