new file mode 100644
--- /dev/null
+++ b/firmware/main/hal/maipai_updatehdr_core.h
@@ -0,0 +1,102 @@
+/*
+ * SPDX-License-Identifier: MIT
+ *
+ * The signed update header with a build number (patch SF25; docs/plan/signed-update-header.md). Plain C99, no heap. The 56-byte header is
+ * signed by the release key (Ed25519, checked by update_verify.cc over exactly these 56 bytes). This file checks everything else: the
+ * magic, the reserved bytes, a build number above the highest one confirmed, the image length and the SHA-256 of the image (streamed).
+ * Host test: host/tests/test_update_header_core.py (runs host/tests/firmware/updatehdr_core_test.c on the shared vectors).
+ */
+#ifndef MAIPAI_UPDATEHDR_CORE_H
+#define MAIPAI_UPDATEHDR_CORE_H
+
+#include <stddef.h>
+#include <stdint.h>
+#include <string.h>
+#include "maipai_lock_core.h" /* SHA-256 blocks */
+
+#define MUH_HDR_LEN 56
+#define MUH_SIG_LEN 64
+
+typedef struct {
+    uint32_t build;
+    uint32_t image_len;
+    uint8_t sha256[32];
+} muh_hdr_t;
+
+enum { MUH_OK = 0, MUH_SHORT, MUH_MAGIC, MUH_RESERVED, MUH_BUILD_ZERO, MUH_NOT_NEWER, MUH_LENGTH, MUH_HASH, MUH_COUNT };
+static const char* const MUH_REASONS[MUH_COUNT] = {"ok",
+                                                   "the header is not 56 bytes",
+                                                   "the header does not start with MPUH1",
+                                                   "the reserved bytes of the header are not zero",
+                                                   "the build number is zero",
+                                                   "the build number is not higher than the one already installed",
+                                                   "the image length does not match the header",
+                                                   "the image hash does not match the header"};
+
+static inline uint32_t muh_le32(const uint8_t* p) { return (uint32_t)p[0] | ((uint32_t)p[1] << 8) | ((uint32_t)p[2] << 16) | ((uint32_t)p[3] << 24); }
+
+/* Checks the header bytes (after the signature over them was verified). floor: the highest build confirmed so far, 0 when none. */
+static inline int muh_parse(const uint8_t* hdr, size_t len, uint32_t floor_build, muh_hdr_t* out)
+{
+    static const uint8_t magic[8] = {'M', 'P', 'U', 'H', '1', 0, 0, 0};
+    if (len != MUH_HDR_LEN) return MUH_SHORT;
+    if (memcmp(hdr, magic, 8) != 0) return MUH_MAGIC;
+    for (int i = 48; i < 56; i++) {
+        if (hdr[i] != 0) return MUH_RESERVED;
+    }
+    out->build = muh_le32(hdr + 8);
+    out->image_len = muh_le32(hdr + 12);
+    memcpy(out->sha256, hdr + 16, 32);
+    if (out->build == 0) return MUH_BUILD_ZERO;
+    if (out->build <= floor_build) return MUH_NOT_NEWER;
+    return MUH_OK;
+}
+
+/* Streaming SHA-256 of the image. */
+typedef struct {
+    uint32_t h[8];
+    uint8_t buf[64];
+    uint32_t n;
+    uint64_t total;
+} muh_sha_t;
+
+static inline void muh_sha_begin(muh_sha_t* s)
+{
+    lk_sha_init(s->h);
+    s->n = 0;
+    s->total = 0;
+}
+
+static inline void muh_sha_update(muh_sha_t* s, const uint8_t* data, size_t len)
+{
+    s->total += len;
+    while (len > 0) {
+        const size_t take = 64u - s->n < len ? 64u - s->n : len;
+        memcpy(s->buf + s->n, data, take);
+        s->n += (uint32_t)take;
+        data += take;
+        len -= take;
+        if (s->n == 64u) {
+            lk_sha_block(s->h, s->buf);
+            s->n = 0;
+        }
+    }
+}
+
+static inline void muh_sha_end(muh_sha_t* s, uint8_t out[32])
+{
+    /* the blocks already processed are s->total - s->n bytes: finish with the rest, as lk_sha_finish takes the byte count so far as prefix */
+    lk_sha_finish(s->h, s->total - s->n, s->buf, s->n, out);
+}
+
+/* After the whole image was streamed: its length and hash must equal the header's. */
+static inline int muh_check_image(const muh_hdr_t* h, const muh_sha_t* streamed_state)
+{
+    muh_sha_t copy = *streamed_state;
+    uint8_t digest[32];
+    if (copy.total != h->image_len) return MUH_LENGTH;
+    muh_sha_end(&copy, digest);
+    return lk_ct_equal(digest, h->sha256, 32) ? MUH_OK : MUH_HASH;
+}
+
+#endif /* MAIPAI_UPDATEHDR_CORE_H */
