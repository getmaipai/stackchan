+void draw_slide(Grid* g, lv_layer_t* layer)
+{
+    for (int i = 0; i < GS_N * GS_N; i++) {
+        const int e = g->slide.t[i];
+        const int x = g->lay.x0 + (i % GS_N) * g->lay.cw + 3, y = g->lay.y0 + (i / GS_N) * g->lay.ch + 3, w = g->lay.cw - 6;
