diff --git a/firmware/main/hal/maipai_mouthcue_core.h b/firmware/main/hal/maipai_mouthcue_core.h
new file mode 100644
--- /dev/null
+++ b/firmware/main/hal/maipai_mouthcue_core.h
@@ -0,0 +1,98 @@
+/*
+ * SPDX-License-Identifier: MIT
+ *
+ * Mouth cues from the host (patch SF10): a list of [ms, level 0..4] pairs played against the unit's speaking mouth on the unit's
+ * own clock, from the first audio frame. Plain C99, no clock of its own, no heap. Host test: host/tests/firmware/mouthcue_core_test.c.
+ * A list is checked when it arrives (count, times in order and within a minute, levels, at most MMC_MAX_PER_SEC cues in any second).
+ * It waits for the speech to start; a list that waited longer than MMC_STALE_MS belongs to an earlier turn and is dropped. When the
+ * speech ends, or a new turn starts, the list is dropped (mmc_stop). After the last cue the mouth stays closed until the speech ends.
+ */
+#ifndef MAIPAI_MOUTHCUE_CORE_H
+#define MAIPAI_MOUTHCUE_CORE_H
+
+#include <stdint.h>
+#include <string.h>
+
+#define MMC_MAX_CUES 160
+#define MMC_MAX_MS 60000u
+#define MMC_MAX_PER_SEC 12
+#define MMC_STALE_MS 10000u
+#define MMC_TAIL_MS 300u /* the last cue holds this long, then the mouth closes */
+
+enum { MMC_OK = 0, MMC_BAD_COUNT, MMC_BAD_TIME, MMC_BAD_LEVEL, MMC_TOO_FAST, MMC_COUNT };
+static const char* const MMC_REASONS[MMC_COUNT] = {"ok", "bad_count", "bad_time", "bad_level", "too_fast"};
+
+enum { MMC_NONE = 0, MMC_PENDING, MMC_PLAYING };
+
+typedef struct {
+    uint32_t ms[MMC_MAX_CUES];
+    uint8_t lvl[MMC_MAX_CUES];
+    uint16_t n;
+    uint16_t cur;
+    uint8_t state;
+    uint32_t loaded_at;
+    uint32_t start_at;
+} mmc_t;
+
+static inline void mmc_init(mmc_t* m) { memset(m, 0, sizeof(*m)); }
+static inline void mmc_stop(mmc_t* m)
+{
+    m->state = MMC_NONE;
+    m->n = 0;
+    m->cur = 0;
+}
+
+/* A new list. The old one is replaced only when the new one is valid. now: the unit's clock in ms. */
+static inline int mmc_set(mmc_t* m, const uint32_t* ms, const uint8_t* lvl, int n, uint32_t now)
+{
+    if (ms == NULL || lvl == NULL || n < 1 || n > MMC_MAX_CUES) return MMC_BAD_COUNT;
+    for (int i = 0; i < n; i++) {
+        if (ms[i] > MMC_MAX_MS || (i > 0 && ms[i] < ms[i - 1])) return MMC_BAD_TIME;
+        if (lvl[i] > 4) return MMC_BAD_LEVEL;
+    }
+    /* at most MMC_MAX_PER_SEC cues in any window of 1000 ms */
+    for (int i = 0, j = 0; i < n; i++) {
+        while (ms[i] - ms[j] >= 1000u) j++;
+        if (i - j + 1 > MMC_MAX_PER_SEC) return MMC_TOO_FAST;
+    }
+    memcpy(m->ms, ms, sizeof(uint32_t) * (size_t)n);
+    memcpy(m->lvl, lvl, (size_t)n);
+    m->n = (uint16_t)n;
+    m->cur = 0;
+    m->state = MMC_PENDING;
+    m->loaded_at = now;
+    return MMC_OK;
+}
+
+/* The first audio frame of a turn: start playing a fresh list, drop a stale one. */
+static inline void mmc_start(mmc_t* m, uint32_t now)
+{
+    if (m->state != MMC_PENDING) return;
+    if ((uint32_t)(now - m->loaded_at) > MMC_STALE_MS) {
+        mmc_stop(m);
+        return;
+    }
+    m->state = MMC_PLAYING;
+    m->start_at = now;
+    m->cur = 0;
+}
+
+/* 1 and *level 0..100 while a list is playing (the mouth follows it), 0 when the audio loudness should drive the mouth. */
+static inline int mmc_level(mmc_t* m, uint32_t now, int* level)
+{
+    if (m->state != MMC_PLAYING || m->n == 0) return 0;
+    const uint32_t t = (uint32_t)(now - m->start_at);
+    if (t < m->ms[0]) {
+        *level = 0;
+        return 1;
+    }
+    while ((uint16_t)(m->cur + 1) < m->n && m->ms[m->cur + 1] <= t) m->cur++;
+    if (m->cur + 1u == m->n && t >= m->ms[m->cur] + MMC_TAIL_MS) {
+        *level = 0; /* after the last cue the mouth stays closed until the speech ends */
+        return 1;
+    }
+    *level = m->lvl[m->cur] * 25;
+    return 1;
+}
+
+#endif /* MAIPAI_MOUTHCUE_CORE_H */
