diff --git a/firmware/main/hal/maipai_listen_guard_core.h b/firmware/main/hal/maipai_listen_guard_core.h
new file mode 100644
--- /dev/null
+++ b/firmware/main/hal/maipai_listen_guard_core.h
@@ -0,0 +1,21 @@
+/*
+ * SPDX-License-Identifier: MIT
+ *
+ * When the state guard may return Listening to Idle (patch SF03). Plain C99. The old rule ended every listening state 8 s after it
+ * began. The new rule: end it after follow_up_s seconds with no
+ * voice (counted from the entry or from the last voice heard, whichever is later), and never later than cap_s seconds after the entry.
+ * Host test: host/tests/firmware/listen_guard_core_test.c.
+ */
+#ifndef MAIPAI_LISTEN_GUARD_CORE_H
+#define MAIPAI_LISTEN_GUARD_CORE_H
+
+#include <stdint.h>
+
+/* held_s: seconds since the state began. silent_s: seconds since the later of the entry and the last voice. */
+static inline int mlg_should_end(uint32_t held_s, uint32_t silent_s, uint32_t follow_up_s, uint32_t cap_s)
+{
+    if (held_s >= cap_s) return 1;
+    return silent_s >= follow_up_s;
+}
+
+#endif /* MAIPAI_LISTEN_GUARD_CORE_H */
