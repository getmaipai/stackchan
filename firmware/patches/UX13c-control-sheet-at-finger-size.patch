+/* ---- the control sheet at finger size (patch UX13c): two pages ----
+ * The sheet has a fixed height (208 px, from y 32) and two pages that the "Next" and "Back" target and the dots change. Page 0 is the status row (Wi-Fi bars, the time, the battery: not
+ * targets) and the sliders, one 304 by 56 px row each (the whole row is the grab area: the name and value at the left, the track at the right), 8 px apart. Page 1 is the tiles, two rows of
+ * three, each 96 by 56 px, 8 px apart, with the one line of status text (the private network or the address) above them. Under both pages sits a 48 px strip: the dots in the middle and the
+ * 80 by 48 px page target at the right. The margin everywhere is 8 px. Nothing overlaps; every target is at least 56 px high (the page target 48, a secondary target). The older
+ * mpg_sheet_layout() stays for the config tests; the drawing uses this one. */
+#define MPG_SHEET2_H 208
+#define MPG_SHEET2_PAGES 2
+#define MPG_SHEET2_HANDLE_H 8
+#define MPG_SHEET2_STATUS_H 20      /* the status row, and the one status text line on page 1 */
+#define MPG_SHEET2_ROW_H 56
+#define MPG_SHEET2_PITCH 64         /* 56 + the 8 px gap */
+#define MPG_SHEET2_BODY_DY 28       /* from the sheet's top to the first slider row or tile row */
+#define MPG_SHEET2_TILE_W 96
+#define MPG_SHEET2_TILE_COLS 3
+#define MPG_SHEET2_STRIP_DY 156     /* the strip under the pages: dots and the page target */
+#define MPG_SHEET2_NEXT_W 80
+#define MPG_SHEET2_NEXT_H 48
+typedef struct {
+    int16_t top_y;
+    int16_t status_y, status_h;   /* page 0: the status row, or 0 height */
+    int16_t text_y, text_h;       /* page 1: the one text line, or 0 height */
+    mpg_rect_t r[MPG_SHEET_MAX_ITEMS + 1];
+    uint8_t page[MPG_SHEET_MAX_ITEMS + 1];  /* 0 sliders, 1 tiles */
+    uint8_t n;
+    uint8_t status_items[MPG_SHEET_MAX_STATUS];
+    uint8_t n_status;
+    mpg_rect_t next;              /* the page target (item unused) */
+    int16_t dots_y;               /* the dots' center row */
+} mpg_sheet2_t;
+
+static inline void mpg_sheet2_layout(const mpg_cfg_t* c, mpg_sheet2_t* L)
+{
+    memset(L, 0, sizeof(*L));
+    L->top_y = (int16_t)(240 - MPG_SHEET2_H);
+    int ns = 0, nt = 0, lines = 0, row = 0;
+    int tiles[MPG_SHEET_MAX_TILES + 1];
+    int sliders[MPG_SHEET_MAX_SLIDERS];
+    for (int i = 0; i < c->n_items; i++) {
+        const int it = c->items[i], k = mpg_sheet_kind(it);
+        if (k == 0 && ns < MPG_SHEET_MAX_SLIDERS) {
+            sliders[ns++] = it;
+        } else if (k == 1 && nt < MPG_SHEET_MAX_TILES) {
+            tiles[nt++] = it;
+        } else if (k == 2 && L->n_status < MPG_SHEET_MAX_STATUS) {
+            L->status_items[L->n_status++] = (uint8_t)it;
+            if (it == MPG_S_WIFI || it == MPG_S_BATTERY) {
+                row = 1;
+            } else {
+                lines++;
+            }
+        }
+    }
+    tiles[nt++] = MPG_S_COUNT;  /* the gear */
+    if (row) {
+        L->status_y = (int16_t)(L->top_y + MPG_SHEET2_HANDLE_H);
+        L->status_h = MPG_SHEET2_STATUS_H;
+    }
+    if (lines > 0) {
+        L->text_y = (int16_t)(L->top_y + MPG_SHEET2_HANDLE_H);
+        L->text_h = MPG_SHEET2_STATUS_H;   /* one line: the texts are joined and cut with dots */
+    }
+    for (int i = 0; i < ns; i++) {
+        mpg_rect_t* r = &L->r[L->n];
+        r->item = (uint8_t)sliders[i];
+        r->x = 8;
+        r->w = 304;
+        r->h = MPG_SHEET2_ROW_H;
+        r->y = (int16_t)(L->top_y + MPG_SHEET2_BODY_DY + i * MPG_SHEET2_PITCH);
+        L->page[L->n++] = 0;
+    }
+    for (int i = 0; i < nt; i++) {
+        mpg_rect_t* r = &L->r[L->n];
+        r->item = (uint8_t)tiles[i];
+        r->w = MPG_SHEET2_TILE_W;
+        r->h = MPG_SHEET2_ROW_H;
+        r->x = (int16_t)(8 + (i % MPG_SHEET2_TILE_COLS) * (MPG_SHEET2_TILE_W + 8));
+        r->y = (int16_t)(L->top_y + MPG_SHEET2_BODY_DY + (i / MPG_SHEET2_TILE_COLS) * MPG_SHEET2_PITCH);
+        L->page[L->n++] = 1;
+    }
+    L->next.x = (int16_t)(320 - 8 - MPG_SHEET2_NEXT_W);
+    L->next.w = MPG_SHEET2_NEXT_W;
+    L->next.h = MPG_SHEET2_NEXT_H;
+    L->next.y = (int16_t)(L->top_y + MPG_SHEET2_STRIP_DY);
+    L->dots_y = (int16_t)(L->next.y + MPG_SHEET2_NEXT_H / 2);
+}
+
 /* The colors of the status row follow the state (patch UI05): 0 good (green), 1 low (amber), 2 critical (red). */
 static inline int mpg_signal_level(int bars) { return bars >= 3 ? 0 : (bars == 2 ? 1 : 2); }
 static inline int mpg_battery_level(int pct, int charging) { return charging || pct >= 30 ? 0 : (pct >= 15 ? 1 : 2); }
