+    o->lx1 = static_cast<int16_t>(x1);
+    o->ly1 = static_cast<int16_t>(y1);
+    o->lx2 = static_cast<int16_t>(x2);
+    o->ly2 = static_cast<int16_t>(y2);
+}
+inline Node* vo_line(Node* parent) { return parent == nullptr ? nullptr : node_new(parent, NK_LINE); }
+/* A label with room for `cap` bytes of text (the room comes out of the scene's arena). */
+inline Node* vo_label(Node* parent, int cap)
+{
+    static char none[1] = {0};
+    Node* o = parent == nullptr ? nullptr : node_new(parent, NK_TEXT);
+    if (o == nullptr) return nullptr;
+    o->w = o->h = -1;
+    o->font = &lv_font_montserrat_14;
+    Scene* sc = o->sc;
+    if (sc->arena_used + cap <= sc->arena_cap) {
