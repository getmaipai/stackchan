+inline void scene_budget(const mg_pack_t* pk, int* nodes, int* arena)
 {
+    *nodes = 1;
+    *arena = 0;
+    for (int i = 0; i < pk->n_shapes; i++) {
+        mg_shape_t s;
+        mg_shape_get(pk, i, &s);
+        switch (s.type) {
+            case MG_SH_MOLE: *nodes += 1 + P_COUNT; *arena += 3 * 8; break;
+            case MG_SH_DIE: *nodes += 8; break;
+            case MG_SH_COIN: *nodes += 6; break;
