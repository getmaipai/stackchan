+                if (s.cond_ctr == 0xFF) icon_counts(s.text, &nb, &nl);
+                *nodes += 1 + nb + nl;
+                break;
+            }
+            case MG_SH_TEXT: *nodes += 1; *arena += MG_TEXT_LEN + 16; break;
+            default: *nodes += 1; break;
+        }
+    }
+}
