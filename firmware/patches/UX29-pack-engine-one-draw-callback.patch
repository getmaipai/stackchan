+/* ---- the drawing layer (patch UX29) ----
+ * A pack's screen used to be one LVGL object for every shape and every part of the mole, a die, the coin and an icon: 15 to 87 objects a
+ * screen, each one a few hundred bytes of internal RAM and a walk of the whole tree on every change. Now every shape is a Node, a small
+ * record in one block that begin() takes for the whole game, and ONE LVGL object (the canvas) draws all of them in one draw callback, in the
+ * order they were made, each one clipped to its parent the way LVGL clips a child. The functions named vo_* take the place of the LVGL calls
+ * the old code made on its objects (same arguments, so the shapes' code reads as before). A change marks the nodes it touches; commit()
+ * invalidates only the old and new area of each, so a still screen costs nothing and a moving one flushes only what moved. */
+struct Scene;
+enum { NK_BOX = 0, NK_TEXT, NK_LINE };
+
+struct Node {
+    Scene* sc;
+    Node* parent;
+    char* text;                     /* NK_TEXT: the words, in the scene's arena */
+    const lv_font_t* font;
+    int16_t x, y, w, h;             /* relative to the parent's content; w or h < 0: the size of the content (a label) */
+    int16_t radius, lx1, ly1, lx2, ly2, cw, ch, lw;
+    int16_t ox1, oy1, ox2, oy2;     /* the area this node covered when it first changed since the last commit */
