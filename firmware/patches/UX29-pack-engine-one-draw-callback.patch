+inline Node* plain(Node* parent) { return node_new(parent, NK_BOX); }
+
+inline void abs_xy(const Node* o, int* ax, int* ay)
+{
+    int x = o->x, y = o->y;
+    if (o->parent != nullptr) {
+        int px, py;
+        abs_xy(o->parent, &px, &py);
+        x += px + o->parent->bd_w;
+        y += py + o->parent->bd_w;
+    }
+    *ax = x;
+    *ay = y;
+}
+
+inline bool shown(const Node* o)
+{
+    for (; o != nullptr; o = o->parent) {
+        if (o->hidden) return false;
+    }
+    return true;
+}
+
+/* The size a node has now: a label's content size is measured the way LVGL measures it (the width the label has, or no limit), a line's is
+ * the far corner of its two points. */
+inline void size_of(Node* o, int* w, int* h)
+{
+    if (o->kind == NK_LINE) {
+        *w = o->lx1 > o->lx2 ? o->lx1 : o->lx2;
+        *h = o->ly1 > o->ly2 ? o->ly1 : o->ly2;
+        if (*w < 0) *w = 0;
+        if (*h < 0) *h = 0;
+        return;
+    }
+    if (o->kind == NK_TEXT && (o->w < 0 || o->h < 0)) {
+        if (!o->size_ok) {
+            lv_point_t sz;
+            lv_text_get_size(&sz, o->text, o->font, 0, 0, o->w >= 0 ? o->w : LV_COORD_MAX, LV_TEXT_FLAG_NONE);
+            o->cw = static_cast<int16_t>(sz.x);
+            o->ch = static_cast<int16_t>(sz.y);
+            o->size_ok = 1;
+        }
+        *w = o->w >= 0 ? o->w : o->cw;
+        *h = o->h >= 0 ? o->h : o->ch;
+        return;
+    }
+    *w = o->w < 0 ? 0 : o->w;
+    *h = o->h < 0 ? 0 : o->h;
+}
+
+/* How far a node draws outside its own box: a label a quarter of a line (LVGL's allowance for slanted letters), a line its width. */
+inline int ext_of(const Node* o)
+{
+    if (o->kind == NK_LINE) return o->thick;
+    if (o->kind == NK_TEXT && o->font != nullptr) return lv_font_get_line_height(o->font) / 4;
+    return 0;
+}
+
+/* The area a node's own pixels can be in, on the canvas. False when it draws nothing (hidden, empty). */
+inline bool own_area(Node* o, lv_area_t* a)
+{
+    if (o->hidden) return false;
+    int ax, ay, w, h;
+    abs_xy(o, &ax, &ay);
+    size_of(o, &w, &h);
+    const int e = ext_of(o);
+    if (o->kind == NK_LINE) {
+        const int x1 = o->lx1 < o->lx2 ? o->lx1 : o->lx2, x2 = o->lx1 > o->lx2 ? o->lx1 : o->lx2;
+        const int y1 = o->ly1 < o->ly2 ? o->ly1 : o->ly2, y2 = o->ly1 > o->ly2 ? o->ly1 : o->ly2;
+        a->x1 = static_cast<lv_coord_t>(ax + x1 - e);
+        a->y1 = static_cast<lv_coord_t>(ay + y1 - e);
+        a->x2 = static_cast<lv_coord_t>(ax + x2 + e);
+        a->y2 = static_cast<lv_coord_t>(ay + y2 + e);
+        return true;
+    }
+    if (w <= 0 || h <= 0) return false;
+    a->x1 = static_cast<lv_coord_t>(ax - e);
+    a->y1 = static_cast<lv_coord_t>(ay - e);
+    a->x2 = static_cast<lv_coord_t>(ax + w - 1 + e);
+    a->y2 = static_cast<lv_coord_t>(ay + h - 1 + e);
+    return true;
+}
+
+/* The area of a node and everything inside it (a node nobody can see covers nothing). */
+inline bool tree_area(Node* o, lv_area_t* out)
+{
+    if (!shown(o)) return false;
+    bool any = false;
+    lv_area_t a;
+    if (own_area(o, &a)) {
+        *out = a;
+        any = true;
+    }
+    if (o->kids) {
+        Scene* sc = o->sc;
+        for (int j = static_cast<int>(o - sc->n) + 1; j < sc->cnt; j++) {
+            Node* c = &sc->n[j];
+            bool inside = false;
+            for (Node* p = c->parent; p != nullptr; p = p->parent) {
+                if (p == o) {
+                    inside = true;
+                    break;
+                }
+            }
+            if (inside && own_area(c, &a) && shown(c)) {
+                if (!any) {
+                    *out = a;
+                    any = true;
+                } else {
+                    out->x1 = a.x1 < out->x1 ? a.x1 : out->x1;
+                    out->y1 = a.y1 < out->y1 ? a.y1 : out->y1;
+                    out->x2 = a.x2 > out->x2 ? a.x2 : out->x2;
+                    out->y2 = a.y2 > out->y2 ? a.y2 : out->y2;
+                }
+            }
+        }
+    }
+    return any;
+}
+
+/* Called before a change: remembers what the node covers now, once, so commit() can invalidate it. */
+inline void touch(Node* o)
+{
+    if (o == nullptr || o->dirty) return;
+    lv_area_t a;
+    o->old_ok = tree_area(o, &a) ? 1 : 0;
+    if (o->old_ok) {
+        o->ox1 = static_cast<int16_t>(a.x1);
+        o->oy1 = static_cast<int16_t>(a.y1);
+        o->ox2 = static_cast<int16_t>(a.x2);
+        o->oy2 = static_cast<int16_t>(a.y2);
+    }
+    o->dirty = 1;
+    o->sc->any = 1;
+}
+
+/* Hands the changes since the last commit to LVGL: the old and the new area of every node that changed. */
+inline void commit(Scene* sc)
+{
+    if (sc == nullptr || !sc->any) return;
+    sc->any = 0;
+    for (int i = 0; i < sc->cnt; i++) {
+        Node* o = &sc->n[i];
+        if (!o->dirty) continue;
+        o->dirty = 0;
+        if (o->old_ok) {
+            const lv_area_t old = {o->ox1, o->oy1, o->ox2, o->oy2};
+            lv_obj_invalidate_area(sc->canvas, &old);
+            o->old_ok = 0;
+        }
+        lv_area_t now;
+        if (tree_area(o, &now)) lv_obj_invalidate_area(sc->canvas, &now);
+    }
+}
+
+inline bool isect(lv_area_t* r, const lv_area_t* a, const lv_area_t* b)
+{
+    const int x1 = a->x1 > b->x1 ? a->x1 : b->x1, y1 = a->y1 > b->y1 ? a->y1 : b->y1;
+    const int x2 = a->x2 < b->x2 ? a->x2 : b->x2, y2 = a->y2 < b->y2 ? a->y2 : b->y2;
+    if (x1 > x2 || y1 > y2) return false;
+    r->x1 = static_cast<lv_coord_t>(x1);
+    r->y1 = static_cast<lv_coord_t>(y1);
+    r->x2 = static_cast<lv_coord_t>(x2);
+    r->y2 = static_cast<lv_coord_t>(y2);
+    return true;
+}
+
+inline bool same_colour(lv_color_t a, lv_color_t b) { return a.red == b.red && a.green == b.green && a.blue == b.blue; }
+
+inline void vo_pos(Node* o, int x, int y)
+{
+    if (o == nullptr || (o->x == x && o->y == y)) return;
+    touch(o);
+    o->x = static_cast<int16_t>(x);
+    o->y = static_cast<int16_t>(y);
+}
+inline void vo_size(Node* o, int w, int h)
+{
+    if (w == LV_SIZE_CONTENT) w = -1;
+    if (h == LV_SIZE_CONTENT) h = -1;
+    if (o == nullptr || (o->w == w && o->h == h)) return;
+    touch(o);
+    o->w = static_cast<int16_t>(w);
+    o->h = static_cast<int16_t>(h);
+    o->size_ok = 0;
+}
+inline void vo_width_set(Node* o, int w) { if (o != nullptr) vo_size(o, w, o->h); }
+/* The width the node had when the screen was last drawn. LVGL's lv_obj_get_width reads the width of the last layout, not the one just set,
+ * and the coin's flip (animate) has always positioned itself with that value, so the first tick after a face change uses the width of the
+ * face before: kept exactly, so the drawing is the same pixel for pixel (a one-line change to size_of would draw it with the new width). */
+inline int vo_width(Node* o) { return o->lw; }
+inline void vo_flag_on(Node* o, lv_obj_flag_t f)
+{
+    if (o == nullptr || f != LV_OBJ_FLAG_HIDDEN || o->hidden) return;
+    touch(o);
+    o->hidden = 1;
+}
+inline void vo_flag_off(Node* o, lv_obj_flag_t f)
+{
+    if (o == nullptr || f != LV_OBJ_FLAG_HIDDEN || !o->hidden) return;
+    touch(o);
+    o->hidden = 0;
+}
+inline void vo_bg(Node* o, lv_color_t c, int) { if (o != nullptr && !same_colour(o->bg, c)) { touch(o); o->bg = c; } }
+inline void vo_bg_opa(Node* o, int a, int) { if (o != nullptr && o->bg_opa != a) { touch(o); o->bg_opa = static_cast<uint8_t>(a); } }
+inline void vo_radius(Node* o, int r, int) { if (o != nullptr && o->radius != r) { touch(o); o->radius = static_cast<int16_t>(r); } }
+inline void vo_bd(Node* o, lv_color_t c, int) { if (o != nullptr && !same_colour(o->bd, c)) { touch(o); o->bd = c; } }
+inline void vo_bd_w(Node* o, int w, int) { if (o != nullptr && o->bd_w != w) { touch(o); o->bd_w = static_cast<uint8_t>(w); } }
+inline void vo_opa(Node* o, int a, int) { if (o != nullptr && o->opa != a) { touch(o); o->opa = static_cast<uint8_t>(a); } }
+inline void vo_thick(Node* o, int w, int) { if (o != nullptr && o->thick != w) { touch(o); o->thick = static_cast<uint8_t>(w); } }
+inline void vo_ink(Node* o, lv_color_t c, int) { if (o != nullptr && !same_colour(o->ink, c)) { touch(o); o->ink = c; } }
+inline void vo_round(Node* o, bool r, int) { if (o != nullptr && o->rounded != (r ? 1 : 0)) { touch(o); o->rounded = r ? 1 : 0; } }
+inline void vo_font(Node* o, const lv_font_t* f, int) { if (o != nullptr && o->font != f) { touch(o); o->font = f; o->size_ok = 0; } }
+inline void vo_align(Node* o, lv_text_align_t a, int) { if (o != nullptr && o->mid != (a == LV_TEXT_ALIGN_CENTER ? 1 : 0)) { touch(o); o->mid = a == LV_TEXT_ALIGN_CENTER ? 1 : 0; } }
+inline void vo_long(Node*, lv_label_long_mode_t) {}   /* every label wraps */
+inline void vo_text(Node* o, const char* s)
+{
+    if (o == nullptr || o->text == nullptr || o->cap == 0) return;
+    size_t len = strlen(s);
+    if (len >= o->cap) len = o->cap - 1u;
+    if (memcmp(o->text, s, len) == 0 && o->text[len] == 0) return;
+    touch(o);
+    memcpy(o->text, s, len);
+    o->text[len] = 0;
+    o->size_ok = 0;
