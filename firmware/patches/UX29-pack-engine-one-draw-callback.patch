+/* The ink of a node is clipped to the nodes above it, so the area every ancestor covers (their boxes, not their padding) is the clip. */
+inline bool clip_to_parents(const Node* o, int cx, int cy, lv_area_t* clip)
+{
+    for (const Node* p = o->parent; p != nullptr; p = p->parent) {
+        int ax, ay, w, h;
+        abs_xy(p, &ax, &ay);
+        size_of(const_cast<Node*>(p), &w, &h);
+        const lv_area_t box = {static_cast<lv_coord_t>(cx + ax), static_cast<lv_coord_t>(cy + ay), static_cast<lv_coord_t>(cx + ax + w - 1), static_cast<lv_coord_t>(cy + ay + h - 1)};
+        if (!isect(clip, clip, &box)) return false;
+    }
+    return true;
+}
