--- /dev/null
+++ b/firmware/main/hal/maipai_servo_clock_core.h
@@ -0,0 +1,53 @@
+/*
+ * SPDX-License-Identifier: MIT
+ *
+ * The servo animation clock (patch SF28). Plain C99, no clock of its own. The spring animation used to advance a fixed 20 ms per update
+ * step, and a step ran only when 20 ms had passed since the last one: with update calls every 11 to 13 ms a step ran every second call,
+ * about 26 to 31 steps a second instead of 50, so the head moved at roughly half the designed speed. Now a step still waits for 20 ms
+ * (the bus is written at most 50 times a second) but advances the animation by the real time since the last step, between 20 and 50 ms,
+ * so the same motion takes the same real time at any call rate. A speed ceiling in degrees per second (scaled by the movement limiter)
+ * keeps the head from moving faster than the servo's own limit whatever the clock does.
+ * Host test: host/tests/firmware/servo_clock_core_test.c.
+ */
+#ifndef MAIPAI_SERVO_CLOCK_CORE_H
+#define MAIPAI_SERVO_CLOCK_CORE_H
+
+#include <stdint.h>
+
+#define MSC_MIN_MS 20u
+#define MSC_MAX_MS 50u
+#define MSC_VMAX_TENTH_DPS 4000 /* 400 degrees per second at the limiter's scale of 100 percent */
+
+/* 1 when an animation step is due; *elapsed receives the ms since the last step. */
+static inline int msc_due(uint32_t now, uint32_t last_step, uint32_t* elapsed)
+{
+    const uint32_t e = (uint32_t)(now - last_step);
+    *elapsed = e;
+    return e >= MSC_MIN_MS;
+}
+
+/* The animation advance for a step, in seconds: the real elapsed time, never less than 20 ms and never more than 50 ms (a stall is not a jump). */
+static inline float msc_dt_s(uint32_t elapsed_ms)
+{
+    const uint32_t e = elapsed_ms < MSC_MIN_MS ? MSC_MIN_MS : (elapsed_ms > MSC_MAX_MS ? MSC_MAX_MS : elapsed_ms);
+    return (float)e / 1000.0f;
+}
+
+/* The speed ceiling in tenth-degrees per second for the limiter's scale (0 to 100 percent). */
+static inline int msc_vmax_tenth_dps(int scale_pct)
+{
+    const int s = scale_pct < 0 ? 0 : (scale_pct > 100 ? 100 : scale_pct);
+    return MSC_VMAX_TENTH_DPS * s / 100;
+}
+
+/* The command for this step: the animation's value, but no further from the last command than vmax allows in dt seconds. */
+static inline int msc_limit_step(int prev_cmd, int target, int vmax_tenth_dps, float dt)
+{
+    int max_step = (int)((float)vmax_tenth_dps * dt + 0.5f);
+    if (max_step < 1) max_step = 1;
+    if (target > prev_cmd + max_step) return prev_cmd + max_step;
+    if (target < prev_cmd - max_step) return prev_cmd - max_step;
+    return target;
+}
+
+#endif /* MAIPAI_SERVO_CLOCK_CORE_H */
