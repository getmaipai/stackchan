# Intent: Fast eyes, part 4 (owner brief 2026-11-16: the facial animation stutters, the earlier X02 build was smooth). Measured on the unit: the cheek and lid triangles of the emotions and the sixteen round-ended line draws of the speaking mouth are expensive LVGL masked draws (an emotion change refreshed in 22 ms, a speaking refresh in 9.5 ms). The looks do not change; only how they reach the screen. The shape list of the approved design stays the one definition (V10, V12). A new pure core, hal/maipai_sprite_core.h, rasterizes it: one RGB565 plus alpha picture per eye (the rounded box with its corner edge, the pupil and the two highlights, the lid and the cheek cut out of the alpha) and one alpha mask for the mouth (a round brush stamped along the 17 points at half-pixel places), each handed to LVGL as one image blit; the picture is built in the update loop (measured: building it in the draw event instead, once per refresh, was slower, 29.7 against 32.5 refreshes a second while the eyes move, because the loop's work overlaps the SPI send of the refresh before). Lists the pictures cannot draw (a heart, the closed-eye arc, an eye fading in or out, a stroke thicker than 36) stay shape draws. The dirty rectangles of V21 are unchanged: LVGL clips the blit to them. Memory: the pictures live in PSRAM (an eye 54,612 bytes, the mouth mask 15,840, the brush set 7,052: 132,116 bytes for Big eyes, allocated on first use and when the style changes); internal RAM cost is about 200 bytes (the members of two eyes and the mouth, no static buffers).
# Placement: unit (the face runs on the robot, so it is complete with no host); the settings page preview is unchanged (it draws the same shape lists)
# Upstream: firmware/main/stackchan/avatar/skins/default/{default.h,eyes.cpp,mouth.cpp} of the StackChan main component (MIT) as changed by X01, V10, V12, V21; new file hal/maipai_sprite_core.h
# Check after a flash: Big eyes neutral, happy, sad, angry, doubt, surprised, sleepy and tired look as before (scripts/fw-serial.py snap, then compare with self.face.bench_mode sprite_off 1); a steady speaking mouth is the same pill; the host renderer (scripts/fw-face-render, command sprite off|on) draws both and the PNGs agree to within one pixel on the edges.

diff --git a/firmware/main/hal/maipai_sprite_core.h b/firmware/main/hal/maipai_sprite_core.h
new file mode 100644

--- /dev/null
+++ b/firmware/main/hal/maipai_sprite_core.h
@@ -0,0 +1,369 @@
+/*
+ * SPDX-License-Identifier: MIT
+ *
+ * Sprites for the face (patch V23): the pure drawing code. No ESP-IDF, no heap, no clock. Header-only plain C99 so a host compiler
+ * tests it (host/tests/firmware/sprite_core_test.c); the skin (eyes.cpp, mouth.cpp) owns the buffers and hands them to LVGL as images.
+ *
+ * Why: LVGL's software drawing spends about 150 cycles on every anti-aliased pixel of a rounded box, a disc, a triangle or a
+ * round-ended line (8 to 15 ms for a Big eyes refresh against 4 to 6 ms for the earlier faces-core eyes). The looks do not change. Only
+ * how they reach the screen does: the shape list of the approved design (ml_shape_t, hal/maipai_look_core.h) is rasterized here into
+ * one small picture per eye (RGB565 plus an alpha plane) and one alpha mask for the mouth, and LVGL blits each as a single image.
+ *
+ * Coordinates: shape coordinates are whole pixels, relative to the shape list's origin, and are pixel EDGES (a disc at (0, 0) with
+ * radius r covers x from -r to r). Pixel (i, j) of a picture covers [i, i+1] by [j, j+1]; its centre is (i + 0.5, j + 0.5).
+ * Coverage is the usual distance estimate: clamp(r + 0.5 - distance of the pixel centre from the edge).
+ */
+#ifndef MAIPAI_SPRITE_CORE_H
+#define MAIPAI_SPRITE_CORE_H
+
+#include "maipai_look_core.h"
+#include <math.h>
+#include <stdint.h>
+#include <string.h>
+
+/* The picture of an eye: the box it covers, relative to the shape list's origin. */
+typedef struct {
+    int x1, y1, w, h;
+} msp_box_t;
+
+/* ---------------------------------------------------------------- small helpers */
+
+/* Square root without the library call (the unit's FPU has no square root): bit estimate and two Newton steps, good to 1e-5. */
+static inline float msp_sqrt(float x)
+{
+    if (x <= 0.0f) return 0.0f;
+    union { float f; uint32_t u; } c = {x};
+    c.u = 0x5f375a86u - (c.u >> 1); /* 1 / sqrt(x) */
+    float y = c.f;
+    y = y * (1.5f - 0.5f * x * y * y);
+    y = y * (1.5f - 0.5f * x * y * y);
+    y = y * (1.5f - 0.5f * x * y * y);
+    return x * y;
+}
+
+static inline int msp_iceil(float x) { int i = (int)x; return (float)i < x ? i + 1 : i; }
+static inline int msp_ifloor(float x) { int i = (int)x; return (float)i > x ? i - 1 : i; }
+static inline int msp_imin(int a, int b) { return a < b ? a : b; }
+static inline int msp_imax(int a, int b) { return a > b ? a : b; }
+static inline float msp_clamp01(float x) { return x < 0.0f ? 0.0f : (x > 1.0f ? 1.0f : x); }
+
+/* dst moved toward src by w (0 to 255), on 5-6-5 fields. */
+static inline uint16_t msp_mix565(uint16_t dst, uint16_t src, int w)
+{
+    if (w <= 0) return dst;
+    if (w >= 255) return src;
+    const int r = ((dst >> 11) & 31) * (255 - w) + ((src >> 11) & 31) * w;
+    const int g = ((dst >> 5) & 63) * (255 - w) + ((src >> 5) & 63) * w;
+    const int b = (dst & 31) * (255 - w) + (src & 31) * w;
+    return (uint16_t)((((r + 127) / 255) << 11) | (((g + 127) / 255) << 5) | ((b + 127) / 255));
+}
+
+/* ---------------------------------------------------------------- disc and rounded box rows
+ * For the row whose centre is dy away from the middle of a circle of radius r: the pixel centres within `xo` of the middle are
+ * touched, within `xi` are fully covered (xi is -1 when none is). */
+static inline void msp_row_reach(float r, float dy, float* xo, float* xi)
+{
+    const float o2 = (r + 0.5f) * (r + 0.5f) - dy * dy;
+    *xo = o2 > 0.0f ? msp_sqrt(o2) : -1.0f;
+    const float i2 = (r - 0.5f) * (r - 0.5f) - dy * dy;
+    *xi = i2 > 0.0f ? msp_sqrt(i2) : -1.0f;
+}
+
+/* Cover of a pixel whose centre is (dx, dy) from the middle of a circle of radius r, 0 to 255. */
+static inline int msp_cov(float r, float dx, float dy)
+{
+    const float c = r + 0.5f - msp_sqrt(dx * dx + dy * dy);
+    return c <= 0.0f ? 0 : (c >= 1.0f ? 255 : (int)(c * 255.0f + 0.5f));
+}
+
+/* A disc of radius r around (cx, cy) painted over an RGB565 picture w by h: full pixels take `color`, edge pixels mix toward it. */
+static inline void msp_disc_paint(uint16_t* rgb, int w, int h, float cx, float cy, float r, uint16_t color)
+{
+    const int j0 = msp_imax(0, msp_ifloor(cy - r - 0.5f)), j1 = msp_imin(h - 1, msp_iceil(cy + r + 0.5f));
+    for (int j = j0; j <= j1; j++) {
+        const float dy = (float)j + 0.5f - cy;
+        float xo, xi;
+        msp_row_reach(r, dy, &xo, &xi);
+        if (xo < 0.0f) continue;
+        const int lo = msp_imax(0, msp_iceil(cx - xo - 0.5f)), hi = msp_imin(w - 1, msp_ifloor(cx + xo - 0.5f));
+        int flo = 1 << 20, fhi = -(1 << 20);
+        if (xi >= 0.0f) {
+            flo = msp_iceil(cx - xi - 0.5f);
+            fhi = msp_ifloor(cx + xi - 0.5f);
+        }
+        uint16_t* row = rgb + (size_t)j * (size_t)w;
+        for (int i = lo; i <= hi; i++) {
+            if (i >= flo && i <= fhi) {
+                const int e = fhi < hi ? fhi : hi;
+                for (int k = i; k <= e; k++) row[k] = color;
+                i = e;
+                continue;
+            }
+            const int c = msp_cov(r, (float)i + 0.5f - cx, dy);
+            if (c > 0) row[i] = msp_mix565(row[i], color, c);
+        }
+    }
+}
+
+/* The alpha of a rounded box w by h, corner radius rad (already limited to half the short side): 255 inside, an anti-aliased edge at the corners. */
+static inline void msp_rrect_alpha(uint8_t* a, int w, int h, int rad)
+{
+    if (rad < 0) rad = 0;
+    if (rad > w / 2) rad = w / 2;
+    if (rad > h / 2) rad = h / 2;
+    for (int j = 0; j < h; j++) {
+        uint8_t* row = a + (size_t)j * (size_t)w;
+        float dyc = 0.0f;
+        if (j < rad) dyc = (float)rad - ((float)j + 0.5f);
+        else if (j >= h - rad) dyc = ((float)j + 0.5f) - (float)(h - rad);
+        if (rad == 0 || dyc <= 0.0f) {
+            memset(row, 255, (size_t)w);
+            continue;
+        }
+        float xo, xi;
+        msp_row_reach((float)rad, dyc, &xo, &xi);
+        int lo = xo < 0.0f ? rad : msp_imax(0, msp_iceil((float)rad - xo - 0.5f));
+        int full = xi < 0.0f ? rad : msp_imin(rad, msp_iceil((float)rad - xi - 0.5f));
+        if (lo > full) lo = full;
+        memset(row, 0, (size_t)lo);
+        for (int i = lo; i < full; i++) {
+            const int c = msp_cov((float)rad, (float)rad - ((float)i + 0.5f), dyc);
+            row[i] = (uint8_t)c;
+            row[w - 1 - i] = (uint8_t)c;
+        }
+        memset(row + w - lo, 0, (size_t)lo);
+        memset(row + full, 255, (size_t)(w - 2 * full));
+    }
+}
+
+/* Erase (multiply the alpha by 1 - cover) the quad q (x, y of four corners: top left, top right, bottom right, bottom left; vertical
+ * sides), in picture coordinates. This is a lid or a cheek strip of the shape list. */
+static inline void msp_erase_quad(uint8_t* a, int w, int h, const float* q)
+{
+    const float xl = q[0], xr = q[2];
+    if (xr <= xl) return;
+    const float yt0 = q[1], yt1 = q[3], yb0 = q[7], yb1 = q[5];
+    const int i0 = msp_imax(0, msp_ifloor(xl)), i1 = msp_imin(w - 1, msp_iceil(xr) - 1);
+    for (int i = i0; i <= i1; i++) {
+        const float xa = (float)i > xl ? (float)i : xl, xb = (float)(i + 1) < xr ? (float)(i + 1) : xr;
+        const float fx = xb - xa;
+        if (fx <= 0.0f) continue;
+        const float t = ((xa + xb) * 0.5f - xl) / (xr - xl);
+        const float yt = yt0 + (yt1 - yt0) * t, yb = yb0 + (yb1 - yb0) * t;
+        if (yb <= yt) continue;
+        const int j0 = msp_imax(0, msp_ifloor(yt)), j1 = msp_imin(h - 1, msp_iceil(yb) - 1);
+        for (int j = j0; j <= j1; j++) {
+            const float ya = (float)j > yt ? (float)j : yt, yc = (float)(j + 1) < yb ? (float)(j + 1) : yb;
+            const float c = fx * (yc - ya);
+            if (c <= 0.0f) continue;
+            uint8_t* p = a + (size_t)j * (size_t)w + i;
+            if (c >= 0.995f) *p = 0;
+            else *p = (uint8_t)(((int)*p * (int)((1.0f - c) * 256.0f)) >> 8);
+        }
+    }
+}
+
+/* ---------------------------------------------------------------- the eye */
+
+/* 1 when the shape list is a plain eye the picture can draw (a fully opaque box, then discs, the mask ring and lid or cheek quads), with
+ * the box it covers in `box`; 0 for a heart, a closed-eye arc, a fading eye or anything else (the caller draws those as shapes). */
+static inline int msp_eye_plain(const ml_shape_t* sh, int n, msp_box_t* box)
+{
+    if (n < 1 || sh[0].kind != ML_SH_RRECT || sh[0].opa != 255) return 0;
+    for (int i = 1; i < n; i++) {
+        const ml_shape_t* s = &sh[i];
+        switch (s->kind) {
+            case ML_SH_CIRCLE:
+                if (s->opa != 255) return 0;
+                break;
+            case ML_SH_RING: break;
+            case ML_SH_QUAD:
+                if (s->opa != 255 || s->col != ML_COL_BG) return 0;
+                if (s->v[0] != s->v[6] || s->v[2] != s->v[4]) return 0; /* vertical sides only (every lid and cheek strip is) */
+                break;
+            default: return 0;
+        }
+    }
+    const ml_shape_t* e = &sh[0];
+    box->w  = (int)lroundf(e->v[2]);
+    box->h  = (int)lroundf(e->v[3]);
+    box->x1 = (int)lroundf(e->v[0] - e->v[2] * 0.5f);
+    box->y1 = (int)lroundf(e->v[1] - e->v[3] * 0.5f);
+    return box->w > 0 && box->h > 0;
+}
+
+/* Draw the plain eye into rgb (w*h u16) and a (w*h u8): the face colour fg for the box, the screen colour bg for the pupil and
+ * the highlights in the face colour; the lid and the cheek take their cover out of the alpha. The box is `box` (from msp_eye_plain). */
+static inline void msp_eye_render(const ml_shape_t* sh, int n, const msp_box_t* box, uint16_t fg, uint16_t bg, uint16_t* rgb, uint8_t* a)
+{
+    const int w = box->w, h = box->h;
+    for (size_t i = 0, e = (size_t)w * (size_t)h; i < e; i++) rgb[i] = fg;
+    int rad = (int)lroundf(sh[0].v[4]);
+    msp_rrect_alpha(a, w, h, rad);
+    const float ox = (float)-box->x1, oy = (float)-box->y1;
+    for (int i = 1; i < n; i++) {
+        const ml_shape_t* s = &sh[i];
+        if (s->kind == ML_SH_CIRCLE) {
+            msp_disc_paint(rgb, w, h, s->v[0] + ox, s->v[1] + oy, s->v[2], s->col == ML_COL_BG ? bg : fg);
+        } else if (s->kind == ML_SH_QUAD) {
+            float q[8];
+            for (int k = 0; k < 4; k++) {
+                q[k * 2]     = s->v[k * 2] + ox;
+                q[k * 2 + 1] = s->v[k * 2 + 1] + oy;
+            }
+            msp_erase_quad(a, w, h, q);
+        }
+    }
+}
+
+/* ---------------------------------------------------------------- the mouth stroke
+ * A stroke along a polyline with round ends, drawn as a round brush stamped every pixel along it (at half-pixel places), then the
+ * brush rows: solid in the middle, a soft edge at each end. The result is a mask (alpha only); LVGL colours it. */
+
+#define MSP_BRUSH_MAX 40 /* the brush is at most this many pixels wide: a stroke up to 36 thick */
+
+typedef struct {
+    int t;                                          /* thickness this set was made for, 0 = none */
+    int size, c;                                    /* canvas size and the pixel edge the circle is centred on */
+    uint8_t px[4][MSP_BRUSH_MAX * MSP_BRUSH_MAX];   /* the brush for the four half-pixel phases (fx + 2 fy) */
+    int8_t lo[4][MSP_BRUSH_MAX], flo[4][MSP_BRUSH_MAX], fhi[4][MSP_BRUSH_MAX], hi[4][MSP_BRUSH_MAX]; /* per row: first touched, first solid, first after solid, first after touched */
+} msp_brush_t;
+
+static inline void msp_brush_make(msp_brush_t* b, int t)
+{
+    if (t < 1) t = 1;
+    if (t > MSP_BRUSH_MAX - 4) t = MSP_BRUSH_MAX - 4;
+    const float r = (float)t * 0.5f;
+    b->t    = t;
+    b->c    = msp_iceil(r) + 1;
+    b->size = 2 * b->c + 1;
+    for (int ph = 0; ph < 4; ph++) {
+        const float cx = (float)b->c + ((ph & 1) ? 0.5f : 0.0f), cy = (float)b->c + ((ph & 2) ? 0.5f : 0.0f);
+        for (int j = 0; j < b->size; j++) {
+            uint8_t* row = &b->px[ph][j * MSP_BRUSH_MAX];
+            memset(row, 0, MSP_BRUSH_MAX);
+            const float dy = (float)j + 0.5f - cy;
+            float xo, xi;
+            msp_row_reach(r, dy, &xo, &xi);
+            int lo = b->size, flo = b->size, fhi = b->size, hi = b->size;
+            if (xo >= 0.0f) {
+                lo = msp_imax(0, msp_iceil(cx - xo - 0.5f));
+                hi = msp_imin(b->size, msp_ifloor(cx + xo - 0.5f) + 1);
+                if (xi >= 0.0f) {
+                    flo = msp_iceil(cx - xi - 0.5f);
+                    fhi = msp_ifloor(cx + xi - 0.5f) + 1;
+                    if (flo < lo) flo = lo;
+                    if (fhi > hi) fhi = hi;
+                    if (fhi < flo) fhi = flo;
+                } else {
+                    flo = fhi = (lo + hi) / 2;
+                }
+                for (int i = lo; i < flo; i++) row[i] = (uint8_t)msp_cov(r, (float)i + 0.5f - cx, dy);
+                for (int i = flo; i < fhi; i++) row[i] = 255;
+                for (int i = fhi; i < hi; i++) row[i] = (uint8_t)msp_cov(r, (float)i + 0.5f - cx, dy);
+            }
+            b->lo[ph][j] = (int8_t)lo;
+            b->flo[ph][j] = (int8_t)flo;
+            b->fhi[ph][j] = (int8_t)fhi;
+            b->hi[ph][j] = (int8_t)hi;
+        }
+    }
+}
+
+/* One stamp of the brush with its pixel origin at (ox, oy) in the mask (w by h). */
+static inline void msp_brush_stamp(const msp_brush_t* b, int ph, uint8_t* m, int w, int h, int ox, int oy)
+{
+    for (int j = 0; j < b->size; j++) {
+        const int y = oy + j;
+        if (y < 0 || y >= h) continue;
+        const int lo = b->lo[ph][j], flo = b->flo[ph][j], fhi = b->fhi[ph][j], hi = b->hi[ph][j];
+        if (lo >= hi) continue;
+        uint8_t* row = m + (size_t)y * (size_t)w;
+        const uint8_t* src = &b->px[ph][j * MSP_BRUSH_MAX];
+        for (int i = lo; i < flo; i++) {
+            const int x = ox + i;
+            if (x >= 0 && x < w && src[i] > row[x]) row[x] = src[i];
+        }
+        int s = ox + flo, e = ox + fhi;
+        if (s < 0) s = 0;
+        if (e > w) e = w;
+        if (e > s) memset(row + s, 255, (size_t)(e - s));
+        for (int i = fhi; i < hi; i++) {
+            const int x = ox + i;
+            if (x >= 0 && x < w && src[i] > row[x]) row[x] = src[i];
+        }
+    }
+}
+
+/* 1 when the shape list is a mouth stroke the mask can draw (round-ended lines of one width, or one disc), with the box it covers (and the
+ * thickness in *t). The box includes the brush. */
+static inline int msp_stroke_plain(const ml_shape_t* sh, int n, msp_box_t* box, int* t, uint8_t* opa)
+{
+    if (n < 1) return 0;
+    int x1 = 1 << 20, y1 = 1 << 20, x2 = -(1 << 20), y2 = -(1 << 20), tt = 0;
+    for (int i = 0; i < n; i++) {
+        const ml_shape_t* s = &sh[i];
+        if (s->opa != sh[0].opa || s->col != sh[0].col) return 0;
+        int ti, px[2] = {0, 0}, py[2] = {0, 0}, m;
+        if (s->kind == ML_SH_LINE) {
+            ti = (int)lroundf(s->v[4]);
+            if (ti < 1) ti = 1;
+            px[0] = (int)lroundf(s->v[0]); py[0] = (int)lroundf(s->v[1]);
+            px[1] = (int)lroundf(s->v[2]); py[1] = (int)lroundf(s->v[3]);
+            m = 2;
+        } else if (s->kind == ML_SH_CIRCLE) {
+            ti = (int)lroundf(s->v[2] * 2.0f);
+            px[0] = (int)lroundf(s->v[0]); py[0] = (int)lroundf(s->v[1]);
+            m = 1;
+        } else {
+            return 0;
+        }
+        if (i > 0 && ti != tt) return 0;
+        tt = ti;
+        for (int k = 0; k < m; k++) {
+            x1 = msp_imin(x1, px[k]); x2 = msp_imax(x2, px[k]);
+            y1 = msp_imin(y1, py[k]); y2 = msp_imax(y2, py[k]);
+        }
+    }
+    if (tt > MSP_BRUSH_MAX - 4) return 0;
+    const int pad = msp_iceil((float)tt * 0.5f) + 2;
+    box->x1 = x1 - pad;
+    box->y1 = y1 - pad;
+    box->w  = x2 - x1 + 2 * pad + 1;
+    box->h  = y2 - y1 + 2 * pad + 1;
+    *t      = tt;
+    *opa    = sh[0].opa;
+    return 1;
+}
+
+/* Draw the stroke into the mask (box->w by box->h bytes). `brush` is filled for this thickness on first use. */
+static inline void msp_stroke_render(const ml_shape_t* sh, int n, const msp_box_t* box, int t, msp_brush_t* brush, uint8_t* m)
+{
+    if (brush->t != msp_imax(1, msp_imin(t, MSP_BRUSH_MAX - 4))) msp_brush_make(brush, t);
+    memset(m, 0, (size_t)box->w * (size_t)box->h);
+    for (int i = 0; i < n; i++) {
+        const ml_shape_t* s = &sh[i];
+        float x0, y0, x1, y1;
+        if (s->kind == ML_SH_LINE) {
+            x0 = (float)lroundf(s->v[0]); y0 = (float)lroundf(s->v[1]);
+            x1 = (float)lroundf(s->v[2]); y1 = (float)lroundf(s->v[3]);
+        } else {
+            x0 = x1 = (float)lroundf(s->v[0]);
+            y0 = y1 = (float)lroundf(s->v[1]);
+        }
+        /* LVGL draws a line through the middle of the pixels its end points name, so the brush centre is half a pixel in */
+        x0 += 0.5f - (float)box->x1; x1 += 0.5f - (float)box->x1;
+        y0 += 0.5f - (float)box->y1; y1 += 0.5f - (float)box->y1;
+        const float dx = x1 - x0, dy = y1 - y0;
+        const int steps = msp_imax(1, msp_imax((int)fabsf(dx), (int)fabsf(dy)));
+        for (int k = 0; k <= steps; k++) {
+            const float f  = (float)k / (float)steps;
+            const int qx = (int)lroundf((x0 + dx * f) * 2.0f), qy = (int)lroundf((y0 + dy * f) * 2.0f);
+            const int ph = (qx & 1) + 2 * (qy & 1);
+            msp_brush_stamp(brush, ph, m, box->w, box->h, (qx >> 1) - brush->c, (qy >> 1) - brush->c);
