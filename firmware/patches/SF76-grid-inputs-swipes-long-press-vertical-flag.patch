+#define MGS_F_GAME_VERT 8 /* patch SF76: the running game takes vertical swipes inside its play area (2048, Snake): a swipe down stops it only from the bottom edge */
+#define MGS_GAME_STOP_Y 224 /* with MGS_F_GAME_VERT: a swipe down that began at or below this stops the game (the bottom edge); the grabber at the top has its own dismiss */
 
