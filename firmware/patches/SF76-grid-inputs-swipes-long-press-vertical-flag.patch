diff --git a/firmware/main/hal/maipai_grid_input_core.h b/firmware/main/hal/maipai_grid_input_core.h
new file mode 100644
--- /dev/null
+++ b/firmware/main/hal/maipai_grid_input_core.h
@@ -0,0 +1,31 @@
+/*
+ * SPDX-License-Identifier: MIT
+ *
+ * The grid games' touch classifier (patch SF76): one finger, from where it began to where it lifted, becomes a tap, a long press (still for at least 450 ms) or a swipe in one of
+ * four directions. The swipe rule is the unit's (maipai_gesture_core.h mgs_swipe_of: at least a minimum distance, quick enough, mostly in one direction); a touch that moves a little
+ * is still a tap or a long press. Plain C99; host test grid_input_test.c.
+ */
+#ifndef MAIPAI_GRID_INPUT_CORE_H
+#define MAIPAI_GRID_INPUT_CORE_H
+
+#include <stdint.h>
+#include "maipai_gesture_core.h"
+
+#define GI_LONG_PRESS_MS 450u
+
+enum { GI_NONE = 0, GI_TAP, GI_LONG, GI_SWIPE_UP, GI_SWIPE_DOWN, GI_SWIPE_LEFT, GI_SWIPE_RIGHT };
+
+static inline int gi_classify(int x0, int y0, int x1, int y1, uint32_t held_ms)
+{
+    const mgs_swipe_t sw = mgs_swipe_of(x0, y0, x1, y1, held_ms);
+    if (sw == MGS_SW_UP) return GI_SWIPE_UP;
+    if (sw == MGS_SW_DOWN) return GI_SWIPE_DOWN;
+    if (sw == MGS_SW_LEFT) return GI_SWIPE_LEFT;
+    if (sw == MGS_SW_RIGHT) return GI_SWIPE_RIGHT;
+    if (mgs_abs(x1 - x0) <= MGS_TAP_MAX_PX && mgs_abs(y1 - y0) <= MGS_TAP_MAX_PX) {
+        return held_ms >= GI_LONG_PRESS_MS ? GI_LONG : (held_ms <= MGS_TAP_MAX_MS ? GI_TAP : GI_NONE);
+    }
+    return GI_NONE; /* a slow drag */
+}
+
+#endif /* MAIPAI_GRID_INPUT_CORE_H */
