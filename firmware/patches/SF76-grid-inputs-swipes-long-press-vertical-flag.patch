+// Mine Finder: one finger, acted on at the lift.
+void mines_act(Grid* g, int x, int y, bool long_press)
+{
+    const int idx = gr_cell_at(&g->lay, x, y);
+    if (idx < 0) return;
+    const uint32_t now = now_ms();
+    const bool flag = long_press || g->flag_mode;
+    if (g->start_ms == 0 && !flag) g->start_ms = now;
+    const int r = flag ? gmn_flag(&g->mines, idx) : gmn_reveal(&g->mines, idx);
+    if (r == GMN_IGNORED) return;
+    cue(r == GMN_BOOM ? GR_CUE_LOSE : (r == GMN_CLEARED ? GR_CUE_WIN : GR_CUE_TAP));
+    if (!flag) gan_pop(&g->anim, now, idx);
+    redraw(g);
+    if (r == GMN_BOOM) finish(g, GR_UNIT_WON);
+    else if (r == GMN_CLEARED) finish(g, GR_PERSON_WON);
+}
+
 void maipai_grid_release(int x0, int y0, int x1, int y1, uint32_t held_ms)
 {
-    if (s_grid != nullptr && mg_drag_dismiss(x0, y0, x1, y1, held_ms)) end_locked("dragbar");  // a swipe down from the grabber ends the game
+    Grid* g = s_grid;
+    if (g == nullptr) return;
+    if (mg_drag_dismiss(x0, y0, x1, y1, held_ms)) {  // a swipe down from the grabber ends the game
+        end_locked("dragbar");
+        return;
+    }
+    if (g->kind == kMines && g->press_valid && g->result == GR_PLAYING) {
+        g->press_valid = 0;
+        g->last_input_ms = now_ms();
+        const int what = gi_classify(g->press_x, g->press_y, x1, y1, held_ms);
+        if (what == GI_TAP) mines_act(g, g->press_x, g->press_y, false);
+        else if (what == GI_LONG) mines_act(g, g->press_x, g->press_y, true);
+    }
 }
 
+bool maipai_grid_wants_vertical() { return s_vertical.load(); }
