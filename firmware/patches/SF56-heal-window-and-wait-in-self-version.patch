+                cJSON_AddStringToObject(root, "heal_boot_why", maipai_heal_boot_why());             // why the restart before this boot was made ("" after a power-on or a crash)
                 cJSON_AddStringToObject(root, "reset_reason", esp_reset_reason() == ESP_RST_POWERON ? "power_on" : (esp_reset_reason() == ESP_RST_SW ? "software" :
                                         (esp_reset_reason() == ESP_RST_PANIC ? "panic" : (esp_reset_reason() == ESP_RST_TASK_WDT ? "task_watchdog" : "other"))));
