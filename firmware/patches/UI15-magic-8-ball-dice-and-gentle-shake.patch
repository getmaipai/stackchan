+/*
+ * Patch UI15: the gentle shake. Owner rule: nobody should have to shake the unit hard, so a small quick wobble of a few centimeters counts,
+ * and a very violent shake does not (the game answers "Easy!" and gives no points). Samples come every 20 ms (50 Hz).
+ *
+ * The pull's slow part (gravity, the pose) is followed by a low pass filter (time constant about 0.25 s) and taken away; what is left is
+ * the motion. On the axis that moves most, a swing that reaches 2.2 m/s^2 (0.22 g) on one side and then the other counts as a stroke.
+ * Three strokes within 0.9 s are a shake. A wobble of 3 cm at 3 Hz is about 10 m/s^2 and a wobble of 1 cm at 2.5 Hz about 2.5 m/s^2, so
+ * both count; a tap on the table, a slow tilt or a lone bump does not (one stroke, or none). If the motion reaches 20 m/s^2 (2 g) in the
+ * same window the shake is "too hard": it returns MGI_SHAKE_EASY instead and the game gives no points.
+ */
+#define MGI_SHAKE_LP 0.08f
+#define MGI_SHAKE_STROKE 2.2f
+#define MGI_SHAKE_STROKES 3
+#define MGI_SHAKE_WINDOW_MS 900u
+#define MGI_SHAKE_TOO_HARD 20.0f
+#define MGI_SHAKE_REFRACT_MS 800u
+
+typedef enum { MGI_SHAKE_NONE = 0, MGI_SHAKE_OK, MGI_SHAKE_EASY } mgi_shake_result_t;
+
+typedef struct {
+    float base[3];
+    int primed, axis, last_sign, strokes;
+    uint32_t first_ms, hard_ms, quiet_until_ms;
+    int hard;
+} mgi_shake_t;
+
+static inline void mgi_shake_init(mgi_shake_t* k)
+{
+    memset(k, 0, sizeof(*k));
+    k->axis = -1;
+}
+
+/* One accelerometer sample (m/s^2, every 20 ms). Returns MGI_SHAKE_OK, MGI_SHAKE_EASY or MGI_SHAKE_NONE. */
+static inline int mgi_shake_update(mgi_shake_t* k, float x, float y, float z, uint32_t now_ms)
+{
+    const float in[3] = {x, y, z};
+    if (!k->primed) {
+        memcpy(k->base, in, sizeof(k->base));
+        k->primed = 1;
+        return MGI_SHAKE_NONE;
+    }
+    float dev[3], m2 = 0.0f;
+    int axis = 0;
+    for (int i = 0; i < 3; i++) {
+        dev[i] = in[i] - k->base[i];
+        k->base[i] += MGI_SHAKE_LP * dev[i];
+        m2 += dev[i] * dev[i];
+        if (mgi_abs(dev[i]) > mgi_abs(dev[axis])) {
+            axis = i;
+        }
+    }
+    if ((int32_t)(now_ms - k->quiet_until_ms) < 0) {
+        return MGI_SHAKE_NONE;
+    }
+    if (k->strokes > 0 && now_ms - k->first_ms > MGI_SHAKE_WINDOW_MS) {
+        k->strokes = 0;
+        k->hard    = 0;
+        k->axis    = -1;
+    }
+    if (m2 >= MGI_SHAKE_TOO_HARD * MGI_SHAKE_TOO_HARD) {
+        k->hard    = 1;
+        k->hard_ms = now_ms;
+    }
+    if (mgi_abs(dev[axis]) >= MGI_SHAKE_STROKE) {
+        const int sign = dev[axis] > 0 ? 1 : -1;
+        if (axis != k->axis) {
+            k->axis      = axis;
+            k->last_sign = 0;
+        }
+        if (sign != k->last_sign) {
+            k->last_sign = sign;
+            if (k->strokes == 0) {
+                k->first_ms = now_ms;
+            }
+            k->strokes++;
+        }
+    }
+    if (k->strokes >= MGI_SHAKE_STROKES || (k->hard && k->strokes >= 2)) {
+        const int hard = k->hard;
+        k->strokes = 0;
+        k->hard    = 0;
+        k->axis    = -1;
+        k->quiet_until_ms = now_ms + MGI_SHAKE_REFRACT_MS;
+        return hard ? MGI_SHAKE_EASY : MGI_SHAKE_OK;
+    }
+    return MGI_SHAKE_NONE;
+}
+
 #endif
