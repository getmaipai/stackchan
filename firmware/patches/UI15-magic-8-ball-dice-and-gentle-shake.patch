+
+bool clip_ready(int clip)
+{
+    if (clip < 0 || clip >= MGS_CLIPS) {
+        return false;
+    }
+    if (s_clip_buf[clip] != nullptr) {
+        return true;
+    }
+    const size_t want = mgs_clip_samples(clip);
+    s_clip_buf[clip]  = static_cast<int16_t*>(heap_caps_malloc(want * sizeof(int16_t), MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT));
+    if (s_clip_buf[clip] == nullptr) {
+        return false;
+    }
+    s_clip_n[clip] = mgs_render(clip, s_clip_buf[clip], want);
+    return s_clip_n[clip] > 0;
+}
+
+// Renders every clip a pack's rules can ask for (a group's members, the cue clips a counter may pick), once, at the game's start.
+void clips_prepare(const mg_pack_t& p)
+{
+    for (int i = 0; i < p.n_actions; i++) {
+        const uint8_t* a = p.b + p.o_actions + static_cast<size_t>(i) * MG_ACTION_SIZE;
+        if (a[0] == MG_OP_TONE_CTR) {
+            for (int c = MGS_C_CUE0; c <= MGS_C_CUE5; c++) (void)clip_ready(c);
+        } else if (a[0] == MG_OP_TONE && a[1] >= MGS_TONE_GROUP && a[1] < MGS_TONE_GROUP + MGS_GROUPS) {
+            const int g = a[1] - MGS_TONE_GROUP;
+            for (int k = 0; k < MGS_GROUP[g].n; k++) (void)clip_ready(MGS_GROUP[g].clip[k]);
+        } else if (a[0] == MG_OP_TONE && a[1] >= MGS_TONE_SHIPPED && a[1] < MGS_TONE_SHIPPED + MGS_CLIPS) {
+            (void)clip_ready(a[1] - MGS_TONE_SHIPPED);
+        }
     }
 }
 
