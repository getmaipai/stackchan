+/* ---- motion (patch UI15) ----
+ * Called every 30 ms tick of a running game (and by the host renderer for keyframes). It only moves, resizes or fades the few objects a
+ * game's moment needs and only inside that moment's window, so a still screen costs nothing: the mole pops up with an ease-out overshoot and
+ * is squashed when struck, with stars circling; dice hop in turn and bounce on landing, the coin flips (its width goes through edge-on),
+ * bounces and glints; the eight ball wobbles with a damped spring when shaken and its window fades in and floats; the Rock Paper Scissors
+ * hands bump with each beat and the unit's pick fades in; the Tic-Tac-Toe marks draw themselves in; Do It's called tile pulses. All of it
+ * is arithmetic on existing objects: no allocation, no new object. Returns true while something still moves (the caller keeps ticking). */
+inline float ease_out(float p) { p = p < 0 ? 0 : (p > 1 ? 1 : p); return 1.0f - (1.0f - p) * (1.0f - p) * (1.0f - p); }
+inline float ease_back(float p)
+{
+    p = p < 0 ? 0 : (p > 1 ? 1 : p);
+    const float c1 = 1.70158f, c3 = c1 + 1.0f, q = p - 1.0f;
+    return 1.0f + c3 * q * q * q + c1 * q * q;
+}
+
+inline void shape_origin(const mg_shape_t& s, int* x, int* y)
+{
+    switch (s.type) {
+        case MG_SH_CIRCLE: case MG_SH_RING: *x = s.x - s.w; *y = s.y - s.w; break;
+        case MG_SH_TEXT: *x = s.x - (s.w > 0 ? s.w : 280) / 2; *y = s.y - lv_font_get_line_height(font_for(s.aux)) / 2; break;
+        default: *x = s.x; *y = s.y; break;
+    }
+}
+
+inline bool animate(const mg_run_t& r, lv_obj_t* const* obj, const uint8_t* type, lv_point_precise_t (*pts)[2], Parts* P, uint32_t now)
+{
+    bool busy = false;
+    const mg_pack_t* pk = r.p;
+    const bool is_ball = strcmp(pk->id, "eightball") == 0, is_rps = strcmp(pk->id, "rps") == 0, is_ttt = strcmp(pk->id, "tictactoe") == 0,
+               is_bop = strcmp(pk->id, "bopit") == 0;
+    const float t_state = (float)(now - P->state_ms);
+    for (int i = 0; i < pk->n_shapes; i++) {
+        lv_obj_t* o = obj[i];
+        if (o == nullptr || !P->shown[i]) {
+            continue;
+        }
+        mg_shape_t s;
+        mg_shape_get(pk, i, &s);
+        const float t_app = (float)(now - P->appear_ms[i]);
+        if (type[i] == MG_SH_MOLE) {
+            const float t = (float)(now - P->mole_ms);
+            const int face = r.ctr[s.aux];
+            int bx, by;
+            mole_place(pk, mg_mole_region(&r, &s), &bx, &by);
+            if (t < 330.0f || (face == MG_FACE_DAZED && t < 460.0f)) {
+                const float pop = t < 240.0f ? (1.0f - ease_back(t / 240.0f)) * 30.0f : 0.0f;
+                const float sq  = face == MG_FACE_DAZED ? 0.14f * (1.0f - ease_out(t / 220.0f)) : 0.0f;  // struck: squashed, then settles
+                const int size  = (int)((s.w > 0 ? s.w : 30) * (1.0f + sq));
+                const int orbit = face == MG_FACE_DAZED ? (int)(6.0f * sinf(t / 90.0f)) : 0;
+                mole_apply(&P->mole, bx, by + (int)pop, face, size, orbit, face == MG_FACE_DAZED ? (int)(2.0f * cosf(t / 90.0f)) : 0);
+                busy = true;
+            } else {
+                mole_apply(&P->mole, bx, by, face, s.w > 0 ? s.w : 30);
+            }
+        } else if (type[i] == MG_SH_DIE) {
+            for (int k = 0; k < P->n_dice; k++) {
+                if (P->die[k].box != o) continue;
+                const float t = (float)(now - P->die_ms[k]) - 90.0f * (float)k;  // the second die follows the first by 90 ms
+                float y = 0, x = 0;
+                if (t >= 0 && t < 90.0f) {
+                    y = -9.0f * sinf(3.14159f * t / 90.0f);
+                    x = ((P->die_val[k] & 1) ? 2.0f : -2.0f) * sinf(3.14159f * t / 90.0f);
+                } else if (t >= 100.0f && t < 450.0f) {
+                    y = -4.0f * expf(-(t - 100.0f) / 90.0f) * fabsf(sinf((t - 100.0f) / 38.0f));  // landing: bounces and settles
+                }
+                if (t < 450.0f) busy = true;
+                lv_obj_set_pos(o, s.x - s.w / 2 + (int)x, s.y - s.w / 2 + (int)y);
+            }
+        } else if (type[i] == MG_SH_COIN) {
+            const float t = (float)(now - P->coin_ms);
+            float y = 0;
+            if (P->coin_face == 2) y = -12.0f * sinf(t / 70.0f); else if (t < 420.0f) y = -9.0f * expf(-t / 110.0f) * fabsf(sinf(t / 42.0f));
+            const int w = lv_obj_get_width(o);
+            lv_obj_set_pos(o, s.x - w / 2, s.y - s.w / 2 + (int)y);
+            lv_obj_t* glint = P->coin.part[4];
+            if (P->coin_face != 2 && t < 260.0f) {  // a glint runs across the face after it lands
+                const int inner = s.w - 8;
+                lv_obj_set_size(glint, inner / 8, inner / 3);
+                lv_obj_set_pos(glint, (int)((inner - inner / 8) * (t / 260.0f)), inner / 6);
+                lv_obj_set_style_bg_color(glint, lv_color_hex(0xfff4b0), 0);
+                lv_obj_remove_flag(glint, LV_OBJ_FLAG_HIDDEN);
+            } else {
+                lv_obj_add_flag(glint, LV_OBJ_FLAG_HIDDEN);
+            }
+            if (P->coin_face == 2 || t < 420.0f) busy = true;
+        } else if (is_ball && ((i >= 1 && i <= 10) || (type[i] == MG_SH_TEXT && s.y >= 80 && s.y <= 100 && s.x == 160))) {
+            // the ball wobbles with a damped spring from the moment it is shaken; the window and the answer fade in and then float
+            const float tk = (float)(now - P->state_ms);
+            const bool shaking = r.state == 1, answered = r.state == 2;
+            float dx = 0, dy = 0;
+            if (shaking) {
+                dx = 14.0f * expf(-tk / 650.0f) * sinf(tk / 48.0f);
+                dy = 3.0f * cosf(tk / 48.0f);
+                busy = true;
+            } else if (answered) {
+                dx = 14.0f * expf(-(tk + 1100.0f) / 650.0f) * sinf((tk + 1100.0f) / 48.0f);
+                if (i >= 4) dy = 2.0f * sinf((float)now / 380.0f);  // the window floats gently
+                busy = true;
+            }
+            int ox, oy;
+            shape_origin(s, &ox, &oy);
+            lv_obj_set_pos(o, ox + (int)dx, oy + (int)dy);
+            if (i >= 4 && answered && tk < 380.0f) {
+                lv_obj_set_style_opa(o, (lv_opa_t)(255.0f * ease_out(tk / 380.0f)), 0);  // fades in out of the fog
+                P->faded[i] = 1;
+            } else if (P->faded[i]) {
+                lv_obj_set_style_opa(o, LV_OPA_COVER, 0);
+                P->faded[i] = 0;
+            }
+        } else if (is_rps && i >= 13 && i < 30 && r.state >= 2 && r.state <= 5) {
+            const float p = t_state / 380.0f;  // the hands bump once a beat; the last, "shoot", bumps higher
+            const float bump = sinf(3.14159f * (p > 1 ? 1 : p)) * (r.state == 5 ? 8.0f : 5.0f);
+            lv_obj_set_y(o, -(int)bump);
+            busy = true;
+        } else if (is_rps && i >= 13 && i < 30 && r.state >= 7) {
+            lv_obj_set_y(o, 0);
+        } else if (is_rps && i >= 7 && i <= 9 && r.state >= 7) {
+            if (t_state < 240.0f) {
+                lv_obj_set_style_opa(o, (lv_opa_t)(255.0f * ease_out(t_state / 240.0f)), 0);  // the unit's pick pops in
+                P->faded[i] = 1;
+                busy = true;
+            } else if (P->faded[i]) {
+                lv_obj_set_style_opa(o, LV_OPA_COVER, 0);
+                P->faded[i] = 0;
+            }
+        } else if (is_ttt && type[i] == MG_SH_LINE && t_app < 330.0f) {
+            const float delay = s.w < s.x ? 110.0f : 0.0f;  // the second stroke of an X follows the first
+            const float p     = ease_out((t_app - delay) / 200.0f);
+            pts[i][1].x = (lv_value_precise_t)(s.x + (s.w - s.x) * p);
+            pts[i][1].y = (lv_value_precise_t)(s.y + (s.h - s.y) * p);
+            lv_line_set_points(o, pts[i], 2);
+            busy = true;
+        } else if (is_ttt && type[i] == MG_SH_LINE && t_app >= 330.0f && (pts[i][1].x != s.w || pts[i][1].y != s.h)) {
+            pts[i][1].x = s.w;
+            pts[i][1].y = s.h;
+            lv_line_set_points(o, pts[i], 2);
+        } else if (is_ttt && type[i] == MG_SH_RING && t_app < 300.0f) {
+            const float k = 0.3f + 0.7f * ease_back(t_app / 260.0f);  // an O grows in with a little overshoot
+            const int d   = (int)(2.0f * s.w * k);
+            lv_obj_set_size(o, d, d);
+            lv_obj_set_pos(o, s.x - d / 2, s.y - d / 2);
+            busy = true;
+        } else if (is_ttt && type[i] == MG_SH_RING && t_app >= 300.0f && lv_obj_get_width(o) != 2 * s.w) {
+            lv_obj_set_size(o, 2 * s.w, 2 * s.w);
+            lv_obj_set_pos(o, s.x - s.w, s.y - s.w);
+        } else if (is_bop && i >= 9 && i <= 14 && r.state == 2) {
+            lv_obj_set_style_opa(o, (lv_opa_t)(215.0f + 40.0f * sinf((float)now / 120.0f)), 0);  // the called tile pulses
+            P->faded[i] = 1;
+            busy = true;
+        } else if (is_bop && i >= 9 && i <= 14 && P->faded[i]) {
+            lv_obj_set_style_opa(o, LV_OPA_COVER, 0);
+            P->faded[i] = 0;
+        }
+    }
+    return busy;
+}
+
