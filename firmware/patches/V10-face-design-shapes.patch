+// The approved design, one eased step (patch V10): the spring of the pose, the gaze, then the shapes of this eye; what changed is
+// invalidated, nothing else.
+void DefaultEyes::update_art(uint32_t ms)
+{
+    const int64_t now    = esp_timer_get_time();
+    const ml_style_t* st = ml_style(_style);
+    if (!s_spring_init) {
+        ml_pose_target(st, _emotion, s_thinking, s_target);
+        ml_spring_snap(&s_spring, s_target);
+        s_spring_init = true;
+        s_spring_us   = now;
+    }
+    if (now - s_spring_us >= 5000) {
+        const float dts = static_cast<float>(now - s_spring_us) / 1000000.0f;
+        s_spring_us     = now;
+        ml_pose_target(st, _emotion, s_thinking, s_target);
+        ml_spring_step(&s_spring, s_target, dts);
+    }
+    if (!s_drift_init) {
+        mx_drift_init(&s_drift, 0x9E3779B9u);
+        s_drift_init = true;
+    }
+    if (now - s_drift_us >= 5000) {
+        const float dts = static_cast<float>(now - s_drift_us) / 1000.0f;
+        s_drift_us      = now;
+        const int amp   = (int)lroundf((float)st->drift * ml_pose_drift_scale(_emotion));
+        mx_drift_step(&s_drift, static_cast<uint32_t>(now / 1000), dts > 200.0f ? 200.0f : dts, (_visible && _sw_eff > 40.0f) ? amp : 0);
+    }
+    const float* P  = s_spring.x;
+    const int side  = _is_left_eye ? -1 : 1;
+    const float fx  = _eye_min_offset.x + (_sx + 100.0f) * (_eye_max_offset.x - _eye_min_offset.x) / 200.0f;
+    const float fy  = _eye_min_offset.y + (_sy + 100.0f) * (_eye_max_offset.y - _eye_min_offset.y) / 200.0f;
+    const float gx  = fx + s_drift.x + P[MP_GX];
+    const float gy  = fy + s_drift.y + P[MP_GY];
+    const float es  = side > 0 ? P[MP_RSCALE] : 1.0f;
+    ml_eye_in_t in;
+    memset(&in, 0, sizeof(in));
+    in.st    = st;
+    in.side  = side;
+    in.ew    = P[MP_EW] * es;
+    in.eh    = P[MP_EH] * es;
+    in.lid   = 1.0f - (_sw_eff < 0.0f ? 0.0f : (_sw_eff > 100.0f ? 100.0f : _sw_eff)) / 100.0f;
+    in.slant = P[MP_SLANT];
+    in.cheek = P[MP_CHEEK];
+    in.blink = s_blink;
+    in.heart = P[MP_HEART];
+    in.beat  = 1.0f + 0.14f * powf(fmaxf(0.0f, sinf(6.2831853f * 1.2f * (float)(ms % 100000u) / 1000.0f)), 3.0f);
+    in.closed = ml_clamp01f((26.0f - _sw_eff) / 12.0f);
+    in.gx     = gx;
+    in.gy     = gy;
+    in.voice  = g_ml_voice;
+    _d_now    = in.eh;
+    const int ox = (int)lroundf(gx), oy = (int)lroundf(P[MP_DY] + gy + (side > 0 ? P[MP_RLIFT] : 0.0f));
+    // shapes are made around the eye's own centre; the gaze moves the centre, the pupil moves 1.3 times as far
+    ml_shape_t tmp[ML_MAX_SHAPES];
+    const int n = ml_eye_shapes(&in, tmp, ML_MAX_SHAPES);
+    for (int i = 0; i < n; i++) {  // whole pixels: what the unit can draw, and a stable key
+        for (int k = 0; k < 8; k++) {
+            tmp[i].v[k] = roundf(tmp[i].v[k]);
+        }
+    }
+    const bool vis = _visible;
+    if (n != _nsh || ox != _ox || oy != _oy || memcmp(tmp, _sh, sizeof(ml_shape_t) * (size_t)n) != 0) {
+        int nb[4];
+        ml_shape_list_bounds(tmp, n, nb);
+        lv_area_t a;
+        lv_obj_get_coords(_art, &a);
+        const int cx = (a.x1 + a.x2) / 2, cy = (a.y1 + a.y2) / 2;
+        if (vis) {
+            if (_nsh > 0) {
+                lv_area_t o = {cx + _ox + _bb[0], cy + _oy + _bb[1], cx + _ox + _bb[2], cy + _oy + _bb[3]};
+                lv_obj_invalidate_area(_art, &o);
+            }
+            if (n > 0) {
+                lv_area_t o = {cx + ox + nb[0], cy + oy + nb[1], cx + ox + nb[2], cy + oy + nb[3]};
+                lv_obj_invalidate_area(_art, &o);
+            }
+        }
+        memcpy(_sh, tmp, sizeof(ml_shape_t) * (size_t)n);
+        _nsh = n;
+        _ox  = ox;
+        _oy  = oy;
+        for (int k = 0; k < 4; k++) {
+            _bb[k] = nb[k];
+        }
+    }
+    // the brow
+    ml_shape_t bs[2];
+    const int bn = ml_brow_shapes(st, side, P[MP_EW] * es, P[MP_EH] * es, es, gx, side > 0 ? P[MP_RLIFT] : 0.0f, P[MP_BR], P[MP_BROW],
+                                  P[MP_BLIFT], P[MP_BTILT], bs, 2);
+    for (int i = 0; i < bn; i++) {
+        for (int k = 0; k < 8; k++) {
+            bs[i].v[k] = roundf(bs[i].v[k]);
+        }
+    }
+    const int bx = 0, by = 0;
+    if (bn != _nbsh || bx != _bbx || by != _bby || memcmp(bs, _bsh, sizeof(ml_shape_t) * (size_t)bn) != 0) {
+        int nb[4];
+        ml_shape_list_bounds(bs, bn, nb);
+        lv_area_t a;
+        lv_obj_get_coords(_brow, &a);
+        const int cx = (a.x1 + a.x2) / 2, cy = (a.y1 + a.y2) / 2 + 60;
+        if (vis) {
+            if (_nbsh > 0) {
+                lv_area_t o = {cx + _bbb[0], cy + _bbb[1], cx + _bbb[2], cy + _bbb[3]};
+                lv_obj_invalidate_area(_brow, &o);
+            }
+            if (bn > 0) {
+                lv_area_t o = {cx + nb[0], cy + nb[1], cx + nb[2], cy + nb[3]};
+                lv_obj_invalidate_area(_brow, &o);
+            }
+        }
+        memcpy(_bsh, bs, sizeof(ml_shape_t) * (size_t)bn);
+        _nbsh = bn;
+        for (int k = 0; k < 4; k++) {
+            _bbb[k] = nb[k];
+        }
+    }
+}
+
+void DefaultEyes::drawArt(lv_event_t* e)
+{
+    lv_layer_t* layer = lv_event_get_layer(e);
+    if (layer == nullptr || _art == nullptr || !_art_mode || !_visible) {
+        return;
+    }
+    lv_area_t a;
+    lv_obj_get_coords(_art, &a);
+    ml_draw_shape_list(layer, _sh, _nsh, (a.x1 + a.x2) / 2 + _ox, (a.y1 + a.y2) / 2 + _oy, _fg, _bg);
+}
+
+void DefaultEyes::drawBrow(lv_event_t* e)
+{
+    lv_layer_t* layer = lv_event_get_layer(e);
+    if (layer == nullptr || _brow == nullptr || !_art_mode || !_visible) {
+        return;
+    }
+    lv_area_t a;
+    lv_obj_get_coords(_brow, &a);
+    ml_draw_shape_list(layer, _bsh, _nbsh, (a.x1 + a.x2) / 2, (a.y1 + a.y2) / 2 + 60, _fg, _bg);
+}
