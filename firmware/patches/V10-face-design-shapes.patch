+// Draw a shape list around (cx, cy). Rounded boxes, circles, a border ring, triangles (a quad is four, so no seam shows
+// between them) and round-ended lines: no mask and no layer.
+static void draw_shapes(lv_layer_t* layer, const ml_shape_t* sh, int n, int cx, int cy, lv_color_t fg, lv_color_t bg)
+{
+    for (int i = 0; i < n; i++) {
+        const ml_shape_t& s = sh[i];
+        const lv_color_t col = s.col == ML_COL_BG ? bg : fg;
+        switch (s.kind) {
+            case ML_SH_RRECT:
+            case ML_SH_CIRCLE:
+            case ML_SH_RING: {
+                lv_draw_rect_dsc_t rd;
+                lv_draw_rect_dsc_init(&rd);
+                lv_area_t a;
+                float w, h, r;
+                if (s.kind == ML_SH_CIRCLE) {
+                    w = h = s.v[2] * 2.0f;
+                    r     = s.v[2];
+                } else {
+                    w = s.v[2];
+                    h = s.v[3];
+                    r = s.v[4];
+                }
+                int band = 0;
+                if (s.kind == ML_SH_RING) {
+                    band = (int)lroundf(s.v[5]);
+                    w += 2.0f * band;
+                    h += 2.0f * band;
+                    r += band;
+                    rd.bg_opa       = LV_OPA_TRANSP;
+                    rd.border_color = col;
+                    rd.border_opa   = s.opa;
+                    rd.border_width = band;
+                    rd.border_side  = LV_BORDER_SIDE_FULL;
+                } else {
+                    rd.bg_color = col;
+                    rd.bg_opa   = s.opa;
+                }
+                a.x1 = cx + (int)lroundf(s.v[0] - w * 0.5f);
+                a.y1 = cy + (int)lroundf(s.v[1] - h * 0.5f);
+                a.x2 = a.x1 + (int)lroundf(w) - 1;
+                a.y2 = a.y1 + (int)lroundf(h) - 1;
+                rd.radius = (int)lroundf(r);
+                lv_draw_rect(layer, &rd, &a);
+                break;
+            }
+            case ML_SH_QUAD: {
+                lv_draw_triangle_dsc_t td;
+                lv_draw_triangle_dsc_init(&td);
+                td.color = col;
+                td.opa   = s.opa;
+                lv_point_precise_t p[4];
+                for (int k = 0; k < 4; k++) {
+                    p[k].x = cx + (int)lroundf(s.v[k * 2]);
+                    p[k].y = cy + (int)lroundf(s.v[k * 2 + 1]);
+                }
+                static const int tri[4][3] = {{0, 1, 2}, {0, 2, 3}, {0, 1, 3}, {1, 2, 3}};
+                for (int t = 0; t < 4; t++) {
+                    for (int k = 0; k < 3; k++) {
+                        td.p[k] = p[tri[t][k]];
+                    }
+                    lv_draw_triangle(layer, &td);
+                }
+                break;
+            }
+            case ML_SH_LINE: {
+                lv_draw_line_dsc_t ld;
+                lv_draw_line_dsc_init(&ld);
+                ld.color       = col;
+                ld.opa         = s.opa;
+                ld.width       = (int)lroundf(s.v[4]) < 1 ? 1 : (int)lroundf(s.v[4]);
+                ld.round_start = 1;
+                ld.round_end   = 1;
+                ld.p1.x        = cx + (int)lroundf(s.v[0]);
+                ld.p1.y        = cy + (int)lroundf(s.v[1]);
+                ld.p2.x        = cx + (int)lroundf(s.v[2]);
+                ld.p2.y        = cy + (int)lroundf(s.v[3]);
+                lv_draw_line(layer, &ld);
+                break;
+            }
+            case ML_SH_HEART: {  // the design's heart (two cubic curves), filled as a fan of triangles around a point inside it
+                lv_draw_triangle_dsc_t td;
+                lv_draw_triangle_dsc_init(&td);
+                td.color = col;
+                td.opa   = s.opa;
+                const float x = s.v[0], y = s.v[1], z = s.v[2];
+                static const float C[2][4][2] = {{{0, .48f}, {-.95f, -.05f}, {-.52f, -.72f}, {0, -.22f}},
+                                                 {{0, -.22f}, {.52f, -.72f}, {.95f, -.05f}, {0, .48f}}};
+                const int H = 14;
+                lv_point_precise_t pts[2 * H + 1];
+                int m = 0;
+                for (int c = 0; c < 2; c++) {
+                    for (int k = (c == 0 ? 0 : 1); k <= H; k++) {
+                        const float t = (float)k / (float)H, u = 1.0f - t;
+                        const float bx = u * u * u * C[c][0][0] + 3 * u * u * t * C[c][1][0] + 3 * u * t * t * C[c][2][0] + t * t * t * C[c][3][0];
+                        const float by = u * u * u * C[c][0][1] + 3 * u * u * t * C[c][1][1] + 3 * u * t * t * C[c][2][1] + t * t * t * C[c][3][1];
+                        pts[m].x = cx + (int)lroundf(x + bx * z);
+                        pts[m].y = cy + (int)lroundf(y + by * z);
+                        m++;
+                    }
+                }
+                // two fans around two different points inside the heart: the seams of one lie inside the triangles of the other
+                for (int f = 0; f < 2; f++) {
+                    lv_point_precise_t mid;
+                    mid.x = cx + (int)lroundf(x);
+                    mid.y = cy + (int)lroundf(y + z * (f ? -0.1f : 0.1f));
+                    for (int k = 0; k + 1 < m; k++) {
+                        td.p[0] = mid;
+                        td.p[1] = pts[k];
+                        td.p[2] = pts[k + 1];
+                        lv_draw_triangle(layer, &td);
+                    }
+                }
+                break;
+            }
+            default: break;
+        }
+    }
+}
+
+// The pixel bounds of a shape list, relative to the list's origin.
+static void shapes_bounds(const ml_shape_t* sh, int n, int b[4])
+{
+    int x1 = 0x7fffffff, y1 = 0x7fffffff, x2 = -0x7fffffff, y2 = -0x7fffffff;
+    auto add = [&](float x, float y, float m) {
+        const int ix1 = (int)floorf(x - m) - 2, ix2 = (int)ceilf(x + m) + 2, iy1 = (int)floorf(y - m) - 2, iy2 = (int)ceilf(y + m) + 2;
+        x1 = ix1 < x1 ? ix1 : x1;
+        y1 = iy1 < y1 ? iy1 : y1;
+        x2 = ix2 > x2 ? ix2 : x2;
+        y2 = iy2 > y2 ? iy2 : y2;
+    };
+    for (int i = 0; i < n; i++) {
+        const ml_shape_t& s = sh[i];
+        switch (s.kind) {
+            case ML_SH_RRECT: add(s.v[0], s.v[1], (s.v[2] > s.v[3] ? s.v[2] : s.v[3]) * 0.5f); break;
+            case ML_SH_CIRCLE: add(s.v[0], s.v[1], s.v[2]); break;
+            case ML_SH_RING: add(s.v[0], s.v[1], (s.v[2] > s.v[3] ? s.v[2] : s.v[3]) * 0.5f + s.v[5]); break;
+            case ML_SH_QUAD:
+                for (int k = 0; k < 4; k++) add(s.v[k * 2], s.v[k * 2 + 1], 0);
+                break;
+            case ML_SH_LINE:
+                add(s.v[0], s.v[1], s.v[4] * 0.5f + 1);
+                add(s.v[2], s.v[3], s.v[4] * 0.5f + 1);
+                break;
+            case ML_SH_HEART: add(s.v[0], s.v[1], s.v[2] * 1.1f); break;
+            default: break;
+        }
+    }
+    if (n == 0) {
+        x1 = y1 = x2 = y2 = 0;
+    }
+    b[0] = x1; b[1] = y1; b[2] = x2; b[3] = y2;
+}
+
+void stackchan::avatar::ml_draw_shape_list(lv_layer_t* layer, const ml_shape_t* sh, int n, int cx, int cy, lv_color_t fg, lv_color_t bg)
+{
+    draw_shapes(layer, sh, n, cx, cy, fg, bg);
+}
+
+void stackchan::avatar::ml_shape_list_bounds(const ml_shape_t* sh, int n, int b[4])
+{
+    shapes_bounds(sh, n, b);
+}
