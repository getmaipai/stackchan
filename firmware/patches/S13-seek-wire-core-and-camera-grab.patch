+int StackChanCamera::SeekGrab(uint8_t* gray)
+{
+    if (maipai_vision_off()) {
+        return 2;  // vision off: the sensor is not read, whoever asks
+    }
+    auto lock = TryLockFrame();
+    if (!lock.owns_lock()) {
+        return 1;  // the LAN video stream or a photo has the frame: not blocked on here
+    }
+    // The driver keeps one buffer, so the first read after a pause is the frame it filled long ago: read twice, keep the second.
+    if (!CaptureFrame(false, 1) || frame_.data == nullptr) {
+        return 2;
+    }
+    int fmt = MW_FMT_NONE;
+    switch (frame_.format) {
+        case V4L2_PIX_FMT_YUYV: fmt = MW_FMT_YUYV; break;
+        case V4L2_PIX_FMT_UYVY: fmt = MW_FMT_UYVY; break;
+        case V4L2_PIX_FMT_RGB565: fmt = MW_FMT_RGB565; break;
+        case V4L2_PIX_FMT_GREY: fmt = MW_FMT_GREY; break;
+        default: break;
+    }
+    const int rc = mw_downsample(frame_.data, frame_.len, frame_.width, frame_.height, fmt, gray);
+    heap_caps_free(frame_.data);  // the copy is 150 KB of PSRAM: not kept between bursts
+    frame_.data   = nullptr;
+    frame_.len    = 0;
+    frame_.format = 0;
+    return rc == 0 ? 0 : 2;
+}
