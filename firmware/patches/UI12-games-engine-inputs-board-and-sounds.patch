--- /dev/null
+++ b/firmware/main/hal/maipai_games_input_core.h
@@ -0,0 +1,112 @@
+/*
+ * SPDX-License-Identifier: MIT
+ *
+ * Game inputs from the unit's own sensors (patch UI12): the tilt detector and the swipe test, pure C99 with no ESP call and no clock of
+ * its own. The accelerometer sits in the head and reads about +1 g along the axis that points up (+y when the unit stands, measured
+ * 2026-10-22); a roll to the unit's right turns the pull toward +x, a roll to its left toward -x, face down toward -z and on its back
+ * toward +z (the host's orientation table). The detector works from the pose the unit rests in when the game starts, so a head that
+ * looks a little up or down does not read as a tilt.
+ *
+ * A tilt is the filtered pull leaving that rest pose by about 22 degrees (0.38 g) on one axis for two samples in a row; it must come
+ * back within 0.15 g before the next one counts, and none counts while the unit is being moved or shaken (the pull's length is not
+ * one g) or right after a shake. Samples come every 100 ms.
+ */
+#ifndef MAIPAI_GAMES_INPUT_CORE_H
+#define MAIPAI_GAMES_INPUT_CORE_H
+
+#include <stdint.h>
+#include <string.h>
+
+#define MGI_G 9.80665f
+#define MGI_ALPHA 0.6f
+#define MGI_TILT_G 0.38f        /* of one g: about 22 degrees */
+#define MGI_BACK_G 0.15f        /* the pull must return this close to the rest pose to re-arm */
+#define MGI_HOLD_SAMPLES 2
+#define MGI_MIN_MAG 7.0f        /* m/s^2: shorter or longer than one g means the unit is moving */
+#define MGI_MAX_MAG 12.6f
+#define MGI_SETTLE_SAMPLES 8    /* a pose held this long (0.8 s) becomes the rest pose */
+#define MGI_SETTLE_G 0.12f
+#define MGI_SHAKE_QUIET_MS 700u /* no tilt right after a shake */
+
+typedef enum { MGI_NONE = 0, MGI_LEFT, MGI_RIGHT, MGI_FORWARD, MGI_BACK } mgi_tilt_t;
+
+typedef struct {
+    float f[3];     /* the filtered pull */
+    float rest[3];  /* the rest pose */
+    int primed, have_rest, armed, hold, still;
+    int cand;       /* the direction being held */
+    uint32_t quiet_until_ms;
+} mgi_t;
+
+static inline void mgi_init(mgi_t* t)
+{
+    memset(t, 0, sizeof(*t));
+    t->armed = 1;
+}
+
+static inline void mgi_note_shake(mgi_t* t, uint32_t now_ms)
+{
+    t->quiet_until_ms = now_ms + MGI_SHAKE_QUIET_MS;
+    t->hold           = 0;
+    t->armed          = 0; /* the tilt that follows a shake is part of the shake */
+}
+
+static inline float mgi_abs(float v) { return v < 0 ? -v : v; }
+
+/* One accelerometer sample (m/s^2). Returns MGI_LEFT, MGI_RIGHT, MGI_FORWARD or MGI_BACK when a tilt just counted, else MGI_NONE. */
+static inline int mgi_update(mgi_t* t, float x, float y, float z, uint32_t now_ms)
+{
+    const float in[3] = {x, y, z};
+    for (int i = 0; i < 3; i++) {
+        t->f[i] = t->primed ? t->f[i] + MGI_ALPHA * (in[i] - t->f[i]) : in[i];
+    }
+    t->primed = 1;
+    const float m2 = t->f[0] * t->f[0] + t->f[1] * t->f[1] + t->f[2] * t->f[2];
+    if (m2 < MGI_MIN_MAG * MGI_MIN_MAG || m2 > MGI_MAX_MAG * MGI_MAX_MAG) { /* moving: neither rest nor tilt */
+        t->hold  = 0;
+        t->still = 0;
+        return MGI_NONE;
+    }
+    if (!t->have_rest) {
+        memcpy(t->rest, t->f, sizeof(t->rest));
+        t->have_rest = 1;
+    }
+    const float dx = t->f[0] - t->rest[0], dz = t->f[2] - t->rest[2], dy = t->f[1] - t->rest[1];
+    const float ax = mgi_abs(dx), az = mgi_abs(dz);
+    const float far = ax > az ? ax : az;
+    const float lim = MGI_TILT_G * MGI_G, back = MGI_BACK_G * MGI_G, settle = MGI_SETTLE_G * MGI_G;
+    /* the rest pose follows a pose that has been still for a while */
+    if (mgi_abs(dx) < settle && mgi_abs(dy) < settle && mgi_abs(dz) < settle) {
+        if (++t->still >= MGI_SETTLE_SAMPLES) {
+            for (int i = 0; i < 3; i++) {
+                t->rest[i] += 0.1f * (t->f[i] - t->rest[i]);
+            }
+        }
+    } else if (far >= lim) {
+        t->still = 0;
+    }
+    if (!t->armed) {
+        if (far < back && (int32_t)(now_ms - t->quiet_until_ms) >= 0) {
+            t->armed = 1;
+            t->hold  = 0;
+        }
+        return MGI_NONE;
+    }
+    if (far < lim || (int32_t)(now_ms - t->quiet_until_ms) < 0) {
+        t->hold = 0;
+        return MGI_NONE;
+    }
+    const int dir = ax >= az ? (dx > 0 ? MGI_RIGHT : MGI_LEFT) : (dz > 0 ? MGI_BACK : MGI_FORWARD);
+    if (dir != t->cand) {
+        t->cand = dir;
+        t->hold = 0;
+    }
+    if (++t->hold >= MGI_HOLD_SAMPLES) {
+        t->armed = 0;
+        t->hold  = 0;
+        return dir;
+    }
+    return MGI_NONE;
+}
+
+#endif
