--- /dev/null
+++ b/firmware/main/hal/maipai_games_sfx_core.h
@@ -0,0 +1,161 @@
+/*
+ * SPDX-License-Identifier: MIT
+ *
+ * The games' funny sounds (patch UI12): short tone sequences made in code, so no sound file is added. A clip is a list of
+ * segments, each a glide from one pitch to another in a sine, square or triangle wave (or a rest). The player renders a clip into a
+ * PCM buffer at 16 kHz and plays it through the audio service, so the unit's volume and the sound policy decide how loud it is.
+ * A group is a few clips of one kind (a hit, a miss, an escaped mole); a game asks for the group and one clip is picked at random.
+ * Plain C99, no libm, no allocation: a host test renders every clip and checks its length, its level and that it ends in silence.
+ *
+ * Tone ids in a pack: 0 to 4 are the shipped sounds, 5 + n is clip n, 0x80 + g is group g.
+ */
+#ifndef MAIPAI_GAMES_SFX_CORE_H
+#define MAIPAI_GAMES_SFX_CORE_H
+
+#include <stddef.h>
+#include <stdint.h>
+
+#define MGS_SFX_RATE 16000
+#define MGS_SFX_AMP 12000        /* of 32767: the codec's volume does the rest */
+#define MGS_SFX_ATTACK 64        /* samples (4 ms) */
+#define MGS_SFX_RELEASE 128      /* samples (8 ms) */
+#define MGS_SFX_MAX_SEGS 8
+#define MGS_SFX_MAX_MS 900       /* no clip is longer */
+#define MGS_SFX_MAX_SAMPLES ((MGS_SFX_RATE / 1000) * MGS_SFX_MAX_MS)
+#define MGS_TONE_SHIPPED 5       /* the first clip's tone id */
+#define MGS_TONE_GROUP 0x80      /* the first group's tone id */
+
+typedef enum { MGS_W_SINE = 0, MGS_W_SQUARE, MGS_W_TRI, MGS_W_REST } mgs_wave_t;
+
+typedef struct {
+    uint16_t f0, f1; /* pitch at the start and end of the segment, Hz */
+    uint16_t ms;
+    uint8_t wave;
+    uint8_t vol;     /* 1 to 100 */
+} mgs_seg_t;
+
+typedef struct {
+    const char* name;
+    uint8_t n;
+    mgs_seg_t seg[MGS_SFX_MAX_SEGS];
+} mgs_clip_t;
+
+/* The clips. The first four are a hit (a bonk and a squeak), then a miss, then an escaped mole, then the plain game sounds. */
+enum {
+    MGS_C_BONK_SQUEAK = 0, MGS_C_BONK_BOOP, MGS_C_SQUEAK, MGS_C_BOING,
+    MGS_C_WAH, MGS_C_RASPBERRY, MGS_C_BOOP,
+    MGS_C_HAHA, MGS_C_WHISTLE, MGS_C_TROMBONE,
+    MGS_C_GOOD, MGS_C_FANFARE, MGS_C_BAD,
+    MGS_C_CUE0, MGS_C_CUE1, MGS_C_CUE2, MGS_C_CUE3, MGS_C_CUE4, MGS_C_CUE5,
+    MGS_CLIPS
+};
+
+static const mgs_clip_t MGS_CLIP[MGS_CLIPS] = {
+    {"bonk_squeak", 2, {{420, 120, 110, MGS_W_SINE, 100}, {900, 1500, 80, MGS_W_SINE, 70}}},
+    {"bonk_boop", 4, {{300, 90, 130, MGS_W_TRI, 100}, {0, 0, 30, MGS_W_REST, 1}, {1200, 1800, 60, MGS_W_SINE, 70}, {1800, 1300, 80, MGS_W_SINE, 60}}},
+    {"squeak", 2, {{1000, 1900, 60, MGS_W_SINE, 80}, {1900, 1100, 100, MGS_W_SINE, 70}}},
+    {"boing", 2, {{200, 560, 90, MGS_W_TRI, 100}, {560, 170, 220, MGS_W_TRI, 90}}},
+    {"wah", 3, {{430, 330, 140, MGS_W_TRI, 90}, {0, 0, 40, MGS_W_REST, 1}, {360, 220, 240, MGS_W_TRI, 90}}},
+    {"raspberry", 1, {{120, 80, 240, MGS_W_SQUARE, 45}}},
+    {"boop", 3, {{260, 200, 90, MGS_W_SINE, 100}, {0, 0, 40, MGS_W_REST, 1}, {200, 140, 150, MGS_W_SINE, 100}}},
+    {"haha", 7, {{720, 640, 70, MGS_W_TRI, 90}, {0, 0, 30, MGS_W_REST, 1}, {620, 560, 70, MGS_W_TRI, 90}, {0, 0, 30, MGS_W_REST, 1},
+                 {540, 480, 70, MGS_W_TRI, 90}, {0, 0, 30, MGS_W_REST, 1}, {460, 380, 120, MGS_W_TRI, 90}}},
+    {"whistle", 1, {{1500, 300, 380, MGS_W_SINE, 80}}},
+    {"trombone", 4, {{330, 300, 160, MGS_W_TRI, 90}, {300, 270, 160, MGS_W_TRI, 90}, {270, 240, 160, MGS_W_TRI, 90}, {240, 150, 300, MGS_W_TRI, 90}}},
+    {"good", 2, {{600, 900, 70, MGS_W_SINE, 90}, {900, 1200, 100, MGS_W_SINE, 90}}},
+    {"fanfare", 4, {{523, 523, 90, MGS_W_TRI, 90}, {659, 659, 90, MGS_W_TRI, 90}, {784, 784, 90, MGS_W_TRI, 90}, {1047, 1047, 220, MGS_W_TRI, 90}}},
+    {"bad", 2, {{300, 200, 140, MGS_W_SQUARE, 45}, {200, 120, 220, MGS_W_SQUARE, 45}}},
+    {"cue0", 1, {{440, 440, 150, MGS_W_SINE, 90}}},
+    {"cue1", 1, {{554, 554, 150, MGS_W_SINE, 90}}},
+    {"cue2", 1, {{659, 659, 150, MGS_W_SINE, 90}}},
+    {"cue3", 1, {{784, 784, 150, MGS_W_SINE, 90}}},
+    {"cue4", 1, {{880, 880, 150, MGS_W_SINE, 90}}},
+    {"cue5", 1, {{988, 988, 150, MGS_W_SINE, 90}}},
+};
+
+/* The groups: a clip is picked at random from the clips listed. */
+enum { MGS_G_HIT = 0, MGS_G_MISS, MGS_G_ESCAPE, MGS_GROUPS };
+#define MGS_GROUP_MAX 4
+static const struct {
+    const char* name;
+    uint8_t n;
+    uint8_t clip[MGS_GROUP_MAX];
+} MGS_GROUP[MGS_GROUPS] = {
+    {"bonk", 4, {MGS_C_BONK_SQUEAK, MGS_C_BONK_BOOP, MGS_C_SQUEAK, MGS_C_BOING}},
+    {"miss", 3, {MGS_C_WAH, MGS_C_RASPBERRY, MGS_C_BOOP, 0}},
+    {"escape", 3, {MGS_C_HAHA, MGS_C_WHISTLE, MGS_C_TROMBONE, 0}},
+};
+
+/* Is this a tone id a pack may use? */
+static inline int mgs_tone_ok(int id)
+{
+    return (id >= 0 && id < MGS_TONE_SHIPPED) || (id >= MGS_TONE_SHIPPED && id < MGS_TONE_SHIPPED + MGS_CLIPS) ||
+           (id >= MGS_TONE_GROUP && id < MGS_TONE_GROUP + MGS_GROUPS);
+}
+
+/* sin(2 pi p) for p in [0, 1): a parabola with one correction pass, within 1 percent: a funny sound, not an instrument. */
+static inline float mgs_sin(float p)
+{
+    float x = p < 0.5f ? p : p - 1.0f; /* -0.5 to 0.5 */
+    float a = x < 0 ? -x : x;
+    float y = 8.0f * x * (1.0f - 2.0f * a);
+    float ay = y < 0 ? -y : y;
+    return 0.775f * y + 0.225f * y * ay;
+}
+
+/* The length of a clip in samples (0 for a bad index). */
+static inline size_t mgs_clip_samples(int clip)
+{
+    if (clip < 0 || clip >= MGS_CLIPS) {
+        return 0;
+    }
+    size_t n = 0;
+    for (int i = 0; i < MGS_CLIP[clip].n; i++) {
+        n += (size_t)(MGS_SFX_RATE / 1000) * MGS_CLIP[clip].seg[i].ms;
+    }
+    return n;
+}
+
+/* Renders a clip into out (cap samples). Returns the number of samples, 0 when the index is bad or cap is too small. */
+static inline size_t mgs_render(int clip, int16_t* out, size_t cap)
+{
+    const size_t total = mgs_clip_samples(clip);
+    if (total == 0 || out == NULL || cap < total) {
+        return 0;
+    }
+    size_t at = 0;
+    float phase = 0.0f;
+    for (int s = 0; s < MGS_CLIP[clip].n; s++) {
+        const mgs_seg_t* g = &MGS_CLIP[clip].seg[s];
+        const size_t n = (size_t)(MGS_SFX_RATE / 1000) * g->ms;
+        for (size_t i = 0; i < n; i++) {
+            float v = 0.0f;
+            if (g->wave != MGS_W_REST) {
+                const float f = (float)g->f0 + ((float)g->f1 - (float)g->f0) * (float)i / (float)n;
+                phase += f / (float)MGS_SFX_RATE;
+                if (phase >= 1.0f) {
+                    phase -= 1.0f;
+                }
+                if (g->wave == MGS_W_SINE) {
+                    v = mgs_sin(phase);
+                } else if (g->wave == MGS_W_SQUARE) {
+                    v = phase < 0.5f ? 0.6f : -0.6f;
+                } else {
+                    const float q = phase < 0.5f ? phase : 1.0f - phase; /* 0 to 0.5 to 0 */
+                    v = 4.0f * q - 1.0f;
+                }
+                float env = (float)g->vol / 100.0f;
+                if (i < MGS_SFX_ATTACK) {
+                    env *= (float)i / (float)MGS_SFX_ATTACK;
+                } else if (i + MGS_SFX_RELEASE > n) {
+                    env *= (float)(n - i) / (float)MGS_SFX_RELEASE;
+                }
+                v *= env;
+            }
+            out[at++] = (int16_t)(v * (float)MGS_SFX_AMP);
+        }
+    }
+    return at;
+}
+
+#endif
