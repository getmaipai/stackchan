+/* ---- the board of Tic-Tac-Toe ---- */
+static inline int mg_board_win(const uint8_t* b, int who)
+{
+    static const uint8_t L[8][3] = {{0, 1, 2}, {3, 4, 5}, {6, 7, 8}, {0, 3, 6}, {1, 4, 7}, {2, 5, 8}, {0, 4, 8}, {2, 4, 6}};
+    for (int i = 0; i < 8; i++) {
+        if (b[L[i][0]] == who && b[L[i][1]] == who && b[L[i][2]] == who) {
+            return 1;
+        }
+    }
+    return 0;
+}
+
+/* 0 playing, 1 the person (X) won, 2 the unit (O) won, 3 a draw. */
+static inline int mg_board_result(const uint8_t* b)
+{
+    if (mg_board_win(b, 1)) {
+        return 1;
+    }
+    if (mg_board_win(b, 2)) {
+        return 2;
+    }
+    for (int i = 0; i < MG_BOARD_CELLS; i++) {
+        if (b[i] == 0) {
+            return 0;
+        }
+    }
+    return 3;
+}
+
+/* Negamax with alpha-beta: the score of the position for `who` to move (win 10 minus depth, loss the opposite, draw 0). */
+static inline int mg_board_search(uint8_t* b, int who, int depth, int alpha, int beta)
+{
+    const int res = mg_board_result(b);
+    if (res != 0) {
+        if (res == 3) {
+            return 0;
+        }
+        return res == who ? 10 - depth : depth - 10;
+    }
+    int best = -100;
+    for (int i = 0; i < MG_BOARD_CELLS; i++) {
+        if (b[i] != 0) {
+            continue;
+        }
+        b[i]    = (uint8_t)who;
+        int v   = -mg_board_search(b, 3 - who, depth + 1, -beta, -alpha);
+        b[i]    = 0;
+        if (v > best) {
+            best = v;
+        }
+        if (best > alpha) {
+            alpha = best;
+        }
+        if (alpha >= beta) {
+            break;
+        }
+    }
+    return best;
+}
+
+/* The unit's move (as player 2) at a difficulty: 0 any free cell; 1 take a win, else block the person's win, else any free cell;
+ * 2 perfect play (it never loses), choosing at random among equally good cells. Returns the cell, or -1 when the board is full. */
+static inline int mg_board_bot(mg_run_t* r, int level)
+{
+    uint8_t* b = r->board;
+    int free_n = 0, free_c[MG_BOARD_CELLS];
+    for (int i = 0; i < MG_BOARD_CELLS; i++) {
+        if (b[i] == 0) {
+            free_c[free_n++] = i;
+        }
+    }
+    if (free_n == 0) {
+        return -1;
+    }
+    if (level >= 1) {
+        for (int pass = 0; pass < 2; pass++) { /* pass 0: win; pass 1: block */
+            const int who = pass == 0 ? 2 : 1;
+            for (int k = 0; k < free_n; k++) {
+                b[free_c[k]] = (uint8_t)who;
+                const int w  = mg_board_win(b, who);
+                b[free_c[k]] = 0;
+                if (w) {
+                    return free_c[k];
+                }
+            }
+        }
+    }
+    if (level >= 2) {
+        int best = -100, n_best = 0, best_c[MG_BOARD_CELLS];
+        for (int k = 0; k < free_n; k++) {
+            b[free_c[k]] = 2;
+            const int v  = -mg_board_search(b, 1, 1, -100, 100);
+            b[free_c[k]] = 0;
+            if (v > best) {
+                best   = v;
+                n_best = 0;
+            }
+            if (v == best) {
+                best_c[n_best++] = free_c[k];
+            }
+        }
+        return best_c[mg_rand(r) % (uint32_t)n_best];
     }
+    return free_c[mg_rand(r) % (uint32_t)free_n];
 }
 
