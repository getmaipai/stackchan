+/*
+ * SPDX-License-Identifier: MIT
+ *
+ * "While it thinks": the filler tone and the filler pack's sounds, device side (patch TB03). Logic: maipai_filler_core.h.
+ */
+#pragma once
+#include <cstddef>
+#include <cstdint>
+
+// self.filler.status and self.filler.play. Renders the tone into 6.7 KB of PSRAM.
+void maipai_filler_register_tools();
+// A new turn begins (the unit starts to listen): the filler may play once more.
+void maipai_filler_turn_start();
+// The thinking cue started or ended: on starts the wait; the filler plays when it passes with no answer audio.
+void maipai_filler_thinking(bool on);
+// The filler pack changed (the shared pack loader calls this). A zip payload, or null/0 to go back to the tone only.
+// Returns false (and a plain reason in *why) when the pack cannot be used; nothing changes then.
+bool maipai_filler_load_pack(const uint8_t* payload, size_t len, const char** why);
diff --git a/firmware/main/hal/maipai_filler.cc b/firmware/main/hal/maipai_filler.cc
new file mode 100644
index 0000000..1ff41bc
--- /dev/null
+++ b/firmware/main/hal/maipai_filler.cc
@@ -0,0 +1,289 @@
+/*
+ * SPDX-License-Identifier: MIT
+ *
+ * "While it thinks" (patch TB03). The wait is the person's (filler_wait_s, 0.2 to 1.5 s, default 0.4 s). When thinking
+ * starts a one-shot timer is set for that wait; when it fires, the delay rule (maipai_filler_core.h) decides: no answer audio,
+ * not speaking, not muted or quiet, once per turn. The tone is rendered at boot; phrases are the filler pack's mu-law clips,
+ * held as sent in one PSRAM block and decoded to a short scratch buffer at play time. Plays through AudioService::PlayPcm and
+ * the sound policy gate. Steady internal RAM: the rule and counters, about 100 bytes, plus one esp_timer (about 100 bytes).
+ */
+#include "maipai_filler.h"
+#include "maipai_filler_core.h"
+#include "maipai_pack_core.h"
+#include "maipai_tbprefs.h"
+#include "maipai_privacy.h"
+#include "maipai_sounds.h"
+#include <application.h>
+#include <esp_heap_caps.h>
+#include <esp_log.h>
+#include <esp_random.h>
+#include <esp_timer.h>
+#include <mcp_server.h>
+#include <atomic>
+#include <cstdio>
+#include <cstring>
+#include <mutex>
+
+static const char* TAG = "MAIPAI-FILLER";
+
+namespace {
+
+std::mutex s_mu;
+tf_rule_t s_rule;
+int16_t* s_tone = nullptr;  // PSRAM
+size_t s_tone_n = 0;
+int16_t s_ulaw[256];
+bool s_ulaw_ready = false;
+
+// the held pack: tf_index_t is 48 clips of 50 bytes, so it lives in PSRAM with the sound bytes
+struct Held {
+    tf_index_t index;
+    uint8_t* bytes = nullptr;          // all clips back to back
+    uint32_t off[TF_MAX_CLIPS] = {};
+    uint32_t len[TF_MAX_CLIPS] = {};
+    uint32_t total = 0;
+};
+Held* s_held = nullptr;
+int s_last_clip = -1;
+esp_timer_handle_t s_timer = nullptr;
+std::atomic<uint32_t> s_plays{0}, s_phrases{0};
+std::atomic<uint32_t> s_skip[TF_SKIP_COUNT];
+std::atomic<int> s_last_skip{-1};
+char s_last_name[TF_NAME_MAX + 1] = "";
+
+uint32_t ms_now() { return static_cast<uint32_t>(esp_timer_get_time() / 1000); }
+
+tf_env_t env_now()
+{
+    tf_env_t e = {};
+    e.sound_ok   = maipai_sounds_gate("success") ? 1 : 0;  // not allowed at night, off when sounds are off
+    e.muted      = maipai_muted() ? 1 : 0;
+    e.full_quiet = maipai_quiet() ? 1 : 0;
+    e.speaking   = Application::GetInstance().GetDeviceState() == kDeviceStateSpeaking ? 1 : 0;
+    return e;
+}
+
+void play_tone()
+{
+    if (s_tone != nullptr) {
+        Application::GetInstance().GetAudioService().PlayPcm(s_tone, s_tone_n, TF_TONE_RATE);
+    }
+}
+
+// call with s_mu held; decodes one clip and queues it
+bool play_clip_locked(int idx)
+{
+    if (s_held == nullptr || idx < 0 || idx >= s_held->index.n) return false;
+    const uint32_t n = s_held->len[idx];
+    int16_t* pcm = static_cast<int16_t*>(heap_caps_malloc(n * sizeof(int16_t), MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT));
+    if (pcm == nullptr) return false;
+    const uint8_t* in = s_held->bytes + s_held->off[idx];
+    for (uint32_t i = 0; i < n; i++) pcm[i] = s_ulaw[in[i]];
+    const bool ok = Application::GetInstance().GetAudioService().PlayPcm(pcm, n, s_held->index.rate);
+    heap_caps_free(pcm);  // PlayPcm copies
+    if (ok) {
+        strncpy(s_last_name, s_held->index.clip[idx].name, TF_NAME_MAX);
+        s_phrases.fetch_add(1);
+    }
+    return ok;
+}
+
+void do_play(uint8_t what)
+{
+    bool done = false;
+    if (what == TF_MODE_PHRASE) {
+        std::lock_guard<std::mutex> lock(s_mu);
+        if (s_held != nullptr) {
+            const int idx = tf_pick(&s_held->index, s_last_clip, esp_random());
+            if (play_clip_locked(idx)) {
+                s_last_clip = idx;
+                done = true;
+            }
+        }
+    }
+    if (!done) {
+        play_tone();
+        strcpy(s_last_name, "tone");
+    }
+    s_plays.fetch_add(1);
+}
+
+void timer_cb(void*)
+{
+    const MaipaiTbPrefs prefs = maipai_tb_prefs();
+    const tf_env_t env = env_now();
+    uint8_t play = 0;
+    tf_skip_t r;
+    {
+        std::lock_guard<std::mutex> lock(s_mu);
+        r = tf_poll(&s_rule, ms_now(), &prefs.filler, &env, s_held != nullptr ? 1 : 0, &play);
+    }
+    s_last_skip.store(r);
+    if (r == TF_SKIP_NONE) {
+        do_play(play);
+    } else {
+        s_skip[r].fetch_add(1);
+    }
+}
+
+void ensure_timer()
+{
+    if (s_timer != nullptr) return;
+    esp_timer_create_args_t a = {};
+    a.callback = timer_cb;
+    a.name     = "filler";
+    esp_timer_create(&a, &s_timer);
+}
+
+void free_held_locked()
+{
+    if (s_held != nullptr) {
+        if (s_held->bytes != nullptr) heap_caps_free(s_held->bytes);
+        heap_caps_free(s_held);
+        s_held = nullptr;
+    }
+    s_last_clip = -1;
+}
+
+long inflate_raw(const uint8_t* in, size_t inlen, uint8_t* out, size_t cap);
+
+}  // namespace
+
+// ---- the shared pack loader's consumer ----
+#include <miniz.h>
+namespace {
+long inflate_raw(const uint8_t* in, size_t inlen, uint8_t* out, size_t cap)
+{
+    const size_t n = tinfl_decompress_mem_to_mem(out, cap, in, inlen, 0);  // raw deflate
+    return n == TINFL_DECOMPRESS_MEM_TO_MEM_FAILED ? -1 : static_cast<long>(n);
+}
+}  // namespace
+
+bool maipai_filler_load_pack(const uint8_t* payload, size_t len, const char** why)
+{
+    *why = "";
+    if (payload == nullptr || len == 0) {
+        std::lock_guard<std::mutex> lock(s_mu);
+        free_held_locked();
+        return true;
+    }
+    tpz_t* z = static_cast<tpz_t*>(heap_caps_malloc(sizeof(tpz_t), MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT));
+    if (z == nullptr) { *why = tpk_say(TPK_ERR_MEMORY, 0); return false; }
+    struct Free { void* p; ~Free() { heap_caps_free(p); } } free_z{z};
+    if (tpz_open(z, payload, len) != TPK_OK) { *why = tpk_say(TPK_ERR_ZIP, 0); return false; }
+    const tpz_entry_t* ie = tpz_find(z, "index.json");
+    if (ie == nullptr || ie->usize > 16384) { *why = tpk_say(TPK_ERR_ZIP, 0); return false; }
+    char* json = static_cast<char*>(heap_caps_malloc(ie->usize + 1, MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT));
+    if (json == nullptr) { *why = tpk_say(TPK_ERR_MEMORY, 0); return false; }
+    struct Free2 { void* p; ~Free2() { heap_caps_free(p); } } free_j{json};
+    if (tpz_extract(z, ie, reinterpret_cast<uint8_t*>(json), ie->usize, inflate_raw) != TPK_OK) { *why = tpk_say(TPK_ERR_ZIP, 0); return false; }
+    Held* h = static_cast<Held*>(heap_caps_calloc(1, sizeof(Held), MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT));
+    if (h == nullptr) { *why = tpk_say(TPK_ERR_MEMORY, 0); return false; }
+    if (tf_parse_index(json, ie->usize, &h->index) == 0) { heap_caps_free(h); *why = tpk_say(TPK_ERR_ZIP, 0); return false; }
+    uint32_t total = 0;
+    int keep = 0;
+    for (int i = 0; i < h->index.n; i++) {
+        const tpz_entry_t* e = tpz_find(z, h->index.clip[i].file);
+        if (e == nullptr || e->usize == 0 || e->usize > 80000 || total + e->usize > TPK_MAX_BYTES[TPK_FILLER]) continue;
+        h->index.clip[keep] = h->index.clip[i];
+        h->off[keep]        = total;
+        h->len[keep]        = e->usize;
+        total += e->usize;
+        keep++;
+    }
+    h->index.n = static_cast<uint8_t>(keep);
+    if (keep == 0) { heap_caps_free(h); *why = tpk_say(TPK_ERR_ZIP, 0); return false; }
+    h->bytes = static_cast<uint8_t*>(heap_caps_malloc(total, MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT));
+    if (h->bytes == nullptr) { heap_caps_free(h); *why = tpk_say(TPK_ERR_MEMORY, 0); return false; }
+    h->total = total;
+    for (int i = 0; i < keep; i++) {
+        const tpz_entry_t* e = tpz_find(z, h->index.clip[i].file);
+        if (tpz_extract(z, e, h->bytes + h->off[i], h->len[i], inflate_raw) != TPK_OK) {
+            heap_caps_free(h->bytes); heap_caps_free(h); *why = tpk_say(TPK_ERR_ZIP, 0); return false;
+        }
+    }
+    std::lock_guard<std::mutex> lock(s_mu);
+    free_held_locked();
+    s_held = h;
+    ESP_LOGI(TAG, "filler pack: %d sounds, %u bytes", keep, static_cast<unsigned>(total));
+    return true;
+}
+
+void maipai_filler_turn_start()
+{
+    std::lock_guard<std::mutex> lock(s_mu);
+    tf_turn_start(&s_rule);
+}
+
+void maipai_filler_thinking(bool on)
+{
+    ensure_timer();
+    if (!on) {
+        esp_timer_stop(s_timer);
+        return;
+    }
+    const MaipaiTbPrefs prefs = maipai_tb_prefs();
+    {
+        std::lock_guard<std::mutex> lock(s_mu);
+        tf_thinking(&s_rule, ms_now());
+    }
+    esp_timer_stop(s_timer);
+    if (prefs.filler.mode != TF_MODE_NONE) {
+        esp_timer_start_once(s_timer, static_cast<uint64_t>(prefs.filler.wait_ms) * 1000ULL);
+    }
+}
+
+void maipai_filler_register_tools()
+{
+    tf_rule_init(&s_rule);
+    tf_ulaw_table(s_ulaw);
+    s_ulaw_ready = true;
+    s_tone = static_cast<int16_t*>(heap_caps_malloc(TF_TONE_SAMPLES * sizeof(int16_t), MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT));
+    if (s_tone != nullptr) s_tone_n = tf_render_tone(s_tone, TF_TONE_SAMPLES);
+    auto& mcp = McpServer::GetInstance();
+    mcp.AddTool("self.filler.status",
+                "The \"While it thinks\" sound: mode (none, tone, phrase), the wait in ms, whether a filler pack is held and how many "
+                "sounds, what played and what was skipped and why. Answers {ok, ...}.",
+                PropertyList(), [](const PropertyList&) -> ReturnValue {
+                    const MaipaiTbPrefs prefs = maipai_tb_prefs();
+                    static const char* const modes[3] = {"none", "tone", "phrase"};
+                    std::lock_guard<std::mutex> lock(s_mu);
+                    char out[480];
+                    int n = snprintf(out, sizeof(out),
+                                     "{\"ok\":true,\"mode\":\"%s\",\"wait_ms\":%u,\"held\":%s,\"sounds\":%d,\"played\":%u,\"phrases\":%u,"
+                                     "\"last\":\"%s\",\"last_skip\":\"%s\",\"skipped\":{",
+                                     modes[prefs.filler.mode], static_cast<unsigned>(prefs.filler.wait_ms), s_held ? "true" : "false",
+                                     s_held ? s_held->index.n : 0, static_cast<unsigned>(s_plays.load()),
+                                     static_cast<unsigned>(s_phrases.load()), s_last_name,
+                                     s_last_skip.load() >= 0 ? TF_SKIP_WORDS[s_last_skip.load()] : "");
+                    for (int i = 1; i < TF_SKIP_COUNT; i++) {
+                        n += snprintf(out + n, sizeof(out) - n, "%s\"%s\":%u", i > 1 ? "," : "", TF_SKIP_WORDS[i],
+                                      static_cast<unsigned>(s_skip[i].load()));
+                    }
+                    snprintf(out + n, sizeof(out) - n, "}}");
+                    return std::string(out);
+                });
+    mcp.AddTool("self.filler.play",
+                "Play the filler now, for a host that ran the wait itself: mode tone or phrase. The same guards as the unit's own "
+                "rule: once per turn, not over speech, not muted or in quiet hours. Answers {ok, played, why}.",
+                PropertyList({Property("mode", kPropertyTypeString, std::string("tone"))}),
+                [](const PropertyList& properties) -> ReturnValue {
+                    uint8_t mode = TF_MODE_TONE;
+                    if (!tf_parse_mode(properties["mode"].value<std::string>().c_str(), &mode)) {
+                        return std::string("{\"ok\":false,\"error\":\"The mode must be none, tone or phrase. Choose one of them.\"}");
+                    }
+                    const tf_env_t env = env_now();
+                    uint8_t play = 0;
+                    tf_skip_t r;
+                    {
+                        std::lock_guard<std::mutex> lock(s_mu);
+                        r = tf_play_now(&s_rule, mode, &env, s_held != nullptr ? 1 : 0, &play);
+                    }
+                    if (r != TF_SKIP_NONE) {
+                        s_skip[r].fetch_add(1);
+                        return std::string("{\"ok\":true,\"played\":false,\"why\":\"") + TF_SKIP_WORDS[r] + "\"}";
+                    }
+                    do_play(play);
+                    return std::string("{\"ok\":true,\"played\":true,\"what\":\"") + (play == TF_MODE_PHRASE ? "phrase" : "tone") + "\"}";
+                });
+}
