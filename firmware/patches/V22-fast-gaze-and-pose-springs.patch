 #include <stdint.h>
 
 #define MX_TAU_POS_MS 70.0f     /* where the eyes look */
+/* Patch V20: the gaze is a damped spring (fast attack, a little overshoot, soft settle), not an exponential of 70 ms (which took 210 ms to
+ * reach 95 percent and read as slow). k 2600 and damping ratio 0.65: 90 percent of a jump in about 45 ms, settled in about 120 ms, 7 percent over. */
+#define MX_GAZE_K 2600.0f
+#define MX_GAZE_ZETA 0.65f
 #define MX_TAU_ROT_MS 110.0f    /* the tilt that goes with an emotion */
 #define MX_TAU_LID_CLOSE_MS 28.0f
 #define MX_TAU_LID_OPEN_MS 85.0f
@@ -45,6 +49,25 @@ static inline float mx_follow(float cur, float target, float dt_ms, float tau_ms
     return cur + (target - cur) * (dt_ms / (tau_ms + dt_ms));
 }
 
+typedef struct {
+    float x, v;
+} mx_spring1_t;
+
+/* One step of a damped spring toward target; dt in milliseconds, sub-steps of at most 6 ms so a slow frame stays stable. */
+static inline void mx_spring1_step(mx_spring1_t* sp, float target, float dt_ms, float k, float zeta)
+{
+    float dt = dt_ms * 0.001f;
+    if (dt <= 0.0f) return;
+    if (dt > 0.05f) dt = 0.05f;
+    int n = (int)(dt / 0.006f) + 1;
+    const float h = dt / (float)n, c = 2.0f * sqrtf(k) * zeta;
+    for (int i = 0; i < n; i++) {
+        sp->v += (k * (target - sp->x) - c * sp->v) * h;
+        sp->x += sp->v * h;
+    }
+    if (fabsf(target - sp->x) < 0.02f && fabsf(sp->v) < 0.3f) { sp->x = target; sp->v = 0.0f; }
+}
+
 static inline float mx_lid_tau(float cur, float target)
 {
     return target < cur ? MX_TAU_LID_CLOSE_MS : MX_TAU_LID_OPEN_MS;

