+/* ---- patch N04: keeping every shape inside the face zone */
+/* The box of the shapes that light pixels (a shape in the screen color lights nothing): b = x0, y0, x1, y1 around the shapes' own centre. */
+static inline int ml_shapes_bbox(const ml_shape_t* sh, int n, float b[4])
+{
+    int any = 0;
+    float x0 = 0, y0 = 0, x1 = 0, y1 = 0;
+#define ML_BB(px, py)                                                              \
+    do {                                                                           \
+        if (!any) { x0 = x1 = (px); y0 = y1 = (py); any = 1; }                     \
+        else { if ((px) < x0) x0 = (px); if ((px) > x1) x1 = (px); if ((py) < y0) y0 = (py); if ((py) > y1) y1 = (py); } \
+    } while (0)
+    for (int i = 0; i < n; i++) {
+        const ml_shape_t* s = &sh[i];
+        if (s->col == ML_COL_BG || s->opa < 8) continue;
+        const float* v = s->v;
+        switch (s->kind) {
+            case ML_SH_RRECT: ML_BB(v[0] - v[2] * 0.5f, v[1] - v[3] * 0.5f); ML_BB(v[0] + v[2] * 0.5f, v[1] + v[3] * 0.5f); break;
+            case ML_SH_CIRCLE: ML_BB(v[0] - v[2], v[1] - v[2]); ML_BB(v[0] + v[2], v[1] + v[2]); break;
+            case ML_SH_QUAD: for (int k = 0; k < 4; k++) ML_BB(v[2 * k], v[2 * k + 1]); break;
+            case ML_SH_LINE: {
+                const float h = v[4] * 0.5f;
+                ML_BB(v[0] - h, v[1] - h); ML_BB(v[0] + h, v[1] + h); ML_BB(v[2] - h, v[3] - h); ML_BB(v[2] + h, v[3] + h);
+                break;
+            }
+            case ML_SH_HEART: ML_BB(v[0] - v[2] * 0.95f, v[1] - v[2] * 0.55f); ML_BB(v[0] + v[2] * 0.95f, v[1] + v[2] * 0.5f); break; /* the bezier's own extent */
+            default: break;
+        }
+    }
+#undef ML_BB
+    b[0] = x0; b[1] = y0; b[2] = x1; b[3] = y1;
+    return any;
+}
+
+/* The eye's vertical offset (pose, gaze and drift together) kept so that its lit shapes stay inside the face zone: its top at
+ * screen y 32 or lower and its bottom above the subtitle zone. top_rel and bottom_rel are the box of its shapes around its own centre. */
+static inline int ml_zone_clamp_oy(const ml_style_t* st, int oy, float top_rel, float bottom_rel)
+{
+    const float c = (float)ML_ZONE_CENTER_Y + (float)st->eye_y;
+    const float lo = (float)ML_ZONE_EYE_TOP - c - top_rel;
+    const float hi = (float)(ML_ZONE_Y1 - 4) - c - bottom_rel;
+    if ((float)oy > hi) oy = (int)floorf(hi);
+    if ((float)oy < lo) oy = (int)ceilf(lo);
+    return oy;
+}
