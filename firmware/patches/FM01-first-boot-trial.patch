+// Patch FM01: the first-boot trial. The rule is maipai_update_core.h (tested on the PC with scripted boots); this part
+// reads the flash record, the reset reason and the boot loader's state, and carries out the verdict.
+constexpr const char* kTrialNs  = "fwtrial";
+constexpr const char* kTrialKey = "t";
+muc_trial_t s_trial{};
+esp_timer_handle_t s_trial_timer = nullptr;
+std::atomic<int64_t> s_board_done_us{0};  // when board init returned (0: not yet)
+std::atomic<int64_t> s_loop_us{0};        // last time the main loop ran
 
 bool image_pending()
 {
@@ -157,35 +164,119 @@
            state == ESP_OTA_IMG_PENDING_VERIFY;
 }
 
-void rollback_now(void*)
+void trial_load()
 {
-    if (!image_pending()) return;
-    ESP_LOGE(kTag,
-             "The new firmware did not reach the host within 60 seconds. Going back to the previous firmware. "
-             "Check the host and the Wi-Fi, then start the update again.");
+    std::memset(&s_trial, 0, sizeof(s_trial));
+    nvs_handle_t h;
+    if (nvs_open(kTrialNs, NVS_READONLY, &h) != ESP_OK) return;
+    size_t len = sizeof(s_trial);
+    muc_trial_t t{};
+    if (nvs_get_blob(h, kTrialKey, &t, &len) == ESP_OK && len == sizeof(t)) s_trial = t;
+    nvs_close(h);
+}
+
+void trial_save()
+{
+    nvs_handle_t h;
+    if (nvs_open(kTrialNs, NVS_READWRITE, &h) != ESP_OK) return;
+    if (s_trial.active) {
+        nvs_set_blob(h, kTrialKey, &s_trial, sizeof(s_trial));
+    } else {
+        nvs_erase_key(h, kTrialKey);
+    }
+    nvs_commit(h);
+    nvs_close(h);
+}
+
+void roll_back(const char* why)
+{
+    ESP_LOGE(kTag, "%s Going back to the previous firmware. Check the host and the Wi-Fi, then start the update again.", why);
+    s_trial.active = 0;
+    trial_save();
+    device_events_push("firmware_update_rolled_back", "");
+    vTaskDelay(pdMS_TO_TICKS(300));
     esp_ota_mark_app_invalid_rollback_and_reboot();
+    // Only reached when no earlier firmware exists: keep this one and go on.
+    ESP_LOGE(kTag, "There is no earlier firmware to go back to. Keeping this one.");
 }
 
+void trial_tick(void*)
+{
+    const int64_t now = esp_timer_get_time();
+    const int64_t done = s_board_done_us.load();
+    const bool camera = done != 0 && now - done >= static_cast<int64_t>(MUC_CAMERA_SETTLE_MS) * 1000;
+    const bool alive = now - s_loop_us.load() < 5000000;
+    bool dirty = false;
+    const muc_step_t step = muc_step(&s_trial, static_cast<uint32_t>(now / 1000000), camera, alive,
+                                     hal_bridge::hub_link_up(), &dirty);
+    if (dirty) trial_save();
+    switch (step) {
+        case MUC_STEP_KEEP_HOST:
+        case MUC_STEP_KEEP_QUIET:
+            esp_timer_stop(s_trial_timer);
+            if (step == MUC_STEP_KEEP_HOST) {
+                ESP_LOGI(kTag, "the new image reached the host; keeping it");
+            } else {
+                ESP_LOGI(kTag, "the new image ran 60 seconds with no crash; keeping it");
+            }
+            device_events_push("firmware_update_validated",
+                               step == MUC_STEP_KEEP_HOST ? "\"path\":\"host\"" : "\"path\":\"quiet\"");
+            break;
+        case MUC_STEP_ROLLBACK:
+            esp_timer_stop(s_trial_timer);
+            roll_back("The new firmware did not settle within 120 seconds.");
+            break;
+        default:
+            break;
+    }
+}
+
+bool crash_reset()
+{
+    switch (esp_reset_reason()) {
+        case ESP_RST_PANIC:
+        case ESP_RST_INT_WDT:
+        case ESP_RST_TASK_WDT:
+        case ESP_RST_WDT:
+        case ESP_RST_BROWNOUT:
+        case ESP_RST_CPU_LOCKUP:
+            return true;
+        default:
+            return false;
+    }
+}
+
 }  // namespace
 
 void maipai_update_arm()
 {
-    if (!image_pending()) return;
-    ESP_LOGI(kTag, "this image was installed wirelessly and is pending: it is kept once it reaches the host, else rolled back in 60 s");
-    const esp_timer_create_args_t args = {.callback = rollback_now, .name = "fwrollback"};
-    if (esp_timer_create(&args, &s_rollback_timer) == ESP_OK) {
-        esp_timer_start_once(s_rollback_timer, kRollbackAfterUs);
+    trial_load();
+    bool dirty = false;
+    const muc_boot_t verdict = muc_boot(&s_trial, image_pending(), crash_reset(), &dirty);
+    if (verdict == MUC_BOOT_IDLE) return;
+    if (verdict == MUC_BOOT_START) {
+        // Defuse the boot loader's blind rule (any reset before "good" rolls back): our own record judges from here.
+        esp_ota_mark_app_valid_cancel_rollback();
+        ESP_LOGI(kTag, "this image was installed wirelessly: on trial for 60 s without a crash, or 20 s with the host");
     }
+    if (dirty) trial_save();
+    if (verdict == MUC_BOOT_ROLLBACK) {
+        roll_back("The new firmware crashed twice after it had started.");
+        return;
+    }
+    s_loop_us = esp_timer_get_time();
+    const esp_timer_create_args_t args = {.callback = trial_tick, .name = "fwtrial"};
+    if (esp_timer_create(&args, &s_trial_timer) == ESP_OK) {
+        esp_timer_start_periodic(s_trial_timer, 1000000);
+    }
 }
 
+void maipai_update_board_ready()
+{
+    s_board_done_us = esp_timer_get_time();
+}
+
 void maipai_update_confirm_poll()
 {
-    if (s_rollback_timer == nullptr || esp_timer_get_time() < kConfirmAfterUs) return;
-    if (!hal_bridge::hub_link_up() || !image_pending()) return;
