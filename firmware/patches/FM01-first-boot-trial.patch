@@ -0,0 +1,115 @@
+/*
+ * SPDX-License-Identifier: MIT
+ *
+ * The trial rule for a wirelessly installed image (patch FM01): the pure state machine, no ESP-IDF, so a host
+ * compiler can run it with scripted boots (host/tests/firmware/update_core_test.c).
+ *
+ * Patch 160 kept a new image only after 20 s with the host link up, and the boot loader itself rolls back any
+ * pending image that resets before it is marked good. Two faults that are not the image's own rolled back a good
+ * image: the vendor camera component panics on about half of the cold USB boots (the VSYNC interrupt fires before
+ * its queue exists), and a unit on a trip has no host at boot. Now the app marks the image good at once (so the
+ * boot loader's blind rule cannot fire) and keeps its own trial record in flash:
+ *   - a crash reset before the camera has settled in the dead boot is a free pass (at most MUC_FREE_PASSES);
+ *   - a crash reset after it is a strike; MUC_STRIKES_TO_ROLLBACK strikes roll back to the old slot;
+ *   - a power loss or a software restart is no fault at all;
+ *   - the trial ends good when the unit has run MUC_HOST_AFTER_S with the host link up, or MUC_QUIET_AFTER_S with no
+ *     crash at all (the trip case), the camera settled and the main loop alive either way;
+ *   - a trial still open at MUC_STALL_AFTER_S (a stuck main loop or a camera init that never returns) rolls back.
+ */
+#ifndef MAIPAI_UPDATE_CORE_H
+#define MAIPAI_UPDATE_CORE_H
+
+#include <stdbool.h>
+#include <stdint.h>
+
+#define MUC_FREE_PASSES 3
+#define MUC_STRIKES_TO_ROLLBACK 2
+#define MUC_HOST_AFTER_S 20
+#define MUC_QUIET_AFTER_S 60
+#define MUC_STALL_AFTER_S 120
+#define MUC_CAMERA_SETTLE_MS 2000 /* the camera counts as settled this long after board init returns */
+
+typedef struct {
+    uint8_t active;       /* a trial is open */
+    uint8_t strikes;      /* crashes after the camera had settled */
+    uint8_t free_passes;  /* crashes before it had */
+    uint8_t stage;        /* in this boot: 0 camera not settled yet, 1 settled (persisted so the next boot can judge) */
+    uint16_t boots;       /* boots since the install */
+    uint16_t pad;
+} muc_trial_t;
+
+typedef enum {
+    MUC_BOOT_IDLE = 0,   /* no trial: nothing to do */
+    MUC_BOOT_START,      /* first boot of a new image: mark it good now (defuses the boot loader), open the trial */
+    MUC_BOOT_CONTINUE,   /* a trial is open: carry on */
+    MUC_BOOT_ROLLBACK,   /* the trial is lost: go back to the old slot */
+} muc_boot_t;
+
+typedef enum {
+    MUC_STEP_IDLE = 0,   /* no trial */
+    MUC_STEP_WAIT,
+    MUC_STEP_KEEP_HOST,  /* trial ends good: the host answered */
+    MUC_STEP_KEEP_QUIET, /* trial ends good: no crash for MUC_QUIET_AFTER_S, no host needed */
+    MUC_STEP_ROLLBACK,   /* stalled: go back to the old slot */
+} muc_step_t;
+
+/* Call once per boot, before the board starts. pending is the boot loader's state of this image (pending
+ * verify = first boot after an install); crash_reset is true for a panic, a watchdog or a brownout reset. */
+static inline muc_boot_t muc_boot(muc_trial_t* t, bool pending, bool crash_reset, bool* dirty)
+{
+    *dirty = false;
+    if (pending) {
+        t->active = 1;
+        t->strikes = 0;
+        t->free_passes = 0;
+        t->stage = 0;
+        t->boots = 1;
+        *dirty = true;
+        return MUC_BOOT_START;
+    }
+    if (!t->active) {
+        return MUC_BOOT_IDLE;
+    }
+    t->boots++;
+    if (crash_reset) {
+        if (t->stage >= 1 || t->free_passes >= MUC_FREE_PASSES) {
+            t->strikes++;
+        } else {
+            t->free_passes++;
+        }
+    }
+    t->stage = 0;
+    *dirty = true;
+    return t->strikes >= MUC_STRIKES_TO_ROLLBACK ? MUC_BOOT_ROLLBACK : MUC_BOOT_CONTINUE;
+}
+
+/* Call about once a second from a task that does not depend on the main loop. up_s is the uptime of this boot,
+ * camera_settled is true MUC_CAMERA_SETTLE_MS after board init returned, loop_alive is true when the main loop
+ * ran within the last few seconds. dirty is set when the record must be saved. */
+static inline muc_step_t muc_step(muc_trial_t* t, uint32_t up_s, bool camera_settled, bool loop_alive, bool host_up,
+                                  bool* dirty)
+{
+    *dirty = false;
+    if (!t->active) {
+        return MUC_STEP_IDLE;
+    }
+    if (camera_settled && t->stage == 0) {
+        t->stage = 1;
+        *dirty = true;
+    }
+    if (t->stage >= 1 && loop_alive) {
+        if (host_up && up_s >= MUC_HOST_AFTER_S) {
+            t->active = 0;
+            *dirty = true;
+            return MUC_STEP_KEEP_HOST;
+        }
+        if (up_s >= MUC_QUIET_AFTER_S) {
+            t->active = 0;
+            *dirty = true;
+            return MUC_STEP_KEEP_QUIET;
+        }
+    }
+    return up_s >= MUC_STALL_AFTER_S ? MUC_STEP_ROLLBACK : MUC_STEP_WAIT;
+}
+
+#endif
