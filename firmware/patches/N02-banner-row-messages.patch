+// Every 2 s, from the banner's LVGL timer: the gauges the strip needs. Battery and Wi-Fi glyphs show only when something is wrong.
+void StackChanAvatarDisplay::BannerPoll(maipai_banner_status_t* st)
+{
+    int level = -1;
+    bool charging = false, on_cable = false;
+    if (hal_bridge::board_battery_state(&level, &charging, &on_cable)) {
+        st->battery_level = level;
+        st->charging      = charging;
+        st->on_cable      = on_cable;
+    }
+    wifi_ap_record_t ap;
+    st->wifi_up = esp_wifi_sta_get_ap_info(&ap) == ESP_OK;
+    if (st->wifi_up) {
+        st->wifi_bars = ap.rssi > -55 ? 4 : (ap.rssi > -65 ? 3 : (ap.rssi > -75 ? 2 : 1));
+    } else {
+        st->wifi_bars = 0;
+    }
+    st->hub_up   = s_banner_link != 2;
+    st->mic_live = Application::GetInstance().GetDeviceState() == kDeviceStateListening;
+}
+#endif
