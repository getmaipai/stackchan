+/* The captions mode (patches N01, N04): the person's choice if they made one, else what the older settings say: subtitles when
+ * the older speech bubble was chosen on, when the style is Stock (its bubble became the subtitles) or when the face's captions
+ * flag is on, off otherwise. 0 off, 1 subtitles, 2 banner. */
+static inline int mp_captions_mode(const mp_prefs_t* p, int face_captions, int style_is_stock)
+{
+    if (p->set & (1u << MP_CAPTIONS_MODE)) return (int)p->v[MP_CAPTIONS_MODE];
+    if (p->set & (1u << MP_SPEECH_BUBBLE)) {
+        if (p->v[MP_SPEECH_BUBBLE] != 0) return 1;
+    } else if (style_is_stock) {
+        return 1;
+    }
+    return face_captions ? 1 : 0;
+}
