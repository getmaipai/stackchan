@@ -0,0 +1,86 @@
+// SPDX-License-Identifier: MIT
+// The flyer screen (patch UX25; spec docs/design/flyer.md). Header only, so the host renderer compiles the very same drawing code. The sky, pipes and bird are drawn by ONE object and one draw
+// callback, redrawn by the caller on every step. The whole screen is the tap target (a tap hops the bird); the firmware track wires that, the 33 ms tick, the sounds and the game-over call
+// (Game over with the pipes passed). No ESP call here.
+#ifndef MAIPAI_FLYER_H
+#define MAIPAI_FLYER_H
+
+#include <lvgl.h>
+#include <stdio.h>
+#include "maipai_flyer_core.h"
+
+namespace flys {
+
+inline void rect(lv_layer_t* layer, int x, int y, int w, int h, int radius, uint32_t color, lv_opa_t opa = LV_OPA_COVER)
+{
+    lv_draw_rect_dsc_t d;
+    lv_draw_rect_dsc_init(&d);
+    d.bg_color = lv_color_hex(color);
+    d.bg_opa = opa;
+    d.radius = radius;
+    lv_area_t a = {static_cast<lv_coord_t>(x), static_cast<lv_coord_t>(y), static_cast<lv_coord_t>(x + w - 1), static_cast<lv_coord_t>(y + h - 1)};
+    lv_draw_rect(layer, &d, &a);
+}
+
+inline void draw_sky(lv_event_t* e)
+{
+    const fl_t* g = static_cast<const fl_t*>(lv_event_get_user_data(e));
+    if (g == nullptr) return;
+    lv_layer_t* layer = lv_event_get_layer(e);
+    rect(layer, 0, FL_TOP, 320, FL_BOTTOM - FL_TOP, 0, 0x10243E);                                      // the sky
+    rect(layer, 0, FL_BOTTOM, 320, 240 - FL_BOTTOM, 0, 0x3A5A2E);                                      // the floor
+    for (int i = 0; i < FL_PIPES; i++) {
+        const int x = g->px[i] >> 4;
+        if (x + FL_PIPE_W <= 0 || x >= 320) continue;
+        const int top_h = g->gap[i] - FL_TOP, bot_y = g->gap[i] + FL_GAP;
+        rect(layer, x, FL_TOP, FL_PIPE_W, top_h, 3, 0x3E8E4F);                                           // the pipe above the gap
+        rect(layer, x - 3, g->gap[i] - 10, FL_PIPE_W + 6, 10, 3, 0x5CB86E);                              // its lip
+        rect(layer, x, bot_y, FL_PIPE_W, FL_BOTTOM - bot_y, 3, 0x3E8E4F);                                // the pipe below
+        rect(layer, x - 3, bot_y, FL_PIPE_W + 6, 10, 3, 0x5CB86E);                                       // its lip
+    }
+    rect(layer, FL_BIRD_X, fl_bird_top(g), FL_BIRD, FL_BIRD, 6, g->phase == FL_PLAY ? 0xF2B24A : 0xC0562E);   // the bird, amber (red-orange after the hit)
+    rect(layer, FL_BIRD_X + 9, fl_bird_top(g) + 3, 3, 3, LV_RADIUS_CIRCLE, 0x10141C);                    // its eye
+}
+
+// `g` must outlive the screen. The score is the number of pipes passed, large, in the header.
+inline lv_obj_t* screen(lv_obj_t* parent, const fl_t* g, bool es)
+{
+    lv_obj_t* r = lv_obj_create(parent);
+    lv_obj_remove_style_all(r);
+    lv_obj_remove_flag(r, LV_OBJ_FLAG_SCROLLABLE);
+    lv_obj_set_size(r, 320, 240);
+    lv_obj_set_style_bg_color(r, lv_color_black(), 0);
+    lv_obj_set_style_bg_opa(r, LV_OPA_COVER, 0);
+    lv_obj_t* sky = lv_obj_create(r);
+    lv_obj_remove_style_all(sky);
+    lv_obj_remove_flag(sky, LV_OBJ_FLAG_SCROLLABLE);
+    lv_obj_set_size(sky, 320, 240);
+    lv_obj_set_pos(sky, 0, 0);
+    lv_obj_add_event_cb(sky, draw_sky, LV_EVENT_DRAW_MAIN, const_cast<fl_t*>(g));
+    char a[24];
+    snprintf(a, sizeof(a), es ? "Tubos %d" : "Pipes %d", g->score);
+    lv_obj_t* l = lv_label_create(r);
+    lv_label_set_text(l, a);
+    lv_obj_set_style_text_font(l, &lv_font_montserrat_20, 0);
+    lv_obj_set_style_text_color(l, lv_color_hex(0xE8E8E8), 0);
+    lv_obj_set_width(l, 320);
+    lv_obj_set_style_text_align(l, LV_TEXT_ALIGN_CENTER, 0);
+    lv_obj_set_pos(l, 0, 4);
+    return r;
+}
+
+// Invalidate only what a step changed (fl_dirty): the sky object is the first child of the screen root. Call it after each fl_step with the state before and after.
+inline void invalidate_dirty(lv_obj_t* root, const fl_t& before, const fl_t& after)
+{
+    lv_obj_t* sky = lv_obj_get_child(root, 0);
+    fl_rect_t r[FL_PIPES * 4 + 2];
+    const int n = fl_dirty(&before, &after, r);
+    for (int i = 0; i < n; i++) {
+        lv_area_t a = {static_cast<lv_coord_t>(r[i].x), static_cast<lv_coord_t>(r[i].y), static_cast<lv_coord_t>(r[i].x + r[i].w - 1), static_cast<lv_coord_t>(r[i].y + r[i].h - 1)};
+        lv_obj_invalidate_area(sky, &a);
+    }
+}
+
+}  // namespace flys
+
+#endif
