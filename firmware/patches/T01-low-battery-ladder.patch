@@ -0,0 +1,14 @@
+/*
+ * SPDX-License-Identifier: MIT
+ *
+ * The unit's daily rules (patches T01 to T05): the low-battery ladder, the hourly chime, the wake cue, the
+ * quiet reconnect and the camera-on cue. One small tick, once a second, on the existing stackchan task.
+ * Logic lives in the plain-C cores (maipai_battery_core.h and the others), tested on a PC.
+ */
+#pragma once
+#include <sdkconfig.h>
+
+// Call often (the 20 ms stackchan task); it does its work at most once a second.
+void maipai_daily_tick();
+// Registers the test tools of the daily rules (self.battery.simulate).
+void maipai_daily_register_tools();
