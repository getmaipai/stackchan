diff --git a/firmware/main/hal/maipai_fx.cc b/firmware/main/hal/maipai_fx.cc
index a7d76d1..19c9b46 100644
--- a/firmware/main/hal/maipai_fx.cc
+++ b/firmware/main/hal/maipai_fx.cc
@@ -504,6 +504,33 @@ void on_prefs(uint32_t changed)
 }
 }  // namespace
 
+#if CONFIG_MAIPAI_FACE_BENCH
+// Patch FI06 (bench builds only): the overlays and the screen effects are drawn on the pixels in the flush hook, after LVGL, so a screen
+// snapshot never held them. This runs the same two passes over a snapshot picture (RGB565, little endian). Caller holds the LVGL lock.
+void maipai_fx_snapshot_post(uint8_t* data, int w, int h, int stride)
+{
+    const bool overlays = !s_ov_hidden && mo_any(s_ov);
+    if (!overlays && !mfx_any(&s_fx)) {
+        return;
+    }
+    const bool whole = stride == w * 2;
+    const int bands  = whole ? 1 : h;
+    const int rows   = whole ? h : 1;
+    for (int b = 0; b < bands; b++) {
+        const int y1     = whole ? 0 : b;
+        uint16_t* pixels = reinterpret_cast<uint16_t*>(data + static_cast<size_t>(y1) * stride);
+        if (overlays) {
+            mc_t cv = mc_make(pixels, 0, y1, w - 1, y1 + rows - 1, maipai_banner_zone_busy() ? 1 : 0, maipai_subtitles_visible() ? 1 : 0);
+            ov_protect_face(&cv);
+            mo_draw_all(s_ov, &cv);
+        }
+        if (mfx_any(&s_fx)) {
+            mfx_post(&s_fx, pixels, 0, y1, w - 1, y1 + rows - 1);
+        }
+    }
+}
+#endif
+
 mp_prefs_t maipai_prefs()
 {
     ensure_loaded();
