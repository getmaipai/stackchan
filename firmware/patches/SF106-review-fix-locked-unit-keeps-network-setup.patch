# Intent: Review fix (lock): a locked unit keeps its network and pairing setup and does not tell it. The tools that read the saved Wi-Fi list (self.wifi.list_saved was open) or change the Wi-Fi, the private network, the pairing or the brain route are refused while the unit is locked, in one table (maipai_lock_gate_core.h) checked in the tool dispatcher, so a tool added later under those names is covered without its own check. The refusal says the unit is locked and to unlock it with the code on its screen. Test: lock_gate_core_test.c and a lint on the patch.
# Placement: unit
# Upstream: firmware/main/hal/maipai_lock_gate_core.h (ours); main/mcp_server.cc of the xiaozhi-esp32 tree (MIT)
# Check after a flash: lock the unit; self.wifi.list_saved, self.wifi.add, self.tailnet.set, self.link.pair and self.brain.set_route all answer that the unit is locked; unlock it: they work as before.
# Kconfig: none
# Memory cost: none (a table of five strings in flash).

diff --git a/firmware/xiaozhi-esp32/main/mcp_server.cc b/firmware/xiaozhi-esp32/main/mcp_server.cc
--- a/firmware/xiaozhi-esp32/main/mcp_server.cc
+++ b/firmware/xiaozhi-esp32/main/mcp_server.cc
@@ -21,6 +21,8 @@
 #include "update_verify.h"
 #include <hal/maipai_remote.h>
 #include <hal/maipai_cloudtest.h>
+#include <hal/maipai_lock.h>
+#include <hal/maipai_lock_gate_core.h>
 
 #define TAG "MCP"
 
@@ -447,6 +449,11 @@ void McpServer::DoToolCall(int id, const std::string& tool_name, const cJSON* to
         return tool->name() == tool_name;
     });
 
+    if (mlg_needs_unlock(tool_name.c_str()) && maipai_lock_locked()) {   // patch SF106 (review fix): a locked unit keeps its network and pairing setup, whoever asks
+        ReplyError(id, -32602, MLG_REFUSAL, response_sender);
+        return;
+    }
+
     if (!maipai_cloudtest_tool_allowed(tool_name.c_str())) {   // patch SF96: the vendor service reaches only a short list of generic tools
         ReplyError(id, -32602, "This tool is not available in the cloud brain test: " + tool_name, response_sender);
         return;
diff --git a/firmware/main/hal/maipai_lock_gate_core.h b/firmware/main/hal/maipai_lock_gate_core.h
new file mode 100644
--- /dev/null
+++ b/firmware/main/hal/maipai_lock_gate_core.h
@@ -0,0 +1,36 @@
+/*
+ * SPDX-License-Identifier: MIT
+ *
+ * Which tools a locked unit refuses (patch SF106, review fix). The lock keeps the unit's network and pairing setup: while it is locked, no tool may read the saved Wi-Fi
+ * list or change the Wi-Fi, the private network, the pairing or the brain route. One table, checked in one place (the tool dispatcher), instead of a check inside each tool
+ * that a new tool can forget. Plain C99.
+ */
+#ifndef MAIPAI_LOCK_GATE_CORE_H
+#define MAIPAI_LOCK_GATE_CORE_H
+
+#include <string.h>
+
+/* Tool names (or prefixes ending in a dot) that need an unlocked unit. */
+static const char* const MLG_NEEDS_UNLOCK[] = {
+    "self.wifi.",             /* list_saved, add, forget, switch: a locked unit keeps its networks and does not tell them */
+    "self.tailnet.set",       /* the private network's key and address */
+    "self.network.prefer_tailnet",
+    "self.link.",             /* pairing and the link key */
+    "self.brain.set_route",   /* leaving hosted erases the vendor link; choosing hosted changes where the voice goes */
+};
+#define MLG_COUNT (int)(sizeof(MLG_NEEDS_UNLOCK) / sizeof(MLG_NEEDS_UNLOCK[0]))
+
+static inline int mlg_needs_unlock(const char* tool)
+{
+    if (tool == NULL) return 0;
+    for (int i = 0; i < MLG_COUNT; i++) {
+        const char* p = MLG_NEEDS_UNLOCK[i];
+        const size_t n = strlen(p);
+        if (p[n - 1] == '.' ? strncmp(tool, p, n) == 0 : strcmp(tool, p) == 0) return 1;
+    }
+    return 0;
+}
+
+#define MLG_REFUSAL "The unit is locked. Unlock it with the code on its screen first."
+
+#endif
