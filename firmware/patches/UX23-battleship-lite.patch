# Intent: Battleship-lite (spec docs/design/battleship-lite.md, rank 7 of docs/plan/more-games.md): a 6 by 6 sea, the unit hides a 3, a 2 and another 2 (never touching), the person fires 22 shots by tapping cells; Hit, Sunk, all three sunk wins (You won), 22 shots without it loses (You lost), with the shots left on the shared game-over screen. Two new header-only files: the pure core (the fleet from a seed, shots, the end, the touch map) and the screen (the sea is ONE object with one draw callback, cells of 30 px). Registering the game, the touches (bs_hit), the sounds (drop, clack, fanfare), the best score and the game-over call are the firmware track's.
# Placement: unit
# Upstream: firmware/main/hal/maipai_battleship_core.h, maipai_battleship.h (new, ours)
# Check after a flash: Games, Battleship-lite: a blue sea of 36 cells and the numbers Shots 22 and Ships 3; a tap on a cell turns it into a pale dot (miss) or an amber spark (hit) and the word shows; a sunk ship shows as dark red bars; the same cell twice does nothing; the end shows the shared game-over screen.
# Kconfig: none

diff --git a/firmware/main/hal/maipai_battleship_core.h b/firmware/main/hal/maipai_battleship_core.h
new file mode 100644
--- /dev/null
+++ b/firmware/main/hal/maipai_battleship_core.h
@@ -0,0 +1,132 @@
+/*
+ * SPDX-License-Identifier: MIT
+ *
+ * Battleship-lite (patch UX23; spec docs/design/battleship-lite.md): a 6 by 6 sea, the unit hides one set of ships (a 3, a 2 and another 2, never touching one another, corners included), the
+ * person fires 22 shots by tapping cells. A hit says Hit, the last cell of a ship says Sunk; all three sunk is a win, 22 shots without it is a loss. A game with a real winner: it ends
+ * on You won or You lost with the shots left. Pure C99, no ESP and no LVGL call, no heap. The rules and the touch geometry live here so a host test checks them.
+ */
+#ifndef MAIPAI_BATTLESHIP_CORE_H
+#define MAIPAI_BATTLESHIP_CORE_H
+
+#include <stdint.h>
+#include <string.h>
+
+#define BS_N 6
+#define BS_CELLS 36
+#define BS_SHIPS 3
+#define BS_SHOTS 22
+enum { BS_PLAY = 0, BS_WON, BS_LOST };
+enum { BS_UNSEEN = 0, BS_MISS, BS_HIT, BS_SUNK };      /* what the person sees of a cell */
+enum { BS_R_IGNORED = 0, BS_R_MISS, BS_R_HIT, BS_R_SUNK, BS_R_WON, BS_R_LOST };
+
+typedef struct {
+    uint8_t ship[BS_CELLS];     /* 0 water, 1 to 3 the ship id: the unit's secret */
+    uint8_t seen[BS_CELLS];     /* BS_UNSEEN, BS_MISS, BS_HIT, BS_SUNK */
+    uint8_t len[BS_SHIPS + 1];
+    uint8_t hits[BS_SHIPS + 1];
+    uint8_t shots_left;
+    uint8_t ships_left;
+    uint8_t phase;
+    int8_t last;                /* the cell of the last shot, -1 before the first */
+    uint8_t last_result;
+    uint32_t rng;
+} bs_t;
+
+static inline uint32_t bs_rand(bs_t* g)
+{
+    g->rng = g->rng * 1664525u + 1013904223u;
+    return g->rng >> 8;
+}
+
+static inline void bs_init(bs_t* g, uint32_t seed)
+{
+    memset(g, 0, sizeof(*g));
+    g->rng = seed != 0 ? seed : 1u;
+    g->len[1] = 3;
+    g->len[2] = 2;
+    g->len[3] = 2;
+    for (int id = 1; id <= BS_SHIPS; id++) {
+        for (;;) {   /* a random place that is free and not next to another ship; the sea is tiny, so this ends at once */
+            const int horiz = (int)(bs_rand(g) % 2u), r = (int)(bs_rand(g) % BS_N), c = (int)(bs_rand(g) % BS_N);
+            const int dr = horiz ? 0 : 1, dc = horiz ? 1 : 0;
+            if (r + dr * (g->len[id] - 1) >= BS_N || c + dc * (g->len[id] - 1) >= BS_N) continue;
+            int ok = 1;
+            for (int k = 0; k < g->len[id] && ok; k++) {
+                const int rr = r + dr * k, cc = c + dc * k;
+                for (int ar = -1; ar <= 1 && ok; ar++)
+                    for (int ac = -1; ac <= 1 && ok; ac++) {
+                        const int nr = rr + ar, nc = cc + ac;
+                        if (nr >= 0 && nr < BS_N && nc >= 0 && nc < BS_N && g->ship[nr * BS_N + nc] != 0) ok = 0;   /* no cell of another ship touches this one, even at a corner */
+                    }
+            }
+            if (!ok) continue;
+            for (int k = 0; k < g->len[id]; k++) g->ship[(r + dr * k) * BS_N + c + dc * k] = (uint8_t)id;
+            break;
+        }
+    }
+    g->shots_left = BS_SHOTS;
+    g->ships_left = BS_SHIPS;
+    g->phase = BS_PLAY;
+    g->last = -1;
+}
+
+/* A shot at a cell. Returns BS_R_IGNORED for a cell already fired at, a bad index, or after the end. */
+static inline int bs_fire(bs_t* g, int idx)
+{
+    if (g->phase != BS_PLAY || idx < 0 || idx >= BS_CELLS || g->seen[idx] != BS_UNSEEN) return BS_R_IGNORED;
+    g->shots_left--;
+    g->last = (int8_t)idx;
+    int res;
+    if (g->ship[idx]) {
+        const int id = g->ship[idx];
+        g->seen[idx] = BS_HIT;
+        g->hits[id]++;
+        res = BS_R_HIT;
+        if (g->hits[id] == g->len[id]) {
+            for (int i = 0; i < BS_CELLS; i++) if (g->ship[i] == id) g->seen[i] = BS_SUNK;
+            g->ships_left--;
+            res = BS_R_SUNK;
+            if (g->ships_left == 0) { g->phase = BS_WON; res = BS_R_WON; }
+        }
+    } else {
+        g->seen[idx] = BS_MISS;
+        res = BS_R_MISS;
+    }
+    if (g->phase == BS_PLAY && g->shots_left == 0) { g->phase = BS_LOST; res = BS_R_LOST; }
+    g->last_result = (uint8_t)res;
+    return res;
+}
+
+/* ---- the screen: the sea on the left (cells 30 px with 2 px between, 190 by 190 at x 8, y 34), the numbers on the right ---- */
+#define BS_CELL 30
+#define BS_GAP 2
+#define BS_BX 8
+#define BS_BY 34
+static inline void bs_cell_box(int idx, int* x, int* y, int* w, int* h)
+{
+    *x = BS_BX + (idx % BS_N) * (BS_CELL + BS_GAP);
+    *y = BS_BY + (idx / BS_N) * (BS_CELL + BS_GAP);
+    *w = BS_CELL;
+    *h = BS_CELL;
+}
+/* The cell under a touch (the 2 px gaps belong to the cell on their left and above, so there is no dead strip), or -1. */
+static inline int bs_hit(int px, int py)
+{
+    const int span = BS_N * (BS_CELL + BS_GAP);
+    if (px < BS_BX || py < BS_BY || px >= BS_BX + span || py >= BS_BY + span) return -1;
+    return ((py - BS_BY) / (BS_CELL + BS_GAP)) * BS_N + (px - BS_BX) / (BS_CELL + BS_GAP);
+}
+
+static inline const char* bs_result_text(int result, int es)
+{
+    switch (result) {
+        case BS_R_MISS: return es ? "Agua" : "Miss";
+        case BS_R_HIT: return es ? "Tocado" : "Hit";
+        case BS_R_SUNK: return es ? "Hundido" : "Sunk";
+        case BS_R_WON: return es ? "Ganaste" : "You won";
+        case BS_R_LOST: return es ? "Perdiste" : "You lost";
+        default: return "";
+    }
+}
+
+#endif
diff --git a/firmware/main/hal/maipai_battleship.h b/firmware/main/hal/maipai_battleship.h
new file mode 100644
--- /dev/null
+++ b/firmware/main/hal/maipai_battleship.h
@@ -0,0 +1,83 @@
+// SPDX-License-Identifier: MIT
+// The Battleship-lite screen (patch UX23; spec docs/design/battleship-lite.md). Header only, so the host renderer compiles the very same drawing code. The sea is drawn by ONE object and one draw
+// callback (the grid-game pattern); the numbers on the right are labels. The firmware track wires the touches (bs_hit), the sounds, and the game-over call (You won or You lost, with the shots left).
+#ifndef MAIPAI_BATTLESHIP_H
+#define MAIPAI_BATTLESHIP_H
+
+#include <lvgl.h>
+#include <stdio.h>
+#include "maipai_battleship_core.h"
+
+namespace bsh {
+
+inline void rect(lv_layer_t* layer, int x, int y, int w, int h, int radius, uint32_t color, lv_opa_t opa = LV_OPA_COVER)
+{
+    lv_draw_rect_dsc_t d;
+    lv_draw_rect_dsc_init(&d);
+    d.bg_color = lv_color_hex(color);
+    d.bg_opa = opa;
+    d.radius = radius;
+    lv_area_t a = {static_cast<lv_coord_t>(x), static_cast<lv_coord_t>(y), static_cast<lv_coord_t>(x + w - 1), static_cast<lv_coord_t>(y + h - 1)};
+    lv_draw_rect(layer, &d, &a);
+}
+
+inline void draw_sea(lv_event_t* e)
+{
+    const bs_t* g = static_cast<const bs_t*>(lv_event_get_user_data(e));
+    if (g == nullptr) return;
+    lv_layer_t* layer = lv_event_get_layer(e);
+    for (int i = 0; i < BS_CELLS; i++) {
+        int x, y, w, h;
+        bs_cell_box(i, &x, &y, &w, &h);
+        const int s = g->seen[i];
+        rect(layer, x, y, w, h, 4, s == BS_SUNK ? 0x7A2E2E : (s == BS_HIT ? 0xC0562E : 0x1B3A5C));
+        if (s == BS_MISS) rect(layer, x + 11, y + 11, 8, 8, LV_RADIUS_CIRCLE, 0x8FB4DA);                       // a miss: a small pale dot in the water
+        if (s == BS_HIT) rect(layer, x + 8, y + 8, 14, 14, LV_RADIUS_CIRCLE, 0xF2B24A);                         // a hit: an amber spark
+        if (s == BS_SUNK) { rect(layer, x + 6, y + 13, 18, 4, 2, 0xE8E8E8); }                                  // a sunk ship: a light bar across the cell
+        if (i == g->last) rect(layer, x, y, w, 2, 0, 0xFFFFFF);                                                 // the last shot: a white edge on top
+    }
+}
+
+inline lv_obj_t* words(lv_obj_t* parent, const char* t, const lv_font_t* font, uint32_t rgb, int x, int y, int w)
+{
+    lv_obj_t* l = lv_label_create(parent);
+    lv_label_set_text(l, t);
+    lv_obj_set_style_text_font(l, font, 0);
+    lv_obj_set_style_text_color(l, lv_color_hex(rgb), 0);
+    lv_label_set_long_mode(l, LV_LABEL_LONG_WRAP);
+    lv_obj_set_width(l, w);
+    lv_obj_set_pos(l, x, y);
+    return l;
+}
+
+// `g` must outlive the screen. The numbers: shots left, ships left, and the word for the last shot.
+inline lv_obj_t* screen(lv_obj_t* parent, const bs_t* g, bool es)
+{
+    lv_obj_t* r = lv_obj_create(parent);
+    lv_obj_remove_style_all(r);
+    lv_obj_remove_flag(r, LV_OBJ_FLAG_SCROLLABLE);
+    lv_obj_set_size(r, 320, 240);
+    lv_obj_set_style_bg_color(r, lv_color_black(), 0);
+    lv_obj_set_style_bg_opa(r, LV_OPA_COVER, 0);
+    lv_obj_t* sea = lv_obj_create(r);
+    lv_obj_remove_style_all(sea);
+    lv_obj_remove_flag(sea, LV_OBJ_FLAG_CLICKABLE);
+    lv_obj_remove_flag(sea, LV_OBJ_FLAG_SCROLLABLE);
+    lv_obj_set_size(sea, 320, 240);
+    lv_obj_set_pos(sea, 0, 0);
+    lv_obj_add_event_cb(sea, draw_sea, LV_EVENT_DRAW_MAIN, const_cast<bs_t*>(g));
+    char a[24], b[24];
+    snprintf(a, sizeof(a), es ? "Tiros %d" : "Shots %d", g->shots_left);
+    snprintf(b, sizeof(b), es ? "Barcos %d" : "Ships %d", g->ships_left);
+    words(r, a, &lv_font_montserrat_20, 0xE8E8E8, 216, 44, 96);
+    words(r, b, &lv_font_montserrat_20, 0xB8C4D8, 216, 76, 96);
+    if (g->last_result) {
+        const int res = g->last_result;
+        words(r, bs_result_text(res, es), &lv_font_montserrat_20, res == BS_R_MISS ? 0x8FB4DA : (res == BS_R_LOST ? 0xE07A7A : 0xF2B24A), 216, 124, 96);
+    }
+    return r;
+}
+
+}  // namespace bsh
+
+#endif
