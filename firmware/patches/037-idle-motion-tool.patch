     Unlock();
 }
 
+void StackChanAvatarDisplay::SetIdleMotionEnabled(bool enabled)
+{
+    // The host's choice is saved (only when it changes, to spare the flash) and read again at boot.
+    if (idle_motion_enabled_ != enabled) {
+        Settings motion_settings("xiaozhi", true);
+        motion_settings.SetInt("idle_motion", enabled ? 1 : 0);
+    }
+    idle_motion_enabled_ = enabled;
+    auto& stackchan      = GetStackChan();
+    if (!enabled) {
+        if (idle_motion_modifier_id_ >= 0) {
+            stackchan.removeModifier(idle_motion_modifier_id_);
+            idle_motion_modifier_id_ = -1;
+        }
+        return;
+    }
+    if (idle_motion_modifier_id_ < 0 && idle_motion_level_ > 0 && !is_sleeping_ && !quiet_face_ &&
+        hal_bridge::is_xiaozhi_idle()) {
+        CreateIdleMotionModifier();
+    }
+}
+
 void StackChanAvatarDisplay::CreateIdleMotionModifier()
 {
     auto& stackchan = GetStackChan();
@@ -1104,12 +1132,12 @@ void StackChanAvatarDisplay::SetStatus(const char* status)
     }
 
     if (is_idle) {
-        // Start idle motion
+        // Start idle motion (only when the host or the saved choice allows it; stillness is the default)
         ESP_LOGW(TAG, "Start idle motion");
-        if (idle_motion_modifier_id_ < 0) {
-            if (idle_motion_level_ > 0) {
-                CreateIdleMotionModifier();
-            }
+        if (idle_motion_modifier_id_ < 0 && idle_motion_enabled_ && idle_motion_level_ > 0) {
+            CreateIdleMotionModifier();
+        }
+        if (idle_expression_modifier_id_ < 0) {
             idle_expression_modifier_id_ = stackchan.addModifier(std::make_unique<IdleExpressionModifier>());
         }
 
@@ -1120,16 +1148,12 @@ void StackChanAvatarDisplay::SetStatus(const char* status)
         if (idle_motion_modifier_id_ >= 0) {
             stackchan.removeModifier(idle_motion_modifier_id_);
             idle_motion_modifier_id_ = -1;
+        }
+        if (idle_expression_modifier_id_ >= 0) {
             stackchan.removeModifier(idle_expression_modifier_id_);
             idle_expression_modifier_id_ = -1;
         }
 
-        // if (!is_listening) {
