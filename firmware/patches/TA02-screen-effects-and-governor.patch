+void maipai_fx_note_emotion(const char* emotion)
+{
+    const bool asleep = emotion != nullptr && (strcmp(emotion, "sleeping") == 0 || strcmp(emotion, "closing") == 0);
+    if (asleep != s_sleeping) {
+        s_sleeping = asleep;
+        apply_effects();  // the halo goes while the eyes are shut
+    }
+}
