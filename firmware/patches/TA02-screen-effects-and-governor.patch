+}
+
+void maipai_fx_attach(lv_display_t* display)
+{
+    ensure_loaded();
+    s_disp = display;
+    if (display == nullptr || display->flush_cb == nullptr) {
+        return;
+    }
+    mg_init(&s_gov);
+    memset(&s_fx, 0, sizeof s_fx);
+    s_orig_flush = display->flush_cb;
+    lv_display_set_flush_cb(display, post_to_flush);
+    lv_display_add_event_cb(display, on_refresh, LV_EVENT_REFR_START, nullptr);
+    lv_display_add_event_cb(display, on_refresh, LV_EVENT_REFR_READY, nullptr);
+    s_gov_timer = lv_timer_create(gov_tick, 1000, nullptr);
+    maipai_prefs_watch(on_prefs);
+    style_refresh();
+    apply_effects();
+    ESP_LOGI(TAG, "effects attached: crt %d, night %d, colour mode %d, glow %d", s_fx.crt, s_fx.night, s_fx.mode, s_fx.glow);
+}
+
+void maipai_fx_style_changed()
+{
+    style_refresh();
+    apply_effects();
+}
