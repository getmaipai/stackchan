+
+// ------------------------------------------------------------------------------------------ screen effects (TA02)
+
+// All of this runs on the LVGL task (the flush callback, the refresh events, the timers) or under the LVGL lock (the tools),
+// so none of it needs a lock of its own.
+lv_display_t* s_disp                 = nullptr;
+lv_display_flush_cb_t s_orig_flush   = nullptr;
+mfx_t s_fx;                          // what the flush callback applies now
+uint8_t* s_gmask                     = nullptr;  // the baked halo: PSRAM, only while the glow is on
+int s_gmask_d                        = 0;        // the eye diameter it was baked for
+mg_t s_gov;
+int s_style_id                       = ML_STYLE_BIG_EYES;
+bool s_style_stock                   = false;
+bool s_sleeping                      = false;
+int64_t s_refr_start_us              = 0;
+volatile uint64_t s_post_us          = 0;        // time spent in the flush step since the last status read
+volatile uint32_t s_post_n           = 0;
+volatile uint32_t s_post_worst_us    = 0;
+lv_timer_t* s_gov_timer              = nullptr;
+
+void invalidate_screen()
+{
+    if (s_disp != nullptr) {
+        lv_obj_invalidate(lv_display_get_screen_active(s_disp));
+    }
+}
+
+// Rebuilds s_fx from the saved preferences, the governor's level, and what the face shows. Caller: the LVGL task or lock.
+void apply_effects()
+{
+    const mp_prefs_t p = maipai_prefs();
+    const bool flat    = mg_flat(&s_gov);
+    mfx_t next         = s_fx;
+    next.crt           = !flat && p.v[MP_FX_CRT] && mg_scan_ok(&s_gov);
+    next.night         = !flat && p.v[MP_FX_NIGHT_DIM];
+    mfx_set_mode(&next, flat ? 0 : p.v[MP_FX_COLOUR_MODE]);
+    const ml_style_t* st = ml_style(s_style_id);
+    const bool want_glow = !flat && p.v[MP_FX_GLOW] && mg_glow_ok(&s_gov) && !s_sleeping && st->eye_d > 0 &&
+                           mfx_glow_side(st->eye_d) <= MFX_GLOW_MAX_SIDE;
+    if (want_glow) {
+        if (s_gmask == nullptr) {
+            s_gmask = static_cast<uint8_t*>(heap_caps_malloc(MFX_GLOW_MAX_SIDE * MFX_GLOW_MAX_SIDE, MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT));
+            s_gmask_d = 0;
+        }
+        if (s_gmask != nullptr && s_gmask_d != st->eye_d) {
+            next.gside = mfx_glow_bake(s_gmask, st->eye_d);
+            s_gmask_d  = st->eye_d;
+        }
+        if (s_gmask != nullptr) {
+            next.gmask = s_gmask;
+            next.gx[0] = 160 - st->eye_x - next.gside / 2;
+            next.gx[1] = 160 + st->eye_x - next.gside / 2;
+            next.gy    = 120 + st->eye_y - next.gside / 2;
+            next.gcol  = 0xFFFF;
+            next.glow  = 1;
+        } else {
+            next.glow = 0;  // no memory for the halo: no glow, no error
+        }
+    } else {
+        next.glow = 0;
+        if (s_gmask != nullptr && !p.v[MP_FX_GLOW]) {  // the setting is off: give the memory back
+            next.gmask = nullptr;
+            heap_caps_free(s_gmask);
+            s_gmask   = nullptr;
+            s_gmask_d = 0;
+        }
+    }
+    const bool same = memcmp(&next, &s_fx, offsetof(mfx_t, ramp)) == 0 && next.mode == s_fx.mode;
+    s_fx            = next;
+    if (!same) {
+        invalidate_screen();  // the whole screen is drawn again once, in the new look
+    }
+}
+
+void post_to_flush(lv_display_t* d, const lv_area_t* a, uint8_t* px)
+{
+    if (mfx_any(&s_fx)) {
+        const int64_t t0 = esp_timer_get_time();
+        mfx_post(&s_fx, reinterpret_cast<uint16_t*>(px), a->x1, a->y1, a->x2, a->y2);
+        const uint32_t us = static_cast<uint32_t>(esp_timer_get_time() - t0);
+        s_post_us += us;
+        s_post_n++;
+        if (us > s_post_worst_us) s_post_worst_us = us;
+    }
+    s_orig_flush(d, a, px);
+}
+
+void on_refresh(lv_event_t* e)
+{
+    if (lv_event_get_code(e) == LV_EVENT_REFR_START) {
+        s_refr_start_us = esp_timer_get_time();
+        return;
+    }
+    if (s_refr_start_us == 0) {
+        return;
+    }
+    const uint32_t us = static_cast<uint32_t>(esp_timer_get_time() - s_refr_start_us);
+    s_refr_start_us   = 0;
+    if (mg_feed(&s_gov, static_cast<uint32_t>(esp_timer_get_time() / 1000), us)) {
+        ESP_LOGW(TAG, "governor: level %d (load %u percent, worst frame %u us)", s_gov.level, (unsigned)s_gov.last_load_pct,
+                 (unsigned)s_gov.last_worst_us);
+        apply_effects();
+    }
+}
+
+// Once a second while the governor holds a level above zero: a quiet second counts as calm and restores a step.
+void gov_tick(lv_timer_t*)
+{
+    if (mg_idle(&s_gov, static_cast<uint32_t>(esp_timer_get_time() / 1000))) {
+        ESP_LOGI(TAG, "governor: restored to level %d", s_gov.level);
+        apply_effects();
+    }
+}
+
+void style_refresh()
+{
+    const mf_config_t c = maipai_face_config();
+    s_style_id          = mf_look_id(c.style);
+    s_style_stock       = c.style == MF_STYLE_STOCK;
+}
+
+void on_prefs(uint32_t changed)
+{
+    const uint32_t fxbits = (1u << MP_FX_CRT) | (1u << MP_FX_COLOUR_MODE) | (1u << MP_FX_NIGHT_DIM) | (1u << MP_FX_GLOW);
+    if (changed & fxbits) {
+        LvglLockGuard lock;
+        style_refresh();
+        apply_effects();
+    }
+}
