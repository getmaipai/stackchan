diff --git a/firmware/main/hal/maipai_lines.cc b/firmware/main/hal/maipai_lines.cc
new file mode 100644
--- /dev/null
+++ b/firmware/main/hal/maipai_lines.cc
@@ -0,0 +1,65 @@
+/*
+ * SPDX-License-Identifier: MIT
+ * Memory cost: nothing is allocated while idle. A shelf copy (up to 40 KB PSRAM) and the short text (101 bytes stack) exist only during selection/play setup; the shelf is freed immediately after copying the chosen line.
+ */
+#include "maipai_lines.h"
+#include "maipai_assets.h"
+#include "maipai_assets_core.h"
+#include "maipai_lines_core.h"
+#include "maipai_mumble.h"
+#include "maipai_subtitles.h"
+#include "maipai_banner.h"
+#include "maipai_sounds.h"
+#include "maipai_games.h"
+#include "maipai_face.h"
+#include <application.h>
+#include <esp_timer.h>
+#include <mcp_server.h>
+#include <string>
+
+#if CONFIG_MAIPAI_PANTRY && CONFIG_MAIPAI_ASSET_STORE
+namespace {
+constexpr int kPantryKind = 7;
+ml_state_t s_lines = {};
+}
+
+bool maipai_lines_say(const char* situation)
+{
+    if (ml_situation_index(situation) < 0 || Application::GetInstance().GetDeviceState() != kDeviceStateIdle || maipai_games_active()) return false;
+    if (!maipai_sounds_gate("popup") || Application::GetInstance().GetDeviceState() == kDeviceStateSpeaking) return false;
+    uint8_t slots[8];
+    const int n = maipai_assets_slots(kPantryKind, slots);
+    const mf_config_t face = maipai_face_config();
+    const char* language = face.lang < MF_LANG_COUNT ? MF_LANG_CODES[face.lang] : "en";
+    for (int k = 0; k < n; ++k) {
+        uint8_t* bytes = nullptr; size_t len = 0;
+        if (!maipai_assets_load(kPantryKind, slots[k], &bytes, &len, nullptr)) continue;
+        mpy_shelf_t shelf;
+        if (mpy_parse(bytes, (uint32_t)len, &shelf) != MPY_OK) { maipai_assets_free(bytes); continue; }
+        if (strncmp(shelf.lang, language, 2) != 0) { maipai_assets_free(bytes); continue; }
+        const int ix = ml_situation_index(situation);
+        const uint32_t seed = (uint32_t)(esp_timer_get_time() / 1000) + (uint32_t)k * 7919u;
+        const int pick = ml_pick(&shelf, situation, static_cast<uint32_t>(esp_timer_get_time() / 1000), seed, &s_lines);
+        if (pick >= 0 && ix >= 0) {
+            mpy_rec_t rec; mpy_get(&shelf, (uint32_t)pick, &rec);
+            char text[ML_TEXT_MAX + 1];
+            memcpy(text, rec.text, rec.text_len); text[rec.text_len] = '\0';
+            maipai_assets_free(bytes);
+            if (maipai_banner_captions() == MB_CAP_SUBTITLES) maipai_subtitles_say(text, false);
+            maipai_mumble_say(text, 0);
+            return true;
+        }
+        maipai_assets_free(bytes);
+    }
+    return false;
+}
+
+void maipai_lines_register_tools()
+{
+#if CONFIG_MAIPAI_BENCH || CONFIG_MAIPAI_SERIAL_TOOLS
+    McpServer::GetInstance().AddTool("self.lines.say", "Show and mumble a pantry line for one situation tag. Tags: greeting_morning, greeting_day, greeting_evening, goodnight, touch_head, touch_face, pick_up, put_down, shaken, loud_noise, wake_heard_offline, cannot_reach_home, back_online, timer_done, battery_low, thanks, bored, sleepy, happy, curious. Answers {ok} or {ok:false}.",
+        PropertyList({Property("situation", kPropertyTypeString, std::string("greeting_day"))}),
+        [](const PropertyList& p) -> ReturnValue { const bool ok = maipai_lines_say(p["situation"].value<std::string>().c_str()); return std::string(ok ? "{\"ok\":true}" : "{\"ok\":false}"); });
+#endif
+}
+#endif
