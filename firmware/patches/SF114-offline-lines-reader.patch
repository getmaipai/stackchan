diff --git a/firmware/main/hal/maipai_lines_core.h b/firmware/main/hal/maipai_lines_core.h
new file mode 100644
--- /dev/null
+++ b/firmware/main/hal/maipai_lines_core.h
@@ -0,0 +1,64 @@
+/* SPDX-License-Identifier: MIT */
+#ifndef MAIPAI_LINES_CORE_H
+#define MAIPAI_LINES_CORE_H
+
+#include <stdint.h>
+#include <string.h>
+#include "maipai_pantry_core.h"
+
+#define ML_SITUATION_COUNT 20
+#define ML_COOLDOWN_MS 30000u
+#define ML_TEXT_MAX 100u
+
+static const char* const ML_SITUATIONS[ML_SITUATION_COUNT] = {
+    "greeting_morning", "greeting_day", "greeting_evening", "goodnight", "touch_head", "touch_face",
+    "pick_up", "put_down", "shaken", "loud_noise", "wake_heard_offline", "cannot_reach_home",
+    "back_online", "timer_done", "battery_low", "thanks", "bored", "sleepy", "happy", "curious"
+};
+
+typedef struct {
+    uint32_t last_ms[ML_SITUATION_COUNT];
+    int16_t last_record[ML_SITUATION_COUNT];
+    uint8_t used[ML_SITUATION_COUNT];
+} ml_state_t;
+
+static inline int ml_situation_index(const char* tag)
+{
+    if (tag == 0) return -1;
+    for (int i = 0; i < ML_SITUATION_COUNT; ++i) if (strcmp(tag, ML_SITUATIONS[i]) == 0) return i;
+    return -1;
+}
+
+/* True when the record's extra is exactly the situation tag (the extra is not terminated: the next record's text follows it). */
+static inline int ml_extra_is(const mpy_rec_t* r, const char* tag)
+{
+    const size_t n = strlen(tag);
+    return r->extra_len == n && memcmp(r->extra, tag, n) == 0;
+}
+
+static inline int ml_pick(const mpy_shelf_t* s, const char* situation, uint32_t now_ms, uint32_t seed, ml_state_t* state)
+{
+    const int ix = ml_situation_index(situation);
+    if (ix < 0 || state == 0) return -1;
+    if (state->used[ix] && (uint32_t)(now_ms - state->last_ms[ix]) < ML_COOLDOWN_MS) return -1;
+    int found = 0;
+    for (uint32_t i = 0; i < s->count; ++i) {
+        mpy_rec_t r; mpy_get(s, i, &r);
+        if (r.kind == MPY_LINE && ml_extra_is(&r, situation) && r.text_len <= ML_TEXT_MAX) found++;
+    }
+    if (!found) return -1;
+    uint32_t last = UINT32_MAX;
+    if (found > 1 && state->used[ix] && state->last_record[ix] >= 0 && (uint32_t)state->last_record[ix] < s->count)
+        last = (uint32_t)state->last_record[ix];
+    uint32_t pick = (seed | 1u) % (uint32_t)(found - (last != UINT32_MAX ? 1 : 0));
+    for (uint32_t i = 0; i < s->count; ++i) {
+        mpy_rec_t r; mpy_get(s, i, &r);
+        if (r.kind != MPY_LINE || !ml_extra_is(&r, situation) || r.text_len > ML_TEXT_MAX || i == last) continue;
+        if (pick-- == 0) {
+            state->last_ms[ix] = now_ms; state->last_record[ix] = (int16_t)i; state->used[ix] = 1;
+            return (int)i;
+        }
+    }
+    return -1;
+}
+#endif
