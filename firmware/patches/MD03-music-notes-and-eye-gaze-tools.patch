         default: return 0;
     }
 }
@@ -144,7 +146,7 @@ static inline md_part_t md_falling_drop(uint32_t t_ms, uint32_t period_ms, uint3
  * The parts of a decorator `t_ms` after it began. Returns how many were written (at most `cap`); the rest of `out` is
  * left alone. A kind with no parts (none, or an unknown one) writes nothing.
  */
-static inline int md_parts(int kind, uint32_t t_ms, md_part_t* out, int cap)
+static inline int md_parts_n(int kind, uint32_t t_ms, md_part_t* out, int cap, int arg)
 {
     const int n = md_part_count(kind);
     if (n == 0 || cap < n) {
@@ -236,9 +238,32 @@ static inline int md_parts(int kind, uint32_t t_ms, md_part_t* out, int cap)
             }
             break;
         }
+        case MD_NOTES: {
+            /* Up to three eighth notes (a head, a stem and a flag each) float up the sides of the face, a third of a cycle apart, and fade
+             * in the last quarter. arg is how many show (1 to 3); the others are hidden. */
+            static const int16_t nx[3] = {-138, 138, -120};
+            for (int k = 0; k < 3; k++) {
+                const uint32_t p = (t_ms + (uint32_t)k * 800u) % 2400u;
+                const int x = nx[k] + md_sin256((int)(p * 360u / 1200u)) * 6 / 256;
+                const int y = 40 - (int)(p * 100u / 2400u);
+                int opa = 255;
+                if (p > 1800u) {
+                    opa = (int)(255 - (p - 1800u) * 255u / 600u);
+                }
+                if (k >= arg) {
+                    opa = 0;
+                }
+                out[k * 3] = md_part(x, y, 12, 9, -200, 1, opa);          /* the head */
+                out[k * 3 + 1] = md_part(x + 5, y - 11, 3, 20, 0, 0, opa); /* the stem */
+                out[k * 3 + 2] = md_part(x + 9, y - 19, 9, 3, 450, 0, opa); /* the flag */
+            }
+            break;
+        }
         default: return 0;
     }
     return n;
 }
 
+static inline int md_parts(int kind, uint32_t t_ms, md_part_t* out, int cap) { return md_parts_n(kind, t_ms, out, cap, 3); }
+
 #endif
