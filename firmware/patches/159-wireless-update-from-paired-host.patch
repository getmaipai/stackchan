diff --git a/firmware/main/hal/maipai_update.h b/firmware/main/hal/maipai_update.h
new file mode 100644
--- /dev/null
+++ b/firmware/main/hal/maipai_update.h
@@ -0,0 +1,13 @@
+/*
+ * SPDX-License-Identifier: MIT
+ */
+#pragma once
+#include <cstddef>
+#include <string>
+
+// Patch 159: wireless firmware update from the paired host. Starts one update in its own task.
+// Returns "" when the update started, otherwise a plain sentence saying what is wrong and what to do.
+std::string maipai_update_start(const char* url, size_t size, const char* version);
+
+// True while an update is downloading or being checked.
+bool maipai_update_active();
diff --git a/firmware/main/hal/maipai_update.cc b/firmware/main/hal/maipai_update.cc
new file mode 100644
--- /dev/null
+++ b/firmware/main/hal/maipai_update.cc
@@ -0,0 +1,142 @@
+/*
+ * SPDX-License-Identifier: MIT
+ */
+#include "maipai_update.h"
+#include "hal.h"
+#include "device_events.h"
+#include <application.h>
+#include <ota.h>
+#include <settings.h>
+#include <update_verify.h>
+#include <esp_app_desc.h>
+#include <esp_log.h>
+#include <esp_ota_ops.h>
+#include <esp_system.h>
+#include <freertos/FreeRTOS.h>
+#include <freertos/task.h>
+#include <atomic>
+#include <cstdio>
+#include <cstring>
+#include <new>
+
+namespace {
+
+const char* const kTag = "MaipaiUpdate";
+constexpr int kMinBatteryPercent = 40;
+constexpr uint32_t kTaskStackBytes = 10240;
+
+std::atomic<bool> s_active{false};
+
+struct Job {
+    char url[256];
+    char version[32];
+};
+
+void note_failure(const char* reason)
+{
+    char extra[240];
+    std::snprintf(extra, sizeof(extra), "\"reason\":\"%s\"", reason);
+    device_events_push("firmware_update_failed", extra);
+    ESP_LOGE(kTag, "%s", reason);
+}
+
+void update_task(void* arg)
+{
+    Job* job = static_cast<Job*>(arg);
+    device_events_push("firmware_update_started", "\"percent\":0");
+    int last_percent = -10;
+    // Ota::Upgrade checks the Ed25519 signature while the image streams in and sets the new slot to boot
+    // only after the check passes (patch 155); the address and the 20 percent rule are checked again inside.
+    const bool ok = Ota::Upgrade(job->url, [&last_percent](int progress, size_t) {
+        if (progress >= last_percent + 10 && progress < 100) {
+            last_percent = progress;
+            char extra[32];
+            std::snprintf(extra, sizeof(extra), "\"percent\":%d", progress);
+            device_events_push("firmware_update_progress", extra);
+        }
+    });
+    if (!ok) {
+        const char* why = UpdateRefusal();
+        note_failure(why[0] != '\0' ? why
+                                    : "The update did not finish: the unit could not download or write the image. "
+                                      "Check that the host is reachable and try again.");
+        delete job;
+        s_active = false;
+        vTaskDelete(nullptr);
+        return;
+    }
+    char extra[64];
+    std::snprintf(extra, sizeof(extra), "\"version\":\"%s\"", job->version);
+    device_events_push("firmware_update_done", extra);
+    ESP_LOGI(kTag, "update written and signature checked; restarting into the new image");
+    vTaskDelay(pdMS_TO_TICKS(2500));  // lets the host read the done event
+    esp_restart();
+    delete job;
+    vTaskDelete(nullptr);
+}
+
+bool safe_version(const char* text)
+{
+    if (text == nullptr || text[0] == '\0' || std::strlen(text) > 31) return false;
+    for (const char* c = text; *c != '\0'; ++c) {
+        const bool ok = (*c >= '0' && *c <= '9') || (*c >= 'a' && *c <= 'z') || (*c >= 'A' && *c <= 'Z') ||
+                        *c == '.' || *c == '-' || *c == '_' || *c == '+';
+        if (!ok) return false;
+    }
+    return true;
+}
+
+}  // namespace
+
+bool maipai_update_active()
+{
+    return s_active.load();
+}
+
+std::string maipai_update_start(const char* url, size_t size, const char* version)
+{
+    if (url == nullptr || std::strlen(url) < 8 || std::strlen(url) > 250) {
+        return "Update refused: the image address is missing or too long. Send a short http address on the paired host.";
+    }
+    Settings paired("websocket", false);
+    if (!UpdateUrlIsPairedHost(url, paired.GetString("url"))) {
+        return "Update refused: the image address is not the paired host. Start the update from the host the unit is paired with.";
+    }
+    if (!safe_version(version)) {
+        return "Update refused: the version text is missing or has odd characters. Send a version such as 1.2.0.";
+    }
+    const esp_app_desc_t* running = esp_app_get_description();
+    if (running != nullptr && std::strcmp(running->version, version) == 0) {
+        return "Update refused: the unit already runs this version. Nothing to do.";
+    }
+    const esp_partition_t* next = esp_ota_get_next_update_partition(nullptr);
+    if (next == nullptr) {
+        return "Update refused: the unit has no second update slot. Flash it once over USB with the full image.";
+    }
+    if (size != 0 && !UpdateFitsSlot(size, next->size)) {
+        return "Update refused: the image would leave less than 20 percent of its slot free. Build a smaller image.";
+    }
+    bool expected = false;
+    if (!s_active.compare_exchange_strong(expected, true)) {
+        return "An update is already running. Wait for it to finish.";
+    }
+    auto fail = [](const char* why) {
+        s_active = false;
+        return std::string(why);
+    };
+    if (Application::GetInstance().GetDeviceState() != kDeviceStateIdle) {
+        return fail("The unit is busy talking. Try again when it is idle.");
+    }
+    if (!GetHAL().isBatteryCharging() && GetHAL().getBatteryLevel() < kMinBatteryPercent) {
+        return fail("The battery is below 40 percent. Put the unit on its charger and try again.");
+    }
+    Job* job = new (std::nothrow) Job();
+    if (job == nullptr) return fail("The unit is low on memory. Restart it and try again.");
+    std::snprintf(job->url, sizeof(job->url), "%s", url);
+    std::snprintf(job->version, sizeof(job->version), "%s", version);
+    if (xTaskCreate(update_task, "fwupdate", kTaskStackBytes, job, 5, nullptr) != pdPASS) {
+        delete job;
+        return fail("The unit is low on memory. Restart it and try again.");
+    }
+    return "";
+}
