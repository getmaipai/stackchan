# Intent: Wireless firmware update from the paired host only (CORE-V1 row 133, rebuilt on patch 155). The host calls the new tool self.firmware.update with the address of one image on its own address; the unit refuses any address that is not the host it is paired with, refuses an image that would leave less than 20 percent of its slot free, streams the image into the inactive slot while it checks the Ed25519 signature, and sets that slot to boot only after the check passes. Every refusal is a plain sentence returned to the host (started:false, reason) and a log line. Progress, done and failed go to the host as events. Behind STACKCHAN_WIRELESS_UPDATE (on in the core preset). The shared helpers (host of an address, paired-host test, slot rule) live in update_verify.h and the camera-address check in mcp_server.cc now uses them, so there is one copy.
# Placement: unit (the robot downloads, checks and writes its own image)
# Upstream: main/ota.cc and main/mcp_server.cc of the xiaozhi-esp32 tree (MIT); the tool and task are new code
# Check after a flash: tools list shows self.firmware.update; calling it with an address on another host answers started:false with "not the paired host"; a signed image on the paired host installs and the unit restarts into it.
diff --git a/firmware/xiaozhi-esp32/main/update_verify.h b/firmware/xiaozhi-esp32/main/update_verify.h
--- a/firmware/xiaozhi-esp32/main/update_verify.h
+++ b/firmware/xiaozhi-esp32/main/update_verify.h
@@ -14,6 +14,38 @@ bool Ed25519VerifyDigest(const uint8_t sig[64], const uint8_t pk[32], const uint
 // Public key built into the image (hex, 64 characters); false when none is built in or it is malformed.
 bool UpdateTrustedKey(uint8_t pk[32]);
 
+// Patch 159: wireless updates come from the paired host only and must leave 20 percent of the slot free.
+// Host part of "scheme://host[:port]/path" (empty when it has no scheme or host, or carries user info).
+inline std::string UpdateUrlHost(const std::string& url) {
+    auto start = url.find("://");
+    if (start == std::string::npos) return "";
+    start += 3;
+    auto end = url.find_first_of("/?#", start);
+    std::string authority = url.substr(start, end == std::string::npos ? std::string::npos : end - start);
+    if (authority.find('@') != std::string::npos) return "";  // user info is never accepted
+    if (!authority.empty() && authority[0] == '[') {
+        auto close = authority.find(']');
+        return close == std::string::npos ? "" : authority.substr(0, close + 1);
+    }
+    return authority.substr(0, authority.find(':'));
+}
+
+// True when url is plain http(s) and its host is the host of paired_url (the unit's saved link).
+inline bool UpdateUrlIsPairedHost(const std::string& url, const std::string& paired_url) {
+    if (url.rfind("http://", 0) != 0 && url.rfind("https://", 0) != 0) return false;
+    std::string paired_host = UpdateUrlHost(paired_url);
+    return !paired_host.empty() && UpdateUrlHost(url) == paired_host;
+}
+
+// The 20 percent rule (docs/design/firmware-memory.md): the image may use at most 80 percent of its slot.
+inline bool UpdateFitsSlot(size_t image_bytes, size_t slot_bytes) {
+    return image_bytes > 0 && slot_bytes > 0 && image_bytes <= slot_bytes - slot_bytes / 5;
+}
+
+// The plain reason of the last refused update ("" when none); the unit sends it back to the host.
+void UpdateSetRefusal(const char* why);
+const char* UpdateRefusal();
+
