+/*
+ * SPDX-License-Identifier: MIT
+ *
+ * The wake word's feedback cue and self-test, device side (patch T03). The judging is maipai_wake_core.h.
+ */
+#include "maipai_wake.h"
+#include "maipai_wake_core.h"
+#include "maipai_sounds.h"
+#include "maipai_privacy.h"
+#include "maipai_timers.h"
+#include "device_events.h"
+#include <application.h>
+#include <esp_log.h>
+#include <esp_timer.h>
+#include <cstdio>
+
+static const char* TAG = "MAIPAI-WAKE";
+
+void maipai_wake_cue()
+{
+    // "popup" is allowed at night (a person is there) but not when sounds are off or the unit is muted.
+    (void)maipai_sounds_play("popup");
+}
+
+namespace {
+
+esp_timer_handle_t s_timer = nullptr;
+unsigned s_fed0            = 0;
+unsigned s_fetched0        = 0;
+bool s_running             = false;
+
+void finish(void*)
+{
+    auto& app = Application::GetInstance();
+    unsigned fed = 0, fetched = 0;
+    maipai_wake_counters(&fed, &fetched);
+    const bool armed = app.GetAudioService().IsWakeWordRunning() && !maipai_mic_blocked();
+    const bool busy  = app.GetDeviceState() != kDeviceStateIdle || maipai_timers_ringing();
+    const mw_result_t r = mw_judge(armed ? 1 : 0, busy ? 1 : 0, fed - s_fed0, fetched - s_fetched0);
+    bool repaired = false;
+    if (mw_needs_repair(r)) {
+        repaired = true;
+        // The cheap cure: switch the wake word off and on again, on the main task that owns that state.
+        app.Schedule([]() {
+            auto& a = Application::GetInstance();
+            a.GetAudioService().EnableWakeWordDetection(false);
+            a.GetAudioService().EnableWakeWordDetection(true);
+        });
+    }
+    char extra[96];
+    snprintf(extra, sizeof(extra), "\"result\":\"%s\",\"why\":\"%s\",\"fed\":%u,\"fetched\":%u,\"repaired\":%d",
+             mw_word(r), mw_why(r), fed - s_fed0, fetched - s_fetched0, repaired ? 1 : 0);
+    device_events_push("wake_selftest", extra);
+    ESP_LOGI(TAG, "wake self-test: %s", extra);
+    s_running = false;
+}
+
+}  // namespace
+
+void maipai_wake_selftest_start()
+{
+    if (s_running) {
+        return;  // one test at a time
+    }
+    if (s_timer == nullptr) {
+        esp_timer_create_args_t args = {};
+        args.callback                = finish;
+        args.name                    = "wake_selftest";
+        if (esp_timer_create(&args, &s_timer) != ESP_OK) {
+            ESP_LOGW(TAG, "wake self-test could not start (no timer); try again after a restart");
+            return;
+        }
+    }
+    s_running = true;
+    maipai_wake_counters(&s_fed0, &s_fetched0);
+    esp_timer_start_once(s_timer, MW_WINDOW_MS * 1000LL);
+}
