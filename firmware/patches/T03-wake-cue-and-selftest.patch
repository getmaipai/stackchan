--- /dev/null
+++ b/firmware/main/hal/maipai_wake_core.h
@@ -0,0 +1,55 @@
+/*
+ * SPDX-License-Identifier: MIT
+ *
+ * The pure logic of the wake self-test (patch T03). The test counts the audio frames fed to the wake engine and
+ * the results the engine fetched over a short window, and says whether the path is alive. It proves the
+ * microphone feed and the engine loop run. It does not prove that the wake word model hears a word: nothing
+ * is injected, so nothing can cause a false wake. Plain C99, no hardware: compiled by a host test.
+ */
+#pragma once
+#include <stdint.h>
+
+#define MW_WINDOW_MS 1500
+#define MW_MIN_FED 10     /* frames fed in the window: the feed runs about 33 times a second */
+#define MW_MIN_FETCHED 5  /* engine results in the window: about 30 a second while the engine runs */
+
+typedef enum {
+    MW_ALIVE = 0,
+    MW_SKIPPED_NOT_ARMED, /* the wake word is not armed (muted, quiet, stopped): nothing to test */
+    MW_SKIPPED_BUSY,      /* the unit is speaking, listening or ringing: the engine serves that instead */
+    MW_NO_AUDIO,          /* the microphone feed did not move */
+    MW_NO_FETCH           /* audio went in and the engine returned nothing: the engine loop is stuck */
+} mw_result_t;
+
+static inline mw_result_t mw_judge(int armed, int busy, uint32_t fed_delta, uint32_t fetched_delta)
+{
+    if (!armed) return MW_SKIPPED_NOT_ARMED;
+    if (busy) return MW_SKIPPED_BUSY;
+    if (fed_delta < MW_MIN_FED) return MW_NO_AUDIO;
+    if (fetched_delta < MW_MIN_FETCHED) return MW_NO_FETCH;
+    return MW_ALIVE;
+}
+
+/* A failed result is worth one repair (the wake word switched off and on again); a skip or a pass is not. */
+static inline int mw_needs_repair(mw_result_t r) { return r == MW_NO_FETCH || r == MW_NO_AUDIO; }
+
+static inline const char* mw_word(mw_result_t r)
+{
+    switch (r) {
+    case MW_ALIVE: return "alive";
+    case MW_SKIPPED_NOT_ARMED: return "skipped";
+    case MW_SKIPPED_BUSY: return "skipped";
+    case MW_NO_AUDIO: return "no_audio";
+    case MW_NO_FETCH: return "no_fetch";
+    }
+    return "unknown";
+}
+
+static inline const char* mw_why(mw_result_t r)
+{
+    switch (r) {
+    case MW_SKIPPED_NOT_ARMED: return "not_armed";
+    case MW_SKIPPED_BUSY: return "busy";
+    default: return "";
+    }
+}
