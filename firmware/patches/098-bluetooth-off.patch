diff --git a/firmware/main/hal/maipai_bt_disabled.cpp b/firmware/main/hal/maipai_bt_disabled.cpp
new file mode 100644
index 0000000..d4f4704
--- /dev/null
+++ b/firmware/main/hal/maipai_bt_disabled.cpp
@@ -0,0 +1,32 @@
+#include "hal.h"
+
+#include <esp_log.h>
+
+#include "settings.h"
+
+void Hal::startBleServer()
+{
+    ESP_LOGW("Bluetooth", "Bluetooth is disabled. Configure the robot over Wi-Fi.");
+}
+
+bool Hal::isBleConnected()
+{
+    return false;
+}
+
+void Hal::startAppConfigServer()
+{
+    ESP_LOGW("Bluetooth", "Bluetooth setup is disabled. Configure Wi-Fi on the robot.");
+}
+
+bool Hal::isAppConfiged()
+{
+    Settings settings("app_config", false);
+    return settings.GetBool("is_configed", false);
+}
+
+void Hal::resetAppConfiged()
+{
+    Settings settings("app_config", true);
+    settings.SetBool("is_configed", false);
+}
