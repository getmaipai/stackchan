     if (best > 0) snprintf(best_text, sizeof(best_text), g->kind == kMines ? (g->es ? "Mejor %d s" : "Best %d s") : (g->es ? "Mejor %d" : "Best %d"), best);
     if (g->root != nullptr) {
-        g->over = mgo::build(g->root, mgo_result, score_text, best_text, record, g->es);
