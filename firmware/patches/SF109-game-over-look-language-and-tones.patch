diff --git a/firmware/main/hal/maipai_game_over_wire.h b/firmware/main/hal/maipai_game_over_wire.h
new file mode 100644
--- /dev/null
+++ b/firmware/main/hal/maipai_game_over_wire.h
@@ -0,0 +1,14 @@
+/*
+ * SPDX-License-Identifier: MIT
+ *
+ * The device side of the shared game-over screen's new look (patch SF109; the screen is maipai_game_over.h, UX15d). The language the games pass (the household's, six languages,
+ * the firmware's table order) and the tone table played when the screen shows. Both only act on the new look (mgo::g_look above 0): look 0 stays exactly today's screen and sounds.
+ */
+#pragma once
+#include <sdkconfig.h>
+#include "maipai_game_over.h"
+
+// The unit's screen language as the game-over screen numbers it (0 en, 1 es, 2 fr, 3 de, 4 pt, 5 it).
+int maipai_mgo_language();
+// Plays the result's tone table (maipai_game_over_core.h) through the sound policy; does nothing at look 0 (the games' own result sounds play then).
+void maipai_mgo_play(int result, bool new_best);
diff --git a/firmware/main/hal/maipai_game_over_wire.cc b/firmware/main/hal/maipai_game_over_wire.cc
new file mode 100644
--- /dev/null
+++ b/firmware/main/hal/maipai_game_over_wire.cc
@@ -0,0 +1,50 @@
+/*
+ * SPDX-License-Identifier: MIT
+ *
+ * The device side of the shared game-over screen's new look (patch SF109). See maipai_game_over_wire.h.
+ */
+#include "maipai_game_over_wire.h"
+#include "maipai_face.h"
+#include "maipai_sounds.h"
+#include "maipai_mumble_render_core.h"
+#include <application.h>
+#include <esp_heap_caps.h>
+
+int maipai_mgo_language()
+{
+#if CONFIG_MAIPAI_FACE_CONFIG
+    const int l = maipai_face_config().lang;
+    return l >= 0 && l < MGO_LANGS ? l : 0;
+#else
+    return 0;
+#endif
+}
+
+void maipai_mgo_play(int result, bool new_best)
+{
+    if (mgo::g_look == MGO_LOOK_OLD || !maipai_sounds_gate("popup")) return;
+    const mgo_tone_t* tones = nullptr;
+    const int n = mgo_tones(result, new_best ? 1 : 0, &tones);
+    if (n <= 0 || tones == nullptr) return;
+    size_t total = 0;
+    for (int i = 0; i < n; i++) total += static_cast<size_t>(tones[i].ms) * (MMR_RATE / 1000);
+    int16_t* pcm = static_cast<int16_t*>(heap_caps_malloc(total * sizeof(int16_t), MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT));
+    if (pcm == nullptr) return;
+    size_t at = 0;
+    for (int i = 0; i < n; i++) {   // each tone: a sine with a quarter triangle, 5 ms attack, 15 ms fall, at the chime level, as the mumble's notes (maipai_mumble_render_core.h)
+        mm_blip_t b = {0, tones[i].ms, tones[i].hz, tones[i].hz, 100, 0};
+        const size_t len = static_cast<size_t>(tones[i].ms) * (MMR_RATE / 1000);
+        // mmr_render caps a note at MMR_MAX_DUR_MS: longer tones are rendered in pieces
+        size_t done = 0;
+        while (done < len) {
+            const size_t piece = len - done > static_cast<size_t>(MMR_MAX_DUR_MS) * (MMR_RATE / 1000) ? static_cast<size_t>(MMR_MAX_DUR_MS) * (MMR_RATE / 1000) : len - done;
+            mm_blip_t p = b;
+            p.dur_ms = static_cast<uint16_t>(piece / (MMR_RATE / 1000));
+            mmr_render(&p, 0, pcm + at + done, piece);
+            done += piece;
+        }
+        at += len;
+    }
+    (void)Application::GetInstance().GetAudioService().PlayPcm(pcm, total, MMR_RATE);   // PlayPcm copies
+    heap_caps_free(pcm);
+}
