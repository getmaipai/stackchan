@@ -173,7 +173,11 @@ static inline void ft_init(ft_t* t, const ft_cfg_t* cfg)
     }
 }
 
-static inline int32_t ft_dt(uint32_t a, uint32_t b) { return (int32_t)(a - b); }
+static inline int32_t ft_dt(uint32_t a, uint32_t b)
+{
