# Intent: The seek and face-tracking time differences treat a stamp that is a day or more old, or still at 0 on a unit that has run that long, as long past instead of as a deadline still ahead (one saturating difference in each core; the three "until" checks now ask the same way round).
# Placement: unit
# Upstream: firmware/main/hal/maipai_seek_core.h, maipai_seek_wire_core.h, maipai_face_track_core.h, maipai_seek.cc (ours)
# Check after a flash: face following and the idle look-around keep working on a unit that has run for more than 25 days (host test covers the clock past 2^31 ms).
# Kconfig: none

diff --git a/firmware/main/hal/maipai_seek_core.h b/firmware/main/hal/maipai_seek_core.h
--- a/firmware/main/hal/maipai_seek_core.h
+++ b/firmware/main/hal/maipai_seek_core.h
@@ -102,7 +102,14 @@ typedef struct {
     uint32_t until_ms; /* expires when now reaches this */
 } ms_lease_t;
 
-static inline int32_t ms_dt(uint32_t a, uint32_t b) { return (int32_t)(a - b); }
+/* a - b in ms. A deadline is never more than a minute ahead, so a result far "ahead" (a stamp that is 24.9 days old, or one still at 0 on a
+ * unit that has run that long) means the stamp is long past: it reads as 2^30 ms elapsed, never as a deadline still to come (patch SF17).
+ * Ask "is the deadline still ahead" as ms_dt(now, until) < 0, never as ms_dt(until, now) > 0. */
+static inline int32_t ms_dt(uint32_t a, uint32_t b)
+{
+    const int32_t d = (int32_t)(a - b);
+    return d < -(1 << 30) ? (1 << 30) : d;
+}
 
 static inline int ms_owner_ok(const char* owner)
 {
@@ -604,10 +611,10 @@ static inline void ms_tick(ms_t* s, const ms_in_t* in, ms_out_t* out)
             s->searches_total++;
         }
     }
-    if (in->conversation && ms_dt(s->addr_until, now) < (int32_t)(MS_ADDR_WINDOW_MS / 2)) {
+    if (in->conversation && ms_dt(now, s->addr_until) > -(int32_t)(MS_ADDR_WINDOW_MS / 2)) {
         s->addr_until = now + MS_ADDR_WINDOW_MS / 2; /* a talk keeps seeking wanted */
     }
-    int wanted = ms_dt(s->addr_until, now) > 0;
+    int wanted = ms_dt(now, s->addr_until) < 0;
 
     /* A frame fed back, or a burst that never came: the result of a look (1 hit, 2 miss) or of a watch. */
     int result = 0;
@@ -793,7 +800,7 @@ static inline int ms_status_json(ms_t* s, uint8_t mode, uint32_t now, char* buf,
 {
     int who = ms_owner(s, mode, now);
     const char* owner = who == 2 ? "host" : (who == 1 ? "unit" : "none");
-    long ttl = who == 2 ? (long)ms_dt(s->lease.until_ms, now) : 0;
+    long ttl = who == 2 ? -(long)ms_dt(now, s->lease.until_ms) : 0;
     long face_ago = s->last_face_any ? (long)ms_dt(now, s->last_face_at) : -1;
     return snprintf(buf, n,
                     "{\"ok\":true,\"owner\":\"%s\",\"lease_owner\":\"%s\",\"lease_ttl_ms\":%ld,\"setting\":\"%s\",\"state\":\"%s\","
