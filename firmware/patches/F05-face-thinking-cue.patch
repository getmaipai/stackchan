diff --git a/firmware/main/hal/maipai_face_think_core.h b/firmware/main/hal/maipai_face_think_core.h
new file mode 100644
index 0000000..d34eb9a
--- /dev/null
+++ b/firmware/main/hal/maipai_face_think_core.h
@@ -0,0 +1,77 @@
+/*
+ * SPDX-License-Identifier: MIT
+ *
+ * The thinking cue (patch F05): the pure logic, no ESP-IDF, no clock of its own. The caller passes
+ * the time in. Header-only plain C99 so a host compiler can test it.
+ *
+ * Decision 23: three animated dots on every face, plus a quiet tone, on by default. Spoken fillers
+ * are optional and off, so a Spanish unit needs none. The dots are the cue; the tone is an extra
+ * that the sound policy and the hard mute may silence, so the dots always show.
+ */
+#ifndef MAIPAI_FACE_THINK_CORE_H
+#define MAIPAI_FACE_THINK_CORE_H
+
+#include <stdint.h>
+
+#define MF_THINK_DOTS 3
+#define MF_THINK_PERIOD_MS 1200u /* one full wave across the three dots */
+#define MF_THINK_MAX_MS 45000u   /* a cue the host never ended stops by itself */
+#define MF_THINK_TONE_GAP_MS 8000u /* never a second tone sooner than this */
+
+typedef struct {
+    uint8_t active;
+    uint32_t start_ms;
+    uint32_t last_tone_ms;
+    uint8_t tone_sounded; /* last_tone_ms is meaningful */
+} mf_think_t;
+
+static inline void mf_think_init(mf_think_t* t)
+{
+    t->active       = 0;
+    t->start_ms     = 0;
+    t->last_tone_ms = 0;
+    t->tone_sounded = 0;
+}
+
+/* The cue starts. Returns 1 when the quiet tone should be asked for now (tone on, and not too soon after the last). */
+static inline int mf_think_begin(mf_think_t* t, uint32_t now_ms, int tone_on)
+{
+    if (t->active) {
+        return 0;
+    }
+    t->active   = 1;
+    t->start_ms = now_ms;
+    if (!tone_on) {
+        return 0;
+    }
+    if (t->tone_sounded && (uint32_t)(now_ms - t->last_tone_ms) < MF_THINK_TONE_GAP_MS) {
+        return 0;
+    }
+    t->tone_sounded = 1;
+    t->last_tone_ms = now_ms;
+    return 1;
+}
+
+/* Returns 1 if a cue was on and now is not. */
+static inline int mf_think_end(mf_think_t* t)
+{
+    const int was = t->active;
+    t->active     = 0;
+    return was;
+}
+
+static inline int mf_think_expired(const mf_think_t* t, uint32_t now_ms)
+{
+    return t->active && (uint32_t)(now_ms - t->start_ms) >= MF_THINK_MAX_MS;
+}
+
+/* Brightness of dot `i` (0 to 2) at `elapsed_ms`, 60 to 255: a wave that runs left to right. */
+static inline int mf_think_dot_level(uint32_t elapsed_ms, int i)
+{
+    const uint32_t phase = (elapsed_ms + (uint32_t)(MF_THINK_DOTS - i) * (MF_THINK_PERIOD_MS / MF_THINK_DOTS)) % MF_THINK_PERIOD_MS;
+    const uint32_t half  = MF_THINK_PERIOD_MS / 2;
+    const uint32_t up    = phase < half ? phase : MF_THINK_PERIOD_MS - phase; /* 0 to half and back */
+    return 60 + (int)((up * 195u) / half);
+}
+
+#endif /* MAIPAI_FACE_THINK_CORE_H */
