diff --git a/firmware/main/hal/maipai_barge.h b/firmware/main/hal/maipai_barge.h
new file mode 100644
--- /dev/null
+++ b/firmware/main/hal/maipai_barge.h
@@ -0,0 +1,25 @@
+#pragma once
+// Patch SF29 (CONFIG_MAIPAI_TALK_OVER_AEC, off by default): talking over the robot. The decisions are maipai_barge_core.h.
+#include <sdkconfig.h>
+#include <stddef.h>
+#include <stdint.h>
+
+#if CONFIG_MAIPAI_TALK_OVER_AEC
+// A wake hit. speaking: the unit is speaking now. Returns 0 ignore, 1 wait for a second hit, 2 interrupt, 3 normal wake.
+int maipai_barge_wake_hit(bool speaking);
+// The host marked a sentence no_barge: hits are ignored while it plays and for 500 ms after it.
+void maipai_barge_no_barge(uint32_t duration_ms);
+// A tts start: the frames of a new reply are good again. After an interruption the frames of the old turn are dropped until this.
+void maipai_barge_tts_start();
+bool maipai_barge_frame_ok();
+#if CONFIG_MAIPAI_SERIAL_TOOLS
+// Bench: one trace line a second, "AEC mic=<rms> ref=<rms> out=<rms>" (microphone 1, the loopback, the cleaned output).
+void maipai_aec_trace_in(const int16_t* interleaved, size_t count, int channels);
+void maipai_aec_trace_out(const int16_t* mono, size_t count);
+#endif
+#else
+inline int maipai_barge_wake_hit(bool) { return 3; }
+inline void maipai_barge_no_barge(uint32_t) {}
+inline void maipai_barge_tts_start() {}
+inline bool maipai_barge_frame_ok() { return true; }
+#endif
diff --git a/firmware/main/hal/maipai_barge.cc b/firmware/main/hal/maipai_barge.cc
new file mode 100644
--- /dev/null
+++ b/firmware/main/hal/maipai_barge.cc
@@ -0,0 +1,89 @@
+/*
+ * SPDX-License-Identifier: MIT
+ *
+ * Patch SF29 (CONFIG_MAIPAI_TALK_OVER_AEC): the unit side of talking over the robot. Decisions: maipai_barge_core.h (host test).
+ */
+#include "maipai_barge.h"
+
+#if CONFIG_MAIPAI_TALK_OVER_AEC
+#include "maipai_barge_core.h"
+#include <esp_log.h>
+#include <esp_timer.h>
+#include <cmath>
+#include <cstdio>
+#include <mutex>
+
+namespace {
+const char* const kTag = "MaipaiBarge";
+std::mutex s_mu;
+mbg_t s_barge;
+
+uint32_t now_ms() { return static_cast<uint32_t>(esp_timer_get_time() / 1000); }
+}  // namespace
+
+int maipai_barge_wake_hit(bool speaking)
+{
+    std::lock_guard<std::mutex> lock(s_mu);
+    mbg_speaking(&s_barge, speaking ? 1 : 0);
+    const mbg_verdict_t v = mbg_wake_hit(&s_barge, now_ms());
+    if (v == MBG_ABORT) ESP_LOGW(kTag, "interrupted: the second wake hit while speaking");
+    return static_cast<int>(v);
+}
+
+void maipai_barge_no_barge(uint32_t duration_ms)
+{
+    std::lock_guard<std::mutex> lock(s_mu);
+    mbg_no_barge_sentence(&s_barge, now_ms(), duration_ms);
+}
+
+void maipai_barge_tts_start()
+{
+    std::lock_guard<std::mutex> lock(s_mu);
+    mbg_tts_start(&s_barge);
+}
+
+bool maipai_barge_frame_ok()
+{
+    std::lock_guard<std::mutex> lock(s_mu);
+    return mbg_frame_ok(&s_barge) != 0;
+}
+
+#if CONFIG_MAIPAI_SERIAL_TOOLS
+namespace {
+double s_sq_mic = 0, s_sq_ref = 0, s_sq_out = 0;
+uint32_t s_n_in = 0, s_n_out = 0;
+int64_t s_last_us = 0;
+std::mutex s_trace_mu;
+
+void maybe_log()
+{
+    const int64_t now = esp_timer_get_time();
+    if (s_last_us == 0) s_last_us = now;
+    if (now - s_last_us < 1000000 || s_n_in == 0) return;
+    std::printf("AEC mic=%.1f ref=%.1f out=%.1f\n", std::sqrt(s_sq_mic / s_n_in), std::sqrt(s_sq_ref / s_n_in), s_n_out ? std::sqrt(s_sq_out / s_n_out) : 0.0);
+    s_sq_mic = s_sq_ref = s_sq_out = 0;
+    s_n_in = s_n_out = 0;
+    s_last_us = now;
+}
+}  // namespace
+
+void maipai_aec_trace_in(const int16_t* interleaved, size_t count, int channels)
+{
+    if (channels < 2) return;
+    std::lock_guard<std::mutex> lock(s_trace_mu);
+    for (size_t f = 0; f + 1 < count; f += static_cast<size_t>(channels)) {
+        s_sq_mic += static_cast<double>(interleaved[f]) * interleaved[f];
+        s_sq_ref += static_cast<double>(interleaved[f + 1]) * interleaved[f + 1];
+        s_n_in++;
+    }
+    maybe_log();
+}
+
+void maipai_aec_trace_out(const int16_t* mono, size_t count)
+{
+    std::lock_guard<std::mutex> lock(s_trace_mu);
+    for (size_t i = 0; i < count; i++) s_sq_out += static_cast<double>(mono[i]) * mono[i];
+    s_n_out += static_cast<uint32_t>(count);
+}
+#endif
+#endif
