# Intent: The setting "Turn toward faces: off, when I talk to it, always" as one more row of the unit's preference table (owner brief 2026-11-16). Key turn_to_faces (13 characters, so the flash key is the whole name), enum off, talk, always, default talk, applied by the unit itself, placed right after top_bar so the unit's table keeps the host's order (host/maipai_body/unit_prefs.py PREFS) with pickup_reaction still last. self.prefs.get and self.prefs.set carry it like every other row; a damaged or unknown value is refused with the field named. The default is talk (the camera runs only after the wake word) until the seeker has been measured in the memory gate; the default moves to always only on that measurement. Nothing reads the row yet: the seeker that does (patch S10 core, wired in a later patch) is the only reader, so on its own this patch changes no behavior on a unit and costs one 40 byte table row.
# Placement: unit (the row lives in the unit's own flash; the host copy is what the settings page shows)
# Upstream: firmware/main/hal/maipai_prefs_core.h (ours, patch TA01 and the rows N01 and TB04 added)
# Check after a flash: self.prefs.get lists turn_to_faces with value talk; self.prefs.set {"json":"{\"turn_to_faces\":\"always\"}"} answers ok and the value survives a reboot; a value such as "sometimes" is refused with the field named.

diff --git a/firmware/main/hal/maipai_prefs_core.h b/firmware/main/hal/maipai_prefs_core.h
index 247ee37..08e5832 100644
--- a/firmware/main/hal/maipai_prefs_core.h
+++ b/firmware/main/hal/maipai_prefs_core.h
@@ -47,6 +47,7 @@ enum {
     MP_THINKING_DOTS,
     MP_CAPTIONS_MODE,   /* patch N01, N04: off, subtitles (the strip at the bottom, the default when on) or banner (the row at the top) */
     MP_TOP_BAR,         /* patch N01: hidden (default) or always show battery and Wi-Fi in the top row */
+    MP_TURN_TO_FACES,   /* patch S11: off, talk (after the wake word, the default) or always; read by the seeker (hal/maipai_seek_core.h) */
     MP_PICKUP_REACTION, /* not in the host's table yet: the pickup patch reads it (off, face, face_sound) */
     MP_COUNT
 };
@@ -71,6 +72,7 @@ static const char* const MP_NAMES_COLOUR[] = {"normal", "mono", "warm", "cool",
 static const char* const MP_NAMES_PICKUP[] = {"off", "face", "face_sound", NULL};
 static const char* const MP_NAMES_CAPTIONS[] = {"off", "subtitles", "banner", NULL};
 static const char* const MP_NAMES_TOPBAR[] = {"hidden", "always", NULL};
+static const char* const MP_NAMES_TURN[] = {"off", "talk", "always", NULL};
 
 static const mp_def_t MP_DEFS[MP_COUNT] = {
     {"emotion_faces", "emotion_faces", MP_BOOL, 0, 1, 1, 0, NULL},
@@ -89,6 +91,7 @@ static const mp_def_t MP_DEFS[MP_COUNT] = {
     {"thinking_dots", "thinking_dots", MP_BOOL, 0, 1, 1, 1, NULL},
     {"captions_mode", "captions_mode", MP_ENUM, 0, 2, 1, 1, MP_NAMES_CAPTIONS},
     {"top_bar", "top_bar", MP_ENUM, 0, 1, 0, 1, MP_NAMES_TOPBAR},
+    {"turn_to_faces", "turn_to_faces", MP_ENUM, 0, 2, 1, 1, MP_NAMES_TURN},
     {"pickup_reaction", "pickup_reaction", MP_ENUM, 0, 2, 1, 0, MP_NAMES_PICKUP},
 };
 
