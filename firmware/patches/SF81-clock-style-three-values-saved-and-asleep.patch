+    // Patch SF81 (docs/design/clock-styles.md): the style is kept in the face configuration (0 digits, 1 ring, 2 date and time). A tap changes it in memory at once; the flash is written once,
+    // 700 ms after the last tap, on the application task (never the display task or a task with its stack in PSRAM), and only when the style changed since the last write.
+    int clock_style() override { return maipai_face_config().clock_style; }
+    void clock_set_style(int v) override
+    {
+        const int cur = maipai_face_config().clock_style;
+        if (v < 0 || v > 2 || v == cur) return;
+        if (s_clock_saved < 0) s_clock_saved = cur;  // what flash holds now: the config loaded at boot
+        maipai_face_set_clock_style(v);
+        arm_clock_save();
+    }
+    // The unit has no sleep state of its own: a host that puts it to sleep dims the screen (and any person's touch brings it back: maipai_screen_wake). Asleep means the screen is
+    // dimmed below the level the person saved.
+    bool asleep() override
+    {
+        int saved = 0, live = 0;
+        maipai_screen_levels(&saved, &live);
+        return saved > 0 && live < saved;
+    }
     bool spanish() override { return maipai_face_config().lang == MF_LANG_ES; }
