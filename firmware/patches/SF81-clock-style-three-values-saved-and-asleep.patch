+esp_timer_handle_t s_clock_timer = nullptr;
+int s_clock_saved = -1;  // the clock style last written to flash (-1: not known yet)
+
+void arm_clock_save()
+{
+    if (s_clock_timer == nullptr) {
+        esp_timer_create_args_t args = {};
+        args.callback = [](void*) {
+            Application::GetInstance().Schedule([]() {
+                const int now = maipai_face_config().clock_style;
+                if (now != s_clock_saved) {
+                    s_clock_saved = now;
+                    maipai_face_save_config();
+                }
+            });
+        };
+        args.name = "clock_save";
+        if (esp_timer_create(&args, &s_clock_timer) != ESP_OK) {
+            s_clock_timer = nullptr;
+            maipai_face_save_config();
+            return;
+        }
+    }
+    esp_timer_stop(s_clock_timer);
+    esp_timer_start_once(s_clock_timer, 700ULL * 1000);
+}
