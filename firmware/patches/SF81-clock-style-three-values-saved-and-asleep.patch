+// Patch SF81: the clock style chosen by a tap on the clock page. Memory only (the page redraws itself); the caller arms the debounced save.
+void maipai_face_set_clock_style(int style)
+{
+    if (style < 0 || style > 2) return;
+    std::lock_guard<std::mutex> lock(s_mutex);
+    s_cfg.clock_style = static_cast<uint8_t>(style);
+}
+
+// Writes the settings as they are now, from the main task (never the screen task or a task with its stack in PSRAM). The page calls it 700 ms after the last tap.
+void maipai_face_save_config()
+{
+    const mf_config_t now = maipai_face_config();
+    Application::GetInstance().Schedule([now]() { save(now); });
+}
