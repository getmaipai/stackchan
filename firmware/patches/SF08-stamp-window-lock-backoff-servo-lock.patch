# Intent: Safety fix, train 8. The millisecond-stamp helper reads a passed deadline as not pending at any later time (deadlines are at most one hour ahead). Lock tool lockouts double each time and are kept in flash across a restart. The servo lock moves into the servo layer so every caller shares it. The picture-face probe hands its buffer over cleanly. The private-network setup tool refuses on a locked unit. Restart timer is created once.
# Placement: unit
# Upstream: firmware/main/hal, firmware/main/stackchan/motion (ours)
# Check after a flash: wrong lock codes sent to the tools lock them for 60 s, then 120 s; the lock keeps its strikes after a restart; dances and head moves show no stutter.
# Kconfig: none

diff --git a/firmware/main/hal/maipai_time_core.h b/firmware/main/hal/maipai_time_core.h
--- a/firmware/main/hal/maipai_time_core.h
+++ b/firmware/main/hal/maipai_time_core.h
@@ -1,14 +1,11 @@
 /*
  * SPDX-License-Identifier: MIT
  *
- * One way to compare 32-bit millisecond stamps (patch SF01). Plain C99, no clock of its own.
- *
- * Rules for 32-bit millisecond stamps: a stamp that starts at 0 and is compared with a signed difference is wrong once
- * the unit has run for 2^31 ms. Use these helpers instead:
- *   - A stamp of 0 means "not armed". mt_stamp() never returns 0, so a real deadline is never mistaken for it.
- *   - mt_pending() is true only for an armed stamp that has not been reached.
- *   - Elapsed time is always an unsigned difference (mt_elapsed), which stays right for 49.7 days of staleness.
- *   - A stamp that has been reached is cleared by mt_pending_clear() wherever the state can change.
+ * One way to compare 32-bit millisecond stamps (patch SF01, hardened by SF08). Plain C99, no clock of its own.
+ * A stamp of 0 means "not armed". A deadline is armed by mt_stamp() (never 0, never more than MT_MAX_AHEAD_MS ahead) and is
+ * pending only while it lies 1 to MT_MAX_AHEAD_MS ahead of now. A deadline that has passed is therefore not pending again
+ * 2^31 ms later; only the last MT_MAX_AHEAD_MS before the counter itself wraps (49.7 days after the stamp) could read it as
+ * pending, and mt_pending_clear() disarms a stamp at the first read after it passes. Elapsed time uses an unsigned difference.
  * Host test: host/tests/firmware/safety_core_test.c.
  */
 #ifndef MAIPAI_TIME_CORE_H
@@ -17,11 +14,12 @@
 #include <stdint.h>
 
 #define MT_HALF 0x80000000u
+#define MT_MAX_AHEAD_MS 3600000u /* the longest deadline any caller sets: one hour */
 
 /* A deadline `delay` ms after `now`; never 0. */
 static inline uint32_t mt_stamp(uint32_t now, uint32_t delay)
 {
-    const uint32_t t = now + delay;
+    const uint32_t t = now + (delay > MT_MAX_AHEAD_MS ? MT_MAX_AHEAD_MS : delay);
     return t == 0u ? 1u : t;
 }
 
@@ -32,13 +30,13 @@ static inline uint32_t mt_elapsed(uint32_t now, uint32_t then) { return (uint32_
 static inline int mt_reached(uint32_t now, uint32_t at) { return (uint32_t)(now - at) < MT_HALF; }
 
 /* True while an armed deadline has not been reached. */
-static inline int mt_pending(uint32_t now, uint32_t at) { return at != 0u && !mt_reached(now, at); }
+static inline int mt_pending(uint32_t now, uint32_t at) { return at != 0u && (uint32_t)(at - now - 1u) < MT_MAX_AHEAD_MS; }
 
 /* mt_pending that also disarms the stamp once it has been reached, so it does not read as pending after a wrap. */
 static inline int mt_pending_clear(uint32_t now, uint32_t* at)
 {
     if (*at == 0u) return 0;
-    if (mt_reached(now, *at)) {
+    if (!mt_pending(now, *at)) {
         *at = 0u;
         return 0;
     }
