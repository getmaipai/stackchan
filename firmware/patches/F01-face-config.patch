+void DefaultAvatar::setColors(lv_color_t primary, lv_color_t secondary)
+{
+    primaryColor   = primary;
+    secondaryColor = secondary;
+    if (_pannel) {
+        _pannel->setBgColor(secondary);
+    }
+    if (auto* eye = dynamic_cast<DefaultEyes*>(_key_elements.leftEye.get())) {
+        eye->setColors(primary, secondary);
+    }
+    if (auto* eye = dynamic_cast<DefaultEyes*>(_key_elements.rightEye.get())) {
+        eye->setColors(primary, secondary);
+    }
+    if (auto* mouth = dynamic_cast<DefaultMouth*>(_key_elements.mouth.get())) {
+        mouth->setColors(primary);
+    }
+    if (auto* bubble = dynamic_cast<DefaultSpeechBubble*>(_key_elements.speechBubble.get())) {
+        bubble->setColors(primary, secondary);
+    }
+}
+
+void DefaultAvatar::setEyeStyleOffset(int offset)
