+/*
+ * SPDX-License-Identifier: MIT
+ *
+ * The face as saved settings (patch F01): style, colour and the switches the later face patches read.
+ * Logic: maipai_face_core.h. With CONFIG_MAIPAI_FACE_CONFIG off nothing here is compiled.
+ */
+#pragma once
+#include <sdkconfig.h>
+
+#if CONFIG_MAIPAI_FACE_CONFIG
+#include <lvgl.h>
+#include "maipai_face_core.h"
+
+namespace stackchan::avatar {
+class DefaultAvatar;
+}
+
+// Loads the saved settings and draws them on the face. Call once from SetupUI, with the LVGL lock held.
+void maipai_face_attach(stackchan::avatar::DefaultAvatar* face);
+// Registers self.face.set_config and self.face.get_config.
+void maipai_face_register_tools();
+// A copy of the settings now in force.
+mf_config_t maipai_face_config();
+#else
+inline void maipai_face_register_tools() {}
+#endif
diff --git a/firmware/main/hal/maipai_face_core.h b/firmware/main/hal/maipai_face_core.h
new file mode 100644
index 0000000..26b746c
--- /dev/null
+++ b/firmware/main/hal/maipai_face_core.h
@@ -0,0 +1,318 @@
+/*
+ * SPDX-License-Identifier: MIT
+ *
+ * MaiPai face configuration (patch F01): the pure logic, no ESP-IDF, no heap, no clock. Header-only
+ * plain C99 so a host compiler can test it. The device side is maipai_face.cc.
+ *
+ * The face is neutral by default: white on black, the classic look, no captions, no time-of-day
+ * change. Style and colour are saved settings, never a reflash. Colour is decoration only: no state
+ * is told by colour alone (the screen rule), and a colour too dark to see on the black screen is
+ * refused so the face cannot be made to vanish.
+ */
+#ifndef MAIPAI_FACE_CORE_H
+#define MAIPAI_FACE_CORE_H
+
+#include <stdint.h>
+#include <string.h>
+
+#define MF_BLOB_VERSION 1
+
+#define MF_STYLE_CLASSIC 0
+#define MF_STYLE_BIG_EYES 1
+#define MF_STYLE_MINIMAL 2
+#define MF_STYLE_COUNT 3
+
+#define MF_COLOUR_NONE 0    /* neutral white: the default */
+#define MF_COLOUR_PALETTE 1 /* one of the named colours */
+#define MF_COLOUR_CUSTOM 2  /* the person's own #rrggbb */
+
+#define MF_PALETTE_COUNT 7
+#define MF_MIN_LUMA 60 /* of 255: darker than this cannot be seen on the black screen */
+
+#define MF_LANG_EN 0
+#define MF_LANG_ES 1
+
+#define MF_OK 0
+#define MF_ERR_STYLE -1
+#define MF_ERR_COLOUR -2
+#define MF_ERR_DARK -3
+#define MF_ERR_HOURS -4
+#define MF_ERR_LANG -5
+#define MF_ERR_RANGE -6
+
+typedef struct {
+    uint8_t style;        /* MF_STYLE_* */
+    uint8_t colour_mode;  /* MF_COLOUR_* */
+    uint8_t palette;      /* index into the named colours when colour_mode is MF_COLOUR_PALETTE */
+    uint8_t r, g, b;      /* the custom colour */
+    uint8_t captions;     /* 1: the words the unit would say show on the face (off by default) */
+    uint8_t tod;          /* 1: time-of-day face variants (patch F03) */
+    uint8_t tod_from[4];  /* the hour each band starts: morning, day, evening, night */
+    uint8_t thinking_tone;/* 1: a quiet tone with the thinking dots (default on, decision 23) */
+    uint8_t lang;         /* MF_LANG_*: weekday names on the clock face */
+    uint8_t clock24;      /* 1: 24 hour clock, 0: 12 hour */
+    uint8_t clock_style;  /* 0 big digits, 1 ring */
+    uint16_t clock_idle_s;/* 0: the clock face never shows by itself; otherwise after this many idle seconds */
+} mf_config_t;
+
+static inline void mf_default(mf_config_t* c)
+{
+    memset(c, 0, sizeof(*c));
+    c->style = MF_STYLE_CLASSIC;
+    c->colour_mode = MF_COLOUR_NONE;
+    c->captions = 0;
+    c->tod = 0;
+    c->tod_from[0] = 6;
+    c->tod_from[1] = 9;
+    c->tod_from[2] = 18;
+    c->tod_from[3] = 21;
+    c->thinking_tone = 1;
+    c->lang = MF_LANG_EN;
+    c->clock24 = 0;
+    c->clock_style = 0;
+    c->clock_idle_s = 0;
+}
+
+static const char* const MF_STYLE_NAMES[MF_STYLE_COUNT] = {"classic", "big_eyes", "minimal"};
+static const char* const MF_PALETTE_NAMES[MF_PALETTE_COUNT] = {"mint", "sky", "amber", "rose", "lilac", "lime", "coral"};
+static const uint8_t MF_PALETTE_RGB[MF_PALETTE_COUNT][3] = {
+    {0x7F, 0xE0, 0xB8}, {0x7F, 0xC4, 0xF0}, {0xF2, 0xB2, 0x4A}, {0xF0, 0x8F, 0xB0},
+    {0xB8, 0x9C, 0xF0}, {0xB4, 0xE0, 0x5A}, {0xF2, 0x84, 0x6C},
+};
+
+/* Eye size offset for a style, added to the size the face already uses (the classic look is 0). */
+static inline int mf_style_eye_offset(int style)
+{
+    switch (style) {
+        case MF_STYLE_BIG_EYES: return 60;
+        case MF_STYLE_MINIMAL: return -40;
+        default: return 0;
+    }
+}
+
+static inline int mf_luma(int r, int g, int b) { return (r * 30 + g * 59 + b * 11) / 100; }
+
+static inline int mf_set_style_name(mf_config_t* c, const char* name)
+{
+    if (name == NULL) {
+        return MF_ERR_STYLE;
+    }
+    for (int i = 0; i < MF_STYLE_COUNT; i++) {
+        if (strcmp(name, MF_STYLE_NAMES[i]) == 0) {
+            c->style = (uint8_t)i;
+            return MF_OK;
+        }
+    }
+    return MF_ERR_STYLE;
+}
+
+static inline int mf_hex_digit(char ch)
+{
+    if (ch >= '0' && ch <= '9') return ch - '0';
+    if (ch >= 'a' && ch <= 'f') return ch - 'a' + 10;
+    if (ch >= 'A' && ch <= 'F') return ch - 'A' + 10;
+    return -1;
+}
+
+/* "none" (or an empty text), a palette name, or "#rrggbb". */
+static inline int mf_set_colour(mf_config_t* c, const char* text)
+{
+    if (text == NULL || text[0] == '\0' || strcmp(text, "none") == 0) {
+        c->colour_mode = MF_COLOUR_NONE;
+        return MF_OK;
+    }
+    for (int i = 0; i < MF_PALETTE_COUNT; i++) {
+        if (strcmp(text, MF_PALETTE_NAMES[i]) == 0) {
+            c->colour_mode = MF_COLOUR_PALETTE;
+            c->palette = (uint8_t)i;
+            return MF_OK;
+        }
+    }
+    if (text[0] != '#' || strlen(text) != 7) {
+        return MF_ERR_COLOUR;
+    }
+    int v[6];
+    for (int i = 0; i < 6; i++) {
+        v[i] = mf_hex_digit(text[1 + i]);
+        if (v[i] < 0) {
+            return MF_ERR_COLOUR;
+        }
+    }
+    const int r = v[0] * 16 + v[1];
+    const int g = v[2] * 16 + v[3];
+    const int b = v[4] * 16 + v[5];
+    if (mf_luma(r, g, b) < MF_MIN_LUMA) {
+        return MF_ERR_DARK;
+    }
+    c->colour_mode = MF_COLOUR_CUSTOM;
+    c->r = (uint8_t)r;
+    c->g = (uint8_t)g;
+    c->b = (uint8_t)b;
+    return MF_OK;
+}
+
+/* The colour the face draws in. */
+static inline void mf_foreground(const mf_config_t* c, uint8_t* r, uint8_t* g, uint8_t* b)
+{
+    if (c->colour_mode == MF_COLOUR_PALETTE && c->palette < MF_PALETTE_COUNT) {
+        *r = MF_PALETTE_RGB[c->palette][0];
+        *g = MF_PALETTE_RGB[c->palette][1];
+        *b = MF_PALETTE_RGB[c->palette][2];
+    } else if (c->colour_mode == MF_COLOUR_CUSTOM) {
+        *r = c->r;
+        *g = c->g;
+        *b = c->b;
+    } else {
+        *r = *g = *b = 255;
+    }
+}
+
+/* Band starts must rise: morning < day < evening < night, each an hour 0 to 23. Night runs through midnight. */
+static inline int mf_set_hours(mf_config_t* c, int morning, int day, int evening, int night)
+{
+    if (morning < 0 || night > 23 || !(morning < day && day < evening && evening < night)) {
+        return MF_ERR_HOURS;
+    }
+    c->tod_from[0] = (uint8_t)morning;
+    c->tod_from[1] = (uint8_t)day;
+    c->tod_from[2] = (uint8_t)evening;
+    c->tod_from[3] = (uint8_t)night;
+    return MF_OK;
+}
+
+static inline int mf_set_lang(mf_config_t* c, const char* code)
+{
+    if (code != NULL && strcmp(code, "en") == 0) {
+        c->lang = MF_LANG_EN;
+        return MF_OK;
+    }
+    if (code != NULL && strcmp(code, "es") == 0) {
+        c->lang = MF_LANG_ES;
+        return MF_OK;
+    }
+    return MF_ERR_LANG;
+}
+
+/* A clean config: every field in range. Used after a load so a damaged blob falls back to defaults. */
+static inline int mf_valid(const mf_config_t* c)
+{
+    if (c->style >= MF_STYLE_COUNT || c->colour_mode > MF_COLOUR_CUSTOM || c->palette >= MF_PALETTE_COUNT) {
+        return 0;
+    }
+    if (c->colour_mode == MF_COLOUR_CUSTOM && mf_luma(c->r, c->g, c->b) < MF_MIN_LUMA) {
+        return 0;
+    }
+    if (c->captions > 1 || c->tod > 1 || c->thinking_tone > 1 || c->clock24 > 1 || c->clock_style > 1) {
+        return 0;
+    }
+    if (c->lang > MF_LANG_ES) {
+        return 0;
+    }
+    if (!(c->tod_from[0] < c->tod_from[1] && c->tod_from[1] < c->tod_from[2] && c->tod_from[2] < c->tod_from[3] &&
+          c->tod_from[3] <= 23)) {
+        return 0;
+    }
+    return 1;
+}
+
+/* The plain words for an error code: what went wrong and what to do. */
+static inline const char* mf_err_word(int code)
+{
+    switch (code) {
+        case MF_OK: return "ok";
+        case MF_ERR_STYLE: return "unknown face style: use classic, big_eyes or minimal";
+        case MF_ERR_COLOUR: return "unknown colour: use none, a name (mint, sky, amber, rose, lilac, lime, coral) or #rrggbb";
+        case MF_ERR_DARK: return "colour too dark to see on the black screen: pick a lighter colour";
+        case MF_ERR_HOURS: return "day bands must be hours 0 to 23 that rise: morning, day, evening, night";
+        case MF_ERR_LANG: return "unknown language: use en or es";
+        case MF_ERR_RANGE: return "a value is out of range: check the number and send it again";
+        default: return "unknown error";
+    }
+}
+
+/* ---- save and load: one small blob with a version and a check, so a damaged one is never trusted ---- */
+
+#define MF_BLOB_MAX 32
+
+static inline uint16_t mf_crc16(const uint8_t* p, size_t n)
+{
+    uint16_t crc = 0xFFFF;
+    for (size_t i = 0; i < n; i++) {
+        crc ^= (uint16_t)p[i] << 8;
+        for (int k = 0; k < 8; k++) {
+            crc = (crc & 0x8000) ? (uint16_t)((crc << 1) ^ 0x1021) : (uint16_t)(crc << 1);
+        }
+    }
+    return crc;
+}
+
+static inline size_t mf_save(const mf_config_t* c, uint8_t* buf, size_t size)
+{
+    if (size < MF_BLOB_MAX) {
+        return 0;
+    }
+    memset(buf, 0, MF_BLOB_MAX);
+    size_t n = 0;
+    buf[n++] = MF_BLOB_VERSION;
+    buf[n++] = c->style;
+    buf[n++] = c->colour_mode;
+    buf[n++] = c->palette;
+    buf[n++] = c->r;
+    buf[n++] = c->g;
+    buf[n++] = c->b;
+    buf[n++] = c->captions;
+    buf[n++] = c->tod;
+    for (int i = 0; i < 4; i++) {
+        buf[n++] = c->tod_from[i];
+    }
+    buf[n++] = c->thinking_tone;
+    buf[n++] = c->lang;
+    buf[n++] = c->clock24;
+    buf[n++] = c->clock_style;
+    buf[n++] = (uint8_t)(c->clock_idle_s >> 8);
+    buf[n++] = (uint8_t)(c->clock_idle_s & 0xFF);
+    const uint16_t crc = mf_crc16(buf, n);
+    buf[n++] = (uint8_t)(crc >> 8);
+    buf[n++] = (uint8_t)(crc & 0xFF);
+    return n;
+}
+
+/* Returns MF_OK, or MF_ERR_RANGE for a blob that is the wrong size, version or check, or holds a bad value
+ * (the config is then left as the defaults). */
+static inline int mf_load(mf_config_t* c, const uint8_t* buf, size_t len)
+{
+    mf_default(c);
+    const size_t body = 9 + 4 + 4 + 2;
+    if (buf == NULL || len != body + 2 || buf[0] != MF_BLOB_VERSION) {
+        return MF_ERR_RANGE;
+    }
+    if (mf_crc16(buf, body) != (uint16_t)((buf[body] << 8) | buf[body + 1])) {
+        return MF_ERR_RANGE;
+    }
+    mf_config_t t;
+    mf_default(&t);
+    size_t n = 1;
+    t.style = buf[n++];
+    t.colour_mode = buf[n++];
+    t.palette = buf[n++];
+    t.r = buf[n++];
+    t.g = buf[n++];
+    t.b = buf[n++];
+    t.captions = buf[n++];
+    t.tod = buf[n++];
+    for (int i = 0; i < 4; i++) {
+        t.tod_from[i] = buf[n++];
+    }
+    t.thinking_tone = buf[n++];
+    t.lang = buf[n++];
+    t.clock24 = buf[n++];
+    t.clock_style = buf[n++];
+    t.clock_idle_s = (uint16_t)((buf[n] << 8) | buf[n + 1]);
+    if (!mf_valid(&t)) {
+        return MF_ERR_RANGE;
+    }
+    *c = t;
+    return MF_OK;
+}
+
+#endif /* MAIPAI_FACE_CORE_H */
