diff --git a/firmware/main/hal/maipai_face.cc b/firmware/main/hal/maipai_face.cc
new file mode 100644
index 0000000..d4f1e7a
--- /dev/null
+++ b/firmware/main/hal/maipai_face.cc
@@ -0,0 +1,254 @@
+/*
+ * SPDX-License-Identifier: MIT
+ *
+ * The face as saved settings, the device side (patch F01). See maipai_face.h.
+ */
+#include <sdkconfig.h>
+#if CONFIG_MAIPAI_FACE_CONFIG
+#include "maipai_face.h"
+#include "hal.h"
+#include <mcp_server.h>
+#include <cJSON.h>
+#include <esp_log.h>
+#include <nvs.h>
+#include <nvs_flash.h>
+#include <stackchan/stackchan.h>
+#include <stackchan/avatar/skins/default/default.h>
+#include <mutex>
+#include <string>
+
+using stackchan::avatar::DefaultAvatar;
+
+static const char* TAG        = "MAIPAI-FACE";
+static const char* kNamespace = "mp_face";  // our own: never the websocket namespace (pairing token, Wi-Fi)
+static const char* kKey       = "v1";
+
+namespace {
+std::mutex s_mutex;  // a leaf lock: nothing else is taken while it is held
+mf_config_t s_cfg;
+bool s_loaded = false;
+
+void load_locked()
+{
+    mf_default(&s_cfg);
+    s_loaded = true;
+    nvs_handle_t h;
+    if (nvs_open(kNamespace, NVS_READONLY, &h) != ESP_OK) {
+        return;
+    }
+    uint8_t buf[MF_BLOB_MAX];
+    size_t n = sizeof(buf);
+    if (nvs_get_blob(h, kKey, buf, &n) == ESP_OK && mf_load(&s_cfg, buf, n) != MF_OK) {
+        ESP_LOGW(TAG, "saved face settings unreadable (%u bytes): using the plain face", static_cast<unsigned>(n));
+    }
+    nvs_close(h);
+}
+
+void save(const mf_config_t& c)
+{
+    uint8_t buf[MF_BLOB_MAX];
+    const size_t n = mf_save(&c, buf, sizeof(buf));
+    nvs_handle_t h;
+    if (n == 0 || nvs_open(kNamespace, NVS_READWRITE, &h) != ESP_OK) {
+        ESP_LOGW(TAG, "face settings not saved: flash is not writable");
+        return;
+    }
+    nvs_set_blob(h, kKey, buf, n);
+    nvs_commit(h);
+    nvs_close(h);
+}
+
+// Draws style and colour. The caller holds the LVGL lock.
+void apply(DefaultAvatar* face, const mf_config_t& c)
+{
+    if (face == nullptr) {
+        return;
+    }
+    uint8_t r, g, b;
+    mf_foreground(&c, &r, &g, &b);
+    face->setColors(lv_color_make(r, g, b), lv_color_black());
+    face->setEyeStyleOffset(mf_style_eye_offset(c.style));
+}
+
+DefaultAvatar* current_face()
+{
+    auto& chan = GetStackChan();
+    return chan.hasAvatar() ? dynamic_cast<DefaultAvatar*>(&chan.avatar()) : nullptr;
+}
+
+std::string reply_error(const char* word)
+{
+    return std::string("{\"ok\":false,\"error\":\"") + word + "\"}";
+}
+
+// Reads one boolean field; false when the field is present but not a boolean.
+bool read_bool(const cJSON* obj, const char* key, uint8_t* out, bool* present)
+{
+    const cJSON* it = cJSON_GetObjectItemCaseSensitive(obj, key);
+    *present        = it != nullptr;
+    if (it == nullptr) {
+        return true;
+    }
+    if (!cJSON_IsBool(it)) {
+        return false;
+    }
+    *out = cJSON_IsTrue(it) ? 1 : 0;
+    return true;
+}
+
+// Applies a partial JSON update to `c`; returns MF_OK or the first error and sets `bad` to the field name.
+int update_from_json(mf_config_t* c, const cJSON* root, const char** bad)
+{
+    bool present = false;
+    const cJSON* it;
+    if ((it = cJSON_GetObjectItemCaseSensitive(root, "style")) != nullptr) {
+        *bad = "style";
+        if (!cJSON_IsString(it)) return MF_ERR_STYLE;
+        if (int e = mf_set_style_name(c, it->valuestring)) return e;
+    }
+    if ((it = cJSON_GetObjectItemCaseSensitive(root, "colour")) != nullptr) {
+        *bad = "colour";
+        if (!cJSON_IsString(it)) return MF_ERR_COLOUR;
+        if (int e = mf_set_colour(c, it->valuestring)) return e;
+    }
+    if ((it = cJSON_GetObjectItemCaseSensitive(root, "lang")) != nullptr) {
+        *bad = "lang";
+        if (!cJSON_IsString(it)) return MF_ERR_LANG;
+        if (int e = mf_set_lang(c, it->valuestring)) return e;
+    }
+    if ((it = cJSON_GetObjectItemCaseSensitive(root, "tod_hours")) != nullptr) {
+        *bad = "tod_hours";
+        if (!cJSON_IsArray(it) || cJSON_GetArraySize(it) != 4) return MF_ERR_HOURS;
+        int h[4];
+        for (int i = 0; i < 4; i++) {
+            const cJSON* v = cJSON_GetArrayItem(it, i);
+            if (!cJSON_IsNumber(v)) return MF_ERR_HOURS;
+            h[i] = v->valueint;
+        }
+        if (int e = mf_set_hours(c, h[0], h[1], h[2], h[3])) return e;
+    }
+    if ((it = cJSON_GetObjectItemCaseSensitive(root, "clock_style")) != nullptr) {
+        *bad = "clock_style";
+        if (!cJSON_IsString(it)) return MF_ERR_RANGE;
+        if (strcmp(it->valuestring, "digits") == 0) c->clock_style = 0;
+        else if (strcmp(it->valuestring, "ring") == 0) c->clock_style = 1;
+        else return MF_ERR_RANGE;
+    }
+    if ((it = cJSON_GetObjectItemCaseSensitive(root, "clock_idle_s")) != nullptr) {
+        *bad = "clock_idle_s";
+        if (!cJSON_IsNumber(it) || it->valueint < 0 || it->valueint > 3600) return MF_ERR_RANGE;
+        c->clock_idle_s = static_cast<uint16_t>(it->valueint);
+    }
+    struct {
+        const char* key;
+        uint8_t* field;
+    } flags[] = {{"captions", &c->captions}, {"tod", &c->tod}, {"thinking_tone", &c->thinking_tone},
+                 {"clock24", &c->clock24}};
+    for (auto& f : flags) {
+        *bad = f.key;
+        if (!read_bool(root, f.key, f.field, &present)) return MF_ERR_RANGE;
+    }
+    *bad = "";
+    return MF_OK;
+}
+
+std::string config_json(const mf_config_t& c)
+{
+    uint8_t r, g, b;
+    mf_foreground(&c, &r, &g, &b);
+    char colour[24];
+    if (c.colour_mode == MF_COLOUR_PALETTE) {
+        snprintf(colour, sizeof(colour), "%s", MF_PALETTE_NAMES[c.palette]);
+    } else if (c.colour_mode == MF_COLOUR_CUSTOM) {
+        snprintf(colour, sizeof(colour), "#%02x%02x%02x", r, g, b);
+    } else {
+        snprintf(colour, sizeof(colour), "none");
+    }
+    char out[360];
+    snprintf(out, sizeof(out),
+             "{\"ok\":true,\"style\":\"%s\",\"colour\":\"%s\",\"captions\":%s,\"tod\":%s,\"tod_hours\":[%d,%d,%d,%d],"
+             "\"thinking_tone\":%s,\"lang\":\"%s\",\"clock24\":%s,\"clock_style\":\"%s\",\"clock_idle_s\":%u,"
+             "\"features\":[\"config\""
+#if CONFIG_MAIPAI_FACE_CAPTIONS
+             ",\"captions\""
+#endif
+#if CONFIG_MAIPAI_FACE_TOD
+             ",\"tod\""
+#endif
+#if CONFIG_MAIPAI_FACE_CLOCK
+             ",\"clock\""
+#endif
+#if CONFIG_MAIPAI_FACE_THINKING
+             ",\"thinking\""
+#endif
+#if CONFIG_MAIPAI_FACE_TIMERS
+             ",\"timers\""
+#endif
+             "]}",
+             MF_STYLE_NAMES[c.style], colour, c.captions ? "true" : "false", c.tod ? "true" : "false", c.tod_from[0],
+             c.tod_from[1], c.tod_from[2], c.tod_from[3], c.thinking_tone ? "true" : "false",
+             c.lang == MF_LANG_ES ? "es" : "en", c.clock24 ? "true" : "false", c.clock_style ? "ring" : "digits",
+             static_cast<unsigned>(c.clock_idle_s));
+    return out;
+}
+}  // namespace
+
+mf_config_t maipai_face_config()
+{
+    std::lock_guard<std::mutex> lock(s_mutex);
+    if (!s_loaded) {
+        load_locked();
+    }
+    return s_cfg;
+}
+
+void maipai_face_attach(DefaultAvatar* face)
+{
+    const mf_config_t c = maipai_face_config();
+    apply(face, c);
+    ESP_LOGI(TAG, "face: style %s, colour mode %d", MF_STYLE_NAMES[c.style], c.colour_mode);
+}
+
+void maipai_face_register_tools()
+{
+    auto& mcp = McpServer::GetInstance();
+    mcp.AddTool("self.face.set_config",
+                "Change the face settings the unit keeps in its own flash. config is a JSON object with any of: "
+                "style (classic, big_eyes, minimal), colour (none, mint, sky, amber, rose, lilac, lime, coral or "
+                "#rrggbb), captions (true shows the words on the face), tod (time-of-day looks), tod_hours "
+                "([morning, day, evening, night] start hours), thinking_tone, lang (en or es), clock24, "
+                "clock_style (digits or ring), clock_idle_s (0 to 3600, 0 never shows the clock by itself). "
+                "Nothing changes unless every field is valid. Answers the new settings or {ok:false,error}.",
+                PropertyList({Property("config", kPropertyTypeString, std::string("{}"))}),
+                [](const PropertyList& properties) -> ReturnValue {
+                    const std::string text = properties["config"].value<std::string>();
+                    cJSON* root            = cJSON_Parse(text.c_str());
+                    if (root == nullptr || !cJSON_IsObject(root)) {
+                        cJSON_Delete(root);
+                        return reply_error("config is not a JSON object: send something like {\\\"style\\\":\\\"minimal\\\"}");
+                    }
+                    mf_config_t next = maipai_face_config();
+                    const char* bad  = "";
+                    const int err    = update_from_json(&next, root, &bad);
+                    cJSON_Delete(root);
+                    if (err != MF_OK) {
+                        std::string word = std::string(bad) + ": " + mf_err_word(err);
+                        return reply_error(word.c_str());
+                    }
+                    {
+                        std::lock_guard<std::mutex> lock(s_mutex);
+                        s_cfg = next;
+                    }
+                    save(next);
+                    {
+                        LvglLockGuard lock;
+                        apply(current_face(), next);
+                    }
+                    return config_json(next);
+                });
+    mcp.AddTool("self.face.get_config", "Read the face settings in force and the face features this build has.",
+                std::vector<Property>{}, [](const PropertyList&) -> ReturnValue {
+                    return config_json(maipai_face_config());
+                });
+}
+#endif
