 #include <arpa/inet.h>
 #include <cJSON.h>
 #include <cstring>
@@ -99,6 +100,11 @@ void Application::Initialize() {
     // tells the host to end the turn, and nothing is said.
     audio_service_.SetStopWordCallback([this]() {
         Schedule([this]() {
+            // A ringing timer or alarm takes the word first (patch 093): it ends the ring, nothing else.
+            if (maipai_timers_request_dismiss("stop")) {
+                ESP_LOGI(TAG, "Stop word heard while a timer rings: ending the ring");
+                return;
+            }
             ESP_LOGI(TAG, "Stop word heard while speaking: aborting");
             AbortSpeaking(kAbortReasonNone);
         });
@@ -1098,7 +1104,7 @@ void Application::HandleStateChangedEvent() {
     auto led = board.GetLed();
     led->OnStateChanged();
 
-    if (new_state != kDeviceStateSpeaking) {
+    if (new_state != kDeviceStateSpeaking && !maipai_timers_ringing()) {
         audio_service_.SetStopWordArmed(false);
     }
     switch (new_state) {
diff --git a/firmware/main/hal/board/hal_bridge.cc b/firmware/main/hal/board/hal_bridge.cc
