+void stop_word_arm(bool arm)
+{
+    auto& app = Application::GetInstance();
+    if (!arm && app.GetDeviceState() == kDeviceStateSpeaking) {
+        return;
+    }
+    app.GetAudioService().SetStopWordArmed(arm);
+}
