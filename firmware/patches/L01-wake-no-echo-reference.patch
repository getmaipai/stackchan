+    afe_config->aec_init = false;  // patch L01: no real echo reference on this board
     afe_config->aec_mode = AEC_MODE_FD_LOW_COST;
     afe_config->aec_nlp_level = AEC_NLP_LEVEL_VERYAGGR;
     afe_config->ns_init = false;
@@ -217,9 +220,7 @@ bool AfeAudioEngine::Initialize(AudioCodec* codec, int frame_duration_ms,
     if (wake_detector_ == WakeDetector::kWakeNet) {
         afe_iface_->disable_wakenet(afe_data_);
     }
-    if (codec_->input_reference()) {
-        afe_iface_->disable_aec(afe_data_);
-    }
+    // patch L01: no AEC stage exists (aec_init is false), so nothing to disable
     afe_iface_->print_pipeline(afe_data_);
 
     if (processing_task_stack_ == nullptr) {
@@ -410,7 +411,7 @@ void AfeAudioEngine::ApplyAfeControls() {
             afe_iface_->disable_wakenet(afe_data_);
         }
     }
-    if (codec_->input_reference()) {
