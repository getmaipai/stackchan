diff --git a/firmware/main/hal/maipai_facefx_core.h b/firmware/main/hal/maipai_facefx_core.h
new file mode 100644
--- /dev/null
+++ b/firmware/main/hal/maipai_facefx_core.h
@@ -0,0 +1,135 @@
+/*
+ * SPDX-License-Identifier: MIT
+ *
+ * Fluid face motion (patch H02): the pure logic. No ESP-IDF, no clock of its own (the caller passes the time in).
+ * Header-only plain C99 so a host compiler can test it. Four small pieces:
+ *
+ *  - mx_follow:   an eased step toward a target. a = dt / (tau + dt) is stable for any frame time, so a slow frame
+ *                 never overshoots, and it needs no maths library.
+ *  - lid and mouth time constants: a lid closes faster than it opens, a mouth opens faster than it closes, so a blink
+ *                 and a syllable both look like something that has weight.
+ *  - mx_level_*:  the speech level (0 to 100) from the loudness of the sound the unit plays, and the mouth opening
+ *                 (0 to 100) that follows it.
+ *  - mx_drift_*:  gaze drift. Every 0.7 to 2.2 seconds the eyes pick a new place within a few pixels of the middle and
+ *                 glide to it. It lives in pixels and is added to wherever the face is looking.
+ */
+#ifndef MAIPAI_FACEFX_CORE_H
+#define MAIPAI_FACEFX_CORE_H
+
+#include <math.h>
+#include <stdint.h>
+
+#define MX_TAU_POS_MS 70.0f     /* where the eyes look */
+#define MX_TAU_ROT_MS 110.0f    /* the tilt that goes with an emotion */
+#define MX_TAU_LID_CLOSE_MS 28.0f
+#define MX_TAU_LID_OPEN_MS 85.0f
+#define MX_TAU_MOUTH_OPEN_MS 38.0f
+#define MX_TAU_MOUTH_CLOSE_MS 105.0f
+#define MX_TAU_DRIFT_MS 260.0f
+#define MX_DRIFT_AMP_PX 3
+#define MX_DRIFT_MIN_MS 700u
+#define MX_DRIFT_MAX_MS 2200u
+#define MX_LEVEL_FRESH_MS 250u  /* a level older than this means nothing is playing */
+#define MX_LEVEL_FLOOR_DB (-48.0f)
+#define MX_LEVEL_TOP_DB (-14.0f)
+
+/* One eased step. dt and tau in milliseconds; a tau of 0 or less, or a very long frame, lands on the target. */
+static inline float mx_follow(float cur, float target, float dt_ms, float tau_ms)
+{
+    if (tau_ms <= 0.0f || dt_ms >= 12.0f * tau_ms) {
+        return target;
+    }
+    if (dt_ms <= 0.0f) {
+        return cur;
+    }
+    return cur + (target - cur) * (dt_ms / (tau_ms + dt_ms));
+}
+
+static inline float mx_lid_tau(float cur, float target)
+{
+    return target < cur ? MX_TAU_LID_CLOSE_MS : MX_TAU_LID_OPEN_MS;
+}
+
+static inline float mx_mouth_tau(float cur, float target)
+{
+    return target > cur ? MX_TAU_MOUTH_OPEN_MS : MX_TAU_MOUTH_CLOSE_MS;
+}
+
+/* Loudness of a block of samples as a level 0 to 100: -48 dBFS and below is 0, -14 dBFS and above is 100. */
+static inline int mx_level_from_rms(float rms_16bit)
+{
+    if (rms_16bit < 1.0f) {
+        return 0;
+    }
+    const float db = 20.0f * log10f(rms_16bit / 32768.0f);
+    if (db <= MX_LEVEL_FLOOR_DB) {
+        return 0;
+    }
+    if (db >= MX_LEVEL_TOP_DB) {
+        return 100;
+    }
+    return (int)(((db - MX_LEVEL_FLOOR_DB) / (MX_LEVEL_TOP_DB - MX_LEVEL_FLOOR_DB)) * 100.0f + 0.5f);
+}
+
+/* The mouth opening (0 to 100, the face's mouth weight) for a speech level: a noise gate under 8, then a curve that
+ * opens quickly for ordinary speech and saves the last quarter for loud syllables. */
+static inline float mx_mouth_for_level(int level)
+{
+    if (level < 8) {
+        return 0.0f;
+    }
+    if (level > 100) {
+        level = 100;
+    }
+    const float x = (float)(level - 8) / 92.0f;
+    const float y = 1.0f - (1.0f - x) * (1.0f - x); /* ease out */
+    return 8.0f + y * 82.0f;                        /* a talking mouth is never fully shut or fully open */
+}
+
+typedef struct {
+    float x, y;       /* the drift now, pixels */
+    float tx, ty;     /* where it is heading */
+    uint32_t next_ms; /* when to pick a new place */
+    uint32_t rng;
+} mx_drift_t;
+
+static inline uint32_t mx_rand(uint32_t* s)
+{
+    uint32_t v = *s ? *s : 2463534242u;
+    v ^= v << 13;
+    v ^= v >> 17;
+    v ^= v << 5;
+    *s = v;
+    return v;
+}
+
+static inline void mx_drift_init(mx_drift_t* d, uint32_t seed)
+{
+    d->x = d->y = d->tx = d->ty = 0.0f;
+    d->next_ms = 0;
+    d->rng     = seed ? seed : 1u;
+}
+
+/* Advance by dt_ms at time now_ms. amp_px 0 holds the eyes still (and they glide back to the middle). */
+static inline void mx_drift_step(mx_drift_t* d, uint32_t now_ms, float dt_ms, int amp_px)
+{
+    if (amp_px <= 0) {
+        d->tx = d->ty = 0.0f;
+    } else if (now_ms >= d->next_ms) {
+        const int span = 2 * amp_px + 1;
+        d->tx          = (float)((int)(mx_rand(&d->rng) % (uint32_t)span) - amp_px);
+        d->ty          = (float)((int)(mx_rand(&d->rng) % (uint32_t)span) - amp_px) * 0.7f;
+        d->next_ms     = now_ms + MX_DRIFT_MIN_MS + mx_rand(&d->rng) % (MX_DRIFT_MAX_MS - MX_DRIFT_MIN_MS);
+    }
+    d->x = mx_follow(d->x, d->tx, dt_ms, MX_TAU_DRIFT_MS);
+    d->y = mx_follow(d->y, d->ty, dt_ms, MX_TAU_DRIFT_MS);
+}
+
+/* A value that is close enough to its target that no redraw is needed. */
+static inline int mx_settled(float cur, float target, float eps)
+{
+    const float d = cur - target;
+    return (d < 0 ? -d : d) <= eps;
+}
+
+#endif
