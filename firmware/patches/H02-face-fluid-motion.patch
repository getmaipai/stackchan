+// One eased step (patch H02). While the unit speaks the mouth follows the loudness of its voice; otherwise the weight
+// the face was given.
+void DefaultMouth::_update()
+{
+#if CONFIG_MAIPAI_FACE_FLUID
+    const int64_t now = esp_timer_get_time();
+    if (!_started) {
+        _started = true;
+        _last_us = now;
+        return;
+    }
+    const float dt = static_cast<float>(now - _last_us) / 1000.0f;
+    _last_us       = now;
+
+    float target = _sealed ? 0.0f : static_cast<float>(_weight);
+    int level;
+    if (!_sealed && maipai_speech_level(&level)) {
+        target = mx_mouth_for_level(level);
+    }
+    _sw = mx_follow(_sw, target, dt, mx_mouth_tau(_sw, target));
+    if (mx_settled(_sw, target, 0.5f)) {
+        _sw = target;
+    }
+    apply_weight(static_cast<int>(lroundf(_sw)));
+
+    _sx = mx_follow(_sx, static_cast<float>(_position.x), dt, MX_TAU_POS_MS);
+    _sy = mx_follow(_sy, static_cast<float>(_position.y), dt, MX_TAU_POS_MS);
+    layout();
+#endif
+}
