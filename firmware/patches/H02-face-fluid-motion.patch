diff --git a/firmware/main/hal/maipai_facefx.cc b/firmware/main/hal/maipai_facefx.cc
new file mode 100644
--- /dev/null
+++ b/firmware/main/hal/maipai_facefx.cc
@@ -0,0 +1,71 @@
+/*
+ * SPDX-License-Identifier: MIT
+ *
+ * Fluid face motion, the speech level (patch H02). The eased eyes, blink, gaze drift and mouth live in the default
+ * skin (stackchan/avatar/skins/default); this file only answers one question for the mouth: how loud is the unit's own
+ * voice right now. No task, no timer, no allocation: two atomics.
+ */
+#include <sdkconfig.h>
+
+#if CONFIG_MAIPAI_FACE_FLUID
+#include "maipai_facefx.h"
+#include "maipai_facefx_core.h"
+#include <esp_timer.h>
+#include <atomic>
+
+namespace {
+std::atomic<bool> s_active{false};
+std::atomic<int> s_level{0};
+std::atomic<uint32_t> s_stamp_ms{0};
+
+uint32_t now_ms()
+{
+    return static_cast<uint32_t>(esp_timer_get_time() / 1000);
+}
+}  // namespace
+
+void maipai_speech_set_active(bool on)
+{
+    s_active.store(on, std::memory_order_relaxed);
+    if (!on) {
+        s_level.store(0, std::memory_order_relaxed);
+    }
+}
+
+bool maipai_speech_level(int* level)
+{
+    if (!s_active.load(std::memory_order_relaxed)) {
+        return false;
+    }
+    if (now_ms() - s_stamp_ms.load(std::memory_order_relaxed) > MX_LEVEL_FRESH_MS) {
+        *level = 0;  // speaking, but nothing playing for a moment: the mouth closes
+        return true;
+    }
+    *level = s_level.load(std::memory_order_relaxed);
+    return true;
+}
+
+void maipai_speech_tap(const int16_t* samples, size_t count)
+{
+    if (!s_active.load(std::memory_order_relaxed) || samples == nullptr || count == 0) {
+        return;
+    }
+    // Every fourth sample is plenty for a loudness: a 60 ms block is a few hundred multiplies.
+    float sum    = 0.0f;
+    size_t taken = 0;
+    for (size_t i = 0; i < count; i += 4) {
+        const float v = static_cast<float>(samples[i]);
+        sum += v * v;
+        taken++;
+    }
+    const int level = mx_level_from_rms(sqrtf(sum / static_cast<float>(taken)));
+    s_level.store(level, std::memory_order_relaxed);
+    s_stamp_ms.store(now_ms(), std::memory_order_relaxed);
+}
+
+void maipai_speech_feed_bench(int level)
+{
+    s_level.store(level, std::memory_order_relaxed);
+    s_stamp_ms.store(now_ms(), std::memory_order_relaxed);
+}
+#endif
