+// One eased step (patch H02): the lids, the gaze, the tilt and the drift move toward where they were asked to be.
+void DefaultEyes::_update()
+{
+#if CONFIG_MAIPAI_FACE_FLUID
+    const int64_t now = esp_timer_get_time();
+    if (!_started) {
+        _started = true;
+        _last_us = now;
+        return;
+    }
+    const float dt = static_cast<float>(now - _last_us) / 1000.0f;
+    _last_us       = now;
+
+    _sx = mx_follow(_sx, static_cast<float>(_position.x), dt, MX_TAU_POS_MS);
+    _sy = mx_follow(_sy, static_cast<float>(_position.y), dt, MX_TAU_POS_MS);
+
+    const float lid_target = static_cast<float>(effective_weight());
+    _sw_eff                = mx_follow(_sw_eff, lid_target, dt, mx_lid_tau(_sw_eff, lid_target));
+    if (mx_settled(_sw_eff, lid_target, 0.4f)) {
+        _sw_eff = lid_target;
+    }
+    apply_lid();
+
+    _srot = mx_follow(_srot, static_cast<float>(_rotation), dt, MX_TAU_ROT_MS);
+    if (mx_settled(_srot, static_cast<float>(_rotation), 3.0f)) {
+        _srot = static_cast<float>(_rotation);
+    }
+    const int rot = static_cast<int>(lroundf(_srot));
+    if (rot != _drawn_rot) {
+        _drawn_rot = rot;
+        _container->setRotation(rot);
+    }
+
+    // The drift is shared: the first eye in a frame steps it. It rests while the eye is shut or hidden.
+    if (!s_drift_init) {
+        mx_drift_init(&s_drift, 0x9E3779B9u);
+        s_drift_init = true;
+    }
+    if (now - s_drift_us >= 5000) {
+        const float dts = static_cast<float>(now - s_drift_us) / 1000.0f;
+        s_drift_us      = now;
+        mx_drift_step(&s_drift, static_cast<uint32_t>(now / 1000), dts > 200.0f ? 200.0f : dts,
+                      (_visible && _sw_eff > 40.0f) ? MX_DRIFT_AMP_PX : 0);
+    }
+    _drawn_dx = static_cast<int>(lroundf(s_drift.x));
+    _drawn_dy = static_cast<int>(lroundf(s_drift.y));
+    layout();
+#endif
+}
