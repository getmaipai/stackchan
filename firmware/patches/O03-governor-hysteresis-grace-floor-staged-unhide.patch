+/* Brings a layer back after the overlays were hidden without one big redraw (patch O03): each call marks the next fixed area or particle
+ * boxes until about budget_px pixels are marked, then stops; call it once a tick with the same cursor (start at 0) until it returns 1. The
+ * boxes are the ones mo_mark_extent marks, only spread over several frames and over the layer's particle groups. */
+static inline int mo_unhide_step(mo_layer_t* L, int* cursor, int budget_px)
+{
+    if (L->id == MO_NONE) {
+        return 1;
+    }
+    long marked = 0;
+    const int parts = mo_fixed_parts(L->id);
+    while (marked < budget_px && *cursor < parts + L->n) {
+        const uint8_t before = L->ndirty;
+        mo_rect_t last = {0, 0, -1, -1};
+        if (*cursor < parts) {
+            mo_mark_fixed_part(L, *cursor);
+        } else {
+            int x1, y1, x2, y2;
+            mo_ext(L->id, &L->p[*cursor - parts], &x1, &y1, &x2, &y2);
+            mo_mark(L, x1, y1, x2, y2);
+        }
+        if (L->ndirty > before) last = L->dirty[L->ndirty - 1];
+        marked += (long)(last.x2 - last.x1 + 1) * (long)(last.y2 - last.y1 + 1);
+        (*cursor)++;
+    }
+    return *cursor >= parts + L->n;
+}
