+/* Patch SF74: a flip of a card, and a pop of a cell. */
+static inline int gan_flip(gan_t* a, uint32_t now, int cell)
+{
+    for (int i = 0; i < GAN_MAX; i++) {
+        if (a->t[i].kind == GAN_NONE) {
+            memset(&a->t[i], 0, sizeof(a->t[i]));
+            a->t[i].kind = GAN_FLIP;
+            a->t[i].cell = (uint8_t)cell;
+            a->t[i].t0 = now;
+            return i;
+        }
+    }
+    return -1;
+}
+
+static inline int gan_pop(gan_t* a, uint32_t now, int cell)
+{
+    for (int i = 0; i < GAN_MAX; i++) {
+        if (a->t[i].kind == GAN_NONE) {
+            memset(&a->t[i], 0, sizeof(a->t[i]));
+            a->t[i].kind = GAN_POP;
+            a->t[i].cell = (uint8_t)cell;
+            a->t[i].t0 = now;
+            return i;
+        }
+    }
+    return -1;
+}
+
+/* The width of a flipping card in permille of its full width (1000 when it is not flipping): 1000 down to 0 at the middle, back up to 1000. */
+static inline int gan_flip_width(const gan_t* a, int cell, uint32_t now)
+{
+    for (int i = 0; i < GAN_MAX; i++) {
+        if (a->t[i].kind == GAN_FLIP && a->t[i].cell == cell) {
+            const uint32_t e = now - a->t[i].t0;
+            if (e >= GAN_FLIP_MS) {
+                return 1000;
+            }
+            const uint32_t half = GAN_FLIP_MS / 2u;
+            return e < half ? (int)(1000u - 1000u * e / half) : (int)(1000u * (e - half) / half);
+        }
+    }
+    return 1000;
+}
+
+/* Is the card past the middle of its flip (so the new face shows)? 1 when it is not flipping. */
+static inline int gan_flip_new_face(const gan_t* a, int cell, uint32_t now)
+{
+    for (int i = 0; i < GAN_MAX; i++) {
+        if (a->t[i].kind == GAN_FLIP && a->t[i].cell == cell) {
+            return now - a->t[i].t0 >= GAN_FLIP_MS / 2u;
+        }
+    }
+    return 1;
+}
+
+/* The size of a popping cell in permille (1000 when it is not popping): up to 1120 at 40 percent of the time, back to 1000. */
+static inline int gan_pop_scale(const gan_t* a, int cell, uint32_t now)
+{
+    for (int i = 0; i < GAN_MAX; i++) {
+        if (a->t[i].kind == GAN_POP && a->t[i].cell == cell) {
+            const uint32_t e = now - a->t[i].t0;
+            if (e >= GAN_POP_MS) {
+                return 1000;
+            }
+            const uint32_t peak = GAN_POP_MS * 4u / 10u;
+            return e < peak ? (int)(1000u + 120u * e / peak) : (int)(1120u - 120u * (e - peak) / (GAN_POP_MS - peak));
+        }
+    }
+    return 1000;
+}
+
