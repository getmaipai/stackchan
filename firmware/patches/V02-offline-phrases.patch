+// A clip is real when it exists and starts with the Ogg capture pattern.
+bool clip_real(int group, int variant)
+{
+    if (group < 0 || group >= MS_GRP_COUNT || variant < 0 || variant >= MS_GROUP_SIZE[group]) {
+        return false;
+    }
+    const PhClip& c = kClips[group][variant];
+    return c.start != nullptr && c.end > c.start + 4 && memcmp(c.start, "OggS", 4) == 0;
