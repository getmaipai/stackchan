+void maipai_sounds_link_event(int event)
+{
+#if CONFIG_MAIPAI_OFFLINE_PHRASES
+    bool back_clip = false;
+    {
+        std::lock_guard<std::mutex> lock(s_ph_mutex);
+        ph_ensure_locked();
+        const uint32_t now = ph_now_ms();
+        switch (event) {
+            case MAIPAI_LINK_DOWN: ms_link_down(&s_ph_link, now); break;
+            case MAIPAI_LINK_HELLO_FAILED: ms_link_hello_failed(&s_ph_link); break;
+            case MAIPAI_LINK_HELLO_SLOW: s_ph_link.hello_fails = 0; break;  // a slow or absent host is not a refusal
+            case MAIPAI_LINK_OFFLINE_SOUNDED: ms_link_mark_offline(&s_ph_link); break;
+            case MAIPAI_LINK_UP: back_clip = ms_link_up(&s_ph_link, now).back_clip != 0; break;
+            default: break;
+        }
+    }
+    if (back_clip) {
+        (void)phrase_run(MS_GRP_BACK, false, false);  // "I'm back", only after a long outage, through the same limits
+    }
+#else
+    (void)event;
+#endif
+}
