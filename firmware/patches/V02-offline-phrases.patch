+// ---- offline phrases (patch V02) ----
+// What the link to Home did, as the reconnect loop sees it. Fed from the websocket task (and the quiet reconnect).
+enum {
+    MAIPAI_LINK_DOWN = 0,         // the link went down, or the unit started without it
+    MAIPAI_LINK_UP,               // the first hello arrived: Home is back
+    MAIPAI_LINK_HELLO_FAILED,     // Home accepted the connection and closed it before its hello
+    MAIPAI_LINK_HELLO_SLOW,       // a connect failed for another reason (Home slow or absent): not a refusal
+    MAIPAI_LINK_OFFLINE_SOUNDED,  // the 3 minute offline tone played: coming back may say "I'm back"
+};
