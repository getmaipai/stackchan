+                std::lock_guard<std::mutex> lock(s_mutex);
+                s_clips_played++;
+            }
+        } else {
+            kind = "tone";
+            std::lock_guard<std::mutex> lock(s_mutex);
+            s_clips_missing++;
+        }
+    } else if (pick.kind == MS_PH_TONE) {
+        kind = "tone";
+    } else if (!muted && tone_if_not_clip) {
+        kind = "tone";  // the link is up or unknown: no clip fits, the old tone
+    }
+    if (!dry && strcmp(kind, "tone") == 0) {
