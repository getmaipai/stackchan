# Intent: The auto lock offers off, 1 and 15 minutes (owner decision 22). A unit that saved 5, 30 or 60 minutes with an earlier version keeps that value until the person picks again: an update never turns a saved auto lock into "off". Memory cost: none.
# Placement: unit
# Upstream: firmware/main/hal (ours)
# Check after a flash: self.lock.set_auto with 5 is refused and with 15 is accepted; a unit that had 30 saved still reports auto_minutes 30 after the update.
# Kconfig: none

diff --git a/firmware/main/hal/maipai_lock_core.h b/firmware/main/hal/maipai_lock_core.h
--- a/firmware/main/hal/maipai_lock_core.h
+++ b/firmware/main/hal/maipai_lock_core.h
@@ -186,8 +186,12 @@ typedef struct {
