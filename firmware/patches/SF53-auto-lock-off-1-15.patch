 static const char* const MLK_REASONS[MLK_R_COUNT] = {"ok", "bad_code", "current_needed", "wrong_current", "locked", "no_code", "bad_minutes", "too_many"};
 
-#define LK_AUTO_COUNT 6
-static const uint8_t LK_AUTO_MINUTES[LK_AUTO_COUNT] = {0, 1, 5, 15, 30, 60};
+/* Patch SF53 (owner decision 22): the auto lock offers off, 1 and 15 minutes. A unit that saved 5, 30 or 60 before keeps that value until the person picks again
+ * (LK_AUTO_LEGACY): the saved choice is never turned into "off" by an update. */
+#define LK_AUTO_COUNT 3
+static const uint8_t LK_AUTO_MINUTES[LK_AUTO_COUNT] = {0, 1, 15};
+#define LK_AUTO_LEGACY_COUNT 6
+static const uint8_t LK_AUTO_LEGACY[LK_AUTO_LEGACY_COUNT] = {0, 1, 5, 15, 30, 60};
 
 enum { MLK_EV_NONE = 0, MLK_EV_UNLOCK, MLK_EV_WRONG, MLK_EV_CANCEL, MLK_EV_IGNORED };
 
@@ -214,6 +218,15 @@ static inline int mlk_auto_ok(int minutes)
     return 0;
 }
 
+/* A saved value is accepted when it is one of today's choices or one an earlier version offered. */
+static inline int mlk_auto_saved_ok(int minutes)
+{
+    for (int i = 0; i < LK_AUTO_LEGACY_COUNT; i++) {
+        if (LK_AUTO_LEGACY[i] == minutes) return 1;
+    }
+    return 0;
+}
+
 static inline void mlk_derive(const char* code, const uint8_t salt[LK_SALT_LEN], uint8_t out[LK_HASH_LEN])
 {
     lk_pbkdf2((const uint8_t*)code, strlen(code), salt, LK_SALT_LEN, LK_KDF_ROUNDS, out);
@@ -271,7 +284,7 @@ static inline void mlk_load(mlk_t* s, const char* salt_hex, const char* hash_hex
         memset(s->salt, 0, sizeof(s->salt));
         memset(s->hash, 0, sizeof(s->hash));
     }
-    s->auto_min = (uint8_t)(mlk_auto_ok(auto_min) ? auto_min : 0);
+    s->auto_min = (uint8_t)(mlk_auto_saved_ok(auto_min) ? auto_min : 0);
     s->last_activity_ms = now;
 }
 
