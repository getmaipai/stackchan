+static CoreS3AudioCodec* s_instance = nullptr;
+
     uint8_t aw88298_addr, uint8_t es7210_addr, bool input_reference) {
     duplex_ = true; // 是否双工
     input_reference_ = input_reference; // 是否使用参考输入，实现回声消除
@@ -77,7 +84,72 @@ CoreS3AudioCodec::CoreS3AudioCodec(void* i2c_master_handle, int input_sample_rat
 }
 
 CoreS3AudioCodec::~CoreS3AudioCodec() {
+    s_instance = this;
+    if (maipai_mic_blocked()) {
+        // The unit boots muted (or in full quiet): the chip is powered down before anything can open it.
+        MaipaiMicOff(nullptr, 0);
