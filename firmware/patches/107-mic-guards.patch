     }
 
     auto state = GetDeviceState();
@@ -1252,6 +1253,15 @@ void Application::HandleNotificationFinished(uint32_t playback_id, bool success)
 }
 
 void Application::Schedule(std::function<void()>&& callback) {
+    if (maipai_mic_blocked()) {
+        // Muted or in full quiet (patch 107): every way into listening ends here. The unit goes back to idle
+        // (it may have been set to connecting on the way).
+        ESP_LOGW(TAG, "listening refused: muted or in full quiet");
+        if (GetDeviceState() != kDeviceStateIdle) {
+            SetDeviceState(kDeviceStateIdle);
+        }
+        return;
+    }
     {
         std::lock_guard<std::mutex> lock(mutex_);
         main_tasks_.push_back(std::move(callback));
