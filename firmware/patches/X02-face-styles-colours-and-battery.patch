+            c->bg_mode = MF_COLOUR_PALETTE;
+            c->bg_palette = (uint8_t)i;
+            return MF_OK;
+        }
+    }
+    if (text[0] != '#' || strlen(text) != 7) {
+        return MF_ERR_COLOUR;
