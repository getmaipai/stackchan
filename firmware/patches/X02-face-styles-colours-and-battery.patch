+static inline int mf_set_background(mf_config_t* c, const char* text)
+{
+    if (text == NULL || text[0] == '\0' || strcmp(text, "none") == 0) {
+        c->bg_mode = MF_COLOUR_NONE;
+        return MF_OK;
+    }
+    for (int i = 0; i < MF_PALETTE_COUNT; i++) {
