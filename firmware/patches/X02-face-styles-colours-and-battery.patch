+    int v[6];
+    for (int i = 0; i < 6; i++) {
+        v[i] = mf_hex_digit(text[1 + i]);
+        if (v[i] < 0) {
+            return MF_ERR_COLOUR;
+        }
+    }
+    const int r = v[0] * 16 + v[1], g = v[2] * 16 + v[3], b = v[4] * 16 + v[5];
