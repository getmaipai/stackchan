+/*
+ * SPDX-License-Identifier: MIT
+ *
+ * The game player, device side (patch G01). See maipai_games.h. One game at a time. While a game runs it owns one
+ * LVGL object tree on the top layer (never clickable, so a touch still reaches the face's own handlers, which pass it
+ * here), one LVGL timer (30 ms) and about 0.5 KB of PSRAM (measured: 492 bytes); the three built-in packs are flash data read in place.
+ * Scores are saved once, when a game ends, into the NVS namespace "mp_games" (five u16 per game).
+ */
+#include <sdkconfig.h>
+#if CONFIG_MAIPAI_GAMES
+#include "maipai_games.h"
+#include "maipai_games_core.h"
+#include "maipai_face.h"
+#include "maipai_privacy.h"
+#include "maipai_sounds.h"
+#include "maipai_timers.h"
+#include "maipai_update.h"
+#include "device_events.h"
+#include "board/hal_bridge.h"
+#include "hal.h"
+#include <application.h>
+#include <mcp_server.h>
+#include <update_verify.h>
+#include <esp_heap_caps.h>
+#include <esp_log.h>
+#include <esp_random.h>
+#include <esp_timer.h>
+#include <lvgl.h>
+#include <nvs.h>
+#include <nvs_flash.h>
+#include <psa/crypto.h>
+#include <strings.h>
+#include <atomic>
+#include <cstdio>
+#include <cstring>
+#include <mutex>
+#include <string>
+#include <vector>
+
+static const char* TAG        = "MAIPAI-GAMES";
+static const char* kNamespace = "mp_games";
+
+extern "C" {
+extern const uint8_t _binary_memory_mpk_start[];
+extern const uint8_t _binary_memory_mpk_end[];
+extern const uint8_t _binary_reaction_mpk_start[];
+extern const uint8_t _binary_reaction_mpk_end[];
+extern const uint8_t _binary_whack_mpk_start[];
+extern const uint8_t _binary_whack_mpk_end[];
+}
+
+namespace {
+
+constexpr int kBuiltIns   = 3;
+constexpr int kMaxGames   = kBuiltIns + 1;  // the three, plus one pack loaded from outside (bench builds)
+constexpr uint32_t kTickMs = 30;
+
+struct Source {
+    const uint8_t* start;
+    const uint8_t* end;
+};
+const Source kBuilt[kBuiltIns] = {
+    {_binary_memory_mpk_start, _binary_memory_mpk_end},
+    {_binary_reaction_mpk_start, _binary_reaction_mpk_end},
+    {_binary_whack_mpk_start, _binary_whack_mpk_end},
+};
+
+// A pack loaded from outside the image (only the bench tool does this today): one slot, in PSRAM.
+uint8_t* s_ext     = nullptr;
+size_t s_ext_len   = 0;
+
+struct Entry {
+    char id[12];
+    uint16_t best[MG_SCORES];
+};
+std::mutex s_mutex;  // a leaf lock: the score cache
+Entry s_entries[kMaxGames];
+bool s_loaded = false;
+
+struct Game {
+    mg_pack_t pack;
+    mg_run_t run;
+    lv_obj_t* root;
+    lv_timer_t* timer;
+    lv_obj_t* obj[MG_MAX_SHAPES];
+    uint8_t type[MG_MAX_SHAPES];
+    uint8_t text[MG_MAX_SHAPES];
+    int16_t last_ctr[MG_COUNTERS];
+    uint8_t last_state;
+    bool es;
+    bool lower;
+    int entry;
+    int rank;
+    uint32_t last_awake_ms;
+    uint32_t tones;
+    char id[12];
+    char source[8];
+};
+
+Game* s_game = nullptr;  // owned by the LVGL task: touched only with the LVGL lock held
+std::atomic<bool> s_active{false};
+std::atomic<const char*> s_stop_req{nullptr};
+uint32_t s_tones_total = 0;
+uint32_t s_saves_total = 0;
+
+uint32_t now_ms()
+{
+    return static_cast<uint32_t>(esp_timer_get_time() / 1000);
+}
+
+bool want_spanish()
+{
+#if CONFIG_MAIPAI_FACE_CONFIG
+    return maipai_face_config().lang == MF_LANG_ES;
+#else
+    return false;
+#endif
+}
+
+bool bench_build()
+{
+#if CONFIG_MAIPAI_GAMES_BENCH
+    return true;
+#else
+    return false;
+#endif
+}
+
+// ---- the packs ----
+
+// Pack bytes for slot `i` (0 to 2 the built-ins, 3 the outside pack), or false.
+bool slot_bytes(int i, const uint8_t** data, size_t* len)
+{
+    if (i >= 0 && i < kBuiltIns) {
+        *data = kBuilt[i].start;
+        *len  = static_cast<size_t>(kBuilt[i].end - kBuilt[i].start);
+        return true;
+    }
+    if (i == kBuiltIns && s_ext != nullptr) {
+        *data = s_ext;
+        *len  = s_ext_len;
+        return true;
+    }
+    return false;
+}
+
+bool slot_pack(int i, mg_pack_t* p)
+{
+    const uint8_t* data;
+    size_t len;
+    return slot_bytes(i, &data, &len) && mg_parse(data, len, p) == MG_OK;
+}
+
+int slot_by_name(const char* name)
+{
+    if (name == nullptr || name[0] == '\0') {
+        return -1;
+    }
+    for (int i = 0; i < kMaxGames; i++) {
+        mg_pack_t p;
+        if (!slot_pack(i, &p)) {
+            continue;
+        }
+        if (strcasecmp(name, p.id) == 0 || strcasecmp(name, mg_text_raw(&p, p.title_text, 0)) == 0 ||
+            strcasecmp(name, mg_text_raw(&p, p.title_text, 1)) == 0) {
+            return i;
+        }
+    }
+    return -1;
+}
+
+// ---- scores ----
+
+void load_scores_locked()
+{
+    if (s_loaded) {
+        return;
+    }
+    s_loaded = true;
+    nvs_handle_t h;
+    const bool have = nvs_open(kNamespace, NVS_READONLY, &h) == ESP_OK;
+    for (int i = 0; i < kBuiltIns; i++) {
+        mg_pack_t p;
+        if (!slot_pack(i, &p)) {
+            continue;
+        }
+        snprintf(s_entries[i].id, sizeof(s_entries[i].id), "%s", p.id);
+        if (!have) {
+            continue;
+        }
+        char key[16];
+        snprintf(key, sizeof(key), "s_%s", p.id);
+        uint8_t buf[2 * MG_SCORES];
+        size_t n = sizeof(buf);
+        if (nvs_get_blob(h, key, buf, &n) == ESP_OK && n == sizeof(buf)) {
+            for (int k = 0; k < MG_SCORES; k++) {
+                s_entries[i].best[k] = mg_u16(buf + 2 * k);
+            }
+        }
+    }
+    if (have) {
+        nvs_close(h);
+    }
+}
+
+void write_scores(const char* id, const uint16_t scores[MG_SCORES])
+{
+    nvs_handle_t h;
+    if (nvs_open(kNamespace, NVS_READWRITE, &h) != ESP_OK) {
+        ESP_LOGW(TAG, "could not save the scores of %s", id);
+        return;
+    }
+    char key[16];
+    snprintf(key, sizeof(key), "s_%s", id);
+    uint8_t buf[2 * MG_SCORES];
+    for (int k = 0; k < MG_SCORES; k++) {
+        buf[2 * k]     = static_cast<uint8_t>(scores[k] & 0xFF);
+        buf[2 * k + 1] = static_cast<uint8_t>(scores[k] >> 8);
+    }
+    if (nvs_set_blob(h, key, buf, sizeof(buf)) != ESP_OK || nvs_commit(h) != ESP_OK) {
+        ESP_LOGW(TAG, "could not write the scores of %s", id);
+    }
+    nvs_close(h);
+}
+
+// ---- drawing ----
+
+lv_color_t colour(uint16_t c)
+{
+    return lv_color_make(static_cast<uint8_t>(((c >> 11) & 31) << 3), static_cast<uint8_t>(((c >> 5) & 63) << 2),
+                         static_cast<uint8_t>((c & 31) << 3));
+}
+
+const lv_font_t* font_for(int size)
+{
+    return size == 0 ? &lv_font_montserrat_14 : (size == 1 ? &lv_font_montserrat_16 : &lv_font_montserrat_20);
+}
+
+lv_obj_t* plain(lv_obj_t* parent)
+{
+    lv_obj_t* o = lv_obj_create(parent);
+    lv_obj_remove_style_all(o);
+    lv_obj_remove_flag(o, LV_OBJ_FLAG_CLICKABLE);
+    lv_obj_remove_flag(o, LV_OBJ_FLAG_SCROLLABLE);
+    lv_obj_add_flag(o, LV_OBJ_FLAG_HIDDEN);
+    return o;
+}
+
+lv_obj_t* build_shape(lv_obj_t* parent, const mg_shape_t& s)
+{
+    switch (s.type) {
+        case MG_SH_FILL: {
+            lv_obj_t* o = plain(parent);
+            lv_obj_set_size(o, 320, 240);
+            lv_obj_set_pos(o, 0, 0);
+            lv_obj_set_style_bg_color(o, colour(s.colour), 0);
+            lv_obj_set_style_bg_opa(o, LV_OPA_COVER, 0);
+            return o;
+        }
+        case MG_SH_CIRCLE:
+        case MG_SH_RING: {
+            lv_obj_t* o = plain(parent);
+            lv_obj_set_size(o, s.w * 2, s.w * 2);
+            lv_obj_set_pos(o, s.x - s.w, s.y - s.w);
+            lv_obj_set_style_radius(o, LV_RADIUS_CIRCLE, 0);
+            if (s.type == MG_SH_CIRCLE) {
+                lv_obj_set_style_bg_color(o, colour(s.colour), 0);
+                lv_obj_set_style_bg_opa(o, LV_OPA_COVER, 0);
+            } else {
+                lv_obj_set_style_border_color(o, colour(s.colour), 0);
+                lv_obj_set_style_border_width(o, s.aux > 0 ? s.aux : 2, 0);
+            }
+            return o;
+        }
+        case MG_SH_BOX: {
+            lv_obj_t* o = plain(parent);
+            lv_obj_set_size(o, s.w, s.h);
+            lv_obj_set_pos(o, s.x, s.y);
+            lv_obj_set_style_radius(o, s.aux, 0);
+            lv_obj_set_style_bg_color(o, colour(s.colour), 0);
+            lv_obj_set_style_bg_opa(o, LV_OPA_COVER, 0);
+            return o;
+        }
+        default: {  // MG_SH_TEXT
+            lv_obj_t* o = lv_label_create(parent);
+            lv_obj_remove_flag(o, LV_OBJ_FLAG_CLICKABLE);
+            lv_obj_add_flag(o, LV_OBJ_FLAG_HIDDEN);
+            const lv_font_t* font = font_for(s.aux);
+            const int width       = s.w > 0 ? s.w : 280;
+            lv_obj_set_style_text_font(o, font, 0);
+            lv_obj_set_style_text_color(o, colour(s.colour), 0);
+            lv_obj_set_style_text_align(o, LV_TEXT_ALIGN_CENTER, 0);
+            lv_label_set_long_mode(o, LV_LABEL_LONG_WRAP);
+            lv_obj_set_width(o, width);
+            lv_obj_set_pos(o, s.x - width / 2, s.y - lv_font_get_line_height(font) / 2);
+            return o;
+        }
+    }
+}
+
+void redraw(Game* g, bool force)
+{
+    mg_run_t& r = g->run;
+    if (!force && r.state == g->last_state && memcmp(r.ctr, g->last_ctr, sizeof(g->last_ctr)) == 0) {
+        return;
+    }
+    g->last_state = r.state;
+    memcpy(g->last_ctr, r.ctr, sizeof(g->last_ctr));
+    for (int i = 0; i < g->pack.n_shapes; i++) {
+        lv_obj_t* o = g->obj[i];
+        if (o == nullptr) {
+            continue;
+        }
+        if (mg_shape_visible(&r, i)) {
+            if (g->type[i] == MG_SH_TEXT) {
+                char buf[MG_TEXT_LEN + 16];
+                mg_text(&r, g->text[i], g->es ? 1 : 0, buf, sizeof(buf));
+                lv_label_set_text(o, buf);
+            }
+            lv_obj_remove_flag(o, LV_OBJ_FLAG_HIDDEN);
+        } else {
+            lv_obj_add_flag(o, LV_OBJ_FLAG_HIDDEN);
+        }
+    }
+}
+
+// ---- the running game ----
+
+void end_locked(const char* how)
+{
+    Game* g = s_game;
+    if (g == nullptr) {
+        return;
+    }
+    s_game = nullptr;
+    if (g->timer != nullptr) {
+        lv_timer_delete(g->timer);
+    }
+    if (g->root != nullptr) {
+        lv_obj_delete(g->root);  // every shape is its child
+    }
+    char extra[120];
+    snprintf(extra, sizeof(extra), "\"game\":\"%s\",\"how\":\"%s\",\"score\":%d,\"rank\":%d", g->id, how,
+             g->run.ctr[g->pack.score_ctr], g->rank);
+    ESP_LOGI(TAG, "game %s ended (%s), score %d, rank %d, %u tones", g->id, how, g->run.ctr[g->pack.score_ctr], g->rank,
+             static_cast<unsigned>(g->tones));
+    heap_caps_free(g);
+    s_stop_req.store(nullptr);
+    s_active.store(false);
+    if (!maipai_timers_ringing()) {
+        hal_bridge::stop_word_arm(false);  // a ring keeps its own arming
+    }
+    device_events_push("game_ended", extra);
+}
+
+void commit_score(Game* g)
+{
+    const int value = g->run.ctr[g->pack.score_ctr];
+    uint16_t copy[MG_SCORES];
+    int rank;
+    {
+        std::lock_guard<std::mutex> lock(s_mutex);
+        rank = mg_scores_add(s_entries[g->entry].best, g->lower ? 1 : 0, value);
+        memcpy(copy, s_entries[g->entry].best, sizeof(copy));
+    }
+    g->rank = rank;
+    if (rank < 0) {
+        return;
+    }
+    s_saves_total++;
+    // The flash write runs on the main task, never on the screen task (and only here, once, when a game ends).
+    char id[12];
+    snprintf(id, sizeof(id), "%s", g->id);
+    Application::GetInstance().Schedule([id, copy]() { write_scores(id, copy); });
+}
+
+// Plays the tones the player queued, saves a committed score, redraws; ends the game when the player finished.
+void after_event(Game* g)
+{
+    mg_run_t& r = g->run;
+    for (int i = 0; i < r.tone_n; i++) {
+        (void)maipai_sounds_play(MG_TONES[r.tone_q[i]]);  // the sound policy and the mute decide; a refusal is silence
+        g->tones++;
+        s_tones_total++;
+    }
+    r.tone_n = 0;
+    if (r.save_pending) {
+        r.save_pending = 0;
+        commit_score(g);
+    }
+    redraw(g, false);
+    if (r.finished) {
+        end_locked(r.budget_hit ? "budget" : "finished");
+    }
+}
+
+void tick_cb(lv_timer_t*)
+{
+    Game* g = s_game;
+    if (g == nullptr) {
+        return;
+    }
+    if (const char* how = s_stop_req.exchange(nullptr)) {
+        end_locked(how);
+        return;
+    }
+    if (maipai_quiet()) {  // full quiet wins over everything
+        end_locked("quiet");
+        return;
+    }
+    if (maipai_update_active()) {
+        end_locked("update");
+        return;
+    }
+    const uint32_t now = now_ms();
+    if (now - g->last_awake_ms >= 1000) {
+        g->last_awake_ms = now;
+        hal_bridge::power_keep_awake();  // a game keeps the screen on
+    }
+    mg_tick(&g->run, now);
+    after_event(g);
+}
+
+const char* say(bool es, const char* en, const char* sp)
+{
+    return es ? sp : en;
+}
+
+}  // namespace
+
+bool maipai_games_active()
+{
+    return s_active.load();
+}
+
+int maipai_games_count()
+{
+    int n = 0;
+    for (int i = 0; i < kMaxGames; i++) {
+        mg_pack_t p;
+        n += slot_pack(i, &p) ? 1 : 0;
+    }
+    return n;
+}
+
+const char* maipai_games_id(int index)
+{
+    static char ids[kMaxGames][12];
+    mg_pack_t p;
+    int seen = 0;
+    for (int i = 0; i < kMaxGames; i++) {
+        if (slot_pack(i, &p) && seen++ == index) {
+            snprintf(ids[i], sizeof(ids[i]), "%s", p.id);
+            return ids[i];
+        }
+    }
+    return "";
+}
+
+const char* maipai_games_title(int index, bool es)
+{
+    mg_pack_t p;
+    int seen = 0;
+    for (int i = 0; i < kMaxGames; i++) {
+        if (slot_pack(i, &p) && seen++ == index) {
+            return mg_text_raw(&p, p.title_text, es ? 1 : 0);  // the text is in flash or in the pack's own PSRAM copy
+        }
+    }
+    return "";
+}
+
+int maipai_games_best(int index)
+{
+    mg_pack_t p;
+    int seen = 0;
+    for (int i = 0; i < kMaxGames; i++) {
+        if (slot_pack(i, &p) && seen++ == index) {
+            std::lock_guard<std::mutex> lock(s_mutex);
+            return s_entries[i].best[0];
+        }
+    }
+    return 0;
+}
+
+bool maipai_games_lower_is_better(int index)
+{
+    mg_pack_t p;
+    int seen = 0;
+    for (int i = 0; i < kMaxGames; i++) {
+        if (slot_pack(i, &p) && seen++ == index) {
+            return (p.flags & MG_FLAG_LOWER_BETTER) != 0;
+        }
+    }
+    return false;
+}
+
+const char* maipai_games_start_locked(const char* name, const char* source)
+{
+    const bool es = want_spanish();
+    if (s_game != nullptr) {
+        return say(es, "A game is already running. Stop it first (swipe down from the bottom edge, or say stop), then start another.",
+                   "Ya hay un juego en marcha. Detenlo primero (desliza hacia abajo desde el borde inferior, o di para), y luego empieza otro.");
+    }
+    const int slot = slot_by_name(name);
+    if (slot < 0) {
+        return say(es, "That game is not on this unit. Ask for memory, reaction or whack.",
+                   "Ese juego no esta en esta unidad. Pide memory, reaction o whack.");
+    }
+    if (maipai_quiet()) {
+        return say(es, "The unit is in full quiet, so no game starts. Turn full quiet off, then ask again.",
+                   "La unidad esta en silencio total, asi que no empieza ningun juego. Quita el silencio total y pidelo otra vez.");
+    }
+    if (maipai_update_active()) {
+        return say(es, "The unit is installing an update. Ask again when it has restarted.",
+                   "La unidad esta instalando una actualizacion. Pidelo otra vez cuando se reinicie.");
+    }
+    const uint8_t* data;
+    size_t len;
+    if (!slot_bytes(slot, &data, &len)) {
+        return say(es, "That game is not on this unit. Ask for memory, reaction or whack.",
+                   "Ese juego no esta en esta unidad. Pide memory, reaction o whack.");
+    }
+    Game* g = static_cast<Game*>(heap_caps_calloc(1, sizeof(Game), MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT));
+    if (g == nullptr) {
+        return say(es, "The unit is low on memory. Restart it and try again.",
+                   "La unidad tiene poca memoria. Reiniciala e intentalo otra vez.");
+    }
+    const mg_err_t err = mg_parse(data, len, &g->pack);
+    if (err != MG_OK) {
+        heap_caps_free(g);
+        return mg_err_text(err, es);
+    }
+    g->es    = es;
+    g->lower = (g->pack.flags & MG_FLAG_LOWER_BETTER) != 0;
+    g->entry = slot;
+    g->rank  = -1;
+    snprintf(g->id, sizeof(g->id), "%s", g->pack.id);
+    snprintf(g->source, sizeof(g->source), "%s", source != nullptr ? source : "tool");
+    {
+        std::lock_guard<std::mutex> lock(s_mutex);
+        load_scores_locked();
+        if (s_entries[slot].id[0] == '\0') {
+            snprintf(s_entries[slot].id, sizeof(s_entries[slot].id), "%s", g->id);
+        }
+    }
+    g->root = lv_obj_create(lv_layer_top());
+    lv_obj_remove_style_all(g->root);
+    lv_obj_remove_flag(g->root, LV_OBJ_FLAG_CLICKABLE);
+    lv_obj_remove_flag(g->root, LV_OBJ_FLAG_SCROLLABLE);
+    lv_obj_set_size(g->root, 320, 240);
+    lv_obj_set_pos(g->root, 0, 0);
+    lv_obj_set_style_bg_color(g->root, lv_color_black(), 0);
+    lv_obj_set_style_bg_opa(g->root, LV_OPA_COVER, 0);
+    for (int i = 0; i < g->pack.n_shapes; i++) {
+        mg_shape_t s;
+        mg_shape_get(&g->pack, i, &s);
+        g->type[i] = s.type;
+        g->text[i] = s.text;
+        g->obj[i]  = build_shape(g->root, s);
+    }
+    g->last_awake_ms = now_ms();
+    mg_start(&g->run, &g->pack, now_ms(), esp_random());
+    s_game = g;
+    s_active.store(true);
+    s_stop_req.store(nullptr);
+    g->timer = lv_timer_create(tick_cb, kTickMs, nullptr);
+    if (!maipai_mic_blocked()) {
+        hal_bridge::stop_word_arm(true);  // best effort: the stop word ends a game
+    }
+    hal_bridge::power_keep_awake();
+    redraw(g, true);
+    char extra[48];
+    snprintf(extra, sizeof(extra), "\"game\":\"%s\",\"source\":\"%s\"", g->id, g->source);
+    device_events_push("game_started", extra);
+    ESP_LOGI(TAG, "game %s started (%s), pack %u bytes", g->id, g->source, static_cast<unsigned>(len));
+    after_event(g);  // the first state may already have a tone
+    return "";
+}
+
+bool maipai_games_stop_locked(const char* how)
+{
+    if (s_game == nullptr) {
+        return false;
+    }
+    end_locked(how != nullptr ? how : "stopped");
+    return true;
+}
+
+bool maipai_games_request_stop(const char* how)
+{
+    if (!s_active.load()) {
+        return false;
+    }
+    s_stop_req.store(how);
+    return true;
+}
+
+void maipai_games_touch(int x, int y)
+{
+    Game* g = s_game;
+    if (g == nullptr) {
+        return;
+    }
+    mg_tap(&g->run, x, y, now_ms());
+    after_event(g);
+}
