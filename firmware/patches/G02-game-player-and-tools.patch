+/*
+ * SPDX-License-Identifier: MIT
+ *
+ * The game player, device side (patch G01). The player and the pack format are the pure core in maipai_games_core.h; this
+ * file draws a game with LVGL shapes, plays its tones through the sound policy, keeps the top five scores in the
+ * unit's own NVS namespace and registers the tools. Nothing exists while no game runs: no task, no timer, no objects and
+ * no PSRAM (the three games are flash data in the app image). With CONFIG_MAIPAI_GAMES off nothing here is compiled.
+ */
+#pragma once
+#include <sdkconfig.h>
+
+#if CONFIG_MAIPAI_GAMES
+#include <stdbool.h>
+
+// Registers self.game.list, start, stop and scores (and the bench tools in a bench build).
+void maipai_games_register_tools();
+// True from the moment a game starts until it ends. Cheap and safe from any task.
+bool maipai_games_active();
+// Starts a game by id ("memory", "reaction", "whack"). Returns "" or a plain sentence saying what is wrong and what to do.
+// The caller holds the LVGL lock. `source` is "touch", "voice" or "host" (reported in the game_started event).
+const char* maipai_games_start_locked(const char* id, const char* source);
+// Ends the running game from the LVGL task (the stop swipe); the caller holds the LVGL lock. True if one was running.
+bool maipai_games_stop_locked(const char* how);
+// Asks for the running game to end from any task without a lock (the stop word); it ends within 30 ms. True if one runs.
+bool maipai_games_request_stop(const char* how);
+// A touch that began outside the screen edges, in screen pixels (LVGL task, lock held).
+void maipai_games_touch(int x, int y);
+// The saved best of each game, for the games page: 0 when none. `lower` tells which way is better.
+int maipai_games_count();
+const char* maipai_games_id(int index);
+const char* maipai_games_title(int index, bool es);
+int maipai_games_best(int index);
+bool maipai_games_lower_is_better(int index);
+#else
+inline void maipai_games_register_tools() {}
+inline bool maipai_games_active() { return false; }
+inline bool maipai_games_request_stop(const char*) { return false; }
+inline bool maipai_games_stop_locked(const char*) { return false; }
+inline void maipai_games_touch(int, int) {}
+#endif
