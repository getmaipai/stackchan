+void maipai_games_register_tools()
+{
+    {
+        std::lock_guard<std::mutex> lock(s_mutex);
+        load_scores_locked();  // reads the saved scores once, here, on the task that sets the tools up
+    }
+    auto& mcp = McpServer::GetInstance();
+    mcp.AddTool("self.game.list",
+                "List the games on this unit with their best scores (best first, up to five), and which one is playing now. "
+                "Answers {ok, playing, games:[{id, title, lower_is_better, scores}]}.",
+                std::vector<Property>{}, [](const PropertyList&) -> ReturnValue {
+                    const bool es = want_spanish();
+                    std::string out = std::string("{\"ok\":true,\"playing\":") + (s_active.load() ? "true" : "false") + ",\"games\":[";
+                    bool first      = true;
+                    for (int i = 0; i < kMaxGames; i++) {
+                        mg_pack_t p;
+                        if (!slot_pack(i, &p)) {
+                            continue;
+                        }
+                        out += first ? "" : ",";
+                        first = false;
+                        out += std::string("{\"id\":\"") + p.id + "\",\"title\":\"" +
+                               json_text(mg_text_raw(&p, p.title_text, es ? 1 : 0)) + "\",\"lower_is_better\":" +
+                               ((p.flags & MG_FLAG_LOWER_BETTER) ? "true" : "false") + ",\"scores\":" + scores_json(i) + "}";
+                    }
+                    return out + "]}";
+                });
+    mcp.AddTool("self.game.start",
+                "Start a game on the unit's screen: memory (colour memory), reaction (reaction time) or whack (whack-a-mole). "
+                "It never starts in full quiet or during an update. A person stops it with a swipe down from the bottom edge "
+                "or by saying stop. Answers {ok} or {ok:false,error}.",
+                PropertyList({Property("name", kPropertyTypeString, std::string("memory"))}),
+                [](const PropertyList& properties) -> ReturnValue {
+                    const std::string name = properties["name"].value<std::string>();
+                    const char* why;
+                    {
+                        LvglLockGuard lock;
+                        why = maipai_games_start_locked(name.c_str(), "tool");
+                    }
+                    if (why[0] != '\0') {
+                        return error_json(why);
+                    }
+                    return std::string("{\"ok\":true}");
+                });
+    mcp.AddTool("self.game.stop", "Stop the game that is playing. Nothing is saved for a game that was stopped before its end. "
+                "Answers {ok, was}.",
+                std::vector<Property>{}, [](const PropertyList&) -> ReturnValue {
+                    bool was;
+                    {
+                        LvglLockGuard lock;
+                        was = maipai_games_stop_locked("tool");
+                    }
+                    return std::string("{\"ok\":true,\"was\":") + (was ? "true" : "false") + "}";
+                });
+    mcp.AddTool("self.game.scores", "The saved best scores of one game (best first, up to five). Answers {ok, game, lower_is_better, scores}.",
+                PropertyList({Property("name", kPropertyTypeString, std::string("memory"))}),
+                [](const PropertyList& properties) -> ReturnValue {
+                    const std::string name = properties["name"].value<std::string>();
+                    const int slot         = slot_by_name(name.c_str());
+                    mg_pack_t p;
+                    if (slot < 0 || !slot_pack(slot, &p)) {
+                        return error_json("That game is not on this unit. Ask for memory, reaction or whack.");
+                    }
+                    return std::string("{\"ok\":true,\"game\":\"") + p.id + "\",\"lower_is_better\":" +
+                           ((p.flags & MG_FLAG_LOWER_BETTER) ? "true" : "false") + ",\"scores\":" + scores_json(slot) + "}";
+                });
+#if CONFIG_MAIPAI_GAMES_BENCH
+    mcp.AddTool("self.game.bench_tap", "Bench only: tap the running game's screen at x, y (screen pixels) as a finger would. "
+                "Taps in the reserved screen edges do nothing, as for a finger.",
+                PropertyList({Property("x", kPropertyTypeInteger, 160, 0, 319), Property("y", kPropertyTypeInteger, 120, 0, 239)}),
+                [](const PropertyList& properties) -> ReturnValue {
+                    const int x = properties["x"].value<int>();
+                    const int y = properties["y"].value<int>();
+                    if (x < MG_EDGE_L || x >= MG_EDGE_R || y < MG_EDGE_T || y >= MG_EDGE_B) {
+                        return std::string("{\"ok\":true,\"edge\":true}");
+                    }
+                    LvglLockGuard lock;
+                    if (s_game == nullptr) {
+                        return error_json("No game is running.");
+                    }
+                    maipai_games_touch(x, y);
+                    return std::string("{\"ok\":true,\"edge\":false}");
+                });
+    mcp.AddTool("self.game.bench_request_stop", "Bench only: ask the running game to end the way the stop word does (no lock, "
+                "ends within 30 ms). Answers {ok, asked}.",
+                std::vector<Property>{}, [](const PropertyList&) -> ReturnValue {
+                    const bool asked = maipai_games_request_stop("stop");
+                    return std::string("{\"ok\":true,\"asked\":") + (asked ? "true" : "false") + "}";
+                });
+    mcp.AddTool("self.game.status", "Bench only: the player's state, counters and totals.", std::vector<Property>{},
+                [](const PropertyList&) -> ReturnValue {
+                    LvglLockGuard lock;
+                    char out[640];
+                    uint32_t internal_free = heap_caps_get_free_size(MALLOC_CAP_INTERNAL);
+                    if (s_game == nullptr) {
+                        snprintf(out, sizeof(out),
+                                 "{\"ok\":true,\"active\":false,\"tones\":%u,\"saves\":%u,\"internal_free\":%u,\"psram_free\":%u}",
+                                 static_cast<unsigned>(s_tones_total), static_cast<unsigned>(s_saves_total),
+                                 static_cast<unsigned>(internal_free), static_cast<unsigned>(heap_caps_get_free_size(MALLOC_CAP_SPIRAM)));
+                        return std::string(out);
+                    }
+                    const mg_run_t& r = s_game->run;
+                    char seq[2 * MG_SEQ_MAX + 4] = "";
+                    for (int i = 0; i < r.seq_len; i++) {
+                        snprintf(seq + strlen(seq), sizeof(seq) - strlen(seq), "%s%d", i > 0 ? "," : "", r.seq[i]);
+                    }
+                    snprintf(out, sizeof(out),
+                             "{\"ok\":true,\"active\":true,\"game\":\"%s\",\"state\":%d,\"ctr\":[%d,%d,%d,%d,%d,%d,%d,%d],"
+                             "\"seq\":[%s],\"seq_pos\":%d,\"steps\":%d,\"finished\":%s,\"tones\":%u,\"saves\":%u,"
+                             "\"internal_free\":%u,\"psram_free\":%u}",
+                             s_game->id, r.state, r.ctr[0], r.ctr[1], r.ctr[2], r.ctr[3], r.ctr[4], r.ctr[5], r.ctr[6], r.ctr[7],
+                             seq, r.seq_pos, r.steps, r.finished ? "true" : "false", static_cast<unsigned>(s_tones_total),
+                             static_cast<unsigned>(s_saves_total), static_cast<unsigned>(internal_free),
+                             static_cast<unsigned>(heap_caps_get_free_size(MALLOC_CAP_SPIRAM)));
+                    return std::string(out);
+                });
+    mcp.AddTool("self.game.bench_install", "Bench only: load one game pack from outside the image through the same checks an "
+                "outside pack must pass. The cable takes short lines, so send the pack as base64 in pieces of at most 300 "
+                "letters (done false), the last piece with done true. Answers {ok, id} or {ok:false, error}.",
+                PropertyList({Property("pack", kPropertyTypeString, std::string("")),
+                              Property("done", kPropertyTypeBoolean, true)}),
+                [](const PropertyList& properties) -> ReturnValue {
+                    static std::string pending;
+                    pending += properties["pack"].value<std::string>();
+                    if (!properties["done"].value<bool>()) {
+                        return std::string("{\"ok\":true,\"text\":") + std::to_string(pending.size()) + "}";
+                    }
+                    std::vector<uint8_t> bytes;
+                    const bool decoded = b64_decode(pending, &bytes);
+                    pending.clear();
+                    if (!decoded || bytes.empty()) {
+                        return error_json("The pack text is not base64. Send the pack file as base64.");
+                    }
+                    char id[12] = "";
+                    LvglLockGuard lock;
+                    const mg_err_t err = maipai_games_load_external(bytes.data(), bytes.size(), id, sizeof(id));
+                    if (err != MG_OK) {
+                        return error_json(mg_err_text(err, false));
+                    }
+                    return std::string("{\"ok\":true,\"id\":\"") + id + "\"}";
+                });
+#endif
+    ESP_LOGI(TAG, "games ready: %d on this unit", maipai_games_count());
+}
