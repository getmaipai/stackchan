+// ---- the tools ----
+
+namespace {
+
+std::string json_text(const char* s)
+{
+    std::string out;
+    for (; *s != '\0'; s++) {
+        if (*s == '"' || *s == '\\') {
+            out += '\\';
+        }
+        out += *s;
+    }
+    return out;
+}
+
+std::string error_json(const char* why)
+{
+    return std::string("{\"ok\":false,\"error\":\"") + json_text(why) + "\"}";
+}
+
+std::string scores_json(int slot)
+{
+    mg_pack_t p;
+    if (!slot_pack(slot, &p)) {
+        return "[]";
+    }
+    std::lock_guard<std::mutex> lock(s_mutex);
+    std::string out = "[";
+    bool first      = true;
+    for (int k = 0; k < MG_SCORES; k++) {
+        if (s_entries[slot].best[k] == 0) {
+            continue;
+        }
+        out += first ? "" : ",";
+        out += std::to_string(s_entries[slot].best[k]);
+        first = false;
+    }
+    return out + "]";
+}
+
+#if CONFIG_MAIPAI_GAMES_BENCH
+int b64_value(char c)
+{
+    if (c >= 'A' && c <= 'Z') return c - 'A';
+    if (c >= 'a' && c <= 'z') return c - 'a' + 26;
+    if (c >= '0' && c <= '9') return c - '0' + 52;
+    if (c == '+') return 62;
+    if (c == '/') return 63;
+    return -1;
+}
+
+bool b64_decode(const std::string& in, std::vector<uint8_t>* out)
+{
+    uint32_t acc = 0;
+    int bits     = 0;
+    for (char c : in) {
+        if (c == '=' || c == '\n' || c == '\r' || c == ' ') {
+            continue;
+        }
+        const int v = b64_value(c);
+        if (v < 0) {
+            return false;
+        }
+        acc = (acc << 6) | static_cast<uint32_t>(v);
+        bits += 6;
+        if (bits >= 8) {
+            bits -= 8;
+            out->push_back(static_cast<uint8_t>((acc >> bits) & 0xFF));
+        }
+    }
+    return true;
+}
+#endif
+
+// The signature of a pack from outside the image: plain Ed25519 over the pack and its checksum, made with the update
+// key (patch 155), checked with the same code that checks firmware updates.
+bool signature_ok(const mg_pack_t& p, const uint8_t* pk)
+{
+    size_t signed_len        = 0;
+    const uint8_t* sig       = mg_signature(&p, &signed_len);
+    if (sig == nullptr || psa_crypto_init() != PSA_SUCCESS) {
+        return false;
+    }
+    psa_hash_operation_t op = psa_hash_operation_init();
+    uint8_t h[64];
+    size_t n = 0;
+    if (psa_hash_setup(&op, PSA_ALG_SHA_512) != PSA_SUCCESS) {
+        return false;
+    }
+    psa_hash_update(&op, sig, 32);  // R
+    psa_hash_update(&op, pk, 32);   // the public key
+    psa_hash_update(&op, p.b, signed_len);
+    if (psa_hash_finish(&op, h, sizeof(h), &n) != PSA_SUCCESS || n != 64) {
+        psa_hash_abort(&op);
+        return false;
+    }
+    return Ed25519VerifyDigest(sig, pk, h);
+}
+
+}  // namespace
+
+// Loads one pack from outside the image into the single outside slot. The checks: the file (size, checksum, tables), the
+// signing rule (mg_admit), then the copy. Returns MG_OK or the reason. Not used by a shipped path yet: the host push is the
+// next step; the bench tool below calls it so the whole path can be exercised.
+namespace {
+[[maybe_unused]] mg_err_t maipai_games_load_external(const uint8_t* data, size_t len, char* id_out, size_t id_cap)
+{
+    mg_pack_t p;
+    mg_err_t err = mg_parse(data, len, &p);
+    if (err != MG_OK) {
+        return err;
+    }
+    uint8_t pk[32];
+    const bool key = UpdateTrustedKey(pk);
+    const bool sig = p.has_sig && key && signature_ok(p, pk);
+    err            = mg_admit(MG_SRC_EXTERNAL, p.has_sig, sig, key, bench_build());
+    if (err != MG_OK) {
+        return err;
+    }
+    for (int i = 0; i < kBuiltIns; i++) {
+        mg_pack_t b;
+        if (slot_pack(i, &b) && strcmp(b.id, p.id) == 0) {
+            return MG_E_TAKEN;  // the name is a built-in game's
+        }
+    }
+    if (s_game != nullptr) {
+        return MG_E_BUSY;  // never replace a pack while a game may be using the old one
+    }
+    uint8_t* copy = static_cast<uint8_t*>(heap_caps_malloc(len, MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT));
+    if (copy == nullptr) {
+        return MG_E_MEMORY;
+    }
+    memcpy(copy, data, len);
+    heap_caps_free(s_ext);
+    s_ext     = copy;
+    s_ext_len = len;
+    {
+        std::lock_guard<std::mutex> lock(s_mutex);
+        memset(&s_entries[kBuiltIns], 0, sizeof(s_entries[kBuiltIns]));
+        snprintf(s_entries[kBuiltIns].id, sizeof(s_entries[kBuiltIns].id), "%s", p.id);
+    }
+    snprintf(id_out, id_cap, "%s", p.id);
+    return MG_OK;
+}
+}  // namespace
