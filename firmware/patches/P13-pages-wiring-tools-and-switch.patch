+
+static const char* TAG = "MAIPAI-PAGES";
+
+// Defined in board/stackchan_display.cc: the old edge swipes and the settings panel, kept as they were.
+extern "C" {
+bool maipai_display_ready(void);
+bool maipai_display_overlay_open(void);
+void maipai_display_volume_step(int delta);
+void maipai_display_open_quick(void);
+void maipai_display_stop_swipe(void);
+void maipai_display_face_toggle(int action);  // MTC_ACTION_MUTE (1) or MTC_ACTION_QUIET (3)
+}
+extern bool maipai_dance_play(const char* name);
+
+namespace {
+
+constexpr const char* kKeyCfg   = "pages_cfg";    // the one saved text line (maipai_pages_core.h), in the preferences namespace
+constexpr const char* kKeyTiles = "page_tiles";   // the host fed tiles, saved at most every ten minutes
+
+std::mutex s_mu;             // a leaf lock: the tiles, which the tool task writes and the LVGL task reads
+mpg_tiles_t s_tiles;
+uint32_t s_tiles_mono_s = 0; // when they last came from the host, seconds since boot (0: loaded from flash)
+uint32_t s_tiles_unix   = 0; // the wall clock when they were saved or last received (0: unknown)
+uint32_t s_tiles_saved_s = 0;
+bool s_tiles_dirty      = false;
+mpg_tiles_t s_view;          // a copy for the page to read without the lock
+std::atomic<bool> s_last_gesture{false};
+std::atomic<bool> s_hooked{false};
+lv_indev_t* s_indev = nullptr;
+
+uint32_t mono_s() { return static_cast<uint32_t>(esp_timer_get_time() / 1000000); }
+uint32_t unix_now()
+{
+    const time_t t = time(nullptr);
+    return t >= 1704067200 ? static_cast<uint32_t>(t) : 0;
+}
+
+// ---- saved choice ----
+bool load_cfg(mpg_cfg_t* cfg)
+{
+    nvs_handle_t h;
+    char text[MPG_TEXT_MAX + 1] = "";
+    if (nvs_open(MP_NAMESPACE, NVS_READONLY, &h) == ESP_OK) {
+        size_t n = sizeof(text);
+        if (nvs_get_str(h, kKeyCfg, text, &n) != ESP_OK) {
+            text[0] = '\0';
+        }
+        nvs_close(h);
+    }
+    return mpg_cfg_from_text(cfg, text[0] != '\0' ? text : nullptr) == 1;
+}
+
+bool save_cfg(const mpg_cfg_t& cfg)
+{
+    char text[MPG_TEXT_MAX + 1];
+    if (mpg_cfg_to_text(&cfg, text, sizeof(text)) < 0) {
+        return false;
+    }
+    nvs_handle_t h;
+    if (nvs_open(MP_NAMESPACE, NVS_READWRITE, &h) != ESP_OK) {
+        return false;
+    }
+    char old[MPG_TEXT_MAX + 1] = "";
+    size_t n = sizeof(old);
+    const bool same = nvs_get_str(h, kKeyCfg, old, &n) == ESP_OK && strcmp(old, text) == 0;  // flash is touched only for a change
+    esp_err_t err = ESP_OK;
+    if (!same) {
+        err = nvs_set_str(h, kKeyCfg, text);
+        if (err == ESP_OK) {
+            err = nvs_commit(h);
+        }
+    }
+    nvs_close(h);
+    return err == ESP_OK;
+}
+
+#pragma pack(push, 1)
+struct TilesBlob {
+    uint8_t version;
+    uint8_t n;
+    uint32_t unix_s;
+    mpg_tile_t t[MPG_TILES_MAX];
+};
+#pragma pack(pop)
+
+void load_tiles()
+{
+    nvs_handle_t h;
+    if (nvs_open(MP_NAMESPACE, NVS_READONLY, &h) != ESP_OK) {
+        return;
+    }
+    TilesBlob b;
+    size_t n = sizeof(b);
+    if (nvs_get_blob(h, kKeyTiles, &b, &n) == ESP_OK && n == sizeof(b) && b.version == 1 && b.n <= MPG_TILES_MAX) {
+        std::lock_guard<std::mutex> lock(s_mu);
+        mpg_tiles_clear(&s_tiles);
+        for (int i = 0; i < b.n; i++) {
+            if (b.t[i].icon < MPG_I_COUNT) {
+                mpg_tiles_add(&s_tiles, MPG_ICON_NAMES[b.t[i].icon], b.t[i].label, b.t[i].value);  // cleaned again on the way in
+            }
+        }
+        s_tiles_unix = b.unix_s;
+    }
+    nvs_close(h);
+}
+
+void save_tiles_locked()
+{
+    TilesBlob b;
+    memset(&b, 0, sizeof(b));
+    b.version = 1;
+    b.n       = s_tiles.n;
+    b.unix_s  = s_tiles_unix;
+    memcpy(b.t, s_tiles.t, sizeof(b.t));
+    nvs_handle_t h;
+    if (nvs_open(MP_NAMESPACE, NVS_READWRITE, &h) == ESP_OK) {
+        nvs_set_blob(h, kKeyTiles, &b, sizeof(b));
+        nvs_commit(h);
+        nvs_close(h);
+    }
+    s_tiles_dirty   = false;
+    s_tiles_saved_s = mono_s();
+}
+
+// ---- what the pages read and do ----
+class UnitHost : public MaipaiPagesHost {
+public:
+    uint32_t now_ms() override { return static_cast<uint32_t>(esp_timer_get_time() / 1000); }
+    bool local_time(struct tm* t) override
+    {
+        const time_t now = time(nullptr);
+        if (now < 1704067200) {
+            return false;
+        }
+        localtime_r(&now, t);
+        return true;
+    }
+    bool night() override { return maipai_face_is_night(); }
+    bool clock24() override { return maipai_face_config().clock24 != 0; }
+    bool clock_ring() override { return maipai_face_config().clock_style != 0; }
+    bool spanish() override { return maipai_face_config().lang == MF_LANG_ES; }
+    bool quiet() override { return (maipai_privacy_bits() & kPrivQuiet) != 0; }
+    bool muted() override { return (maipai_privacy_bits() & kPrivMute) != 0; }
+    bool ringing() override { return maipai_timers_ringing(); }
+    bool game_running() override { return maipai_games_active(); }
+
+    int timers(MaipaiPageTimer* out, int max) override
+    {
+#if CONFIG_MAIPAI_FACE_TIMERS
+        maipai_timer_view_t v[MPG_TIMER_ROWS];
+        const int n = maipai_timers_view(v, max < MPG_TIMER_ROWS ? max : MPG_TIMER_ROWS);
+        const int64_t now = esp_timer_get_time() / 1000;
+        for (int i = 0; i < n; i++) {
+            out[i].id     = v[i].id;
+            out[i].left_s = static_cast<int32_t>((v[i].due_ms - now + 500) / 1000);
+            snprintf(out[i].label, sizeof(out[i].label), "%s", v[i].label);
+        }
+        return n;
+#else
+        (void)out; (void)max;
+        return 0;
+#endif
+    }
+    // The timer store has its own lock and the tick task its own pace: the change goes to the main task, never inside a touch.
+    void timer_cancel(uint32_t id) override
+    {
+        Application::GetInstance().Schedule([id]() { maipai_timers_cancel(static_cast<int>(id)); });
+    }
+    void timer_add(int seconds, const char*) override
+    {
+        Application::GetInstance().Schedule([seconds]() { maipai_timers_add_timer(seconds, "", (maipai_privacy_bits() & kPrivMute) != 0); });
+    }
+
+    int game_count() override { return maipai_games_count(); }
+    const char* game_title(int i) override { return maipai_games_title(i, spanish()); }
+    int game_best(int i) override { return maipai_games_best(i); }
+    const char* game_start(int i) override
+    {
+        const char* why = maipai_games_start_locked(maipai_games_id(i), "touch");
+        if (why == nullptr || why[0] == '\0') {
+            maipai_pages_show(-1);  // the game draws on the same layer: the page steps aside
+            return "";
+        }
+        return why;
+    }
+
+    void action(int a) override
+    {
+        switch (a) {
+            case MPG_A_FIND: Application::GetInstance().Schedule([]() { maipai_sounds_find_chirp(); }); break;
+            case MPG_A_BEEP: Application::GetInstance().Schedule([]() { maipai_sounds_play("popup"); }); break;
+            case MPG_A_DANCE: Application::GetInstance().Schedule([]() { maipai_dance_play("happy"); }); break;
+            case MPG_A_GAME:
+                if (maipai_games_count() > 0) {
+                    game_start(0);
+                }
+                break;
+            default:  // hello: a happy face, the words and a cheerful sound; no host needed
+                Application::GetInstance().Schedule([]() {
+                    hal_bridge::react_face("happy", 1800);
+                    hal_bridge::notice("Hi!", 1800);
+                    maipai_sounds_play("success");
+                });
+                break;
+        }
+    }
+
+    const mpg_tiles_t* tiles(uint32_t* age) override
+    {
+        {
+            std::lock_guard<std::mutex> lock(s_mu);
+            s_view = s_tiles;
+            if (s_tiles_mono_s != 0) {
+                *age = mono_s() - s_tiles_mono_s;
+            } else if (s_tiles_unix != 0 && unix_now() != 0) {
+                *age = unix_now() - s_tiles_unix;  // loaded from flash: the saved time against the clock now
+            } else {
+                *age = 86400;  // unknown: shown as old
+            }
+        }
+        return s_view.n > 0 ? &s_view : nullptr;
+    }
+
+    int frame_count() override { return maipai_picface_frame_total(); }
+    uint8_t* frame_alloc() override
+    {
+        return static_cast<uint8_t*>(heap_caps_malloc(320 * 240 * 2, MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT));
+    }
+    void frame_free(uint8_t* p) override
+    {
+        maipai_picface_frame_cancel();
+        heap_caps_free(p);
+    }
+    bool frame_request(int i, uint8_t* dst) override { return maipai_picface_frame_request(i, dst); }
+    int frame_poll() override { return maipai_picface_frame_poll(); }
+
+    int volume() override
+    {
+        auto* codec = Board::GetInstance().GetAudioCodec();
+        return codec != nullptr ? codec->output_volume() : 70;
+    }
+    void set_volume(int v) override
+    {
+        auto* codec = Board::GetInstance().GetAudioCodec();
+        if (codec != nullptr) {
+            codec->SetOutputVolume(v);
+        }
+    }
+    int brightness() override
+    {
+        auto* b = Board::GetInstance().GetBacklight();
+        return b != nullptr ? b->brightness() : 80;
+    }
+    void set_brightness(int v) override
+    {
+        auto* b = Board::GetInstance().GetBacklight();
+        if (b != nullptr) {
+            b->SetBrightness(v, true);
+        }
+    }
+    bool light_on() override { return maipai_pref(MP_LISTEN_LIGHT) != 0; }
+    void toggle_light() override { maipai_pref_set(MP_LISTEN_LIGHT, light_on() ? 0 : 2); }
+    void toggle_mute() override { maipai_display_face_toggle(1); }
+    void toggle_quiet() override { maipai_display_face_toggle(3); }
+
+    int wifi_bars() override
+    {
+        wifi_ap_record_t ap;
+        if (esp_wifi_sta_get_ap_info(&ap) != ESP_OK) {
+            return -1;
+        }
+        return ap.rssi > -55 ? 4 : (ap.rssi > -65 ? 3 : (ap.rssi > -75 ? 2 : 1));
+    }
+    int battery_pct(bool* charging) override
+    {
+        int level = 0;
+        bool ch = false, cable = false;
+        *charging = false;
+        if (!hal_bridge::board_battery_state(&level, &ch, &cable)) {
+            return -1;
+        }
+        *charging = ch;
+        return level;
+    }
+    int tailnet() override
+    {
+        if (!maipai_tailnet_compiled()) {
+            return -1;
+        }
+        return maipai_tailnet_ready() ? 2 : (maipai_tailnet_key_saved() ? 1 : 0);
+    }
+    const char* address() override
+    {
+        // Read from flash at most once a minute: the sheet asks every 250 ms while it is open.
+        static char line[64];
+        static uint32_t read_ms = 0;
+        const uint32_t now = now_ms();
+        if (read_ms != 0 && now - read_ms < 60000) {
+            return line;
+        }
+        read_ms = now == 0 ? 1 : now;
+        line[0] = '\0';
+        Settings settings("websocket", false);
+        const std::string url = settings.GetString("url");
+        size_t a = url.find("://");
+        a        = a == std::string::npos ? 0 : a + 3;
+        size_t b = url.find('/', a);
+        const std::string host = url.substr(a, b == std::string::npos ? std::string::npos : b - a);
+        if (!host.empty()) {
+            snprintf(line, sizeof(line), "%s %s", spanish() ? "Ajustes:" : "Settings:", host.c_str());
+        }
+        return line;
+    }
+    void open_more() override { maipai_display_open_quick(); }
+    void stop_all() override { maipai_display_stop_swipe(); }
+    void volume_step(int d) override { maipai_display_volume_step(d); }
+};
+
+UnitHost s_host;
+
+// ---- the touch hook: every finger, whichever object it landed on ----
+void on_indev(lv_event_t* e)
+{
+    if (!maipai_display_ready()) {
+        return;
+    }
+    lv_indev_t* in = static_cast<lv_indev_t*>(lv_event_get_target(e));
+    lv_point_t p   = {0, 0};
+    lv_indev_get_point(in, &p);
+    if (lv_event_get_code(e) == LV_EVENT_PRESSED) {
+        s_last_gesture.store(false);
+        // quick settings and the screens opened from it own their touches: this finger changes no page
+        maipai_pages_touch_down(p.x, p.y, (maipai_games_active() ? MGS_F_GAME : 0) | (maipai_display_overlay_open() ? MGS_F_WOKE : 0) |
+                                              (maipai_screen_peek_wake_touch() ? MGS_F_WOKE : 0));
+    } else if (lv_event_get_code(e) == LV_EVENT_RELEASED) {
+        s_last_gesture.store(maipai_pages_touch_up(p.x, p.y));
+    }
+}
+
+std::string names_json(const uint8_t* ids, int n, const char* const* names)
+{
+    std::string out = "[";
+    for (int i = 0; i < n; i++) {
+        out += std::string(i ? ",\"" : "\"") + names[ids[i]] + "\"";
+    }
+    return out + "]";
+}
+
+std::string cfg_json(const mpg_cfg_t& c)
+{
+    char head[96];
+    std::string out = "{\"ok\":true,\"left\":" + names_json(c.left, c.n_left, MPG_PAGE_NAMES) + ",\"right\":" + names_json(c.right, c.n_right, MPG_PAGE_NAMES);
+    snprintf(head, sizeof(head), ",\"sheet_s\":%u,\"idle_s\":%u,\"actions\":", static_cast<unsigned>(c.sheet_s), static_cast<unsigned>(c.idle_s));
+    out += head + names_json(c.actions, c.n_actions, MPG_ACTION_NAMES) + ",\"sheet_items\":" + names_json(c.items, c.n_items, MPG_SHEET_NAMES) + "}";
+    return out;
+}
+
+std::string error_json(const std::string& why)
+{
+    std::string out = "{\"ok\":false,\"error\":\"";
+    for (char ch : why) {
+        if (ch == '"' || ch == '\\') out += '\\';
+        out += ch;
+    }
+    return out + "\"}";
+}
+
+// Reads a JSON array of names into ids with `by`; false (and the field name in *bad) for a wrong type or an unknown name.
+bool read_names(const cJSON* arr, int (*by)(const char*), int* out, int max, int* n)
+{
+    if (!cJSON_IsArray(arr)) {
+        return false;
+    }
+    *n = 0;
+    const cJSON* it = nullptr;
+    cJSON_ArrayForEach(it, arr)
+    {
+        if (!cJSON_IsString(it) || *n >= max) {
+            return false;
+        }
+        const int v = by(it->valuestring);
+        if (v < 0) {
+            return false;
+        }
+        out[(*n)++] = v;
+    }
+    return true;
+}
+
+}  // namespace
+
+bool maipai_pages_last_touch_was_gesture() { return s_last_gesture.load(); }
+
+void maipai_pages_unit_attach(lv_color_t (*fg)())
+{
+    maipai_pages_attach(&s_host, fg);
+    mpg_cfg_t cfg;
+    load_cfg(&cfg);
+    maipai_pages_set_config(cfg);
+    load_tiles();
+    if (!s_hooked.exchange(true)) {
+        for (lv_indev_t* in = lv_indev_get_next(nullptr); in != nullptr; in = lv_indev_get_next(in)) {
+            if (lv_indev_get_type(in) == LV_INDEV_TYPE_POINTER) {
+                lv_indev_add_event_cb(in, on_indev, LV_EVENT_PRESSED, nullptr);
+                lv_indev_add_event_cb(in, on_indev, LV_EVENT_RELEASED, nullptr);
+                s_indev = in;
+            }
+        }
+        ESP_LOGI(TAG, "pages ready: %d left, %d right, touch %s", cfg.n_left, cfg.n_right, s_indev != nullptr ? "hooked" : "NOT found");
+    }
+}
+
+void maipai_pages_unit_register_tools()
+{
