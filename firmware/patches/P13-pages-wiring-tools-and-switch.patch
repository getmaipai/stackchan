+/*
+ * SPDX-License-Identifier: MIT
+ *
+ * Swipe pages and the control sheet, device side (patch P13). See maipai_pages_unit.h.
+ */
+#include <sdkconfig.h>
+#include "maipai_pages_unit.h"
+#if CONFIG_MAIPAI_PAGES
+#include "maipai_pages.h"
+#include "maipai_face.h"
+#include "maipai_fx.h"
+#include "maipai_games.h"
