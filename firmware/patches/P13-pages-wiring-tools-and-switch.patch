+#include <sdkconfig.h>
+
+#if CONFIG_MAIPAI_PAGES
+#include <lvgl.h>
+// Loads the saved choice (or the defaults), hooks the touch input and gives the pages the face color. Call once from the display
+// set-up, with the LVGL lock held, after the face exists. Creates no screen objects.
+void maipai_pages_unit_attach(lv_color_t (*fg)());
