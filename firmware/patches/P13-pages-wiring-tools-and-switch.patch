diff --git a/firmware/main/hal/maipai_picface.cc b/firmware/main/hal/maipai_picface.cc
--- a/firmware/main/hal/maipai_picface.cc
+++ b/firmware/main/hal/maipai_picface.cc
@@ -769,6 +769,87 @@ bool maipai_picface_showing()
     return s_showing.load();
 }
 
+// Patch P13: the picture frame page walks the pack's frames one at a time, on a decode task of its own (the face's task is busy with
+// the expression changes). The task is made the first time a frame is asked for and kept: its 20 KB stack is in PSRAM, idle it
+// holds a control block of about 400 bytes of internal RAM.
+namespace {
+TaskHandle_t s_fr_task = nullptr;
+std::atomic<uint8_t*> s_fr_dst{nullptr};
+std::atomic<int> s_fr_idx{-1};
+std::atomic<int> s_fr_state{-1};  // 0 working, 1 ready, -1 failed or none
+std::atomic<uint32_t> s_fr_gen{0};
+
+void frame_task(void*)
+{
+    for (;;) {
+        ulTaskNotifyTake(pdTRUE, portMAX_DELAY);
+        uint8_t* dst   = s_fr_dst.load();
+        const int idx  = s_fr_idx.load();
+        const uint32_t gen = s_fr_gen.load();
+        bool ok = false;
+        if (dst != nullptr && s_mu != nullptr) {
+            xSemaphoreTake(s_mu, portMAX_DELAY);
+            if (s_pack != nullptr && gen == s_fr_gen.load()) {
+                int k = idx;
+                for (int s = 0; s < PF_SLOTS && !ok; s++) {
+                    if (k < s_pack->plan.frames[s]) {
+                        const Frame& f = s_pack->fr[s][k];
+                        ok             = f.done && f.data != nullptr && decode_frame(f, dst);
+                        break;
+                    }
+                    k -= s_pack->plan.frames[s];
+                }
+            }
+            xSemaphoreGive(s_mu);
+        }
+        if (gen == s_fr_gen.load()) {
+            s_fr_state.store(ok ? 1 : -1);
+        }
+    }
+}
+}  // namespace
+
+int maipai_picface_frame_total()
+{
+    if (s_mu == nullptr || xSemaphoreTake(s_mu, pdMS_TO_TICKS(100)) != pdTRUE) {
+        return 0;
+    }
+    const int n = s_pack != nullptr ? total_frames(s_pack->plan) : 0;
+    xSemaphoreGive(s_mu);
+    return n;
+}
+
+bool maipai_picface_frame_request(int index, uint8_t* dst)
+{
+    if (dst == nullptr || index < 0 || index >= maipai_picface_frame_total() || s_fr_state.load() == 0) {
+        return false;
+    }
+    if (s_fr_task == nullptr &&
+        xTaskCreatePinnedToCoreWithCaps(frame_task, "picframe", 20 * 1024, nullptr, 2, &s_fr_task, 0, MALLOC_CAP_SPIRAM) != pdPASS) {
+        s_fr_task = nullptr;
+        return false;
+    }
+    s_fr_idx.store(index);
+    s_fr_dst.store(dst);
+    s_fr_state.store(0);
+    xTaskNotifyGive(s_fr_task);
+    return true;
+}
+
+int maipai_picface_frame_poll() { return s_fr_state.load(); }
+
+// The page closes: a decode that is still running must not write into the buffer after it is freed. This waits for the task (it is
+// at most one decode, about 40 ms) and bumps the generation so a late answer is dropped.
+void maipai_picface_frame_cancel()
+{
+    s_fr_gen.fetch_add(1);
+    s_fr_dst.store(nullptr);
+    for (int i = 0; i < 50 && s_fr_state.load() == 0; i++) {
+        vTaskDelay(pdMS_TO_TICKS(10));
+    }
+    s_fr_state.store(-1);
+}
+
 void maipai_picface_register_tools()
 {
     s_mu        = xSemaphoreCreateMutex();
