+/* A heart of s pixels across, filled with an outline. */
+static inline void mo_draw_heart(const mc_t* c, int cx, int cy, int s, uint16_t fill, uint16_t edge, uint16_t shine, unsigned a)
+{
+    const float u = (float)s / 2.3f;
