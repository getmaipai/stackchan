+/* Starts an element or a preset by id (mo_id). A preset replaces everything; a single overlay replaces what runs in its
+ * layer, and ends a preset that was running (its other layers would be left half a picture). Returns the layers used as a
+ * bit mask, 0 when the id is not known. */
+static inline int mo_set(mo_layer_t* layers, int id, int intensity, uint32_t seconds, uint32_t seed)
+{
+    const int pct0 = layers[0].pct ? layers[0].pct : 100;
+    if (mo_is_preset(id)) {
+        const int pi = id - MO_PRESET_BASE;
+        int mask     = 0;
+        for (int l = 0; l < MO_LAYERS; l++) mo_clear(&layers[l]);
+        for (int l = 0; l < MO_LAYERS; l++) {
+            const int part = MOP_PARTS[pi][l][0];
+            if (part == 0) continue;
+            int lvl = MOP_PARTS[pi][l][1] + (intensity - 2);
+            lvl     = lvl < 1 ? 1 : (lvl > 3 ? 3 : lvl);
+            mo_start(&layers[l], part, lvl, seconds, seed * (uint32_t)(l * 2 + 3) + (uint32_t)l * 7919u);
+            layers[l].combo = 1;
+            layers[l].pct   = (uint8_t)pct0;
+            mask |= 1 << l;
+        }
+        return mask;
+    }
+    if (id <= MO_NONE || id >= MO_COUNT) {
+        return 0;
+    }
+    for (int l = 0; l < MO_LAYERS; l++) {
+        if (layers[l].combo) {
+            for (int k = 0; k < MO_LAYERS; k++) {
+                if (layers[k].combo) mo_clear(&layers[k]);
+            }
+            break;
+        }
+    }
+    const int ly = mo_layer_of(id);
+    mo_start(&layers[ly], id, intensity, seconds, seed);
+    layers[ly].pct = (uint8_t)pct0;
+    return 1 << ly;
+}
