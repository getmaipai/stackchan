+/* ---------------------------------------------------------------- drawing: the shapes */
+
+/* A Z: S pixels square, bars S/4 thick, a diagonal between them. fill and edge colors; o is the outline width in pixels. */
+static inline int mo_z_in(int xx, int yy, int s, int t, int hw, int e)
+{
+    if (xx < -e || xx >= s + e || yy < -e || yy >= s + e) {
+        return 0;
+    }
+    if (yy < t + e || yy >= s - t - e) {
+        return 1; /* the top and the bottom bar */
+    }
+    const int xd = (s - 1) - yy; /* the diagonal's center column at this row */
+    return mo_abs(xx - xd) <= hw + (e * 3) / 2;
+}
+
+/* s is the whole glyph, outline included: the filled Z is s minus two outlines (2 px, 3 px at 40 and more) square. */
+static inline void mo_draw_z(const mc_t* c, int cx, int cy, int s, uint16_t fill, uint16_t edge, unsigned a)
+{
+    const int o = s >= 40 ? 3 : 2, si = s - 2 * o, t = si / 4, hw = (t * 2) / 3 + 1;
+    const int x0 = cx - s / 2 + o, y0 = cy - s / 2 + o;
+    for (int y = y0 - o; y < y0 + si + o; y++) {
+        if (y < c->y1 || y > c->y2) continue;
+        for (int x = x0 - o; x < x0 + si + o; x++) {
+            if (x < c->x1 || x > c->x2) continue;
+            if (mo_z_in(x - x0, y - y0, si, t, hw, 0)) mc_put(c, x, y, fill, a);
+            else if (mo_z_in(x - x0, y - y0, si, t, hw, o)) mc_put(c, x, y, edge, a);
+        }
+    }
+}
 
