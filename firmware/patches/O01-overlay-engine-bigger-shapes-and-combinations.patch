+/* The flash of a thunder layer: the sky goes light for three ticks. A wash over everything that is not a bright face part
+ * (the clouds light up too), after every layer has drawn. */
+static inline void mo_draw_flash(const mo_layer_t* L, const mc_t* cv)
+{
+    if (L->id != MO_THUNDER || L->s1 <= 0) {
+        return;
+    }
+    const unsigned peak = L->s1 >= 3 ? 150u : (L->s1 == 2 ? 100u : 50u);
+    for (int y = mo_max(cv->y1, cv->ztop); y <= cv->y2 && y < 130 && (cv->zbot == 0 || y < cv->zbot); y++) {
+        const unsigned a = peak * (unsigned)(130 - y) / 130u + 20u * (unsigned)(L->s1);
+        for (int x = cv->x1; x <= cv->x2; x++) {
+            uint16_t* p = cv->px + (size_t)(y - cv->y1) * (size_t)cv->w + (size_t)(x - cv->x1);
+            if (mfx_luma5(*p) <= 27 && (cv->np == 0 || !mc_protected(cv, x, y))) {
+                *p = mfx_mix(*p, moc(MOC_WASH), a);
             }
         }
     }
 }
 
+/* Draws every layer, front to back, then the thunder flash. */
+static inline void mo_draw_all(const mo_layer_t* layers, mc_t* cv)
+{
+    for (int l = MO_LAYERS - 1; l >= 0; l--) {
+        mo_draw(&layers[l], cv);
+    }
+    for (int l = 0; l < MO_LAYERS; l++) {
+        mo_draw_flash(&layers[l], cv);
+    }
+}
+
+/* ---------------------------------------------------------------- the layers together */
+
+static inline int mo_any(const mo_layer_t* layers)
+{
+    for (int l = 0; l < MO_LAYERS; l++) {
+        if (layers[l].id != MO_NONE) return 1;
+    }
+    return 0;
+}
+
+static inline void mo_clear_all(mo_layer_t* layers)
+{
+    for (int l = 0; l < MO_LAYERS; l++) {
+        if (layers[l].id != MO_NONE) mo_clear(&layers[l]);
+    }
+}
+
+static inline void mo_stop_all(mo_layer_t* layers)
+{
+    for (int l = 0; l < MO_LAYERS; l++) mo_stop(&layers[l]);
+}
