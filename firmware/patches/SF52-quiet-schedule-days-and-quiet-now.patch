--- a/firmware/main/hal/maipai_sounds_core.h
+++ b/firmware/main/hal/maipai_sounds_core.h
@@ -70,6 +70,8 @@ typedef struct {
     uint8_t dark;        /* the host's verdict "it is night now" (the sensor); trusted only while the host is up */
     int16_t quiet_from;  /* quiet hours, minutes of the local day; -1 for none */
     int16_t quiet_to;
+    uint8_t quiet_days;  /* patch SF52: the days the schedule applies to, bit 0 Sunday to bit 6 Saturday (default all seven) */
+    uint8_t quiet_now;   /* patch SF52: "Quiet now": quiet until it is turned off, whatever the schedule says */
 } ms_policy_t;
 
 static inline void ms_policy_default(ms_policy_t* p)
@@ -80,6 +82,8 @@ static inline void ms_policy_default(ms_policy_t* p)
     p->dark = 0;
     p->quiet_from = -1;
     p->quiet_to = -1;
+    p->quiet_days = 0x7f;
+    p->quiet_now = 0;
 }
 
 /* Is minute-of-day `m` inside [from, to)? A window that wraps midnight (22:00 to 07:00) works; from == to is empty. */
@@ -94,6 +98,23 @@ static inline int ms_in_window(int from, int to, int m)
     return m >= from || m < to;
 }
 
+/* Patch SF52: the schedule with days, like a phone's quiet time. `weekday` is 0 Sunday to 6 Saturday, -1 while the clock is not set. A window that wraps midnight
+ * belongs to the day it starts on: 22:00 to 07:00 on Friday is quiet until 07:00 on Saturday. With no days set the schedule never applies. */
+static inline int ms_in_schedule(const ms_policy_t* p, int minute, int weekday)
+{
+    if (!ms_in_window(p->quiet_from, p->quiet_to, minute)) return 0;
+    if (weekday < 0 || weekday > 6) return (p->quiet_days & 0x7f) != 0; /* no calendar: the days cannot be told: any selected day counts */
+    int start_day = weekday;
+    if (p->quiet_from > p->quiet_to && minute < p->quiet_to) start_day = (weekday + 6) % 7; /* after midnight: the window began yesterday */
+    return (p->quiet_days >> start_day) & 1;
+}
+
+/* Quiet now for sounds: the "Quiet now" switch, the schedule, or the host's dark verdict while the host is up. */
+static inline int ms_is_night_ex(const ms_policy_t* p, int minute, int weekday, int host_up)
+{
+    return p->quiet_now || ms_in_schedule(p, minute, weekday) || (p->dark && host_up);
+}
+
 /* Is it night for sound purposes? `minute` is the unit's local minute of the day, -1 while its clock is not set. */
 static inline int ms_is_night(const ms_policy_t* p, int minute, int host_up)
 {
diff --git a/firmware/main/hal/maipai_sounds.cc b/firmware/main/hal/maipai_sounds.cc
--- a/firmware/main/hal/maipai_sounds.cc
+++ b/firmware/main/hal/maipai_sounds.cc
