 }
 
+// Patch SF52: the unit's local weekday, 0 Sunday to 6 Saturday, or -1 while its clock has never been set.
+int weekday_now()
+{
+    time_t t = time(nullptr);
+    if (t < 1700000000) {
+        return -1;
+    }
+    struct tm tm_local = {};
+    localtime_r(&t, &tm_local);
+    return tm_local.tm_wday;
+}
