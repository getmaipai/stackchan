+/*
+ * SPDX-License-Identifier: MIT
+ *
+ * The unit's sound policy and the built-in sounds it may play (patch 116, device side).
+ */
+#pragma once
+
+// Registers self.audio.play_sound, self.audio.set_sound_policy and self.audio.sound_info.
+void maipai_sounds_register_tools();
