--- /dev/null
+++ b/firmware/main/hal/maipai_heal_core.h
@@ -0,0 +1,50 @@
+/*
+ * SPDX-License-Identifier: MIT
+ *
+ * The self-restart guard's allowance (patch R04): the pure rule, no ESP-IDF, so a host compiler can test it
+ * (host/tests/firmware/heal_core_test.c).
+ *
+ * Patch R02 refused every self-chosen restart after the third in an hour and asked once per freeze, so a unit
+ * whose main loop froze a fourth time stayed frozen until the window ended or someone reset it by hand. A frozen
+ * unit is worse than a restarting one, so the refusal became a back-off: the first three restarts in a window go
+ * at once; after that a restart is allowed only once the unit has been running for a growing time since its last
+ * restart (5, 10, 20 minutes, then 30 minutes at most). A fault that comes back at once is therefore held back,
+ * never into a reboot loop, and a freeze that comes back after a long run is always cleared.
+ */
+#ifndef MAIPAI_HEAL_CORE_H
+#define MAIPAI_HEAL_CORE_H
+
+#define MHC_FREE_PER_WINDOW 3   /* restarts that go at once in a window */
+#define MHC_WINDOW_S 3600       /* a window ends after this many seconds of running */
+#define MHC_BACKOFF_BASE_S 300  /* the wait after the free ones are used */
+#define MHC_BACKOFF_MAX_S 1800
+
+/* Seconds the unit must have run since its last restart before another is allowed, for `count` restarts counted
+ * in this window. Zero while the free restarts last. */
+static inline int mhc_backoff_s(int count)
+{
+    if (count < MHC_FREE_PER_WINDOW) {
+        return 0;
+    }
+    int over = count - MHC_FREE_PER_WINDOW;
+    if (over > 3) {
+        over = 3;
+    }
+    int wait = MHC_BACKOFF_BASE_S << over;
+    return wait > MHC_BACKOFF_MAX_S ? MHC_BACKOFF_MAX_S : wait;
+}
+
+/* May a self-chosen restart go now? `uptime_s` is how long the unit has run since it last started. */
+static inline int mhc_allow(int count, int uptime_s)
+{
+    return uptime_s >= mhc_backoff_s(count);
+}
+
+/* Seconds until the next restart would be allowed (0 when it is allowed now). */
+static inline int mhc_wait_s(int count, int uptime_s)
+{
+    const int wait = mhc_backoff_s(count) - uptime_s;
+    return wait > 0 ? wait : 0;
+}
+
+#endif /* MAIPAI_HEAL_CORE_H */
