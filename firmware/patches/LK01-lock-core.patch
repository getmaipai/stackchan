@@ -0,0 +1,444 @@
+/*
+ * SPDX-License-Identifier: MIT
+ *
+ * The passcode lock (patch LK01): the pure decisions. Plain C99, no ESP call, no heap, no clock of its own (the caller passes
+ * the time in ms). Host test: host/tests/firmware/lock_core_test.c.
+ *
+ * What it keeps: whether a code is set, whether the unit is locked, the auto lock choice, and a salted, stretched hash of the code
+ * (PBKDF2 with HMAC-SHA-256, 2000 rounds, a 16 byte random salt the caller supplies). The code itself is never stored: it is
+ * hashed, compared and wiped. The hash and the salt are never part of any report (mlk_status_json). The entry buffer holds the
+ * digits typed so far and is wiped when the keypad ends.
+ *
+ * What it decides: the code rules (4 to 6 digits), set, change and clear (a change or a clear needs the current code), lock now,
+ * the auto lock (idle means no touch, no wake word, no remote action and no turn in progress; a ringing alarm or timer holds it
+ * off), the keypad (a 3 by 4 grid, unlock only by typing the code, no key for "enter": every digit from the fourth on is checked,
+ * so the screen never shows the length of the code), and the words, in English and Spanish.
+ *
+ * Owner decision, 2026-11-17: no lockout and no pause between wrong tries for now. LK_WRONG_DELAY_MS below is the one place to
+ * raise it later (docs/design/lock-and-radio-2026-11-17.md names the risk: a short code with unlimited tries can be guessed).
+ */
+#ifndef MAIPAI_LOCK_CORE_H
+#define MAIPAI_LOCK_CORE_H
+
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+
+#define LK_WRONG_DELAY_MS 0      /* the pause after a wrong code of six digits; 0 = none (owner decision 2026-11-17) */
+#define LK_CODE_MIN 4
+#define LK_CODE_MAX 6
+#define LK_SALT_LEN 16
+#define LK_HASH_LEN 32
+#define LK_KDF_ROUNDS 2000
+#define LK_KEYPAD_TIMEOUT_MS 15000 /* the keypad goes back to the lock screen after this long with no key */
+#define LK_KEYS 12
+#define LK_KEY_SIZE 44             /* every key is at least 44 px high and wide (patch UI01's target size) */
+#define LK_KEY_W 100               /* large keys, three across the full width, four down (owner request 2026-11-17) */
+#define LK_KEY_H 44
+
+/* ---- SHA-256, HMAC and PBKDF2 (portable: the host test checks them against Python's hashlib) ---- */
+static const uint32_t LK_K[64] = {
+    0x428a2f98u, 0x71374491u, 0xb5c0fbcfu, 0xe9b5dba5u, 0x3956c25bu, 0x59f111f1u, 0x923f82a4u, 0xab1c5ed5u, 0xd807aa98u, 0x12835b01u,
+    0x243185beu, 0x550c7dc3u, 0x72be5d74u, 0x80deb1feu, 0x9bdc06a7u, 0xc19bf174u, 0xe49b69c1u, 0xefbe4786u, 0x0fc19dc6u, 0x240ca1ccu,
+    0x2de92c6fu, 0x4a7484aau, 0x5cb0a9dcu, 0x76f988dau, 0x983e5152u, 0xa831c66du, 0xb00327c8u, 0xbf597fc7u, 0xc6e00bf3u, 0xd5a79147u,
+    0x06ca6351u, 0x14292967u, 0x27b70a85u, 0x2e1b2138u, 0x4d2c6dfcu, 0x53380d13u, 0x650a7354u, 0x766a0abbu, 0x81c2c92eu, 0x92722c85u,
+    0xa2bfe8a1u, 0xa81a664bu, 0xc24b8b70u, 0xc76c51a3u, 0xd192e819u, 0xd6990624u, 0xf40e3585u, 0x106aa070u, 0x19a4c116u, 0x1e376c08u,
+    0x2748774cu, 0x34b0bcb5u, 0x391c0cb3u, 0x4ed8aa4au, 0x5b9cca4fu, 0x682e6ff3u, 0x748f82eeu, 0x78a5636fu, 0x84c87814u, 0x8cc70208u,
+    0x90befffau, 0xa4506cebu, 0xbef9a3f7u, 0xc67178f2u};
+
+#define LK_ROR(x, n) (((x) >> (n)) | ((x) << (32 - (n))))
+
+static inline void lk_wipe(void* p, size_t n)
+{
+    volatile uint8_t* v = (volatile uint8_t*)p;
+    while (n--) {
+        *v++ = 0;
+    }
+}
+
+static inline void lk_sha_init(uint32_t h[8])
+{
+    static const uint32_t iv[8] = {0x6a09e667u, 0xbb67ae85u, 0x3c6ef372u, 0xa54ff53au, 0x510e527fu, 0x9b05688cu, 0x1f83d9abu, 0x5be0cd19u};
+    memcpy(h, iv, sizeof(iv));
+}
+
+static inline void lk_sha_block(uint32_t h[8], const uint8_t b[64])
+{
+    uint32_t w[64], a, bb, c, d, e, f, g, hh;
+    for (int i = 0; i < 16; i++) {
+        w[i] = ((uint32_t)b[i * 4] << 24) | ((uint32_t)b[i * 4 + 1] << 16) | ((uint32_t)b[i * 4 + 2] << 8) | (uint32_t)b[i * 4 + 3];
+    }
+    for (int i = 16; i < 64; i++) {
+        const uint32_t s0 = LK_ROR(w[i - 15], 7) ^ LK_ROR(w[i - 15], 18) ^ (w[i - 15] >> 3);
+        const uint32_t s1 = LK_ROR(w[i - 2], 17) ^ LK_ROR(w[i - 2], 19) ^ (w[i - 2] >> 10);
+        w[i] = w[i - 16] + s0 + w[i - 7] + s1;
+    }
+    a = h[0]; bb = h[1]; c = h[2]; d = h[3]; e = h[4]; f = h[5]; g = h[6]; hh = h[7];
+    for (int i = 0; i < 64; i++) {
+        const uint32_t S1 = LK_ROR(e, 6) ^ LK_ROR(e, 11) ^ LK_ROR(e, 25);
+        const uint32_t ch = (e & f) ^ (~e & g);
+        const uint32_t t1 = hh + S1 + ch + LK_K[i] + w[i];
+        const uint32_t S0 = LK_ROR(a, 2) ^ LK_ROR(a, 13) ^ LK_ROR(a, 22);
+        const uint32_t mj = (a & bb) ^ (a & c) ^ (bb & c);
+        const uint32_t t2 = S0 + mj;
+        hh = g; g = f; f = e; e = d + t1; d = c; c = bb; bb = a; a = t1 + t2;
+    }
+    h[0] += a; h[1] += bb; h[2] += c; h[3] += d; h[4] += e; h[5] += f; h[6] += g; h[7] += hh;
+    lk_wipe(w, sizeof(w));
+}
+
+/* One-shot hash of `len` bytes that continue a state that already absorbed `prefix` bytes (a multiple of 64). */
+static inline void lk_sha_finish(const uint32_t start[8], uint64_t prefix, const uint8_t* msg, size_t len, uint8_t out[32])
+{
+    uint32_t h[8];
+    uint8_t blk[64];
+    memcpy(h, start, sizeof(h));
+    size_t done = 0;
+    while (len - done >= 64) {
+        lk_sha_block(h, msg + done);
+        done += 64;
+    }
+    const size_t rest = len - done;
+    memset(blk, 0, sizeof(blk));
+    if (rest > 0) {
+        memcpy(blk, msg + done, rest);
+    }
+    blk[rest] = 0x80;
+    const uint64_t bits = (prefix + (uint64_t)len) * 8u;
+    if (rest >= 56) {
+        lk_sha_block(h, blk);
+        memset(blk, 0, sizeof(blk));
+    }
+    for (int i = 0; i < 8; i++) {
+        blk[56 + i] = (uint8_t)(bits >> (56 - 8 * i));
+    }
+    lk_sha_block(h, blk);
+    for (int i = 0; i < 8; i++) {
+        out[i * 4] = (uint8_t)(h[i] >> 24);
+        out[i * 4 + 1] = (uint8_t)(h[i] >> 16);
+        out[i * 4 + 2] = (uint8_t)(h[i] >> 8);
+        out[i * 4 + 3] = (uint8_t)h[i];
+    }
+    lk_wipe(h, sizeof(h));
+    lk_wipe(blk, sizeof(blk));
+}
+
+/* PBKDF2-HMAC-SHA-256, one 32 byte block (dkLen 32). `pw` is at most 64 bytes (a code is at most 6). */
+static inline void lk_pbkdf2(const uint8_t* pw, size_t pwlen, const uint8_t* salt, size_t saltlen, uint32_t rounds, uint8_t out[32])
+{
+    uint8_t pad[64], u[32], t[32], sbuf[LK_SALT_LEN + 4];
+    uint32_t ist[8], ost[8];
+    if (pwlen > 64 || saltlen > LK_SALT_LEN || rounds == 0) {
+        memset(out, 0, 32);
+        return;
+    }
+    memset(pad, 0x36, 64);
+    for (size_t i = 0; i < pwlen; i++) pad[i] ^= pw[i];
+    lk_sha_init(ist);
+    lk_sha_block(ist, pad);
+    memset(pad, 0x5c, 64);
+    for (size_t i = 0; i < pwlen; i++) pad[i] ^= pw[i];
+    lk_sha_init(ost);
+    lk_sha_block(ost, pad);
+    memcpy(sbuf, salt, saltlen);
+    sbuf[saltlen] = 0; sbuf[saltlen + 1] = 0; sbuf[saltlen + 2] = 0; sbuf[saltlen + 3] = 1;
+    lk_sha_finish(ist, 64, sbuf, saltlen + 4, u);
+    lk_sha_finish(ost, 64, u, 32, u);
+    memcpy(t, u, 32);
+    for (uint32_t r = 1; r < rounds; r++) {
+        lk_sha_finish(ist, 64, u, 32, u);
+        lk_sha_finish(ost, 64, u, 32, u);
+        for (int i = 0; i < 32; i++) t[i] ^= u[i];
+    }
+    memcpy(out, t, 32);
+    lk_wipe(pad, sizeof(pad)); lk_wipe(u, sizeof(u)); lk_wipe(t, sizeof(t)); lk_wipe(ist, sizeof(ist)); lk_wipe(ost, sizeof(ost));
+}
+
+static inline int lk_ct_equal(const uint8_t* a, const uint8_t* b, size_t n)
+{
+    uint8_t d = 0;
+    for (size_t i = 0; i < n; i++) d |= (uint8_t)(a[i] ^ b[i]);
+    return d == 0;
+}
+
+/* ---- the state ---- */
+typedef struct {
+    uint8_t has_code;
+    uint8_t locked;
+    uint8_t auto_min; /* 0 off, or one of LK_AUTO_MINUTES */
+    uint8_t salt[LK_SALT_LEN];
+    uint8_t hash[LK_HASH_LEN];
+    uint32_t last_activity_ms;
+    uint8_t keypad; /* 0 the lock screen, 1 the keypad */
+    uint32_t keypad_since_ms;
+    uint8_t n; /* digits typed so far */
+    char digits[LK_CODE_MAX + 1];
+    uint32_t block_until_ms; /* keys are ignored until then (LK_WRONG_DELAY_MS after a wrong code) */
+    uint8_t wrong_shown;     /* the last full entry was wrong: the dots are red until the next key */
+} mlk_t;
+
+enum { MLK_R_OK = 0, MLK_R_BAD_CODE, MLK_R_CURRENT_NEEDED, MLK_R_WRONG_CURRENT, MLK_R_LOCKED, MLK_R_NO_CODE, MLK_R_BAD_MINUTES, MLK_R_COUNT };
+static const char* const MLK_REASONS[MLK_R_COUNT] = {"ok", "bad_code", "current_needed", "wrong_current", "locked", "no_code", "bad_minutes"};
+
+#define LK_AUTO_COUNT 6
+static const uint8_t LK_AUTO_MINUTES[LK_AUTO_COUNT] = {0, 1, 5, 15, 30, 60};
+
+enum { MLK_EV_NONE = 0, MLK_EV_UNLOCK, MLK_EV_WRONG, MLK_EV_CANCEL, MLK_EV_IGNORED };
+
+static inline void mlk_init(mlk_t* s)
+{
+    memset(s, 0, sizeof(*s));
+}
+
+static inline int mlk_code_valid(const char* code)
+{
+    if (code == NULL) return 0;
+    size_t n = 0;
+    for (; code[n] != '\0'; n++) {
+        if (code[n] < '0' || code[n] > '9' || n >= LK_CODE_MAX) return 0;
+    }
+    return n >= LK_CODE_MIN;
+}
+
+static inline int mlk_auto_ok(int minutes)
+{
+    for (int i = 0; i < LK_AUTO_COUNT; i++) {
+        if (LK_AUTO_MINUTES[i] == minutes) return 1;
+    }
+    return 0;
+}
+
+static inline void mlk_derive(const char* code, const uint8_t salt[LK_SALT_LEN], uint8_t out[LK_HASH_LEN])
+{
+    lk_pbkdf2((const uint8_t*)code, strlen(code), salt, LK_SALT_LEN, LK_KDF_ROUNDS, out);
+}
+
+/* True when `code` is the saved code. A text that is not 4 to 6 digits is never the code (and costs no hashing). */
+static inline int mlk_check(const mlk_t* s, const char* code)
+{
+    uint8_t d[LK_HASH_LEN];
+    if (!s->has_code || !mlk_code_valid(code)) return 0;
+    mlk_derive(code, s->salt, d);
+    const int ok = lk_ct_equal(d, s->hash, LK_HASH_LEN);
+    lk_wipe(d, sizeof(d));
+    return ok;
+}
+
+static inline void mlk_clear_entry(mlk_t* s)
+{
+    lk_wipe(s->digits, sizeof(s->digits));
+    s->n = 0;
+}
+
+/* ---- hex for the saved text (the unit's settings keep text and numbers) ---- */
+static inline void mlk_hex(const uint8_t* in, size_t n, char* out)
+{
+    static const char hx[] = "0123456789abcdef";
+    for (size_t i = 0; i < n; i++) {
+        out[i * 2] = hx[in[i] >> 4];
+        out[i * 2 + 1] = hx[in[i] & 15];
+    }
+    out[n * 2] = '\0';
+}
+
+static inline int mlk_unhex(const char* in, uint8_t* out, size_t n)
+{
+    if (in == NULL || strlen(in) != n * 2) return 0;
+    for (size_t i = 0; i < n * 2; i++) {
+        const char c = in[i];
+        const int v = (c >= '0' && c <= '9') ? c - '0' : ((c >= 'a' && c <= 'f') ? c - 'a' + 10 : -1);
+        if (v < 0) return 0;
+        if (i % 2 == 0) out[i / 2] = (uint8_t)(v << 4); else out[i / 2] |= (uint8_t)v;
+    }
+    return 1;
+}
+
+/* The saved values at boot. A damaged hash or salt means no code (never a locked unit nobody can open); locked without a code is
+ * cleared. A locked unit comes back locked: that is the whole point of saving it. */
+static inline void mlk_load(mlk_t* s, const char* salt_hex, const char* hash_hex, int locked, int auto_min, uint32_t now)
+{
+    mlk_init(s);
+    if (mlk_unhex(salt_hex, s->salt, LK_SALT_LEN) && mlk_unhex(hash_hex, s->hash, LK_HASH_LEN)) {
+        s->has_code = 1;
+        s->locked = locked != 0;
+    } else {
+        memset(s->salt, 0, sizeof(s->salt));
+        memset(s->hash, 0, sizeof(s->hash));
+    }
+    s->auto_min = (uint8_t)(mlk_auto_ok(auto_min) ? auto_min : 0);
+    s->last_activity_ms = now;
+}
+
+/* ---- set, clear, lock, auto ---- */
+static inline int mlk_set(mlk_t* s, const char* code, const char* current, const uint8_t salt[LK_SALT_LEN])
+{
+    if (s->locked) return MLK_R_LOCKED;
+    if (!mlk_code_valid(code)) return MLK_R_BAD_CODE;
+    if (s->has_code) {
+        if (current == NULL || current[0] == '\0') return MLK_R_CURRENT_NEEDED;
+        if (!mlk_check(s, current)) return MLK_R_WRONG_CURRENT;
+    }
+    memcpy(s->salt, salt, LK_SALT_LEN);
+    mlk_derive(code, s->salt, s->hash);
+    s->has_code = 1;
+    return MLK_R_OK;
+}
+
+static inline int mlk_clear(mlk_t* s, const char* current)
+{
+    if (s->locked) return MLK_R_LOCKED;
+    if (!s->has_code) return MLK_R_NO_CODE;
+    if (current == NULL || !mlk_check(s, current)) return MLK_R_WRONG_CURRENT;
+    memset(s->salt, 0, sizeof(s->salt));
+    memset(s->hash, 0, sizeof(s->hash));
+    s->has_code = 0;
+    s->auto_min = 0;
+    return MLK_R_OK;
+}
+
+static inline int mlk_lock_now(mlk_t* s, uint32_t now)
+{
+    if (!s->has_code) return MLK_R_NO_CODE;
+    s->locked = 1;
+    s->keypad = 0;
+    s->block_until_ms = 0;
+    s->wrong_shown = 0;
+    s->keypad_since_ms = now;
+    mlk_clear_entry(s);
+    return MLK_R_OK;
+}
+
+static inline int mlk_set_auto(mlk_t* s, int minutes)
+{
+    if (s->locked) return MLK_R_LOCKED;
+    if (!mlk_auto_ok(minutes)) return MLK_R_BAD_MINUTES;
+    s->auto_min = (uint8_t)minutes;
+    return MLK_R_OK;
+}
+
+/* ---- the idle timer ---- */
+static inline void mlk_activity(mlk_t* s, uint32_t now)
+{
+    s->last_activity_ms = now;
+}
+
+/* Called about once a second (or every 20 ms: it is cheap). `ringing`: an alarm or timer is ringing. `busy`: a turn is in progress
+ * (listening, thinking or speaking). Both hold the lock off and count as activity. True when the unit should lock now. */
+static inline int mlk_idle_due(mlk_t* s, uint32_t now, int ringing, int busy)
+{
+    if (s->locked || !s->has_code || s->auto_min == 0) return 0;
+    if (ringing || busy) {
+        s->last_activity_ms = now;
+        return 0;
+    }
+    return (uint32_t)(now - s->last_activity_ms) >= (uint32_t)s->auto_min * 60000u;
+}
+
+/* ---- the screens and the keypad ---- */
+/* A touch on the lock screen shows the keypad. */
+static inline void mlk_screen_touch(mlk_t* s, uint32_t now)
+{
+    if (!s->locked) return;
+    if (!s->keypad) {
+        s->keypad = 1;
+        s->wrong_shown = 0;
+        mlk_clear_entry(s);
+    }
+    s->keypad_since_ms = now;
+}
+
+/* The key characters, row by row: 1 2 3 / 4 5 6 / 7 8 9 / back 0 cancel. */
+static inline char mlk_key_char(int i)
+{
+    static const char k[LK_KEYS] = {'1', '2', '3', '4', '5', '6', '7', '8', '9', 'B', '0', 'C'};
+    return (i >= 0 && i < LK_KEYS) ? k[i] : '\0';
+}
+/* The keypad fills the content zone under the banner row (patch N01: 0 to 28): a row of entry dots at y 30 to 44, then four rows of three
+ * 100 by 44 px keys with 4 px gaps from y 48 to y 236, 6 px from each side. No title and no help line: the dots and the keys are the screen. */
+#define LK_PAD_X 6
+#define LK_PAD_Y 48
+#define LK_PAD_GAPX 4
+#define LK_PAD_GAPY 4
+#define LK_DOTS_Y 30
+#define LK_DOT_SIZE 14
+static inline int mlk_key_x(int i) { return LK_PAD_X + (i % 3) * (LK_KEY_W + LK_PAD_GAPX); }
+static inline int mlk_key_y(int i) { return LK_PAD_Y + (i / 3) * (LK_KEY_H + LK_PAD_GAPY); }
+
+/* One key. Every digit from the fourth on is checked against the code: no "enter" key and no early "wrong", so the screen never
+ * tells a watcher how long the code is. After six digits a wrong entry is cleared and the line "wrong code" shows. */
+static inline int mlk_key(mlk_t* s, char key, uint32_t now)
+{
+    if (!s->locked || !s->keypad) return MLK_EV_IGNORED;
+    if ((int32_t)(s->block_until_ms - now) > 0) return MLK_EV_IGNORED;
+    s->keypad_since_ms = now;
+    if (key == 'C') {
+        mlk_clear_entry(s);
+        s->keypad = 0;
+        s->wrong_shown = 0;
+        return MLK_EV_CANCEL;
+    }
+    if (key == 'B') {
+        if (s->n > 0) s->digits[--s->n] = '\0';
+        s->wrong_shown = 0;
+        return MLK_EV_NONE;
+    }
+    if (key < '0' || key > '9') return MLK_EV_IGNORED;
+    s->wrong_shown = 0;
+    if (s->n >= LK_CODE_MAX) return MLK_EV_IGNORED;
+    s->digits[s->n++] = key;
+    s->digits[s->n] = '\0';
+    if (s->n >= LK_CODE_MIN && mlk_check(s, s->digits)) {
+        mlk_clear_entry(s);
+        s->locked = 0;
+        s->keypad = 0;
+        s->last_activity_ms = now;
+        return MLK_EV_UNLOCK;
+    }
+    if (s->n >= LK_CODE_MAX) {
+        mlk_clear_entry(s);
+        s->wrong_shown = 1;
+        s->block_until_ms = now + (uint32_t)LK_WRONG_DELAY_MS;
+        return MLK_EV_WRONG;
+    }
+    return MLK_EV_NONE;
+}
+
+/* About every 500 ms while the keypad is up: back to the lock screen after LK_KEYPAD_TIMEOUT_MS with no key. True when it did. */
+static inline int mlk_keypad_tick(mlk_t* s, uint32_t now)
+{
+    if (!s->locked || !s->keypad) return 0;
+    if ((uint32_t)(now - s->keypad_since_ms) < LK_KEYPAD_TIMEOUT_MS) return 0;
+    mlk_clear_entry(s);
+    s->keypad = 0;
+    s->wrong_shown = 0;
+    return 1;
+}
+
+/* ---- what is reported: never the code, the hash, the salt or the length ---- */
+static inline int mlk_status_json(const mlk_t* s, char* out, size_t n)
+{
+    return snprintf(out, n, "{\"ok\":true,\"has_code\":%s,\"locked\":%s,\"auto_minutes\":%u}", s->has_code ? "true" : "false",
+                    s->locked ? "true" : "false", (unsigned)s->auto_min);
+}
+
+static inline int mlk_reply_json(int reason, char* out, size_t n)
+{
+    if (reason == MLK_R_OK) return snprintf(out, n, "{\"ok\":true}");
+    return snprintf(out, n, "{\"ok\":false,\"reason\":\"%s\"}", MLK_REASONS[reason < MLK_R_COUNT ? reason : MLK_R_BAD_CODE]);
+}
+
+/* ---- the words (plain ASCII: the screen font has no accents) ---- */
+enum { MLK_LANG_EN = 0, MLK_LANG_ES = 1 };
+/* The lock screen and the keypad carry no words (owner request 2026-11-17): a wrong code is a shake of the dots and a red flash. The only
+ * word is the Lock button on the More screen. */
+enum { MLK_T_LOCK = 0, MLK_T_COUNT };
+static const char* const MLK_TEXT[2][MLK_T_COUNT] = {
+    {"Lock"},
+    {"Bloquear"},
+};
+static inline const char* mlk_text(int lang, int id)
+{
+    return MLK_TEXT[lang == MLK_LANG_ES ? 1 : 0][id >= 0 && id < MLK_T_COUNT ? id : 0];
+}
+
+#endif /* MAIPAI_LOCK_CORE_H */
