+/* ---- patch SF55: a rise in the room's sound level as a trigger -------------------------------------------------------------- */
+
+typedef struct {
+    int ema;            /* slow average of the level */
+    uint8_t have;
+    uint32_t last_at;   /* the last trigger */
+    uint8_t fired_once;
+} ms_sound_t;
+
+/* Feed the level (int16 RMS of the last second) about once a second. Returns 1 for one rise: well above the slow average, at
+ * least MS_SOUND_HOLDOFF_MS after the last. A steady loud room raises the average and does not trigger again. */
+static inline int ms_sound_rise(ms_sound_t* m, int level, uint32_t now)
+{
+    if (level < 0) {
+        level = 0;
+    }
+    if (!m->have) {
+        m->ema = level;
+        m->have = 1;
+        return 0;
+    }
+    const int rise = level - m->ema;
+    const int hit = rise >= MS_SOUND_MIN_RISE && level * 10 >= m->ema * MS_SOUND_RATIO_X10 &&
+                    (!m->fired_once || ms_dt(now, m->last_at) >= (int32_t)MS_SOUND_HOLDOFF_MS);
+    m->ema += (level - m->ema) / 8; /* the average follows in about 8 reads */
+    if (hit) {
+        m->last_at = now;
+        m->fired_once = 1;
+        return 1;
+    }
+    return 0;
+}
