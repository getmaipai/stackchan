-        } else if (ready && ms_dt(now, s->next_idle_at) >= 0) {
-            ms_request_burst(s, out, now, 1, 1, MS_REASON_NOTICE);
+        } else if (ready && (s->trig_pending || ms_dt(now, s->next_idle_at) >= 0)) {
+            /* Patch SF55: a sensor trigger or the 30 s net; every grab still asks for the cue first (ms_request_burst), no path skips it. Two frames in one burst: at 30 s the previous frame is too old to compare. */
+            ms_request_burst(s, out, now, 2, 1, MS_REASON_NOTICE);
             s->burst_kind = 2;
-            s->next_idle_at = now + (in->quiet_or_night ? MS_IDLE_PERIOD_QUIET_MS : MS_IDLE_PERIOD_MS);
