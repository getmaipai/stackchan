+#define M3_WIN_FRAMES 3200 /* 200 ms at 16 kHz */
+#define M3_WIN_MAX 24
+
 typedef struct {
     float coeff;
     uint8_t phase;
+    uint32_t win_n;
+    float w1[2], w2[2]; /* Goertzel state of the window under way */
+    double w_sq[2];
