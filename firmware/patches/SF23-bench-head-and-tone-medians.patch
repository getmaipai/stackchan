+    float win_amp[2][2][M3_WIN_MAX];  /* [phase][channel][window] tone amplitude */
+    float win_rms[2][2][M3_WIN_MAX];
     struct {
         float s1, s2;     /* Goertzel state at the tone frequency */
         double sum_sq;    /* energy */
@@ -30,7 +39,15 @@ static inline void m3_begin(m3_t* m, float sample_rate, float tone_hz)
     m->coeff = 2.0f * cosf(2.0f * 3.14159265f * tone_hz / sample_rate);
 }
 
-static inline void m3_set_phase(m3_t* m, int phase) { m->phase = (uint8_t)(phase ? 1 : 0); }
+static inline void m3_set_phase(m3_t* m, int phase)
+{
+    m->phase = (uint8_t)(phase ? 1 : 0);
+    m->win_n = 0; /* a window never spans two phases */
+    for (int c = 0; c < 2; c++) {
+        m->w1[c] = m->w2[c] = 0.0f;
+        m->w_sq[c] = 0.0;
+    }
+}
 
 /* interleaved: frames of `channels` samples; the first two channels are measured. */
 static inline void m3_feed(m3_t* m, const int16_t* interleaved, size_t frames, int channels)
@@ -47,6 +64,25 @@ static inline void m3_feed(m3_t* m, const int16_t* interleaved, size_t frames, i
             s->n++;
             const int a = x < 0 ? -(int)x : (int)x;
             if (a > s->peak) s->peak = a;
+            const float w0 = x + m->coeff * m->w1[c] - m->w2[c];
+            m->w2[c] = m->w1[c];
+            m->w1[c] = w0;
+            m->w_sq[c] += (double)x * (double)x;
+        }
+        if (++m->win_n >= M3_WIN_FRAMES) {
+            if (m->wn[m->phase] < M3_WIN_MAX) {
+                for (int c = 0; c < 2; c++) {
+                    const float p = m->w1[c] * m->w1[c] + m->w2[c] * m->w2[c] - m->coeff * m->w1[c] * m->w2[c];
+                    m->win_amp[m->phase][c][m->wn[m->phase]] = 2.0f * sqrtf(p > 0.0f ? p : 0.0f) / (float)M3_WIN_FRAMES;
+                    m->win_rms[m->phase][c][m->wn[m->phase]] = (float)sqrt(m->w_sq[c] / (double)M3_WIN_FRAMES);
+                }
+                m->wn[m->phase]++;
+            }
+            m->win_n = 0;
+            for (int c = 0; c < 2; c++) {
+                m->w1[c] = m->w2[c] = 0.0f;
+                m->w_sq[c] = 0.0;
+            }
         }
     }
 }
@@ -67,6 +103,26 @@ static inline float m3_tone_amp(const m3_t* m, int phase, int ch)
     return 2.0f * sqrtf(p > 0.0f ? p : 0.0f) / n;
 }
 
+static inline float m3_median(const float* v, int n)
+{
+    float t[M3_WIN_MAX];
+    if (n <= 0) return 0.0f;
+    for (int i = 0; i < n; i++) t[i] = v[i];
+    for (int i = 1; i < n; i++) {
+        const float x = t[i];
+        int j = i - 1;
+        while (j >= 0 && t[j] > x) {
+            t[j + 1] = t[j];
+            j--;
+        }
+        t[j + 1] = x;
+    }
+    return t[n / 2];
+}
+/* The median over the finished 200 ms windows of a phase (the room swings between windows; the median does not). */
+static inline float m3_win_amp_median(const m3_t* m, int phase, int ch) { return m3_median(m->win_amp[phase][ch], m->wn[phase]); }
+static inline float m3_win_rms_median(const m3_t* m, int phase, int ch) { return m3_median(m->win_rms[phase][ch], m->wn[phase]); }
+
 static inline int m3_peak(const m3_t* m, int phase, int ch) { return m->ch[phase][ch].peak; }
 
