# Intent: Status icons in the banner row, and why they sometimes did not show. The row learned that the unit was listening only from a poll of the device state every 2 s, so a short listen was missed, and a notice queued behind a steady one (the link message) waited for it to end; a steady notice that was preempted was dropped. Now every state change is posted when it happens (new maipai_status_core.h; wake word, listen, thinking), the mic glyph stays 1.5 s after the last listen and is checked every tick, a status message has the privacy priority and its own tag (MB_TAG_STATUS) so it replaces the last status in place, and a preempted steady notice waits in the queue instead of vanishing. New pref status_icons (off by default; the listening sound and ring light of TB01 still signal the same states, the remote chip and the mic glyph are never affected). Also adds maipai_face_set_style, the face style chosen on the bot (drawn at once, saved from the main task, device event face_style_changed).
# Placement: unit
# Upstream: firmware/main/hal/maipai_banner.cc, maipai_banner_core.h (ours, N01), maipai_prefs_core.h (TA01), maipai_face.cc, maipai_listen.cc (TB01), stackchan_display.cc SetStatus
# Check after a flash: self.prefs.set {"json":"{\"status_icons\":true}"}: wake word shows Heard you, a listen shows Listening, thinking shows Thinking in the top row, also for a short listen; with it false only the sound and light signal them.

diff --git a/firmware/main/hal/maipai_status_core.h b/firmware/main/hal/maipai_status_core.h
new file mode 100644
--- /dev/null
+++ b/firmware/main/hal/maipai_status_core.h
@@ -0,0 +1,48 @@
+/*
+ * SPDX-License-Identifier: MIT
+ *
+ * Status icons for the banner row (patch UI04): the pure rules. Plain C99, no ESP call, no heap, no clock of its own.
+ * Host test: host/tests/firmware/status_core_test.c.
+ *
+ * Why the icons sometimes did not show (found 2026-11-17): the row only learned that the unit was listening from a poll every 2 s of
+ * the device state, so a listen shorter than the poll, or one that began and ended between two polls, never reached the row; and a
+ * notice that was queued behind a steady one (the link message) waited for it to end. Now every state change is posted when it
+ * happens, the mic glyph stays at least MST_MIC_HOLD_MS after the last listen, and a status message has the highest priority
+ * (the same as the privacy cues) with its own tag, so it replaces the last status in place and is not queued behind a notice.
+ *
+ * The icons are a choice (pref status_icons, off by default). With them off the same states are still signaled by the listening
+ * cues of patch TB01 (the chime and the ring light, both on by default). The remote chip and the mic glyph are privacy cues: they
+ * are never affected by this setting.
+ */
+#ifndef MAIPAI_STATUS_CORE_H
+#define MAIPAI_STATUS_CORE_H
+
+#include <stdint.h>
+
+#define MST_MIC_HOLD_MS 1500u /* the mic glyph stays this long after the unit stopped listening, so a short listen is seen */
+
+enum { MST_WAKE = 0, MST_LISTEN, MST_THINK, MST_COUNT };
+
+/* English and Spanish words; the icon is a banner icon id (MB_ICON_*: 2 check, 7 speech) so the row needs no new shape. */
+static const char* const MST_TEXT[2][MST_COUNT] = {{"Heard you", "Listening", "Thinking"}, {"Te oi", "Escuchando", "Pensando"}};
+static const uint8_t MST_ICON[MST_COUNT] = {2, 7, 7};
+/* How long it stays at most: the state change clears it sooner; the limit keeps a missed change from leaving it up (the banner's own
+ * longest hold is MB_MAX_HOLD_MS). */
+static const uint32_t MST_HOLD_MS[MST_COUNT] = {1500u, 30000u, 45000u};
+
+static inline const char* mst_text(int kind, int es) { return kind >= 0 && kind < MST_COUNT ? MST_TEXT[es ? 1 : 0][kind] : ""; }
+static inline int mst_icon(int kind) { return kind >= 0 && kind < MST_COUNT ? MST_ICON[kind] : 0; }
+static inline uint32_t mst_hold_ms(int kind) { return kind >= 0 && kind < MST_COUNT ? MST_HOLD_MS[kind] : 0u; }
+
+/* The mic glyph: shown while listening (event or poll), and for MST_MIC_HOLD_MS after the last listen. hold_until 0 means none. */
+static inline int mst_mic_shown(int live, uint32_t hold_until, uint32_t now, int polled)
+{
+    return live || polled || (hold_until != 0u && (int32_t)(now - hold_until) < 0);
+}
+static inline uint32_t mst_mic_hold_until(uint32_t now)
+{
+    const uint32_t t = now + MST_MIC_HOLD_MS;
+    return t == 0u ? 1u : t;
+}
+
+#endif /* MAIPAI_STATUS_CORE_H */
