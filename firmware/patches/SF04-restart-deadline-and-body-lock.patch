# Intent: Safety fix, train 4. The self-restart now happens within 5 s even when the saved restart count is busy or the flash write stalls (the lock is only tried, and a one-shot timer restarts the unit). Servo commands from other tasks and the servo update no longer run at the same moment (one recursive lock inside Motion).
# Placement: unit
# Upstream: firmware/main/hal/maipai_heal.cc, firmware/main/stackchan/motion (ours, M5Stack base)
# Check after a flash: the dance, head moves and look-at still run smoothly (no stutter from the new lock); self.heal restart test still restarts the unit.
# Kconfig: none

diff --git a/firmware/main/hal/maipai_heal.cc b/firmware/main/hal/maipai_heal.cc
--- a/firmware/main/hal/maipai_heal.cc
+++ b/firmware/main/hal/maipai_heal.cc
@@ -216,11 +216,27 @@ void restart_task(void* arg)
     snprintf(extra, sizeof(extra), "\"action\":\"restart\",\"why\":\"%s\",\"n\":%d", request->why, count + 1);
     device_events_push("heal", extra);
     vTaskDelay(pdMS_TO_TICKS(300));  // the log line and the event leave first
-    {
-        std::lock_guard<std::mutex> lock(s_mutex);
+    // Patch SF03: the restart must happen even when the saved count cannot be written (a stuck lock or flash). A timer restarts the
+    // unit after 5 s whatever this task is waiting for, and the lock is only tried, never waited for.
+    static esp_timer_handle_t hard_restart = nullptr;
+    esp_timer_create_args_t hard_args = {};
+    hard_args.callback = [](void*) { esp_restart(); };
+    hard_args.name = "heal_hard";
+    if (esp_timer_create(&hard_args, &hard_restart) == ESP_OK) {
+        esp_timer_start_once(hard_restart, 5ULL * 1000 * 1000);
+    }
+    bool got_lock = false;
+    for (int i = 0; i < 20 && !got_lock; i++) {
+        got_lock = s_mutex.try_lock();
+        if (!got_lock) vTaskDelay(pdMS_TO_TICKS(50));
+    }
+    if (got_lock) {
         if (!save_locked(request->why)) {
             ESP_LOGW(kTag, "could not count this restart in flash; restarting anyway");
         }
+        s_mutex.unlock();
+    } else {
+        ESP_LOGW(kTag, "the restart count is busy; restarting without counting this one");
     }
     esp_restart();
 }
