# Intent: two on-screen cues. (1) Find-my-robot: every find chirp (Y02) shows a happy face and the words "Here I am!" for 2.5 s, so the unit is easy to spot as well as to hear. (2) Games: the game screen shows "Best N" in the top corner (the saved best, nothing before the first score) and, after a record, "New best! N" in gold with the success tone. The packs are unchanged; the label is drawn by the player.
# Placement: unit (the screen and the game player run on the robot)
# Upstream: firmware/main/hal/maipai_sounds.cc, maipai_games.cc, MIT
# Check after a flash: Remote Find shows "Here I am!"; a game shows "Best N" and, when the score beats it, "New best! N".

diff --git a/firmware/main/hal/maipai_sounds.cc b/firmware/main/hal/maipai_sounds.cc
index c50c5ec..3872589 100644
--- a/firmware/main/hal/maipai_sounds.cc
+++ b/firmware/main/hal/maipai_sounds.cc
@@ -161,6 +161,9 @@ std::string play_named(const std::string& name, bool urgent, bool test, int find
             hal_bridge::board_set_speaker_volume(kFindVolume, false);
         }
         s_find_last_ms = now_ms;
+        // Patch Y04: a clear "finding" cue on the screen with every chirp: a big happy face and the words.
+        hal_bridge::react_face("happy", 2500);
+        hal_bridge::notice("Here I am!", 2500);
     }
     const int s     = ms_sound_from_name(name.c_str());
     const char* why = "unknown_sound";
