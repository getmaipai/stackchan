diff --git a/firmware/main/hal/maipai_screen_core.h b/firmware/main/hal/maipai_screen_core.h
new file mode 100644
--- /dev/null
+++ b/firmware/main/hal/maipai_screen_core.h
@@ -0,0 +1,76 @@
+/*
+ * SPDX-License-Identifier: MIT
+ *
+ * The screen's wake rule (patch W01): the pure decisions, no ESP-IDF, so a host compiler can test them
+ * (host/tests/firmware/screen_core_test.c).
+ *
+ * The screen may be dimmed from outside (the host's rest stage sets 5, its night rule sets 15). Whatever
+ * dimmed it, an input from a person puts the saved level back, and the unit never boots into a level a
+ * transient command chose. Three small rules live here:
+ *
+ *   saved level   what the person chose (quick settings slider): at least 10, at most 100, 75 when nothing
+ *                 was ever saved. A raw 0 or below is a damaged value and reads as the floor.
+ *   dim           the live level is below the saved one: an input should restore it.
+ *   hub gone      no host to restore it either: the screen returns to the saved level after a grace period.
+ */
+#ifndef MAIPAI_SCREEN_CORE_H
+#define MAIPAI_SCREEN_CORE_H
+
+#include <stdint.h>
+
+#define MSC_DEFAULT_LEVEL 75
+#define MSC_FLOOR_LEVEL 10
+#define MSC_MIN_GAP_MS 250      /* two wakes closer than this are one input (a finger held on the glass) */
+#define MSC_EVENT_GAP_MS 1500   /* the host is told at most this often */
+#define MSC_TOUCH_CLAIM_MS 800  /* a face press this soon after a wake only woke the screen */
+#define MSC_HUB_GONE_MS 60000   /* with no host this long, a dimmed screen comes back by itself */
+
+/* The level the person chose, from the raw saved value (`present` 0 when nothing was saved). */
+static inline int msc_saved_level(int present, int raw)
+{
+    if (!present) {
+        return MSC_DEFAULT_LEVEL;
+    }
+    if (raw <= 0) {
+        return MSC_FLOOR_LEVEL;
+    }
+    if (raw > 100) {
+        return 100;
+    }
+    return raw;
+}
+
+/* True when the live level is below the saved one (dimmed from outside, or the screen is off). */
+static inline int msc_is_dim(int live, int saved)
+{
+    return live < saved;
+}
+
+/* Wake now? `last_ms` is when the last wake ran (or a negative number for never). */
+static inline int msc_wake_due(int live, int saved, int64_t now_ms, int64_t last_ms)
+{
+    if (!msc_is_dim(live, saved)) {
+        return 0;
+    }
+    return last_ms < 0 || now_ms - last_ms >= MSC_MIN_GAP_MS;
+}
+
+/* Tell the host about a wake? Only when one restored something, and not more often than the gap. */
+static inline int msc_event_due(int restored, int64_t now_ms, int64_t last_event_ms)
+{
+    return restored && (last_event_ms < 0 || now_ms - last_event_ms >= MSC_EVENT_GAP_MS);
+}
+
+/* A press that began right after a wake that restored the screen is only a wake: no listen, no toggle. */
+static inline int msc_touch_only_woke(int64_t now_ms, int64_t woke_ms)
+{
+    return woke_ms >= 0 && now_ms - woke_ms >= 0 && now_ms - woke_ms < MSC_TOUCH_CLAIM_MS;
+}
+
+/* The hub link has been down since `down_since_ms` (negative while it is up): time to come back by itself? */
+static inline int msc_hub_gone_due(int live, int saved, int64_t now_ms, int64_t down_since_ms)
+{
+    return msc_is_dim(live, saved) && down_since_ms >= 0 && now_ms - down_since_ms >= MSC_HUB_GONE_MS;
+}
+
+#endif /* MAIPAI_SCREEN_CORE_H */
diff --git a/firmware/main/hal/maipai_screen.h b/firmware/main/hal/maipai_screen.h
new file mode 100644
--- /dev/null
+++ b/firmware/main/hal/maipai_screen.h
@@ -0,0 +1,30 @@
+/*
+ * SPDX-License-Identifier: MIT
+ *
+ * The screen's wake rule, device side (patch W01). The decisions are maipai_screen_core.h.
+ */
+#pragma once
+
+// An input from a person (a touch on the glass, the touch bar, a shake, a tilt, the wake word) happened.
+// If the screen is below the level the person saved, put it back and tell the host (a "head_touch" event with
+// screen=1, so a host that put the unit to sleep wakes it). `why` is a short word for the log. Safe from any
+// task, including the timer task: no LVGL lock, no wait. True when it restored the screen.
+bool maipai_screen_wake(const char* why);
+
+// Called for every touch on the glass, before the point is stored (so the wake is known before the face sees
+// the press).
+void maipai_screen_touch(int num);
+
+// True once after a touch on the glass that restored the screen: that press is only a wake and must start no
+// listen and toggle nothing (the same rule as the clock face).
+bool maipai_screen_take_wake_touch();
+
+// About once a second from the board timer: with the hub gone for a minute a dimmed screen comes back.
+void maipai_screen_tick();
+
+// The level the person saved (what the screen returns to), live level, and the level being moved to.
+void maipai_screen_levels(int* saved, int* live);
+
+// Registers self.screen.get_level (read-only: saved, live) and, in a bench build (MAIPAI_SERIAL_TOOLS), the
+// self.screen.bench_touch tool that presses the glass through the same funnel a real finger uses.
+void maipai_screen_register_tools();
diff --git a/firmware/main/hal/maipai_screen.cc b/firmware/main/hal/maipai_screen.cc
new file mode 100644
--- /dev/null
+++ b/firmware/main/hal/maipai_screen.cc
@@ -0,0 +1,167 @@
+/*
+ * SPDX-License-Identifier: MIT
+ */
+// The screen's wake rule, device side (patch W01). See maipai_screen_core.h for the rule and why it exists.
+#include "maipai_screen.h"
+#include "maipai_screen_core.h"
+#include "board/hal_bridge.h"
+#include "device_events.h"
+
+#include <backlight.h>
+#include <board.h>
+#include <esp_log.h>
+#include <esp_timer.h>
+
+#include <sdkconfig.h>
+#include <freertos/FreeRTOS.h>
+#include <freertos/task.h>
+#include <mcp_server.h>
+
+#include <atomic>
+#include <cstdio>
+#include <string>
+
+static const char* TAG = "MAIPAI-SCREEN";
+
+namespace {
+std::atomic<int64_t> s_last_wake_ms{-1};
+std::atomic<int64_t> s_last_event_ms{-1};
+std::atomic<int64_t> s_touch_woke_ms{-1};
+std::atomic<int64_t> s_hub_down_since_ms{-1};
+std::atomic<int64_t> s_last_tick_ms{0};
+
+int64_t now_ms()
+{
+    return esp_timer_get_time() / 1000;
+}
+
+// The level the person saved, from the backlight's own copy: this runs on tasks whose stacks are in external RAM
+// (the motion and head touch tasks), and a flash read from one of those aborts the unit (see patch V03).
+int saved_level(Backlight* backlight)
+{
+    const int raw = backlight->saved_brightness();
+    return msc_saved_level(raw >= 0, raw);
+}
+
+// Restores the saved level when the screen is below it. True when it restored something.
+bool restore_if_dim(const char* why, bool hub_gone_rule)
+{
+    auto* backlight = Board::GetInstance().GetBacklight();
+    if (backlight == nullptr) {
+        return false;
+    }
+    const int saved = saved_level(backlight);
+    const int live  = backlight->brightness();
+    if (!msc_is_dim(live, saved)) {
+        return false;
+    }
+    backlight->RestoreSavedLevel();
+    ESP_LOGW(TAG, "screen was dim (%d, saved %d): restored on %s%s", live, saved, why, hub_gone_rule ? " (no host)" : "");
+    return true;
+}
+}  // namespace
+
+bool maipai_screen_wake(const char* why)
+{
+    const int64_t now = now_ms();
+    auto* backlight   = Board::GetInstance().GetBacklight();
+    if (backlight == nullptr) {
+        return false;
+    }
+    const int saved = saved_level(backlight);
+    if (!msc_wake_due(backlight->brightness(), saved, now, s_last_wake_ms.load())) {
+        return false;
+    }
+    s_last_wake_ms.store(now);
+    if (!restore_if_dim(why != nullptr ? why : "input", false)) {
+        return false;
+    }
+    if (msc_event_due(1, now, s_last_event_ms.load())) {
+        s_last_event_ms.store(now);
+        // The host that put the unit to sleep wakes on a head touch it can trust (strong and tap); screen=1 says it
+        // was the glass or another input, not the strip.
+        device_events_push("head_touch", "\"strong\":1,\"tap\":1,\"screen\":1");
+    }
+    return true;
+}
+
+void maipai_screen_touch(int num)
+{
+    static std::atomic<bool> down{false};
+    if (num <= 0) {
+        down.store(false);
+        return;
+    }
+    if (down.exchange(true)) {
+        return;  // a finger already on the glass: the wake ran at the touch down
+    }
+    if (maipai_screen_wake("touch")) {
+        s_touch_woke_ms.store(now_ms());  // this press only woke the screen
+    }
+}
+
+bool maipai_screen_take_wake_touch()
+{
+    const int64_t woke = s_touch_woke_ms.exchange(-1);
+    return msc_touch_only_woke(now_ms(), woke);
+}
+
+void maipai_screen_tick()
+{
+    const int64_t now = now_ms();
+    if (now - s_last_tick_ms.load() < 1000) {
+        return;
+    }
+    s_last_tick_ms.store(now);
+    if (hal_bridge::hub_link_up()) {
+        s_hub_down_since_ms.store(-1);
+        return;
+    }
+    if (s_hub_down_since_ms.load() < 0) {
+        s_hub_down_since_ms.store(now);
+        return;
+    }
+    auto* backlight = Board::GetInstance().GetBacklight();
+    if (backlight == nullptr) {
+        return;
+    }
+    if (msc_hub_gone_due(backlight->brightness(), saved_level(backlight), now, s_hub_down_since_ms.load())) {
+        restore_if_dim("hub gone", true);
+    }
+}
+
+void maipai_screen_levels(int* saved, int* live)
+{
+    auto* backlight = Board::GetInstance().GetBacklight();
+    if (saved != nullptr) {
+        *saved = backlight != nullptr ? saved_level(backlight) : 0;
+    }
+    if (live != nullptr) {
+        *live = backlight != nullptr ? backlight->brightness() : 0;
+    }
+}
+
+void maipai_screen_register_tools()
+{
+    auto& mcp = McpServer::GetInstance();
+    mcp.AddTool("self.screen.get_level",
+                "Returns the screen levels: saved (the level a person chose, where a touch or the wake word puts a dimmed "
+                "screen back) and live (what the screen shows now), each 0 to 100.",
+                PropertyList(), [](const PropertyList&) -> ReturnValue {
+                    int saved = 0, live = 0;
+                    maipai_screen_levels(&saved, &live);
+                    char buffer[64];
+                    snprintf(buffer, sizeof(buffer), "{\"saved\":%d,\"live\":%d}", saved, live);
+                    return std::string(buffer);
+                });
+#if CONFIG_MAIPAI_SERIAL_TOOLS
+    mcp.AddTool("self.screen.bench_touch",
+                "Bench only: a finger on the glass for 200 ms, through the same function the touch chip's reader calls.",
+                PropertyList(), [](const PropertyList&) -> ReturnValue {
+                    hal_bridge::set_touch_point(1, 160, 4);  // the top edge strip: a tap there toggles nothing and starts no listen
+                    vTaskDelay(pdMS_TO_TICKS(200));
+                    hal_bridge::set_touch_point(0, 0, 0);
+                    return true;
+                });
+#endif
+}
