+// ---- Patch UX26 (bench only): a richer look for Four in a Row, switchable at run time so one image measures both looks (self.game.bench_look: 0 plain, 1 gradients and highlights, 2 adds soft shadows).
+// It follows docs/plan/games-visual-budget.md: only the one draw callback (no extra LVGL objects), gradients and shadows on the static parts, a highlight and a rim made of plain rectangles on the
+// discs, no bitmaps. Level 0 is the look of before, unchanged.
+int s_look = 0;
+
+uint32_t shade(uint32_t c, int pct)   // pct 100 keeps the color, 70 is darker, 130 lighter (clamped)
+{
+    int r = ((c >> 16) & 255) * pct / 100, g = ((c >> 8) & 255) * pct / 100, b = (c & 255) * pct / 100;
+    if (r > 255) r = 255;
+    if (g > 255) g = 255;
+    if (b > 255) b = 255;
+    return (static_cast<uint32_t>(r) << 16) | (static_cast<uint32_t>(g) << 8) | static_cast<uint32_t>(b);
 }
 
+void grad_rect(lv_layer_t* layer, int x, int y, int w, int h, int radius, uint32_t top, uint32_t bottom, int shadow = 0, int shadow_dy = 0)
+{
+    lv_draw_rect_dsc_t d;
+    lv_draw_rect_dsc_init(&d);
+    d.bg_color = rgb(top);
+    d.bg_opa = LV_OPA_COVER;
+    d.radius = radius;
+    d.bg_grad.dir = LV_GRAD_DIR_VER;
+    d.bg_grad.stops_count = 2;
+    d.bg_grad.stops[0].color = rgb(top);
+    d.bg_grad.stops[0].opa = LV_OPA_COVER;
+    d.bg_grad.stops[0].frac = 0;
+    d.bg_grad.stops[1].color = rgb(bottom);
+    d.bg_grad.stops[1].opa = LV_OPA_COVER;
+    d.bg_grad.stops[1].frac = 255;
+    if (shadow > 0) {
+        d.shadow_width = shadow;
+        d.shadow_offset_y = shadow_dy;
+        d.shadow_color = lv_color_black();
+        d.shadow_opa = LV_OPA_50;
+    }
+    lv_area_t a = {static_cast<lv_coord_t>(x), static_cast<lv_coord_t>(y), static_cast<lv_coord_t>(x + w - 1), static_cast<lv_coord_t>(y + h - 1)};
+    lv_draw_rect(layer, &d, &a);
+}
+
+// A disc with depth, from plain rectangles: a darker rim, the face a little up and to the left, and a pale highlight. Level 2 adds a soft shadow under it.
+void rich_disc(lv_layer_t* layer, int x, int y, int d, uint32_t color)
+{
+    if (s_look >= 2) {
+        lv_draw_rect_dsc_t sd;
+        lv_draw_rect_dsc_init(&sd);
+        sd.bg_opa = LV_OPA_TRANSP;
+        sd.radius = LV_RADIUS_CIRCLE;
+        sd.shadow_width = 5;
+        sd.shadow_offset_y = 2;
+        sd.shadow_color = lv_color_black();
+        sd.shadow_opa = LV_OPA_60;
+        lv_area_t a = {static_cast<lv_coord_t>(x), static_cast<lv_coord_t>(y), static_cast<lv_coord_t>(x + d - 1), static_cast<lv_coord_t>(y + d - 1)};
+        lv_draw_rect(layer, &sd, &a);
+    }
+    rect(layer, x, y, d, d, LV_RADIUS_CIRCLE, shade(color, 68));                              // the rim
+    rect(layer, x + 2, y + 1, d - 5, d - 5, LV_RADIUS_CIRCLE, color);                          // the face
+    rect(layer, x + d / 4, y + d / 6, d / 4, d / 5, LV_RADIUS_CIRCLE, 0xFFFFFF, LV_OPA_50);    // the highlight
+}
+
+// A hole of the board: a dark socket with a lighter inner floor low and to the right, so it looks cut into the blue.
+void rich_hole(lv_layer_t* layer, int x, int y, int d)
+{
+    rect(layer, x - 1, y - 1, d + 2, d + 2, LV_RADIUS_CIRCLE, 0x0E2A6E);                      // a thin light edge round the socket
+    rect(layer, x, y, d, d, LV_RADIUS_CIRCLE, 0x040A1C);                                       // the socket
+    rect(layer, x + 2, y + 3, d - 4, d - 4, LV_RADIUS_CIRCLE, 0x08142F);                       // the floor of the socket, shifted down: a shadow on the top left
+}
