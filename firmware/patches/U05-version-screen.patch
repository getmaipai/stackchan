diff --git a/firmware/main/hal/maipai_version.cc b/firmware/main/hal/maipai_version.cc
new file mode 100644
--- /dev/null
+++ b/firmware/main/hal/maipai_version.cc
@@ -0,0 +1,83 @@
+/*
+ * SPDX-License-Identifier: MIT
+ *
+ * Version screen data, device side (patch U05). Reads only; nothing is stored.
+ */
+#include <sdkconfig.h>
+#if CONFIG_MAIPAI_VERSION
+#include "maipai_version.h"
+#include <mcp_server.h>
+#include <cJSON.h>
+#include <esp_app_desc.h>
+#include <esp_heap_caps.h>
+#include <esp_ota_ops.h>
+#include <esp_timer.h>
+#include <cstring>
+#include <string>
+
+void maipai_version_read(mv_info_t* out)
+{
+    memset(out, 0, sizeof(*out));
+    const esp_app_desc_t* desc = esp_app_get_description();
+    if (desc != nullptr) {
+        strlcpy(out->version, desc->version, sizeof(out->version));
+        strlcpy(out->project, desc->project_name, sizeof(out->project));
+        snprintf(out->built, sizeof(out->built), "%s %s", desc->date, desc->time);
+    }
+    const esp_partition_t* run = esp_ota_get_running_partition();
+    if (run != nullptr) {
+        strlcpy(out->slot, run->label, sizeof(out->slot));
+        out->slot_known = 1;
+        esp_ota_img_states_t state;
+        out->image_state = MV_IMG_UNKNOWN;
+        if (esp_ota_get_state_partition(run, &state) == ESP_OK) {
+            if (state == ESP_OTA_IMG_VALID) {
+                out->image_state = MV_IMG_VALID;
+            } else if (state == ESP_OTA_IMG_NEW || state == ESP_OTA_IMG_PENDING_VERIFY) {
+                out->image_state = MV_IMG_PENDING;
+            } else if (state == ESP_OTA_IMG_UNDEFINED) {
+                out->image_state = MV_IMG_USB;
+            }
+        }
+    }
+    out->update_key    = CONFIG_STACKCHAN_UPDATE_PUBKEY[0] != '\0';
+    out->internal_free = heap_caps_get_free_size(MALLOC_CAP_INTERNAL);
+    out->internal_min  = heap_caps_get_minimum_free_size(MALLOC_CAP_INTERNAL);
+    out->internal_big  = heap_caps_get_largest_free_block(MALLOC_CAP_INTERNAL);
+    out->psram_free    = heap_caps_get_free_size(MALLOC_CAP_SPIRAM);
+    out->psram_min     = heap_caps_get_minimum_free_size(MALLOC_CAP_SPIRAM);
+    out->uptime_s      = static_cast<uint32_t>(esp_timer_get_time() / 1000000);
+}
+
+void maipai_version_register_tools()
+{
+    McpServer::GetInstance().AddTool(
+        "self.version.get",
+        "The firmware version, its release tag, whether the image can be trusted (installed by a signed update, or "
+        "flashed by cable), the slot it runs from and the free memory. Answers {ok,version,tag,image,slot,"
+        "internal_free,internal_min,internal_big,psram_free,psram_min,uptime_s}.",
+        std::vector<Property>{}, [](const PropertyList&) -> ReturnValue {
+            mv_info_t i;
+            maipai_version_read(&i);
+            char tag[40];
+            mv_tag(i.version, tag, sizeof(tag));
+            cJSON* root = cJSON_CreateObject();
+            cJSON_AddBoolToObject(root, "ok", true);
+            cJSON_AddStringToObject(root, "version", i.version);
+            cJSON_AddStringToObject(root, "tag", tag);
+            cJSON_AddStringToObject(root, "image", mv_signature_word(&i));
+            cJSON_AddStringToObject(root, "slot", i.slot_known ? i.slot : "unknown");
+            cJSON_AddNumberToObject(root, "internal_free", i.internal_free);
+            cJSON_AddNumberToObject(root, "internal_min", i.internal_min);
+            cJSON_AddNumberToObject(root, "internal_big", i.internal_big);
+            cJSON_AddNumberToObject(root, "psram_free", i.psram_free);
+            cJSON_AddNumberToObject(root, "psram_min", i.psram_min);
+            cJSON_AddNumberToObject(root, "uptime_s", i.uptime_s);
+            char* text      = cJSON_PrintUnformatted(root);
+            std::string out = text != nullptr ? text : "{\"ok\":false,\"error\":\"out of memory: try again\"}";
+            cJSON_free(text);
+            cJSON_Delete(root);
+            return out;
+        });
+}
+#endif
