diff --git a/firmware/main/hal/maipai_version_core.h b/firmware/main/hal/maipai_version_core.h
new file mode 100644
--- /dev/null
+++ b/firmware/main/hal/maipai_version_core.h
@@ -0,0 +1,147 @@
+/*
+ * SPDX-License-Identifier: MIT
+ *
+ * Version screen (patch U05): the pure logic. The screen shows the firmware version; tapping it ten times, each tap
+ * within two seconds of the last, opens the details a helper needs: the release tag, whether the image can be trusted,
+ * the slot it runs from and the free memory. Header-only plain C99 so a host compiler can test it; the device side is
+ * in maipai_more.cc.
+ */
+#ifndef MAIPAI_VERSION_CORE_H
+#define MAIPAI_VERSION_CORE_H
+
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+
+#define MV_TAPS 10
+#define MV_TAP_GAP_MS 2000
+#define MV_OPEN_MS 60000 /* the details close again by themselves */
+
+typedef struct {
+    uint8_t taps;
+    uint32_t last_ms;
+    uint32_t opened_ms; /* 0: closed */
+    uint8_t open;
+} mv_state_t;
+
+static inline void mv_init(mv_state_t* s) { memset(s, 0, sizeof(*s)); }
+
+/* A tap on the version line. Returns 1 on the tap that opens the details. */
+static inline int mv_tap(mv_state_t* s, uint32_t now_ms)
+{
+    if (s->open) {
+        return 0;
+    }
+    if (s->taps > 0 && now_ms - s->last_ms > MV_TAP_GAP_MS) {
+        s->taps = 0; /* too slow: start counting again */
+    }
+    s->taps++;
+    s->last_ms = now_ms;
+    if (s->taps >= MV_TAPS) {
+        s->open = 1;
+        s->opened_ms = now_ms == 0 ? 1 : now_ms;
+        s->taps = 0;
+        return 1;
+    }
+    return 0;
+}
+
+/* Whether the details are showing; they close after MV_OPEN_MS. */
+static inline int mv_is_open(mv_state_t* s, uint32_t now_ms)
+{
+    if (s->open && now_ms - s->opened_ms > MV_OPEN_MS) {
+        mv_init(s);
+    }
+    return s->open;
+}
+
+typedef struct {
+    char version[40];       /* the firmware version text */
+    char project[24];       /* the project name */
+    char built[40];         /* the build date and time */
+    char slot[12];          /* the partition label the image runs from */
+    uint8_t slot_known;
+    uint8_t update_key;     /* an update signature key is built in */
+    uint8_t image_state;    /* MV_IMG_* */
+    uint32_t internal_free;
+    uint32_t internal_min;
+    uint32_t internal_big;
+    uint32_t psram_free;
+    uint32_t psram_min;
+    uint32_t uptime_s;
+} mv_info_t;
+
+#define MV_IMG_UNKNOWN 0
+#define MV_IMG_VALID 1    /* the system confirmed it after a start */
+#define MV_IMG_PENDING 2  /* installed wirelessly, not yet confirmed */
+#define MV_IMG_USB 3      /* flashed over the cable: no signature check ran */
+
+static inline const char* mv_signature_word(const mv_info_t* i)
+{
+    if (i->image_state == MV_IMG_PENDING) {
+        return i->update_key ? "installed by a signed update, waiting to be confirmed" : "waiting to be confirmed";
+    }
+    if (i->image_state == MV_IMG_VALID) {
+        return i->update_key ? "installed by a signed update and confirmed" : "confirmed; no update key is built in";
+    }
+    if (i->image_state == MV_IMG_USB) {
+        return i->update_key ? "flashed by cable; later updates must be signed" : "flashed by cable; wireless updates are off";
+    }
+    return "not known";
+}
+
+/* The release tag is the version text when it looks like one: it starts with a digit (after an optional v), holds only
+ * letters, digits, dots, plus and minus, has at least one dot and does not say "dirty". Anything else is a development build. */
+static inline int mv_tag(const char* version, char* out, size_t cap)
+{
+    const char* p = version;
+    if (*p == 'v') {
+        p++;
+    }
+    int dots = 0;
+    int ok = *p >= '0' && *p <= '9';
+    for (const char* q = p; ok && *q != '\0'; q++) {
+        if (*q == '.') {
+            dots++;
+        } else if (!((*q >= '0' && *q <= '9') || (*q >= 'a' && *q <= 'z') || (*q >= 'A' && *q <= 'Z') || *q == '+' || *q == '-')) {
+            ok = 0;
+        }
+    }
+    if (!ok || dots < 1 || strstr(version, "dirty") != NULL) {
+        return snprintf(out, cap, "%s", "not a release build");
+    }
+    return snprintf(out, cap, "v%.38s", p);
+}
+
+/* Kilobytes with one decimal would be noise: whole kilobytes, or megabytes with one decimal. */
+static inline int mv_bytes_word(uint32_t bytes, char* out, size_t cap)
+{
+    if (bytes >= 1024u * 1024u) {
+        const uint32_t tenths = (uint32_t)(((uint64_t)bytes * 10u + 524288u) / (1024u * 1024u));
+        return snprintf(out, cap, "%u.%u MB", (unsigned)(tenths / 10), (unsigned)(tenths % 10));
+    }
+    return snprintf(out, cap, "%u KB", (unsigned)((bytes + 512u) / 1024u));
+}
+
+#define MV_LINES 6
+#define MV_LINE 80
+
+/* The detail lines, in order. Returns how many were written. */
+static inline int mv_detail_lines(const mv_info_t* i, char out[MV_LINES][MV_LINE])
+{
+    char tag[40], a[16], b[16], c[16], d[16];
+    mv_tag(i->version, tag, sizeof(tag));
+    snprintf(out[0], MV_LINE, "Version: %.60s", i->version[0] != '\0' ? i->version : "unknown");
+    snprintf(out[1], MV_LINE, "Tag: %s", tag);
+    snprintf(out[2], MV_LINE, "Image: %s", mv_signature_word(i));
+    snprintf(out[3], MV_LINE, "Slot: %s", i->slot_known ? i->slot : "unknown");
+    mv_bytes_word(i->internal_free, a, sizeof(a));
+    mv_bytes_word(i->internal_min, b, sizeof(b));
+    snprintf(out[4], MV_LINE, "Memory free: %s (lowest %s)", a, b);
+    mv_bytes_word(i->psram_free, c, sizeof(c));
+    mv_bytes_word(i->psram_min, d, sizeof(d));
+    snprintf(out[5], MV_LINE, "Large memory free: %s (lowest %s)", c, d);
+    return MV_LINES;
+}
+
+#endif
diff --git a/firmware/sdkconfig.core.defaults b/firmware/sdkconfig.core.defaults
--- a/firmware/sdkconfig.core.defaults
