+/* ---- patch UX15d: the look (docs/design/game-over-look.md) ----
+ * The languages of the first run (the order of the firmware's language table: en, es, fr, de, pt, it), the words in plain ASCII, the geometry of the new look, the
+ * count-up, the confetti, the easings and the flourish of tones. Pure functions of the time since the screen appeared, so a host test checks them and the renderer draws any
+ * moment of the motion. The old look stays: look 0 is today's screen, 1 the new one still, 2 the new one moving and with soft shadows (mgo::g_look in maipai_game_over.h). */
+enum { MGO_LANG_EN = 0, MGO_LANG_ES, MGO_LANG_FR, MGO_LANG_DE, MGO_LANG_PT, MGO_LANG_IT, MGO_LANGS };
+
+static inline const char* mgo_title_l(int result, int lang)
+{
+    static const char* const t[5][MGO_LANGS] = {
+        {"You won!", "Ganaste", "Gagne !", "Gewonnen!", "Voce ganhou!", "Hai vinto!"},
+        {"You lost", "Perdiste", "Perdu", "Verloren", "Voce perdeu", "Hai perso"},
+        {"Draw", "Empate", "Egalite", "Unentschieden", "Empate", "Pareggio"},
+        {"Game over", "Fin del juego", "Fin du jeu", "Spiel vorbei", "Fim de jogo", "Fine partita"},
+        {"Time's up", "Se acabo el tiempo", "Temps ecoule", "Zeit ist um", "Tempo esgotado", "Tempo scaduto"}};
+    if (result < MGO_WON || result > MGO_TIMEUP) result = MGO_DRAW;
+    if (lang < 0 || lang >= MGO_LANGS) lang = MGO_LANG_EN;
+    return t[result - 1][lang];
+}
+static inline const char* mgo_button_label_l(int btn, int lang)
+{
+    static const char* const t[2][MGO_LANGS] = {{"Play again", "Otra vez", "Rejouer", "Nochmal", "Outra vez", "Ancora"}, {"Quit", "Salir", "Quitter", "Beenden", "Sair", "Esci"}};
+    if (lang < 0 || lang >= MGO_LANGS) lang = MGO_LANG_EN;
+    return t[btn == MGO_BTN_AGAIN ? 0 : 1][lang];
+}
+static inline const char* mgo_new_best_label_l(int lang)
+{
+    static const char* const t[MGO_LANGS] = {"New best!", "Nuevo record", "Nouveau record", "Neuer Rekord", "Novo recorde", "Nuovo record"};
+    if (lang < 0 || lang >= MGO_LANGS) lang = MGO_LANG_EN;
+    return t[lang];
+}
+
+#define MGO_LOOK_OLD 0
+#define MGO_LOOK_STILL 1
+#define MGO_LOOK_FULL 2
+#define MGO_LOOK_DEFAULT 1     /* the new look, still: the default candidate (owner, 2026-11-19; docs/design/game-over-look.md). Look 2, the motion, is a bench-only level until it meets its gates on the unit */
+
+#define MGO2_BAND_X 56         /* the band of the emblem and the confetti: nothing else moves outside it and the score line */
+#define MGO2_BAND_Y 28
+#define MGO2_BAND_W 208
+#define MGO2_BAND_H 72
+#define MGO2_EMB_X 104         /* the emblem alone, while it drops in: 112 by 72 (the draw's arms need 132: 94 to 226) */
+#define MGO2_EMB_W 112
+#define MGO2_TITLE_Y 100       /* the result word, 24 px font */
+#define MGO2_SCORE_Y 127       /* the score line, 20 px font, counts up */
+#define MGO2_SCORE_X 60
+#define MGO2_SCORE_W 200
+#define MGO2_CHIP_Y 152        /* the best chip, 22 px high */
+#define MGO2_CHIP_H 22
+#define MGO2_ANIM_MS 1700u     /* every motion has ended by now (the callers keep calling set_pop a little longer: MGO_POP_MS) */
+#define MGO2_COUNT_START 200
+#define MGO2_COUNT_MS 700
+#define MGO2_CONFETTI 8       /* eight pieces, four in each of two narrow columns beside the emblem (x 62 to 98 and 222 to 258) */
+#define MGO2_COL_L_X 62
+#define MGO2_COL_R_X 222
+#define MGO2_COL_W 36
+#define MGO2_CONFETTI_END 1700
+#define MGO2_DROP_MS 380
+#define MGO2_MAX_RECTS 40      /* the most rectangles one step can give: 18 confetti pieces and the few parts of an emblem */
+
+/* The easings in permille (0 to 1000; the back easing overshoots a little past 1000). */
+static inline int mgo_ease_out(int p)
+{
+    if (p < 0) p = 0;
+    if (p > 1000) p = 1000;
+    const int q = 1000 - p;
+    return 1000 - (int)((long)q * q * q / 1000000L);
+}
+static inline int mgo_ease_back(int p)
+{
+    if (p < 0) p = 0;
+    if (p > 1000) p = 1000;
+    const double q = (p - 1000) / 1000.0, c1 = 1.70158, c3 = c1 + 1.0;
+    return (int)((1.0 + c3 * q * q * q + c1 * q * q) * 1000.0);
+}
+
+/* How far the emblem is above its place `t` ms after the screen appeared: it drops in from 34 px up with a little overshoot. */
+static inline int mgo_emblem_dy(uint32_t t)
+{
+    if (t >= MGO2_DROP_MS) return 0;
+    return -(34 * (1000 - mgo_ease_back((int)(t * 1000u / MGO2_DROP_MS)))) / 1000;
+}
+
+/* The slow motions (rain, the clock's hand, sparkles, the glint on the cup, the clasp, the count-up) move in steps of 60 ms: what is on the glass is the moment rounded down to 60 ms, so a 30 ms step
+ * between two such moments changes none of their pixels and invalidates nothing for them. The drop of the emblem and the confetti use the exact time. */
+static inline uint32_t mgo_q60(uint32_t t) { return t / 60u * 60u; }
+/* The glint that crosses the cup: its left edge as an offset from the cup's centre, from -14 to +10 between 480 and 900 ms; 0 and not shown outside that. Returns 1 while it shows. */
+static inline int mgo_glint(uint32_t tq, int* dx)
+{
+    if (tq < 480u || tq >= 900u) return 0;
+    *dx = -14 + (int)(24u * (tq - 480u) / 420u);
+    return 1;
+}
+/* How far the clasp rises in its squeeze, 0 to 4 px, between 480 and 720 ms. */
+static inline int mgo_bump(uint32_t tq)
+{
+    if (tq < 480u || tq >= 720u) return 0;
+    const int p = (int)(tq - 480u);
+    return (p < 120 ? p : 240 - p) / 30;
+}
+
+/* The number shown on the score line while it counts up to `target`. */
+static inline int mgo_countup(int target, uint32_t t)
+{
+    if (target <= 0 || t >= (uint32_t)(MGO2_COUNT_START + MGO2_COUNT_MS)) return target;
+    if (t <= (uint32_t)MGO2_COUNT_START) return 0;
+    return (int)((long)target * mgo_ease_out((int)((t - MGO2_COUNT_START) * 1000u / MGO2_COUNT_MS)) / 1000L);
+}
+
+/* The first run of digits in a score line ("Score 66" gives 6, 2 and 66): where it starts, how long it is, its value. Returns 0 when there is none or it is above 99999. */
+static inline int mgo_first_number(const char* s, int* pos, int* len, int* value)
+{
+    for (int i = 0; s != 0 && s[i] != '\0'; i++) {
+        if (s[i] >= '0' && s[i] <= '9') {
+            int n = 0, v = 0;
+            while (s[i + n] >= '0' && s[i + n] <= '9' && n < 6) { v = v * 10 + (s[i + n] - '0'); n++; }
+            if (n >= 6 || (s[i + n] >= '0' && s[i + n] <= '9')) return 0;
+            *pos = i; *len = n; *value = v;
+            return 1;
+        }
+    }
+    return 0;
+}
+
+static inline uint32_t mgo_hash(uint32_t i)
+{
+    i = i * 2654435761u + 40503u;
+    i ^= i >> 15;
+    i *= 2246822519u;
+    i ^= i >> 13;
+    return i;
+}
+
+/* Piece `i` of the confetti `t` ms after the screen appeared (the caller gives the time in 60 ms steps): a small rectangle falling down its column (the even pieces the left one, the odd the right one) at 40 to 90
+ * px a second, so 2 to 5 px a step, wrapping to the top when it reaches the bottom, fading in the last 300 ms. Returns 0 when it is not drawn (not started or over). `color` is an index into the palette the
+ * screen picks (0 to 5). Every piece stays inside its column, so the two columns are all the screen has to redraw. */
+static inline int mgo_confetti(int i, uint32_t t, int* x, int* y, int* w, int* h, int* color, int* opa)
+{
+    if (t >= (uint32_t)MGO2_CONFETTI_END) return 0;
+    const uint32_t hv = mgo_hash((uint32_t)i + 1u);
+    const int t0 = (int)(hv % 400u), v = 40 + (int)((hv >> 16) % 50u);
+    if ((int)t < t0) return 0;
+    *w = 4 + (int)((hv >> 20) % 3u);
+    *h = 6 + (int)((hv >> 22) % 4u);
+    const int col_x = (i & 1) ? MGO2_COL_R_X : MGO2_COL_L_X;
+    *x = col_x + (int)((hv >> 8) % (uint32_t)(MGO2_COL_W - *w));
+    *y = MGO2_BAND_Y + (int)(((uint32_t)(t - (uint32_t)t0) * (uint32_t)v / 1000u) % (uint32_t)(MGO2_BAND_H - *h));
+    *color = (int)((hv >> 26) % 6u);
+    *opa = t > (uint32_t)(MGO2_CONFETTI_END - 300) ? (int)(255u * ((uint32_t)MGO2_CONFETTI_END - t) / 300u) : 255;
+    return 1;
+}
+
+/* Confetti for a win and for a new best. */
+static inline int mgo_has_confetti(int result, int new_best) { return new_best || result == MGO_WON; }
+
+/* What a step of the motion changes on the glass, as few small rectangles as can be: from `before` ms to `after` ms (both since the screen appeared). Everything that moves moves in 60 ms steps (the caller gives
+ * the time rounded down to 60 ms to the drawing), so a 30 ms step between two such moments changes nothing and returns no rectangle. On a 60 ms step: the two confetti columns of a win or a new best (36 by 72
+ * px each), the rain and the tear of a loss (one rectangle), the clasp of a draw (while it squeezes), the clock's hand (Time's up), and the score line while it counts (its text's width, `score_w`, centred).
+ * The emblem of every outcome stands still, the shadows and the backdrop are drawn once, in the frame that shows the screen. Each rectangle is a separate transfer on the unit, so the number of them matters as
+ * much as their area: at most 3 on any step. The last step redraws the moving parts once in their still pose. The screen invalidates exactly these rectangles and the renderer checks that no pixel outside them
+ * changed. Returns how many (at most MGO2_MAX_RECTS). */
+typedef struct { int16_t x, y, w, h; } mgo_rect_t;
+static inline void mgo_set_rect(mgo_rect_t* r, int x, int y, int w, int h) { r->x = (int16_t)x; r->y = (int16_t)y; r->w = (int16_t)w; r->h = (int16_t)h; }
+static inline int mgo_dirty(int result, int new_best, int num_len, int score_w, uint32_t before, uint32_t after, mgo_rect_t* out)
+{
+    int n = 0;
+    if (before >= MGO2_ANIM_MS) return 0;   /* the motion has ended: nothing changes any more */
+    const int last = after >= MGO2_ANIM_MS;
+    if (!(mgo_q60(before) != mgo_q60(after) || last)) return 0;
+    if (mgo_has_confetti(result, new_best)) {
+        mgo_set_rect(&out[n++], MGO2_COL_L_X, MGO2_BAND_Y, MGO2_COL_W, MGO2_BAND_H);
+        mgo_set_rect(&out[n++], MGO2_COL_R_X, MGO2_BAND_Y, MGO2_COL_W, MGO2_BAND_H);
+    } else if (result == MGO_LOST) {
+        mgo_set_rect(&out[n++], 136, 50, 48, 56);   /* the rain and the tear */
+    } else if (result == MGO_DRAW) {
+        if (last || mgo_bump(mgo_q60(before)) || mgo_bump(mgo_q60(after))) mgo_set_rect(&out[n++], 94, 52, 132, 46);
+    } else if (result == MGO_TIMEUP) {
+        mgo_set_rect(&out[n++], 138, 44, 44, 44);   /* the hand */
+    }
+    if (num_len > 0 && score_w > 0 && (before <= (uint32_t)(MGO2_COUNT_START + MGO2_COUNT_MS) + 60u || last)) mgo_set_rect(&out[n++], (320 - score_w) / 2, MGO2_SCORE_Y, score_w, 24);
+    return n;
+}
+
+/* The flourish each moment gets (the unit plays the tones through its tone player at the sound level the household set, 20 ms apart; a game keeps its own clip when it has one):
+ * a short rising run for a win, a slow falling one for a loss, two equal notes for a draw, two falling for a neutral end, a quick glitter for a new best. At most 600 ms in all. */
+typedef struct { uint16_t hz, ms; } mgo_tone_t;
+static const mgo_tone_t MGO_TONES_WON[] = {{523, 90}, {659, 90}, {784, 90}, {1047, 260}};
+static const mgo_tone_t MGO_TONES_LOST[] = {{392, 140}, {330, 140}, {262, 300}};
+static const mgo_tone_t MGO_TONES_DRAW[] = {{440, 140}, {440, 220}};
+static const mgo_tone_t MGO_TONES_OVER[] = {{392, 200}, {330, 320}};
+static const mgo_tone_t MGO_TONES_TIMEUP[] = {{880, 80}, {880, 80}, {660, 260}};
+static const mgo_tone_t MGO_TONES_NEW_BEST[] = {{784, 70}, {988, 70}, {1175, 70}, {1568, 70}, {2093, 320}};
+static inline int mgo_tones(int result, int new_best, const mgo_tone_t** out)
+{
+    if (new_best) { *out = MGO_TONES_NEW_BEST; return (int)(sizeof(MGO_TONES_NEW_BEST) / sizeof(MGO_TONES_NEW_BEST[0])); }
+    switch (result) {
+        case MGO_WON: *out = MGO_TONES_WON; return (int)(sizeof(MGO_TONES_WON) / sizeof(MGO_TONES_WON[0]));
+        case MGO_LOST: *out = MGO_TONES_LOST; return (int)(sizeof(MGO_TONES_LOST) / sizeof(MGO_TONES_LOST[0]));
+        case MGO_OVER: *out = MGO_TONES_OVER; return (int)(sizeof(MGO_TONES_OVER) / sizeof(MGO_TONES_OVER[0]));
+        case MGO_TIMEUP: *out = MGO_TONES_TIMEUP; return (int)(sizeof(MGO_TONES_TIMEUP) / sizeof(MGO_TONES_TIMEUP[0]));
+        default: *out = MGO_TONES_DRAW; return (int)(sizeof(MGO_TONES_DRAW) / sizeof(MGO_TONES_DRAW[0]));
+    }
+}
+
 #endif
