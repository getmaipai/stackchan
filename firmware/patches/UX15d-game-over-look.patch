+struct Pen {
+    lv_layer_t* L;
+    int ox, oy;
+};
+inline void pen_fill(const Pen& p, int x, int y, int w, int h, int r, uint32_t c, int opa = 255)
+{
+    if (w < 1 || h < 1) return;
+    lv_draw_rect_dsc_t d;
+    lv_draw_rect_dsc_init(&d);
+    d.base.layer = p.L;
+    d.bg_color = lv_color_hex(c);
+    d.bg_opa = static_cast<lv_opa_t>(opa);
+    d.radius = r;
+    const lv_area_t a = {static_cast<lv_coord_t>(p.ox + x), static_cast<lv_coord_t>(p.oy + y), static_cast<lv_coord_t>(p.ox + x + w - 1), static_cast<lv_coord_t>(p.oy + y + h - 1)};
+    lv_draw_rect(p.L, &d, &a);
+}
+// A box with a vertical gradient (top c1, bottom c2), an optional rim and an optional soft shadow (static things only).
+inline void pen_grad(const Pen& p, int x, int y, int w, int h, int r, uint32_t c1, uint32_t c2, int bw = 0, uint32_t bc = 0, int shadow = 0, int shadow_dy = 0)
+{
+    lv_draw_rect_dsc_t d;
+    lv_draw_rect_dsc_init(&d);
+    d.base.layer = p.L;
+    d.bg_color = lv_color_hex(c1);
+    d.bg_opa = LV_OPA_COVER;
+    d.bg_grad.dir = LV_GRAD_DIR_VER;
+    d.bg_grad.stops_count = 2;
+    d.bg_grad.stops[0].color = lv_color_hex(c1);
+    d.bg_grad.stops[0].opa = LV_OPA_COVER;
+    d.bg_grad.stops[0].frac = 0;
+    d.bg_grad.stops[1].color = lv_color_hex(c2);
+    d.bg_grad.stops[1].opa = LV_OPA_COVER;
+    d.bg_grad.stops[1].frac = 255;
+    d.radius = r;
+    if (bw > 0) {
+        d.border_width = bw;
+        d.border_color = lv_color_hex(bc);
+    }
+    if (shadow > 0) {
+        d.shadow_width = shadow;
+        d.shadow_offset_y = shadow_dy;
+        d.shadow_color = lv_color_black();
+        d.shadow_opa = LV_OPA_50;
+    }
+    const lv_area_t a = {static_cast<lv_coord_t>(p.ox + x), static_cast<lv_coord_t>(p.oy + y), static_cast<lv_coord_t>(p.ox + x + w - 1), static_cast<lv_coord_t>(p.oy + y + h - 1)};
+    lv_draw_rect(p.L, &d, &a);
+}
+inline void pen_disc(const Pen& p, int cx, int cy, int rad, uint32_t c, int opa = 255) { pen_fill(p, cx - rad, cy - rad, 2 * rad, 2 * rad, LV_RADIUS_CIRCLE, c, opa); }
+inline void pen_ring(const Pen& p, int cx, int cy, int rad, int bw, uint32_t c, uint32_t inner = 0, bool fill_inner = false)
+{
+    lv_draw_rect_dsc_t d;
+    lv_draw_rect_dsc_init(&d);
+    d.base.layer = p.L;
+    d.bg_opa = fill_inner ? LV_OPA_COVER : LV_OPA_TRANSP;
+    d.bg_color = lv_color_hex(inner);
+    d.radius = LV_RADIUS_CIRCLE;
+    d.border_width = bw;
+    d.border_color = lv_color_hex(c);
+    const lv_area_t a = {static_cast<lv_coord_t>(p.ox + cx - rad), static_cast<lv_coord_t>(p.oy + cy - rad), static_cast<lv_coord_t>(p.ox + cx + rad - 1), static_cast<lv_coord_t>(p.oy + cy + rad - 1)};
+    lv_draw_rect(p.L, &d, &a);
+}
+inline void pen_seg(const Pen& p, int x1, int y1, int x2, int y2, int w, uint32_t c, int opa = 255)
+{
+    lv_draw_line_dsc_t d;
+    lv_draw_line_dsc_init(&d);
+    d.base.layer = p.L;
+    d.color = lv_color_hex(c);
+    d.width = w;
+    d.opa = static_cast<lv_opa_t>(opa);
+    d.round_start = d.round_end = 1;
+    d.p1.x = p.ox + x1;
+    d.p1.y = p.oy + y1;
+    d.p2.x = p.ox + x2;
+    d.p2.y = p.oy + y2;
+    lv_draw_line(p.L, &d);
+}
+inline void pen_arc(const Pen& p, int cx, int cy, int rad, int a0, int a1, int w, uint32_t c)
+{
+    lv_draw_arc_dsc_t d;
+    lv_draw_arc_dsc_init(&d);
+    d.base.layer = p.L;
+    d.color = lv_color_hex(c);
+    d.width = w;
+    d.rounded = 1;
+    d.center.x = p.ox + cx;
+    d.center.y = p.oy + cy;
+    d.radius = rad;
+    d.start_angle = a0;
+    d.end_angle = a1;
+    lv_draw_arc(p.L, &d);
+}
+inline void pen_text(const Pen& p, const char* s, const lv_font_t* f, uint32_t c, int x, int y, int w, int opa = 255)
+{
+    lv_draw_label_dsc_t d;
+    lv_draw_label_dsc_init(&d);
+    d.base.layer = p.L;
+    d.font = f;
+    d.color = lv_color_hex(c);
+    d.opa = static_cast<lv_opa_t>(opa);
+    d.align = LV_TEXT_ALIGN_CENTER;
+    d.text = s;
+    const lv_area_t a = {static_cast<lv_coord_t>(p.ox + x), static_cast<lv_coord_t>(p.oy + y), static_cast<lv_coord_t>(p.ox + x + w - 1), static_cast<lv_coord_t>(p.oy + y + lv_font_get_line_height(f))};
+    lv_draw_label(p.L, &d, &a);
+}
+inline int pen_text_w(const char* s, const lv_font_t* f)
+{
+    lv_point_t sz;
+    lv_text_get_size(&sz, s, f, 0, 0, LV_COORD_MAX, LV_TEXT_FLAG_NONE);
+    return sz.x;
+}
+
+inline void backdrop_colors(int result, bool new_best, uint32_t* top, uint32_t* bottom)
+{
+    if (new_best) { *top = 0x3A1F5E; *bottom = 0x0B0612; return; }
+    switch (result) {
+        case MGO_WON: *top = 0x4A3508; *bottom = 0x0A0802; break;
+        case MGO_LOST: *top = 0x1A2A44; *bottom = 0x07090E; break;
+        case MGO_OVER: case MGO_TIMEUP: *top = 0x3A3220; *bottom = 0x0C0B08; break;
+        default: *top = 0x2C3038; *bottom = 0x0A0B0D; break;
+    }
+}
+inline uint32_t word_color(int result, bool new_best)
+{
+    if (new_best) return 0xFFFFFF;
+    return result == MGO_WON ? 0xFFD76A : (result == MGO_LOST ? 0xB9D0F2 : (result == MGO_OVER || result == MGO_TIMEUP) ? 0xF0E2B8 : 0xE8E8E8);
+}
+
+// The emblems: only primitives. `t` is the time since the screen appeared (look 1 draws the last frame of the motion), `mv` true when the motion is on.
+inline void emblem_won(const Pen& p, int dy, uint32_t t, bool mv)
+{
+    const int cx = 160, cy = 64 + dy;
+    for (int k = 0; k < 12; k++) {
+        const float a = static_cast<float>(k * 30) * 3.14159265f / 180.0f, c = cosf(a), s = sinf(a);
+        const int r1 = (k & 1) ? 38 : 47;
+        pen_seg(p, cx + static_cast<int>(c * 27.0f), cy + static_cast<int>(s * 27.0f), cx + static_cast<int>(c * static_cast<float>(r1)), cy + static_cast<int>(s * static_cast<float>(r1)), 4, 0x9A7424);
+    }
+    pen_ring(p, cx - 27, cy + 1, 9, 4, 0xD9951F);                    // the handles
+    pen_ring(p, cx + 27, cy + 1, 9, 4, 0xD9951F);
+    pen_fill(p, cx - 4, cy + 16, 8, 9, 0, 0xC98A1A);                  // the stem
+    pen_grad(p, cx - 15, cy + 24, 30, 8, 3, 0xE0A22A, 0xB87814);      // the base
+    pen_grad(p, cx - 18, cy - 12, 36, 29, 13, 0xFFD76A, 0xD9951F);    // the cup
+    pen_fill(p, cx - 21, cy - 15, 42, 6, 3, 0xFFE9A8);                // the lip
+    pen_fill(p, cx - 12, cy - 6, 4, 16, 2, 0xFFF6D8);                 // the shine
+    pen_disc(p, cx + 3, cy + 2, 4, 0xFFF3C0);
+}
+inline void emblem_lost(const Pen& p, int dy, uint32_t t, bool mv)
+{
+    const int cx = 160;
+    const int cc = 40 + dy;                                           // the cloud
+    pen_disc(p, cx - 14, cc, 11, 0xA9B4C8);
+    pen_disc(p, cx + 3, cc - 6, 14, 0xB7C1D4);
+    pen_disc(p, cx + 18, cc, 11, 0xA9B4C8);
+    pen_fill(p, cx - 25, cc - 2, 51, 13, 6, 0xA9B4C8);
+    pen_fill(p, cx - 25, cc + 7, 51, 4, 2, 0x8D99B0);
+    for (int i = 0; i < 5; i++) {                                     // the rain falls from the cloud to the face
+        const int y0 = 52 + dy + (mv ? static_cast<int>((t * 9u / 100u + static_cast<uint32_t>(i * 7)) % 12u) : (i * 5) % 12);
+        pen_seg(p, cx - 18 + i * 9, y0, cx - 20 + i * 9, y0 + 6, 2, 0x7FB4FF);
+    }
+    const int fy = 82 + dy;                                           // the face: droopy and kind
+    pen_grad(p, cx - 18, fy - 18, 36, 36, LV_RADIUS_CIRCLE, 0x9DBBE6, 0x6F8FBF);
+    pen_disc(p, cx - 12, fy + 8, 4, 0xE79AB0);
+    pen_disc(p, cx + 12, fy + 8, 4, 0xE79AB0);
+    pen_disc(p, cx - 7, fy - 2, 4, 0xFFFFFF);
+    pen_disc(p, cx + 7, fy - 2, 4, 0xFFFFFF);
+    pen_disc(p, cx - 7, fy, 2, 0x10141C);
+    pen_disc(p, cx + 7, fy, 2, 0x10141C);
+    pen_seg(p, cx - 12, fy - 6, cx - 4, fy - 10, 2, 0x2A3550);        // brows that slant up toward the middle
+    pen_seg(p, cx + 12, fy - 6, cx + 4, fy - 10, 2, 0x2A3550);
+    pen_arc(p, cx, fy + 15, 6, 200, 340, 3, 0x10141C);                // a small frown
+    pen_disc(p, cx - 7, fy + 4 + (mv ? static_cast<int>(t / 24u % 9u) : 2), 2, 0xBEE3FF);   // one tear
+}
+inline void emblem_draw(const Pen& p, int dy, uint32_t t, bool mv)
+{
+    const int cx = 160, cy = 68 + dy, up = mv ? mgo_bump(t) : 0;
+    pen_seg(p, 108, cy + 20, 146, cy + 2 - up, 18, 0x7FA0D0);         // two arms meeting: one blue, one amber
+    pen_seg(p, 212, cy + 20, 174, cy + 2 - up, 18, 0xF2B24A);
+    pen_fill(p, 96, cy + 8, 11, 26, 4, 0x4E6A96);
+    pen_fill(p, 213, cy + 8, 11, 26, 4, 0xB07F24);
+    pen_grad(p, cx - 17, cy - 12 - up, 34, 26, 10, 0xF3EFE2, 0xCFC8B4);    // the clasp, squeezed up a little once
+    for (int i = 0; i < 3; i++) pen_seg(p, cx - 7 + i * 7, cy - 6 - up, cx - 7 + i * 7, cy + 4 - up, 2, 0x8E8672);
+}
+inline void emblem_over(const Pen& p, int dy)                         // a finish flag
+{
+    pen_seg(p, 148, 40 + dy, 148, 94 + dy, 4, 0xB8B2A0);
+    for (int r = 0; r < 3; r++)
+        for (int c = 0; c < 5; c++) pen_fill(p, 152 + c * 10, 40 + dy + r * 10, 10, 10, 0, ((r + c) & 1) ? 0x1A1A1A : 0xF4F1E8);
+    pen_disc(p, 148, 38 + dy, 4, 0xF0E2B8);
 }
+inline void emblem_timeup(const Pen& p, int dy, uint32_t t, bool mv)  // a clock with a sweeping hand
+{
+    const int cx = 160, cy = 66 + dy;
+    pen_ring(p, cx, cy, 28, 5, 0xE9D9A8, 0x1B1A14, true);
+    for (int k = 0; k < 12; k++) {
+        const float a = static_cast<float>(k * 30) * 3.14159265f / 180.0f;
+        pen_seg(p, cx + static_cast<int>(sinf(a) * 21.0f), cy - static_cast<int>(cosf(a) * 21.0f), cx + static_cast<int>(sinf(a) * 23.0f), cy - static_cast<int>(cosf(a) * 23.0f), 2, 0xE9D9A8);
+    }
+    pen_seg(p, cx, cy, cx, cy - 15, 3, 0xF0E2B8);
+    pen_seg(p, cx, cy, cx + 9, cy + 5, 3, 0xF0E2B8);
+    const float s = (mv ? static_cast<float>(t) * 0.36f : 180.0f) * 3.14159265f / 180.0f;
+    pen_seg(p, cx, cy, cx + static_cast<int>(sinf(s) * 19.0f), cy - static_cast<int>(cosf(s) * 19.0f), 2, 0xFF6A5A);
+    pen_disc(p, cx, cy, 3, 0xFF6A5A);
+}
+inline void emblem_new_best(const Pen& p, int dy, uint32_t t, bool mv)  // a crown over a ribbon
+{
+    const int cx = 160;
+    pen_seg(p, cx - 38, 84 + dy, cx - 48, 98 + dy, 10, 0x5B35A8);     // the ribbon's tails, behind its band
+    pen_seg(p, cx + 38, 84 + dy, cx + 48, 98 + dy, 10, 0x5B35A8);
+    pen_grad(p, cx - 44, 76 + dy, 88, 14, 3, 0x9066E8, 0x6A3FC8);
+    pen_seg(p, cx - 20, 62 + dy, cx - 24, 44 + dy, 8, 0xE8A82A);      // the crown's three spikes
+    pen_seg(p, cx, 62 + dy, cx, 38 + dy, 8, 0xE8A82A);
+    pen_seg(p, cx + 20, 62 + dy, cx + 24, 44 + dy, 8, 0xE8A82A);
+    pen_grad(p, cx - 26, 58 + dy, 52, 12, 3, 0xFFD76A, 0xD9951F);
+    pen_disc(p, cx - 24, 41 + dy, 4, 0xFF5A5A);
+    pen_disc(p, cx, 35 + dy, 4, 0xFFFFFF);
+    pen_disc(p, cx + 24, 41 + dy, 4, 0xFF5A5A);
+    pen_disc(p, cx - 14, 64 + dy, 3, 0x4FA0FF);
+    pen_disc(p, cx, 64 + dy, 3, 0x4FA0FF);
+    pen_disc(p, cx + 14, 64 + dy, 3, 0x4FA0FF);
+    static const int8_t sp[4][2] = {{-62, 50}, {62, 56}, {-56, 86}, {58, 90}};   // four sparkles
+    for (int i = 0; i < 4; i++) {   // four sparkles, still
+        const int len = 5;
+        pen_seg(p, cx + sp[i][0] - len, sp[i][1] + dy, cx + sp[i][0] + len, sp[i][1] + dy, 2, 0xFFFFFF);
+        pen_seg(p, cx + sp[i][0], sp[i][1] + dy - len, cx + sp[i][0], sp[i][1] + dy + len, 2, 0xFFFFFF);
+    }
+}
+inline uint32_t confetti_color(int idx, bool gold)
+{
+    static const uint32_t multi[6] = {0xFF5A5A, 0xFFD76A, 0x5AD28C, 0x4FA0FF, 0xE070FF, 0xFFFFFF};
+    static const uint32_t golds[6] = {0xFFD76A, 0xE8A82A, 0xFFF3C0, 0x9066E8, 0xFFD76A, 0xFFFFFF};
+    return gold ? golds[idx] : multi[idx];
+}
 
+inline void button(const Pen& p, const State* s, int btn, bool shadows)
+{
+    int x, y, w, h;
+    mgo_button(btn, &x, &y, &w, &h);
+    const bool down = s->pressed == btn, again = btn == MGO_BTN_AGAIN;
+    if (down) {
+        pen_fill(p, x, y + 1, w, h - 1, 12, again ? 0x1C2A6A : 0x1A1C20);
+    } else {
+        pen_grad(p, x, y, w, h, 12, again ? 0x3E5CC0 : 0x3A3D45, again ? 0x25388A : 0x23252B, 1, again ? 0x7FA0F0 : 0x5A5F6B, shadows ? 6 : 0, 3);
+        pen_fill(p, x + 12, y + 3, w - 24, 1, 0, 0xFFFFFF, 60);   // a thin light along the top edge
+    }
+    const char* label = mgo_button_label_l(btn, s->lang);
+    pen_text(p, label, &lv_font_montserrat_20, 0xFFFFFF, x, y + (h - lv_font_get_line_height(&lv_font_montserrat_20)) / 2 + (down ? 2 : 0), w);
+}
+
+// The one draw callback: everything the screen shows, from the state and the time. The clip LVGL gives (the dirty area) decides what is really drawn.
+inline void draw_cb(lv_event_t* e)
+{
+    State* s = static_cast<State*>(lv_event_get_user_data(e));
+    lv_layer_t* layer = lv_event_get_layer(e);
+    if (s == nullptr || layer == nullptr) return;
+    lv_area_t cv;
+    lv_obj_get_coords(s->canvas, &cv);
+    const Pen p = {layer, cv.x1, cv.y1};
+    const bool mv = s->look >= MGO_LOOK_FULL && s->t < MGO2_ANIM_MS;   // false at look 1 and once the motion has ended: every part in its still pose
+    const uint32_t t = mv ? s->t : MGO2_ANIM_MS, tq = mgo_q60(t);    // t exact for the drop and the confetti, tq (60 ms steps) for the slow parts
+    uint32_t top, bottom;
+    backdrop_colors(s->result, s->new_best, &top, &bottom);
+    pen_grad(p, 0, 0, MGO_W, MGO_H, 0, top, bottom);
+    // the emblem and the confetti live in their band: the clip keeps every stroke inside it
+    const lv_area_t clip0 = layer->_clip_area;
+    const lv_area_t band = {static_cast<lv_coord_t>(cv.x1 + MGO2_BAND_X), static_cast<lv_coord_t>(cv.y1 + MGO2_BAND_Y), static_cast<lv_coord_t>(cv.x1 + MGO2_BAND_X + MGO2_BAND_W - 1),
+                            static_cast<lv_coord_t>(cv.y1 + MGO2_BAND_Y + MGO2_BAND_H - 1)};
+    lv_area_t in;
+    const int x1 = clip0.x1 > band.x1 ? clip0.x1 : band.x1, y1 = clip0.y1 > band.y1 ? clip0.y1 : band.y1, x2 = clip0.x2 < band.x2 ? clip0.x2 : band.x2, y2 = clip0.y2 < band.y2 ? clip0.y2 : band.y2;
+    if (x1 <= x2 && y1 <= y2) {
+        in.x1 = static_cast<lv_coord_t>(x1); in.y1 = static_cast<lv_coord_t>(y1); in.x2 = static_cast<lv_coord_t>(x2); in.y2 = static_cast<lv_coord_t>(y2);
+        layer->_clip_area = in;
+        const int dy = 0;   // the emblem stands still: only the confetti, the rain, the clasp, the hand and the count move
+        if (s->new_best) emblem_new_best(p, dy, tq, mv);
+        else if (s->result == MGO_WON) emblem_won(p, dy, tq, mv);
+        else if (s->result == MGO_LOST) emblem_lost(p, dy, tq, mv);
+        else if (s->result == MGO_OVER) emblem_over(p, dy);
+        else if (s->result == MGO_TIMEUP) emblem_timeup(p, dy, tq, mv);
+        else emblem_draw(p, dy, tq, mv);
+        if (mv && mgo_has_confetti(s->result, s->new_best)) {
+            for (int i = 0; i < MGO2_CONFETTI; i++) {
+                int x, y, w, h, c, o;
+                if (mgo_confetti(i, tq, &x, &y, &w, &h, &c, &o)) pen_fill(p, x, y, w, h, i % 3 == 0 ? LV_RADIUS_CIRCLE : 1, confetti_color(c, s->new_best), o);
+            }
+        }
+        layer->_clip_area = clip0;
+    }
+    // the result word, with a dark shadow under it so it reads on any backdrop
+    const char* title = mgo_title_l(s->result, s->lang);
+    pen_text(p, title, &lv_font_montserrat_24, 0x000000, 0, MGO2_TITLE_Y + 2, MGO_W, 150);
+    pen_text(p, title, &lv_font_montserrat_24, word_color(s->result, s->new_best), 0, MGO2_TITLE_Y, MGO_W);
+    if (s->score[0] != '\0') {
+        char line[56];
+        snprintf(line, sizeof(line), "%s", s->score);
+        if (mv && s->num_len > 0) {
+            char num[12];
+            snprintf(num, sizeof(num), "%d", mgo_countup(s->num_val, tq));
+            snprintf(line, sizeof(line), "%.*s%s%s", s->num_pos, s->score, num, s->score + s->num_pos + s->num_len);
+        }
+        pen_text(p, line, &lv_font_montserrat_20, 0xFFFFFF, 0, MGO2_SCORE_Y, MGO_W);
+    }
+    const char* chip = s->new_best ? mgo_new_best_label_l(s->lang) : s->best;
+    if (chip != nullptr && chip[0] != '\0') {
+        const int w = pen_text_w(chip, &lv_font_montserrat_16) + 28, x = (MGO_W - w) / 2;
+        if (s->new_best) {
+            pen_grad(p, x, MGO2_CHIP_Y, w, MGO2_CHIP_H, MGO2_CHIP_H / 2, 0xFFD76A, 0xE09A1E);
+            pen_text(p, chip, &lv_font_montserrat_16, 0x2A1A00, x, MGO2_CHIP_Y + 2, w);
+        } else {
+            pen_fill(p, x, MGO2_CHIP_Y, w, MGO2_CHIP_H, MGO2_CHIP_H / 2, 0x000000, 90);
+            pen_text(p, chip, &lv_font_montserrat_16, 0xB4BCC8, x, MGO2_CHIP_Y + 2, w);
+        }
+    }
+    button(p, s, MGO_BTN_AGAIN, s->look >= MGO_LOOK_FULL);
+    button(p, s, MGO_BTN_QUIT, s->look >= MGO_LOOK_FULL);
+}
+inline void state_deleted(lv_event_t* e) { lv_free(lv_event_get_user_data(e)); }
+
+inline void invalidate(const Screen& s, int x, int y, int w, int h)
+{
+    const lv_area_t a = {static_cast<lv_coord_t>(x), static_cast<lv_coord_t>(y), static_cast<lv_coord_t>(x + w - 1), static_cast<lv_coord_t>(y + h - 1)};
+    lv_obj_invalidate_area(s.icon, &a);
+}
+
+inline Screen build_new(lv_obj_t* parent, int result, const char* score_text, const char* best_text, bool new_best, int lang, int look)
+{
+    Screen s = {};
+    s.root = lv_obj_create(parent);
+    lv_obj_remove_style_all(s.root);
+    lv_obj_remove_flag(s.root, LV_OBJ_FLAG_SCROLLABLE);
+    lv_obj_set_size(s.root, MGO_W, MGO_H);
+    lv_obj_set_pos(s.root, 0, 0);
+    s.icon = lv_obj_create(s.root);
+    lv_obj_remove_style_all(s.icon);
+    lv_obj_remove_flag(s.icon, LV_OBJ_FLAG_CLICKABLE);
+    lv_obj_remove_flag(s.icon, LV_OBJ_FLAG_SCROLLABLE);
+    lv_obj_set_size(s.icon, MGO_W, MGO_H);
+    lv_obj_set_pos(s.icon, 0, 0);
+    s.st = static_cast<State*>(lv_malloc(sizeof(State)));
+    if (s.st == nullptr) return s;
+    memset(s.st, 0, sizeof(State));
+    s.st->canvas = s.icon;
+    s.st->result = result;
+    s.st->lang = lang;
+    s.st->look = look;
+    s.st->new_best = new_best;
+    snprintf(s.st->score, sizeof(s.st->score), "%s", score_text != nullptr ? score_text : "");
+    snprintf(s.st->best, sizeof(s.st->best), "%s", best_text != nullptr ? best_text : "");
+    if (!mgo_first_number(s.st->score, &s.st->num_pos, &s.st->num_len, &s.st->num_val)) s.st->num_len = 0;
+    s.st->score_w = pen_text_w(s.st->score, &lv_font_montserrat_20) + 12;
+    if (s.st->score_w > MGO_W) s.st->score_w = MGO_W;
+    lv_obj_add_event_cb(s.icon, draw_cb, LV_EVENT_DRAW_MAIN, s.st);
+    lv_obj_add_event_cb(s.icon, state_deleted, LV_EVENT_DELETE, s.st);
+    return s;
+}
+
+// The motion, `elapsed` ms after the screen appeared (called from the game's tick until MGO_POP_MS has passed): invalidates only what moves this tick.
+inline void set_pop_new(const Screen& s, uint32_t elapsed)
+{
+    State* st = s.st;
+    if (st == nullptr || st->look < MGO_LOOK_FULL) return;
+    if (elapsed > MGO2_ANIM_MS) elapsed = MGO2_ANIM_MS;
+    if (st->settled && elapsed >= MGO2_ANIM_MS) return;
+    const uint32_t before = st->t;
+    st->t = elapsed;
+    if (elapsed >= MGO2_ANIM_MS) st->settled = true;
+    mgo_rect_t r[MGO2_MAX_RECTS];
+    const int n = mgo_dirty(st->result, st->new_best, st->num_len, st->score_w, before, elapsed, r);
+    for (int i = 0; i < n; i++) invalidate(s, r[i].x, r[i].y, r[i].w, r[i].h);
+}
+
+// The pressed state of a button (MGO_BTN_AGAIN, MGO_BTN_QUIT, or MGO_BTN_NONE to let go): the game's touch handler calls it on touch down and again on release.
+inline void set_pressed(const Screen& s, int btn)
+{
+    if (s.st == nullptr || s.st->pressed == btn) return;
+    s.st->pressed = btn;
+    int x, y, w, h;
+    mgo_button(MGO_BTN_AGAIN, &x, &y, &w, &h);
+    invalidate(s, x - 10, y - 4, 2 * MGO_BTN_W + MGO_BTN_GAP + 20, MGO_BTN_H + 14);
+}
+
 // result: MGO_WON, MGO_LOST, MGO_DRAW, or for a game with no winner MGO_OVER or MGO_TIMEUP (a calm face, no verdict). score_text is the game's own score line ("Score 66", "Cleared in 96 s", "Length 31"), best_text its best line ("Best 70"); both may be empty.
