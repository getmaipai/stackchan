+void track_move(const ft_out_t& o)
+{
+    // Pan goes through the path every seek move takes: the remote-session gate, source user, the 100 to 150 speed.
+    op_head(nullptr, o.pan_deg, o.speed_pct, o.reason == FT_REASON_RETURN ? MS_REASON_RETURN : MS_REASON_FOLLOW);
+#if CONFIG_MAIPAI_FACE_TRACK_TILT
+    if (o.has_tilt && head_ready() && maipai_remote_gate("move_near", "user", 0)) {
+        int speed = 150 * static_cast<int>(o.speed_pct) / 100;
+        if (speed < 100) speed = 100;
+        const int tilt = static_cast<int>(o.tilt_deg >= 0 ? o.tilt_deg + 0.5f : o.tilt_deg - 0.5f);
+        LvglLockGuard lock;
+        GetStackChan().motion().pitchServo().moveWithSpeed(tilt * 10, speed);
+    }
+#endif
+}
