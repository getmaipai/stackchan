+// One pass, after the seek core's own pass: builds the inputs from what the seek core already read, runs the loop, asks the detector
+// for frames while it wants them and moves the head. Reads the head about every 100 ms while it is not off; at rest it reads nothing.
+void track_step()
+{
+    if (s_ft == nullptr) return;
+    const uint32_t now = ms_now();
+    ft_in_t in;
+    memset(&in, 0, sizeof(in));
+    in.now_ms = now;
+    in.armed  = s_track_armed.load() ? 1 : 0;
+    const mw_env_t& e = s_env;
+    in.gates_ok       = e.awake && !e.muted && !e.privacy_sleep && !e.vision_off && !e.full_quiet;
+    in.mode           = s_mode.load();  // the setting itself: the core's copy reads off while the tracker holds the head
+    in.conversation   = e.conversation;
+    in.head_settled   = e.head_settled;
+    in.quiet_or_night = e.quiet_or_night;
+    xSemaphoreTake(s_mu, portMAX_DELAY);
+    in.leased      = ms_lease_active(&s_w->seek.lease, now) ? 1 : 0;
+    in.blob_recent = (s_w->seek.seen_any && ms_dt(now, s_w->seek.last_seen) < 3000) ? 1 : 0;
+    // The seek core is mid run (a look, a sweep, a turn) or a calibration pans the head: the tracker waits for it.
+    const uint8_t cs = s_w->seek.state;
+    in.remote_busy   = (s_w->cal.state == MW_CAL_RUN || (!s_track_own.load() && cs != MS_IDLE && cs != MS_HOLD && cs != MS_COOL)) ? 1 : 0;
+    s_ft->cfg.x_sign    = s_w->seek.x_sign;
+    s_ft->cfg.fov_h_deg = s_w->seek.fov_deg;
+    xSemaphoreGive(s_mu);
+    in.locked  = (maipai_lock_locked != nullptr && maipai_lock_locked()) ? 1 : 0;
+    in.carried = maipai_pickup_held() ? 1 : 0;
+    if (s_ft->state != FT_OFF && ms_dt(now, s_trk_read_at) >= 100) {  // the head, for the picture-time angle
+        s_trk_pan     = read_pan();
+        s_trk_tilt    = s_ft->cfg.tilt ? read_tilt() : 0.0f;
+        s_trk_read_at = now;
+        ft_hist_add(s_ft, now, s_trk_pan, s_trk_tilt);
+    }
+    in.pan_deg  = s_trk_pan;
+    in.tilt_deg = s_trk_tilt;
+    // The newest detection: a run that found nothing is a miss (the detector publishes faces only, so runs tell misses).
+    FdStatus st;
+    maipai_fd_status(&st);
+    if (st.runs != s_trk_runs) {
+        s_trk_runs = st.runs;
+        s_trk_seq++;
+        if (st.face.valid && st.face.seq != s_trk_face_seq) {
+            s_trk_face_seq = st.face.seq;
+            in.face_valid  = 1;
+            in.face_cx     = st.face.cx;
+            in.face_cy     = st.face.cy;
+            in.face_w      = st.face.w;
+            in.face_score  = st.face.score;
+            in.face_at_ms  = st.face.at_ms;
+        } else {
+            in.face_at_ms = now - 100;
+        }
+    }
+    in.face_seq = s_trk_seq;
+    ft_out_t out;
+    xSemaphoreTake(s_mu, portMAX_DELAY);  // the status tool reads the same state
+    ft_tick(s_ft, &in, &out);
+    const uint8_t ft_state = s_ft->state;
+    xSemaphoreGive(s_mu);
+    s_track_own.store(out.own != 0);
+    s_track_active.store(ft_state != FT_OFF);
+    if (out.want_detect) maipai_fd_want(600, FD_CROP_FOLLOW);  // renewed every pass: it stops within 600 ms of the last one
+    if (out.move) {
+        ESP_LOGW(TAG, "track move: pan %d (from %d) %s", static_cast<int>(out.pan_deg), static_cast<int>(in.pan_deg), FT_STATE_NAMES[out.state]);
+        track_move(out);
+    }
+}
