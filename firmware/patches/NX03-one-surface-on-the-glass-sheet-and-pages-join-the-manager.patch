+/* ---- patch NX03: one rule for everything that can be on the glass ----
+ * Opening the Apps wall from the quick sheet while the games swipe page was open drew both screens over each other: the sheet closed back to
+ * the page it covered and the Apps wall then opened on top of it. The rule now: a sheet may sit over the face or a swipe page (that is what it
+ * is for); everything else is exclusive. Entering any surface returns the mask of the surfaces that must close first, and the state keeps the
+ * set that is visible, so there are never two overlay screens at once. */
+#define MSCR_BIT(id) (1u << (id))
+#define MSCR_SHEET_OVER MSCR_BIT(MSCR_PAGE) /* what the sheet may cover */
+
+static inline unsigned mscr_conflicts(int entering, unsigned visible)
+{
+    unsigned m = visible & ~MSCR_BIT(entering);
+    if (entering == MSCR_SHEET) {
+        m &= ~MSCR_SHEET_OVER;
+    }
+    return m;
+}
+
+/* A surface opens. Returns the mask of surfaces to close first; they are removed from the visible set and `id` joins it. */
+static inline unsigned mscr_enter(mscr_t* s, int id)
+{
+    if (id < 0 || id >= MSCR_COUNT) {
+        return 0;
+    }
+    const unsigned close = mscr_conflicts(id, s->visible_mask);
+    s->visible_mask = (uint16_t)((s->visible_mask & ~close) | MSCR_BIT(id));
+    s->cur = (int8_t)id;
+    return close;
+}
+
+/* A surface has closed (or was closed). The current one falls back to what is still visible: the page under a closed sheet, else none. */
+static inline void mscr_exit(mscr_t* s, int id)
+{
+    if (id < 0 || id >= MSCR_COUNT) {
+        return;
+    }
+    s->visible_mask = (uint16_t)(s->visible_mask & ~MSCR_BIT(id));
+    if (s->cur == id) {
+        s->cur = MSCR_NONE;
+        for (int i = 0; i < MSCR_COUNT; i++) {
+            if (s->visible_mask & MSCR_BIT(i)) {
+                s->cur = (int8_t)i;
+            }
+        }
+    }
+}
+
+/* The invariant the glass must keep: at most one surface that is not the sheet, and the sheet only over a swipe page or the face. */
+static inline int mscr_valid(const mscr_t* s)
+{
+    const unsigned others = s->visible_mask & ~MSCR_BIT(MSCR_SHEET);
+    int n = 0;
+    for (int i = 0; i < MSCR_COUNT; i++) {
+        n += (int)((others >> i) & 1u);
+    }
+    if (n > 1) {
+        return 0;
+    }
+    if ((s->visible_mask & MSCR_BIT(MSCR_SHEET)) && (others & ~MSCR_SHEET_OVER) != 0) {
+        return 0;
+    }
+    return 1;
+}
+
 #endif /* MAIPAI_SCREENS_CORE_H */
