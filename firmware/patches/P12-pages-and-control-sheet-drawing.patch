+// ---- Dashboard tiles ----
+void build_tiles(lv_obj_t* root)
+{
+    title(root, MPG_P_TILES);
+    pager(root);
+    uint32_t age = 0;
+    const mpg_tiles_t* t = s_host->tiles(&age);
+    if (t == nullptr || t->n == 0) {
+        lv_obj_t* none = text(root, tx("Nothing to show yet. Your home hub sends the tiles.", "Nada que mostrar todavia. Tu centro del hogar envia los paneles."), kSmall, fg(70));
+        lv_obj_set_width(none, 280);
+        lv_obj_set_style_text_align(none, LV_TEXT_ALIGN_CENTER, 0);
+        lv_obj_set_pos(none, 20, 52);
+        return;
+    }
+    const bool stale = age >= MPG_TILES_STALE_S;
+    char ago[32];
+    mpg_age_text(ago, sizeof(ago), age, es());
+    if (age >= 90) {
+        lv_obj_t* a = text(root, ago, kTiny, fg(stale ? 100 : 55));
+        lv_obj_align(a, LV_ALIGN_TOP_RIGHT, -10, 5);
+    }
+    const int val_pct = stale ? 45 : 100;
+    for (int i = 0; i < t->n; i++) {
+        int x, y, w, h;
+        mpg_cell(i, t->n, 8, 26, 304, 108, 8, &x, &y, &w, &h);
+        box(root, x, y, w, h, fg(16), 12);
+        const char* value = t->t[i].value;
+        if (h >= 90 && w >= 140) {  // one or two big tiles: a big icon, the label beside it, the value below
+            const int sc = 2;
+            draw_icon(root, t->t[i].icon, x + 10, y + 8, sc, fg(val_pct), fg(16));
+            lv_obj_t* lab = text(root, t->t[i].label, kSmall, fg(70));
+            lv_label_set_long_mode(lab, LV_LABEL_LONG_DOT);
+            lv_obj_set_size(lab, w - 24 * sc - 28, 20);
+            lv_obj_set_pos(lab, x + 10 + 24 * sc + 8, y + 8 + 14);
+            lv_obj_t* val = text(root, value, fit_font(value, w - 20), fg(val_pct));
+            lv_label_set_long_mode(val, LV_LABEL_LONG_DOT);
+            lv_obj_set_size(val, w - 20, 30);
+            lv_obj_set_pos(val, x + 10, y + h - 40);
+            continue;
+        }
+        if (h >= 90) {  // three tall tiles: icon on top, the label under it, the value at the bottom
+            draw_icon(root, t->t[i].icon, x + 8, y + 8, 2, fg(val_pct), fg(16));
+            lv_obj_t* lab = text(root, t->t[i].label, kTiny, fg(70));
+            lv_label_set_long_mode(lab, LV_LABEL_LONG_DOT);
+            lv_obj_set_size(lab, w - 14, 17);
+            lv_obj_set_pos(lab, x + 7, y + 60);
+            lv_obj_t* val = text(root, value, fit_font(value, w - 14), fg(val_pct));
+            lv_label_set_long_mode(val, LV_LABEL_LONG_DOT);
+            lv_obj_set_size(val, w - 14, 30);
+            lv_obj_set_pos(val, x + 7, y + h - 34);
+            continue;
+        }
+        // a small tile: the label on top, then the icon and the value (a long value drops the icon and takes the width)
+        lv_obj_t* lab = text(root, t->t[i].label, kTiny, fg(70));
+        lv_label_set_long_mode(lab, LV_LABEL_LONG_DOT);
+        lv_obj_set_size(lab, w - 14, 17);
+        lv_obj_set_pos(lab, x + 7, y + 3);
+        bool icon = t->t[i].icon != MPG_I_NONE && text_w(value, kSmall) <= w - 8 - 34 - 4;
+        const int vx = icon ? x + 34 : x + 8;
+        const int avail = x + w - 6 - vx;
+        if (icon) {
+            draw_icon(root, t->t[i].icon, x + 6, y + 22, 1, fg(val_pct), fg(16));
+        }
+        const lv_font_t* vf = fit_font(value, avail);
+        if (vf == kBig) {
+            vf = kMid;
+        }
+        lv_obj_t* val = text(root, value, vf, fg(val_pct));
+        lv_label_set_long_mode(val, LV_LABEL_LONG_DOT);
+        lv_obj_set_size(val, avail, vf == kMid ? 26 : 20);
+        lv_obj_set_pos(val, vx, y + (vf == kMid ? 21 : 24));
+    }
+}
