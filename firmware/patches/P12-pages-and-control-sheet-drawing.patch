+// ---- Timers ----
+int timers_sig(const MaipaiPageTimer* t, int n)
+{
+    int sig = n;
+    for (int i = 0; i < n; i++) {
+        sig = sig * 31 + static_cast<int>(t[i].id);
+    }
+    return sig;
+}
