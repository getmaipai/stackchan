+void on_sheet_tile(lv_event_t* e)
+{
+    const int item = static_cast<int>(reinterpret_cast<intptr_t>(lv_event_get_user_data(e)));
+    switch (item) {
+        case MPG_S_MUTE: s_host->toggle_mute(); break;
+        case MPG_S_QUIET: s_host->toggle_quiet(); break;
+        case MPG_S_LIGHT: s_host->toggle_light(); break;
+        case MPG_S_FIND:
+            if (!mpg_action_blocked(MPG_A_FIND, s_host->quiet(), s_host->muted())) {
+                s_host->action(MPG_A_FIND);
+            }
+            break;
+        case MPG_S_TIMERS:
+        case MPG_S_GAMES: {
+            const int type = item == MPG_S_TIMERS ? MPG_P_TIMERS : MPG_P_GAMES;
+            int pos = mpg_pos_of(&s_cfg, type);
+            drop_sheet();
+            if (pos == 0) {
+                s_extra_type = type;
+                apply(mgs_show_extra(&s_g, now_ms()));
+            } else {
+                apply(mgs_pick_goto(&s_g, pos, now_ms()));
+            }
+            return;
+        }
+        default:  // MPG_S_COUNT: More
+            sheet_pick();
+            s_host->open_more();
+            return;
+    }
+    sheet_pick();
+}
+
+void on_slider(lv_event_t* e)
+{
+    lv_obj_t* sl = static_cast<lv_obj_t*>(lv_event_get_target(e));
+    const int item = static_cast<int>(reinterpret_cast<intptr_t>(lv_event_get_user_data(e)));
+    const int v = lv_slider_get_value(sl);
+    if (item == MPG_S_VOLUME) {
+        s_host->set_volume(v);
+    } else {
+        s_host->set_brightness(v);
+    }
+}
+
+void sheet_refresh()
+{
+    if (s_sh == nullptr || s_sheet == nullptr) {
+        return;
+    }
+    char buf[160];
+    sheet_status_text(buf, sizeof(buf));
+    set_text_if(s_sh->stat, buf);
+    mpg_sheet_t L;
+    mpg_sheet_layout(&s_cfg, &L);
+    for (int i = 0; i < L.n; i++) {
+        const int item = L.r[i].item;
+        if (item == MPG_S_MUTE || item == MPG_S_QUIET || item == MPG_S_LIGHT) {
+            const bool on = tile_on(item);
+            if (s_sh->last_on[i] == (on ? 1 : 0)) {
+                continue;
+            }
+            s_sh->last_on[i] = on ? 1 : 0;
+            lv_obj_set_style_bg_color(s_sh->tile_btn[i], on ? fg(100) : fg(16), 0);
+            lv_obj_t* l1 = s_sh->tile_state[i];
+            lv_obj_set_style_text_color(l1, on ? lv_color_black() : fg(100), 0);
+            lv_obj_set_style_text_color(s_sh->tile_name[i], on ? lv_color_black() : fg(100), 0);
+            set_text_if(l1, on ? yes_no(true) : yes_no(false));
+        }
+    }
+}
+
+void build_sheet()
+{
+    drop_sheet();
+    s_sh = new (std::nothrow) ShUi();
+    if (s_sh == nullptr) {
+        return;
+    }
+    memset(s_sh, 0, sizeof(*s_sh));
+    memset(s_sh->last_on, -1, sizeof(s_sh->last_on));
+    mpg_sheet_t L;
+    mpg_sheet_layout(&s_cfg, &L);
+    const int h = 240 - L.top_y;
+    lv_obj_t* r = box(lv_layer_top(), 0, L.top_y, 320, h + 14, shade(s_fg != nullptr ? s_fg() : lv_color_white(), 10 * night_pct() / 100), 14, true);
+    lv_obj_set_style_border_width(r, 2, 0);
+    lv_obj_set_style_border_side(r, LV_BORDER_SIDE_TOP, 0);
+    lv_obj_set_style_border_color(r, fg(45), 0);
+    s_sheet = r;
+    box(r, 142, 4, 36, 4, fg(50), 2);
+    if (L.status_h > 0) {
+        s_sh->stat = text(r, "", kTiny, fg(85));
+        lv_label_set_long_mode(s_sh->stat, LV_LABEL_LONG_WRAP);
+        lv_obj_set_width(s_sh->stat, 304);
+        lv_obj_set_pos(s_sh->stat, 8, L.status_y - L.top_y);
+    }
+    int si = 0;
+    for (int i = 0; i < L.n; i++) {
+        const mpg_rect_t& q = L.r[i];
+        const int x = q.x, y = q.y - L.top_y;
+        if (q.item < MPG_S_MUTE) {
+            lv_obj_t* sl_name = text(r, MPG_SHEET_TITLE[es() ? 1 : 0][q.item], kTiny, fg(80));
+            lv_obj_set_pos(sl_name, x, y - 1);
+            lv_obj_t* sl = lv_slider_create(r);
+            lv_obj_set_size(sl, q.w, 10);
+            lv_obj_set_pos(sl, x, y + 18);
+            lv_obj_set_ext_click_area(sl, 10);
+            const bool vol = q.item == MPG_S_VOLUME;
+            lv_slider_set_range(sl, vol ? 20 : 10, 100);
+            lv_slider_set_value(sl, vol ? s_host->volume() : s_host->brightness(), LV_ANIM_OFF);
+            // every part is styled in full: the theme's own slider look (and its opacity) differs between the unit and the PC renderer
+            const lv_part_t parts[3] = {LV_PART_MAIN, LV_PART_INDICATOR, LV_PART_KNOB};
+            for (lv_part_t part : parts) {
+                lv_obj_set_style_bg_opa(sl, LV_OPA_COVER, part);
+                lv_obj_set_style_border_width(sl, 0, part);
+                lv_obj_set_style_shadow_width(sl, 0, part);
+                lv_obj_set_style_outline_width(sl, 0, part);
+                lv_obj_set_style_bg_color(sl, part == LV_PART_MAIN ? fg(30) : fg(100), part);
+            }
+            lv_obj_set_style_radius(sl, 5, LV_PART_MAIN);
+            lv_obj_set_style_radius(sl, 5, LV_PART_INDICATOR);
+            lv_obj_set_style_radius(sl, LV_RADIUS_CIRCLE, LV_PART_KNOB);
+            lv_obj_set_style_pad_all(sl, 5, LV_PART_KNOB);
+            lv_obj_add_event_cb(sl, on_slider, LV_EVENT_VALUE_CHANGED, reinterpret_cast<void*>(static_cast<intptr_t>(q.item)));
+            if (si < 2) {
+                s_sh->slider[si++] = sl;
+            }
+            continue;
+        }
+        lv_obj_t* b = box(r, x, y, q.w, q.h, fg(16), 10, true);
+        lv_obj_set_style_border_width(b, 1, 0);
+        lv_obj_set_style_border_color(b, fg(40), 0);
+        lv_obj_set_style_bg_color(b, fg(45), LV_STATE_PRESSED);
+        const bool toggle = q.item == MPG_S_MUTE || q.item == MPG_S_QUIET || q.item == MPG_S_LIGHT;
+        const char* name  = q.item == MPG_S_COUNT ? tx("More", "Mas") : MPG_SHEET_TITLE[es() ? 1 : 0][q.item];
+        lv_obj_t* l = text(b, name, kTiny, fg(100));
+        if (toggle) {
+            lv_obj_align(l, LV_ALIGN_TOP_MID, 0, 3);
+            lv_obj_t* st = text(b, "", kTiny, fg(100));
+            lv_obj_align(st, LV_ALIGN_BOTTOM_MID, 0, -3);
+            s_sh->tile_state[i] = st;
+            s_sh->tile_name[i]  = l;
+        } else {
+            lv_obj_center(l);
+        }
+        s_sh->tile_btn[i] = b;
+        lv_obj_add_event_cb(b, on_sheet_tile, LV_EVENT_CLICKED, reinterpret_cast<void*>(static_cast<intptr_t>(q.item)));
+    }
+    sheet_refresh();
+}
+
+// ---- the timer: one at a time, only while something is open ----
+void timer_cb(lv_timer_t*)
+{
+    maipai_pages_step();
+}
+
+}  // namespace
+
+// ================= public =================
+void maipai_pages_attach(MaipaiPagesHost* host, lv_color_t (*fgcb)())
+{
+    s_host = host;
+    s_fg   = fgcb;
+    mpg_defaults(&s_cfg);
+    mgs_init(&s_g);
+    mgs_config(&s_g, s_cfg.n_left, s_cfg.n_right, s_cfg.sheet_s, s_cfg.idle_s);
+    s_ready = true;
+}
+
+void maipai_pages_set_config(const mpg_cfg_t& cfg)
+{
+    s_cfg = cfg;
+    mgs_config(&s_g, cfg.n_left, cfg.n_right, cfg.sheet_s, cfg.idle_s);
+    if (s_g.mode == MGS_FACE && (s_page != nullptr || s_sheet != nullptr)) {
+        close_everything();
+    }
+}
+
+const mpg_cfg_t& maipai_pages_config() { return s_cfg; }
+bool maipai_pages_open() { return s_open_a.load(); }
+int maipai_pages_position() { return s_pos_a.load(); }
+bool maipai_pages_sheet_open() { return s_sheet_a.load(); }
+
+void maipai_pages_touch_down(int x, int y, unsigned flags)
+{
+    if (!s_ready) {
+        return;
+    }
+    mgs_down(&s_g, x, y, now_ms(), flags);
+}
+
+void maipai_pages_touch_flags(unsigned flags)
+{
+    if (s_ready) {
+        mgs_flag(&s_g, flags);
+    }
+}
+
+bool maipai_pages_touch_up(int x, int y)
+{
+    if (!s_ready) {
+        return false;
+    }
+    const mgs_out_t o = mgs_up(&s_g, x, y, now_ms());
+    apply(o);
+    return o.consume != 0;
+}
+
+void maipai_pages_event(int ev)
+{
+    if (s_open_a.load()) {
+        s_pending.store(ev);
+    }
+}
+
+bool maipai_pages_show(int type)
+{
+    if (!s_ready) {
+        return false;
+    }
+    if (type == -1) {
+        s_g.mode = MGS_FACE;
+        s_g.pos = s_g.under_pos = 0;
+        s_extra_type = -1;
+        close_everything();
+        return true;
+    }
+    if (type == -2) {
+        s_g.under_pos = s_g.mode == MGS_PAGE ? s_g.pos : 0;
+        s_g.mode      = MGS_SHEET;
+        s_g.last_touch_ms = now_ms();
+        apply({MGS_ACT_OPEN_SHEET, 0, 0, 0});
+        return true;
+    }
+    if (type < 0 || type >= MPG_P_COUNT) {
+        return false;
+    }
+    drop_sheet();
+    const int pos = mpg_pos_of(&s_cfg, type);
+    if (pos == 0) {
+        s_extra_type = type;
+        apply(mgs_show_extra(&s_g, now_ms()));
+    } else {
+        apply(mgs_goto(&s_g, pos, now_ms()));
+    }
+    return true;
+}
+
+void maipai_pages_step()
+{
+    if (!s_ready || (s_page == nullptr && s_sheet == nullptr)) {
+        if (s_timer != nullptr && s_page == nullptr && s_sheet == nullptr) {
+            lv_timer_delete(s_timer);
+            s_timer = nullptr;
+        }
+        return;
+    }
+    int ev = s_pending.exchange(0);
+    if (s_host->ringing()) {
+        ev = MGS_EV_TIMER_RING;  // a ringing timer brings the face back so the ring is seen and a touch can end it
+    } else if (s_host->game_running()) {
+        ev = MGS_EV_SPEECH;  // a game (started by voice or the host) plays on the top layer and needs the touches: the page steps aside
+    }
+    if (ev != 0) {
+        apply(mgs_event(&s_g, ev, now_ms()));
+        if (s_page == nullptr && s_sheet == nullptr) {
+            return;
+        }
+    }
+    apply(mgs_tick(&s_g, now_ms()));
+    if (s_page == nullptr && s_sheet == nullptr) {
+        return;
+    }
+    // a day to night change repaints the page in the dimmer color
+    const bool night = s_host->night();
+    if (night != s_night_seen) {
+        s_night_seen = night;
+        const int type = s_page_type, pos = s_page_pos;
+        const bool sheet = s_sheet != nullptr;
+        if (type >= 0) {
+            s_page_type = -1;
+            show_type(type, pos);
+        }
+        if (sheet) {
+            build_sheet();
+        }
+    }
+    if (s_ui != nullptr && s_page != nullptr) {
+        switch (s_page_type) {
+            case MPG_P_CLOCK: clock_paint(); break;
+            case MPG_P_TIMERS: timers_refresh(); break;
+            case MPG_P_FRAME: frame_refresh(); break;
+            default: break;
+        }
+        if (s_ui != nullptr && s_ui->toast != nullptr && s_ui->toast_until != 0 && now_ms() >= s_ui->toast_until) {
+            lv_label_set_text(s_ui->toast, "");
+            s_ui->toast_until = 0;
+        }
+    }
+    if (s_sheet != nullptr) {
+        sheet_refresh();
+    }
+}
+
+void maipai_pages_close()
+{
+    mgs_init(&s_g);
+    mgs_config(&s_g, s_cfg.n_left, s_cfg.n_right, s_cfg.sheet_s, s_cfg.idle_s);
+    close_everything();
+}
+#endif
