# Intent: Swipe pages, part 3: the drawing. hal/maipai_pages.cc builds only the page that is showing (and the control sheet) from LVGL shapes and the fonts the build already has (the 20 px Latin text font and Montserrat 14 to 24, no new font), inside the face zone for pages and over the lower part for the sheet; the banner row above and the subtitles below are never covered. Clock: seven-bar digits or a seconds ring, dimmed at night, a dash with no time. Timers: the named countdowns with a cancel and three quick starts. Games: the games with their best scores and a play row. Quick actions: four to six big buttons, dimmed in full quiet and under a mute for the ones that make sound or move. Pictures: the owner's pictures one at a time, a slideshow that holds still at night and in quiet. Dashboard: the host's tiles with icons drawn as shapes, dim when older than an hour with their age. The sheet: status line, two sliders, buttons with on and off written out (never color alone), the More button that opens the old settings panel. A 250 ms timer exists only while something is open; at rest the cost is about 150 bytes. All data and actions go through MaipaiPagesHost so the host renderer (scripts/fw-face-render/pages_render.sh) draws the same code. Not compiled into the image until patch P13 adds the Kconfig switch.
# Placement: unit
# Upstream: new files firmware/main/hal/maipai_pages.h and maipai_pages.cc only (and the face clock core's digit bars, ours, patch F04).
# Check after a flash: nothing to check yet (the switch comes with patch P13). PNGs of every page and the sheet on Big eyes and Stock: docs/design/pages-2026-11-17.md.

diff --git a/firmware/main/hal/maipai_pages.h b/firmware/main/hal/maipai_pages.h
new file mode 100644
--- /dev/null
+++ b/firmware/main/hal/maipai_pages.h
@@ -0,0 +1,113 @@
+/*
+ * SPDX-License-Identifier: MIT
+ *
+ * Swipe pages and the control sheet, drawing and wiring (patch P12). Logic: maipai_gesture_core.h (the touch state machine) and
+ * maipai_pages_core.h (data and layout). The face is home; a swipe left or right moves through the pages the owner chose, a swipe
+ * up from the bottom opens the control sheet. Only the page that is showing exists: its LVGL objects are built when it opens and
+ * freed when it closes, and one 250 ms timer runs only while something is open. At rest the cost is one config record and one
+ * state record (about 150 bytes) and no timer.
+ *
+ * Everything the pages read or do goes through MaipaiPagesHost, so the same drawing code runs on the unit (maipai_pages_unit.cc)
+ * and in the host renderer that makes the pictures for the design notes (scripts/fw-face-render).
+ */
+#pragma once
+#include <sdkconfig.h>
+#include "maipai_gesture_core.h"  // MGS_EV_* and MGS_F_*: plain C, always available
+
+#if CONFIG_MAIPAI_PAGES || defined(MAIPAI_HOST_RENDER)
+#include <lvgl.h>
+#include <stddef.h>
+#include <stdint.h>
+#include <time.h>
+#include "maipai_gesture_core.h"
+#include "maipai_pages_core.h"
+
+typedef struct {
+    uint32_t id;
+    int32_t left_s;
+    char label[25];
+} MaipaiPageTimer;
+
+class MaipaiPagesHost {
+public:
+    virtual ~MaipaiPagesHost() {}
+    virtual uint32_t now_ms() = 0;
+    virtual uint32_t now_s() { return now_ms() / 1000; }
+    // the look
+    virtual bool local_time(struct tm*) { return false; }
+    virtual bool night() { return false; }
+    virtual bool clock24() { return false; }
+    virtual bool clock_ring() { return false; }
+    virtual bool spanish() { return false; }
+    virtual bool quiet() { return false; }
+    virtual bool muted() { return false; }
+    virtual bool ringing() { return false; }
+    virtual bool game_running() { return false; }
+    // timers
+    virtual int timers(MaipaiPageTimer*, int) { return 0; }
+    virtual void timer_cancel(uint32_t) {}
+    virtual void timer_add(int, const char*) {}
+    // games
+    virtual int game_count() { return 0; }
+    virtual const char* game_title(int) { return ""; }
+    virtual int game_best(int) { return 0; }
+    virtual const char* game_start(int) { return "No games on this unit."; }  // "" on success, else a plain sentence
+    // quick actions
+    virtual void action(int) {}
+    // host fed tiles
+    virtual const mpg_tiles_t* tiles(uint32_t* age_s) { *age_s = 0; return nullptr; }
+    // pictures: a buffer of 320 x 240 RGB565 (153,600 bytes) the page gives back when it closes
+    virtual int frame_count() { return 0; }
+    virtual uint8_t* frame_alloc() { return nullptr; }
+    virtual void frame_free(uint8_t*) {}
+    virtual bool frame_request(int, uint8_t*) { return false; }
+    virtual int frame_poll() { return -1; }  // 1 ready, 0 busy, -1 failed or none
+    // the sheet
+    virtual int volume() { return 70; }
+    virtual void set_volume(int) {}
+    virtual int brightness() { return 80; }
+    virtual void set_brightness(int) {}
+    virtual bool light_on() { return true; }
+    virtual void toggle_light() {}
+    virtual void toggle_mute() {}
+    virtual void toggle_quiet() {}
+    virtual int wifi_bars() { return -1; }        // -1 off, else 0 to 4
+    virtual int battery_pct(bool* charging) { *charging = false; return -1; }
+    virtual int tailnet() { return -1; }          // -1 not in this build, 0 off, 1 connecting, 2 up
+    virtual const char* address() { return ""; }
+    virtual void open_more() {}                   // the settings panel of quick settings
+    virtual void stop_all() {}                    // the stop swipe: stop speaking and end a game
+    virtual void volume_step(int) {}              // an edge swipe
+    virtual void bump() {}                        // a swipe toward a side with no page
+};
+
+// Hooks the pages up. `fg` gives the face color. Call once with the LVGL lock held. Nothing is created yet.
+void maipai_pages_attach(MaipaiPagesHost* host, lv_color_t (*fg)());
+// The configuration in force (the defaults until set).
+void maipai_pages_set_config(const mpg_cfg_t& cfg);
+const mpg_cfg_t& maipai_pages_config();
+// True while a page or the sheet is on screen. Safe from any task.
+bool maipai_pages_open();
+// The strip position on screen now (0 the face or the sheet), and whether the sheet is up. Safe from any task.
+int maipai_pages_position();
+bool maipai_pages_sheet_open();
+// Touches, from the LVGL task with the lock held: one call when a finger goes down and one when it lifts. `flags` are MGS_F_*.
+// touch_up returns true when the touch was a gesture (a swipe): the face must not treat it as a tap.
+void maipai_pages_touch_down(int x, int y, unsigned flags);
+void maipai_pages_touch_flags(unsigned flags);
+bool maipai_pages_touch_up(int x, int y);
+// An outside event (MGS_EV_*), from any task: returns at once, the LVGL timer acts on it. Does nothing while nothing is open.
+void maipai_pages_event(int ev);
+// Host driven (self.page.show): show a page type by id, the face (-1) or the sheet (-2). LVGL lock held. False when it cannot.
+bool maipai_pages_show(int type);
+// Runs the timer's work now (the host renderer calls this instead of waiting for the timer).
+void maipai_pages_step();
+// Closes everything and frees it (the lock is held).
+void maipai_pages_close();
+#else
+inline void maipai_pages_event(int) {}
+inline bool maipai_pages_open() { return false; }
+inline bool maipai_pages_touch_up(int, int) { return false; }
+inline void maipai_pages_touch_down(int, int, unsigned) {}
+inline void maipai_pages_touch_flags(unsigned) {}
+#endif
diff --git a/firmware/main/hal/maipai_pages.cc b/firmware/main/hal/maipai_pages.cc
new file mode 100644
--- /dev/null
+++ b/firmware/main/hal/maipai_pages.cc
@@ -0,0 +1,1161 @@
+/*
+ * SPDX-License-Identifier: MIT
+ *
+ * Swipe pages and the control sheet, drawing and wiring (patch P12). See maipai_pages.h. Runs on the LVGL task with the lock held;
+ * the only calls from other tasks are maipai_pages_event and the atomic readers.
+ */
+#include <sdkconfig.h>
+#include "maipai_pages.h"
+#if CONFIG_MAIPAI_PAGES || defined(MAIPAI_HOST_RENDER)
+#include <atomic>
+#include <cstdio>
+#include <cstring>
+#include <new>
+#include "maipai_face_clock_core.h"
+
+LV_FONT_DECLARE(BUILTIN_TEXT_FONT);
+
+namespace {
+
+// ---- state: one config, one gesture record, a few pointers (about 150 bytes) ----
+MaipaiPagesHost* s_host = nullptr;
+lv_color_t (*s_fg)()    = nullptr;
+mpg_cfg_t s_cfg;
+mgs_t s_g;
+bool s_ready = false;
+
+std::atomic<bool> s_open_a{false};
+std::atomic<int> s_pos_a{0};
+std::atomic<bool> s_sheet_a{false};
+std::atomic<int> s_pending{0};
+
+lv_obj_t* s_page    = nullptr;
+lv_obj_t* s_sheet   = nullptr;
+lv_timer_t* s_timer = nullptr;
+int s_page_type     = -1;
+int s_page_pos      = 99;
+int s_extra_type    = -1;  // the page showing at position 0 when it is not in the strip
+bool s_night_seen   = false;
+
+// Widgets of the page that shows: built when it opens, freed when it closes.
+struct Ui {
+    // clock
+    lv_obj_t* seg[4][7];
+    lv_obj_t* colon[2];
+    lv_obj_t* date;
+    lv_obj_t* ampm;
+    lv_obj_t* arc;
+    int shown[4];
+    // timers
+    lv_obj_t* trow_time[MPG_TIMER_ROWS];
+    uint32_t tids[MPG_TIMER_ROWS];
+    int tn;
+    int tsig;
+    // games, actions, tiles
+    lv_obj_t* toast;
+    uint32_t toast_until;
+    lv_obj_t* age;
+    // frame
+    lv_obj_t* img;
+    lv_obj_t* hint;
+    uint8_t* buf;
+    lv_image_dsc_t dsc;
+    int fidx, fcount;
+    uint32_t fshown_ms;
+    bool fpending;
+};
+Ui* s_ui = nullptr;
+
+struct ShUi {
+    lv_obj_t* stat;
+    lv_obj_t* tile_state[MPG_SHEET_MAX_ITEMS + 1];
+    lv_obj_t* tile_name[MPG_SHEET_MAX_ITEMS + 1];
+    lv_obj_t* tile_btn[MPG_SHEET_MAX_ITEMS + 1];
+    lv_obj_t* slider[2];
+    int8_t last_on[MPG_SHEET_MAX_ITEMS + 1];  // what each toggle shows now: a style is set only when it changes (a set always repaints)
+};
+ShUi* s_sh = nullptr;
+
+const lv_font_t* kTiny = &lv_font_montserrat_14;
+const lv_font_t* kSmall = &lv_font_montserrat_16;
+const lv_font_t* kMid = &lv_font_montserrat_20;
+const lv_font_t* kBig = &lv_font_montserrat_24;
+const lv_font_t* kText = &BUILTIN_TEXT_FONT;
+
+bool es() { return s_host != nullptr && s_host->spanish(); }
+const char* tx(const char* en, const char* sp) { return es() ? sp : en; }
+uint32_t now_ms() { return s_host != nullptr ? s_host->now_ms() : 0; }
+
+lv_color_t shade(lv_color_t c, int pct)
+{
+    return lv_color_make(mpg_scale(c.red, pct), mpg_scale(c.green, pct), mpg_scale(c.blue, pct));
+}
+int night_pct() { return s_host != nullptr ? mpg_dim_pct(s_host->night()) : 100; }
+lv_color_t fg(int pct = 100)
+{
+    const lv_color_t c = s_fg != nullptr ? s_fg() : lv_color_white();
+    return shade(c, pct * night_pct() / 100);
+}
+
+lv_obj_t* box(lv_obj_t* parent, int x, int y, int w, int h, lv_color_t c, int radius, bool clickable = false)
+{
+    lv_obj_t* o = lv_obj_create(parent);
+    lv_obj_remove_style_all(o);
+    lv_obj_remove_flag(o, LV_OBJ_FLAG_SCROLLABLE);
+    if (clickable) {
+        lv_obj_add_flag(o, LV_OBJ_FLAG_CLICKABLE);
+    } else {
+        lv_obj_remove_flag(o, LV_OBJ_FLAG_CLICKABLE);
+    }
+    lv_obj_set_pos(o, x, y);
+    lv_obj_set_size(o, w, h);
+    lv_obj_set_style_radius(o, radius, 0);
+    lv_obj_set_style_bg_opa(o, LV_OPA_COVER, 0);
+    lv_obj_set_style_bg_color(o, c, 0);
+    return o;
+}
+
+lv_obj_t* text(lv_obj_t* parent, const char* s, const lv_font_t* font, lv_color_t c)
+{
+    lv_obj_t* l = lv_label_create(parent);
+    lv_obj_remove_flag(l, LV_OBJ_FLAG_CLICKABLE);
+    lv_obj_set_style_text_font(l, font, 0);
+    lv_obj_set_style_text_color(l, c, 0);
+    lv_label_set_text(l, s);
+    return l;
+}
+
+int text_w(const char* s, const lv_font_t* f)
+{
+    lv_point_t p;
+    lv_text_get_size(&p, s, f, 0, 0, LV_COORD_MAX, LV_TEXT_FLAG_NONE);
+    return p.x;
+}
+// The biggest of the three number fonts in which the text fits `avail` pixels (the smallest when none does: it is cut with dots).
+const lv_font_t* fit_font(const char* s, int avail)
+{
+    if (text_w(s, kBig) <= avail) return kBig;
+    if (text_w(s, kMid) <= avail) return kMid;
+    if (text_w(s, kSmall) <= avail) return kSmall;
+    return kTiny;
+}
+
+void set_text_if(lv_obj_t* l, const char* s)
+{
+    if (l != nullptr && strcmp(lv_label_get_text(l), s) != 0) {
+        lv_label_set_text(l, s);
+    }
+}
+
+// A drawn icon: the shapes of maipai_pages_core.h in a 24 by 24 box, scaled by an integer factor.
+void draw_icon(lv_obj_t* parent, int icon, int x, int y, int scale, lv_color_t c, lv_color_t bg)
+{
+    mpg_shape_t sh[MPG_ICON_SHAPES_MAX];
+    const int n = mpg_icon_shapes(icon, sh);
+    for (int i = 0; i < n; i++) {
+        const int sx = x + sh[i].x * scale, sy = y + sh[i].y * scale, sw = sh[i].w * scale, shh = sh[i].h * scale;
+        switch (sh[i].kind) {
+            case MPG_SH_CIRCLE: box(parent, sx, sy, sw, shh, c, LV_RADIUS_CIRCLE); break;
+            case MPG_SH_RING: {
+                lv_obj_t* o = box(parent, sx, sy, sw, shh, c, LV_RADIUS_CIRCLE);
+                lv_obj_set_style_bg_opa(o, LV_OPA_TRANSP, 0);
+                lv_obj_set_style_border_width(o, scale * 2, 0);
+                lv_obj_set_style_border_color(o, c, 0);
+                break;
+            }
+            case MPG_SH_RECT: box(parent, sx, sy, sw, shh, c, 0); break;
+            case MPG_SH_ROUND: box(parent, sx, sy, sw, shh, c, scale); break;
+            default: box(parent, sx, sy, sw, shh, bg, 0); break;
+        }
+    }
+}
+
+// ---- the page frame ----
+void free_ui()
+{
+    if (s_ui != nullptr) {
+        if (s_ui->buf != nullptr && s_host != nullptr) {
+            s_host->frame_free(s_ui->buf);
+        }
+        delete s_ui;
+        s_ui = nullptr;
+    }
+}
+
+void drop_page()
+{
+    if (s_page != nullptr) {
+        lv_obj_delete_async(s_page);
+        s_page = nullptr;
+    }
+    s_page_type = -1;
+    s_page_pos  = 99;
+    free_ui();
+}
+
+void drop_sheet()
+{
+    if (s_sheet != nullptr) {
+        lv_obj_delete_async(s_sheet);
+        s_sheet = nullptr;
+    }
+    delete s_sh;
+    s_sh = nullptr;
+    s_sheet_a.store(false);
+}
+
+void publish()
+{
+    s_open_a.store(s_page != nullptr || s_sheet != nullptr);
+    s_pos_a.store(s_page != nullptr ? s_g.pos : 0);
+    s_sheet_a.store(s_sheet != nullptr);
+}
+
+void toast(const char* msg)
+{
+    if (s_ui == nullptr || s_page == nullptr) {
+        return;
+    }
+    if (s_ui->toast == nullptr) {
+        s_ui->toast = text(s_page, "", kTiny, fg(100));
+        lv_obj_set_width(s_ui->toast, 300);
+        lv_obj_set_style_text_align(s_ui->toast, LV_TEXT_ALIGN_CENTER, 0);
+        lv_obj_set_pos(s_ui->toast, 10, 126);
+    }
+    lv_label_set_text(s_ui->toast, msg);
+    s_ui->toast_until = now_ms() + 2500;
+}
+
+void pager(lv_obj_t* parent)
+{
+    const int n = s_cfg.n_left + 1 + s_cfg.n_right;
+    if (n < 2 || (s_page_pos == 0 && s_extra_type >= 0)) {
+        return;  // a page outside the strip has no place among the dots
+    }
+    const int cur = s_page_pos + s_cfg.n_left;
+    for (int i = 0; i < n; i++) {
+        const bool on = i == cur;
+        box(parent, mpg_pager_x(n, i) - (on ? 4 : 3), MPG_PAGER_Y - (on ? 4 : 3), on ? 8 : 6, on ? 8 : 6, fg(on ? 100 : 32), LV_RADIUS_CIRCLE);
+    }
+}
+
+lv_obj_t* make_root()
+{
+    lv_obj_t* r = box(lv_layer_top(), MPG_ZONE_X, MPG_ZONE_Y, MPG_ZONE_W, MPG_ZONE_H, lv_color_black(), 0, true);
+    lv_obj_move_to_index(r, 0);  // under the banner row and the subtitles, which stay where they are
+    return r;
+}
+
+void title(lv_obj_t* root, int type)
+{
+    lv_obj_t* l = text(root, MPG_PAGE_TITLE[es() ? 1 : 0][type], kSmall, fg(70));
+    lv_obj_set_pos(l, 10, 2);
+}
+
+// ---- Clock ----
+void clock_paint()
+{
+    if (s_ui == nullptr) {
+        return;
+    }
+    struct tm t = {};
+    const bool known = s_host->local_time(&t);
+    int digits[4] = {MF_DIGIT_BLANK, 0, 0, 0};
+    const bool c24 = s_host->clock24();
+    int ampm = 0;
+    if (known) {
+        int h = t.tm_hour;
+        if (!c24) {
+            ampm = h >= 12 ? 2 : 1;
+            h    = h % 12 == 0 ? 12 : h % 12;
+        }
+        digits[0] = h / 10 == 0 && !c24 ? MF_DIGIT_BLANK : h / 10;
+        digits[1] = h % 10;
+        digits[2] = t.tm_min / 10;
+        digits[3] = t.tm_min % 10;
+    }
+    for (int d = 0; d < 4; d++) {
+        const int want = known ? digits[d] : 8 + 100;  // no time: show dashes (only the middle bar)
+        if (s_ui->shown[d] == want) {
+            continue;
+        }
+        s_ui->shown[d] = want;
+        const uint8_t mask = known ? (digits[d] >= 0 && digits[d] <= 9 ? mf_digit_segments(digits[d]) : 0) : 0x40;
+        for (int sgm = 0; sgm < 7; sgm++) {
+            if (mask & (1 << sgm)) {
+                lv_obj_remove_flag(s_ui->seg[d][sgm], LV_OBJ_FLAG_HIDDEN);
+            } else {
+                lv_obj_add_flag(s_ui->seg[d][sgm], LV_OBJ_FLAG_HIDDEN);
+            }
+        }
+    }
+    const bool dots = !known || (t.tm_sec % 2) == 0;
+    for (lv_obj_t* o : s_ui->colon) {
+        if (dots) {
+            lv_obj_remove_flag(o, LV_OBJ_FLAG_HIDDEN);
+        } else {
+            lv_obj_add_flag(o, LV_OBJ_FLAG_HIDDEN);
+        }
+    }
+    char line[32];
+    if (known) {
+        static const char* const wd[2][7] = {{"Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"}, {"dom", "lun", "mar", "mie", "jue", "vie", "sab"}};
+        static const char* const mo[2][12] = {{"Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"},
+                                              {"ene", "feb", "mar", "abr", "may", "jun", "jul", "ago", "sep", "oct", "nov", "dic"}};
+        const int l = es() ? 1 : 0;
+        if (l) {
+            snprintf(line, sizeof(line), "%s %d %s", wd[l][t.tm_wday % 7], t.tm_mday, mo[l][t.tm_mon % 12]);
+        } else {
+            snprintf(line, sizeof(line), "%s %s %d", wd[l][t.tm_wday % 7], mo[l][t.tm_mon % 12], t.tm_mday);
+        }
+    } else {
+        snprintf(line, sizeof(line), "%s", tx("Time not set", "Hora sin ajustar"));
+    }
+    set_text_if(s_ui->date, line);
+    if (s_ui->ampm != nullptr) {
+        set_text_if(s_ui->ampm, ampm == 2 ? "PM" : "AM");
+    }
+    if (s_ui->arc != nullptr) {
+        lv_arc_set_value(s_ui->arc, known ? t.tm_sec : 0);
+    }
+}
+
+void build_clock(lv_obj_t* root)
+{
+    const mpg_clock_layout_t l = mpg_clock_layout(s_host->clock_ring() ? 1 : 0);
+    const lv_color_t c         = fg(100);
+    if (l.ring) {
+        s_ui->arc = lv_arc_create(root);
+        lv_obj_remove_flag(s_ui->arc, LV_OBJ_FLAG_CLICKABLE);
+        lv_obj_remove_style(s_ui->arc, nullptr, LV_PART_KNOB);
+        lv_obj_set_size(s_ui->arc, l.ring, l.ring);
+        lv_obj_set_pos(s_ui->arc, l.ring_cx - l.ring / 2, l.ring_cy - l.ring / 2);
+        lv_arc_set_rotation(s_ui->arc, 270);
+        lv_arc_set_bg_angles(s_ui->arc, 0, 360);
+        lv_arc_set_range(s_ui->arc, 0, 60);
+        lv_obj_set_style_arc_width(s_ui->arc, 6, LV_PART_MAIN);
+        lv_obj_set_style_arc_width(s_ui->arc, 6, LV_PART_INDICATOR);
+        lv_obj_set_style_arc_color(s_ui->arc, fg(25), LV_PART_MAIN);
+        lv_obj_set_style_arc_color(s_ui->arc, c, LV_PART_INDICATOR);
+    }
+    const int xs[4] = {l.x0, l.x0 + l.digit_w + l.gap, l.x0 + 2 * l.digit_w + l.gap + l.colon_w, l.x0 + 3 * l.digit_w + 2 * l.gap + l.colon_w};
+    for (int d = 0; d < 4; d++) {
+        for (int sgm = 0; sgm < 7; sgm++) {
+            int rx, ry, rw, rh;
+            mf_seg_rect(sgm, xs[d], l.y0, l.digit_w, l.digit_h, l.bar, &rx, &ry, &rw, &rh);
+            s_ui->seg[d][sgm] = box(root, rx, ry, rw, rh, c, l.bar / 3);
+            lv_obj_add_flag(s_ui->seg[d][sgm], LV_OBJ_FLAG_HIDDEN);
+        }
+        s_ui->shown[d] = -1;
+    }
+    const int cx  = l.x0 + 2 * l.digit_w + l.gap + (l.colon_w - l.bar) / 2;
+    s_ui->colon[0] = box(root, cx, l.y0 + l.digit_h / 3 - l.bar / 2, l.bar, l.bar, c, l.bar / 3);
+    s_ui->colon[1] = box(root, cx, l.y0 + 2 * l.digit_h / 3 - l.bar / 2, l.bar, l.bar, c, l.bar / 3);
+    s_ui->date     = text(root, "", kMid, fg(70));
+    lv_obj_set_width(s_ui->date, MPG_ZONE_W);
+    lv_obj_set_style_text_align(s_ui->date, LV_TEXT_ALIGN_CENTER, 0);
+    lv_obj_set_pos(s_ui->date, 0, l.date_y);
+    if (!s_host->clock24()) {
+        s_ui->ampm = text(root, "", kSmall, fg(70));
+        lv_obj_set_pos(s_ui->ampm, l.ampm_x, l.ampm_y);
+    }
+    clock_paint();
+}
