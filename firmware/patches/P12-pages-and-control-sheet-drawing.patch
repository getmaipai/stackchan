+// ---- the control sheet ----
+const char* yes_no(bool on) { return on ? tx("on", "si") : tx("off", "no"); }
+
+void sheet_status_text(char* out, size_t n)
+{
+    mpg_sheet_t L;
+    mpg_sheet_layout(&s_cfg, &L);
+    out[0] = '\0';
+    size_t k = 0;
+    for (int i = 0; i < L.n_status; i++) {
+        char part[48] = "";
+        switch (L.status_items[i]) {
+            case MPG_S_WIFI: {
+                const int b = s_host->wifi_bars();
+                if (b < 0) {
+                    snprintf(part, sizeof(part), "Wi-Fi %s", tx("off", "sin red"));
+                } else {
+                    snprintf(part, sizeof(part), "Wi-Fi %d/4", b);
+                }
+                break;
+            }
+            case MPG_S_BATTERY: {
+                bool charging = false;
+                const int p = s_host->battery_pct(&charging);
+                if (p >= 0) {
+                    snprintf(part, sizeof(part), "%s %d%%%s", tx("Battery", "Bateria"), p, charging ? "+" : "");
+                }
+                break;
+            }
+            case MPG_S_TAILNET: {
+                const int t = s_host->tailnet();
+                if (t >= 0) {
+                    snprintf(part, sizeof(part), "%s %s", tx("Private net", "Red priv."), t == 2 ? tx("up", "activa") : (t == 1 ? tx("joining", "uniendo") : tx("off", "apagada")));
+                }
+                break;
+            }
+            default: {
+                const char* a = s_host->address();
+                if (a != nullptr && a[0] != '\0') {
+                    snprintf(part, sizeof(part), "%s", a);
+                }
+                break;
+            }
+        }
+        if (part[0] != '\0') {
+            k += static_cast<size_t>(snprintf(out + k, n > k ? n - k : 0, "%s%s", k ? "    " : "", part));
+        }
+    }
+}
