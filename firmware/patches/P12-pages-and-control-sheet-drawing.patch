+// ---- Picture frame ----
+void frame_show(int idx)
+{
+    if (s_ui == nullptr || s_ui->buf == nullptr) {
+        return;
+    }
+    s_ui->dsc.header.magic  = LV_IMAGE_HEADER_MAGIC;
+    s_ui->dsc.header.cf     = LV_COLOR_FORMAT_RGB565;
+    s_ui->dsc.header.w      = 320;
+    s_ui->dsc.header.h      = 240;
+    s_ui->dsc.header.stride = 640;
+    s_ui->dsc.data_size     = 320 * 240 * 2;
+    s_ui->dsc.data          = s_ui->buf;
+    lv_image_set_src(s_ui->img, &s_ui->dsc);
+    lv_obj_remove_flag(s_ui->img, LV_OBJ_FLAG_HIDDEN);
+    if (s_ui->hint != nullptr) {
+        lv_obj_add_flag(s_ui->hint, LV_OBJ_FLAG_HIDDEN);
+    }
+    s_ui->fidx      = idx;
+    s_ui->fshown_ms = now_ms();
+}
+
+void frame_refresh()
+{
+    if (s_ui == nullptr || s_ui->buf == nullptr) {
+        return;
+    }
+    if (s_ui->fpending) {
+        const int r = s_host->frame_poll();
+        if (r == 1) {
+            s_ui->fpending = false;
+            frame_show(s_ui->fidx);
+            lv_obj_invalidate(s_ui->img);
+        } else if (r < 0) {
+            s_ui->fpending = false;
+        }
+        return;
+    }
+    // a still screen at night and in full quiet: the slideshow waits for the morning
+    if (s_ui->fcount > 1 && !s_host->night() && !s_host->quiet() && now_ms() - s_ui->fshown_ms >= MPG_FRAME_HOLD_S * 1000u) {
+        const int next = mpg_frame_next(s_ui->fcount, s_ui->fidx);
+        if (s_host->frame_request(next, s_ui->buf)) {
+            s_ui->fidx     = next;
+            s_ui->fpending = true;
+        } else {
+            s_ui->fshown_ms = now_ms();
+        }
+    }
+}
+
+void build_frame(lv_obj_t* root)
+{
+    pager(root);
+    s_ui->fcount = s_host->frame_count();
+    s_ui->img    = lv_image_create(root);
+    lv_obj_remove_flag(s_ui->img, LV_OBJ_FLAG_CLICKABLE);
+    lv_obj_set_size(s_ui->img, 192, 144);
+    lv_image_set_scale(s_ui->img, 154);   // 320 by 240 at 60 percent
+    lv_image_set_inner_align(s_ui->img, LV_IMAGE_ALIGN_CENTER);
+    lv_obj_add_flag(s_ui->img, LV_OBJ_FLAG_HIDDEN);
+    lv_obj_set_pos(s_ui->img, 64, 0);
+    s_ui->buf = s_ui->fcount > 0 ? s_host->frame_alloc() : nullptr;
+    if (s_ui->buf != nullptr && s_host->frame_request(0, s_ui->buf)) {
+        s_ui->fpending = true;
+        s_ui->fidx     = 0;
+    } else {
+        s_ui->buf = nullptr;
+        s_ui->hint = text(root, s_ui->fcount > 0 ? tx("Could not open the pictures right now.", "No se pueden abrir las fotos ahora.")
+                                                 : tx("No pictures yet. Send a picture face pack from settings.", "Aun no hay fotos. Envia un paquete de caras con fotos desde los ajustes."),
+                          kSmall, fg(70));
+        lv_obj_set_width(s_ui->hint, 270);
+        lv_obj_set_style_text_align(s_ui->hint, LV_TEXT_ALIGN_CENTER, 0);
+        lv_obj_set_pos(s_ui->hint, 25, 48);
+    }
+}
