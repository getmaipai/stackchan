+void show_type(int type, int pos)
+{
+    if (s_page != nullptr && s_page_type == type && s_page_pos == pos) {
+        return;  // already up (the sheet closed back to it)
+    }
+    drop_page();
+    s_ui = new (std::nothrow) Ui();
+    if (s_ui == nullptr) {
+        return;
+    }
+    memset(s_ui, 0, sizeof(*s_ui));
+    s_page      = make_root();
+    s_page_type = type;
+    s_page_pos  = pos;
+    switch (type) {
+        case MPG_P_CLOCK:
+            pager(s_page);
+            build_clock(s_page);
+            break;
+        case MPG_P_TIMERS: build_timers(s_page); break;
+        case MPG_P_GAMES: build_games(s_page); break;
+        case MPG_P_ACTIONS: build_actions(s_page); break;
+        case MPG_P_FRAME: build_frame(s_page); break;
+        default: build_tiles(s_page); break;
+    }
+    ensure_timer();
+    publish();
+}
+
+void build_sheet();
+
+void apply(const mgs_out_t& o)
+{
+    if (o.stop && s_host != nullptr) {
+        s_host->stop_all();
+    }
+    switch (o.act) {
+        case MGS_ACT_SHOW_FACE:
+            s_extra_type = -1;
+            close_everything();
+            break;
+        case MGS_ACT_SHOW_PAGE: {
+            drop_sheet();
+            const int type = o.arg == 0 ? s_extra_type : mpg_page_at(&s_cfg, o.arg);
+            if (type < 0) {
+                close_everything();
+                s_g.mode = MGS_FACE;
+                s_g.pos = 0;
+                break;
+            }
+            if (o.arg != 0) {
+                s_extra_type = -1;
+            }
+            show_type(type, o.arg);
+            publish();
+            break;
+        }
+        case MGS_ACT_OPEN_SHEET:
+            build_sheet();
+            ensure_timer();
+            publish();
+            break;
+        case MGS_ACT_VOLUME:
+            if (s_host != nullptr) {
+                s_host->volume_step(o.arg);
+            }
+            break;
+        case MGS_ACT_BUMP:
+            if (s_host != nullptr) {
+                s_host->bump();
+            }
+            break;
+        default: break;
+    }
+}
