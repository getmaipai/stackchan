diff --git a/firmware/main/hal/maipai_listen.cc b/firmware/main/hal/maipai_listen.cc
new file mode 100644
index 0000000..1bde7fe
--- /dev/null
+++ b/firmware/main/hal/maipai_listen.cc
@@ -0,0 +1,222 @@
+/*
+ * SPDX-License-Identifier: MIT
+ *
+ * The three listening cues (patch TB01): sound, light, face. Each is a choice (maipai_tbprefs.h). The sound is a sample
+ * that is ready before the wake: the chime is the shipped "popup" clip, the "mm" is rendered once at boot into 11.5 KB of
+ * PSRAM. The light is the LED ring, driven by one low-priority task (stack in PSRAM) that wakes every 60 ms while a cue
+ * shows and every 500 ms otherwise; a ring update is one I2C transfer and the time of each is measured (a frame that takes
+ * more than 30 ms is counted). The privacy cues that cannot be turned off (microphone live, camera on) are a different
+ * code path (monitor_cue_begin) and are not touched here.
+ * Steady internal RAM: the task's control block (about 0.4 KB) and the state below (about 0.1 KB).
+ */
+#include "maipai_listen.h"
+#include "maipai_listen_core.h"
+#include "maipai_tbprefs.h"
+#include "maipai_filler.h"
+#include "maipai_privacy.h"
+#include "maipai_sounds.h"
+#include "maipai_timers.h"
+#include "maipai_remote.h"
+#include "board/hal_bridge.h"
+#include <application.h>
+#include <board.h>
+#include <esp_heap_caps.h>
+#include <esp_log.h>
+#include <esp_timer.h>
+#include <freertos/FreeRTOS.h>
+#include <freertos/idf_additions.h>
+#include <freertos/task.h>
+#include <mcp_server.h>
+#include <atomic>
+#include <cstdio>
+#include <cstring>
+
+static const char* TAG = "MAIPAI-LISTEN";
+
+namespace {
+
+int16_t* s_mm        = nullptr;  // PSRAM
+size_t s_mm_n        = 0;
+TaskHandle_t s_task  = nullptr;
+std::atomic<int64_t> s_wake_us{0};
+std::atomic<bool> s_thinking{false};
+std::atomic<int64_t> s_think_us{0};
+std::atomic<int> s_test{0};      // 0 none; else the test step started at s_test_us
+std::atomic<int64_t> s_test_us{0};
+std::atomic<bool> s_lit{false};
+std::atomic<uint32_t> s_slow{0}, s_frames{0}, s_max_us{0};
+
+uint32_t ms_now() { return static_cast<uint32_t>(esp_timer_get_time() / 1000); }
+
+tl_env_t env_now()
+{
+    tl_env_t e = {};
+    bool night = false;
+    e.sound_ok = maipai_sounds_gate("popup", &night) ? 1 : 0;
+    e.muted      = maipai_muted() ? 1 : 0;
+    e.quiet_hrs  = night ? 1 : 0;
+    e.full_quiet = maipai_quiet() ? 1 : 0;
+    return e;
+}
+
+tl_effective_t effective_now(const tl_prefs_t& p)
+{
+    const tl_env_t e = env_now();
+    return tl_effective(&p, &e);
+}
+
+void play_sound(uint8_t which)
+{
+    if (which == TL_SOUND_CHIME) {
+        (void)maipai_sounds_play("popup");  // the policy gate is inside
+    } else if (which == TL_SOUND_MM && s_mm != nullptr) {
+        Application::GetInstance().GetAudioService().PlayPcm(s_mm, s_mm_n, TL_MM_RATE);
+    }
+}
+
+void render_task(void*)
+{
+    int16_t* buf = static_cast<int16_t*>(heap_caps_malloc(TL_MM_SAMPLES * sizeof(int16_t), MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT));
+    if (buf != nullptr) {
+        s_mm_n = tl_render_mm(buf, TL_MM_SAMPLES);
+        s_mm   = buf;
+    }
+    vTaskDelete(nullptr);
+}
+
+void ring_task(void*)
+{
+    tl_state_t last_state = TL_ST_OFF;
+    int64_t state_since   = 0;
+    bool lit              = false;
+    DeviceState prev_dev  = kDeviceStateIdle;
+    for (;;) {
+        const int wait_ms = (lit || s_test.load() != 0 || s_thinking.load()) ? 60 : 500;
+        ulTaskNotifyTake(pdTRUE, pdMS_TO_TICKS(wait_ms));
+        const int64_t now = esp_timer_get_time();
+        auto& app         = Application::GetInstance();
+        const DeviceState dev = app.GetDeviceState();
+        if (dev == kDeviceStateListening && prev_dev != kDeviceStateListening) {
+            maipai_filler_turn_start();  // a new turn: the filler may play once more
+        }
+        prev_dev = dev;
+
+        const MaipaiTbPrefs prefs = maipai_tb_prefs();
+        const tl_effective_t eff  = effective_now(prefs.listen);
+        tl_state_t st             = TL_ST_OFF;
+        uint32_t since            = 0;
+        int hearing               = 0;
+        if (s_test.load() != 0) {  // self.listen.test: listen 1.6 s, heard + think 1.4 s, speak 0.8 s
+            const int64_t t = (now - s_test_us.load()) / 1000;
+            if (t < 1600) { st = TL_ST_LISTEN; since = static_cast<uint32_t>(t); }
+            else if (t < 1600 + 1400) { st = TL_ST_HEARD; since = static_cast<uint32_t>(t - 1600); }
+            else if (t < 3800) { st = TL_ST_SPEAK; since = static_cast<uint32_t>(t - 3000); }
+            else { s_test.store(0); }
+        } else if (s_thinking.load() && dev != kDeviceStateSpeaking) {
+            st    = TL_ST_HEARD;
+            since = static_cast<uint32_t>((now - s_think_us.load()) / 1000);
+        } else if (dev == kDeviceStateListening) {
+            st      = TL_ST_LISTEN;
+            since   = static_cast<uint32_t>((now - s_wake_us.load()) / 1000);
+            hearing = app.GetAudioService().IsVoiceDetected() ? 1 : 0;
+        } else if (dev == kDeviceStateSpeaking) {
+            st    = TL_ST_SPEAK;
+            since = 0;
+        }
+        if (st != last_state) {
+            last_state  = st;
+            state_since = now;
+        }
+        const tl_rgb_t c = tl_frame(st, since, hearing, &prefs.listen, eff.light);
+        const bool own_ring = maipai_timers_ringing();  // a ringing timer owns the ring
+        if (c.lit && !own_ring) {
+            const int64_t t0 = esp_timer_get_time();
+            hal_bridge::leds_cue(c.r, c.g, c.b);
+            const uint32_t us = static_cast<uint32_t>(esp_timer_get_time() - t0);
+            s_frames.fetch_add(1);
+            if (us > s_max_us.load()) s_max_us.store(us);
+            if (us > TL_FRAME_BUDGET_MS * 1000u) s_slow.fetch_add(1);
+            lit = true;
+            s_lit.store(true);
+        } else if (lit) {
+            hal_bridge::leds_cue_off();
+            lit = false;
+            s_lit.store(false);
+            maipai_remote_ring_refresh();  // the violet remote tint comes back if a remote session is on
+        }
+        (void)state_since;
+    }
+}
+
+void ensure_task()
+{
+    if (s_task != nullptr) return;
+    xTaskCreatePinnedToCoreWithCaps(ring_task, "listen_ring", 3072, nullptr, 1, &s_task, 0, MALLOC_CAP_SPIRAM);
+}
+
+}  // namespace
+
+void maipai_listen_wake(int within_ms)
+{
+    const int64_t now = esp_timer_get_time();
+    const int64_t prev = s_wake_us.load();
+    if (prev != 0 && now - prev < static_cast<int64_t>(within_ms) * 1000) {
+        return;
+    }
+    s_wake_us.store(now);
+    const MaipaiTbPrefs prefs = maipai_tb_prefs();
+    const tl_effective_t eff  = effective_now(prefs.listen);
+    if (eff.sound != TL_SOUND_OFF) {
+        play_sound(eff.sound);  // first: nothing before this waits for the network
+    }
+    if (eff.face) {
+        hal_bridge::react_face("surprised", 500);
+    }
+    if (s_task != nullptr) {
+        xTaskNotifyGive(s_task);
+    }
+}
+
+bool maipai_listen_ring_active() { return s_lit.load(); }
+
+void maipai_listen_thinking(bool on)
+{
+    if (on) {
+        s_think_us.store(esp_timer_get_time());
+    }
+    s_thinking.store(on);
+    if (s_task != nullptr) {
+        xTaskNotifyGive(s_task);
+    }
+}
+
+void maipai_listen_register_tools()
+{
+    xTaskCreate(render_task, "mm_render", 3072, nullptr, 1, nullptr);  // transient: renders the "mm" then ends
+    ensure_task();
+    auto& mcp = McpServer::GetInstance();
+    mcp.AddTool("self.listen.test",
+                "Plays every enabled listening cue once: the sound (chime or mm), the ring light (listening, heard, thinking, "
+                "speaking) and the face. Follows mute, sounds off, quiet hours and full quiet like a real listen. Answers "
+                "{ok, sound, light, face, ring_frames, ring_slow}.",
+                PropertyList(), [](const PropertyList&) -> ReturnValue {
+                    const MaipaiTbPrefs prefs = maipai_tb_prefs();
+                    const tl_effective_t eff  = effective_now(prefs.listen);
+                    static const char* const snd[3] = {"off", "chime", "mm"};
+                    static const char* const lgt[3] = {"off", "dim", "normal"};
+                    if (eff.sound != TL_SOUND_OFF) play_sound(eff.sound);
+                    if (eff.face) hal_bridge::react_face("surprised", 700);
+                    s_test_us.store(esp_timer_get_time());
+                    s_test.store(1);
+                    if (s_task != nullptr) xTaskNotifyGive(s_task);
+                    char out[220];
+                    snprintf(out, sizeof(out),
+                             "{\"ok\":true,\"sound\":\"%s\",\"light\":\"%s\",\"face\":%s,\"sound_chosen\":\"%s\",\"all_off\":%s,"
+                             "\"ring_frames\":%u,\"ring_slow\":%u,\"ring_max_us\":%u}",
+                             snd[eff.sound], lgt[eff.light], eff.face ? "true" : "false", snd[prefs.listen.sound],
+                             tl_all_off(&prefs.listen) ? "true" : "false", static_cast<unsigned>(s_frames.load()),
+                             static_cast<unsigned>(s_slow.load()), static_cast<unsigned>(s_max_us.load()));
+                    return std::string(out);
+                });
+    ESP_LOGI(TAG, "listening cues ready");
+}
diff --git a/firmware/main/hal/maipai_tbprefs.h b/firmware/main/hal/maipai_tbprefs.h
new file mode 100644
index 0000000..55804de
--- /dev/null
+++ b/firmware/main/hal/maipai_tbprefs.h
@@ -0,0 +1,31 @@
+/*
+ * SPDX-License-Identifier: MIT
+ *
+ * The saved choices of the listening cues, "While it thinks" and the pickup reaction, read from the NVS namespace
+ * "maipai_prefs" (patch TB01). The unit's one preference store belongs to the self.prefs tool (patch set A); this file only
+ * READS the keys it needs, with the stock Settings class, and caches them. Key names are the host's
+ * (host/maipai_body/unit_prefs.py). An NVS key holds at most 15 characters, so a longer name is cut to its first 15
+ * characters, by one function both the writer and this reader call: maipai_tb_nvs_key. Value types: an enum is a string
+ * ("chime"), a colour a string ("#40c0ff"), a bool a string ("true", "on", "1") or an integer 0/1, filler_wait_s a string
+ * ("0.4") or an integer number of milliseconds.
+ */
+#pragma once
+#include "maipai_filler_core.h"
+#include "maipai_listen_core.h"
+
+#define MAIPAI_PREFS_NAMESPACE "maipai_prefs"
+
+// Copies the NVS key for a pref name into out (at most 15 characters and the end mark); returns out.
+const char* maipai_tb_nvs_key(const char* name, char out[16]);
+
+// Pickup reaction: 0 off, 1 face only, 2 face and sound (key pickup_reaction: off, face, face_sound).
+struct MaipaiTbPrefs {
+    tl_prefs_t listen;
+    tf_prefs_t filler;
+    uint8_t pickup;
+};
+
+// The saved values (defaults for any key not saved). Cached; re-read from flash when older than 5 s or after an invalidate.
+MaipaiTbPrefs maipai_tb_prefs();
+// The self.prefs.set writer calls this after it saves, so the new values apply at once.
+void maipai_tb_prefs_invalidate();
diff --git a/firmware/main/hal/maipai_tbprefs.cc b/firmware/main/hal/maipai_tbprefs.cc
new file mode 100644
index 0000000..0d25166
--- /dev/null
+++ b/firmware/main/hal/maipai_tbprefs.cc
@@ -0,0 +1,114 @@
+/*
+ * SPDX-License-Identifier: MIT
+ *
+ * Reads the listening, filler and pickup choices from NVS (patch TB01). See maipai_tbprefs.h.
+ */
+#include "maipai_tbprefs.h"
+#include <esp_timer.h>
+#include <freertos/FreeRTOS.h>
+#include <freertos/semphr.h>
+#include <settings.h>
+#include <atomic>
+#include <cstring>
+#include <mutex>
+#include <string>
+
+namespace {
+
+std::mutex s_mu;
+MaipaiTbPrefs s_cache;
+int64_t s_loaded_us = -1;
+std::atomic<bool> s_dirty{true};
+
+bool text_true(const std::string& s)
+{
+    return s == "true" || s == "on" || s == "1" || s == "yes";
+}
+bool text_false(const std::string& s)
+{
+    return s == "false" || s == "off" || s == "0" || s == "no";
+}
+
+// A bool saved as a string or as an integer; false and untouched when it is neither.
+void read_bool(Settings& st, const char* name, uint8_t* out)
+{
+    char key[16];
+    maipai_tb_nvs_key(name, key);
+    const std::string s = st.GetString(key, "");
+    if (text_true(s)) {
+        *out = 1;
+        return;
+    }
+    if (text_false(s)) {
+        *out = 0;
+        return;
+    }
+    const int32_t v = st.GetInt(key, -1);
+    if (v == 0 || v == 1) {
+        *out = static_cast<uint8_t>(v);
+    }
+}
+
+std::string read_text(Settings& st, const char* name)
+{
+    char key[16];
+    maipai_tb_nvs_key(name, key);
+    return st.GetString(key, "");
+}
+
+void load(MaipaiTbPrefs* out)
+{
+    tl_prefs_default(&out->listen);
+    tf_prefs_default(&out->filler);
+    out->pickup = 1;
+    Settings st(MAIPAI_PREFS_NAMESPACE, false);
+    std::string s = read_text(st, "listen_sound");
+    uint8_t v;
+    if (tl_parse_sound(s.c_str(), &v)) out->listen.sound = v;
+    s = read_text(st, "listen_light");
+    if (tl_parse_light(s.c_str(), &v)) out->listen.light = v;
+    s = read_text(st, "listen_light_colour");
+    tl_parse_colour(s.c_str(), &out->listen.r, &out->listen.g, &out->listen.b);
+    read_bool(st, "listen_face", &out->listen.face);
+    s = read_text(st, "filler_mode");
+    if (tf_parse_mode(s.c_str(), &v)) out->filler.mode = v;
+    s = read_text(st, "filler_wait_s");
+    uint16_t w;
+    if (tf_parse_wait(s.c_str(), &w)) {
+        out->filler.wait_ms = w;
+    } else {
+        char key[16];
+        maipai_tb_nvs_key("filler_wait_s", key);
+        const int32_t ms = st.GetInt(key, -1);
+        if (ms >= TF_WAIT_MIN_MS && ms <= TF_WAIT_MAX_MS) out->filler.wait_ms = static_cast<uint16_t>(ms);
+    }
+    s = read_text(st, "pickup_reaction");
+    if (s == "off") out->pickup = 0;
+    else if (s == "face") out->pickup = 1;
+    else if (s == "face_sound") out->pickup = 2;
+}
+
+}  // namespace
+
+const char* maipai_tb_nvs_key(const char* name, char out[16])
+{
+    strncpy(out, name != nullptr ? name : "", 15);
+    out[15] = 0;
+    return out;
+}
+
+MaipaiTbPrefs maipai_tb_prefs()
+{
+    std::lock_guard<std::mutex> lock(s_mu);
+    const int64_t now = esp_timer_get_time();
+    if (s_dirty.exchange(false) || s_loaded_us < 0 || now - s_loaded_us > 5000000) {
+        load(&s_cache);
+        s_loaded_us = now;
+    }
+    return s_cache;
+}
+
+void maipai_tb_prefs_invalidate()
+{
+    s_dirty.store(true);
+}
