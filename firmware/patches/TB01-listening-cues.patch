# Intent: The three listening cues (owner decision 2026-11-16), each its own choice read from the NVS namespace maipai_prefs (listen_sound off/chime/mm, listen_light off/dim/normal, listen_light_colour, listen_face): a sound that plays from a sample ready before any network step (the shipped popup clip, or a voice-like mm rendered once at boot into 11.5 KB of PSRAM; both through the sound policy), a light (the LED ring breathing in the person's colour, brighter while it hears speech, a quick double blink at heard, a slower pulse in a rotated colour while thinking, steady dim while speaking, off at idle; one low-priority task, ring updates timed against a 30 ms budget) and a face cue. Mute silences the sound only; quiet hours cap the light at dim; full quiet turns sound, light and face cues off. The privacy cues that cannot be turned off (monitor_cue_begin) are not touched. self.listen.test plays them all once. New: AudioService::PlayPcm (mono samples straight to the playback queue, resampled), hal_bridge::leds_cue and leds_cue_off (a colour over the ring without touching its shadow), maipai_sounds_gate (the sound policy decision without playing), maipai_tb_nvs_key (NVS keys are at most 15 characters, so a longer pref name is cut to its first 15) and the cached prefs reader. The wake word calls maipai_listen_wake first thing in HandleWakeWordDetectedEvent; the later popup call dedupes (6 s).
# Placement: unit (the cues run on the robot with no host)
# Upstream: firmware/main/hal/{maipai_wake.cc,maipai_sounds.cc,maipai_sounds.h,hal_io_expander.cpp,board/hal_bridge.h} (ours, T03, 116, 075), xiaozhi-esp32 main/application.cc and main/audio/audio_service.{h,cc} (MIT); new hal/maipai_listen*.{h,cc}, maipai_tbprefs.{h,cc}
# Check after a flash: self.listen.test answers sound, light and face as set and the ring shows listening, heard, thinking, speaking (read the ring pixels); the wake word plays the chosen sound before the connect; mute keeps the light; self.prefs listen_sound off silences it. Internal RAM steady cost with TB02 to TB05: about 3.1 KB (see the report).

diff --git a/firmware/main/hal/maipai_listen_core.h b/firmware/main/hal/maipai_listen_core.h
new file mode 100644
index 0000000..55fbc8a
--- /dev/null
+++ b/firmware/main/hal/maipai_listen_core.h
@@ -0,0 +1,269 @@
+/*
+ * SPDX-License-Identifier: MIT
+ *
+ * The three listening cues (patch TB01): the pure logic. A person near the robot must be able to tell when it listens,
+ * so there are three cues, each its own choice: a sound (a soft chime or a voice-like "mm", from a sample that is ready
+ * before any network step), a light (the LED ring, breathing), and a face. This file holds the choices, the rules that
+ * mute, quiet hours and full quiet apply, the state-to-colour table of the ring, and the one rendered sample ("mm").
+ * Plain C99, no clock of its own, no hardware: a host compiler tests it (host/tests/firmware/listen_core_test.c).
+ *
+ * The privacy cues that can never be turned off (microphone live, camera on) are not here: monitor_cue_begin stays the
+ * single code path for them. Mute turns the sound off but keeps the light and the face; the cues are decoration.
+ */
+#ifndef MAIPAI_LISTEN_CORE_H
+#define MAIPAI_LISTEN_CORE_H
+
+#include <math.h>
+#include <stddef.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+/* ---- the choices (the names are the host's: host/maipai_body/unit_prefs.py) ---- */
+
+#define TL_SOUND_OFF 0
+#define TL_SOUND_CHIME 1
+#define TL_SOUND_MM 2
+#define TL_LIGHT_OFF 0
+#define TL_LIGHT_DIM 1
+#define TL_LIGHT_NORMAL 2
+
+typedef struct {
+    uint8_t sound; /* listen_sound: off, chime, mm */
+    uint8_t light; /* listen_light: off, dim, normal */
+    uint8_t face;  /* listen_face: 0 or 1 */
+    uint8_t r, g, b; /* listen_light_colour, "#rrggbb" */
+} tl_prefs_t;
+
+static inline void tl_prefs_default(tl_prefs_t* p)
+{
+    p->sound = TL_SOUND_CHIME;
+    p->light = TL_LIGHT_NORMAL;
+    p->face  = 1;
+    p->r     = 0x40;
+    p->g     = 0xc0;
+    p->b     = 0xff;
+}
+
+static inline int tl_hex(int c)
+{
+    if (c >= '0' && c <= '9') return c - '0';
+    if (c >= 'a' && c <= 'f') return c - 'a' + 10;
+    if (c >= 'A' && c <= 'F') return c - 'A' + 10;
+    return -1;
+}
+
+/* "#rrggbb" to a colour; 0 and the colour untouched when the text is anything else. */
+static inline int tl_parse_colour(const char* s, uint8_t* r, uint8_t* g, uint8_t* b)
+{
+    if (s == NULL || s[0] != '#' || strlen(s) != 7) {
+        return 0;
+    }
+    int v[6];
+    for (int i = 0; i < 6; i++) {
+        v[i] = tl_hex((unsigned char)s[1 + i]);
+        if (v[i] < 0) {
+            return 0;
+        }
+    }
+    *r = (uint8_t)(v[0] * 16 + v[1]);
+    *g = (uint8_t)(v[2] * 16 + v[3]);
+    *b = (uint8_t)(v[4] * 16 + v[5]);
+    return 1;
+}
+
+/* Each of these answers 1 and sets *out when the text is one of the allowed words, else 0 and *out is untouched. */
+static inline int tl_parse_sound(const char* s, uint8_t* out)
+{
+    if (s == NULL) return 0;
+    if (strcmp(s, "off") == 0) { *out = TL_SOUND_OFF; return 1; }
+    if (strcmp(s, "chime") == 0) { *out = TL_SOUND_CHIME; return 1; }
+    if (strcmp(s, "mm") == 0) { *out = TL_SOUND_MM; return 1; }
+    return 0;
+}
+
+static inline int tl_parse_light(const char* s, uint8_t* out)
+{
+    if (s == NULL) return 0;
+    if (strcmp(s, "off") == 0) { *out = TL_LIGHT_OFF; return 1; }
+    if (strcmp(s, "dim") == 0) { *out = TL_LIGHT_DIM; return 1; }
+    if (strcmp(s, "normal") == 0) { *out = TL_LIGHT_NORMAL; return 1; }
+    return 0;
+}
+
+/* ---- what the rules allow right now ---- */
+
+typedef struct {
+    uint8_t muted;      /* the hard mute */
+    uint8_t quiet_hrs;  /* quiet hours, or the host's "it is dark" */
+    uint8_t full_quiet; /* full quiet: the unit shows the sleeping face and wants nothing from the room */
+    uint8_t sound_ok;   /* the sound policy would play a wake chime now (it already reads mute and "sounds off") */
+} tl_env_t;
+
+typedef struct {
+    uint8_t sound; /* TL_SOUND_*: what plays now (off when the person or the rules say so) */
+    uint8_t light; /* TL_LIGHT_*: what shows now */
+    uint8_t face;  /* 0 or 1 */
+} tl_effective_t;
+
+/* Mute: no sound, light and face stay. Quiet hours: the light is at most dim; the sound goes through the sound policy,
+ * which lets the wake chime through for a person who is there (T03) and silences everything else. Full quiet: no sound
+ * and no light (the face is the sleeping face and does not change either). */
+static inline tl_effective_t tl_effective(const tl_prefs_t* p, const tl_env_t* e)
+{
+    tl_effective_t out;
+    out.sound = p->sound;
+    out.light = p->light;
+    out.face  = p->face;
+    if (e->muted || !e->sound_ok || e->full_quiet) {
+        out.sound = TL_SOUND_OFF;
+    }
+    if (e->full_quiet) {
+        out.light = TL_LIGHT_OFF;
+        out.face  = 0;
+    } else if (e->quiet_hrs && out.light > TL_LIGHT_DIM) {
+        out.light = TL_LIGHT_DIM;
+    }
+    return out;
+}
+
+/* All three off: the page says so in plain words (people near the robot will not see or hear when it listens). */
+static inline int tl_all_off(const tl_prefs_t* p) { return p->sound == TL_SOUND_OFF && p->light == TL_LIGHT_OFF && !p->face; }
+
+/* ---- the light: one state, one colour, one brightness at each moment ---- */
+
+typedef enum {
+    TL_ST_OFF = 0, /* idle: the ring is not ours */
+    TL_ST_LISTEN,  /* after the wake word and in follow-up listening: a soft breath */
+    TL_ST_HEARD,   /* it heard you and starts thinking: a quick double blink, then the thinking pulse */
+    TL_ST_THINK,   /* a different slow pulse in a different colour */
+    TL_ST_SPEAK,   /* steady and dim while it speaks */
+    TL_ST_COUNT
+} tl_state_t;
+
+static const char* const TL_STATE_NAMES[TL_ST_COUNT] = {"off", "listen", "heard", "think", "speak"};
+
+/* Brightness in thousandths of the colour's own value, at "normal"; "dim" is a third of it. These numbers are the
+ * table the test pins. The peak of a channel at normal is 0.43 of its value (the ring is bright at the edge of a desk). */
+#define TL_BREATH_MS 3200   /* listen: one breath */
+#define TL_THINK_MS 1800    /* think: one pulse, slower than a heartbeat, faster than a breath */
+#define TL_BLINK_MS 90      /* heard: each on and each off */
+#define TL_HEARD_MS (4 * TL_BLINK_MS)
+#define TL_PEAK_NORMAL 110  /* of 255 */
+#define TL_PEAK_DIM 36
+#define TL_SPEAK_PERMILLE 220
+#define TL_HEARING_BOOST_PERMILLE 1500 /* listen, while it hears speech: brighter */
+#define TL_PEAK_MAX_NORMAL 165 /* the boosted peak never goes past this */
+#define TL_FRAME_BUDGET_MS 30 /* one ring update may take this long at most (I2C to the expander) */
+
+/* A triangle wave eased with a sine: 0..1000, period `period`, minimum at t=0. */
+static inline int tl_breath_permille(uint32_t t, uint32_t period)
+{
+    const float x = (float)(t % period) / (float)period;
+    return (int)(500.0f - 500.0f * cosf(6.2831853f * x));
+}
+
+typedef struct {
+    uint8_t r, g, b;
+    uint8_t lit; /* 0 when the ring is dark (idle, or a blink gap) */
+} tl_rgb_t;
+
+/* The colour while thinking: the listening colour with its channels rotated, so it is always a different colour
+ * (cyan listens, a lime-green thinks) and still the person's own palette. A grey stays grey: the pulse and the
+ * slower rhythm are then the difference. */
+static inline void tl_think_colour(uint8_t r, uint8_t g, uint8_t b, uint8_t* tr, uint8_t* tg, uint8_t* tb)
+{
+    *tr = g;
+    *tg = b;
+    *tb = r;
+}
+
+/* The ring at `since_ms` after `state` began. `hearing` is the voice-activity bit (it hears speech now). */
+static inline tl_rgb_t tl_frame(tl_state_t state, uint32_t since_ms, int hearing, const tl_prefs_t* p, int light_level)
+{
+    tl_rgb_t out = {0, 0, 0, 0};
+    if (light_level <= TL_LIGHT_OFF || state == TL_ST_OFF || state >= TL_ST_COUNT) {
+        return out;
+    }
+    const int peak = light_level == TL_LIGHT_DIM ? TL_PEAK_DIM : TL_PEAK_NORMAL;
+    uint8_t cr = p->r, cg = p->g, cb = p->b;
+    int permille = 0;
+    switch (state) {
+    case TL_ST_LISTEN:
+        /* a breath between 18 and 100 percent; brighter while it hears speech */
+        permille = 180 + (tl_breath_permille(since_ms, TL_BREATH_MS) * 820) / 1000;
+        break;
+    case TL_ST_HEARD:
+        if (since_ms >= TL_HEARD_MS) {
+            return tl_frame(TL_ST_THINK, since_ms - TL_HEARD_MS, 0, p, light_level);
+        }
+        permille = ((since_ms / TL_BLINK_MS) % 2 == 0) ? 1000 : 0; /* on, off, on, off */
+        break;
+    case TL_ST_THINK:
+        tl_think_colour(p->r, p->g, p->b, &cr, &cg, &cb);
+        permille = 120 + (tl_breath_permille(since_ms, TL_THINK_MS) * 560) / 1000;
+        break;
+    case TL_ST_SPEAK:
+        permille = TL_SPEAK_PERMILLE;
+        break;
+    default:
+        return out;
+    }
+    int scale = (peak * permille) / 1000; /* of 255 */
+    if (state == TL_ST_LISTEN && hearing) {
+        scale = (scale * TL_HEARING_BOOST_PERMILLE) / 1000;
+        const int cap = light_level == TL_LIGHT_DIM ? TL_PEAK_DIM : TL_PEAK_MAX_NORMAL;
+        if (scale > cap) scale = cap;
+    }
+    if (scale <= 0) {
+        return out;
+    }
+    out.r   = (uint8_t)((cr * scale + 127) / 255);
+    out.g   = (uint8_t)((cg * scale + 127) / 255);
+    out.b   = (uint8_t)((cb * scale + 127) / 255);
+    out.lit = (out.r | out.g | out.b) != 0;
+    return out;
+}
+
+/* ---- the sound: a short voice-like "mm", rendered once at boot so nothing is decoded or fetched at the wake ---- */
+
+#define TL_MM_RATE 16000
+#define TL_MM_MS 360
+#define TL_MM_SAMPLES (TL_MM_RATE * TL_MM_MS / 1000) /* 5760 samples, 11,520 bytes */
+
+/* A hummed "mm": a glottal buzz at about 175 Hz falling a little, shaped by a low-pass resonance (the nasal murmur
+ * sits under 800 Hz), an attack of 35 ms and a release of 140 ms. Peak about 0.30 of full scale, so it is a murmur
+ * and never a bark. Deterministic. Returns the sample count. */
+static inline size_t tl_render_mm(int16_t* out, size_t cap)
+{
+    const size_t n = TL_MM_SAMPLES < cap ? (size_t)TL_MM_SAMPLES : cap;
+    float phase = 0.0f;
+    float lp1 = 0.0f, lp2 = 0.0f;
+    for (size_t i = 0; i < n; i++) {
+        const float t  = (float)i / TL_MM_RATE;
+        const float f0 = 182.0f - 22.0f * (t / (TL_MM_MS / 1000.0f));
+        phase += f0 / TL_MM_RATE;
+        phase -= floorf(phase);
+        /* a band-limited-ish buzz: the first eight harmonics at 1/k */
+        float s = 0.0f;
+        for (int k = 1; k <= 8; k++) {
+            s += sinf(6.2831853f * phase * (float)k) / (float)k;
+        }
+        lp1 += 0.20f * (s - lp1); /* two poles near 600 Hz at 16 kHz */
+        lp2 += 0.20f * (lp1 - lp2);
+        float env      = 1.0f;
+        const float ms = t * 1000.0f;
+        if (ms < 35.0f) env = ms / 35.0f;
+        else if (ms > TL_MM_MS - 140.0f) env = ((float)TL_MM_MS - ms) / 140.0f;
+        if (env < 0.0f) env = 0.0f;
+        env = env * env * (3.0f - 2.0f * env); /* smoothstep */
+        float v = lp2 * env * 0.50f;
+        if (v > 1.0f) v = 1.0f;
+        if (v < -1.0f) v = -1.0f;
+        out[i] = (int16_t)(v * 32767.0f * 0.60f);
+    }
+    return n;
+}
+
+#endif /* MAIPAI_LISTEN_CORE_H */
diff --git a/firmware/main/hal/maipai_listen.h b/firmware/main/hal/maipai_listen.h
