                         } else {
                             SetDeviceState(kDeviceStateListening);
                         }
+                    } else if (GetDeviceState() == kDeviceStateListening &&
+                               listening_mode_ != kListeningModeManualStop) {
+                        protocol_->SendStartListening(listening_mode_);
                     }
                 });
