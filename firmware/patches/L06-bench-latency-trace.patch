diff --git a/firmware/main/hal/maipai_lat.h b/firmware/main/hal/maipai_lat.h
new file mode 100644
index 0000000..fd8753b
--- /dev/null
+++ b/firmware/main/hal/maipai_lat.h
@@ -0,0 +1,34 @@
+/*
+ * SPDX-License-Identifier: MIT
+ *
+ * Latency trace points (bench build only). One WARN line per point, "LAT <name>", so the serial log carries the
+ * unit's own clock next to the host's receive time. Compiled out unless MAIPAI_SERIAL_TOOLS is on, so the plain
+ * image has no trace code and no extra log traffic in the audio path.
+ */
+#pragma once
+#include <sdkconfig.h>
+
+#ifdef CONFIG_MAIPAI_SERIAL_TOOLS
+#include <esp_log.h>
+#include <esp_timer.h>
+#define MAIPAI_LAT(fmt, ...) ESP_LOGW("LAT", "%lld " fmt, (long long)(esp_timer_get_time() / 1000), ##__VA_ARGS__)
+// One-shot flags: the first packet or sample of a reply is the one that matters.
+extern volatile bool g_lat_first_dl;
+extern volatile bool g_lat_first_ul;
+extern volatile bool g_lat_first_play;
+extern volatile unsigned g_lat_ul_count;
+#define MAIPAI_LAT_COUNT() (g_lat_ul_count = g_lat_ul_count + 1)
+#define MAIPAI_LAT_SET(flag) ((flag) = true)
+#define MAIPAI_LAT_ONCE(flag, fmt, ...) \
+    do {                                \
+        if (flag) {                     \
+            flag = false;               \
+            MAIPAI_LAT(fmt, ##__VA_ARGS__); \
+        }                               \
+    } while (0)
+#else
+#define MAIPAI_LAT(...) ((void)0)
+#define MAIPAI_LAT_ONCE(...) ((void)0)
+#define MAIPAI_LAT_COUNT() ((void)0)
+#define MAIPAI_LAT_SET(...) ((void)0)
+#endif
diff --git a/firmware/main/hal/maipai_bench.cc b/firmware/main/hal/maipai_bench.cc
new file mode 100644
index 0000000..b135e05
--- /dev/null
+++ b/firmware/main/hal/maipai_bench.cc
@@ -0,0 +1,138 @@
+/*
+ * SPDX-License-Identifier: MIT
+ *
+ * Bench only (MAIPAI_SERIAL_TOOLS): plays a stored speech clip into the microphone path so a turn can be timed
+ * without a speaker beside the unit. The wake phrase, a gap, one question and silence are written over the
+ * microphone channel of each 16 kHz block (the reference channel is left alone), at the pace of the real input.
+ * Not in any shipped image.
+ */
+#include <sdkconfig.h>
+
+#if CONFIG_MAIPAI_SERIAL_TOOLS
+#include <hal/maipai_lat.h>
+#include <mcp_server.h>
+
+#include <atomic>
+#include <cstdint>
+#include <cstdio>
+#include <vector>
+
+extern const int g_bench_clip_count;
+extern const uint32_t g_bench_clip_off[];
+extern const uint32_t g_bench_clip_len[];
+extern const int16_t g_bench_clips[];
+
+namespace {
+struct Run {
+    std::atomic<bool> active{false};
+    uint32_t pos = 0;       // samples since the start
+    uint32_t wake_len = 0;  // samples of the wake phrase (0 = none)
+    uint32_t gap = 0;       // samples of silence between them
+    int q = 0;              // question clip, or -1 for none
+    int gain = 100;         // percent of the stored level
+    uint32_t q_len = 0;
+    uint32_t total = 0;
+    bool logged_wake_end = false, logged_q_start = false, logged_q_end = false;
+};
+Run s_run;
+struct Noise {
+    std::atomic<bool> active{false};
+    uint32_t pos = 0, total = 0;
+    int gain_pct = 100;
+} s_noise;
+}  // namespace
+
+// Called from AudioService::ReadAudioData with one block of interleaved 16 kHz audio.
+void maipai_bench_inject(std::vector<int16_t>& data, int channels) {
+    if (s_noise.active.load() && !s_run.active.load()) {
+        const size_t nf = data.size() / (channels > 0 ? channels : 1);
+        const uint32_t nlen = g_bench_clip_len[6];
+        for (size_t f = 0; f < nf; f++) {
+            int v = (int)g_bench_clips[g_bench_clip_off[6] + (s_noise.pos++ % nlen)] * s_noise.gain_pct / 100;
+            data[f * channels] = (int16_t)(v > 32767 ? 32767 : v < -32768 ? -32768 : v);
+            if (channels > 1) data[f * channels + 1] = data[f * channels];  // the room reaches both microphones
+        }
+        if (s_noise.pos >= s_noise.total) {
+            s_noise.active.store(false);
+            MAIPAI_LAT("noise_done");
+        }
+        return;
+    }
+    if (!s_run.active.load()) {
+        return;
+    }
+    const size_t frames = data.size() / (channels > 0 ? channels : 1);
+    for (size_t f = 0; f < frames; f++) {
+        uint32_t p = s_run.pos++;
+        int16_t v = 0;
+        if (p < s_run.wake_len) {
+            v = g_bench_clips[g_bench_clip_off[0] + p];
+        } else if (s_run.q >= 0 && p >= s_run.wake_len + s_run.gap && p < s_run.wake_len + s_run.gap + s_run.q_len) {
+            v = g_bench_clips[g_bench_clip_off[s_run.q] + (p - s_run.wake_len - s_run.gap)];
+        }
+        v = (int16_t)((int)v * s_run.gain / 100);
+        data[f * channels] = v;
+        if (channels > 1) data[f * channels + 1] = v;  // a person's voice reaches both microphones
+        if (p % 16000 == 0) {
+            MAIPAI_LAT("inj_t %u ul=%u", (unsigned)(p / 16000), (unsigned)g_lat_ul_count);
+        }
+        if (!s_run.logged_wake_end && s_run.wake_len && p >= s_run.wake_len) {
+            s_run.logged_wake_end = true;
+            MAIPAI_LAT("inj_wake_end");
+        }
+        if (!s_run.logged_q_start && s_run.q >= 0 && p >= s_run.wake_len + s_run.gap) {
+            s_run.logged_q_start = true;
+            MAIPAI_LAT("inj_q_start");
+        }
+        if (!s_run.logged_q_end && s_run.q >= 0 && p >= s_run.wake_len + s_run.gap + s_run.q_len) {
+            s_run.logged_q_end = true;
+            MAIPAI_LAT("inj_q_end");
+        }
+    }
+    if (s_run.pos >= s_run.total) {
+        s_run.active.store(false);
+        MAIPAI_LAT("inj_done");
+    }
+}
+
+void maipai_bench_register_tools() {
+    auto& mcp = McpServer::GetInstance();
+    mcp.AddTool("self.bench.noise",
+                "Bench only: loops a pink-noise clip into the microphone path for seconds at gain_pct percent.",
+                PropertyList({Property("seconds", kPropertyTypeInteger, 60, 1, 7200),
+                              Property("gain_pct", kPropertyTypeInteger, 100, 1, 1000)}),
+                [](const PropertyList& properties) -> ReturnValue {
+                    s_noise.gain_pct = properties["gain_pct"].value<int>();
+                    s_noise.total = static_cast<uint32_t>(properties["seconds"].value<int>()) * 16000;
+                    s_noise.pos = 0;
+                    MAIPAI_LAT("noise_start gain=%d", s_noise.gain_pct);
+                    s_noise.active.store(true);
+                    return std::string("{\"ok\":true}");
+                });
+    mcp.AddTool("self.bench.inject",
+                "Bench only: plays the wake phrase (wake=1), a gap, question clip q (1 to 5, or 0 for none) and "
+                "silence into the microphone path. Answers at once; the log shows the timing.",
+                PropertyList({Property("q", kPropertyTypeInteger, 1, 0, 5), Property("wake", kPropertyTypeInteger, 1, 0, 1),
+                              Property("gap_ms", kPropertyTypeInteger, 1800, 0, 10000),
+                              Property("tail_ms", kPropertyTypeInteger, 9000, 0, 30000),
+                              Property("gain_pct", kPropertyTypeInteger, 100, 1, 300)}),
+                [](const PropertyList& properties) -> ReturnValue {
+                    if (s_run.active.load()) {
+                        return std::string("{\"ok\":false,\"error\":\"running\"}");
+                    }
+                    const int q = properties["q"].value<int>();
+                    s_run.wake_len = properties["wake"].value<int>() ? g_bench_clip_len[0] : 0;
+                    s_run.gap = static_cast<uint32_t>(properties["gap_ms"].value<int>()) * 16;
+                    s_run.q = q >= 1 && q < g_bench_clip_count ? q : -1;
+                    s_run.q_len = s_run.q >= 0 ? g_bench_clip_len[s_run.q] : 0;
+                    s_run.total = s_run.wake_len + s_run.gap + s_run.q_len +
+                                  static_cast<uint32_t>(properties["tail_ms"].value<int>()) * 16;
+                    s_run.gain = properties["gain_pct"].value<int>();
+                    s_run.pos = 0;
+                    s_run.logged_wake_end = s_run.logged_q_start = s_run.logged_q_end = false;
+                    MAIPAI_LAT("inj_start q=%d", s_run.q);
+                    s_run.active.store(true);
+                    return std::string("{\"ok\":true}");
+                });
+}
+#endif
