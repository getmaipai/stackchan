 #include <sys/time.h>
@@ -34,6 +35,12 @@ int maipai_tz_current()
     return mz_find_posix(GetHAL().getTimezone().c_str());
 }
 
+bool maipai_tz_picker_allowed()
+{
+    Settings paired("websocket", false);  // the saved host address, the same rule the update and the first-run flow use for "paired"
+    return paired.GetString("url").empty();
+}
+
 bool maipai_tz_set(int index)
 {
     if (index < 0 || index >= MZ_COUNT) {
