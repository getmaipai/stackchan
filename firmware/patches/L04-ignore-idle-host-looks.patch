# Intent: A look-around by itself is not a command. self.robot.set_head_angles is answered ok and ignored while the device is idle (no turn, not listening, not speaking) and the person has not turned idle movement on (the saved choice, off by default). Measured on the unit 2026-11-16: the hub host moved the head 53 times in 600 s with nobody speaking; 4 times after the fixes.
# Placement: unit (the head tool runs on the robot)
# Upstream: firmware/main/hal/hal_mcp.cpp, firmware/main/hal/board/hal_bridge.cc of this tree (patches 037, 038)
# Check after a flash: idle for 10 minutes the log shows no 'motion set_angles' lines; during a turn a spoken 'look left' still moves the head.

diff --git a/firmware/main/hal/hal_mcp.cpp b/firmware/main/hal/hal_mcp.cpp
index 6a4035a..524a308 100644
--- a/firmware/main/hal/hal_mcp.cpp
+++ b/firmware/main/hal/hal_mcp.cpp
@@ -272,6 +272,10 @@ void Hal::xiaozhi_mcp_init()
                                               kMaxHeadMovesPerMinute);
                                return false;
                            }
+                           if (hal_bridge::host_idle_look_ignored()) {
+                               mclog::tagInfo(_tag, "set_head_angles ignored: idle and idle movement is off");
+                               return true;  // patch L04: still the default; answered ok so the host does not retry
+                           }
                            int speed = properties["speed"].value<int>();
                            int yaw   = properties["yaw"].value<int>();
                            int pitch = properties["pitch"].value<int>();
diff --git a/firmware/main/hal/board/hal_bridge.cc b/firmware/main/hal/board/hal_bridge.cc
index 23bcd0a..de7f904 100644
--- a/firmware/main/hal/board/hal_bridge.cc
+++ b/firmware/main/hal/board/hal_bridge.cc
@@ -103,6 +103,15 @@ void display_set_idle_motion_enabled(bool enabled)
     display->SetIdleMotionEnabled(enabled);
 }
 
+bool host_idle_look_ignored()
+{
+    auto display = static_cast<DISPLAY_TYPE*>(Board::GetInstance().GetDisplay());
+    if (display == nullptr || display->IsIdleMotionEnabled()) {
+        return false;
+    }
+    return Application::GetInstance().GetDeviceState() == kDeviceStateIdle;
+}
+
 void disply_lvgl_unlock()
 {
     auto display = static_cast<DISPLAY_TYPE*>(Board::GetInstance().GetDisplay());
