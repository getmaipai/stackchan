diff --git a/firmware/main/hal/maipai_linkurl_core.h b/firmware/main/hal/maipai_linkurl_core.h
new file mode 100644
--- /dev/null
+++ b/firmware/main/hal/maipai_linkurl_core.h
@@ -0,0 +1,59 @@
+/*
+ * SPDX-License-Identifier: MIT
+ *
+ * The address rule of the encrypted link (patch SF33; docs/plan/link-key-exchange.md). Plain C99, no heap. A unit paired with the key exchange
+ * talks to its host only over TLS-PSK: ws on 8765 becomes wss on 18775 (voice), ws on 8766 becomes wss on 18776 (avatar and camera), http on 8767
+ * becomes https on 8777 (photos, notification audio, firmware file). Anything else is not rewritten (and a paired unit does not connect to it).
+ * Host test: host/tests/firmware/linkurl_core_test.c.
+ */
+#ifndef MAIPAI_LINKURL_CORE_H
+#define MAIPAI_LINKURL_CORE_H
+
+#include <stddef.h>
+#include <stdio.h>
+#include <string.h>
+
+#define MLU_PORT_VOICE_PLAIN 8765
+#define MLU_PORT_AVATAR_PLAIN 8766
+#define MLU_PORT_HTTP_PLAIN 8767
+#define MLU_PORT_VOICE_TLS 18775
+#define MLU_PORT_AVATAR_TLS 18776
+#define MLU_PORT_HTTP_TLS 8777
+
+/* 1 when the port is one of the host's encrypted listeners (the TLS client uses the key for these and only these). */
+static inline int mlu_is_link_port(int port) { return port == MLU_PORT_VOICE_TLS || port == MLU_PORT_AVATAR_TLS || port == MLU_PORT_HTTP_TLS; }
+
+/* Rewrites "ws://host:8765/path", "ws://host:8766/path" or "http://host:8767/path" to the encrypted address. Returns 1 and fills out, or 0 (out empty). */
+static inline int mlu_rewrite(const char* url, char* out, size_t cap)
+{
+    static const struct {
+        const char* from_scheme;
+        int from_port;
+        const char* to_scheme;
+        int to_port;
+    } map[3] = {{"ws://", MLU_PORT_VOICE_PLAIN, "wss://", MLU_PORT_VOICE_TLS},
+                {"ws://", MLU_PORT_AVATAR_PLAIN, "wss://", MLU_PORT_AVATAR_TLS},
+                {"http://", MLU_PORT_HTTP_PLAIN, "https://", MLU_PORT_HTTP_TLS}};
+    if (out != NULL && cap > 0) out[0] = '\0';
+    if (url == NULL || out == NULL || cap == 0) return 0;
+    for (int i = 0; i < 3; i++) {
+        const size_t sl = strlen(map[i].from_scheme);
+        if (strncmp(url, map[i].from_scheme, sl) != 0) continue;
+        const char* host = url + sl;
+        const char* end = host;
+        while (*end != '\0' && *end != '/' && *end != '?' && *end != '#' && *end != ':') end++;
+        if (end == host || *end != ':') continue;
+        char* stop = NULL;
+        const long port = strtol(end + 1, &stop, 10);
+        if (stop == end + 1 || port != map[i].from_port || (*stop != '\0' && *stop != '/' && *stop != '?' && *stop != '#')) continue;
+        const int n = snprintf(out, cap, "%s%.*s:%d%s", map[i].to_scheme, (int)(end - host), host, map[i].to_port, stop);
+        if (n < 0 || (size_t)n >= cap) {
+            out[0] = '\0';
+            return 0;
+        }
+        return 1;
+    }
+    return 0;
+}
+
+#endif /* MAIPAI_LINKURL_CORE_H */
diff --git a/firmware/main/hal/maipai_pairx_core.h b/firmware/main/hal/maipai_pairx_core.h
new file mode 100644
--- /dev/null
+++ b/firmware/main/hal/maipai_pairx_core.h
@@ -0,0 +1,100 @@
+/*
+ * SPDX-License-Identifier: MIT
+ *
+ * The unit's side of the pairing exchange (patch SF33; docs/plan/link-key-exchange.md): a small state machine over the messages
+ * pair_start, {pk_h, c}, {n_u}, {n_h}, paired. Plain C99. The curve calculation is the caller's (maipai_linkpsk.cc); the hashing is
+ * maipai_linkkey_core.h. Host test: host/tests/firmware/pairx_core_test.c.
+ *
+ * Order, and what a message out of order does: any message that is not the next one aborts the exchange (the keys are wiped).
+ *   BEGIN (pk_u made)  -> host key and commitment arrive -> the unit sends n_u -> the host's nonce arrives and must match the commitment
+ *   -> the six-digit code is shown -> "paired" arrives -> the link key K is derived and handed to the caller.
+ * A wrong code typed on the host makes the host send pair_abort (or nothing: the exchange ends after MPX_TIMEOUT_MS).
+ */
+#ifndef MAIPAI_PAIRX_CORE_H
+#define MAIPAI_PAIRX_CORE_H
+
+#include <stdint.h>
+#include <string.h>
+#include "maipai_linkkey_core.h"
+#include "maipai_time_core.h"
+
+#define MPX_TIMEOUT_MS 120000u
+
+enum { MPX_IDLE = 0, MPX_STARTED, MPX_NONCE_SENT, MPX_CODE_SHOWN, MPX_DONE, MPX_FAILED };
+enum { MPX_OK = 0, MPX_ORDER, MPX_COMMIT_MISMATCH, MPX_TIMEOUT, MPX_REASON_COUNT };
+static const char* const MPX_REASONS[MPX_REASON_COUNT] = {"ok", "a pairing message arrived out of order", "the host's commitment did not match its nonce",
+                                                          "the pairing took too long"};
+
+typedef struct {
+    uint8_t state;
+    uint8_t pk_u[MLY_PK], pk_h[MLY_PK], commit[32], n_u[MLY_NONCE], n_h[MLY_NONCE];
+    uint32_t code;       /* the six digits, valid from MPX_CODE_SHOWN */
+    uint32_t started_ms; /* stamp, never 0 */
+} mpx_t;
+
+static inline void mpx_wipe(mpx_t* s) { lk_wipe(s, sizeof(*s)); }
+
+static inline void mpx_begin(mpx_t* s, const uint8_t pk_u[MLY_PK], uint32_t now)
+{
+    mpx_wipe(s);
+    memcpy(s->pk_u, pk_u, MLY_PK);
+    s->state = MPX_STARTED;
+    s->started_ms = mt_stamp(now, 0);
+}
+
+static inline int mpx_fail(mpx_t* s, int reason)
+{
+    mpx_wipe(s);
+    s->state = MPX_FAILED;
+    return reason;
+}
+
+/* The host's reply to pair_start. The unit then sends n_u (the caller supplied it here). */
+static inline int mpx_on_host_key(mpx_t* s, const uint8_t pk_h[MLY_PK], const uint8_t commit[32], const uint8_t n_u[MLY_NONCE])
+{
+    if (s->state != MPX_STARTED) return mpx_fail(s, MPX_ORDER);
+    memcpy(s->pk_h, pk_h, MLY_PK);
+    memcpy(s->commit, commit, 32);
+    memcpy(s->n_u, n_u, MLY_NONCE);
+    s->state = MPX_NONCE_SENT;
+    return MPX_OK;
+}
+
+/* The host's nonce: it must match the commitment it sent first. Then the code is known and is shown. */
+static inline int mpx_on_host_nonce(mpx_t* s, const uint8_t n_h[MLY_NONCE])
+{
+    uint8_t c[32];
+    if (s->state != MPX_NONCE_SENT) return mpx_fail(s, MPX_ORDER);
+    mly_commit(s->pk_h, s->pk_u, n_h, c);
+    if (lk_ct_equal(c, s->commit, 32) == 0) return mpx_fail(s, MPX_COMMIT_MISMATCH);
+    memcpy(s->n_h, n_h, MLY_NONCE);
+    s->code = mly_sas(s->pk_u, s->pk_h, s->n_u, s->n_h);
+    s->state = MPX_CODE_SHOWN;
+    return MPX_OK;
+}
+
+/* "paired": the owner typed the right code. z is the X25519 shared secret (the caller computed it from its private key and pk_h). */
+static inline int mpx_on_paired(mpx_t* s, const uint8_t z[32], const char* device_id, uint8_t k_out[MLY_KEY])
+{
+    if (s->state != MPX_CODE_SHOWN) return mpx_fail(s, MPX_ORDER);
+    mly_link_key(z, s->pk_u, s->pk_h, s->n_u, s->n_h, device_id, k_out);
+    mpx_wipe(s);
+    s->state = MPX_DONE;
+    return MPX_OK;
+}
+
+/* The host refused or the owner gave up. */
+static inline void mpx_abort(mpx_t* s) { mpx_wipe(s); s->state = MPX_IDLE; }
+
+/* Once a second: an exchange that waits too long ends. Returns 1 when it just ended. */
+static inline int mpx_tick(mpx_t* s, uint32_t now)
+{
+    if (s->state == MPX_IDLE || s->state == MPX_DONE || s->state == MPX_FAILED) return 0;
+    if (mt_elapsed(now, s->started_ms) >= MPX_TIMEOUT_MS) {
+        mpx_fail(s, MPX_TIMEOUT);
+        return 1;
+    }
+    return 0;
+}
+
+#endif /* MAIPAI_PAIRX_CORE_H */
