diff --git a/firmware/vendor_fixes/link_psk.cmake b/firmware/vendor_fixes/link_psk.cmake
new file mode 100644
--- /dev/null
+++ b/firmware/vendor_fixes/link_psk.cmake
@@ -0,0 +1,47 @@
+# Encrypted link, the TLS client (patch SF33), included from firmware/CMakeLists.txt. The network component's TLS client (78/esp-ml307,
+# src/esp/esp_ssl.cc) checks the server against the public certificate bundle. For a connection to one of the host's encrypted ports a
+# unit paired with the key exchange uses the pre-shared key instead (esp-tls already supports it: psk_hint_key). The component in managed_components
+# is not edited: at configure time this script copies esp_ssl.cc into the build directory, adds the key lookup, and swaps the copy in
+# for the original (the same method as vendor_fixes/wifi_roam.cmake). Only when CONFIG_MAIPAI_LINK_PSK is on; with it off nothing changes.
+# The configure stops with an error if the vendor text changed.
+set(maipai_link_psk_dir "${CMAKE_CURRENT_LIST_DIR}")
+
+function(maipai_link_psk_fix)
+    if(NOT CONFIG_MAIPAI_LINK_PSK)
+        return()
+    endif()
+    idf_component_get_property(ssl_lib 78__esp-ml307 COMPONENT_LIB)
+    if(NOT ssl_lib)
+        return()
+    endif()
+    idf_component_get_property(ssl_dir 78__esp-ml307 COMPONENT_DIR)
+    set(src "${ssl_dir}/src/esp/esp_ssl.cc")
+    if(NOT EXISTS "${src}")
+        return()
+    endif()
+    file(READ "${src}" text)
+    set(out "${CMAKE_BINARY_DIR}/maipai_vendor/esp_ssl.cc")
+    set(old_inc "#include <esp_crt_bundle.h>\n")
+    set(new_inc "#include <esp_crt_bundle.h>\nextern bool maipai_link_psk_for_tls(int port, psk_hint_key_t* out);  /* MaiPai SF33 */\n")
+    set(old_cfg "    cfg.crt_bundle_attach = esp_crt_bundle_attach;\n")
+    set(new_cfg "    cfg.crt_bundle_attach = esp_crt_bundle_attach;\n    static psk_hint_key_t maipai_psk;  /* MaiPai SF33: one TLS connection is made at a time */\n    if (maipai_link_psk_for_tls(port, &maipai_psk)) {\n        cfg.crt_bundle_attach = nullptr;\n        cfg.psk_hint_key = &maipai_psk;\n    }\n")
+    foreach(pair old_inc;old_cfg)
+        string(FIND "${text}" "${${pair}}" pos)
+        if(pos EQUAL -1)
+            message(FATAL_ERROR "MaiPai SF33: the TLS client's esp_ssl.cc no longer has the text this fix edits (${pair}). Update firmware/vendor_fixes/link_psk.cmake for the new version of 78/esp-ml307.")
+        endif()
+    endforeach()
+    # The copy is built from the build directory, so the component's own header is named by its full path.
+    string(REPLACE "#include \"esp_ssl.h\"\n" "#include \"${ssl_dir}/src/esp/esp_ssl.h\"\n" text "${text}")
+    string(REPLACE "${old_inc}" "${new_inc}" text "${text}")
+    string(REPLACE "${old_cfg}" "${new_cfg}" text "${text}")
+    file(WRITE "${out}" "${text}")
+    set_property(DIRECTORY "${CMAKE_SOURCE_DIR}" APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${src}")
+
+    get_target_property(srcs ${ssl_lib} SOURCES)
+    list(FILTER srcs EXCLUDE REGEX "esp_ssl\\.cc$")
+    list(APPEND srcs "${out}")
+    set_property(TARGET ${ssl_lib} PROPERTY SOURCES "${srcs}")
+endfunction()
+
+cmake_language(DEFER DIRECTORY "${CMAKE_SOURCE_DIR}" CALL maipai_link_psk_fix)
