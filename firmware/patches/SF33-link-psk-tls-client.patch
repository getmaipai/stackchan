+std::string maipai_link_secure_url(const std::string& url)
+{
+    uint8_t k[32];
+    if (!maipai_link_key_load(k)) {
+        return url;  // no link key: the unit is not paired with the key exchange
+    }
+    lk_wipe(k, sizeof(k));
+    char out[300];
+    if (mlu_rewrite(url.c_str(), out, sizeof(out)) == 0) {
+        ESP_LOGE(kTag, "The host address %s cannot be made encrypted: this unit is paired for the encrypted link and does not connect in the clear. Pair it again or fix the address.", url.c_str());
+        return std::string();
+    }
+    return std::string(out);
+}
+
+bool maipai_link_psk_for_tls(int port, psk_hint_key_t* out)
+{
+    // The key and identity live in static storage for the length of one connection (esp-tls keeps the pointers); one TLS connection is made at a time.
+    static uint8_t s_psk[32];
+    static char s_identity[24];
+    if (out == nullptr || !mlu_is_link_port(port)) return false;
+    uint8_t k[32];
+    if (!maipai_link_key_load(k)) return false;
+    std::string id = SystemInfo::GetMacAddress();
+    std::transform(id.begin(), id.end(), id.begin(), [](unsigned char ch) { return static_cast<char>(std::tolower(ch)); });
+    std::snprintf(s_identity, sizeof(s_identity), "%s", id.c_str());
+    mly_psk(k, s_identity, s_psk);
+    lk_wipe(k, sizeof(k));
+    out->key = s_psk;
+    out->key_size = sizeof(s_psk);
+    out->hint = s_identity;
+    return true;
+}
