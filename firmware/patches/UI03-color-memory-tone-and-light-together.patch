+// ---- patch UI01: Color Memory plays its tone and shows its light as one event ----
+// The rule that lights a tile and the rule that sounds its tone fire in the same instant, but they reach the person by two paths:
+// the tone starts about 3 ms after the call (the audio task has the first block at the codec), the tile only when LVGL has drawn
+// it and the first strip that carries it is sent to the panel (27 to 90 ms later on the unit, see the patch header). So the tone is
+// not started in after_event: it waits, and the first display flush whose area touches the lit tile starts it. The face keeps
+// redrawing under the game, so a strip comes every 10 ms; a tone whose strip never comes (a dark screen) starts after 100 ms anyway.
+// The tone is a pure sine of exactly the time the tile stays lit (MG_COLOR_LIT_MS, also in memory.json).
+struct ColorTone {
+    int idx;           // -1: none waiting
+    int16_t x1, y1, x2, y2;
+    uint32_t since_ms;
+};
+ColorTone s_ct = {-1, 0, 0, 0, 0, 0};
+int16_t* s_ct_buf[MG_COLOR_TONES] = {};  // the four tones, held in PSRAM while Color Memory runs (about 58 KB)
+
+bool is_color_game(const Game* g)
+{
+    return strcmp(g->id, "memory") == 0;
+}
+
+void color_tones_free()
+{
+    s_ct.idx = -1;
+    for (auto& b : s_ct_buf) {
+        if (b != nullptr) {
+            heap_caps_free(b);
+            b = nullptr;
+        }
+    }
+}
+
+bool color_tones_make()
+{
+    for (int i = 0; i < MG_COLOR_TONES; i++) {
+        if (s_ct_buf[i] == nullptr) {
+            s_ct_buf[i] = static_cast<int16_t*>(heap_caps_malloc(MG_COLOR_TONE_SAMPLES * sizeof(int16_t), MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT));
+            if (s_ct_buf[i] == nullptr || mg_color_tone(i, s_ct_buf[i], MG_COLOR_TONE_SAMPLES) == 0) {
+                color_tones_free();
+                return false;  // no memory: the game then falls back to the shipped sounds
+            }
+        }
+    }
+    return true;
+}
+
+void play_color_tone(int idx)
+{
+    if (idx < 0 || idx >= MG_COLOR_TONES || s_ct_buf[idx] == nullptr || !maipai_sounds_gate("popup")) {
+        return;  // mute, sounds off or night: the light still shows
+    }
+#if CONFIG_MAIPAI_GAMES_BENCH
+    const int64_t t0 = esp_timer_get_time();
+    g_mp_pcm_call_us = t0;
+#endif
+    const bool ok = Application::GetInstance().GetAudioService().PlayPcm(s_ct_buf[idx], MG_COLOR_TONE_SAMPLES, MG_COLOR_TONE_RATE);  // PlayPcm copies
+#if CONFIG_MAIPAI_GAMES_BENCH
+    ESP_LOGW("GAMELAT", "%lld tone_call idx=%d took %lld us ok=%d", static_cast<long long>(t0 / 1000), idx,
+             static_cast<long long>(esp_timer_get_time() - t0), ok ? 1 : 0);
+#else
+    (void)ok;
+#endif
+}
+
+// A display flush is about to start: if it carries the waiting tone's tile, the tone starts now.
+void on_flush_sync(lv_event_t* e)
+{
+    if (s_ct.idx < 0) {
+        return;
+    }
+    const lv_area_t* a = static_cast<const lv_area_t*>(lv_event_get_param(e));
+    if (a == nullptr || a->x2 < s_ct.x1 || a->x1 > s_ct.x2 || a->y2 < s_ct.y1 || a->y1 > s_ct.y2) {
+        return;
+    }
+    const int idx = s_ct.idx;
+    s_ct.idx      = -1;
+    play_color_tone(idx);
+}
+
+void color_sync_attach(bool on)
+{
+    lv_display_t* d = lv_display_get_default();
+    if (d == nullptr) {
+        return;
+    }
+    if (on) {
+        lv_display_add_event_cb(d, on_flush_sync, LV_EVENT_FLUSH_START, nullptr);
+    } else {
+        lv_display_remove_event_cb_with_user_data(d, on_flush_sync, nullptr);
+    }
+}
+
+// The tick: a tone whose strip never came (a dark or busy screen) starts after 100 ms.
+void color_tone_fallback(uint32_t now)
+{
+    if (s_ct.idx >= 0 && now - s_ct.since_ms >= 100) {
+        const int idx = s_ct.idx;
+        s_ct.idx      = -1;
+        play_color_tone(idx);
+    }
+}
+
+void redraw(Game* g, bool force);
+#if CONFIG_MAIPAI_GAMES_BENCH
+void on_disp_event(lv_event_t* e)
+{
+    if (s_light_mark_us == 0) {
+        return;
+    }
+    const int64_t now = esp_timer_get_time();
+    if (now - s_light_mark_us > 400000) {
+        s_light_mark_us = 0;
+        return;
+    }
+    const lv_event_code_t code = lv_event_get_code(e);
+    if (code == LV_EVENT_REFR_READY) {
+        ESP_LOGW("GAMELAT", "%lld light_refr_ready +%lld us", static_cast<long long>(now / 1000), static_cast<long long>(now - s_light_mark_us));
+        return;
+    }
+    const lv_area_t* a = static_cast<const lv_area_t*>(lv_event_get_param(e));
+    if (a == nullptr) {
+        return;
+    }
+    ESP_LOGW("GAMELAT", "%lld light_%s +%lld us area %d,%d,%d,%d", static_cast<long long>(now / 1000),
+             code == LV_EVENT_FLUSH_START ? "flush_start" : "flush_finish", static_cast<long long>(now - s_light_mark_us),
+             static_cast<int>(a->x1), static_cast<int>(a->y1), static_cast<int>(a->x2), static_cast<int>(a->y2));
+}
+#endif
