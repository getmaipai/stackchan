diff --git a/firmware/main/hal/maipai_games_core.h b/firmware/main/hal/maipai_games_core.h
--- a/firmware/main/hal/maipai_games_core.h
+++ b/firmware/main/hal/maipai_games_core.h
@@ -105,6 +105,51 @@ typedef enum { MG_SH_FILL = 0, MG_SH_CIRCLE, MG_SH_BOX, MG_SH_RING, MG_SH_TEXT,
 /* The tones are the unit's shipped sounds, played through the sound policy; the last is the error sound. */
 static const char* const MG_TONES[MG_TONE_COUNT] = {"popup", "vibration", "success", "low_battery", "exclamation"};
 
+/* Patch UI01: the Color Memory tones. The shipped sounds differ in length (a tile is lit for a fixed time), so the four colors play
+ * a pure tone of exactly the lit time, started together with the tile: red, green, blue and yellow are four pitches. The lit time
+ * is also in firmware/games/memory.json (show, echo and correct all last MG_COLOR_LIT_MS); a test keeps both equal.
+ * The tone is a sine with a 10 ms rise and a 40 ms fall, made with a recurrence (no libm) into a caller buffer. */
+#define MG_COLOR_LIT_MS 450
+#define MG_COLOR_TONE_RATE 16000
+#define MG_COLOR_TONE_SAMPLES ((MG_COLOR_TONE_RATE / 1000) * MG_COLOR_LIT_MS)
+#define MG_COLOR_TONES 4
+static const uint16_t MG_COLOR_HZ[MG_COLOR_TONES] = {330, 262, 392, 220}; /* red E4, green C4, blue G4, yellow A3 */
+
+/* Fills out (cap samples, at least MG_COLOR_TONE_SAMPLES) with color `idx`; returns the number of samples, 0 for a bad index. */
+static inline size_t mg_color_tone(int idx, int16_t* out, size_t cap)
+{
+    if (idx < 0 || idx >= MG_COLOR_TONES || out == NULL || cap < (size_t)MG_COLOR_TONE_SAMPLES) {
+        return 0;
+    }
+    const float w = 6.2831853f * (float)MG_COLOR_HZ[idx] / (float)MG_COLOR_TONE_RATE;
+    const float w2 = w * w;
+    const float c = 1.0f - w2 / 2.0f + w2 * w2 / 24.0f - w2 * w2 * w2 / 720.0f;
+    const float sn = w - w2 * w / 6.0f + w2 * w2 * w / 120.0f;
+    float y1 = sn, y2 = 0.0f; /* y[1], y[0] of sin(w n) */
+    const size_t n = (size_t)MG_COLOR_TONE_SAMPLES;
+    const size_t rise = (size_t)(MG_COLOR_TONE_RATE / 100), fall = (size_t)(MG_COLOR_TONE_RATE / 25);
+    for (size_t i = 0; i < n; i++) {
+        float y;
+        if (i == 0) {
+            y = 0.0f;
+        } else if (i == 1) {
+            y = y1;
+        } else {
+            y = 2.0f * c * y1 - y2;
+            y2 = y1;
+            y1 = y;
+        }
+        float env = 1.0f;
+        if (i < rise) {
+            env = (float)i / (float)rise;
+        } else if (i + fall > n) {
+            env = (float)(n - i) / (float)fall;
+        }
+        out[i] = (int16_t)(y * env * 16000.0f);
+    }
+    return n;
+}
