+// Starts an overlay (LVGL lock held). Returns false when overlays are switched off in the preferences.
+bool ov_start(int id, int intensity, uint32_t seconds)
+{
+    if (!maipai_pref(MP_OVERLAYS_ENABLED)) {
+        return false;
+    }
+    s_ov_seed = s_ov_seed * 1664525u + 1013904223u + static_cast<uint32_t>(esp_timer_get_time());
+    mo_layer_t* L = &s_ov[mo_layer_of(id)];
+    mo_start(L, id, intensity, seconds, s_ov_seed);
+    L->pct = static_cast<uint8_t>(mg_particles_pct(&s_gov) > 0 ? mg_particles_pct(&s_gov) : 100);
+    ov_set_hidden(ov_should_hide());
+    ov_invalidate(L);
+    ov_ensure_timer();
+    return true;
+}
