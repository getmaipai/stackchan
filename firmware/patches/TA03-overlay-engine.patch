+// Whether overlays may show now: not under a mute, vision-off or quiet look, the clock face or the flat fallback.
+bool ov_should_hide()
+{
+    return mg_flat(&s_gov) || maipai_privacy_bits() != 0 || maipai_face_clock_visible();
+}
+
+void ov_set_hidden(bool hide)
+{
+    if (hide == s_ov_hidden) {
+        return;
+    }
+    s_ov_hidden = hide;
+    for (int l = 0; l < 2; l++) {
+        if (s_ov[l].id != MO_NONE) {
+            mo_mark_extent(&s_ov[l]);  // draw it or wipe it
+            ov_invalidate(&s_ov[l]);
+        }
+    }
+}
+
+void ov_governor_changed()
+{
+    const int pct = mg_particles_pct(&s_gov);
+    for (int l = 0; l < 2; l++) {
+        s_ov[l].pct = static_cast<uint8_t>(pct > 0 ? pct : 100);
+    }
+    if (ov_any()) {
+        ov_set_hidden(ov_should_hide());
+    }
+}
+
+void ov_tick(lv_timer_t*)
+{
+    const int64_t now = esp_timer_get_time();
+    const uint32_t dt = static_cast<uint32_t>((now - s_ov_last_us) / 1000);
+    s_ov_last_us      = now;
+    ov_set_hidden(ov_should_hide());
+    for (int l = 0; l < 2; l++) {
+        mo_layer_t* L = &s_ov[l];
+        if (L->id == MO_NONE) {
+            continue;
+        }
+        if (!s_ov_hidden) {
+            mo_step(L, dt > 200 ? 200 : dt);
+        } else if (L->dur_ms != 0) {
+            L->t_ms += dt;  // the clock runs while hidden, so a timed overlay still ends on time
+            if (L->spawning && L->t_ms >= L->dur_ms) mo_stop(L);
+        }
+        if (mo_done(L)) {
+            if (l == 1) s_zzz_auto = false;
+            mo_clear(L);
+        }
+        ov_invalidate(L);
+    }
+    if (!ov_any()) {
+        lv_timer_pause(s_ov_timer);
+    }
+}
+
+void ov_ensure_timer()
+{
+    s_ov_last_us = esp_timer_get_time();
+    if (s_ov_timer == nullptr) {
+        s_ov_timer = lv_timer_create(ov_tick, MO_TICK_MS, nullptr);
+    } else {
+        lv_timer_resume(s_ov_timer);
+    }
+}
