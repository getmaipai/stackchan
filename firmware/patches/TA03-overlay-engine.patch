+                "it runs (1 to 3600; 0 runs until self.overlay.clear). A new overlay replaces the running one in its own layer "
+                "(weather: rain, snow, sun, clouds, wind, thunder, fog, stars, leaves, disco; event: confetti, fireworks, hearts, "
+                "steam, balloons, zzz). A mute, vision-off or quiet look and the clock face hide overlays. Answers {ok} or "
+                "{ok:false,error}.",
+                PropertyList({Property("name", kPropertyTypeString, std::string("rain")),
+                              Property("intensity", kPropertyTypeString, std::string("normal")),
+                              Property("seconds", kPropertyTypeInteger, 8, 0, 3600)}),
+                [](const PropertyList& properties) -> ReturnValue {
+                    const std::string name      = properties["name"].value<std::string>();
+                    const std::string intensity = properties["intensity"].value<std::string>();
+                    const int seconds           = properties["seconds"].value<int>();
+                    const int id                = mo_id(name.c_str());
+                    if (id == 0) {
+                        return reply_error("that overlay is not known: use rain, snow, sun, clouds, wind, thunder, fog, stars, disco, confetti, fireworks, hearts, steam, balloons, leaves or zzz");
+                    }
+                    int level = 0;
+                    if (intensity == "light") level = 1;
+                    else if (intensity == "normal") level = 2;
+                    else if (intensity == "heavy") level = 3;
+                    if (level == 0) {
+                        return reply_error("intensity must be light, normal or heavy: pick one and send again");
+                    }
+                    if (seconds < 0 || seconds > 3600) {
+                        return reply_error("seconds must be from 0 to 3600: 0 runs until cleared");
+                    }
+                    LvglLockGuard lock;
+                    if (!ov_start(id, level, static_cast<uint32_t>(seconds))) {
+                        return reply_error("overlays are turned off in the settings: turn them on and send again");
+                    }
+                    return std::string("{\"ok\":true}");
+                });
+    mcp.AddTool("self.overlay.clear", "Remove every overlay at once. Answers {ok}.", std::vector<Property>{},
+                [](const PropertyList&) -> ReturnValue {
+                    LvglLockGuard lock;
+                    ov_clear_all();
+                    return std::string("{\"ok\":true}");
+                });
 }
 #endif
