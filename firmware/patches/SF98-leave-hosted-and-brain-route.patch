diff --git a/firmware/main/hal/maipai_hosted.h b/firmware/main/hal/maipai_hosted.h
new file mode 100644
--- /dev/null
+++ b/firmware/main/hal/maipai_hosted.h
@@ -0,0 +1,17 @@
+/*
+ * SPDX-License-Identifier: MIT
+ *
+ * The Brain route and leaving the hosted brain, device side (patch SF98; rules in maipai_hosted_core.h). Route custom (the unit's own host or local) is the default; hosted
+ * exists only in the cloudtest image kind for now. self.brain.status and self.brain.set_route are in every image.
+ */
+#pragma once
+#include <sdkconfig.h>
+#include <stdint.h>
+
+void maipai_brain_register_tools();
+// The hosted link must not run: the route is custom, or it was just left. Cheap, any task.
+bool maipai_hosted_blocked();
+// One attempt to reach the vendor service (a check, an activation, a connect). Counted so a bench check can show there were none after leaving.
+void maipai_hosted_note_attempt();
+// Stops the hosted link, erases every cl_ namespace, tells the screen and the host, saves route custom, and restarts the unit shortly after (so no timer, task or RAM copy of the vendor link survives).
+void maipai_hosted_leave();
diff --git a/firmware/main/hal/maipai_hosted.cc b/firmware/main/hal/maipai_hosted.cc
new file mode 100644
--- /dev/null
+++ b/firmware/main/hal/maipai_hosted.cc
@@ -0,0 +1,148 @@
+/*
+ * SPDX-License-Identifier: MIT
+ *
+ * The Brain route and leaving the hosted brain, device side (patch SF98). See maipai_hosted.h.
+ */
+#include "maipai_hosted.h"
+#include "maipai_hosted_core.h"
+#include "device_events.h"
+#include "hal.h"
+#include <application.h>
+#include <esp_log.h>
+#include <esp_system.h>
+#include <esp_timer.h>
+#include <mcp_server.h>
+#include <nvs.h>
+#include <settings.h>
+#include <atomic>
+#include <cstdio>
+#include <string>
+#include <vector>
+
+static const char* TAG = "MAIPAI-BRAIN";
+
+namespace {
+
+#if CONFIG_MAIPAI_CLOUDTEST
+constexpr bool kHostedBuild = true;
+#else
+constexpr bool kHostedBuild = false;
+#endif
+
+std::atomic<bool> s_left{false};
+std::atomic<uint32_t> s_attempts{0};
+
+bool route_is_custom()
+{
+    Settings st(MHS_ROUTE_NS, false);
+    return st.GetString("route", kHostedBuild ? "hosted" : "custom") == "custom";
+}
+
+std::vector<std::string> all_namespaces()
+{
+    std::vector<std::string> names;
+    nvs_iterator_t it = nullptr;
+    esp_err_t err = nvs_entry_find(NVS_DEFAULT_PART_NAME, nullptr, NVS_TYPE_ANY, &it);
+    while (err == ESP_OK && it != nullptr) {
+        nvs_entry_info_t info;
+        nvs_entry_info(it, &info);
+        bool seen = false;
+        for (const auto& n : names) seen = seen || n == info.namespace_name;
+        if (!seen) names.emplace_back(info.namespace_name);
+        err = nvs_entry_next(&it);
+    }
+    nvs_release_iterator(it);
+    return names;
+}
+
+int erase_ns(void*, const char* ns)
+{
+    nvs_handle_t h;
+    esp_err_t err = nvs_open(ns, NVS_READWRITE, &h);
+    if (err != ESP_OK) return -1;
+    err = nvs_erase_all(h);
+    if (err == ESP_OK) err = nvs_commit(h);
+    nvs_close(h);
+    return err == ESP_OK ? 0 : -1;
+}
+
+int hosted_keys()
+{
+    int n = 0;
+    nvs_iterator_t it = nullptr;
+    esp_err_t err = nvs_entry_find(NVS_DEFAULT_PART_NAME, nullptr, NVS_TYPE_ANY, &it);
+    while (err == ESP_OK && it != nullptr) {
+        nvs_entry_info_t info;
+        nvs_entry_info(it, &info);
+        if (mhs_is_hosted_ns(info.namespace_name)) n++;
+        err = nvs_entry_next(&it);
+    }
+    nvs_release_iterator(it);
+    return n;
+}
+
+bool want_spanish()
+{
+    return false;   // the plain line is shown in English; the Spanish twin is in the core for the screens that know the language
+}
+
+}  // namespace
+
+bool maipai_hosted_blocked() { return s_left.load() || route_is_custom(); }
+
+void maipai_hosted_note_attempt() { s_attempts.fetch_add(1); }
+
+void maipai_hosted_leave()
+{
+    s_left.store(true);   // the check loops and the connect path stop at their next look
+    std::vector<std::string> names = all_namespaces();
+    std::vector<const char*> ptrs;
+    for (const auto& n : names) ptrs.push_back(n.c_str());
+    const int r = mhs_leave(ptrs.data(), static_cast<int>(ptrs.size()), erase_ns, nullptr);
+    {
+        Settings st(MHS_ROUTE_NS, true);
+        st.SetString("route", "custom");
+    }
+    ESP_LOGW(TAG, "hosted link left: %d namespaces erased%s", r < 0 ? 0 : r, r < 0 ? " (some failed; a second call finishes)" : "");
+    Application::GetInstance().Schedule([]() {
+        Application::GetInstance().Alert("Brain", mhs_removed_text(want_spanish() ? 1 : 0), "neutral", "");   // silent
+    });
+    device_events_push("brain_route", "\"route\":\"custom\",\"hosted_removed\":true");
+    // A restart ends every vendor timer, task and RAM copy at once; the line stays readable first.
+    static esp_timer_handle_t t = nullptr;
+    esp_timer_create_args_t a = {};
+    a.callback = [](void*) { esp_restart(); };
+    a.name = "brain_restart";
+    if (esp_timer_create(&a, &t) == ESP_OK) esp_timer_start_once(t, 4ll * 1000 * 1000);
+}
+
+void maipai_brain_register_tools()
+{
+    auto& mcp = McpServer::GetInstance();
+    mcp.AddTool("self.brain.status",
+                "Which brain the unit uses: route custom (its own host or local) or hosted, how many saved vendor keys (cl_ namespaces) it holds, and how many attempts to reach the vendor service it made since it started. "
+                "Answers {ok, route, hosted_build, cl_keys, vendor_attempts}.",
+                std::vector<Property>{}, [](const PropertyList&) -> ReturnValue {
+                    return std::string("{\"ok\":true,\"route\":\"") + (maipai_hosted_blocked() ? "custom" : "hosted") + "\",\"hosted_build\":" + (kHostedBuild ? "true" : "false") +
+                           ",\"cl_keys\":" + std::to_string(hosted_keys()) + ",\"vendor_attempts\":" + std::to_string(s_attempts.load()) + "}";
+                });
+    mcp.AddTool("self.brain.set_route",
+                "Choose the brain: custom leaves the hosted brain (stops the vendor link, erases every saved vendor key, shows one line on screen, sends the event brain_route and restarts the unit in a few seconds). "
+                "hosted only works in the cloud test image and takes effect at the next start. The host pairing and the privacy settings are never touched. Answers {ok, route}.",
+                PropertyList({Property("route", kPropertyTypeString, std::string("custom"))}),
+                [](const PropertyList& properties) -> ReturnValue {
+                    const std::string route = properties["route"].value<std::string>();
+                    if (route == "custom") {
+                        maipai_hosted_leave();
+                        return std::string("{\"ok\":true,\"route\":\"custom\"}");
+                    }
+                    if (route == "hosted") {
+                        if (!kHostedBuild)
+                            return std::string("{\"ok\":false,\"error\":\"This image has no hosted brain. Use the cloud test image to try it.\"}");
+                        Settings st(MHS_ROUTE_NS, true);
+                        st.SetString("route", "hosted");
+                        return std::string("{\"ok\":true,\"route\":\"hosted\",\"applies\":\"at the next start\"}");
+                    }
+                    return std::string("{\"ok\":false,\"error\":\"The route must be custom or hosted. Send one of those two.\"}");
+                });
+}
diff --git a/firmware/main/hal/maipai_hosted_core.h b/firmware/main/hal/maipai_hosted_core.h
new file mode 100644
--- /dev/null
+++ b/firmware/main/hal/maipai_hosted_core.h
@@ -0,0 +1,39 @@
+/*
+ * SPDX-License-Identifier: MIT
+ *
+ * Leaving the hosted brain (patch SF98; docs/plan/cloud-brain-firmware-test.md, "Leaving hosted"): the pure rules. Everything the unit keeps for the vendor's hosted
+ * service lives in NVS namespaces that start with "cl_" (the activation state, the token, the websocket and MQTT settings, any cached offer). Leaving erases exactly
+ * those namespaces and nothing else: the host pairing ("websocket"), the privacy bits ("maipai_priv") and the chip's key blocks are never touched. Plain C99.
+ */
+#ifndef MAIPAI_HOSTED_CORE_H
+#define MAIPAI_HOSTED_CORE_H
+
+#include <string.h>
+#include "maipai_reset_core.h"
+
+#define MHS_PREFIX "cl_"
+#define MHS_ROUTE_NS "mp_brain"   /* the route choice itself: "hosted" or "custom" (not a cl_ namespace: it must survive the erase) */
+
+static inline int mhs_is_hosted_ns(const char* ns) { return ns != NULL && strncmp(ns, MHS_PREFIX, strlen(MHS_PREFIX)) == 0; }
+
+/* Erases every namespace of `names` that is a hosted one, through erase(ctx, name) (0 on success). Returns how many were erased, or -1 if any erase failed
+ * (the rest are still tried, so a retry finishes the job). Repeating it is harmless. */
+static inline int mhs_leave(const char* const* names, int n, int (*erase)(void*, const char*), void* ctx)
+{
+    int done = 0, failed = 0;
+    for (int i = 0; i < n; i++) {
+        if (!mhs_is_hosted_ns(names[i])) continue;
+        if (erase(ctx, names[i]) == 0) done++;
+        else failed = 1;
+    }
+    return failed ? -1 : done;
+}
+
+/* The one line shown on the screen when the hosted link is removed. */
+static inline const char* mhs_removed_text(int es)
+{
+    return es ? "Enlace alojado quitado. Para que tu cuenta deje de tener este robot, quitalo en la consola del proveedor."
+              : "Hosted link removed. To stop your account keeping this robot, remove it in the vendor's console.";
+}
+
+#endif
