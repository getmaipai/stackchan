# Intent: Faces core, part 1 (owner brief 2026-11-16). The default skin is rebuilt on one pure core (hal/maipai_look_core.h): a style table; an eye that is a circle with a lid, where the lid is a square three boxes wide so it covers the whole circle above its straight edge at any tilt, and an open eye is a full circle at every tilt; a SIGNED tilt that is never clamped (the base element clamped every negative tilt to none, so the right eye was cut at one angle and the left at another: the clipped eyes seen on the glass); a mouth that is one family of shapes (a stroke along a curve: width, bend, thickness, wobble, split) so a smile, a cat mouth, a wobble line and an open O ease into each other, drawn with round-ended line segments; the sleep sequence (awake, sleepy with slow blinks that stay longer, closing over 1.5 s, closed with a thin curved line near the middle of the eye, waking with a stretch blink); a 140 ms blink; thinking dots at the MOUTH position on every style; and a gentle emotion tint (angry warm red, sad cool blue, love pink, sleepy and tired dim). New emotions: surprised, tired, closing, sleeping, love, content. The stock style keeps the stock skin's own lids and tilts and the stock bar mouth, with no tint. Costs: a few floats per eye, 17 points on the stack per mouth draw, no heap after init except the three thinking dots while they show.
# Placement: unit (the face runs on the robot, so it is complete with no host)
# Upstream: firmware/main/stackchan/avatar/skins/default/{default.h,default.cpp,eyes.cpp,mouth.cpp}, avatar/elements/{emotion.h,feature.h} and modifiers/blink.h of the StackChan main component (MIT); patches H02 (the eased motion this extends), F05 (the thinking cue it moves into the skin); new file hal/maipai_look_core.h
# Check after a flash: every style times every state drawn from the unit (scripts/fw-serial.py snap, self.face.bench_emotion); both eyes mirror; an open eye is a full circle; speaking fps on a real spoken turn (FACEFPS lines).

diff --git a/firmware/main/hal/maipai_look_core.h b/firmware/main/hal/maipai_look_core.h
new file mode 100644
index 0000000..9022879
--- /dev/null
+++ b/firmware/main/hal/maipai_look_core.h
@@ -0,0 +1,535 @@
+/*
+ * SPDX-License-Identifier: MIT
+ *
+ * The look of the face (patch X01): the pure logic. No ESP-IDF, no heap, no clock of its own. Header-only plain C99 so
+ * a host compiler can test it (host/tests/firmware/look_core_test.c). The device side is the default skin
+ * (stackchan/avatar/skins/default: eyes.cpp, mouth.cpp, dots.cpp); the host renderer (scripts/fw-face-render) draws the
+ * same code into a picture.
+ *
+ * What is here:
+ *  - the style table: eye size, spacing, mouth kind, for Big eyes, Eyes only, Stock, Classic and Minimal;
+ *  - the eye geometry: an eye is a circle with a lid. The lid is a half plane cut by a straight edge; the edge never cuts
+ *    an eye that is fully open, at any tilt. A lid drawn as a rectangle is always large enough to cover the half plane
+ *    inside the circle (ml_lid_covers), which is what the old square lid failed to do at a tilt;
+ *  - the emotion table: per emotion the lid, the tilt, the mouth shape, the tint;
+ *  - the mouth: one family of shapes, a stroke along a curve (width, bend, thickness, wobble, split). A smile, a cat mouth,
+ *    an open O and a wobble line are all points in that family, so one shape eases into the next;
+ *  - the sleep sequence: awake, sleepy, closing, closed, waking;
+ *  - the thinking dots at the mouth position, and the tint blend.
+ */
+#ifndef MAIPAI_LOOK_CORE_H
+#define MAIPAI_LOOK_CORE_H
+
+#include "maipai_facefx_core.h"
+#include <math.h>
+#include <stdint.h>
+#include <string.h>
+
+/* ---------------------------------------------------------------- styles */
+
+#define ML_STYLE_BIG_EYES 0
+#define ML_STYLE_EYES_ONLY 1
+#define ML_STYLE_STOCK 2
+#define ML_STYLE_CLASSIC 3
+#define ML_STYLE_MINIMAL 4
+#define ML_STYLE_COUNT 5
+
+#define ML_MOUTH_NONE 0
+#define ML_MOUTH_CUTE 1 /* the stroke family below */
+#define ML_MOUTH_BAR 2  /* the stock bar: a rounded rectangle that grows from 90 by 6 to 60 by 50 */
+
+typedef struct {
+    const char* name;
+    int16_t eye_d;      /* eye diameter, pixels */
+    int16_t eye_x;      /* each eye's distance from the middle */
+    int16_t eye_y;      /* eye centre above (negative) or below the middle of the screen */
+    int16_t mouth_y;    /* mouth centre; the thinking dots sit here too, also in a style with no mouth */
+    uint8_t mouth;      /* ML_MOUTH_* */
+    int16_t mouth_w;    /* resting mouth width */
+    int16_t mouth_t;    /* resting mouth line thickness */
+    uint8_t stock_look; /* 1: the emotions are the stock skin's own (lid weight and tilt as shipped) */
+} ml_style_t;
+
+static const ml_style_t ML_STYLES[ML_STYLE_COUNT] = {
+    {"big_eyes", 48, 72, -28, 54, ML_MOUTH_CUTE, 46, 8, 0},
+    {"eyes_only", 50, 74, -6, 64, ML_MOUTH_NONE, 0, 0, 0},
+    {"stock", 20, 70, -16, 26, ML_MOUTH_BAR, 90, 6, 1},
+    {"classic", 34, 70, -22, 42, ML_MOUTH_CUTE, 36, 6, 0},
+    {"minimal", 16, 60, -10, 30, ML_MOUTH_CUTE, 22, 3, 0},
+};
+
+static inline const ml_style_t* ml_style(int id) { return &ML_STYLES[(id >= 0 && id < ML_STYLE_COUNT) ? id : ML_STYLE_BIG_EYES]; }
+
+/* The side of the square an eye is drawn in: room for the circle and one pixel of edge on every side. */
+static inline int ml_eye_box(int eye_d) { return eye_d + 4; }
+
+/* ---------------------------------------------------------------- emotions */
+
+typedef enum {
+    ML_NEUTRAL = 0,
+    ML_HAPPY,
+    ML_ANGRY,
+    ML_SAD,
+    ML_DOUBT,
+    ML_SLEEPY,
+    ML_SURPRISED,
+    ML_TIRED,
+    ML_CLOSING,  /* lids lower to shut, then stay shut */
+    ML_SLEEPING, /* shut */
+    ML_LOVE,
+    ML_CONTENT, /* the resting look of a well cared for unit: round eyes, a small smile */
+    ML_COUNT
+} ml_emotion_t;
+
+typedef struct {
+    float w;     /* chord width, pixels, at the big-eyes size */
+    float bend;  /* how far the middle sits below the ends (a smile is positive) */
+    float t;     /* line thickness; a thick short stroke is an open mouth */
+    float wob;   /* wobble amplitude */
+    float split; /* 0 one curve, 1 two curves side by side (the cat mouth) */
+    float tilt;  /* degrees, the whole mouth */
+} ml_mouth_t;
+
+typedef struct {
+    float lid;          /* percent of the eye that shows, 0 to 100 */
+    int8_t from_bottom; /* 1: the lid comes up from below (a happy eye) */
+    float tilt;         /* degrees, left eye; the right eye mirrors it */
+    float scale;        /* eye size factor */
+    ml_mouth_t mouth;
+    uint8_t tint;       /* ML_TINT_* */
+} ml_look_t;
+
+#define ML_TINT_NONE 0
+#define ML_TINT_RED 1
+#define ML_TINT_BLUE 2
+#define ML_TINT_PINK 3
+#define ML_TINT_DIM 4
+
+/* Our own looks. Tilts follow the stock skin's signs: a positive tilt on the left eye lowers the lid edge toward the middle. */
+static const ml_look_t ML_LOOKS[ML_COUNT] = {
+    /* neutral   */ {100, 0, 0, 1.00f, {24, 8, 8, 0, 0, 0}, ML_TINT_NONE},
+    /* happy     */ {62, 1, -10, 1.00f, {30, 11, 8, 0, 1, 0}, ML_TINT_NONE},
+    /* angry     */ {70, 0, 20, 1.00f, {24, -7, 8, 0, 0, 0}, ML_TINT_RED},
+    /* sad       */ {72, 0, -18, 0.94f, {22, -7, 7, 0, 0, 0}, ML_TINT_BLUE},
+    /* doubt     */ {80, 0, 6, 1.00f, {24, 0, 7, 1.6f, 0, 9}, ML_TINT_NONE},
+    /* sleepy    */ {50, 0, -6, 1.00f, {6, 0, 12, 0, 0, 0}, ML_TINT_DIM},
+    /* surprised */ {100, 0, 0, 1.12f, {3, 0, 22, 0, 0, 0}, ML_TINT_NONE},
+    /* tired     */ {56, 0, -10, 1.00f, {14, 0, 10, 0, 0, 0}, ML_TINT_DIM},
+    /* closing   */ {6, 0, -4, 1.00f, {14, 0, 6, 0, 0, 0}, ML_TINT_DIM},
+    /* sleeping  */ {6, 0, -4, 1.00f, {14, 0, 6, 0, 0, 0}, ML_TINT_DIM},
+    /* love      */ {62, 1, -10, 1.00f, {30, 13, 8, 0, 1, 0}, ML_TINT_PINK},
+    /* content   */ {100, 0, 0, 1.00f, {24, 8, 8, 0, 0, 0}, ML_TINT_NONE},
+};
+
+/* The stock skin's own emotions (patch H02's source skin): lid weight and tilt as shipped. */
+static inline ml_look_t ml_stock_look(int emotion)
+{
+    ml_look_t l = ML_LOOKS[ML_NEUTRAL];
+    switch (emotion) {
+        case ML_HAPPY:
+        case ML_LOVE: l.lid = 72; l.from_bottom = 1; l.tilt = -25; break; /* stock: 72 percent, 155 degrees */
+        case ML_ANGRY: l.lid = 70; l.tilt = 45; break;
+        case ML_SAD: l.lid = 70; l.tilt = -40; break;
+        case ML_DOUBT: l.lid = 75; break;
+        case ML_SLEEPY: l.lid = 35; l.tilt = -5; break;
+        case ML_TIRED: l.lid = 50; l.tilt = -8; break;
+        case ML_CLOSING:
+        case ML_SLEEPING: l.lid = 6; break;
+        default: break;
+    }
+    l.mouth = ML_LOOKS[emotion >= 0 && emotion < ML_COUNT ? emotion : 0].mouth;
+    l.tint = ML_TINT_NONE; /* the stock face is as shipped: white */
+    return l;
+}
+
+static inline ml_look_t ml_look(int style, int emotion)
+{
+    if (emotion < 0 || emotion >= ML_COUNT) {
+        emotion = ML_NEUTRAL;
+    }
+    return ml_style(style)->stock_look ? ml_stock_look(emotion) : ML_LOOKS[emotion];
+}
+
+/* The tilt the container is rotated by, in tenths of a degree, for each eye. The right eye mirrors the left; a lid from
+ * below turns the container half a turn. Always a plain signed int: no clamp (the old element clamp turned every
+ * negative tilt into none, which cut the two eyes differently). */
+static inline int ml_eye_rotation_deci(const ml_look_t* l, int right_eye)
+{
+    float deg = l->tilt + (l->from_bottom ? 180.0f : 0.0f);
+    if (right_eye) {
+        deg = -deg;
+    }
+    return (int)lroundf(deg * 10.0f);
+}
+
+/* ---------------------------------------------------------------- the eye: a circle and a lid */
+
+/* The lid edge, in pixels from the eye's centre toward the shut side. Open 100 puts the edge at the far rim (nothing
+ * covered); open 50 puts it through the middle; open 0 at the near rim (everything covered). */
+static inline float ml_lid_edge(float eye_d, float open_pct)
+{
+    if (open_pct > 100.0f) open_pct = 100.0f;
+    if (open_pct < 0.0f) open_pct = 0.0f;
+    const float r = eye_d * 0.5f;
+    return r * (1.0f - open_pct / 50.0f); /* y of the edge, up is negative: -r at 100, +r at 0 */
+}
+
+/* The shape of an eye that is shut for good: never less than a few pixels, so a sleeping eye is a thin curved line. */
+#define ML_SHUT_OPEN_PCT 6.0f
+static inline float ml_shut_pct(float eye_d)
+{
+    float min_px = eye_d * 0.125f; /* about 6 pixels for a big eye: a clear curved line */
+    if (min_px < 3.0f) min_px = 3.0f;
+    const float pct = min_px / (eye_d > 1.0f ? eye_d : 1.0f) * 100.0f;
+    return pct > ML_SHUT_OPEN_PCT ? pct : ML_SHUT_OPEN_PCT;
+}
+
+/* A lid that has come down past this percent lifts the eye so the thin line it leaves sits near the eye's middle, not on its
+ * lower rim: pixels the eye moves up (negative y is up). Zero while the eye is more than 30 percent open. */
+static inline float ml_closed_lift(float eye_d, float open_pct)
+{
+    if (open_pct >= 30.0f) return 0.0f;
+    const float k = (30.0f - (open_pct < 0.0f ? 0.0f : open_pct)) / 30.0f;
+    return -k * eye_d * 0.5f * 0.95f;
+}
+
+/* The lid is a square of side `lid_side` whose bottom edge sits at y = edge (container coordinates, centre 0,0, y down),
+ * centred on x = 0, before the container turns. Returns 1 when that square covers every point of the circle that lies
+ * above the edge, so no sliver of the eye shows beside the lid at any tilt. The old lid was one eye wide: it failed for
+ * any tilt but 0. */
+static inline int ml_lid_covers(float eye_d, float edge, float lid_side)
+{
+    const float r = eye_d * 0.5f;
+    for (int i = 0; i < 720; i++) {
+        const float a = (float)i * (6.2831853f / 720.0f);
+        const float x = r * cosf(a);
+        const float y = r * sinf(a);
+        if (y < edge) { /* a point of the rim that the lid must hide */
+            const int in_x = fabsf(x) <= lid_side * 0.5f;
+            const int in_y = y >= edge - lid_side && y <= edge;
+            if (!(in_x && in_y)) return 0;
+        }
+    }
+    return 1;
+}
+
+/* How much of the circle shows (0 to 1) for an open percent: the area on the open side of the straight edge. A chord
+ * cuts a circle the same way at any tilt, so the answer does not depend on the tilt. */
+static inline float ml_eye_area_fraction(float open_pct)
+{
+    if (open_pct >= 100.0f) return 1.0f;
+    if (open_pct <= 0.0f) return 0.0f;
+    const float d = 1.0f - open_pct / 50.0f; /* the edge's signed distance from the centre over the radius, toward the shut side */
+    return (acosf(d) - d * sqrtf(1.0f - d * d)) / 3.14159265f;
+}
+
+/* ---------------------------------------------------------------- the lids over time: blink, sleepy, closing, waking */
+
+#define ML_BLINK_SHUT_MS 140u    /* a blink is shut for this long in all */
+#define ML_BLINK_MIN_GAP_MS 2600u
+#define ML_BLINK_MAX_GAP_MS 5200u
+#define ML_SLEEPY_BLINK_MS 360u  /* the first slow blink of a sleepy eye; each next one stays this much longer */
+#define ML_SLEEPY_BLINK_GROW_MS 140u
+#define ML_SLEEPY_BLINK_MAX_MS 1400u
+#define ML_SLEEPY_GAP_MS 3200u
+#define ML_CLOSE_MS 1500u        /* the lids lower in this long, eased */
+#define ML_WAKE_HALF_MS 220u     /* shut to half */
+#define ML_WAKE_OPEN_MS 260u     /* half to open */
+#define ML_WAKE_STRETCH_MS 260u  /* then one stretch blink */
+
+typedef enum { ML_PH_AWAKE = 0, ML_PH_SLEEPY, ML_PH_CLOSING, ML_PH_CLOSED, ML_PH_WAKING } ml_phase_t;
+
+typedef struct {
+    uint8_t phase;
+    uint32_t phase_at_ms;  /* when the phase began */
+    uint32_t next_blink_ms;
+    uint32_t blink_start_ms;
+    uint32_t blink_len_ms; /* 0: no blink running */
+    uint32_t blinks;       /* slow blinks done in this sleepy spell */
+    float close_from;      /* lid percent when closing began */
+    uint32_t rng;
+} ml_lids_t;
+
+static inline void ml_lids_init(ml_lids_t* s, uint32_t seed)
+{
+    memset(s, 0, sizeof(*s));
+    s->rng = seed ? seed : 7u;
+    s->next_blink_ms = 2500u;
+}
+
+/* The emotion changed. `now_ms` is the clock, `shown` the lid percent on screen now. */
+static inline void ml_lids_emotion(ml_lids_t* s, int emotion, uint32_t now_ms, float shown)
+{
+    const int was_asleep = s->phase == ML_PH_CLOSING || s->phase == ML_PH_CLOSED;
+    if (emotion == ML_CLOSING || emotion == ML_SLEEPING) {
+        /* Asleep from any look goes through the closing: the lids lower over ML_CLOSE_MS, then stay shut. */
+        if (s->phase != ML_PH_CLOSING && s->phase != ML_PH_CLOSED) {
+            s->phase = ML_PH_CLOSING;
+            s->phase_at_ms = now_ms;
+            s->close_from = shown;
+        }
+        return;
+    }
+    if (emotion == ML_SLEEPY || emotion == ML_TIRED) {
+        if (s->phase == ML_PH_CLOSED || s->phase == ML_PH_CLOSING) {
+            s->phase = ML_PH_WAKING; /* from shut to sleepy: wake a little, no stretch blink needed but it is short */
+            s->phase_at_ms = now_ms;
+        } else if (s->phase != ML_PH_SLEEPY && emotion == ML_SLEEPY) {
+            s->phase = ML_PH_SLEEPY;
+            s->phase_at_ms = now_ms;
+            s->blinks = 0;
+            s->blink_len_ms = 0;
+            s->next_blink_ms = now_ms + ML_SLEEPY_GAP_MS;
+        }
+        return;
+    }
+    if (was_asleep) {
+        s->phase = ML_PH_WAKING;
+        s->phase_at_ms = now_ms;
+    } else if (s->phase == ML_PH_SLEEPY) {
+        s->phase = ML_PH_AWAKE;
+        s->phase_at_ms = now_ms;
+        s->blink_len_ms = 0;
+    }
+}
+
+static inline float ml_ease_inout(float x)
+{
+    if (x <= 0.0f) return 0.0f;
+    if (x >= 1.0f) return 1.0f;
+    return x * x * (3.0f - 2.0f * x);
+}
+
+/* The lid percent the sequence asks for now, given the percent the emotion alone asks for (`base`) and the shut percent.
+ * Returns the target; the eye's own easing carries it there. */
+static inline float ml_lids_target(ml_lids_t* s, float base, float shut_pct, uint32_t now_ms)
+{
+    const uint32_t in_phase = now_ms - s->phase_at_ms;
+    switch (s->phase) {
+        case ML_PH_CLOSING: {
+            if (in_phase >= ML_CLOSE_MS) {
+                s->phase = ML_PH_CLOSED;
+                s->phase_at_ms = now_ms;
+                return shut_pct;
+            }
+            const float k = ml_ease_inout((float)in_phase / (float)ML_CLOSE_MS);
+            return s->close_from + (shut_pct - s->close_from) * k;
+        }
+        case ML_PH_CLOSED:
+            return shut_pct;
+        case ML_PH_WAKING: {
+            const uint32_t t = in_phase;
+            if (t < ML_WAKE_HALF_MS) {
+                const float k = ml_ease_inout((float)t / (float)ML_WAKE_HALF_MS);
+                return shut_pct + (50.0f - shut_pct) * k;
+            }
+            if (t < ML_WAKE_HALF_MS + ML_WAKE_OPEN_MS) {
+                const float k = ml_ease_inout((float)(t - ML_WAKE_HALF_MS) / (float)ML_WAKE_OPEN_MS);
+                return 50.0f + (base - 50.0f) * k;
+            }
+            if (t < ML_WAKE_HALF_MS + ML_WAKE_OPEN_MS + ML_WAKE_STRETCH_MS) {
+                /* one stretch blink: shut and open again */
+                const float k = (float)(t - ML_WAKE_HALF_MS - ML_WAKE_OPEN_MS) / (float)ML_WAKE_STRETCH_MS;
+                const float dip = k < 0.45f ? k / 0.45f : (1.0f - k) / 0.55f;
+                return base + (shut_pct + 8.0f - base) * (dip < 0.0f ? 0.0f : dip);
+            }
+            s->phase = ML_PH_AWAKE;
+            s->phase_at_ms = now_ms;
+            return base;
+        }
+        case ML_PH_SLEEPY: {
+            if (s->blink_len_ms == 0 && now_ms >= s->next_blink_ms) {
+                uint32_t len = ML_SLEEPY_BLINK_MS + s->blinks * ML_SLEEPY_BLINK_GROW_MS;
+                if (len > ML_SLEEPY_BLINK_MAX_MS) len = ML_SLEEPY_BLINK_MAX_MS;
+                s->blink_start_ms = now_ms;
+                s->blink_len_ms = len;
+                s->blinks++;
+            }
+            if (s->blink_len_ms) {
+                const uint32_t b = now_ms - s->blink_start_ms;
+                if (b >= s->blink_len_ms) {
+                    s->blink_len_ms = 0;
+                    s->next_blink_ms = now_ms + ML_SLEEPY_GAP_MS;
+                } else {
+                    return shut_pct + 6.0f; /* the lids come down and stay a little longer each time */
+                }
+            }
+            return base;
+        }
+        default:
+            return base;
+    }
+}
+
+/* A normal blink (awake): a quick close and open. Returns 1 while a blink is shut. */
+static inline int ml_blink_step(ml_lids_t* s, uint32_t now_ms)
+{
+    if (s->phase != ML_PH_AWAKE) {
+        return 0;
+    }
+    if (s->blink_len_ms == 0) {
+        if (now_ms >= s->next_blink_ms) {
+            s->blink_start_ms = now_ms;
+            s->blink_len_ms = ML_BLINK_SHUT_MS;
+        }
+        return s->blink_len_ms != 0;
+    }
+    if (now_ms - s->blink_start_ms >= s->blink_len_ms) {
+        s->blink_len_ms = 0;
+        uint32_t v = s->rng ? s->rng : 7u;
+        v ^= v << 13; v ^= v >> 17; v ^= v << 5; s->rng = v;
+        s->next_blink_ms = now_ms + ML_BLINK_MIN_GAP_MS + v % (ML_BLINK_MAX_GAP_MS - ML_BLINK_MIN_GAP_MS);
+        return 0;
+    }
+    return 1;
+}
+
+/* ---------------------------------------------------------------- the mouth: a stroke along a curve */
+
+#define ML_MOUTH_PTS 17 /* points along the stroke; the same count for every shape so one eases into the next */
+#define ML_MOUTH_TAU_MS 90.0f
+
+typedef struct {
+    int16_t x, y;
+} ml_pt_t;
+
+/* One eased step toward `to`. tau is the time constant: ML_MOUTH_TAU_MS for a change of mood, 40 while the voice opens it. */
+static inline ml_mouth_t ml_mouth_follow(ml_mouth_t cur, ml_mouth_t to, float dt_ms, float tau)
+{
+    ml_mouth_t o;
+    o.w = mx_follow(cur.w, to.w, dt_ms, tau);
+    o.bend = mx_follow(cur.bend, to.bend, dt_ms, tau);
+    o.t = mx_follow(cur.t, to.t, dt_ms, tau * 0.8f);
+    o.wob = mx_follow(cur.wob, to.wob, dt_ms, tau);
+    o.split = mx_follow(cur.split, to.split, dt_ms, tau);
+    o.tilt = mx_follow(cur.tilt, to.tilt, dt_ms, tau);
+    return o;
+}
+
+/* The stroke's points around (0, 0), pixels. `phase` (0 to 1) moves the wobble along the line. The single curve and the
+ * two-curve (cat) shape have the same number of points, so a split between 0 and 1 is a smooth blend of the two. */
+static inline void ml_mouth_points(const ml_mouth_t* m, float phase, ml_pt_t out[ML_MOUTH_PTS])
+{
+    const float s = m->split < 0.0f ? 0.0f : (m->split > 1.0f ? 1.0f : m->split);
+    const float ca = cosf(m->tilt * 0.0174533f), sa = sinf(m->tilt * 0.0174533f);
+    for (int i = 0; i < ML_MOUTH_PTS; i++) {
+        const float u = (float)i / (float)(ML_MOUTH_PTS - 1); /* 0 to 1 along the stroke */
+        const float ux = u * 2.0f - 1.0f;                     /* -1 to 1 */
+        /* one curve: x along the chord, a parabola for the bend (a smile bows down: the ends sit at -bend/2) */
+        const float x1 = ux * m->w * 0.5f;
+        const float y1 = m->bend * (0.5f - ux * ux);
+        /* two curves: each over half the chord, the same parabola, meeting in the middle */
+        const float half = u < 0.5f ? u * 2.0f : (u - 0.5f) * 2.0f;
+        const float hx = half * 2.0f - 1.0f;
+        const float x2 = (u < 0.5f ? -0.25f : 0.25f) * m->w + hx * m->w * 0.25f;
+        const float y2 = m->bend * (0.5f - hx * hx);
+        const float x = x1 + (x2 - x1) * s;
+        float y = y1 + (y2 - y1) * s;
+        if (m->wob > 0.01f) {
+            y += m->wob * sinf(6.2831853f * (ux * 1.25f + phase));
+        }
+        out[i].x = (int16_t)lroundf(x * ca - y * sa);
+        out[i].y = (int16_t)lroundf(x * sa + y * ca);
+    }
+}
+
+/* While the unit speaks (scale: the style's mouth size over the big-eyes mouth): the open amount (0 to 1) from the speech level turns the resting shape into an open mouth. The
+ * emotion keeps some of its bend so a happy mouth is a smile that opens. */
+static inline ml_mouth_t ml_mouth_speaking(ml_mouth_t base, float open01, float scale)
+{
+    ml_mouth_t o = base;
+    if (open01 < 0.0f) open01 = 0.0f;
+    if (open01 > 1.0f) open01 = 1.0f;
+    const float t_open = 34.0f * scale;         /* the fully open mouth is a soft pill, about 46 by 34 at the big-eyes size */
+    const float w_open = 12.0f * scale;
+    o.t = base.t + open01 * (t_open - base.t);
+    o.w = base.w + open01 * (w_open - base.w);
+    const float flat = open01 * 2.2f > 1.0f ? 1.0f : open01 * 2.2f; /* the curve goes first so the pill is clean */
+    o.bend = base.bend * (1.0f - flat);
+    o.split = base.split * (1.0f - flat);
+    o.wob = base.wob * (1.0f - flat);
+    return o;
+}
+
+/* A tired mouth yawns: it opens and closes slowly, once every six seconds. */
+static inline ml_mouth_t ml_mouth_yawn(ml_mouth_t base, uint32_t t_ms)
+{
+    const float k = (float)(t_ms % 6000u) / 6000.0f;
+    const float x = (k - 0.1f) / 0.5f; /* the yawn runs from 0.1 to 0.6 of the cycle */
+    float open = 0.0f;
+    if (x > 0.0f && x < 1.0f) {
+        open = sinf(3.14159265f * x);
+        open *= open;
+    }
+    ml_mouth_t o = base;
+    o.t = base.t + open * 18.0f;
+    o.w = base.w - open * 4.0f;
+    return o;
+}
+
+/* ---------------------------------------------------------------- the thinking dots, at the mouth position */
+
+#define ML_DOT_COUNT 3
+#define ML_DOT_SPACING 24
+#define ML_DOT_D 10
+
+typedef struct {
+    int16_t x, y;   /* centre, pixels from the middle of the screen */
+    int16_t d;      /* diameter */
+    uint8_t opa;    /* 0 to 255 */
+} ml_dot_t;
+
+/* Dot `i` at `elapsed_ms`: a wave runs left to right; the dot rises, grows and brightens as it passes. */
+static inline ml_dot_t ml_dot(const ml_style_t* st, int i, uint32_t elapsed_ms)
+{
+    const uint32_t period = 1200u;
+    const uint32_t phase = (elapsed_ms + (uint32_t)(ML_DOT_COUNT - i) * (period / ML_DOT_COUNT)) % period;
+    const uint32_t half = period / 2;
+    const uint32_t up = phase < half ? phase : period - phase;
+    const float k = (float)up / (float)half; /* 0 to 1 and back */
+    ml_dot_t d;
+    d.x = (int16_t)((i - 1) * ML_DOT_SPACING);
+    d.y = (int16_t)(st->mouth_y - (int)lroundf(k * 5.0f));
+    d.d = (int16_t)(ML_DOT_D - 2 + (int)lroundf(k * 4.0f));
+    d.opa = (uint8_t)(90 + (int)lroundf(k * 165.0f));
+    return d;
+}
+
+/* ---------------------------------------------------------------- the tint */
+
+/* The colour an emotion leans toward, gentle: only a part of the way. Colour never carries meaning alone: every state
+ * keeps its shape. */
+static inline void ml_tint_rgb(int tint, uint8_t* r, uint8_t* g, uint8_t* b)
+{
+    switch (tint) {
+        case ML_TINT_RED: *r = 255; *g = 118; *b = 98; break;
+        case ML_TINT_BLUE: *r = 128; *g = 170; *b = 255; break;
+        case ML_TINT_PINK: *r = 255; *g = 150; *b = 195; break;
+        case ML_TINT_DIM: *r = 150; *g = 150; *b = 150; break;
+        default: *r = *g = *b = 255; break;
+    }
+}
+
+/* Blend the foreground toward the emotion's tint by `amount` (0 to 1). A dim tint scales the foreground. */
+static inline void ml_tinted(uint8_t fr, uint8_t fg, uint8_t fb, int tint, float amount, uint8_t* r, uint8_t* g, uint8_t* b)
+{
+    if (tint == ML_TINT_NONE || amount <= 0.0f) {
+        *r = fr; *g = fg; *b = fb;
+        return;
+    }
+    if (amount > 1.0f) amount = 1.0f;
+    if (tint == ML_TINT_DIM) {
+        const float k = 1.0f - 0.38f * amount;
+        *r = (uint8_t)(fr * k); *g = (uint8_t)(fg * k); *b = (uint8_t)(fb * k);
+        return;
+    }
+    uint8_t tr, tg, tb;
+    ml_tint_rgb(tint, &tr, &tg, &tb);
+    /* the tint is expressed over white: take the foreground's own brightness, and shift its hue toward the tint */
+    const float lum = (0.30f * fr + 0.59f * fg + 0.11f * fb) / 255.0f;
+    *r = (uint8_t)(fr + ((tr * lum) - fr) * amount);
+    *g = (uint8_t)(fg + ((tg * lum) - fg) * amount);
+    *b = (uint8_t)(fb + ((tb * lum) - fb) * amount);
+}
