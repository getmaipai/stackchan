+    for (int i = 1; i < ML_MOUTH_PTS; i++) {
+        minx = p[i].x < minx ? p[i].x : minx;
+        maxx = p[i].x > maxx ? p[i].x : maxx;
+        miny = p[i].y < miny ? p[i].y : miny;
+        maxy = p[i].y > maxy ? p[i].y : maxy;
+    }
+    if ((maxx - minx) < t / 3 && (maxy - miny) < t / 3) {
+        lv_draw_rect_dsc_t rd;
+        lv_draw_rect_dsc_init(&rd);
+        rd.bg_color = _color;
+        rd.bg_opa   = LV_OPA_COVER;
+        rd.radius   = LV_RADIUS_CIRCLE;
+        lv_area_t ar;
+        const int mx = cx + (minx + maxx) / 2, my = cy + (miny + maxy) / 2;
+        ar.x1 = mx - t / 2;
+        ar.x2 = mx - t / 2 + t - 1;
+        ar.y1 = my - t / 2;
+        ar.y2 = my - t / 2 + t - 1;
+        lv_draw_rect(layer, &rd, &ar);
+        return;
+    }
+    lv_draw_line_dsc_t ld;
+    lv_draw_line_dsc_init(&ld);
+    ld.color       = _color;
+    ld.opa         = LV_OPA_COVER;
+    ld.width       = t;
+    ld.round_start = 1;
+    ld.round_end   = 1;
+    for (int i = 0; i + 1 < ML_MOUTH_PTS; i++) {
+        if (p[i].x == p[i + 1].x && p[i].y == p[i + 1].y) {
