+    if (layer == nullptr || _draw == nullptr) {
+        return;
+    }
+    lv_area_t a;
+    lv_obj_get_coords(_draw, &a);
+    const int cx = (a.x1 + a.x2) / 2;
+    const int cy = (a.y1 + a.y2) / 2;
+    ml_pt_t p[ML_MOUTH_PTS];
+    ml_mouth_points(&_cur, static_cast<float>(_t0_ms % 2400u) / 2400.0f, p);
+    const int t = (int)lroundf(_cur.t) < 2 ? 2 : (int)lroundf(_cur.t);
