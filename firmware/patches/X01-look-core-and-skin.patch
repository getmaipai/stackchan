+        }
+        ld.p1.x = cx + p[i].x;
+        ld.p1.y = cy + p[i].y;
+        ld.p2.x = cx + p[i + 1].x;
+        ld.p2.y = cy + p[i + 1].y;
+        lv_draw_line(layer, &ld);
+    }
 }
 
