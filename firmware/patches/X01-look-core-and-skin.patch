+{
+    Avatar::update();
+    const int64_t now = esp_timer_get_time();
+    const float dt    = _last_us == 0 ? 0.0f : static_cast<float>(now - _last_us) / 1000.0f;
+    _last_us          = now;
+
+    const ml_look_t look = ml_look(_style, static_cast<int>(_emotion));
+    uint8_t tr, tg, tb;
+    ml_tinted(primaryColor.red, primaryColor.green, primaryColor.blue, _tint_on ? look.tint : ML_TINT_NONE, 0.6f, &tr, &tg, &tb);
+    const float tgt[3] = {static_cast<float>(tr), static_cast<float>(tg), static_cast<float>(tb)};
+    for (int i = 0; i < 3; i++) {
+        _rgb[i] = mx_follow(_rgb[i], tgt[i], dt, 220.0f);
+        if (mx_settled(_rgb[i], tgt[i], 0.6f)) {
+            _rgb[i] = tgt[i];
+        }
+    }
+    apply_color();
+
+    if (_thinking) {
+        const uint32_t elapsed = static_cast<uint32_t>((now - _think_start_us) / 1000);
+        for (int i = 0; i < ML_DOT_COUNT; i++) {
+            if (_dots[i] == nullptr) {
+                continue;
+            }
+            const ml_dot_t d = ml_dot(ml_style(_style), i, elapsed);
+            const int key    = (d.y << 16) ^ (d.d << 8) ^ (d.opa >> 3);
+            if (key == _dot_key[i]) {
+                continue;
+            }
+            _dot_key[i] = key;
+            lv_obj_set_size(_dots[i], d.d, d.d);
+            lv_obj_align(_dots[i], LV_ALIGN_CENTER, d.x, d.y);
+            lv_obj_set_style_bg_opa(_dots[i], d.opa, 0);
+        }
+    }
+}
