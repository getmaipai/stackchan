# Intent: Turn the portal on. The base build set the hotspot setup off and its board code sent every no-Wi-Fi case to the phone app setup, which needs Bluetooth and apps the core build removes, so a unit with no Wi-Fi could only be fixed over USB. CONFIG_MAIPAI_WIFI_PORTAL (default y) makes StartWifiConfigMode open the config hotspot and show its name, address and setup code on the screen, makes startNetwork wait in setup instead of restarting into the app setup, and gates the P02 source swap in portal.cmake. Off: the old behaviour and no portal code.
# Placement: unit (the robot's own Wi-Fi setup path)
# Upstream: firmware/main/hal/board/stackchan.cc and firmware/main/hal/hal_network.cpp of the StackChan tree (MIT)
# Check after a flash: with no saved Wi-Fi, boot: the screen shows Wi-Fi setup, MaiPai-StackChan-XXXX, http://192.168.4.1 and a 6 digit code; join that hotspot on a phone, the page opens by itself; a wrong code is refused, the right code plus a real network joins and the unit continues to the hub; after 8 minutes with no one the hotspot restarts with a new code.
diff --git a/firmware/CMakeLists.txt b/firmware/CMakeLists.txt
--- a/firmware/CMakeLists.txt
+++ b/firmware/CMakeLists.txt
@@ -22,6 +22,9 @@ include("${CMAKE_CURRENT_LIST_DIR}/portal/portal.cmake")
 # MaiPai Wi-Fi portal (patch P02): see portal/portal.cmake.
 include("${CMAKE_CURRENT_LIST_DIR}/portal/portal.cmake")
 
+# MaiPai Wi-Fi portal (patch P02): see portal/portal.cmake.
+include("${CMAKE_CURRENT_LIST_DIR}/portal/portal.cmake")
+
 # Auto-load a local sdkconfig overlay (git-ignored) when present. Lets
 # self-hosted / custom deployments pin CONFIG_STACKCHAN_SERVER_URL,
 # CONFIG_OTA_URL, etc. without touching committed defaults.
diff --git a/firmware/main/Kconfig.projbuild b/firmware/main/Kconfig.projbuild
--- a/firmware/main/Kconfig.projbuild
+++ b/firmware/main/Kconfig.projbuild
@@ -72,6 +72,19 @@ config STACKCHAN_UPDATE_ALLOW_UNSIGNED
 
 endmenu
 
+menu "MaiPai Wi-Fi setup portal"
+
+config MAIPAI_WIFI_PORTAL
+    bool "Wi-Fi setup hotspot with a code on the screen"
+    default y
+    help
+        When the unit has no Wi-Fi it opens a short, protected setup hotspot (MaiPai-StackChan-xxxx) and one small
+        page. The page asks for the code shown on the unit's screen before it accepts Wi-Fi details. The web server
+        and DNS responder stop and free their memory when setup ends. Off: the unit restarts into the phone app
+        setup as before, and the portal code is not built.
+
+endmenu
+
 menu "MaiPai face and always-on look"
 
 config MAIPAI_FACE_CONFIG
diff --git a/firmware/main/hal/board/stackchan.cc b/firmware/main/hal/board/stackchan.cc
--- a/firmware/main/hal/board/stackchan.cc
+++ b/firmware/main/hal/board/stackchan.cc
@@ -12,6 +12,7 @@
 #include <esp_log.h>
 #include <driver/i2c_master.h>
 #include <wifi_station.h>
+#include <wifi_manager.h>
 #include <esp_lcd_panel_io.h>
 #include <esp_lcd_panel_ops.h>
 #include <esp_lcd_ili9341.h>
@@ -696,8 +697,21 @@ public:
     // the same BLE App setup flow. Never start the upstream configuration AP.
     void StartWifiConfigMode() override
     {
+#if CONFIG_MAIPAI_WIFI_PORTAL
+        // The MaiPai setup portal (patches P02 to P05): a short protected hotspot and one page. The hotspot name
+        // and the setup code go on the screen; the page asks for the code before it takes Wi-Fi details.
+        ESP_LOGW(TAG, "WiFi setup required; opening the setup hotspot");
+        auto& wifi = WifiManager::GetInstance();
+        wifi.StartConfigAp();
+        std::string hint = "Wi-Fi setup: ";
+        hint += wifi.GetApSsid();
+        hint += "  ";
+        hint += wifi.GetApWebUrl();
+        GetDisplay()->SetChatMessage("system", hint.c_str());
+#else
         ESP_LOGW(TAG, "WiFi setup required; opening StackChan App setup");
         GetHAL().requestAppSetup();
+#endif
     }
 
     virtual AudioCodec* GetAudioCodec() override
diff --git a/firmware/main/hal/hal_network.cpp b/firmware/main/hal/hal_network.cpp
