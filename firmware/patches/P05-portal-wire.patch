@@ -116,7 +117,13 @@ void Hal::startNetwork(std::function<void(std::string_view)> onLog)
     while (!network_connected && !WifiManager::GetInstance().IsConnected()) {
         // WifiBoard normally handles a 60s timeout. Keep this caller bounded
         // even if station startup or the board timer fails to emit an event.
-        if (setup_required || uint32_t(millis() - started_at) >= 65000) {
+        bool give_up = setup_required || uint32_t(millis() - started_at) >= 65000;
+#if CONFIG_MAIPAI_WIFI_PORTAL
+        // The setup portal runs inside StartNetwork and ends in a connection or a fresh window: keep waiting
