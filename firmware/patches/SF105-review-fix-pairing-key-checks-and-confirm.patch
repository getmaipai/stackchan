-static inline int mpx_on_paired(mpx_t* s, const uint8_t z[32], const char* device_id, uint8_t k_out[MLY_KEY])
+/* "paired" (review fix): the host says the owner typed the right code. Nothing proves that to the unit on a plain link (an attacker who relays the exchange can send it too), so the
+ * key is derived but NOT handed over: the unit asks the owner to tap Keep (mpx_confirm) within MPX_CONFIRM_MS. z is the X25519 shared secret (the caller computed it from its
+ * private key and pk_h); an all-zero secret never becomes a key. */
+static inline int mpx_on_paired(mpx_t* s, const uint8_t z[32], const char* device_id, uint32_t now)
 {
