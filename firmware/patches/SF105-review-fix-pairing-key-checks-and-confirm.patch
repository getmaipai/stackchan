+/* Review fix: X25519 public keys of small order (and the all-zero key) give a shared secret that does not depend on the private keys, so the link key would depend only on
+ * public values. The eight points of small order, as libsodium lists them; bit 255 of a key is ignored by the curve, so it is masked before the comparison (this also catches the
+ * non-canonical forms p, p+1 and p-1 written with the top bit set or not). */
+static inline int mpx_low_order(const uint8_t k[MLY_PK])
+{
+    static const uint8_t BAD[7][32] = {
+        {0},
+        {1},
+        {0xe0, 0xeb, 0x7a, 0x7c, 0x3b, 0x41, 0xb8, 0xae, 0x16, 0x56, 0xe3, 0xfa, 0xf1, 0x9f, 0xc4, 0x6a, 0xda, 0x09, 0x8d, 0xeb, 0x9c, 0x32, 0xb1, 0xfd, 0x86, 0x62, 0x05, 0x16, 0x5f, 0x49, 0xb8, 0x00},
