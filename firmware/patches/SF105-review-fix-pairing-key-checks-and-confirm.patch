+// Review fix: after the host says "paired" the unit does not keep the key until the owner taps Keep on the unit's own screen (a forged "paired" on the plain link would
+// otherwise store an attacker's key). The screen is built and closed on the LVGL task through the main task's queue, never with the pairing lock held.
+lv_obj_t* s_confirm = nullptr;   // LVGL lock held to touch it
+
+void confirm_close_ui()
+{
+    LvglLockGuard lock;
+    if (s_confirm != nullptr) {
+        lv_obj_delete(s_confirm);
+        s_confirm = nullptr;
+    }
+}
+
+void send_json(const char* type, const char* field, const uint8_t* data, size_t n);   // below
+
+void confirm_result(bool keep)
+{
+    Application::GetInstance().Schedule([keep]() {
+        confirm_close_ui();
+        std::lock_guard<std::mutex> lock(s_mu);
+        if (!s_active || s_px.state != MPX_AWAIT_CONFIRM) return;
+        if (keep) {
+            uint8_t k[MLY_KEY];
+            if (mpx_confirm(&s_px, k) == MPX_OK && maipai_link_key_save(k)) {
+                finish_locked("Paired. The link to the host is now encrypted.");
+                ESP_LOGI(kTag, "paired: link key stored after the owner confirmed");
+            } else {
+                finish_locked("Pairing failed: the key could not be saved. Try again.");
+            }
+            lk_wipe(k, sizeof(k));
+        } else {
+            send_json("pair_abort", nullptr, nullptr, 0);
+            mpx_decline(&s_px);
+            finish_locked("Not paired: you cancelled. Nothing changed.");
+        }
+    });
+}
