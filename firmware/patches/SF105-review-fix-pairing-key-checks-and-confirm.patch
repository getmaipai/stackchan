+    mly_link_key(z, s->pk_u, s->pk_h, s->n_u, s->n_h, device_id, s->k);
+    s->state = MPX_AWAIT_CONFIRM;
+    s->confirm_ms = mt_stamp(now, 0);
+    return MPX_OK;
+}
+
+/* The owner tapped Keep on the unit: the key is handed over and the exchange is done. Only valid after "paired". */
+static inline int mpx_confirm(mpx_t* s, uint8_t k_out[MLY_KEY])
+{
+    if (s->state != MPX_AWAIT_CONFIRM) return mpx_fail(s, MPX_ORDER);
+    memcpy(k_out, s->k, MLY_KEY);
     mpx_wipe(s);
     s->state = MPX_DONE;
     return MPX_OK;
 }
 
+/* The owner tapped Cancel (or the time ran out): the key is wiped and nothing is saved. */
+static inline int mpx_decline(mpx_t* s)
+{
+    return mpx_fail(s, MPX_DECLINED);
+}
