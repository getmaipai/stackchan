     if (!s_ring.active) {
         return;
     }
@@ -319,3 +351,15 @@ bool maipai_timers_dismiss(const char* how)
     end_ring_locked(how);
     return true;
 }
+
+#if CONFIG_MAIPAI_FACE_TIMERS
+int maipai_timers_view(maipai_timer_view_t* out, int max)
+{
+    std::lock_guard<std::mutex> lock(s_view_mutex);
+    const int n = s_view_n < max ? s_view_n : max;
+    for (int i = 0; i < n; i++) {
+        out[i] = s_view[i];
+    }
+    return n;
+}
+#endif
diff --git a/firmware/main/hal/maipai_timers.h b/firmware/main/hal/maipai_timers.h
index fa99175..3f5c288 100644
--- a/firmware/main/hal/maipai_timers.h
+++ b/firmware/main/hal/maipai_timers.h
@@ -25,3 +25,18 @@ bool maipai_timers_dismiss(const char* how);
 // Ends a ring from a touch, the stop word or any other task, without taking a lock: `how` must be a
 // string literal. Returns true if a ring was going; the tick ends it within 200 ms.
 bool maipai_timers_request_dismiss(const char* how);
+
+// A read-only view of what is counting down, for the face (patch F06). Never takes the timer lock, so the display
+// task can call it: it reads a copy the tick publishes every 200 ms under its own small lock.
+#include <sdkconfig.h>
+#if CONFIG_MAIPAI_FACE_TIMERS
+#include <stdint.h>
+typedef struct {
+    uint32_t id;
+    uint8_t kind;      // MT_KIND_TIMER (1) or MT_KIND_ALARM (2)
+    int64_t due_ms;    // when it fires, on the esp_timer millisecond scale
+    char label[25];
+} maipai_timer_view_t;
+// Copies up to `max` active timers and alarms into `out`; returns how many.
+int maipai_timers_view(maipai_timer_view_t* out, int max);
+#endif
