diff --git a/firmware/main/hal/maipai_face_timers_core.h b/firmware/main/hal/maipai_face_timers_core.h
new file mode 100644
index 0000000..b7d9464
--- /dev/null
+++ b/firmware/main/hal/maipai_face_timers_core.h
@@ -0,0 +1,116 @@
+/*
+ * SPDX-License-Identifier: MIT
+ *
+ * Named timers on the face with live countdowns (patch F06): the pure logic, no ESP-IDF, no clock of
+ * its own. Header-only plain C99 so a host compiler can test it.
+ *
+ * Several timers show at once as small chips along the bottom of the face, soonest first, up to
+ * four. When more than four run, three show and the fourth says how many more there are. Every chip
+ * is text, so no state is told by colour alone.
+ */
+#ifndef MAIPAI_FACE_TIMERS_CORE_H
+#define MAIPAI_FACE_TIMERS_CORE_H
+
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+#include "maipai_face_core.h"
+
+#define MF_CHIP_MAX 4
+#define MF_CHIP_LABEL_MAX 9 /* characters of a label that fit a chip */
+#define MF_CHIP_W 148
+#define MF_CHIP_H 20
+
+typedef struct {
+    uint32_t id;
+    uint8_t kind;    /* 1 timer, 2 alarm (the unit's own timer kinds) */
+    int32_t left_s;  /* seconds left; may be 0 or below for a moment */
+    char label[25];
+} mf_tchip_t;
+
+/* "4:32" under an hour, "1:02:03" from an hour, "0:00" when it is due. */
+static inline void mf_fmt_left(char* out, size_t n, int32_t left_s)
+{
+    if (left_s < 0) {
+        left_s = 0;
+    }
+    if (left_s > 359999) {
+        left_s = 359999; /* 99:59:59: a timer is at most 24 hours, this only bounds the text */
+    }
+    const int32_t h = left_s / 3600;
+    const int32_t m = (left_s % 3600) / 60;
+    const int32_t s = left_s % 60;
+    if (h > 0) {
+        snprintf(out, n, "%d:%02d:%02d", (int)h, (int)m, (int)s);
+    } else {
+        snprintf(out, n, "%d:%02d", (int)m, (int)s);
+    }
+}
+
+/* The name when a timer has no label. */
+static inline const char* mf_kind_word(int lang, int kind)
+{
+    if (kind == 2) {
+        return lang == MF_LANG_ES ? "Alarma" : "Alarm";
+    }
+    return lang == MF_LANG_ES ? "Tiempo" : "Timer";
+}
+
+/* "tea 4:32": the label (or the kind word) cut to what fits, then the countdown. */
+static inline void mf_chip_text(char* out, size_t n, int lang, const mf_tchip_t* c)
+{
+    char left[12];
+    mf_fmt_left(left, sizeof(left), c->left_s);
+    const char* name = c->label[0] ? c->label : mf_kind_word(lang, c->kind);
+    char cut[MF_CHIP_LABEL_MAX + 1];
+    strncpy(cut, name, MF_CHIP_LABEL_MAX);
+    cut[MF_CHIP_LABEL_MAX] = '\0';
+    snprintf(out, n, "%s %s", cut, left);
+}
+
+/* Picks what shows: soonest first (ties by id), at most MF_CHIP_MAX. Returns how many chips are in `out`. With more than
+ * MF_CHIP_MAX timers the last chip is a count: `*more` is the number not shown by name (0 otherwise), and the chip slot
+ * after the named ones is left to the caller to write as "+N". */
+static inline int mf_tchips_pick(const mf_tchip_t* in, int n, mf_tchip_t* out, int* more)
+{
+    mf_tchip_t sorted[16];
+    if (n > 16) {
+        n = 16;
+    }
+    for (int i = 0; i < n; i++) {
+        sorted[i] = in[i];
+    }
+    for (int i = 1; i < n; i++) {  /* insertion sort: n is tiny */
+        mf_tchip_t key = sorted[i];
+        int j          = i - 1;
+        while (j >= 0 && (sorted[j].left_s > key.left_s || (sorted[j].left_s == key.left_s && sorted[j].id > key.id))) {
+            sorted[j + 1] = sorted[j];
+            j--;
+        }
+        sorted[j + 1] = key;
+    }
+    *more = 0;
+    int shown = n;
+    if (n > MF_CHIP_MAX) {
+        shown = MF_CHIP_MAX - 1;
+        *more = n - shown;
+    }
+    for (int i = 0; i < shown; i++) {
+        out[i] = sorted[i];
+    }
+    return shown;
+}
+
+/* Where chip `k` of `slots` goes (slots 1 to 4, filled in reading order, anchored to the bottom edge). A lone chip on a
+ * row is centred. */
+static inline void mf_chip_place(int slots, int k, int* x, int* y)
+{
+    const int rows = (slots + 1) / 2;
+    const int row  = k / 2;
+    const int col  = k % 2;
+    const int in_row = (row == rows - 1 && (slots % 2) == 1) ? 1 : 2;
+    *x = in_row == 1 ? (320 - MF_CHIP_W) / 2 : 6 + col * (MF_CHIP_W + 12);
+    *y = 240 - 2 - (rows - row) * (MF_CHIP_H + 2);
+}
+
+#endif /* MAIPAI_FACE_TIMERS_CORE_H */
