+// ---- patch UI13: the funny sounds (maipai_games_sfx_core.h) ----
+// A clip is rendered into a PSRAM buffer when the rule asks for it and played with PlayPcm (the unit's volume and the sound policy
+// decide how loud, as for the Color Memory tones). When the rule named the region its picture changes (the sync action), the clip
+// waits for the first display strip that carries that region, so the sound and the picture start together; a picture whose strip
+// never comes (a dark screen) starts after 100 ms anyway. A clip with no picture to wait for plays at once.
+struct SfxPending {
+    bool on, rect;
+    int16_t x1, y1, x2, y2;
+    uint32_t since_ms;
+    size_t n;
+};
+SfxPending s_sfx          = {};
+int16_t* s_sfx_buf        = nullptr;
+
+void sfx_free()
+{
+    s_sfx.on = false;
+    if (s_sfx_buf != nullptr) {
+        heap_caps_free(s_sfx_buf);
+        s_sfx_buf = nullptr;
+    }
+}
+
+void sfx_play_now()
+{
+    if (!s_sfx.on || s_sfx_buf == nullptr) {
+        s_sfx.on = false;
+        return;
+    }
+    s_sfx.on = false;
+#if CONFIG_MAIPAI_GAMES_BENCH
+    const int64_t t0 = esp_timer_get_time();
+    g_mp_pcm_call_us = t0;
+    ESP_LOGW("GAMELAT", "%lld sfx_play %u samples, %u ms after it was asked for%s", static_cast<long long>(t0 / 1000), static_cast<unsigned>(s_sfx.n),
+             static_cast<unsigned>(now_ms() - s_sfx.since_ms), s_sfx.rect ? " (waited for its picture)" : " (at once)");
+#endif
+    (void)Application::GetInstance().GetAudioService().PlayPcm(s_sfx_buf, s_sfx.n, MGS_SFX_RATE);  // PlayPcm copies
+}
+
+// Renders clip `clip` and plays it now, or when the strip of `region` (a region number, or MG_NO_REGION) is on the panel.
+void sfx_queue(const Game* g, int clip, int region)
+{
+    if (!maipai_sounds_gate("popup")) {
+        return;  // mute, sounds off or night: the picture still shows
+    }
+    if (s_sfx_buf == nullptr) {
+        s_sfx_buf = static_cast<int16_t*>(heap_caps_malloc(MGS_SFX_MAX_SAMPLES * sizeof(int16_t), MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT));
+        if (s_sfx_buf == nullptr) {
+            return;
+        }
+    }
+    const size_t n = mgs_render(clip, s_sfx_buf, MGS_SFX_MAX_SAMPLES);
+    if (n == 0) {
+        return;
+    }
+    s_sfx.n        = n;
+    s_sfx.on       = true;
+    s_sfx.since_ms = now_ms();
+    s_sfx.rect     = false;
+    if (region >= 0 && region < g->pack.n_regions) {
+        mg_region_t rg;
+        mg_region_get(&g->pack, region, &rg);
+        s_sfx.x1   = static_cast<int16_t>(rg.x);
+        s_sfx.y1   = static_cast<int16_t>(rg.y);
+        s_sfx.x2   = static_cast<int16_t>(rg.x + rg.w - 1);
+        s_sfx.y2   = static_cast<int16_t>(rg.y + rg.h - 1);
+        s_sfx.rect = true;
+    } else {
+        sfx_play_now();
+    }
+}
