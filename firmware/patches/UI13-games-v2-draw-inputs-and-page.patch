diff --git a/firmware/main/hal/maipai_games_draw.h b/firmware/main/hal/maipai_games_draw.h
new file mode 100644
--- /dev/null
+++ b/firmware/main/hal/maipai_games_draw.h
@@ -0,0 +1,281 @@
+/*
+ * SPDX-License-Identifier: MIT
+ *
+ * How a game's shapes are drawn (patch UI13), with LVGL only: no ESP call, so the host renderer (scripts/fw-face-render/games_render.cc)
+ * draws the very same screens the unit shows. Shapes are built once, hidden, and shown or hidden by the player as the game's state and
+ * counters change. Besides the plain ones (fill, circle, box, ring, text) there is the LINE (a thick rounded segment, for the Tic-Tac-Toe
+ * crosses and the scissors) and the MOLE: one character built from 19 small shapes that stands in the hole named by a counter and wears
+ * the funny face named by another (grin, goofy tongue, startled, helmet, and the dazed face with stars after a hit).
+ */
+#ifndef MAIPAI_GAMES_DRAW_H
+#define MAIPAI_GAMES_DRAW_H
+
+#include <lvgl.h>
+#include "maipai_games_core.h"
+
+namespace mgd {
+
+inline lv_color_t color_of(uint16_t c)
+{
+    return lv_color_make(static_cast<uint8_t>(((c >> 11) & 31) << 3), static_cast<uint8_t>(((c >> 5) & 63) << 2),
+                         static_cast<uint8_t>((c & 31) << 3));
+}
+
+inline const lv_font_t* font_for(int size)
+{
+    return size == 0 ? &lv_font_montserrat_14 : (size == 1 ? &lv_font_montserrat_16 : &lv_font_montserrat_20);
+}
+
+inline lv_obj_t* plain(lv_obj_t* parent)
+{
+    lv_obj_t* o = lv_obj_create(parent);
+    lv_obj_remove_style_all(o);
+    lv_obj_remove_flag(o, LV_OBJ_FLAG_CLICKABLE);
+    lv_obj_remove_flag(o, LV_OBJ_FLAG_SCROLLABLE);
+    lv_obj_add_flag(o, LV_OBJ_FLAG_HIDDEN);
+    return o;
+}
+
+/* ---- the mole ---- */
+enum {
+    P_BODY = 0, P_EAR_L, P_EAR_R, P_IN_L, P_IN_R, P_MUZZLE, P_NOSE, P_EYE_L, P_EYE_R, P_PUP_L, P_PUP_R, P_MOUTH, P_TEETH, P_TONGUE,
+    P_DOME, P_RIM, P_X_L, P_X_R, P_STARS, P_COUNT
+};
+
+struct Mole {
+    lv_obj_t* root;           /* a transparent holder over the whole screen; hiding it hides the mole */
+    lv_obj_t* part[P_COUNT];
+    int last_x, last_y, last_face, last_size;
+};
+
+constexpr uint32_t kBodyC = 0x8b5a2b, kEarInC = 0xe8a0a8, kMuzzleC = 0xd9b38c, kNoseC = 0xff8fa3, kWhiteC = 0xffffff, kPupilC = 0x101010,
+                   kMouthC = 0x3a0f0f, kTongueC = 0xff5f7a, kHelmetC = 0xf5c518, kRimC = 0xc99700, kStarC = 0xffe045;
+
+inline lv_obj_t* blob(lv_obj_t* parent, uint32_t rgb, int radius)
+{
+    lv_obj_t* o = plain(parent);
+    lv_obj_set_style_bg_color(o, lv_color_hex(rgb), 0);
+    lv_obj_set_style_bg_opa(o, LV_OPA_COVER, 0);
+    lv_obj_set_style_radius(o, radius, 0);
+    return o;
+}
+
+inline lv_obj_t* tag(lv_obj_t* parent, const char* text, const lv_font_t* font, uint32_t rgb)
+{
+    lv_obj_t* o = lv_label_create(parent);
+    lv_obj_remove_flag(o, LV_OBJ_FLAG_CLICKABLE);
+    lv_obj_add_flag(o, LV_OBJ_FLAG_HIDDEN);
+    lv_obj_set_style_text_font(o, font, 0);
+    lv_obj_set_style_text_color(o, lv_color_hex(rgb), 0);
+    lv_label_set_text(o, text);
+    return o;
+}
+
+inline void mole_build(lv_obj_t* parent, Mole* m)
+{
+    memset(m, 0, sizeof(*m));
+    m->last_x = m->last_y = m->last_face = m->last_size = -9999;
+    m->root = plain(parent);
+    lv_obj_set_size(m->root, 320, 240);
+    lv_obj_set_pos(m->root, 0, 0);
+    lv_obj_t* r = m->root;
+    m->part[P_BODY]   = blob(r, kBodyC, 14);
+    m->part[P_EAR_L]  = blob(r, kBodyC, LV_RADIUS_CIRCLE);
+    m->part[P_EAR_R]  = blob(r, kBodyC, LV_RADIUS_CIRCLE);
+    m->part[P_IN_L]   = blob(r, kEarInC, LV_RADIUS_CIRCLE);
+    m->part[P_IN_R]   = blob(r, kEarInC, LV_RADIUS_CIRCLE);
+    m->part[P_MUZZLE] = blob(r, kMuzzleC, 6);
+    m->part[P_NOSE]   = blob(r, kNoseC, LV_RADIUS_CIRCLE);
+    m->part[P_EYE_L]  = blob(r, kWhiteC, LV_RADIUS_CIRCLE);
+    m->part[P_EYE_R]  = blob(r, kWhiteC, LV_RADIUS_CIRCLE);
+    m->part[P_PUP_L]  = blob(r, kPupilC, LV_RADIUS_CIRCLE);
+    m->part[P_PUP_R]  = blob(r, kPupilC, LV_RADIUS_CIRCLE);
+    m->part[P_MOUTH]  = blob(r, kMouthC, 2);
+    m->part[P_TEETH]  = blob(r, kWhiteC, 1);
+    m->part[P_TONGUE] = blob(r, kTongueC, 3);
+    m->part[P_DOME]   = blob(r, kHelmetC, 14);
+    m->part[P_RIM]    = blob(r, kRimC, 2);
+    m->part[P_X_L]    = tag(r, "x", &lv_font_montserrat_14, kPupilC);
+    m->part[P_X_R]    = tag(r, "x", &lv_font_montserrat_14, kPupilC);
+    m->part[P_STARS]  = tag(r, "* * *", &lv_font_montserrat_14, kStarC);
+}
+
+inline void put(lv_obj_t* o, int x, int y, int w, int h, bool show)
+{
+    if (show) {
+        lv_obj_set_size(o, w, h);
+        lv_obj_set_pos(o, x, y);
+        lv_obj_remove_flag(o, LV_OBJ_FLAG_HIDDEN);
+    } else {
+        lv_obj_add_flag(o, LV_OBJ_FLAG_HIDDEN);
+    }
+}
+
+/* Puts the mole with its feet at (bx, by) (they are hidden under the dirt mound drawn over them) wearing face `face`; `size` is its width in
+ * pixels (30 is the size the numbers below were drawn for). A mole that is already in that place with that face is left alone. */
+inline void mole_apply(Mole* m, int bx, int by, int face, int size)
+{
+    if (m->last_x == bx && m->last_y == by && m->last_face == face && m->last_size == size) {
+        return;
+    }
+    m->last_x = bx;
+    m->last_y = by;
+    m->last_face = face;
+    m->last_size = size;
+    auto sc = [size](int v) { return (v * size + (v < 0 ? -15 : 15)) / 30; };
+    lv_obj_t** p = m->part;
+    const int bw = sc(28), bh = sc(34);
+    const int top = by - bh, fy = top + sc(15);
+    const bool helmet = face == MG_FACE_HELMET, dazed = face == MG_FACE_DAZED, startled = face == MG_FACE_STARTLED, tongue = face == MG_FACE_TONGUE;
+    put(p[P_BODY], bx - bw / 2, top, bw, bh, true);
+    put(p[P_EAR_L], bx - sc(15), top - sc(1), sc(10), sc(10), !helmet);
+    put(p[P_EAR_R], bx + sc(5), top - sc(1), sc(10), sc(10), !helmet);
+    put(p[P_IN_L], bx - sc(13), top + sc(1), sc(6), sc(6), !helmet);
+    put(p[P_IN_R], bx + sc(7), top + sc(1), sc(6), sc(6), !helmet);
+    put(p[P_MUZZLE], bx - sc(9), fy + sc(1), sc(18), sc(13), true);
+    put(p[P_NOSE], bx - sc(4), fy + sc(2), sc(8), sc(6), true);
+    const int er = startled ? sc(5) : sc(4);   /* eye radius */
+    const int ey = fy - sc(5);
+    put(p[P_EYE_L], bx - sc(7) - er, ey - er, 2 * er, 2 * er, !dazed);
+    put(p[P_EYE_R], bx + sc(7) - er, ey - er, 2 * er, 2 * er, !dazed);
+    const int pr = startled ? sc(1) : sc(2);   /* pupil radius, and where it looks: toward each other for the goofy face */
+    const int po = tongue ? sc(2) : 0;
+    put(p[P_PUP_L], bx - sc(7) + po - pr, ey - pr, 2 * pr + 1, 2 * pr + 1, !dazed);
+    put(p[P_PUP_R], bx + sc(7) - po - pr, ey - pr, 2 * pr + 1, 2 * pr + 1, !dazed);
+    /* the mouth: a wide grin, a thin line with the tongue out, an open o, a small smile under the helmet, a wobble when dazed */
+    int mw = sc(14), mh = sc(5), mr = 2;
+    if (tongue) { mw = sc(10); mh = sc(3); }
+    if (startled) { mw = sc(7); mh = sc(7); mr = LV_RADIUS_CIRCLE; }
+    if (helmet) { mw = sc(8); mh = sc(3); }
+    if (dazed) { mw = sc(8); mh = sc(3); }
+    const int my = fy + sc(8);
+    lv_obj_set_style_radius(p[P_MOUTH], mr, 0);
+    put(p[P_MOUTH], bx - mw / 2, my, mw, mh, true);
+    put(p[P_TEETH], bx - sc(5), my, sc(10), sc(2), face == MG_FACE_GRIN);
+    put(p[P_TONGUE], bx - sc(1), my + sc(2), sc(5), sc(8), tongue);
+    put(p[P_DOME], bx - sc(16), top - sc(6), sc(32), sc(12), helmet);
+    put(p[P_RIM], bx - sc(17), top + sc(4), sc(34), sc(3), helmet);
+    put(p[P_X_L], bx - sc(7) - sc(3), ey - sc(8), 12, 16, dazed);
+    put(p[P_X_R], bx + sc(7) - sc(3), ey - sc(8), 12, 16, dazed);
+    if (dazed) {
+        lv_obj_set_size(p[P_STARS], LV_SIZE_CONTENT, LV_SIZE_CONTENT);
+        lv_obj_set_pos(p[P_STARS], bx - sc(18), top - sc(7));
+        lv_obj_remove_flag(p[P_STARS], LV_OBJ_FLAG_HIDDEN);
+    } else {
+        lv_obj_add_flag(p[P_STARS], LV_OBJ_FLAG_HIDDEN);
+    }
+    lv_obj_remove_flag(m->root, LV_OBJ_FLAG_HIDDEN);
+}
+
+/* ---- the shapes ---- */
+
+/* Builds one shape under `parent`, hidden. `pts` is where a LINE keeps its two points (they must outlive the object); `mole` is filled
+ * in for a MOLE shape. Returns the object the player shows and hides. */
+inline lv_obj_t* build_shape(lv_obj_t* parent, const mg_shape_t& s, lv_point_precise_t* pts, Mole* mole)
+{
+    switch (s.type) {
+        case MG_SH_FILL: {
+            lv_obj_t* o = plain(parent);
+            lv_obj_set_size(o, 320, 240);
+            lv_obj_set_pos(o, 0, 0);
+            lv_obj_set_style_bg_color(o, color_of(s.colour), 0);
+            lv_obj_set_style_bg_opa(o, LV_OPA_COVER, 0);
+            return o;
+        }
+        case MG_SH_CIRCLE:
+        case MG_SH_RING: {
+            lv_obj_t* o = plain(parent);
+            lv_obj_set_size(o, s.w * 2, s.w * 2);
+            lv_obj_set_pos(o, s.x - s.w, s.y - s.w);
+            lv_obj_set_style_radius(o, LV_RADIUS_CIRCLE, 0);
+            if (s.type == MG_SH_CIRCLE) {
+                lv_obj_set_style_bg_color(o, color_of(s.colour), 0);
+                lv_obj_set_style_bg_opa(o, LV_OPA_COVER, 0);
+            } else {
+                lv_obj_set_style_border_color(o, color_of(s.colour), 0);
+                lv_obj_set_style_border_width(o, s.aux > 0 ? s.aux : 2, 0);
+            }
+            return o;
+        }
+        case MG_SH_BOX: {
+            lv_obj_t* o = plain(parent);
+            lv_obj_set_size(o, s.w, s.h);
+            lv_obj_set_pos(o, s.x, s.y);
+            lv_obj_set_style_radius(o, s.aux, 0);
+            lv_obj_set_style_bg_color(o, color_of(s.colour), 0);
+            lv_obj_set_style_bg_opa(o, LV_OPA_COVER, 0);
+            return o;
+        }
+        case MG_SH_LINE: {
+            lv_obj_t* o = lv_line_create(parent);
+            lv_obj_remove_flag(o, LV_OBJ_FLAG_CLICKABLE);
+            lv_obj_add_flag(o, LV_OBJ_FLAG_HIDDEN);
+            pts[0].x = s.x;
+            pts[0].y = s.y;
+            pts[1].x = s.w;
+            pts[1].y = s.h;
+            lv_line_set_points(o, pts, 2);
+            lv_obj_set_style_line_width(o, s.aux > 0 ? s.aux : 2, 0);
+            lv_obj_set_style_line_color(o, color_of(s.colour), 0);
+            lv_obj_set_style_line_rounded(o, true, 0);
+            return o;
+        }
+        case MG_SH_MOLE:
+            mole_build(parent, mole);
+            return mole->root;
+        default: {  // MG_SH_TEXT
+            lv_obj_t* o = lv_label_create(parent);
+            lv_obj_remove_flag(o, LV_OBJ_FLAG_CLICKABLE);
+            lv_obj_add_flag(o, LV_OBJ_FLAG_HIDDEN);
+            const lv_font_t* font = font_for(s.aux);
+            const int width       = s.w > 0 ? s.w : 280;
+            lv_obj_set_style_text_font(o, font, 0);
+            lv_obj_set_style_text_color(o, color_of(s.colour), 0);
+            lv_obj_set_style_text_align(o, LV_TEXT_ALIGN_CENTER, 0);
+            lv_label_set_long_mode(o, LV_LABEL_LONG_WRAP);
+            lv_obj_set_width(o, width);
+            lv_obj_set_pos(o, s.x - width / 2, s.y - lv_font_get_line_height(font) / 2);
+            return o;
+        }
+    }
+}
+
+/* Where the mole stands: the bottom middle of its hole's touch region, a little up from the region's bottom edge. */
+inline void mole_place(const mg_pack_t* p, int region, int* bx, int* by)
+{
+    mg_region_t g;
+    mg_region_get(p, region, &g);
+    *bx = g.x + g.w / 2;
+    *by = g.y + g.h - 6;
+}
+
+/* Shows or hides every shape for the run's present state and counters; texts get their counters filled in. */
+inline void draw_state(const mg_run_t& r, lv_obj_t* const* obj, const uint8_t* type, const uint8_t* text, Mole* mole, bool es)
+{
+    for (int i = 0; i < r.p->n_shapes; i++) {
+        lv_obj_t* o = obj[i];
+        if (o == nullptr) {
+            continue;
+        }
+        if (mg_shape_visible(&r, i)) {
+            if (type[i] == MG_SH_TEXT) {
+                char buf[MG_TEXT_LEN + 16];
+                mg_text(&r, text[i], es ? 1 : 0, buf, sizeof(buf));
+                lv_label_set_text(o, buf);
+            } else if (type[i] == MG_SH_MOLE) {
+                mg_shape_t s;
+                mg_shape_get(r.p, i, &s);
+                int bx, by;
+                mole_place(r.p, mg_mole_region(&r, &s), &bx, &by);
+                mole_apply(mole, bx, by, r.ctr[s.aux], s.w > 0 ? s.w : 30);
+            }
+            lv_obj_remove_flag(o, LV_OBJ_FLAG_HIDDEN);
+        } else {
+            lv_obj_add_flag(o, LV_OBJ_FLAG_HIDDEN);
+        }
+    }
+}
+
+}  // namespace mgd
+
+#endif
