+// Patch UI13: the finger lifted (LVGL task, lock held). A game that takes taps on release gets a swipe left or right as its own event and a
+// still touch as a tap where it began; a swipe down or up is the unit's (stop, quick settings) and never reaches here.
+void maipai_games_release(int x0, int y0, int x1, int y1, uint32_t held_ms)
+{
+    Game* g = s_game;
+    if (g == nullptr || !g->tap_on_release) {
+        return;
+    }
+    const uint32_t now = now_ms();
+    const mgs_swipe_t sw = mgs_swipe_of(x0, y0, x1, y1, held_ms);
+    if (sw == MGS_SW_LEFT) {
+        mg_input(&g->run, MG_EV_SWIPE_L, now);
+    } else if (sw == MGS_SW_RIGHT) {
+        mg_input(&g->run, MG_EV_SWIPE_R, now);
+    } else if (sw == MGS_SW_NONE && mgs_abs(x1 - x0) <= MGS_TAP_MAX_PX && mgs_abs(y1 - y0) <= MGS_TAP_MAX_PX && held_ms <= MGS_TAP_MAX_MS) {
+        mg_tap(&g->run, x0, y0, now);
+    } else {
+        return;
+    }
+    after_event(g);
+}
+
