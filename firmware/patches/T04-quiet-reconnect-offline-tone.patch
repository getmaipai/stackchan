+// ---- the quiet reconnect (patch T04) ----
+std::mutex s_link_mutex;
+mq_link_t s_link;
+bool s_link_ready = false;
+
+void link_ensure_locked()
+{
+    if (!s_link_ready) {
+        mq_init(&s_link);
+        s_link_ready = true;
+    }
+}
+
 }  // namespace
 
+void maipai_link_down()
+{
+    std::lock_guard<std::mutex> lock(s_link_mutex);
+    link_ensure_locked();
+    mq_down(&s_link, static_cast<uint32_t>(now_ms()));
+}
+
+void maipai_link_poll(bool refused)
+{
+    bool sound = false;
+    {
+        std::lock_guard<std::mutex> lock(s_link_mutex);
+        link_ensure_locked();
+        sound = mq_poll(&s_link, static_cast<uint32_t>(now_ms()), refused ? 1 : 0) != 0;
+    }
+    if (sound) {
+        ESP_LOGW(TAG, "Home has been unreachable for 3 minutes: the offline tone");
+        (void)maipai_sounds_play("offline");  // through the sound policy: silent at night and when muted
+    }
+}
+
+void maipai_link_up()
+{
+    bool back = false;
+    {
+        std::lock_guard<std::mutex> lock(s_link_mutex);
+        link_ensure_locked();
+        back = mq_up(&s_link) != 0;
+    }
+    if (back) {
+        (void)maipai_sounds_play("success");  // back after a real outage
+    }
+}
