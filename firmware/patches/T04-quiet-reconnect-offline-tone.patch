--- /dev/null
+++ b/firmware/main/hal/maipai_link_quiet_core.h
@@ -0,0 +1,52 @@
+/*
+ * SPDX-License-Identifier: MIT
+ *
+ * The pure logic of the quiet reconnect (patch T04). Home restarts often (an install takes 30 to 60 s) and the
+ * unit reconnects by itself, so a restart must make no sound at all. The offline tone is for a real outage:
+ * the link has been down for 3 minutes. The "back" chime follows only a tone that sounded, so a blip never
+ * chimes. While the unit waits for Home to approve it (a refused link) there is no tone: that is a setup state,
+ * shown on the face, not an outage. Times are milliseconds on any steady clock; the arithmetic is wrap safe.
+ * Plain C99, no hardware: compiled by a host test.
+ */
+#pragma once
+#include <stdint.h>
+#include <string.h>
+
+#define MQ_OFFLINE_SOUND_AFTER_MS 180000u /* 3 minutes */
+
+typedef struct {
+    uint8_t down;
+    uint8_t sounded;
+    uint32_t since_ms;
+} mq_link_t;
+
+static inline void mq_init(mq_link_t* l) { memset(l, 0, sizeof(*l)); }
+
+/* The link went down (or the unit started without it). Calling it again while down changes nothing. */
+static inline void mq_down(mq_link_t* l, uint32_t now_ms)
+{
+    if (!l->down) {
+        l->down = 1;
+        l->sounded = 0;
+        l->since_ms = now_ms;
+    }
+}
+
+/* Poll while down. Returns 1 once per outage, when the offline tone is due. */
+static inline int mq_poll(mq_link_t* l, uint32_t now_ms, int refused)
+{
+    if (l->down && !l->sounded && !refused && (uint32_t)(now_ms - l->since_ms) >= MQ_OFFLINE_SOUND_AFTER_MS) {
+        l->sounded = 1;
+        return 1;
+    }
+    return 0;
+}
+
+/* The link is back. Returns 1 when the "back" chime is due (the offline tone sounded for this outage). */
+static inline int mq_up(mq_link_t* l)
+{
+    const int back = l->down && l->sounded;
+    l->down = 0;
+    l->sounded = 0;
+    return back;
+}
