+void StackChanAvatarDisplay::OnFaceRelease(lv_event_t* event)
+{
+    if (!s_trace_live) {
+        return;
+    }
+    s_trace_live = false;
+    auto* self   = static_cast<StackChanAvatarDisplay*>(lv_event_get_user_data(event));
+    if (self == nullptr || !self->boot_done_ || self->quick_panel_ != nullptr) {
+        return;
+    }
+    lv_point_t point;
+    lv_indev_get_point(lv_indev_active(), &point);
+    mtc_move(&s_trace, point.x, point.y, GetHAL().millis());
+    const mtc_action_t action = mtc_action_on_release(&s_trace);
+    if (action != MTC_ACTION_NONE) {
+        self->OnFaceToggle(static_cast<int>(action));
+    }
+}
