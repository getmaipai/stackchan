+void StackChanAvatarDisplay::EnsureQuietMarker()
+{
+    if (quiet_marker_ != nullptr) {
+        return;
+    }
+    auto* face = dynamic_cast<DefaultAvatar*>(&GetStackChan().avatar());
+    if (face == nullptr || face->getPanel() == nullptr) {
+        return;
+    }
+    // Two short bars, like a pause mark, above the eyes. Children of the face panel; never clickable, so a
+    // touch on them is a touch on the face.
+    quiet_marker_ = lv_obj_create(face->getPanel()->get());
+    lv_obj_remove_style_all(quiet_marker_);
+    lv_obj_remove_flag(quiet_marker_, LV_OBJ_FLAG_SCROLLABLE);
+    lv_obj_remove_flag(quiet_marker_, LV_OBJ_FLAG_CLICKABLE);
+    lv_obj_set_size(quiet_marker_, 26, 22);
+    lv_obj_align(quiet_marker_, LV_ALIGN_TOP_MID, 0, 34);
+    for (int i = 0; i < 2; i++) {
+        lv_obj_t* bar = lv_obj_create(quiet_marker_);
+        lv_obj_remove_style_all(bar);
+        lv_obj_remove_flag(bar, LV_OBJ_FLAG_CLICKABLE);
+        lv_obj_set_size(bar, 7, 22);
+        lv_obj_set_pos(bar, i * 19, 0);
+        lv_obj_set_style_radius(bar, 3, 0);
+        lv_obj_set_style_bg_opa(bar, LV_OPA_COVER, 0);
+        lv_obj_set_style_bg_color(bar, face->primaryColor, 0);
+    }
+    lv_obj_add_flag(quiet_marker_, LV_OBJ_FLAG_HIDDEN);
+}
