+    MP_S_TKEY,   /* travel with the private network (patch TN03) */
+    MP_S_TPEER,
+    MP_S_BADTKEY,
     MP_S_COUNT
 };
 
@@ -60,6 +63,9 @@ static const char* const mp_strings[2][MP_S_COUNT] = {
         "Wrong setup code. Read it again on the unit's screen.",
         "Too many wrong codes. Setup is locked until the unit starts a new window in a few minutes.",
         "Could not join that network. Check the name and password, then try again.",
+        "Travel key (optional)",
+        "Home hub's private address (optional)",
+        "The travel key or the private address looks wrong. A key starts with tskey- and the address looks like 100.64.0.7.",
     },
     {
         "Configurar StackChan",
@@ -77,6 +83,9 @@ static const char* const mp_strings[2][MP_S_COUNT] = {
         "Código incorrecto. Vuelva a leerlo en la pantalla del robot.",
         "Demasiados códigos incorrectos. El ajuste queda bloqueado hasta que el robot abra otra ventana en unos minutos.",
         "No se pudo unir a esa red. Revise el nombre y la contraseña e intente de nuevo.",
+        "Clave de viaje (opcional)",
+        "Dirección privada del hub de casa (opcional)",
+        "La clave de viaje o la dirección privada no parece correcta. La clave empieza con tskey- y la dirección es como 100.64.0.7.",
     },
 };
 
