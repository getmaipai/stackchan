diff --git a/firmware/main/hal/maipai_remote_core.h b/firmware/main/hal/maipai_remote_core.h
new file mode 100644
index 0000000..e71a9d9
--- /dev/null
+++ b/firmware/main/hal/maipai_remote_core.h
@@ -0,0 +1,240 @@
+/*
+ * SPDX-License-Identifier: MIT
+ *
+ * Visible remote control (patch TB05): the pure logic. Nobody may make the robot do or say something without the robot
+ * showing it, and this cannot be turned off. A host that acts on the robot (a page, the app, a Tailscale link) first calls
+ * self.remote.session (while any controller is connected; a 10 s dead-man timeout clears it if the host dies), then
+ * self.remote.action(kind, text) before each action, which answers a one-use cue token; an action that arrives without a
+ * valid token is ignored and logged. A remote SAY shows its exact text in a bubble for 0.8 s before it is spoken, can be
+ * cancelled by a tap or the stop word in that time, is at most 200 characters, at most 3 a minute, and follows the setting
+ * "Remote speaking: off, ask first, on" (default ask first). The last 10 actions are kept. Plain C99, no clock of its own.
+ * Host test: host/tests/firmware/remote_core_test.c.
+ */
+#ifndef MAIPAI_REMOTE_CORE_H
+#define MAIPAI_REMOTE_CORE_H
+
+#include <stddef.h>
+#include <stdint.h>
+#include <string.h>
+
+#define MR_DEAD_MAN_MS 10000u
+#define MR_TOKEN_LIFE_MS 15000u
+#define MR_SAY_NOTICE_MS 800u
+#define MR_ASK_WAIT_MS 30000u
+#define MR_SAY_MAX_CHARS 200u
+#define MR_SAY_PER_MIN 3
+#define MR_HISTORY 10
+#define MR_LABEL_MAX 23
+#define MR_TEXT_KEEP 47
+
+typedef enum { MR_SPEAK_OFF = 0, MR_SPEAK_ASK, MR_SPEAK_ON } mr_speak_t;
+
+/* kinds: what the banner says is the device's; the order is the history's number */
+typedef enum { MR_MOVE = 0, MR_FIND, MR_PHOTO, MR_DANCE, MR_GAME, MR_SAY, MR_LISTEN, MR_KIND_COUNT } mr_kind_t;
+static const char* const MR_KIND_NAMES[MR_KIND_COUNT] = {"move", "find", "photo", "dance", "game", "say", "listen"};
+static const char* const MR_BANNERS[MR_KIND_COUNT]    = {"Remote: moving", "Remote: finding me", "Remote: photo", "Remote: dance",
+                                                         "Remote: game",   "Remote message",     "Remote: listening"};
+
+static inline int mr_kind_by_name(const char* s)
+{
+    if (s == NULL) return -1;
+    for (int i = 0; i < MR_KIND_COUNT; i++) if (strcmp(s, MR_KIND_NAMES[i]) == 0) return i;
+    return -1;
+}
+
+typedef enum {
+    MR_OK = 0, MR_NO_SESSION, MR_NO_TOKEN, MR_BAD_TOKEN, MR_WRONG_KIND, MR_TOO_LONG, MR_EMPTY, MR_RATE, MR_SAY_OFF, MR_BUSY, MR_BAD_KIND, MR_REASON_COUNT
+} mr_reason_t;
+static const char* const MR_REASONS[MR_REASON_COUNT] = {"ok", "no_session", "no_token", "bad_token", "wrong_kind", "too_long", "empty", "rate_limit", "say_off", "busy", "bad_kind"};
+
+typedef struct {
+    uint32_t at_ms;
+    uint8_t kind;
+    uint8_t reason; /* mr_reason_t: MR_OK when it was done */
+    uint8_t cancelled;
+    char who[MR_LABEL_MAX + 1];
+    char text[MR_TEXT_KEEP + 1];
+} mr_entry_t;
+
+typedef struct {
+    /* session */
+    uint8_t active;
+    char label[MR_LABEL_MAX + 1];
+    uint32_t seen_ms;
+    /* token: one at a time, one use */
+    uint32_t token;
+    uint8_t token_kind;
+    uint32_t token_at;
+    uint32_t counter;
+    /* say */
+    uint8_t say_state; /* 0 idle, 1 notice, 2 asking */
+    uint32_t say_at;
+    uint32_t say_len;
+    /* rate */
+    uint32_t say_times[MR_SAY_PER_MIN];
+    uint8_t say_n;
+    /* history, newest last */
+    mr_entry_t hist[MR_HISTORY];
+    uint8_t hist_n;
+    uint8_t hist_head;
+    mr_speak_t speaking; /* Remote speaking */
+} mr_t;
+
+static inline void mr_init(mr_t* r)
+{
+    memset(r, 0, sizeof(*r));
+    r->speaking = MR_SPEAK_ASK;
+    r->counter  = 0x9E3779B1u;
+}
+
+static inline void mr_log(mr_t* r, uint32_t now, int kind, mr_reason_t why, const char* text, int cancelled)
+{
+    mr_entry_t* e = &r->hist[r->hist_head];
+    memset(e, 0, sizeof(*e));
+    e->at_ms = now;
+    e->kind = (uint8_t)kind;
+    e->reason = (uint8_t)why;
+    e->cancelled = (uint8_t)cancelled;
+    strncpy(e->who, r->label, MR_LABEL_MAX);
+    if (text != NULL) {
+        size_t n = strlen(text);
+        if (n > MR_TEXT_KEEP) n = MR_TEXT_KEEP;
+        for (size_t i = 0; i < n; i++) e->text[i] = ((unsigned char)text[i] < 32) ? ' ' : text[i];
+    }
+    r->hist_head = (uint8_t)((r->hist_head + 1) % MR_HISTORY);
+    if (r->hist_n < MR_HISTORY) r->hist_n++;
+}
+
+/* The i-th newest entry (0 is the newest), or NULL. Nothing ever clears the history but the reboot. */
+static inline const mr_entry_t* mr_recent(const mr_t* r, int i)
+{
+    if (i < 0 || i >= r->hist_n) return NULL;
+    return &r->hist[(r->hist_head + MR_HISTORY - 1 - i) % MR_HISTORY];
+}
+
+/* self.remote.session: the host says a controller is connected (active) or gone; it repeats about every 3 s while on. */
+static inline void mr_session(mr_t* r, int active, const char* label, uint32_t now)
+{
+    if (active) {
+        if (!r->active) {
+            memset(r->label, 0, sizeof(r->label));
+            strncpy(r->label, (label != NULL && *label) ? label : "remote", MR_LABEL_MAX);
+        }
+        r->active = 1;
+        r->seen_ms = now;
+    } else {
+        r->active = 0;
+        r->token = 0;
+        r->say_state = 0;
+    }
+}
+
+/* 1 while a controller counts as connected (the dead-man timeout: no call for 10 s clears it by itself). */
+static inline int mr_session_on(mr_t* r, uint32_t now)
+{
+    if (r->active && now - r->seen_ms >= MR_DEAD_MAN_MS) {
+        r->active = 0;
+        r->token = 0;
+        r->say_state = 0;
+    }
+    return r->active;
+}
+
+/* self.remote.action(kind, text): the cue call before an action. On MR_OK `*token` is the one-use token. */
+static inline mr_reason_t mr_action(mr_t* r, const char* kind, uint32_t now, uint32_t* token)
+{
+    const int k = mr_kind_by_name(kind);
+    if (k < 0) { mr_log(r, now, MR_KIND_COUNT - 1, MR_BAD_KIND, kind, 0); return MR_BAD_KIND; }
+    if (!mr_session_on(r, now)) { mr_log(r, now, k, MR_NO_SESSION, NULL, 0); return MR_NO_SESSION; }
+    r->counter = r->counter * 1664525u + 1013904223u;
+    r->token = (r->counter >> 3) | 1u; /* never 0 */
+    r->token_kind = (uint8_t)k;
+    r->token_at = now;
+    *token = r->token;
+    return MR_OK;
+}
+
+/* The gate every remote-origin action calls first. Token 0 is "none". On MR_OK the token is used up. A refusal is logged. */
+static inline mr_reason_t mr_gate(mr_t* r, const char* kind, uint32_t token, uint32_t now)
+{
+    const int k = mr_kind_by_name(kind);
+    if (k < 0) { mr_log(r, now, MR_KIND_COUNT - 1, MR_BAD_KIND, kind, 0); return MR_BAD_KIND; }
+    mr_reason_t why = MR_OK;
+    if (token == 0) why = MR_NO_TOKEN;
+    else if (r->token == 0 || token != r->token || now - r->token_at > MR_TOKEN_LIFE_MS) why = MR_BAD_TOKEN;
+    else if (r->token_kind != k) why = MR_WRONG_KIND;
+    else if (!mr_session_on(r, now)) why = MR_NO_SESSION;
+    if (why != MR_OK) { mr_log(r, now, k, why, NULL, 0); return why; }
+    r->token = 0;
+    return MR_OK;
+}
+
+/* A remote SAY with its token. On MR_OK the notice starts: the device shows the bubble now; mr_say_poll says when to speak. */
+static inline mr_reason_t mr_say(mr_t* r, const char* text, uint32_t token, uint32_t now)
+{
+    if (text == NULL || *text == 0) { mr_log(r, now, MR_SAY, MR_EMPTY, NULL, 0); return MR_EMPTY; }
+    const size_t n = strlen(text);
+    const mr_reason_t g = mr_gate(r, "say", token, now);
+    if (g != MR_OK) return g;
+    if (n > MR_SAY_MAX_CHARS) { mr_log(r, now, MR_SAY, MR_TOO_LONG, text, 0); return MR_TOO_LONG; }
+    if (r->speaking == MR_SPEAK_OFF) { mr_log(r, now, MR_SAY, MR_SAY_OFF, text, 0); return MR_SAY_OFF; }
+    if (r->say_state != 0) { mr_log(r, now, MR_SAY, MR_BUSY, text, 0); return MR_BUSY; }
+    /* at most 3 in any 60 s */
+    int recent = 0;
+    for (int i = 0; i < r->say_n; i++) if (now - r->say_times[i] < 60000u) recent++;
+    if (recent >= MR_SAY_PER_MIN) { mr_log(r, now, MR_SAY, MR_RATE, text, 0); return MR_RATE; }
+    if (r->say_n < MR_SAY_PER_MIN) r->say_times[r->say_n++] = now;
+    else { memmove(r->say_times, r->say_times + 1, sizeof(r->say_times[0]) * (MR_SAY_PER_MIN - 1)); r->say_times[MR_SAY_PER_MIN - 1] = now; }
+    r->say_state = 1;
+    r->say_at = now;
+    r->say_len = (uint32_t)n;
+    mr_log(r, now, MR_SAY, MR_OK, text, 0);
+    return MR_OK;
+}
+
+typedef enum { MR_SAY_NONE = 0, MR_SAY_SPEAK, MR_SAY_CANCELLED, MR_SAY_ASKING } mr_say_event_t;
+
+/* Polled every 50 ms. SPEAK: speak the text now. CANCELLED: drop it. ASKING (once): show "tap to allow". */
+static inline mr_say_event_t mr_say_poll(mr_t* r, uint32_t now)
+{
+    if (r->say_state == 0) return MR_SAY_NONE;
+    if (!mr_session_on(r, now)) { r->say_state = 0; r->hist[(r->hist_head + MR_HISTORY - 1) % MR_HISTORY].cancelled = 1; return MR_SAY_CANCELLED; }
+    if (r->say_state == 1 && now - r->say_at >= MR_SAY_NOTICE_MS) {
+        if (r->speaking == MR_SPEAK_ASK) { r->say_state = 2; r->say_at = now; return MR_SAY_ASKING; }
+        r->say_state = 0;
+        return MR_SAY_SPEAK;
+    }
+    if (r->say_state == 2 && now - r->say_at >= MR_ASK_WAIT_MS) {
+        r->say_state = 0;
+        r->hist[(r->hist_head + MR_HISTORY - 1) % MR_HISTORY].cancelled = 1;
+        return MR_SAY_CANCELLED;
+    }
+    return MR_SAY_NONE;
+}
+
+/* A tap on the robot: during the notice it cancels (mode on), while asking it allows. Returns the event it caused. */
+static inline mr_say_event_t mr_tap(mr_t* r, uint32_t now)
+{
+    (void)now;
+    if (r->say_state == 2) { r->say_state = 0; return MR_SAY_SPEAK; }
+    if (r->say_state == 1) { r->say_state = 0; r->hist[(r->hist_head + MR_HISTORY - 1) % MR_HISTORY].cancelled = 1; return MR_SAY_CANCELLED; }
+    return MR_SAY_NONE;
+}
+
+/* The stop word or any "stop": cancels a pending say in either state. */
+static inline mr_say_event_t mr_stop(mr_t* r)
+{
+    if (r->say_state != 0) { r->say_state = 0; r->hist[(r->hist_head + MR_HISTORY - 1) % MR_HISTORY].cancelled = 1; return MR_SAY_CANCELLED; }
+    return MR_SAY_NONE;
+}
+
+static inline int mr_parse_speaking(const char* s, mr_speak_t* out)
+{
+    if (s == NULL) return 0;
+    if (strcmp(s, "off") == 0) { *out = MR_SPEAK_OFF; return 1; }
+    if (strcmp(s, "ask") == 0) { *out = MR_SPEAK_ASK; return 1; }
+    if (strcmp(s, "on") == 0) { *out = MR_SPEAK_ON; return 1; }
+    return 0;
+}
+
+#endif
