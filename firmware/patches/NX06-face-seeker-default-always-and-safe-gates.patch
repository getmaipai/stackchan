+    uint8_t locked, carried; /* patch NX06: the passcode lock is on, or the unit is held in a hand: nothing runs, in any mode */
+    uint8_t night;           /* patch NX06: night mode: the idle watch of "always" does not run (a wake word still turns the head, slowly) */
     uint8_t mode;           /* MS_MODE_* from the setting */
     const uint8_t* frame;   /* a gray 40 by 30 frame taken now at pan_deg, or NULL */
     uint8_t face_valid;     /* detector build: a face was found in this frame */
@@ -568,7 +570,7 @@ static inline void ms_tick(ms_t* s, const ms_in_t* in, ms_out_t* out)
 {
     memset(out, 0, sizeof(*out));
     uint32_t now = in->now_ms;
-    int camera_ok = in->awake && !in->muted && !in->privacy_sleep && !in->vision_off && !in->full_quiet;
+    int camera_ok = in->awake && !in->muted && !in->privacy_sleep && !in->vision_off && !in->full_quiet && !in->locked && !in->carried;
     int leased = ms_lease_active(&s->lease, now);
     if (in->mode == MS_MODE_OFF || !camera_ok || leased) { /* nothing runs: no camera, no head move */
         if (s->state != MS_IDLE) {
@@ -656,7 +658,7 @@ static inline void ms_tick(ms_t* s, const ms_in_t* in, ms_out_t* out)
 
     switch (s->state) {
     case MS_IDLE:
-        if (in->mode != MS_MODE_ALWAYS) {
+        if (in->mode != MS_MODE_ALWAYS || in->night) { /* patch NX06: at night the unit does not search on its own */
             break;
         }
         if (watch_hit && ms_turn_slots_free(s, now) > 0) {
