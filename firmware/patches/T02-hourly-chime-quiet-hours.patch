+#if CONFIG_MAIPAI_HOURLY_CHIME
+// ---- the hourly chime (patch T02) ----
+const char* kDailyNamespace = "mp_daily";  // our own namespace, never the websocket one
+std::atomic<int> s_hourly{-1};              // -1 not read yet, then 0 or 1
+int32_t s_hourly_last_key = -1;
+
+bool hourly_enabled()
+{
+    int v = s_hourly.load();
+    if (v < 0) {
+        v = 0;  // off until a person turns it on
+        nvs_handle_t h;
+        if (nvs_open(kDailyNamespace, NVS_READONLY, &h) == ESP_OK) {
+            uint8_t b = 0;
+            if (nvs_get_u8(h, "hourly", &b) == ESP_OK) {
+                v = b != 0;
+            }
+            nvs_close(h);
+        }
+        s_hourly.store(v);
+    }
+    return v != 0;
+}
+
+void hourly_save(bool on)
+{
+    nvs_handle_t h;
+    if (nvs_open(kDailyNamespace, NVS_READWRITE, &h) != ESP_OK) {
+        ESP_LOGW(TAG, "could not save the hourly chime setting");
+        return;
+    }
+    if (nvs_set_u8(h, "hourly", on ? 1 : 0) != ESP_OK || nvs_commit(h) != ESP_OK) {
+        ESP_LOGW(TAG, "could not write the hourly chime setting");
+    }
+    nvs_close(h);
+}
+
+// One decision about the chime. `force_top` is the test tool. Returns what was decided.
+mh_result_t hourly_run(bool force_top)
+{
+    time_t t = time(nullptr);
+    int minute     = -1;
+    int32_t key    = 0;
+    if (t >= 1700000000) {
+        struct tm tm_local = {};
+        localtime_r(&t, &tm_local);
+        minute = tm_local.tm_hour * 60 + tm_local.tm_min;
+        key    = tm_local.tm_year * 8784 + tm_local.tm_yday * 24 + tm_local.tm_hour;
+    }
+    const bool busy = Application::GetInstance().GetDeviceState() != kDeviceStateIdle || maipai_timers_ringing();
+    const mh_result_t r = mh_decide(&s_hourly_last_key, hourly_enabled() ? 1 : 0, minute, key,
+                                    maipai_sounds_chime_quiet(minute) ? 1 : 0, busy ? 1 : 0, force_top ? 1 : 0);
+    if (r == MH_CHIME) {
+        // The soft "ready" tone, through the sound policy and the hard mute like every other sound.
+        const bool played = maipai_sounds_play("success");
+        char extra[40];
+        snprintf(extra, sizeof(extra), "\"hour\":%d,\"played\":%d", minute / 60, played ? 1 : 0);
+        device_events_push("chime", extra);
+    }
+    return r;
+}
+#endif
+
