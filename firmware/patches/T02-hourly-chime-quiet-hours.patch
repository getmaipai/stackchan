diff --git a/firmware/main/hal/maipai_hourly_core.h b/firmware/main/hal/maipai_hourly_core.h
new file mode 100644
--- /dev/null
+++ b/firmware/main/hal/maipai_hourly_core.h
@@ -0,0 +1,69 @@
+/*
+ * SPDX-License-Identifier: MIT
+ *
+ * The pure logic of the hourly chime and its quiet-hours rule (patch T02). One soft chime at the top of the hour,
+ * off until a person turns it on. It never sounds in quiet hours (the person's own window, or 22:00 to 07:00
+ * when none is set), never while the host says it is dark, never while the unit is busy, and never twice in one
+ * hour. Unlike the other cues it ignores "sounds at night are fine": a chime is not something a person must
+ * notice. Plain C99, no hardware: compiled by a host test.
+ */
+#pragma once
+#include <stdint.h>
+#include "maipai_sounds_core.h"
+
+#define MH_DEFAULT_QUIET_FROM 1320 /* 22:00 */
+#define MH_DEFAULT_QUIET_TO 420    /* 07:00 */
+
+typedef enum {
+    MH_NO_CLOCK = 0, /* the unit's clock was never set */
+    MH_OFF,          /* the chime is off */
+    MH_NOT_TOP,      /* not the top of an hour */
+    MH_DONE,         /* this hour already had its turn */
+    MH_QUIET,        /* quiet hours or dark: skipped for this hour */
+    MH_BUSY,         /* speaking, listening or a timer ringing: tried again while the minute lasts */
+    MH_CHIME         /* play it now */
+} mh_result_t;
+
+/* Is it quiet for the chime? `minute` is the local minute of the day, -1 while the clock is not set. */
+static inline int mh_quiet_now(const ms_policy_t* p, int minute, int host_up)
+{
+    int from = p->quiet_from;
+    int to = p->quiet_to;
+    if (from < 0 || to < 0 || from == to) {
+        from = MH_DEFAULT_QUIET_FROM;
+        to = MH_DEFAULT_QUIET_TO;
+    }
+    return ms_in_window(from, to, minute) || (p->dark && host_up);
+}
+
+/* One decision. `key` names the local hour (any number that changes each hour); `last_key` is the hour that
+ * already had its turn (start it at -1). `force_top` is the test: treat this minute as the top of the hour. */
+static inline mh_result_t mh_decide(int32_t* last_key, int enabled, int minute, int32_t key, int quiet, int busy,
+                                    int force_top)
+{
+    if (minute < 0) return MH_NO_CLOCK;
+    if (!enabled) return MH_OFF;
+    if (!force_top && (minute % 60) != 0) return MH_NOT_TOP;
+    if (!force_top && key == *last_key) return MH_DONE;
+    if (quiet) {
+        if (!force_top) *last_key = key;
+        return MH_QUIET;
+    }
+    if (busy) return MH_BUSY;
+    if (!force_top) *last_key = key;
+    return MH_CHIME;
+}
+
+static inline const char* mh_word(mh_result_t r)
+{
+    switch (r) {
+    case MH_NO_CLOCK: return "no_clock";
+    case MH_OFF: return "off";
+    case MH_NOT_TOP: return "not_top";
+    case MH_DONE: return "done";
+    case MH_QUIET: return "quiet";
+    case MH_BUSY: return "busy";
+    case MH_CHIME: return "chime";
+    }
+    return "unknown";
+}
