+static const IPart kIconRock[]   = {{K_BOX, 22, 38, 56, 50, 18, C_SKIN}, {K_DISC, 28, 34, 12, 0, 0, C_SKIN}, {K_DISC, 43, 28, 12, 0, 0, C_SKIN},
+                                    {K_DISC, 58, 28, 12, 0, 0, C_SKIN}, {K_DISC, 73, 34, 12, 0, 0, C_SKIN}, {K_BOX, 14, 58, 36, 16, 8, C_SKIN2},
