+                                    {K_LINE, 86, 50, 78, 68, 6, C_AMBER}, {K_END, 0, 0, 0, 0, 0, 0}};
+static const IPart kIconPet[]    = {{K_DISC, 50, 64, 26, 0, 0, C_MAIN}, {K_DISC, 41, 62, 4, 0, 0, C_DARK}, {K_DISC, 59, 62, 4, 0, 0, C_DARK},
+                                    {K_BOX, 24, 8, 52, 22, 11, C_SKIN}, {K_LINE, 12, 14, 20, 28, 5, C_AMBER}, {K_LINE, 88, 14, 80, 28, 5, C_AMBER},
+                                    {K_END, 0, 0, 0, 0, 0, 0}};
+static const IPart kIconTilt[]   = {{K_LINE, 30, 80, 70, 26, 36, C_MAIN}, {K_DISC, 50, 53, 5, 0, 0, C_DARK}, {K_LINE, 8, 94, 92, 94, 6, C_AMBER},
