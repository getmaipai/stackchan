+/* Patch GM04: puts an icon shape at its place for this moment. A popping icon grows from half size with an overshoot in 300 ms after it appears;
+ * a bumping icon (the fist that counts the beats) rises and falls once in 560 ms after each state is entered. Returns true while it moves. */
+inline bool icon_apply(Parts* P, lv_obj_t* o, const mg_shape_t& s, const mg_run_t& r, uint32_t now, uint32_t t_app, uint32_t t_state)
+{
+    Icon* ic = nullptr;
+    for (int k = 0; k < P->n_icons; k++) {
+        if (P->icon[k].root == o) ic = &P->icon[k];
+    }
+    if (ic == nullptr) return false;
+    (void)now;
+    const int id = s.cond_ctr == 0xFF ? (int)s.text : (int)r.ctr[s.cond_ctr] + (int)s.text;
+    float scale = 1.0f;
+    int dy = 0;
+    bool busy = false;
+    if ((s.h & MG_ICON_POP) && t_app < 300u) {
+        scale = 0.5f + 0.5f * ease_back((float)t_app / 300.0f);
+        busy = true;
+    }
+    if ((s.h & MG_ICON_BUMP) && t_state < 560u) {
+        dy   = -(int)(sinf(3.14159f * (float)t_state / 560.0f) * (float)(s.w / 6));
+        busy = true;
+    }
+    icon_show(ic, id, s.x, s.y + dy, (int)((float)(s.w > 0 ? s.w : 60) * scale), (s.h & MG_ICON_MIRROR) != 0, s.colour);
+    return busy;
+}
