+static const IPart kIconPaper[]  = {{K_BOX, 24, 48, 52, 44, 16, C_SKIN}, {K_BOX, 24, 12, 12, 44, 6, C_SKIN}, {K_BOX, 37, 6, 12, 50, 6, C_SKIN},
+                                    {K_BOX, 50, 4, 12, 52, 6, C_SKIN}, {K_BOX, 63, 10, 12, 46, 6, C_SKIN}, {K_BOX, 6, 58, 26, 13, 6, C_SKIN2},
