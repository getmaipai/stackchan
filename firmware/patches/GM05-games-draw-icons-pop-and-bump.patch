+/* The table of an icon, and whether it is drawn mirrored by itself (the right swipe is the left one reversed). */
+inline const IPart* icon_table(int id, bool* mirror)
+{
+    *mirror = false;
+    switch (id) {
+        case MG_ICON_TAP: return kIconTap;
+        case MG_ICON_SWIPE_L: return kIconSwipe;
+        case MG_ICON_SWIPE_R: *mirror = true; return kIconSwipe;
+        case MG_ICON_SHAKE: return kIconShake;
+        case MG_ICON_PET: return kIconPet;
+        case MG_ICON_TILT: return kIconTilt;
+        case MG_ICON_ROCK: return kIconRock;
+        case MG_ICON_PAPER: return kIconPaper;
+        case MG_ICON_SCISSORS: return kIconScissors;
+        default: return nullptr;
+    }
+}
+
+/* How many boxes, discs and rings (blobs) and lines an icon has. */
+inline void icon_counts(int id, int* nb, int* nl)
+{
+    bool m;
+    const IPart* t = icon_table(id, &m);
+    *nb = *nl = 0;
+    for (; t != nullptr && t->kind != K_END; t++) {
+        if (t->kind == K_LINE) (*nl)++; else (*nb)++;
+    }
+}
+
+struct Icon {
+    lv_obj_t* root;
+    lv_obj_t* blob[kIconBlobs];
+    lv_obj_t* line[kIconLines];
+    lv_point_precise_t pts[kIconLines][2];
+    int nb, nl;
+    int id, size, x, y, flags;
+    uint16_t colour;
+};
+
+inline lv_obj_t* icon_build(lv_obj_t* parent, Icon* ic, int nb, int nl)
+{
+    memset(ic, 0, sizeof(*ic));
+    ic->id   = -1;
+    ic->nb   = nb < kIconBlobs ? nb : kIconBlobs;
+    ic->nl   = nl < kIconLines ? nl : kIconLines;
+    ic->root = plain(parent);
+    for (int i = 0; i < ic->nb; i++) {
+        ic->blob[i] = plain(ic->root);
+    }
+    for (int i = 0; i < ic->nl; i++) {
+        lv_obj_t* o = lv_line_create(ic->root);
+        lv_obj_remove_flag(o, LV_OBJ_FLAG_CLICKABLE);
+        lv_obj_add_flag(o, LV_OBJ_FLAG_HIDDEN);
+        lv_obj_set_style_line_rounded(o, true, 0);
+        ic->line[i] = o;
+    }
+    return ic->root;
+}
+
+inline lv_color_t icon_color(int col, uint16_t main)
+{
+    const lv_color_t m = color_of(main);
+    switch (col) {
+        case C_MAIN: return m;
+        case C_DARK: return lv_color_make(static_cast<uint8_t>(m.red * 4 / 10), static_cast<uint8_t>(m.green * 4 / 10), static_cast<uint8_t>(m.blue * 4 / 10));
+        case C_WHITE: return lv_color_hex(0xffffff);
+        case C_AMBER: return lv_color_hex(0xffb020);
+        case C_SKIN: return lv_color_hex(0xf0c8a0);
+        case C_SKIN2: return lv_color_hex(0xd9a878);
+        case C_STEEL: return lv_color_hex(0xdfe3e8);
+        case C_STEEL2: return lv_color_hex(0xaeb6c0);
+        case C_RED: return lv_color_hex(0xff5a4d);
+        default: return lv_color_hex(0x7a8896);
+    }
+}
+
+/* Lays the icon out at its place and size (a size of 0 or less hides every part). The same arguments as the last call do nothing. */
+inline void icon_show(Icon* ic, int id, int cx, int cy, int size, bool mirror, uint16_t colour)
+{
+    if (ic->id == id && ic->size == size && ic->x == cx && ic->y == cy && ic->flags == (mirror ? 1 : 0) && ic->colour == colour) {
+        return;
+    }
+    ic->id = id; ic->size = size; ic->x = cx; ic->y = cy; ic->flags = mirror ? 1 : 0; ic->colour = colour;
+    bool self_mirror;
+    const IPart* t = icon_table(id, &self_mirror);
+    mirror = mirror != self_mirror;
+    lv_obj_set_size(ic->root, size > 0 ? size : 1, size > 0 ? size : 1);
+    lv_obj_set_pos(ic->root, cx - size / 2, cy - size / 2);
+    int ib = 0, il = 0;
+    auto sc = [size](int v) { return (v * size + 50) / 100; };
+    for (; t != nullptr && size > 0 && t->kind != K_END; t++) {
+        const int x1 = mirror ? 100 - t->a : t->a;
+        if (t->kind == K_LINE) {
+            if (il >= ic->nl) continue;
+            lv_obj_t* o = ic->line[il];
+            ic->pts[il][0].x = sc(x1);
+            ic->pts[il][0].y = sc(t->b);
+            ic->pts[il][1].x = sc(mirror ? 100 - t->c : t->c);
+            ic->pts[il][1].y = sc(t->d);
+            lv_line_set_points(o, ic->pts[il], 2);
+            lv_obj_set_style_line_width(o, sc(t->e) < 2 ? 2 : sc(t->e), 0);
+            lv_obj_set_style_line_color(o, icon_color(t->col, colour), 0);
+            lv_obj_remove_flag(o, LV_OBJ_FLAG_HIDDEN);
+            il++;
+            continue;
+        }
+        if (ib >= ic->nb) continue;
+        lv_obj_t* o = ic->blob[ib++];
+        int x = 0, y = 0, w = 0, h = 0, radius = 0;
+        if (t->kind == K_BOX) {
+            x = sc(mirror ? 100 - (t->a + t->c) : t->a); y = sc(t->b); w = sc(t->c); h = sc(t->d); radius = sc(t->e);
+        } else {
+            const int r = sc(t->c);
+            x = sc(x1) - r; y = sc(t->b) - r; w = h = 2 * r; radius = LV_RADIUS_CIRCLE;
+        }
+        lv_obj_set_pos(o, x, y);
+        lv_obj_set_size(o, w < 1 ? 1 : w, h < 1 ? 1 : h);
+        lv_obj_set_style_radius(o, radius, 0);
+        if (t->kind == K_RING) {
+            lv_obj_set_style_bg_opa(o, LV_OPA_TRANSP, 0);
+            lv_obj_set_style_border_width(o, sc(t->e) < 2 ? 2 : sc(t->e), 0);
+            lv_obj_set_style_border_color(o, icon_color(t->col, colour), 0);
+        } else {
+            lv_obj_set_style_border_width(o, 0, 0);
+            lv_obj_set_style_bg_opa(o, LV_OPA_COVER, 0);
+            lv_obj_set_style_bg_color(o, icon_color(t->col, colour), 0);
+        }
+        lv_obj_remove_flag(o, LV_OBJ_FLAG_HIDDEN);
+    }
+    for (; ib < ic->nb; ib++) lv_obj_add_flag(ic->blob[ib], LV_OBJ_FLAG_HIDDEN);
+    for (; il < ic->nl; il++) lv_obj_add_flag(ic->line[il], LV_OBJ_FLAG_HIDDEN);
+}
