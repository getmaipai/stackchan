+/* ---- the icons (patch GM04) ----
+ * A large icon is a handful of plain LVGL objects (rounded boxes, discs, rings, thick lines) laid out from a table in a 100 by 100 grid, so
+ * the same code draws it at any size and the pop animation only re-lays it out. A gesture icon (tap, swipe, shake, pet, tilt) and the three hands
+ * (rock, paper, scissors) are in the table; an icon whose number never changes allocates only the parts that icon needs. */
+constexpr int kIconBlobs = 6, kIconLines = 4, kMaxIcons = 6;
+enum { K_END = 0, K_BOX, K_DISC, K_RING, K_LINE };
+enum { C_MAIN = 0, C_DARK, C_WHITE, C_AMBER, C_SKIN, C_SKIN2, C_STEEL, C_STEEL2, C_RED, C_GRAY };
+struct IPart {
+    uint8_t kind;
+    int8_t a, b, c, d;  /* box: x y w h; disc and ring: cx cy radius; line: x1 y1 x2 y2 */
+    uint8_t e, col;     /* box: corner radius; ring and line: thickness */
+};
