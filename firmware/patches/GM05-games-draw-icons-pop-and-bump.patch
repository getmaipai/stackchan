+static const IPart kIconScissors[] = {{K_LINE, 34, 76, 70, 8, 10, C_STEEL}, {K_LINE, 66, 76, 30, 8, 10, C_STEEL2}, {K_RING, 30, 82, 14, 0, 7, C_RED},
