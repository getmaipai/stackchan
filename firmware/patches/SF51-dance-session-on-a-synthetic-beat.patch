diff --git a/firmware/main/hal/maipai_music.cc b/firmware/main/hal/maipai_music.cc
--- a/firmware/main/hal/maipai_music.cc
+++ b/firmware/main/hal/maipai_music.cc
@@ -432,8 +432,27 @@ void set_enabled(bool enabled, bool persist)
 
 // The beat of the song for the dance (beat_sway.h): true while a beat was measured in the last 3 seconds with a
