# Intent: Core trim on the rebuilt base: drop the unused MQTT protocol client and the unused vendor app headers, and apply sdkconfig.core.defaults (log level WARN, IPv6 off) to every build. The vendor apps, 4G boards, BLE and Mooncake loop are already out through 096 to 099, so this is the remainder of the measured S01 trim.
# Placement: unit (build size and internal RAM on the robot)
# Upstream: firmware/main/CMakeLists.txt and apps/apps.h of the StackChan tree (MIT)
diff --git a/firmware/CMakeLists.txt b/firmware/CMakeLists.txt
index f1c6e4d..9f9c598 100644
--- a/firmware/CMakeLists.txt
+++ b/firmware/CMakeLists.txt
@@ -24,5 +24,15 @@ if(EXISTS "${CMAKE_CURRENT_SOURCE_DIR}/sdkconfig.defaults.local")
     message(STATUS "StackChan: detected sdkconfig.defaults.local, applying overlay")
 endif()
 
+# MaiPai core trim (patch S01): sdkconfig.core.defaults (WARN log level, no IPv6) rides on every build.
+if(EXISTS "${CMAKE_CURRENT_SOURCE_DIR}/sdkconfig.core.defaults")
+    if(NOT SDKCONFIG_DEFAULTS)
+        set(SDKCONFIG_DEFAULTS "${CMAKE_CURRENT_SOURCE_DIR}/sdkconfig.defaults")
+    endif()
+    if(NOT SDKCONFIG_DEFAULTS MATCHES "sdkconfig.core.defaults")
+        list(APPEND SDKCONFIG_DEFAULTS "${CMAKE_CURRENT_SOURCE_DIR}/sdkconfig.core.defaults")
+    endif()
+endif()
+
 include($ENV{IDF_PATH}/tools/cmake/project.cmake)
 project(maipai-stackchan)
