+        "Finish",
+        "Done. StackChan is joining your network. You can close this page.",
     },
     {
         "Configurar StackChan",
@@ -81,7 +85,7 @@ static const char* const mp_strings[2][MP_S_COUNT] = {
         "Dirección de casa (opcional)",
         "Guardar",
         "Uniendo a la red. Puede tardar 30 segundos.",
-        "Guardado. StackChan se está uniendo a su red. Puede cerrar esta página.",
+        "Guardado. Agregue otra red arriba, o toque Terminar cuando termine.",
         "Código incorrecto. Vuelva a leerlo en la pantalla del robot.",
         "Demasiados códigos incorrectos. El ajuste queda bloqueado hasta que el robot abra otra ventana en unos minutos.",
         "No se pudo unir a esa red. Revise el nombre y la contraseña e intente de nuevo.",
@@ -89,6 +93,8 @@ static const char* const mp_strings[2][MP_S_COUNT] = {
         "Dirección privada del hub de casa (opcional)",
         "La clave de viaje o la dirección privada no parece correcta. La clave empieza con tskey- y la dirección es como 100.64.0.7.",
         "No se pudieron guardar los ajustes de viaje, así que no se cambió nada. Intente de nuevo; si sigue fallando, reinicie StackChan y reintente.",
+        "Terminar",
+        "Listo. StackChan se está uniendo a su red. Puede cerrar esta página.",
     },
 };
 
