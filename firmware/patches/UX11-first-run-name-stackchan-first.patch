+/* The name shown as chosen on the name step: the answer given, or StackChan until one is given. */
+static inline int mfr_name_shown(const mfr_t* m)
+{
+    return m->name >= 0 ? m->name : MFR_NAME_STACKCHAN;
+}
+
+/* The screen order of the seven tiles: StackChan first, then the six others in their old order. slot 0 to 6 -> saved index. */
+static inline int mfr_name_at_slot(int slot)
+{
+    return slot == 0 ? MFR_NAME_STACKCHAN : slot - 1;
+}
