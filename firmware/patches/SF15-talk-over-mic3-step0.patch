+
+#if CONFIG_MAIPAI_TALK_OVER
+// Patch SF15 (bench): a new MIC3 gain while the input is open.
+void maipai_mic3_set_gain_db(int db) {
+    auto* codec = CoreS3AudioCodec::Instance();
