+// ---- patch SF94: a telling from the pantry ----
+uint32_t next_rand(Qa* g)
+{
+    g->rng = g->rng * 1664525u + 1013904223u;
+    return g->rng >> 8;
+}
+
+// The next record of the telling: a joke or riddle shows its words (the answer waits for Reveal); trivia shows the question and the answer among its two wrong ones.
+void local_next(Qa* g)
+{
+    MaipaiPantryRecord r;
+    if (!maipai_pantry_pick(g->pk, g->es ? "es" : "en", &r)) {
+        post(g, say(g->es, "Nothing more to tell right now. Ask the host to fill the pantry.", "No hay mas que contar ahora. Pide al equipo que llene la despensa."), 3000);
+        end_locked("no_content");
+        return;
+    }
+    char words[200];
+    g->answer[0] = '\0';
+    if (g->pk == 1) {   // a joke: the setup, then the punchline after Reveal
+        const char* bar = strchr(r.text, '|');
+        const size_t n = bar != nullptr ? static_cast<size_t>(bar - r.text) : strlen(r.text);
+        snprintf(words, sizeof(words), "%.*s", static_cast<int>(n), r.text);
+        if (bar != nullptr) cut_text(bar + 1, 70, g->answer, sizeof(g->answer));
+    } else {
+        snprintf(words, sizeof(words), "%s", r.text);
+        if (g->pk == 2) cut_text(r.answer, 70, g->answer, sizeof(g->answer));
+    }
+    int n_choices = 0;
+    if (g->pk == 3) {   // the right answer and up to two wrong ones, in a shuffled order
+        char tiles[3][MPY_TILE_BYTES];
+        int right = 0;
+        n_choices = mpy_tiles(r.answer, r.extra, next_rand(g), tiles, &right);
+        if (n_choices < 2) {   // a trivia record with no wrong answers cannot make tiles: it counts as told and the next one comes
+            maipai_pantry_told(r.id);
+            local_next(g);
+            return;
+        }
+        for (int i = 0; i < n_choices; i++) memcpy(g->choices[i], tiles[i], sizeof(g->choices[i]));
+        g->right_idx = static_cast<int8_t>(right);
+    }
+    cut_text(words, MQA_MAX, g->question, sizeof(g->question));
+    g->shown = 0;
+    qs_question(&g->st, g->st.n + 1, n_choices, 0, now_ms());
+    maipai_pantry_told(r.id);   // shown now: it counts as told
+    build_screen(g);
+}
+
+const char* start_local_locked(int pk, bool es)
+{
+    MaipaiPantryRecord probe;
+    if (!maipai_pantry_pick(pk, es ? "es" : "en", &probe))
+        return say(es, "There is nothing to tell yet. Ask the host to fill the pantry.", "Todavia no hay nada que contar. Pide al equipo que llene la despensa.");
+    const char* why = start_locked(pk == 3 ? QS_TRIVIA : QS_RIDDLE, es, 5);
+    if (why[0] != '\0') return why;
+    Qa* g = s_qa;
+    g->local = true;
+    g->joke = pk == 1;
+    g->pk = static_cast<uint8_t>(pk);
+    g->rng = now_ms() | 1u;
+    local_next(g);
+    return "";
+}
