# Intent: The games page and the Apps and Games walls at finger size (owner review 2026-11-18, the physical standard in docs/design/screen-style.md; batch UX13e). Two columns and two rows of 148 by 64 px tiles with an 8 px gap and an 8 px margin, so the first screen shows four games with their names in the 20 px body text over the best score in 16 px; a long name ("Rock Paper Scissors") wraps in 16 px and keeps its best line; the lines are stacked and centered in the tile so they cannot overlap in any language. With more than four games the fourth tile is "More games" with "page N of M" under it. The Apps and Games walls keep their picture tiles but take the 8 px gap and 6 px margin (150 by 86 tiles). Display only: no safety, lock, cue, limiter or head-motion code.
# Placement: unit
# Upstream: firmware/main/hal/maipai_pages.cc, maipai_pages_core.h, maipai_apps_core.h (ours)
# Check after a flash: Games shows four tiles, each name and its best score on two clean lines, no text touching the tile edge; the fourth tile says More games and the page it is on; tapping it shows the next games.
# Kconfig: none

diff --git a/firmware/main/hal/maipai_pages_core.h b/firmware/main/hal/maipai_pages_core.h
--- a/firmware/main/hal/maipai_pages_core.h
+++ b/firmware/main/hal/maipai_pages_core.h
@@ -920,21 +920,33 @@
 #define MPG_GAMES_TOP 10
 #define MPG_GAMES_AREA_H 136
 #define MPG_GAMES_GAP 2
-/* Patch UI13: seven games do not fit three rows. The games page is a grid of two columns and three rows of 44 px tiles (slot 0 to 5, row by
- * row); with more than six games the last slot is a "More" tile and the others show five games a page. */
+/* Patch UX13e: the games page at finger size. A grid of two columns and two rows of 148 by 64 px tiles (slot 0 to 3, row by row) with an 8 px gap, on the 8 px margin
+ * of the screen standard (docs/design/screen-style.md); with more than four games the last slot is a "More games" tile that also tells which page of the list shows. A game tile
+ * is the name (20 px) over its best score (16 px); a long name wraps in 16 px and keeps the best line. */
 #define MPG_GAMES_COLS 2
-#define MPG_GAMES_SLOTS 6
-#define MPG_GAMES_TILE_W 150
-#define MPG_GAMES_TILE_H 44
-#define MPG_GAMES_COL_GAP 4
+#define MPG_GAMES_SLOTS 4
+#define MPG_GAMES_TILE_W 148
+#define MPG_GAMES_TILE_H 64
+#define MPG_GAMES_COL_GAP 8
 static inline int mpg_games_per_page(int total) { return total <= MPG_GAMES_SLOTS ? total : MPG_GAMES_SLOTS - 1; }
 static inline int mpg_games_has_more(int total) { return total > MPG_GAMES_SLOTS; }
+/* How many pages the list takes and which one `offset` is on (both 1 for a list that fits). */
+static inline int mpg_games_pages(int total)
+{
+    const int per = mpg_games_per_page(total);
+    return per < 1 ? 1 : (total + per - 1) / per;
+}
+static inline int mpg_games_page_of(int offset, int total)
+{
+    const int per = mpg_games_per_page(total);
+    return per < 1 ? 1 : offset / per + 1;
+}
 static inline void mpg_games_tile(int slot, int* x, int* y, int* w, int* h)
 {
     *w = MPG_GAMES_TILE_W;
     *h = MPG_GAMES_TILE_H;
     *x = (slot % MPG_GAMES_COLS == 0) ? 8 : 8 + MPG_GAMES_TILE_W + MPG_GAMES_COL_GAP;
-    *y = MPG_GAMES_TOP + (slot / MPG_GAMES_COLS) * (MPG_GAMES_TILE_H + MPG_GAMES_GAP);
+    *y = MPG_GAMES_TOP + (slot / MPG_GAMES_COLS) * (MPG_GAMES_TILE_H + MPG_GAMES_COL_GAP);
 }
 /* The first game on the page after `offset` when More is tapped (it wraps to the first page). */
 static inline int mpg_games_next_offset(int offset, int total)
