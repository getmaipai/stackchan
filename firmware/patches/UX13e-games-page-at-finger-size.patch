         const char* gt = s_host->game_title(i);
-        const bool long_name = text_w(gt, kBig) > w - 12;  // "Rock Paper Scissors": two small lines and no best line, nothing is cut
-        const lv_font_t* nf = long_name ? kSmall : (text_w(gt, kBig) <= w - 12 ? kBig : kSmall);  // one size for the names that fit
+        const bool long_name = text_w(gt, kBig) > w - 8;  // "Rock Paper Scissors": two 16 px lines and the best line under them, nothing is cut
