-            lv_obj_center(name);
-        } else {
-            lv_label_set_long_mode(name, LV_LABEL_LONG_DOT);
-            lv_obj_set_size(name, w - 12, lv_font_get_line_height(nf));
-            lv_obj_align(name, LV_ALIGN_TOP_MID, 0, 2);
-            char best[24];
-            mpg_best_text(best, sizeof(best), s_host->game_best(i), es());
-            lv_obj_t* bl = text(b, best, kSmall, fg(70));
-            lv_obj_set_width(bl, w - 12);
-            lv_obj_set_style_text_align(bl, LV_TEXT_ALIGN_CENTER, 0);
-            lv_obj_align(bl, LV_ALIGN_BOTTOM_MID, 0, -2);
-        }
+        lv_obj_set_width(name, w - 16);
