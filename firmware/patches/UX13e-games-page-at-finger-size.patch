+/* Patch UX13e: the games page at finger size, as a scrolling grid instead of More paging. Two columns of 148 by 64 px tiles with an 8 px gap and an 8 px margin (the screen standard,
+ * docs/design/screen-style.md), as many rows as there are games; the area shows two rows exactly (10 to 146, above the page dots) and a scroll bar on the right tells that the list goes on; a finger scrolls it.
+ * A tile is the name (20 px) over its best score (16 px); a long name wraps in 16 px and keeps the best line. */
+#define MPG_GSCROLL_COLS 2
+#define MPG_GSCROLL_TILE_W 148
+#define MPG_GSCROLL_TILE_H 64
+#define MPG_GSCROLL_GAP 8
+#define MPG_GSCROLL_MARGIN 8
+static inline void mpg_gscroll_tile(int i, int* x, int* y, int* w, int* h)
+{
+    *w = MPG_GSCROLL_TILE_W;
+    *h = MPG_GSCROLL_TILE_H;
+    *x = MPG_GSCROLL_MARGIN + (i % MPG_GSCROLL_COLS) * (MPG_GSCROLL_TILE_W + MPG_GSCROLL_GAP);
+    *y = (i / MPG_GSCROLL_COLS) * (MPG_GSCROLL_TILE_H + MPG_GSCROLL_GAP);   /* inside the scrolling area */
+}
+static inline int mpg_gscroll_content_h(int total)
+{
+    const int rows = (total + MPG_GSCROLL_COLS - 1) / MPG_GSCROLL_COLS;
+    return rows < 1 ? 0 : rows * (MPG_GSCROLL_TILE_H + MPG_GSCROLL_GAP) - MPG_GSCROLL_GAP;
+}
