+// ---- patch UI06: the sleeping look snores and now and then drools ----
+// Sleeping: the mouth opens and closes slowly (a snore) with a small puff that rises and fades, and now and then a drool drop slides
+// down from the corner of the mouth. One 120 ms timer while the look is on; nothing exists otherwise. The sleepy look has none of this
+// (it nods off instead, maipai_look_core.h) and no floating z letters either; those belong to sleeping only (maipai_fx.cc).
+namespace {
+lv_timer_t* s_snore_timer = nullptr;
+lv_obj_t* s_snore_puff    = nullptr;
+lv_obj_t* s_snore_drool   = nullptr;
+uint32_t s_snore_t0       = 0;
+uint32_t s_drool_at       = 0;  // 0: none running; else when the drop began
+uint32_t s_drool_next     = 0;
+uint32_t s_snore_rng      = 0x2545F491u;
+constexpr int kSnoreMs = 3400;
+constexpr int kMouthX = 160, kMouthY = 160;  // the mouth of the faces, in screen pixels
+
+void snore_stop()
+{
+    if (s_snore_timer != nullptr) {
+        lv_timer_delete(s_snore_timer);
+        s_snore_timer = nullptr;
+        if (s_snore_puff != nullptr) {
+            lv_obj_delete(s_snore_puff);
+            s_snore_puff = nullptr;
+        }
+        if (s_snore_drool != nullptr) {
+            lv_obj_delete(s_snore_drool);
+            s_snore_drool = nullptr;
+        }
+        if (GetStackChan().hasAvatar()) {
+            GetStackChan().avatar().mouth().setWeight(0);
+        }
+    }
+}
+
+void snore_tick(lv_timer_t*)
+{
+    if (!GetStackChan().hasAvatar()) {
+        return;
+    }
+    const uint32_t now = lv_tick_get();
+    const uint32_t ph  = (now - s_snore_t0) % kSnoreMs;
+    // in 1100 ms, held 300, out 1300, rest 700
+    float w = 0.0f, puff = 0.0f;
+    if (ph < 1100) {
+        w = 30.0f * (ph / 1100.0f);
+    } else if (ph < 1400) {
+        w = 30.0f;
+    } else if (ph < 2700) {
+        const float k = (ph - 1400) / 1300.0f;
+        w             = 30.0f * (1.0f - k);
+        puff          = k;
+    }
+    GetStackChan().avatar().mouth().setWeight(static_cast<int>(w));
+    if (maipai_pages_open()) {
+        puff = 0.0f;
+        s_drool_at   = 0;
+        s_drool_next = now + 1000;
+        if (s_snore_drool != nullptr) lv_obj_add_flag(s_snore_drool, LV_OBJ_FLAG_HIDDEN);
+    }
+    if (s_snore_puff != nullptr) {
+        if (puff > 0.0f) {
+            lv_obj_remove_flag(s_snore_puff, LV_OBJ_FLAG_HIDDEN);
+            lv_obj_set_pos(s_snore_puff, kMouthX + 34 + static_cast<int>(10 * puff), kMouthY - 6 - static_cast<int>(16 * puff));
+            lv_obj_set_style_bg_opa(s_snore_puff, static_cast<lv_opa_t>(200 * (1.0f - puff)), 0);
+        } else {
+            lv_obj_add_flag(s_snore_puff, LV_OBJ_FLAG_HIDDEN);
+        }
+    }
+    if (s_snore_drool != nullptr) {
+        if (s_drool_at == 0 && now >= s_drool_next) {
+            s_drool_at = now | 1u;
+        }
+        if (s_drool_at != 0) {
+            const uint32_t el = now - s_drool_at;
+            if (el < 1600) {
+                lv_obj_remove_flag(s_snore_drool, LV_OBJ_FLAG_HIDDEN);
+                lv_obj_set_pos(s_snore_drool, kMouthX - 30, kMouthY + 10 + static_cast<int>(el * 16 / 1600));
+                lv_obj_set_style_bg_opa(s_snore_drool, static_cast<lv_opa_t>(220 - el * 150 / 1600), 0);
+            } else {
+                lv_obj_add_flag(s_snore_drool, LV_OBJ_FLAG_HIDDEN);
+                s_drool_at = 0;
+                s_snore_rng ^= s_snore_rng << 13; s_snore_rng ^= s_snore_rng >> 17; s_snore_rng ^= s_snore_rng << 5;
+                s_drool_next = now + 6000 + s_snore_rng % 9000;  // now and then, never on a beat
+            }
+        }
+    }
+}
+
+void snore_start()
+{
+    if (s_snore_timer != nullptr || !GetStackChan().hasAvatar()) {
+        return;
+    }
+    lv_obj_t* parent = lv_layer_top();  // above the face; hidden while a page or the sheet covers it (snore_tick)
+    auto dot = [parent](int d) {
+        lv_obj_t* o = lv_obj_create(parent);
+        lv_obj_remove_flag(o, LV_OBJ_FLAG_CLICKABLE);
+        lv_obj_set_size(o, d, d);
+        lv_obj_set_style_radius(o, LV_RADIUS_CIRCLE, 0);
+        lv_obj_set_style_border_width(o, 0, 0);
+        lv_obj_set_style_bg_color(o, lv_color_white(), 0);
+        lv_obj_add_flag(o, LV_OBJ_FLAG_HIDDEN);
+        return o;
+    };
+    s_snore_puff  = dot(10);
+    s_snore_drool = dot(6);
+    s_snore_t0    = lv_tick_get();
+    s_drool_at    = 0;
+    s_drool_next  = s_snore_t0 + 4000;
+    s_snore_timer = lv_timer_create(snore_tick, 120, nullptr);
+}
