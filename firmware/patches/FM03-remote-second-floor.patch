+/* The gate for one tool call (patches TC01 and FM03). Two floors, and the second does not read `source`:
+ *  1. A call marked source "remote" must carry the one-use token from self.remote.action for that kind; with none it passes only
+ *     inside the window a token of the same kind opened. Anything else is refused and logged.
+ *  2. A call with any other source (none, "user", the voice turn) passes when no remote session is on, when the kind is not a
+ *     cued one, or when the host announced no id (an older host). While a session is on, a cued kind needs the session's own host
+ *     id as `token` (the paired host stamps it on every call that is not a controller's) or a valid cue token for that kind.
+ *     A controller that reaches the unit with the source left out carries neither, so it is refused, logged and ignored. */
 static inline mr_reason_t mr_gate_call(mr_t* r, const char* source, const char* kind, uint32_t token, uint32_t now)
 {
-    if (source == NULL || strcmp(source, "remote") != 0) return MR_OK;
+    if (source == NULL || strcmp(source, "remote") != 0) {
+        const int k = mr_kind_by_name(kind);
+        if (k < 0 || !mr_kind_needs_host(k) || !mr_session_on(r, now) || r->host_id == 0) return MR_OK;
+        if (token != 0 && token == r->host_id) return MR_OK;
+        if (token != 0 && mr_gate(r, kind, token, now) == MR_OK) return MR_OK;
+        mr_log(r, now, k, MR_NOT_HOST, NULL, 0);
+        return MR_NOT_HOST;
+    }
     if (token == 0 && mr_grant_open(r, mr_kind_by_name(kind), now)) return MR_OK;
     return mr_gate(r, kind, token, now);
 }
