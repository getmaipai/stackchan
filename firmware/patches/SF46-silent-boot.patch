# Intent: A unit that is muted or in full quiet boots silently, and a saved speaker volume of 0 stays 0 across a boot. The "device ready" tone and the start-up alerts play only when the unit is not muted, not in full quiet and the sound policy allows the sound; the always-on safety cues (camera on, listening) are not affected. Memory cost: none (two inline functions).
# Placement: unit
# Upstream: firmware/xiaozhi-esp32/main/audio/audio_codec.cc (Start: a saved volume of 0 is kept; the stock code raised it to 10) and application.cc (the ready tone and Alert), nested tree, MIT
# Check after a flash: with the unit muted and volume 0, a reboot makes no sound at all (no ready tone, no start-up alert); unmuted at volume 35 the ready tone plays as before; a boot in full quiet is silent from the first sample.
# Kconfig: none

diff --git a/firmware/main/hal/maipai_boottone_core.h b/firmware/main/hal/maipai_boottone_core.h
new file mode 100644
--- /dev/null
+++ b/firmware/main/hal/maipai_boottone_core.h
@@ -0,0 +1,23 @@
+/*
+ * SPDX-License-Identifier: MIT
+ *
+ * Start-up sound rules (patch SF46). Plain C99; host test host/tests/firmware/boottone_core_test.c.
+ *   mbt_boot_volume    the speaker volume after a boot: a saved volume of 0 stays 0 (silent is a choice); only a missing or invalid saved value takes the fallback.
+ *   mbt_tone_allowed   whether a start-up tone (the "device ready" tone and the start-up alerts) may play: never while muted or in full quiet, and only if the
+ *                      sound policy (sounds off, night hours) lets it. The always-on safety cues (camera on, listening) do not use this rule.
+ */
+#ifndef MAIPAI_BOOTTONE_CORE_H
+#define MAIPAI_BOOTTONE_CORE_H
+
+#define MBT_VOLUME_MAX 100
+
+/* saved: the saved volume, or a negative number when none is saved. fallback: the default volume (the stock value is 10). */
+static inline int mbt_boot_volume(int saved, int fallback)
+{
+    if (saved < 0) return fallback < 0 ? 0 : (fallback > MBT_VOLUME_MAX ? MBT_VOLUME_MAX : fallback);
+    return saved > MBT_VOLUME_MAX ? MBT_VOLUME_MAX : saved;
+}
+
+static inline int mbt_tone_allowed(int muted, int quiet, int policy_ok) { return !muted && !quiet && policy_ok; }
+
+#endif /* MAIPAI_BOOTTONE_CORE_H */
diff --git a/firmware/xiaozhi-esp32/main/audio/audio_codec.cc b/firmware/xiaozhi-esp32/main/audio/audio_codec.cc
--- a/firmware/xiaozhi-esp32/main/audio/audio_codec.cc
