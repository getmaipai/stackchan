@@ -1,4 +1,5 @@
 #include "audio_codec.h"
+#include <hal/maipai_boottone_core.h>
 #include "board.h"
 #include "settings.h"
 
@@ -28,11 +29,8 @@ bool AudioCodec::InputData(std::vector<int16_t>& data) {
 
 void AudioCodec::Start() {
     Settings settings("audio", false);
-    output_volume_ = settings.GetInt("output_volume", output_volume_);
-    if (output_volume_ <= 0) {
-        ESP_LOGW(TAG, "Output volume value (%d) is too small, setting to default (10)", output_volume_);
-        output_volume_ = 10;
-    }
+    // Patch SF46: a saved volume of 0 stays 0 across a boot (silent is a choice); only a missing value takes the default.
+    output_volume_ = mbt_boot_volume(settings.GetInt("output_volume", -1), 10);
 
     ESP_LOGI(TAG, "Audio codec started");
 }
