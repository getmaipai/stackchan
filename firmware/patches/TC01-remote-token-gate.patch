+static mr_reason_t s_last_refusal = MR_OK;
+
+bool maipai_remote_gate(const char* kind, const char* source, int token)
+{
+    if (source == nullptr || strcmp(source, "remote") != 0) return true;  // local and person-asked calls are unchanged
+    mr_reason_t r = MR_NO_SESSION;
+    if (s_r != nullptr) {
+        std::lock_guard<std::mutex> lock(s_mu);
+        r = mr_gate_call(s_r, source, kind, static_cast<uint32_t>(token), ms_now());
+    }
+    if (r == MR_OK) return true;
+    s_last_refusal = r;
+    ESP_LOGW(TAG, "remote %s ignored: %s", kind, MR_REASONS[r]);
+    return false;
+}
+
+const char* maipai_remote_refusal()
+{
+    static char out[64];
+    snprintf(out, sizeof(out), "{\"ok\":false,\"reason\":\"%s\"}", MR_REASONS[s_last_refusal]);
+    return out;
+}
+
