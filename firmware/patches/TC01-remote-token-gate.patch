+/* The banner time (seconds, 1 to 30) of the cue just answered: how long its kind stays open after the token is used. */
+static inline void mr_set_window(mr_t* r, int seconds)
+{
+    if (seconds < 1) seconds = 1;
+    if (seconds > 30) seconds = 30;
+    r->window_ms = (uint32_t)seconds * 1000u;
+}
+
 /* The gate every remote-origin action calls first. Token 0 is "none". On MR_OK the token is used up. A refusal is logged. */
 static inline mr_reason_t mr_gate(mr_t* r, const char* kind, uint32_t token, uint32_t now)
 {
@@ -166,9 +182,30 @@ static inline mr_reason_t mr_gate(mr_t* r, const char* kind, uint32_t token, uin
     else if (!mr_session_on(r, now)) why = MR_NO_SESSION;
     if (why != MR_OK) { mr_log(r, now, k, why, NULL, 0); return why; }
     r->token = 0;
+    r->grant_on[k] = 1;
+    r->grant_until[k] = now + r->window_ms;
     return MR_OK;
 }
 
+/* 1 while the kind is open: a token passed the gate for it and the banner time has not run out (and the session is on). */
+static inline int mr_grant_open(mr_t* r, int k, uint32_t now)
+{
+    if (k < 0 || k >= MR_KIND_COUNT || !r->grant_on[k]) return 0;
+    if ((int32_t)(now - r->grant_until[k]) >= 0) { r->grant_on[k] = 0; return 0; }
+    return mr_session_on(r, now);
+}
+
+/* The gate for one tool call (patch TC01). A call whose source is not "remote" (no source, "user", the unit's own) is
+ * local and always passes, nothing logged. A call marked "remote" must carry the one-use token from self.remote.action for
+ * that kind; a call with no token passes only inside the window a token of the same kind opened. Anything else is
+ * refused, logged, and the caller does nothing. */
+static inline mr_reason_t mr_gate_call(mr_t* r, const char* source, const char* kind, uint32_t token, uint32_t now)
+{
+    if (source == NULL || strcmp(source, "remote") != 0) return MR_OK;
+    if (token == 0 && mr_grant_open(r, mr_kind_by_name(kind), now)) return MR_OK;
+    return mr_gate(r, kind, token, now);
+}
+
