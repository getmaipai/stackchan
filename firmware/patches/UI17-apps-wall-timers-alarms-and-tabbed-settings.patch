+int auto_now() { return S != nullptr && S->sh_auto >= 0 ? S->sh_auto : g_host->auto_lock_minutes(); }
+bool night_on() { return S != nullptr && S->sh_night >= 0 ? S->sh_night != 0 : g_host->night_dim(); }
