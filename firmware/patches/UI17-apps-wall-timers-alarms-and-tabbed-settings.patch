+    }
+    int x, y, w, h;
+    mac_pick_cancel_box(&x, &y, &w, &h);
+    lv_obj_t* c = button(S->root, x, Y(y), w, h, tx(MAC_S_CANCEL), kMid);
+    lv_obj_add_event_cb(c, on_pick_cancel, LV_EVENT_CLICKED, nullptr);
+    mac_pick_save_box(&x, &y, &w, &h);
+    lv_obj_t* sv = button(S->root, x, Y(y), w, h, tx(MAC_S_SAVE), kMid, true);
+    lv_obj_add_event_cb(sv, on_pick_save, LV_EVENT_CLICKED, nullptr);
+    pick_paint();
+}
