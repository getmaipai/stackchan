+        lv_obj_add_event_cb(dn, on_step, LV_EVENT_LONG_PRESSED_REPEAT, reinterpret_cast<void*>(static_cast<intptr_t>(col == 0 ? -1 : -2)));
+    }
+    // the colon between the two number columns
+    int cx, cy, cw, ch;
+    mac_pick_val_box(0, c24 ? 1 : 0, &cx, &cy, &cw, &ch);
+    lv_obj_t* colon = text(S->root, ":", kBig, fg(100));
+    lv_obj_set_pos(colon, c24 ? 150 : 105, Y(cy) + 10);
+    S->ampm[0] = S->ampm[1] = nullptr;
