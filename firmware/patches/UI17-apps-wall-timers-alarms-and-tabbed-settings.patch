+
+// The text of an information row (and the value text of a switch or a choice).
+void row_text(int id, char* out, size_t n)
+{
+    out[0] = '\0';
+    switch (id) {
+        case MAC_R_NIGHT: snprintf(out, n, "%s", night_on() ? tx(MAC_S_ON) : tx(MAC_S_OFF)); break;
+        case MAC_R_STATUS_ICONS: snprintf(out, n, "%s", icons_on() ? tx(MAC_S_ON) : tx(MAC_S_OFF)); break;
+        case MAC_R_AUTOLOCK: mac_auto_text(out, n, auto_now(), es() ? 1 : 0); break;
+        case MAC_R_LANGUAGE: snprintf(out, n, "%s", lang_name(g_host->language())); break;
+        case MAC_R_SSID: {
+            const char* s = g_host->wifi_ssid();
+            snprintf(out, n, "%s", s != nullptr && s[0] != '\0' ? s : tx(MAC_S_NOT_CONNECTED));
+            break;
+        }
+        case MAC_R_SIGNAL: {
+            const int bars = g_host->wifi_bars();
+            const int w    = mac_signal_word(bars);
+            if (bars < 0) {
+                snprintf(out, n, "%s", tx(MAC_S_NOT_CONNECTED));
+            } else {
+                snprintf(out, n, "%s (%d/4)", tx(MAC_S_SIG_NONE + w), bars);
+            }
+            break;
+        }
+        case MAC_R_TAILNET: {
+            const int t = g_host->tailnet();
+            snprintf(out, n, "%s", t == 2 ? tx(MAC_S_TN_UP) : (t == 1 ? tx(MAC_S_TN_JOIN) : (t == 0 ? tx(MAC_S_TN_OFF) : tx(MAC_S_TN_NO))));
+            break;
+        }
+        case MAC_R_HUB: {
+            const char* a = g_host->address();
+            if (a != nullptr && a[0] != '\0') {
+                const char* sp = strchr(a, ' ');
+                snprintf(out, n, "%s", sp != nullptr && strchr(a, ':') != nullptr && strchr(a, ':') < sp ? sp + 1 : a);  // the line comes as "Settings: host:port"
+            } else {
+                snprintf(out, n, "%s", tx(MAC_S_NO_HOST));
+            }
+            break;
+        }
+        case MAC_R_I_HOST: {
+            const char* h = g_host->host_name();
+            snprintf(out, n, "%s", h != nullptr && h[0] != '\0' ? h : tx(MAC_S_NO_HOST));
+            break;
+        }
+        case MAC_R_I_HINT: snprintf(out, n, "%s", tx(MAC_S_TEN_TAPS)); break;
+        default:
+            if (id == MAC_R_I_TAG || id == MAC_R_I_IMAGE || id == MAC_R_I_SLOT || id == MAC_R_I_MEM || (id >= MAC_R_I_DETAIL0 && id <= MAC_R_I_DETAIL5)) {
+                mv_info_t info;
+                memset(&info, 0, sizeof(info));
+                g_host->version_info(&info);
+                if (id == MAC_R_I_TAG) {
+                    mv_tag(info.version, out, n);
+                } else if (id == MAC_R_I_IMAGE) {
+                    snprintf(out, n, "%s", tx(info.image_state == MV_IMG_VALID ? MAC_S_IMG_OK : (info.image_state == MV_IMG_PENDING ? MAC_S_IMG_WAIT : (info.image_state == MV_IMG_USB ? MAC_S_IMG_USB : MAC_S_IMG_UNKNOWN))));
+                } else if (id == MAC_R_I_SLOT) {
+                    snprintf(out, n, "%s", info.slot_known ? info.slot : "?");
+                } else if (id == MAC_R_I_MEM) {
+                    char a[16], b[16];
+                    mv_bytes_word(info.internal_free, a, sizeof(a));
+                    mv_bytes_word(info.internal_min, b, sizeof(b));
+                    snprintf(out, n, es() ? "%s libres, minimo %s" : "%s free, low %s", a, b);
+                } else {
+                    char rows[MV_LINES][MV_LINE];
+                    mv_detail_lines(&info, rows);
+                    snprintf(out, n, "%s", rows[id - MAC_R_I_DETAIL0]);
+                }
+            }
+            break;
+    }
+}
