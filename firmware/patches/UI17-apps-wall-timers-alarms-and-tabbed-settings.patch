+void on_countdown(lv_event_t* e)
+{
+    if (taps_ignored() || !MAC_COUNTDOWN_READY) {
+        return;
+    }
+    (void)e;  // reserved: the later full screen countdown shows the first running timer here
+    g_host->countdown_open(S->ids[0]);
+}
