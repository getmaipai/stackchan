+void on_step(lv_event_t* e)
+{
+    if (S == nullptr || S->view != MAV_COUNT) {
+        return;
+    }
+    // a long press repeats (LV_EVENT_LONG_PRESSED_REPEAT); a plain tap steps once
+    const lv_event_code_t code = lv_event_get_code(e);
+    if (code == LV_EVENT_CLICKED && taps_ignored()) {
+        return;
+    }
+    const int d    = static_cast<int>(reinterpret_cast<intptr_t>(lv_event_get_user_data(e)));  // +-1 hour, +-2 minute
+    if (d == 1 || d == -1) {
+        mac_pick_hour(&S->pick, d);
+    } else {
+        mac_pick_minute(&S->pick, d > 0 ? 1 : -1);
+    }
+    S->last_touch = now_ms();
+    pick_paint();
+}
+void on_ampm(lv_event_t* e)
+{
+    if (taps_ignored()) {
+        return;
+    }
+    mac_pick_set_pm(&S->pick, static_cast<int>(reinterpret_cast<intptr_t>(lv_event_get_user_data(e))));
+    pick_paint();
+}
+void on_pick_cancel(lv_event_t*)
+{
+    if (!taps_ignored()) {
+        request_view(MAV_ALARMS);
+    }
+}
+void on_pick_save(lv_event_t*)
+{
+    if (taps_ignored()) {
+        return;
+    }
+    const char* why = g_host->app_alarm_add(S->pick.hour, S->pick.minute);
+    if (why != nullptr && why[0] != '\0') {
+        toast(why);
+        return;
+    }
+    request_view(MAV_ALARMS);
+}
