+void repaint_row(int idx);
+
+void on_row(lv_event_t* e)
+{
+    if (taps_ignored()) {
+        return;
+    }
+    const intptr_t u = reinterpret_cast<intptr_t>(lv_event_get_user_data(e));
+    const int id = static_cast<int>(u & 0xFF), sub = static_cast<int>(u >> 8);
+    int idx = -1;
+    for (int i = 0; i < S->n_set_rows; i++) {
+        if (S->rows[i].id == id) idx = i;
+    }
+    switch (id) {
+        case MAC_R_NIGHT: S->sh_night = night_on() ? 0 : 1; g_host->set_night_dim(S->sh_night != 0); break;
+        case MAC_R_STATUS_ICONS: S->sh_icons = icons_on() ? 0 : 1; g_host->set_status_icons(S->sh_icons != 0); break;
+        case MAC_R_AUTOLOCK:
+            if (!g_host->lock_has_code()) {
+                toast(tx(MAC_S_LOCK_HINT));
+                return;
+            }
+            S->sh_auto = mac_auto_next(auto_now());
+            g_host->set_auto_lock(S->sh_auto);
+            break;
+        case MAC_R_LOCK_NOW:
+            if (!g_host->lock_has_code()) {
+                toast(tx(MAC_S_LOCK_HINT));
+            } else {
+                close_all();
+                g_host->lock_now();
+            }
+            return;
+        case MAC_R_WIFI_PAGE:
+            close_all();
+            g_host->open_wifi();  // the Wi-Fi page: only Wi-Fi content
+            return;
+        case MAC_R_MORE:
+            close_all();
+            g_host->open_more();  // the More screens: time zone, network test, version
+            return;
+        case MAC_R_I_TAG:
+            if (mv_tap(&S->ver, now_ms())) {
+                S->details = true;
+                request_view(MAV_SETTINGS);
+            }
+            return;
+        case MAC_R_PAIR0: case MAC_R_PAIR1: case MAC_R_PAIR2: {
+            const int tile = (id - MAC_R_PAIR0) * 2 + sub;
+            if (tile >= MPG_SET_STYLES) {  // the picture faces: shown on the pictures page
+                close_all();
+                g_host->open_strip_page(MPG_P_FRAME);
+                return;
+            }
+            S->cur_style = MPG_SET_STYLE_ID[tile];
+            g_host->set_face_style(S->cur_style);
+            request_view(MAV_SETTINGS);  // the preview and the filled tile follow
+            return;
+        }
+        default: return;
+    }
+    if (idx >= 0) {
+        repaint_row(idx);
+    }
+}
+
+void on_tab(lv_event_t* e)
+{
+    if (taps_ignored()) {
+        return;
+    }
+    const int tab = static_cast<int>(reinterpret_cast<intptr_t>(lv_event_get_user_data(e)));
+    if (mac_set_tab(&S->set, tab)) {
+        request_view(MAV_SETTINGS);
+    }
+}
+void on_done(lv_event_t*)
+{
+    if (!taps_ignored()) {
+        close_all();
+    }
+}
+
+void on_pane_scroll(lv_event_t*)
+{
+    if (S == nullptr || S->pane == nullptr || S->thumb == nullptr) {
+        return;
+    }
+    int by, bh;
+    if (mac_scroll_bar(S->content_h, MAC_PANE_H, lv_obj_get_scroll_y(S->pane), &by, &bh)) {
+        lv_obj_set_height(S->thumb, bh);
+        lv_obj_set_y(S->thumb, by);
+    }
+}
+
+// The value text and fill of a switch, a choice or an information row.
+void repaint_row(int i)
+{
+    const mac_row_t& r = S->rows[i];
+    char t[96];
+    row_text(r.id, t, sizeof(t));
+    if (r.kind == MAC_K_SWITCH) {
+        const bool on = r.id == MAC_R_NIGHT ? night_on() : icons_on();
+        lv_obj_set_style_bg_color(S->row_obj[i], on ? fg(100) : fg(16), 0);
+        lv_obj_set_style_text_color(S->row_val[r.id], on ? lv_color_black() : fg(100), 0);
+        lv_obj_t* lab = lv_obj_get_child(S->row_obj[i], 0);
+        if (lab != nullptr) {
+            lv_obj_set_style_text_color(lab, on ? lv_color_black() : fg(100), 0);
+        }
+    }
+    set_text_if(S->row_val[r.id], t);
+    if (r.kind == MAC_K_CHOICE || r.kind == MAC_K_SWITCH) {
+        lv_obj_align(S->row_val[r.id], LV_ALIGN_RIGHT_MID, -12, 0);
+    }
+}
+
+void build_slider_row(lv_obj_t* parent, const mac_row_t& r, int i)
+{
+    lv_obj_t* c = lv_obj_create(parent);
+    lv_obj_remove_style_all(c);
+    lv_obj_remove_flag(c, LV_OBJ_FLAG_SCROLLABLE);
+    lv_obj_add_flag(c, LV_OBJ_FLAG_EVENT_BUBBLE);
+    lv_obj_set_pos(c, 0, r.y);
+    lv_obj_set_size(c, MAC_PANE_ROW_W, r.h);
+    S->row_obj[i] = c;
+    const bool vol = r.id == MAC_R_VOLUME;
+    const int v    = vol ? g_host->volume() : g_host->brightness();
+    char t[40];
+    snprintf(t, sizeof(t), "%s  %d", tx(vol ? MAC_S_VOLUME : MAC_S_BRIGHT), v);
+    S->row_val[r.id] = text(c, t, kSmall, fg(90));
+    lv_obj_set_pos(S->row_val[r.id], 4, 0);
+    lv_obj_t* sl = lv_slider_create(c);
+    lv_obj_set_size(sl, MAC_PANE_ROW_W - 28, 16);
+    lv_obj_set_pos(sl, 14, MAC_SLIDER_Y);
+    lv_obj_set_ext_click_area(sl, 14);  // with the label's row the grab area is 44 px high
+    lv_slider_set_range(sl, vol ? 20 : 10, 100);
+    lv_slider_set_value(sl, v, LV_ANIM_OFF);
+    const lv_part_t parts[3] = {LV_PART_MAIN, LV_PART_INDICATOR, LV_PART_KNOB};
+    for (lv_part_t part : parts) {
+        lv_obj_set_style_bg_opa(sl, LV_OPA_COVER, part);
+        lv_obj_set_style_border_width(sl, 0, part);
+        lv_obj_set_style_shadow_width(sl, 0, part);
+        lv_obj_set_style_outline_width(sl, 0, part);
+        lv_obj_set_style_bg_color(sl, part == LV_PART_MAIN ? fg(30) : fg(100), part);
+    }
+    lv_obj_set_style_radius(sl, 8, LV_PART_MAIN);
+    lv_obj_set_style_radius(sl, 8, LV_PART_INDICATOR);
+    lv_obj_set_style_radius(sl, LV_RADIUS_CIRCLE, LV_PART_KNOB);
+    lv_obj_set_style_pad_all(sl, 8, LV_PART_KNOB);
+    lv_obj_add_event_cb(sl, on_slider, LV_EVENT_VALUE_CHANGED, reinterpret_cast<void*>(static_cast<intptr_t>(r.id)));
+    lv_obj_add_event_cb(sl, on_slider_up, LV_EVENT_RELEASED, nullptr);
+    lv_obj_add_event_cb(sl, on_slider_up, LV_EVENT_PRESS_LOST, nullptr);
+}
+
+// The face preview in the pane header (Faces tab): the chosen style's schematic face, scaled to fit beside the title.
+void build_header_preview()
+{
+    const int bx = MAC_PANE_X + 70, bw = 54, bh = 44;
+    lv_obj_t* p = box(S->root, bx, Y(MAC_PANE_HEAD_Y), bw, bh, fg(8), 8);
+    lv_obj_set_style_border_width(p, 1, 0);
+    lv_obj_set_style_border_color(p, fg(40), 0);
+    mpg_pshape_t sh[MPG_PSHAPES_MAX];
+    const int n = mpg_set_preview_shapes(S->cur_style, sh);
+    for (int k = 0; k < n; k++) {  // the schematic is drawn in 112 by 90; here at 45 percent (50 by 40)
+        const int w = sh[k].w * 9 / 20 < 3 ? 3 : sh[k].w * 9 / 20, h = sh[k].h * 9 / 20 < 3 ? 3 : sh[k].h * 9 / 20;
+        box(p, 2 + sh[k].x * 9 / 20, 2 + sh[k].y * 9 / 20, w, h, fg(100), sh[k].r * 9 / 20);
+    }
+}
+
+void build_pair_row(lv_obj_t* parent, const mac_row_t& r, int i)
+{
+    const bool pics = g_host->pictures_held();
+    const int pair  = r.id - MAC_R_PAIR0;
+    const int cnt   = mac_pair_tiles(pair, pics ? 1 : 0);
+    lv_obj_t* c     = lv_obj_create(parent);
+    lv_obj_remove_style_all(c);
+    lv_obj_remove_flag(c, LV_OBJ_FLAG_SCROLLABLE);
+    lv_obj_remove_flag(c, LV_OBJ_FLAG_CLICKABLE);
+    lv_obj_add_flag(c, LV_OBJ_FLAG_EVENT_BUBBLE);
+    lv_obj_set_pos(c, 0, r.y);
+    lv_obj_set_size(c, MAC_PANE_ROW_W, 44);
+    S->row_obj[i] = c;
+    for (int k = 0; k < cnt; k++) {
+        const int tile = pair * 2 + k;
+        const bool on  = tile < MPG_SET_STYLES && MPG_SET_STYLE_ID[tile] == S->cur_style;
+        const char* nm = tile < MPG_SET_STYLES ? MPG_SET_STYLE_NAME[es() ? 1 : 0][tile] : tx(MAC_S_PICTURES);
+        lv_obj_t* b = button(c, k * 110, 0, 106, 44, nm, fit_font(nm, 94) == kMid ? kSmall : fit_font(nm, 94), on);
+        lv_obj_add_event_cb(b, on_row, LV_EVENT_CLICKED, reinterpret_cast<void*>(static_cast<intptr_t>(r.id | (k << 8))));
+    }
+}
+
+void build_line_row(lv_obj_t* parent, const mac_row_t& r, int i)
+{
+    const bool clickable = r.kind == MAC_K_SWITCH || r.kind == MAC_K_CHOICE || r.kind == MAC_K_BUTTON || r.id == MAC_R_I_TAG;
+    lv_obj_t* b = box(parent, 0, r.y, MAC_PANE_ROW_W, 44, fg(clickable ? 16 : 8), 10, clickable);
+    lv_obj_set_style_border_width(b, 1, 0);
+    lv_obj_set_style_border_color(b, fg(clickable ? 40 : 24), 0);
+    if (clickable) {
+        lv_obj_set_style_bg_color(b, fg(45), LV_STATE_PRESSED);
+        lv_obj_add_event_cb(b, on_row, LV_EVENT_CLICKED, reinterpret_cast<void*>(static_cast<intptr_t>(r.id)));
+    }
+    S->row_obj[i] = b;
+    char t[96];
+    row_text(r.id, t, sizeof(t));
+    if (r.kind == MAC_K_BUTTON) {
+        lv_obj_t* l = text(b, mac_row_label(r.id, es() ? 1 : 0), kSmall, fg(100));
+        lv_obj_center(l);
+        return;
+    }
+    if (r.kind == MAC_K_SWITCH || r.kind == MAC_K_CHOICE) {
+        const bool on = r.kind == MAC_K_SWITCH && (r.id == MAC_R_NIGHT ? night_on() : icons_on());
+        if (on) {
+            lv_obj_set_style_bg_color(b, fg(100), 0);
+        }
+        lv_obj_t* l = text(b, mac_row_label(r.id, es() ? 1 : 0), kSmall, on ? lv_color_black() : fg(100));
+        lv_obj_align(l, LV_ALIGN_LEFT_MID, 12, 0);
+        S->row_val[r.id] = text(b, t, kSmall, on ? lv_color_black() : fg(100));
+        lv_obj_align(S->row_val[r.id], LV_ALIGN_RIGHT_MID, -12, 0);
+        return;
+    }
+    // an information row: the name small on top, the value under it
+    const bool detail = r.id >= MAC_R_I_DETAIL0 && r.id <= MAC_R_I_DETAIL5;
+    const char* label = mac_row_label(r.id, es() ? 1 : 0);
+    if (label[0] != '\0') {
+        lv_obj_t* l = text(b, label, kTiny, fg(60));
+        lv_obj_set_pos(l, 10, 2);
+    }
+    const lv_font_t* vf = detail || r.id == MAC_R_I_HINT ? kTiny : kSmall;
+    lv_obj_t* v = text(b, t, vf, fg(100));
+    lv_label_set_long_mode(v, r.id == MAC_R_I_HINT ? LV_LABEL_LONG_WRAP : LV_LABEL_LONG_DOT);
+    if (r.id == MAC_R_I_HINT) {
+        lv_obj_set_width(v, MAC_PANE_ROW_W - 20);
+    } else {
+        lv_obj_set_size(v, MAC_PANE_ROW_W - 20, lv_font_get_line_height(vf));
+    }
+    if (r.id == MAC_R_I_HINT) {
+        lv_obj_align(v, LV_ALIGN_LEFT_MID, 10, 0);
+    } else {
+        lv_obj_set_pos(v, 10, detail ? 14 : 18);
+    }
+    S->row_val[r.id] = v;
+}
+
+void build_settings()
+{
+    S->cur_style = g_host->face_style();
+    // the tab column
+    for (int t = 0; t < MAC_TAB_COUNT; t++) {
+        int x, y, w, h;
+        mac_tab_box(t, &x, &y, &w, &h);
+        const bool on = t == S->set.tab;
+        const char* nm = MAC_TAB_TITLE[es() ? 1 : 0][t];
+        lv_obj_t* b = button(S->root, x, Y(y), w, h, nm, fit_font(nm, w - 8) == kMid ? kSmall : fit_font(nm, w - 8), on);
+        lv_obj_add_event_cb(b, on_tab, LV_EVENT_CLICKED, reinterpret_cast<void*>(static_cast<intptr_t>(t)));
+    }
+    box(S->root, MAC_DIV_X, Y(MAC_TAB_Y0), 1, MAC_BOTTOM - MAC_TAB_Y0 - 4, fg(30), 0);
+    // the pane header: the tab's name and the Done target
+    lv_obj_t* title = text(S->root, MAC_TAB_TITLE[es() ? 1 : 0][S->set.tab], kMid, fg(100));
+    lv_obj_set_pos(title, MAC_PANE_X + 4, Y(MAC_PANE_HEAD_Y) + 10);
+    if (S->set.tab == MAC_TAB_FACES) {
+        build_header_preview();
+    }
+    int dx, dy, dw, dh;
+    mac_done_box(&dx, &dy, &dw, &dh);
+    lv_obj_t* done = button(S->root, dx, Y(dy), dw, dh, tx(MAC_S_DONE), kMid);
+    lv_obj_add_event_cb(done, on_done, LV_EVENT_CLICKED, nullptr);
+    // the list on the right: a vertical scroll area
+    S->n_set_rows = mac_set_rows(S->set.tab, set_flags(), S->rows);
+    lv_obj_t* pane = lv_obj_create(S->root);
+    lv_obj_remove_style_all(pane);
+    lv_obj_set_pos(pane, MAC_PANE_X, Y(MAC_PANE_Y));
+    lv_obj_set_size(pane, MAC_PANE_W, MAC_PANE_H);
+    lv_obj_add_flag(pane, LV_OBJ_FLAG_CLICKABLE);
+    lv_obj_add_flag(pane, LV_OBJ_FLAG_EVENT_BUBBLE);
+    lv_obj_add_flag(pane, LV_OBJ_FLAG_SCROLLABLE);
+    lv_obj_set_scroll_dir(pane, LV_DIR_VER);
+    lv_obj_set_scrollbar_mode(pane, LV_SCROLLBAR_MODE_OFF);
+    lv_obj_remove_flag(pane, LV_OBJ_FLAG_SCROLL_ELASTIC);
+    S->pane = pane;
+    S->pane_tab = S->set.tab;
+    int content = 0;
+    for (int i = 0; i < S->n_set_rows; i++) {
+        const mac_row_t& r = S->rows[i];
+        switch (r.kind) {
+            case MAC_K_SLIDER: build_slider_row(pane, r, i); break;
+            case MAC_K_PAIR: build_pair_row(pane, r, i); break;
+            default: build_line_row(pane, r, i); break;
+        }
+        const int bottom = r.y + row_height_box(r);
+        content = bottom > content ? bottom : content;
+    }
+    S->content_h = content;
+    // the scroll indicator: a thin track at the right edge with a bar that follows the list
+    S->thumb = nullptr;
+    int by, bh;
+    if (mac_scroll_bar(content, MAC_PANE_H, 0, &by, &bh)) {
+        lv_obj_t* track = box(S->root, MAC_PANE_X + MAC_PANE_W - 6, Y(MAC_PANE_Y), 4, MAC_PANE_H, fg(14), 2);
+        S->thumb        = box(track, 0, by, 4, bh, fg(75), 2);
+        lv_obj_add_event_cb(pane, on_pane_scroll, LV_EVENT_SCROLL, nullptr);
+    }
+    if (S->set.scroll[S->set.tab] != 0) {
+        lv_obj_scroll_to_y(pane, mac_scroll_clamp(S->set.scroll[S->set.tab], content, MAC_PANE_H), LV_ANIM_OFF);
+        on_pane_scroll(nullptr);
+    }
+}
+
+// ---- views ----
+void build(int view)
+{
+    if (S == nullptr || S->root == nullptr) {
+        return;
+    }
+    if (view == MAV_COUNT) {
+        // the time picker is a view of the Alarms screen
+    }
+    if (S->pane != nullptr && S->view == MAV_SETTINGS) {  // a tab keeps where it was scrolled to
+        S->set.scroll[S->pane_tab] = static_cast<int16_t>(lv_obj_get_scroll_y(S->pane));
+    }
+    lv_obj_clean(S->root);
+    S->toast = nullptr;
+    S->list  = nullptr;
+    S->pane  = nullptr;
+    S->thumb = nullptr;
+    S->n_rows = 0;
+    S->view  = view;
+    switch (view) {
+        case MAV_APPS:
+        case MAV_GAMES: build_wall(view); break;
+        case MAV_TIMERS: build_timers(); break;
+        case MAV_ALARMS: build_alarms(); break;
+        case MAV_COUNT: build_picker(); break;
+        default: build_settings(); break;
+    }
+    S->last_touch = now_ms();
+    grabber();
+}
+
+void refresh()
+{
+    if (S == nullptr) {
+        return;
+    }
+    if (S->view == MAV_TIMERS || S->view == MAV_ALARMS) {
+        const int kind = S->view == MAV_TIMERS ? kKindTimer : kKindAlarm;
+        MaipaiPageTimer t[MAC_ACTIVE_MAX];
+        const int n = g_host->app_items(kind, t, MAC_ACTIVE_MAX);
+        if (items_sig(t, n) != S->sig) {
+            const int keep = S->list != nullptr ? static_cast<int>(lv_obj_get_scroll_y(S->list)) : 0;
+            build(S->view);
+            if (S->list != nullptr && keep > 0) {
+                lv_obj_scroll_to_y(S->list, mac_scroll_clamp(keep, mac_list_content_h(S->n_rows), MAC_LIST_H), LV_ANIM_OFF);
+            }
+            return;
+        }
+        if (S->view == MAV_TIMERS) {
+            for (int i = 0; i < n && i < MAC_ACTIVE_MAX; i++) {
+                char left[24];
+                mac_fmt_left(left, sizeof(left), t[i].left_s);
+                set_text_if(S->left[i], left);
+            }
+        }
+    } else if (S->view == MAV_SETTINGS) {
+        // live rows: the signal, the memory line and the ten-tap details closing by themselves
+        if (S->details && !mv_is_open(&S->ver, now_ms())) {
+            S->details = false;
+            build(MAV_SETTINGS);
+            return;
+        }
+        for (int i = 0; i < S->n_set_rows; i++) {
+            const int id = S->rows[i].id;
+            if (id == MAC_R_SIGNAL || id == MAC_R_SSID || id == MAC_R_TAILNET || id == MAC_R_I_MEM) {
+                char t[96];
+                row_text(id, t, sizeof(t));
+                set_text_if(S->row_val[id], t);
+            }
+        }
+    }
+}
+
+void tick(lv_timer_t*) { maipai_apps_step(); }
+lv_timer_t* g_timer = nullptr;
+
+void close_all()
+{
+    if (g_timer != nullptr) {
+        lv_timer_delete(g_timer);
+        g_timer = nullptr;
+    }
+    if (S != nullptr) {
+        const int id = S->id;
+        if (S->root != nullptr) {
+            lv_obj_delete_async(S->root);
+        }
+        delete S;
+        S = nullptr;
+        maipai_screen_closed(id);
+    }
+    g_open_a.store(false);
+    g_set_a.store(false);
+}
+
+}  // namespace
+
+// ================= public =================
+void maipai_apps_attach(MaipaiPagesHost* host, lv_color_t (*fgcb)())
+{
+    g_host = host;
+    g_fg   = fgcb;
+    maipai_screen_register(MSCR_APPS, close_all);
+    maipai_screen_register(MSCR_SETTINGS, close_all);
+    g_ready = true;
+}
+
+bool maipai_apps_open() { return g_open_a.load(); }
+bool maipai_apps_settings_open() { return g_set_a.load(); }
+void maipai_apps_event(int ev)
+{
+    if (g_open_a.load()) {
+        g_pending.store(ev);
+    }
+}
+
+bool maipai_apps_show(int view)
+{
+    if (!g_ready || view < 0 || view >= MAV_COUNT || maipai_lock_locked()) {  // patch LK03: no screen while locked
+        return false;
+    }
+    const int id = view == MAV_SETTINGS ? MSCR_SETTINGS : MSCR_APPS;
+    maipai_screen_open(id);  // one overlay screen at a time: whatever else was up (the other one of these included) closes first
+    if (S != nullptr && S->id != id) {
+        close_all();
+        maipai_screen_open(id);
+    }
+    if (S == nullptr) {
+        S = new (std::nothrow) St();
+        if (S == nullptr) {
+            maipai_screen_closed(id);
+            return false;
+        }
+        mac_set_init(&S->set);
+        mv_init(&S->ver);
+        S->id = id;
+        lv_obj_t* r = box(lv_layer_top(), 0, MAC_TOP, MAC_W, 240 - MAC_TOP, lv_color_black(), 0, true);
+        lv_obj_move_to_index(r, 0);  // under the banner row and the cue strips, which stay where they are
+        lv_obj_add_event_cb(r, on_root, LV_EVENT_PRESSED, nullptr);
+        lv_obj_add_event_cb(r, on_root, LV_EVENT_RELEASED, nullptr);
+        lv_obj_add_event_cb(r, on_root, LV_EVENT_PRESS_LOST, nullptr);
+        S->root       = r;
+        S->night_seen = g_host->night();
+        g_timer       = lv_timer_create(tick, 250, nullptr);
+    }
+    S->page = 0;
+    S->details = false;
+    if (view == MAV_SETTINGS) {
+        mac_set_init(&S->set);  // Settings always opens on General, at the top
+    }
+    g_open_a.store(true);
+    g_set_a.store(view == MAV_SETTINGS);
+    build(view);
+    return true;
+}
+
+void maipai_apps_step()
+{
+    if (S == nullptr) {
+        if (g_timer != nullptr) {
+            lv_timer_delete(g_timer);
+            g_timer = nullptr;
+        }
+        return;
+    }
+    const uint32_t now = now_ms();
+    int ev             = g_pending.exchange(0);
+    if (S->touch.down) {
+        S->last_touch = now;  // no timer runs while a finger is down
+        return;
+    }
+    const uint32_t idle = (S->view == MAV_SETTINGS || S->view == MAV_COUNT) ? kIdleSetMs : kIdleWallMs;
+    if (ev != 0 || g_host->ringing() || g_host->game_running() || now - S->last_touch > idle) {
+        close_all();  // the wake word, speech, a ring, a game or a quiet minute brings the face back
+        return;
+    }
+    if (S->toast != nullptr && now >= S->toast_until) {
+        lv_obj_delete(S->toast);
+        S->toast = nullptr;
+    }
+    const bool night = g_host->night();
+    if (night != S->night_seen) {  // day to night repaints in the dimmer color
+        S->night_seen = night;
+        build(S->view);
+        return;
+    }
+    refresh();
+}
+
+void maipai_apps_close() { close_all(); }
+#endif
