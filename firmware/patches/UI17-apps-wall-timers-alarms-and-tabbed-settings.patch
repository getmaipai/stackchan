+// ---- Timers and Alarms: a list of rows with a big Cancel each ----
+int items_sig(const MaipaiPageTimer* t, int n)
+{
+    int sig = n;
+    for (int i = 0; i < n; i++) {
+        sig = sig * 31 + static_cast<int>(t[i].id) * 7 + t[i].hour * 3 + t[i].minute;
+    }
+    return sig;
+}
+
+void on_cancel(lv_event_t* e)
+{
+    if (taps_ignored()) {
+        return;
+    }
+    g_host->timer_cancel(static_cast<uint32_t>(reinterpret_cast<intptr_t>(lv_event_get_user_data(e))));
+    S->sig = -1;  // the list is rebuilt at the next tick
+}
+
+void on_preset(lv_event_t* e)
+{
+    if (taps_ignored()) {
+        return;
+    }
+    const int mins    = static_cast<int>(reinterpret_cast<intptr_t>(lv_event_get_user_data(e)));
+    const char* why   = g_host->app_timer_add(mins * 60);
+    if (why != nullptr && why[0] != '\0') {
+        toast(why);
+    }
+    S->sig = -1;
+}
