+        const time_t wall = time(nullptr);
+        int n = 0;
+        for (int i = 0; i < total && n < max; i++) {
+            if (v[i].kind != kind) {
+                continue;
+            }
+            MaipaiPageTimer& o = out[n++];
+            memset(&o, 0, sizeof(o));
+            o.id     = v[i].id;
+            o.kind   = v[i].kind;
+            o.left_s = static_cast<int32_t>((v[i].due_ms - now + 500) / 1000);
+            snprintf(o.label, sizeof(o.label), "%s", v[i].label);
+            if (kind == 2) {
+                o.hour = -1;  // the clock is not set yet: the screen shows dashes
+            }
+            if (kind == 2 && wall >= 1704067200) {  // an alarm's time of day: the moment it fires, on the wall clock, in local time
+                struct tm t = {};
+                const time_t at = wall + (o.left_s > 0 ? o.left_s : 0);
+                localtime_r(&at, &t);
+                o.hour   = static_cast<int8_t>(t.tm_hour);
+                o.minute = static_cast<int8_t>(t.tm_min);
+            }
