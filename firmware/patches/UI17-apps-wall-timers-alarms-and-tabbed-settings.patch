+// The time picker: hour and minute steppers (and AM or PM on a 12 hour clock), Cancel and Save.
+void pick_paint()
+{
+    const bool c24 = g_host->clock24();
+    char v[8];
+    snprintf(v, sizeof(v), c24 ? "%02d" : "%d", mac_pick_shown_hour(&S->pick, c24 ? 1 : 0));
+    set_text_if(S->pick_val[0], v);
+    snprintf(v, sizeof(v), "%02d", S->pick.minute);
+    set_text_if(S->pick_val[1], v);
+    if (!c24) {
+        for (int pm = 0; pm < 2; pm++) {
+            const bool on = (mac_pick_is_pm(&S->pick) ? 1 : 0) == pm;
+            if (S->ampm[pm] != nullptr) {
+                lv_obj_set_style_bg_color(S->ampm[pm], on ? fg(100) : fg(16), 0);
+                lv_obj_t* l = lv_obj_get_child(S->ampm[pm], 0);
+                if (l != nullptr) {
+                    lv_obj_set_style_text_color(l, on ? lv_color_black() : fg(100), 0);
+                }
+            }
+        }
+    }
+}
