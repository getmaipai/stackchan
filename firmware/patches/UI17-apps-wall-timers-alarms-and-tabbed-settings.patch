+            mac_pick_ampm_box(pm, &x, &y, &w, &h);
+            lv_obj_t* b = button(S->root, x, Y(y), w, h, tx(pm ? MAC_S_PM : MAC_S_AM), kMid);
+            lv_obj_add_event_cb(b, on_ampm, LV_EVENT_CLICKED, reinterpret_cast<void*>(static_cast<intptr_t>(pm)));
+            S->ampm[pm] = b;
