+        lv_obj_add_event_cb(up, on_step, LV_EVENT_LONG_PRESSED_REPEAT, reinterpret_cast<void*>(static_cast<intptr_t>(col == 0 ? 1 : 2)));
+        mac_pick_val_box(col, c24 ? 1 : 0, &x, &y, &w, &h);
+        lv_obj_t* v = box(S->root, x, Y(y), w, h, fg(8), 10);
+        S->pick_val[col] = text(v, "", kBig, fg(100));
+        lv_obj_center(S->pick_val[col]);
+        mac_pick_minus_box(col, c24 ? 1 : 0, &x, &y, &w, &h);
+        lv_obj_t* dn = button(S->root, x, Y(y), w, h, "-", kBig);
