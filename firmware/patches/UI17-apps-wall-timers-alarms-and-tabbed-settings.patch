+/*
+ * SPDX-License-Identifier: MIT
+ *
+ * The Apps wall, the Timers and Alarms apps and the tabbed Settings screen (patch UI16). See maipai_apps.h and maipai_apps_core.h.
+ * Runs on the LVGL task with the lock held; the only calls from other tasks are maipai_apps_event and the atomic readers.
+ */
+#include <sdkconfig.h>
+#include "maipai_apps.h"
+#if CONFIG_MAIPAI_PAGES || defined(MAIPAI_HOST_RENDER)
+#include <atomic>
+#include <cstdio>
+#include <cstring>
+#include <new>
+#include "maipai_apps_core.h"
+#include "maipai_face_core.h"
+#include "maipai_screens.h"
+#include "maipai_lock.h"
+
+namespace {
+
+MaipaiPagesHost* g_host = nullptr;
+lv_color_t (*g_fg)()    = nullptr;
+bool g_ready            = false;
+std::atomic<bool> g_open_a{false};
+std::atomic<bool> g_set_a{false};
+std::atomic<int> g_pending{0};
+
+constexpr uint32_t kIdleWallMs  = 30000;  // a wall, Timers or Alarms returns to the face after 30 s without a touch
+constexpr uint32_t kIdleSetMs   = 60000;  // Settings and the time picker wait a minute
+constexpr uint32_t kToastMs     = 2500;
+constexpr uint32_t kSliderGapMs = 300;    // patch QS01: taps are ignored this long after a slider is let go
+constexpr int kMaxGames         = 16;
+constexpr int kKindTimer         = 1;  // the timer core's MT_KIND_TIMER and MT_KIND_ALARM (maipai_timers_core.h)
+constexpr int kKindAlarm         = 2;
+
+const lv_font_t* kTiny  = &lv_font_montserrat_14;
+const lv_font_t* kSmall = &lv_font_montserrat_16;
+const lv_font_t* kMid   = &lv_font_montserrat_20;
+const lv_font_t* kBig   = &lv_font_montserrat_24;
+
+// One state record, allocated when a view opens and freed when the screen closes.
+struct St {
+    lv_obj_t* root = nullptr;
+    int id         = MSCR_APPS;  // the screen manager's id for this screen
+    int view       = MAV_APPS;
+    mac_touch_t touch;
+    bool taken          = false;  // the finger made a swipe or began on the drag bar: no tap follows
+    uint32_t last_touch = 0;
+    bool night_seen     = false;
+    // the toast
+    lv_obj_t* toast     = nullptr;
+    uint32_t toast_until = 0;
+    // the walls
+    int page = 0;
+    uint8_t apps[MAC_APP_MAX];
+    int n_items = 0;  // apps or games on the wall
+    lv_obj_t* dots_holder = nullptr;
+    // timers and alarms
+    lv_obj_t* list = nullptr;
+    lv_obj_t* left[MAC_ACTIVE_MAX];
+    uint32_t ids[MAC_ACTIVE_MAX];
+    int n_rows = 0;
+    int sig    = 0;
+    mac_pick_t pick;
+    lv_obj_t* pick_val[2];
+    lv_obj_t* ampm[2];
+    // settings
+    mac_set_t set;
+    mac_row_t rows[MAC_SET_ROWS_MAX];
+    int n_set_rows = 0;
+    lv_obj_t* pane     = nullptr;
+    lv_obj_t* thumb    = nullptr;
+    int pane_tab       = 0;
+    lv_obj_t* row_obj[MAC_SET_ROWS_MAX];
+    lv_obj_t* row_val[MAC_R_COUNT];  // by row id
+    int8_t sh_night = -1, sh_icons = -1;
+    int sh_auto = -1;  // what the person just chose (the saved value follows from the main task a moment later)
+    lv_obj_t* tile_obj[6];
+    int cur_style = 1;
+    int content_h = 0;
+    uint32_t slider_up_ms = 0;
+    mv_state_t ver;
+    bool details = false;
+};
+St* S = nullptr;
+
+bool es() { return g_host != nullptr && g_host->spanish(); }
+const char* tx(int id) { return mac_str(id, es() ? 1 : 0); }
+uint32_t now_ms() { return g_host != nullptr ? g_host->now_ms() : 0; }
+int Y(int y) { return y - MAC_TOP; }  // the root starts at screen y 28
+
+lv_color_t shade(lv_color_t c, int pct) { return lv_color_make(mpg_scale(c.red, pct), mpg_scale(c.green, pct), mpg_scale(c.blue, pct)); }
+int night_pct() { return g_host != nullptr ? mpg_dim_pct(g_host->night()) : 100; }
+lv_color_t fg(int pct = 100)
+{
+    const lv_color_t c = g_fg != nullptr ? g_fg() : lv_color_white();
+    return shade(c, pct * night_pct() / 100);
+}
+
+lv_obj_t* box(lv_obj_t* parent, int x, int y, int w, int h, lv_color_t c, int radius, bool clickable = false)
+{
+    lv_obj_t* o = lv_obj_create(parent);
+    lv_obj_remove_style_all(o);
+    lv_obj_remove_flag(o, LV_OBJ_FLAG_SCROLLABLE);
+    if (clickable) {
+        lv_obj_add_flag(o, LV_OBJ_FLAG_CLICKABLE);
+        lv_obj_add_flag(o, LV_OBJ_FLAG_EVENT_BUBBLE);  // the finger also reaches the root, which classifies swipes and the drag bar
+    } else {
+        lv_obj_remove_flag(o, LV_OBJ_FLAG_CLICKABLE);
+    }
+    lv_obj_set_pos(o, x, y);
+    lv_obj_set_size(o, w, h);
+    lv_obj_set_style_radius(o, radius, 0);
+    lv_obj_set_style_bg_opa(o, LV_OPA_COVER, 0);
+    lv_obj_set_style_bg_color(o, c, 0);
+    return o;
+}
+
+lv_obj_t* text(lv_obj_t* parent, const char* s, const lv_font_t* font, lv_color_t c)
+{
+    lv_obj_t* l = lv_label_create(parent);
+    lv_obj_remove_flag(l, LV_OBJ_FLAG_CLICKABLE);
+    lv_obj_set_style_text_font(l, font, 0);
+    lv_obj_set_style_text_color(l, c, 0);
+    lv_label_set_text(l, s);
+    return l;
+}
+
+int text_w(const char* s, const lv_font_t* f)
+{
+    lv_point_t p;
+    lv_text_get_size(&p, s, f, 0, 0, LV_COORD_MAX, LV_TEXT_FLAG_NONE);
+    return p.x;
+}
+const lv_font_t* fit_font(const char* s, int avail)
+{
+    if (text_w(s, kMid) <= avail) return kMid;
+    if (text_w(s, kSmall) <= avail) return kSmall;
+    return kTiny;
+}
+void set_text_if(lv_obj_t* l, const char* s)
+{
+    if (l != nullptr && strcmp(lv_label_get_text(l), s) != 0) {
+        lv_label_set_text(l, s);
+    }
+}
+
+// A target: a rounded box that fills while it is pressed, with its label centered. `on` fills it (a state is never told by color alone).
+lv_obj_t* button(lv_obj_t* parent, int x, int y, int w, int h, const char* label, const lv_font_t* font, bool on = false, bool enabled = true)
+{
+    lv_obj_t* b = box(parent, x, y, w, h, on ? fg(100) : fg(enabled ? 16 : 8), 10, enabled);
+    lv_obj_set_style_border_width(b, 1, 0);
+    lv_obj_set_style_border_color(b, fg(enabled ? 40 : 22), 0);
+    if (enabled) {
+        lv_obj_set_style_bg_color(b, fg(45), LV_STATE_PRESSED);
+    }
+    if (label != nullptr && label[0] != '\0') {
+        lv_obj_t* l = text(b, label, font, on ? lv_color_black() : fg(enabled ? 100 : 35));
+        lv_label_set_long_mode(l, LV_LABEL_LONG_CLIP);
+        lv_obj_set_width(l, w - 2);
+        lv_obj_set_style_text_align(l, LV_TEXT_ALIGN_CENTER, 0);
+        lv_obj_align(l, LV_ALIGN_CENTER, 0, 0);
+    }
+    return b;
+}
+
+// ---- drawn icons: the shapes of maipai_pages_core.h, scaled ----
+void draw_shapes(lv_obj_t* parent, const mpg_shape_t* sh, int n, int x, int y, int scale, lv_color_t c, lv_color_t bg)
+{
+    for (int i = 0; i < n; i++) {
+        const int sx = x + sh[i].x * scale, sy = y + sh[i].y * scale, sw = sh[i].w * scale, shh = sh[i].h * scale;
+        switch (sh[i].kind) {
+            case MPG_SH_CIRCLE: box(parent, sx, sy, sw, shh, c, LV_RADIUS_CIRCLE); break;
+            case MPG_SH_RING: {
+                lv_obj_t* o = box(parent, sx, sy, sw, shh, c, LV_RADIUS_CIRCLE);
+                lv_obj_set_style_bg_opa(o, LV_OPA_TRANSP, 0);
+                lv_obj_set_style_border_width(o, scale * 2, 0);
+                lv_obj_set_style_border_color(o, c, 0);
+                break;
+            }
+            case MPG_SH_RECT: box(parent, sx, sy, sw, shh, c, 0); break;
+            case MPG_SH_ROUND: box(parent, sx, sy, sw, shh, c, scale); break;
+            case MPG_SH_CUTC: box(parent, sx, sy, sw, shh, bg, LV_RADIUS_CIRCLE); break;
+            default: box(parent, sx, sy, sw, shh, bg, 0); break;
+        }
+    }
+}
+
+// The wall icons, in the 24 by 24 box.
+int app_shapes(int app, mpg_shape_t* s)
+{
+    int n = 0;
+#define SH(k, X, Y2, W, H) do { s[n].kind = (k); s[n].x = (X); s[n].y = (Y2); s[n].w = (W); s[n].h = (H); n++; } while (0)
+    switch (app) {
+        case MAC_APP_TIMERS: /* a stopwatch: a ring, a crown and one hand */
+            SH(MPG_SH_RING, 2, 3, 20, 20);
+            SH(MPG_SH_ROUND, 9, 0, 6, 3);
+            SH(MPG_SH_ROUND, 11, 8, 2, 8);
+            SH(MPG_SH_ROUND, 19, 3, 4, 3);
+            break;
+        case MAC_APP_ALARMS: return mpg_icon_shapes(MPG_I_BELL, s);
+        case MAC_APP_CLOCK: /* a clock face with two hands */
+            SH(MPG_SH_RING, 1, 1, 22, 22);
+            SH(MPG_SH_ROUND, 11, 5, 2, 8);
+            SH(MPG_SH_ROUND, 11, 11, 7, 2);
+            break;
+        case MAC_APP_QUICK: /* four small squares */
+            SH(MPG_SH_ROUND, 2, 2, 9, 9);
+            SH(MPG_SH_ROUND, 13, 2, 9, 9);
+            SH(MPG_SH_ROUND, 2, 13, 9, 9);
+            SH(MPG_SH_ROUND, 13, 13, 9, 9);
+            break;
+        case MAC_APP_PICTURES: /* a frame with a sun and a hill */
+            SH(MPG_SH_ROUND, 1, 3, 22, 18);
+            SH(MPG_SH_CUT, 4, 6, 16, 12);
+            SH(MPG_SH_CIRCLE, 14, 7, 4, 4);
+            SH(MPG_SH_ROUND, 5, 13, 10, 5);
+            break;
+        case MAC_APP_DASHBOARD: /* tiles of different sizes */
+            SH(MPG_SH_ROUND, 1, 1, 10, 13);
+            SH(MPG_SH_ROUND, 13, 1, 10, 7);
+            SH(MPG_SH_ROUND, 13, 10, 10, 13);
+            SH(MPG_SH_ROUND, 1, 16, 10, 7);
+            break;
+        case MAC_APP_DANCE: /* two music notes */
+            SH(MPG_SH_CIRCLE, 1, 15, 8, 8);
+            SH(MPG_SH_ROUND, 7, 3, 3, 15);
+            SH(MPG_SH_ROUND, 7, 2, 14, 4);
+            SH(MPG_SH_ROUND, 18, 3, 3, 14);
+            SH(MPG_SH_CIRCLE, 12, 14, 8, 8);
+            break;
+        default: /* lock: a shackle over a body with a keyhole */
+            SH(MPG_SH_RING, 6, 0, 12, 14);
+            SH(MPG_SH_ROUND, 3, 10, 18, 13);
+            SH(MPG_SH_CUTC, 10, 14, 4, 4);
+            SH(MPG_SH_CUT, 11, 17, 2, 4);
+            break;
+    }
+#undef SH
+    return n;
+}
+
+// ---- the frame of every view ----
+void toast(const char* msg)
+{
+    if (S == nullptr || S->root == nullptr) {
+        return;
+    }
+    if (S->toast != nullptr) {
+        lv_obj_delete(S->toast);
+        S->toast = nullptr;
+    }
+    lv_obj_t* t = box(S->root, 8, Y(MAC_BOTTOM - 42), 304, 40, fg(30), 10);  // two lines of small text
+    lv_obj_set_style_border_width(t, 1, 0);
+    lv_obj_set_style_border_color(t, fg(70), 0);
+    lv_obj_t* l = text(t, msg, kTiny, fg(100));
+    lv_label_set_long_mode(l, LV_LABEL_LONG_WRAP);
+    lv_obj_set_width(l, 288);
+    lv_obj_set_style_text_align(l, LV_TEXT_ALIGN_CENTER, 0);
+    lv_obj_align(l, LV_ALIGN_CENTER, 0, 0);
+    S->toast       = t;
+    S->toast_until = now_ms() + kToastMs;
+}
+
+// The drag bar at the top of the zone, the same grabber as the sheet, the games and the other screens (it never takes a touch).
+void grabber()
+{
+    lv_obj_t* g = box(S->root, MAC_W / 2 - 24, Y(31), 48, 5, fg(70), 3);
+    lv_obj_move_foreground(g);
+}
+
+void close_all();
+void build(int view);
+
+void async_close(void*) { close_all(); }
+void async_view(void* p) { if (S != nullptr) build(static_cast<int>(reinterpret_cast<intptr_t>(p))); }
+void request_view(int view) { lv_async_call(async_view, reinterpret_cast<void*>(static_cast<intptr_t>(view))); }
+void async_page(void* p)
+{
+    if (S == nullptr || (S->view != MAV_APPS && S->view != MAV_GAMES)) {
+        return;
+    }
+    const int np = mac_wall_step(S->page, S->n_items, static_cast<int>(reinterpret_cast<intptr_t>(p)));
+    if (np != S->page) {
+        S->page = np;
+        build(S->view);
+    }
+}
+
+// The finger: down, up, and what the touch was (a tap, a page swipe or the drag bar's dismiss).
+void on_root(lv_event_t* e)
+{
+    if (S == nullptr) {
+        return;
+    }
+    const lv_event_code_t code = lv_event_get_code(e);
+    lv_point_t p = {0, 0};
+    lv_indev_t* in = lv_indev_active();
+    if (in != nullptr) {
+        lv_indev_get_point(in, &p);
+    }
+    if (code == LV_EVENT_PRESSED) {
+        mac_touch_down(&S->touch, p.x, p.y, now_ms());
+        S->taken      = false;
+        S->last_touch = now_ms();
+    } else if (code == LV_EVENT_RELEASED) {
+        const bool paged = S->view == MAV_APPS || S->view == MAV_GAMES;
+        const int r      = mac_touch_up(&S->touch, p.x, p.y, now_ms(), paged);
+        S->taken         = r != MAC_T_TAP;  // the click that follows a swipe, a dead press or a slow press is ignored
+        S->last_touch    = now_ms();
+        if (r == MAC_T_DISMISS) {
+            lv_async_call(async_close, nullptr);
+        } else if (r == MAC_T_NEXT) {
+            lv_async_call(async_page, reinterpret_cast<void*>(static_cast<intptr_t>(1)));
+        } else if (r == MAC_T_PREV) {
+            lv_async_call(async_page, reinterpret_cast<void*>(static_cast<intptr_t>(-1)));
+        }
+    } else if (code == LV_EVENT_PRESS_LOST) {
+        S->touch.down = 0;
+        S->taken      = true;
+    }
+}
+
+bool taps_ignored()
+{
+    return S == nullptr || S->taken || (S->slider_up_ms != 0 && now_ms() - S->slider_up_ms < kSliderGapMs);
+}
+
+// ---- the walls: Apps and Games ----
+void on_wall_tile(lv_event_t* e)
+{
+    if (taps_ignored()) {
+        return;
+    }
+    const int idx = static_cast<int>(reinterpret_cast<intptr_t>(lv_event_get_user_data(e)));
+    if (S->view == MAV_GAMES) {
+        const char* why = g_host->game_start(idx);  // on success the page steps aside by itself (the game draws on the same layer)
+        if (why != nullptr && why[0] != '\0') {
+            toast(why);
+        } else {
+            close_all();
+        }
+        return;
+    }
+    const int app = S->apps[idx];
+    switch (app) {
+        case MAC_APP_TIMERS: request_view(MAV_TIMERS); break;
+        case MAC_APP_ALARMS: request_view(MAV_ALARMS); break;
+        case MAC_APP_DANCE:
+            if (mpg_action_blocked(MPG_A_DANCE, g_host->quiet(), g_host->muted())) {
+                toast(g_host->quiet() ? tx(MAC_S_QUIET_ON) : tx(MAC_S_MUTED));
+            } else {
+                g_host->action(MPG_A_DANCE);
+                close_all();  // the face is the show
+            }
+            break;
+        case MAC_APP_LOCK:
+            if (!g_host->lock_has_code()) {
+                toast(tx(MAC_S_LOCK_HINT));  // the Security hint: the code is set on the settings page, never on the unit
+            } else {
+                close_all();
+                g_host->lock_now();  // the lock screen takes the glass; a touch there shows the keypad (patches LK02 and LK03)
+            }
+            break;
+        default: {
+            const int type = mac_app_strip_page(app);
+            close_all();
+            if (type >= 0) {
+                g_host->open_strip_page(type);
+            }
+            break;
+        }
+    }
+}
+
+void build_wall(int view)
+{
+    int total = 0;
+    if (view == MAV_APPS) {
+        total = mac_apps_list(g_host->pictures_held() ? 1 : 0, S->apps);
+    } else {
+        total = g_host->game_count();
+        if (total > kMaxGames) {
+            total = kMaxGames;
+        }
+    }
+    S->n_items = total;
+    S->page    = mac_wall_clamp(S->page, total);
+    if (total == 0) {
+        lv_obj_t* none = text(S->root, tx(MAC_S_NO_GAMES), kMid, fg(70));
+        lv_obj_set_width(none, 280);
+        lv_label_set_long_mode(none, LV_LABEL_LONG_WRAP);
+        lv_obj_set_style_text_align(none, LV_TEXT_ALIGN_CENTER, 0);
+        lv_obj_set_pos(none, 20, Y(96));
+        return;
+    }
+    const int count = mac_wall_count(S->page, total);
+    for (int slot = 0; slot < count; slot++) {
+        const int idx = S->page * MAC_WALL_PER_PAGE + slot;
+        int x, y, w, h;
+        mac_wall_tile(slot, &x, &y, &w, &h);
+        lv_obj_t* b = box(S->root, x, Y(y), w, h, fg(16), 12, true);
+        lv_obj_set_style_border_width(b, 1, 0);
+        lv_obj_set_style_border_color(b, fg(40), 0);
+        lv_obj_set_style_bg_color(b, fg(45), LV_STATE_PRESSED);
+        lv_obj_add_event_cb(b, on_wall_tile, LV_EVENT_CLICKED, reinterpret_cast<void*>(static_cast<intptr_t>(idx)));
+        if (view == MAV_APPS) {
+            const int app = S->apps[idx];
+            mpg_shape_t sh[MPG_ICON_SHAPES_MAX];
+            draw_shapes(b, sh, app_shapes(app, sh), (w - 48) / 2, 8, 2, fg(100), fg(16));
+            const char* name = MAC_APP_TITLE[es() ? 1 : 0][app];
+            lv_obj_t* l = text(b, name, fit_font(name, w - 12), fg(100));
+            lv_label_set_long_mode(l, LV_LABEL_LONG_DOT);
+            lv_obj_set_size(l, w - 12, lv_font_get_line_height(fit_font(name, w - 12)));
+            lv_obj_set_style_text_align(l, LV_TEXT_ALIGN_CENTER, 0);
+            lv_obj_align(l, LV_ALIGN_BOTTOM_MID, 0, -6);
+        } else {
+            const char* gt = g_host->game_title(idx);
+            lv_obj_t* l = text(b, gt, kSmall, fg(100));  // one size for every game; a long name wraps to two lines
+            lv_obj_set_width(l, w - 12);
+            lv_label_set_long_mode(l, LV_LABEL_LONG_WRAP);
+            lv_obj_set_style_text_align(l, LV_TEXT_ALIGN_CENTER, 0);
+            lv_obj_align(l, LV_ALIGN_TOP_MID, 0, 14);
+            char best[24];
+            mpg_best_text(best, sizeof(best), g_host->game_best(idx), es());
+            lv_obj_t* bl = text(b, best, kTiny, fg(70));
+            lv_obj_set_width(bl, w - 12);
+            lv_obj_set_style_text_align(bl, LV_TEXT_ALIGN_CENTER, 0);
+            lv_obj_align(bl, LV_ALIGN_BOTTOM_MID, 0, -6);
+        }
+    }
+    const int pages = mac_wall_pages(total);
+    if (pages > 1) {  // the page dots sit under the tiles at the bottom edge of the zone
+        for (int i = 0; i < pages; i++) {
+            const bool on = i == S->page;
+            const int d   = on ? MAC_WALL_DOT_ON : MAC_WALL_DOT_OFF;
+            box(S->root, mac_wall_dot_x(pages, i) - d / 2, Y(MAC_WALL_DOTS_Y) - d / 2, d, d, fg(on ? 100 : 32), LV_RADIUS_CIRCLE);
+        }
+    }
+}
