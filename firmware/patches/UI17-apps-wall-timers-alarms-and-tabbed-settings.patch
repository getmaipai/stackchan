+void list_rows(int kind)
+{
+    MaipaiPageTimer t[MAC_ACTIVE_MAX];
+    const int n  = g_host->app_items(kind, t, MAC_ACTIVE_MAX);
+    S->n_rows    = n;
+    S->sig       = items_sig(t, n);
+    const int Hh = mac_list_content_h(n);
+    // the list: a scrolling area three rows high at the bottom of the zone
+    lv_obj_t* l = lv_obj_create(S->root);
+    lv_obj_remove_style_all(l);
+    lv_obj_set_pos(l, 0, Y(MAC_ROW_TOP));
+    lv_obj_set_size(l, MAC_W, MAC_LIST_H);
+    lv_obj_add_flag(l, LV_OBJ_FLAG_CLICKABLE);
+    lv_obj_add_flag(l, LV_OBJ_FLAG_EVENT_BUBBLE);
+    lv_obj_add_flag(l, LV_OBJ_FLAG_SCROLLABLE);
+    lv_obj_set_scroll_dir(l, LV_DIR_VER);
+    lv_obj_set_scrollbar_mode(l, LV_SCROLLBAR_MODE_OFF);
+    lv_obj_remove_flag(l, LV_OBJ_FLAG_SCROLL_ELASTIC);
+    S->list = l;
+    if (n == 0) {
+        lv_obj_t* none = text(l, kind == kKindTimer ? tx(MAC_S_NO_TIMERS) : tx(MAC_S_NO_ALARMS), kMid, fg(70));
+        lv_obj_set_width(none, MAC_W);
+        lv_obj_set_style_text_align(none, LV_TEXT_ALIGN_CENTER, 0);
+        lv_obj_set_pos(none, 0, 44);
+        return;
+    }
+    for (int i = 0; i < n; i++) {
+        const int y = i * MAC_ROW_PITCH;
+        box(l, 8, y, 304, MAC_ROW_H, fg(16), 10);
+        char when[24];
+        if (kind == kKindTimer) {
+            mac_fmt_left(when, sizeof(when), t[i].left_s);
+        } else if (t[i].hour < 0) {
+            snprintf(when, sizeof(when), "--:--");  // an alarm kept in flash while the clock is not set yet
+        } else {
+            mac_fmt_time(when, sizeof(when), t[i].hour, t[i].minute, g_host->clock24() ? 1 : 0);
+        }
+        S->left[i] = text(l, when, kind == kKindTimer ? kBig : kMid, fg(100));  // an alarm's "12:05 PM" is longer than a countdown
+        lv_obj_set_pos(S->left[i], 18, y + (kind == kKindTimer ? 9 : 11));
+        S->ids[i] = t[i].id;
+        const char* name = t[i].label[0] != '\0' ? t[i].label : (kind == kKindTimer ? tx(MAC_S_TIMER) : tx(MAC_S_ALARM));
+        lv_obj_t* lab = text(l, name, kSmall, fg(70));
+        lv_label_set_long_mode(lab, LV_LABEL_LONG_DOT);
+        lv_obj_set_size(lab, 88, 20);  // dots need a fixed height, or the name wraps instead
+        lv_obj_set_pos(lab, 122, y + 12);
+        int x, yy, w, h;
+        mac_cancel_box(0, &x, &yy, &w, &h);
+        lv_obj_t* c = button(l, x, y, w, h, tx(MAC_S_CANCEL), kSmall);
+        lv_obj_add_event_cb(c, on_cancel, LV_EVENT_CLICKED, reinterpret_cast<void*>(static_cast<intptr_t>(t[i].id)));
+    }
+    (void)Hh;
+}
