+static std::string ascii_punctuation(const char* text)
+{
+    std::string out;
+    if (text == nullptr) return out;
+    for (const unsigned char* p = reinterpret_cast<const unsigned char*>(text); *p != 0;) {
+        if (p[0] == 0xE2 && p[1] == 0x80) {
+            const char* mapped = nullptr;
+            switch (p[2]) {
+                case 0x98: case 0x99: case 0x9A: mapped = "'"; break;
+                case 0x9C: case 0x9D: case 0x9E: mapped = "\""; break;
+                case 0x90: case 0x91: case 0x92: case 0x93: case 0x94: case 0x95: mapped = "-"; break;
+                case 0xA2: mapped = "*"; break;
+                case 0xA6: mapped = "..."; break;
+                default: break;
+            }
+            if (mapped != nullptr) { out += mapped; p += 3; continue; }
+        } else if (p[0] == 0xC2 && p[1] == 0xA0) {
+            out += ' ';
+            p += 2;
+            continue;
+        }
+        out += static_cast<char>(*p++);
+    }
+    return out;
+}
