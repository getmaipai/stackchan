# Intent: list, add, forget and switch saved Wi-Fi networks through MCP tools backed by the robot SsidManager (NVS); passwords are never returned or logged.
# Placement: unit (robot Wi-Fi settings)
diff --git a/firmware/main/hal/hal_mcp.cpp b/firmware/main/hal/hal_mcp.cpp
index d18d123..3e3fbae 100644
--- a/firmware/main/hal/hal_mcp.cpp
+++ b/firmware/main/hal/hal_mcp.cpp
@@ -8,6 +8,23 @@
 #include <mcp_server.h>
 #include <stackchan/stackchan.h>
 #include <apps/common/common.h>
+#include <ssid_manager.h>
+#include <esp_wifi.h>
+
+namespace {
+std::string EscapeJsonString(const std::string& value)
+{
+    std::string escaped;
+    escaped.reserve(value.size());
+    for (const char c : value) {
+        if (c == '"' || c == '\\') {
+            escaped.push_back('\\');
+        }
+        escaped.push_back(c);
+    }
+    return escaped;
+}
+}  // namespace
 
 using namespace stackchan;
 
@@ -184,4 +201,62 @@ void Hal::xiaozhi_mcp_init()
                            tools::stop_reminder(id);
                            return true;
                        });
+
+    mclog::tagInfo(_tag, "add wifi.list_saved tool");
+    mcp_server.AddTool("self.wifi.list_saved",
+                       "List saved Wi-Fi networks as a JSON array of {index, ssid}. Passwords are never included.",
+                       std::vector<Property>{}, [this](const PropertyList&) -> ReturnValue {
+                           const auto& ssids = SsidManager::GetInstance().GetSsidList();
+                           std::string result = "[";
+                           for (size_t i = 0; i < ssids.size(); ++i) {
+                               if (i > 0) {
+                                   result += ", ";
+                               }
+                               result += fmt::format(R"({{"index": {}, "ssid": "{}"}})", i,
+                                                    EscapeJsonString(ssids[i].ssid));
+                           }
+                           result += "]";
+                           return result;
+                       });
+
+    mclog::tagInfo(_tag, "add wifi.add tool");
+    mcp_server.AddTool("self.wifi.add", "Save a Wi-Fi network. Passwords are not returned or logged.",
+                       PropertyList({Property("ssid", kPropertyTypeString, std::string("")),
+                                     Property("password", kPropertyTypeString, std::string("") )}),
+                       [this](const PropertyList& properties) -> ReturnValue {
+                           const auto ssid = properties["ssid"].value<std::string>();
+                           const auto password = properties["password"].value<std::string>();
+                           if (ssid.empty() || ssid.size() > 32 || password.size() > 63) {
+                               return false;
+                           }
+                           SsidManager::GetInstance().AddSsid(ssid, password);
+                           return true;
+                       });
+
+    mclog::tagInfo(_tag, "add wifi.forget tool");
+    mcp_server.AddTool("self.wifi.forget", "Forget a saved Wi-Fi network by its listed index.",
+                       PropertyList({Property("index", kPropertyTypeInteger, -1)}),
+                       [this](const PropertyList& properties) -> ReturnValue {
+                           const int index = properties["index"].value<int>();
+                           const auto& ssids = SsidManager::GetInstance().GetSsidList();
+                           if (index < 0 || static_cast<size_t>(index) >= ssids.size()) {
+                               return false;
+                           }
+                           SsidManager::GetInstance().RemoveSsid(index);
+                           return true;
+                       });
+
+    mclog::tagInfo(_tag, "add wifi.switch tool");
+    mcp_server.AddTool("self.wifi.switch", "Make a saved network the first choice and reconnect now.",
+                       PropertyList({Property("index", kPropertyTypeInteger, -1)}),
+                       [this](const PropertyList& properties) -> ReturnValue {
+                           const int index = properties["index"].value<int>();
+                           const auto& ssids = SsidManager::GetInstance().GetSsidList();
+                           if (index < 0 || static_cast<size_t>(index) >= ssids.size()) {
+                               return false;
+                           }
+                           SsidManager::GetInstance().SetDefaultSsid(index);
+                           esp_wifi_disconnect();
+                           return true;
+                       });
 }
