+void hal_bridge::update_cover(int percent)
+{
+    auto display = static_cast<StackChanAvatarDisplay*>(Board::GetInstance().GetDisplay());
+    if (display != nullptr) {
+        display->LvglLock();
+        display->ShowUpdateCover(percent);
+        display->LvglUnlock();
+    }
+}
+
+void StackChanAvatarDisplay::ShowUpdateCover(int percent)
+{
+    if (percent == -1) {
+        if (update_bar_ != nullptr) lv_obj_add_flag(update_bar_, LV_OBJ_FLAG_HIDDEN);  // the bar belongs to this cover only
+        HideBootCover();
+        return;
+    }
+    if (percent == -2 || percent == 100) {
+        ShowBootCover(percent == -2 ? "Update refused\nNothing changed" : "Update installed\nRestarting...", 1, -1);
+        if (update_bar_ != nullptr) lv_obj_add_flag(update_bar_, LV_OBJ_FLAG_HIDDEN);
+        if (percent == -2) {
+            lv_timer_t* timer = lv_timer_create([](lv_timer_t* t) {
+                auto self = static_cast<StackChanAvatarDisplay*>(lv_timer_get_user_data(t));
+                if (self != nullptr) self->HideBootCover();
+                lv_timer_delete(t);
+            }, 4000, this);
+            lv_timer_set_repeat_count(timer, 1);
+        }
+        return;
     }
+    char text[32];
+    snprintf(text, sizeof(text), "Updating\n%d%%\nDo not unplug", percent);
+    ShowBootCover(text, 1, -1);
+    if (update_bar_ == nullptr) {
+        update_bar_ = lv_bar_create(boot_cover_);
+        lv_obj_set_size(update_bar_, 200, 14);
+        lv_obj_set_style_bg_color(update_bar_, maipai_ui_style::surface(), LV_PART_MAIN);
+        lv_obj_set_style_bg_opa(update_bar_, LV_OPA_COVER, LV_PART_MAIN);
+        lv_obj_set_style_bg_color(update_bar_, maipai_ui_style::accent(), LV_PART_INDICATOR);
+        lv_obj_set_style_radius(update_bar_, 7, LV_PART_MAIN);
+        lv_obj_set_style_radius(update_bar_, 7, LV_PART_INDICATOR);
+    }
+    lv_obj_remove_flag(update_bar_, LV_OBJ_FLAG_HIDDEN);
+    lv_bar_set_range(update_bar_, 0, 100);
+    lv_bar_set_value(update_bar_, percent, LV_ANIM_OFF);
 }
 
