+// SPDX-License-Identifier: MIT
+// The Reversi screen (patch UX22; spec docs/design/reversi.md). Header only, so the host renderer compiles the very same drawing code. The board is drawn by ONE object and one draw callback (the
+// grid-game pattern: 1 LVGL object instead of 64 cells and 64 discs), the scores and the turn line are three labels. The firmware track wires the touches (rv_hit), the unit's move after a short
+// pause, the sounds, the best score and the shared game-over screen (You won, You lost or Draw, with the disc count). No ESP call here.
+#ifndef MAIPAI_REVERSI_H
+#define MAIPAI_REVERSI_H
+
+#include <lvgl.h>
+#include <stdio.h>
+#include "maipai_reversi_core.h"
+
+namespace rvs {
+
+inline void rect(lv_layer_t* layer, int x, int y, int w, int h, int radius, uint32_t color, lv_opa_t opa = LV_OPA_COVER)
+{
+    lv_draw_rect_dsc_t d;
+    lv_draw_rect_dsc_init(&d);
+    d.bg_color = lv_color_hex(color);
+    d.bg_opa = opa;
+    d.radius = radius;
+    lv_area_t a = {static_cast<lv_coord_t>(x), static_cast<lv_coord_t>(y), static_cast<lv_coord_t>(x + w - 1), static_cast<lv_coord_t>(y + h - 1)};
+    lv_draw_rect(layer, &d, &a);
+}
+
+inline void draw_board(lv_event_t* e)
+{
+    const rv_t* g = static_cast<const rv_t*>(lv_event_get_user_data(e));
+    if (g == nullptr) return;
+    lv_layer_t* layer = lv_event_get_layer(e);
+    rect(layer, RV_BX - 2, RV_BY - 2, 8 * RV_CELL + 4, 8 * RV_CELL + 4, 4, 0x0B3D2A);                // the frame
+    for (int i = 0; i < RV_CELLS; i++) {
+        int x, y, w, h;
+        rv_cell_box(i, &x, &y, &w, &h);
+        rect(layer, x, y, w, h, 0, ((i / 8 + i % 8) & 1) ? 0x1E6B47 : 0x237A50);                      // the two greens of the board
+        if (g->b[i] != RV_EMPTY) {
+            rect(layer, x + 3, y + 3, w - 6, h - 6, LV_RADIUS_CIRCLE, g->b[i] == RV_PERSON ? 0x15171C : 0xF1EEE4);   // the person plays black, the unit white
+        } else if (g->phase == RV_PLAY && g->turn == RV_PERSON && rv_legal(g, i, RV_PERSON)) {
+            rect(layer, x + 9, y + 9, w - 18, h - 18, LV_RADIUS_CIRCLE, 0xF2B24A, LV_OPA_70);          // a moves the person may make: a small amber dot
+        }
+        if (i == g->last) rect(layer, x + 10, y + 10, w - 20, h - 20, LV_RADIUS_CIRCLE, g->b[i] == RV_PERSON ? 0xF2B24A : 0xE07A7A);   // the last move: a colored center
+    }
+}
+
+inline lv_obj_t* words(lv_obj_t* parent, const char* t, const lv_font_t* font, uint32_t rgb, int x, int y, int w, lv_text_align_t align)
+{
+    lv_obj_t* l = lv_label_create(parent);
+    lv_label_set_text(l, t);
+    lv_obj_set_style_text_font(l, font, 0);
+    lv_obj_set_style_text_color(l, lv_color_hex(rgb), 0);
+    lv_obj_set_style_text_align(l, align, 0);
+    lv_label_set_long_mode(l, LV_LABEL_LONG_WRAP);
+    lv_obj_set_width(l, w);
+    lv_obj_set_pos(l, x, y);
+    return l;
+}
+
+// `g` must outlive the screen (the draw callback reads it); a change of the board is shown by lv_obj_invalidate on the returned root's first child.
+inline lv_obj_t* screen(lv_obj_t* parent, const rv_t* g, bool es)
+{
+    lv_obj_t* r = lv_obj_create(parent);
+    lv_obj_remove_style_all(r);
+    lv_obj_remove_flag(r, LV_OBJ_FLAG_SCROLLABLE);
+    lv_obj_set_size(r, 320, 240);
+    lv_obj_set_style_bg_color(r, lv_color_black(), 0);
+    lv_obj_set_style_bg_opa(r, LV_OPA_COVER, 0);
+    lv_obj_t* board = lv_obj_create(r);
+    lv_obj_remove_style_all(board);
+    lv_obj_remove_flag(board, LV_OBJ_FLAG_CLICKABLE);
+    lv_obj_remove_flag(board, LV_OBJ_FLAG_SCROLLABLE);
+    lv_obj_set_size(board, 320, 240);
+    lv_obj_set_pos(board, 0, 0);
+    lv_obj_add_event_cb(board, draw_board, LV_EVENT_DRAW_MAIN, const_cast<rv_t*>(g));
+    char a[24], b[24];
+    snprintf(a, sizeof(a), es ? "Tu %d" : "You %d", rv_discs(g, RV_PERSON));
+    snprintf(b, sizeof(b), es ? "Unidad %d" : "Unit %d", rv_discs(g, RV_UNIT));
+    words(r, a, &lv_font_montserrat_20, 0xE8E8E8, 216, 40, 96, LV_TEXT_ALIGN_LEFT);
+    words(r, b, &lv_font_montserrat_20, 0xB8C4D8, 216, 72, 96, LV_TEXT_ALIGN_LEFT);
+    words(r, rv_turn_text(g, es), &lv_font_montserrat_16, g->turn == RV_PERSON || g->phase == RV_END ? 0x7FE0B8 : 0x9AA3B0, 216, 118, 96, LV_TEXT_ALIGN_LEFT);
+    return r;
+}
+
+}  // namespace rvs
+
+#endif
