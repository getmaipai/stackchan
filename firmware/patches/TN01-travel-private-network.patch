# Intent: Travel with the private network (feature gap row 'Travel', rebuilt from the old patches 147, 148 and 153 and not carried over). The unit joins the household's private network itself, so it reaches the hub from any Wi-Fi with no relay and no public address. Nothing runs at home: the client starts only after the hub failed to answer three connects in a row, only when a pairing key was entered (setup page or self.tailnet.set) or the unit joined before, and only when 46,000 bytes of internal RAM and a 24,000 byte block are free (admission control for the memory gate). The pairing key is saved in the unit's own storage, never in an image, and is erased once the unit has joined. The old Kconfig defaults for a hub address and a first-enrolment key are gone (security note finding 9; patch 156 refuses keys). Adds the pure core (guard, shapes, start decision, route, URL swap), the runtime, tools self.tailnet.status and self.tailnet.set (enabled, key, peer, now, forget), the build switch, the download hook for the pinned client (scripts/fw-tailnet.sh) and sdkconfig.tailnet.defaults, which rides on the home preset (MAIPAI_PRESET=home) on MAIPAI_TAILNET=y and on any build where the client has been downloaded (MAIPAI_TAILNET=n leaves it out).
# Placement: unit (core and home presets; compiled in only with CONFIG_MAIPAI_TAILNET, which the home preset and a downloaded client turn on; the unit works with it off)
# Upstream: firmware/CMakeLists.txt, firmware/main/CMakeLists.txt, firmware/main/Kconfig.projbuild, firmware/main/hal/hal.cpp and hal_mcp.cpp of the StackChan main component (MIT); the client is a separate download, see firmware/tailnet/PIN
# Check after a flash: self.tailnet.status answers compiled, enabled, key_saved, peer_saved, joined, state, ip, ready, route, fails, internal_free and largest_block (never the key); with no key it never starts and internal_free is within 1 KB of a build without it; self.tailnet.set with a bad key answers bad_key.
# Kconfig: MAIPAI_TAILNET (default n; the home preset sets y), MAIPAI_TAILNET_HOSTNAME, MAIPAI_TAILNET_MAX_PEERS.
diff --git a/firmware/CMakeLists.txt b/firmware/CMakeLists.txt
index 469fb47..31ca39b 100644
--- a/firmware/CMakeLists.txt
+++ b/firmware/CMakeLists.txt
@@ -46,6 +46,27 @@ if(EXISTS "${CMAKE_CURRENT_SOURCE_DIR}/sdkconfig.core.defaults")
     endif()
 endif()
 
+# Travel with the private network (patch TN01): scripts/fw-tailnet.sh downloads the pinned client into a folder outside
+# this tree and fw-env.sh names it. Without the variable nothing about it is built.
+if(DEFINED ENV{MAIPAI_MICROLINK_DIR} AND NOT "$ENV{MAIPAI_MICROLINK_DIR}" STREQUAL "")
+    list(APPEND EXTRA_COMPONENT_DIRS "$ENV{MAIPAI_MICROLINK_DIR}/components")
+endif()
+
+# Travel with the private network (patch TN01): sdkconfig.tailnet.defaults rides on the home preset
+# (MAIPAI_PRESET=home), on MAIPAI_TAILNET=y and, for the core preset, whenever the client has been downloaded
+# (scripts/fw-tailnet.sh); MAIPAI_TAILNET=n leaves it out of any build.
+set(MAIPAI_WANT_TAILNET OFF)
+if("$ENV{MAIPAI_PRESET}" STREQUAL "home" OR "$ENV{MAIPAI_TAILNET}" STREQUAL "y"
+   OR (DEFINED ENV{MAIPAI_MICROLINK_DIR} AND NOT "$ENV{MAIPAI_MICROLINK_DIR}" STREQUAL ""))
+    set(MAIPAI_WANT_TAILNET ON)
+endif()
+if("$ENV{MAIPAI_TAILNET}" STREQUAL "n")
+    set(MAIPAI_WANT_TAILNET OFF)
+endif()
+if(MAIPAI_WANT_TAILNET AND EXISTS "${CMAKE_CURRENT_SOURCE_DIR}/sdkconfig.tailnet.defaults")
+    list(APPEND SDKCONFIG_DEFAULTS "${CMAKE_CURRENT_SOURCE_DIR}/sdkconfig.tailnet.defaults")
+endif()
+
 include($ENV{IDF_PATH}/tools/cmake/project.cmake)
 project(maipai-stackchan)
 
