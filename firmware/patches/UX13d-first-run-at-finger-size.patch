+/* ---- the first-run screens at finger size (patch UX13d): where every target sits ----
+ * The header (y 4 to 52) holds Back (56 by 48, left) and Skip (72 by 48, right) as secondary targets, with the title between them. Everything else is 8 px from the header and from the
+ * next target. Language: six tiles 96 by 56 in two rows. Name: StackChan wide (304 by 48) and the six names 96 by 48. Brain: three tiles 304 by 48. The hint lines under the name and brain tiles are gone (they
+ * needed two 16 px lines and the glass has room for none; the last screen and the privacy step say the same). Privacy and the last screen: one 160 by 56 button at the bottom (8 px above the edge). */
+#define MFR_HEADER_BOTTOM 52
+static inline void mfr_set_box(int x, int y, int w, int h, int* ox, int* oy, int* ow, int* oh) { *ox = x; *oy = y; *ow = w; *oh = h; }
+static inline void mfr_back_box(int* x, int* y, int* w, int* h) { mfr_set_box(8, 4, 56, 48, x, y, w, h); }
+static inline void mfr_skip_box(int* x, int* y, int* w, int* h) { mfr_set_box(240, 4, 72, 48, x, y, w, h); }
+static inline void mfr_lang_box(int i, int* x, int* y, int* w, int* h) { mfr_set_box(8 + (i % 3) * 104, 64 + (i / 3) * 64, 96, 56, x, y, w, h); }
+static inline void mfr_name_wide_box(int* x, int* y, int* w, int* h) { mfr_set_box(8, 60, 304, 48, x, y, w, h); }
+static inline void mfr_name_box(int i, int* x, int* y, int* w, int* h) { mfr_set_box(8 + (i % 3) * 104, 116 + (i / 3) * 56, 96, 48, x, y, w, h); }
+static inline void mfr_mode_box(int i, int* x, int* y, int* w, int* h) { mfr_set_box(8, 60 + i * 56, 304, 48, x, y, w, h); }
+static inline void mfr_got_box(int* x, int* y, int* w, int* h) { mfr_set_box(80, 176, 160, 56, x, y, w, h); }
+
 #endif
