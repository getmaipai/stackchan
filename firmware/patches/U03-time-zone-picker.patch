diff --git a/firmware/main/hal/maipai_tz.cc b/firmware/main/hal/maipai_tz.cc
new file mode 100644
--- /dev/null
+++ b/firmware/main/hal/maipai_tz.cc
@@ -0,0 +1,124 @@
+/*
+ * SPDX-License-Identifier: MIT
+ *
+ * Time zone picker and host-set clock, device side (patch U03). The time of day never comes from the public internet:
+ * the paired host sets it (self.clock.set, seconds since 1970) and the unit's clock chip keeps it. The zone is only how
+ * that time is read for the person; it is one of a short list with summer-time rules.
+ */
+#include <sdkconfig.h>
+#if CONFIG_MAIPAI_TZ
+#include "maipai_tz.h"
+#include "maipai_tz_core.h"
+#include "hal.h"
+#include <mcp_server.h>
+#include <esp_log.h>
+#include <sys/time.h>
+#include <cstdio>
+#include <cstdlib>
+#include <ctime>
+#include <string>
+
+static const char* TAG = "MAIPAI-TZ";
+
+void maipai_tz_apply_saved()
+{
+    const std::string tz = GetHAL().getTimezone();
+    if (!tz.empty()) {
+        setenv("TZ", tz.c_str(), 1);
+        tzset();
+    }
+}
+
+int maipai_tz_current()
+{
+    return mz_find_posix(GetHAL().getTimezone().c_str());
+}
+
+bool maipai_tz_set(int index)
+{
+    if (index < 0 || index >= MZ_COUNT) {
+        return false;
+    }
+    GetHAL().setTimezone(std::string_view(MZ_ZONES[index].posix));  // saves and applies (the stock setting)
+    ESP_LOGI(TAG, "time zone set: %s", MZ_ZONES[index].label);
+    return true;
+}
+
+void maipai_tz_local_hhmm(char* out, int cap)
+{
+    out[0]       = '\0';
+    const time_t t = time(nullptr);
+    if (!mz_epoch_ok(static_cast<long long>(t))) {
+        return;
+    }
+    struct tm lt = {};
+    localtime_r(&t, &lt);
+    snprintf(out, cap, "%02d:%02d", lt.tm_hour, lt.tm_min);
+}
+
+namespace {
+std::string zone_reply()
+{
+    const int i = maipai_tz_current();
+    char hhmm[8];
+    maipai_tz_local_hhmm(hhmm, sizeof(hhmm));
+    const std::string posix = GetHAL().getTimezone();
+    char buf[260];
+    snprintf(buf, sizeof(buf),
+             "{\"ok\":true,\"zone\":\"%s\",\"label\":\"%s\",\"custom\":%s,\"posix\":\"%s\",\"clock_set\":%s,\"local\":\"%s\"}",
+             i >= 0 ? MZ_ZONES[i].id : "custom", i >= 0 ? MZ_ZONES[i].label : "custom", i >= 0 ? "false" : "true",
+             posix.c_str(), hhmm[0] != '\0' ? "true" : "false", hhmm);
+    return buf;
+}
+}  // namespace
+
+void maipai_tz_register_tools()
+{
+    maipai_tz_apply_saved();
+    auto& mcp = McpServer::GetInstance();
+    mcp.AddTool("self.clock.get",
+                "The time zone in force, and the local time if the clock was set. Answers "
+                "{ok,zone,label,custom,posix,clock_set,local}.",
+                std::vector<Property>{}, [](const PropertyList&) -> ReturnValue { return zone_reply(); });
+    mcp.AddTool("self.clock.zones", "The time zone ids the unit offers, west to east.", std::vector<Property>{},
+                [](const PropertyList&) -> ReturnValue {
+                    std::string out = "{\"ok\":true,\"zones\":[";
+                    for (int i = 0; i < MZ_COUNT; i++) {
+                        out += i > 0 ? ",{\"id\":\"" : "{\"id\":\"";
+                        out += MZ_ZONES[i].id;
+                        out += "\",\"label\":\"";
+                        out += MZ_ZONES[i].label;
+                        out += "\"}";
+                    }
+                    return out + "]}";
+                });
+    mcp.AddTool("self.clock.set_zone",
+                "Choose the time zone by id (self.clock.zones lists them). Saved on the unit. Answers the zone or "
+                "{ok:false,error}.",
+                PropertyList({Property("zone", kPropertyTypeString, std::string("utc"))}),
+                [](const PropertyList& properties) -> ReturnValue {
+                    const std::string id = properties["zone"].value<std::string>();
+                    const int i          = mz_find(id.c_str());
+                    if (i < 0) {
+                        return std::string("{\"ok\":false,\"error\":\"") + mz_err_word(MZ_ERR_ZONE) + "\"}";
+                    }
+                    maipai_tz_set(i);
+                    return zone_reply();
+                });
+    mcp.AddTool("self.clock.set",
+                "Set the clock: seconds since 1 January 1970 (UTC), the way the paired host reads its own clock. The "
+                "zone decides how it is shown. Answers the zone and local time or {ok:false,error}.",
+                PropertyList({Property("epoch", kPropertyTypeInteger, 1893456000, 1704067200, 2147483647)}),
+                [](const PropertyList& properties) -> ReturnValue {
+                    const long long epoch = properties["epoch"].value<int>();
+                    if (!mz_epoch_ok(epoch)) {
+                        return std::string("{\"ok\":false,\"error\":\"") + mz_err_word(MZ_ERR_TIME) + "\"}";
+                    }
+                    struct timeval tv = {};
+                    tv.tv_sec         = static_cast<time_t>(epoch);
+                    settimeofday(&tv, nullptr);
+                    GetHAL().syncSystemTimeToRtc();  // the clock chip keeps it through a restart
+                    return zone_reply();
+                });
+}
+#endif
diff --git a/firmware/main/hal/maipai_tz.h b/firmware/main/hal/maipai_tz.h
new file mode 100644
--- /dev/null
+++ b/firmware/main/hal/maipai_tz.h
@@ -0,0 +1,23 @@
+/*
+ * SPDX-License-Identifier: MIT
+ *
+ * Time zone picker and host-set clock, device side (patch U03). Logic: maipai_tz_core.h. The zone is stored by the
+ * stock time zone setting (Hal::setTimezone), so one copy exists. With CONFIG_MAIPAI_TZ off nothing here is compiled.
+ */
+#pragma once
+#include <sdkconfig.h>
+
+#if CONFIG_MAIPAI_TZ
+// Applies the saved zone to the C library. Call once at start (done by maipai_tz_register_tools).
+void maipai_tz_apply_saved();
+// The list index of the zone now in force, or -1 when the saved rule is not one of the list.
+int maipai_tz_current();
+// Saves and applies a zone by list index. False for a bad index.
+bool maipai_tz_set(int index);
+// "HH:MM" for the local time now, or "" while the clock was never set.
+void maipai_tz_local_hhmm(char* out, int cap);
+// Registers self.clock.get, self.clock.set_zone, self.clock.zones and self.clock.set.
+void maipai_tz_register_tools();
