+
+#if CONFIG_MAIPAI_TZ || CONFIG_MAIPAI_NETTEST || CONFIG_MAIPAI_VERSION
+#define MAIPAI_MORE_SCREEN 1
+// Opens the page. The caller holds the LVGL lock.
+void maipai_more_open();
+#else
