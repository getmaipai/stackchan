+inline void maipai_tz_register_tools() {}
+#endif
diff --git a/firmware/main/hal/maipai_tz_core.h b/firmware/main/hal/maipai_tz_core.h
new file mode 100644
--- /dev/null
+++ b/firmware/main/hal/maipai_tz_core.h
@@ -0,0 +1,128 @@
+/*
+ * SPDX-License-Identifier: MIT
+ *
+ * Time zone picker (patch U03): the pure logic. A short list of zones the person picks from by name, each with the
+ * POSIX rule the C library needs (including summer time), and the checks for a clock the host sets. There is no
+ * public time call: the time comes from the paired host (self.clock.set) or from the unit's own clock chip; this
+ * only says how to read it for the person. Header-only plain C99 so a host compiler can test it; the device side is
+ * maipai_tz.cc. Labels are plain ASCII because the screen font has no accents.
+ */
+#ifndef MAIPAI_TZ_CORE_H
+#define MAIPAI_TZ_CORE_H
+
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+
+#define MZ_OK 0
+#define MZ_ERR_ZONE -1
+#define MZ_ERR_TIME -2
+
+typedef struct {
+    const char* id;    /* what the host and the tool use */
+    const char* label; /* what the screen shows */
+    const char* posix; /* the TZ rule */
+} mz_zone_t;
+
+/* West to east. The id is the part of the usual region name a person would recognise. */
+static const mz_zone_t MZ_ZONES[] = {
+    {"pacific_honolulu", "Honolulu", "HST10"},
+    {"america_anchorage", "Anchorage", "AKST9AKDT,M3.2.0,M11.1.0"},
+    {"america_los_angeles", "Los Angeles", "PST8PDT,M3.2.0,M11.1.0"},
+    {"america_denver", "Denver", "MST7MDT,M3.2.0,M11.1.0"},
+    {"america_phoenix", "Phoenix", "MST7"},
+    {"america_chicago", "Chicago", "CST6CDT,M3.2.0,M11.1.0"},
+    {"america_mexico_city", "Mexico City", "CST6"},
+    {"america_new_york", "New York", "EST5EDT,M3.2.0,M11.1.0"},
+    {"america_bogota", "Bogota", "<-05>5"},
+    {"america_halifax", "Halifax", "AST4ADT,M3.2.0,M11.1.0"},
+    {"america_sao_paulo", "Sao Paulo", "<-03>3"},
+    {"atlantic_azores", "Azores", "<-01>1<+00>,M3.5.0/0,M10.5.0/1"},
+    {"utc", "UTC", "UTC0"},
+    {"europe_london", "London", "GMT0BST,M3.5.0/1,M10.5.0"},
+    {"europe_lisbon", "Lisbon", "WET0WEST,M3.5.0/1,M10.5.0"},
+    {"europe_paris", "Paris", "CET-1CEST,M3.5.0,M10.5.0/3"},
+    {"europe_berlin", "Berlin", "CET-1CEST,M3.5.0,M10.5.0/3"},
+    {"europe_madrid", "Madrid", "CET-1CEST,M3.5.0,M10.5.0/3"},
+    {"europe_rome", "Rome", "CET-1CEST,M3.5.0,M10.5.0/3"},
+    {"europe_athens", "Athens", "EET-2EEST,M3.5.0/3,M10.5.0/4"},
+    {"africa_cairo", "Cairo", "EET-2"},
+    {"europe_moscow", "Moscow", "MSK-3"},
+    {"asia_dubai", "Dubai", "<+04>-4"},
+    {"asia_karachi", "Karachi", "PKT-5"},
+    {"asia_kolkata", "Delhi", "IST-5:30"},
+    {"asia_dhaka", "Dhaka", "<+06>-6"},
+    {"asia_bangkok", "Bangkok", "<+07>-7"},
+    {"asia_shanghai", "Beijing", "CST-8"},
+    {"asia_tokyo", "Tokyo", "JST-9"},
+    {"australia_sydney", "Sydney", "AEST-10AEDT,M10.1.0,M4.1.0/3"},
+    {"pacific_auckland", "Auckland", "NZST-12NZDT,M9.5.0,M4.1.0/3"},
+};
+#define MZ_COUNT ((int)(sizeof(MZ_ZONES) / sizeof(MZ_ZONES[0])))
+#define MZ_DEFAULT_ID "utc"
+
+static inline int mz_find(const char* id)
+{
+    if (id == NULL) {
+        return -1;
+    }
+    for (int i = 0; i < MZ_COUNT; i++) {
+        if (strcmp(MZ_ZONES[i].id, id) == 0) {
+            return i;
+        }
+    }
+    return -1;
+}
+
+/* The zone whose TZ rule equals `posix` (the first one when several share it), or -1. The rule the stock setting starts
+ * with, GMT0, is UTC. */
+static inline int mz_find_posix(const char* posix)
+{
+    if (posix == NULL) {
+        return -1;
+    }
+    if (strcmp(posix, "GMT0") == 0) {
+        posix = "UTC0";
+    }
+    for (int i = 0; i < MZ_COUNT; i++) {
+        if (strcmp(MZ_ZONES[i].posix, posix) == 0) {
+            return i;
+        }
+    }
+    return -1;
+}
+
+static inline int mz_default_index(void) { return mz_find(MZ_DEFAULT_ID); }
+
+/* The step up or down the list, wrapping at both ends; the screen's two arrow buttons use it. */
+static inline int mz_step(int index, int delta)
+{
+    const int n = MZ_COUNT;
+    int i = (index + delta) % n;
+    return i < 0 ? i + n : i;
+}
+
+/* A clock set from the host must be a real time: after 1 January 2024 and before 1 January 2100. */
+#define MZ_MIN_EPOCH 1704067200LL
+#define MZ_MAX_EPOCH 4102444800LL
+static inline int mz_epoch_ok(long long epoch) { return epoch >= MZ_MIN_EPOCH && epoch < MZ_MAX_EPOCH; }
+
+/* "UTC-05:00"-style offset words are not needed: the zone label says it. The screen line for the picker. */
+static inline int mz_line(char* out, size_t cap, int index)
+{
+    if (index < 0 || index >= MZ_COUNT) {
+        return snprintf(out, cap, "%s", "Time zone not set");
+    }
+    return snprintf(out, cap, "%s", MZ_ZONES[index].label);
+}
+
+static inline const char* mz_err_word(int err)
+{
+    switch (err) {
+        case MZ_ERR_ZONE: return "that time zone is not in the list: ask for the list and pick a name from it";
+        case MZ_ERR_TIME: return "that time is not a real clock time: send seconds since 1970 between 2024 and 2099";
+        default: return "ok";
+    }
+}
+
+#endif
