diff --git a/firmware/main/hal/maipai_more.cc b/firmware/main/hal/maipai_more.cc
new file mode 100644
--- /dev/null
+++ b/firmware/main/hal/maipai_more.cc
@@ -0,0 +1,222 @@
+/*
+ * SPDX-License-Identifier: MIT
+ *
+ * The "More" screen (patches U03 to U05). One full-screen panel on the top layer, rebuilt for each page (menu, time
+ * zone, network test, version). Text is plain ASCII (the screen font has no accents); English or Spanish by the saved
+ * language. A state is never told by colour alone: the network test prefixes every line with OK, FIX or --.
+ */
+#include <sdkconfig.h>
+#include "maipai_more.h"
+#if MAIPAI_MORE_SCREEN
+#include "maipai_face.h"
+#include "hal.h"
+#include <lvgl.h>
+#include <esp_timer.h>
+#include <cstdio>
+#include <cstring>
+#include <string>
+#include <ctime>
+#if CONFIG_MAIPAI_TZ
+#include "maipai_tz.h"
+#include "maipai_tz_core.h"
+#endif
+
+namespace {
+enum Page { PAGE_MENU = 0, PAGE_TZ, PAGE_NET, PAGE_VERSION };
+
+lv_obj_t* s_root     = nullptr;
+lv_timer_t* s_timer  = nullptr;
+int s_page           = PAGE_MENU;
+bool s_es            = false;
+#if CONFIG_MAIPAI_TZ
+int s_zone           = 0;
+lv_obj_t* s_zone_lbl = nullptr;
+lv_obj_t* s_time_lbl = nullptr;
+lv_obj_t* s_note_lbl = nullptr;
+#endif
+
+const char* tx(const char* en, const char* es)
+{
+    return s_es ? es : en;
+}
+
+uint32_t now_ms()
+{
+    return static_cast<uint32_t>(esp_timer_get_time() / 1000);
+}
+
+void show(int page);
+
+void close_all()
+{
+    if (s_timer != nullptr) {
+        lv_timer_delete(s_timer);
+        s_timer = nullptr;
+    }
+    if (s_root != nullptr) {
+        lv_obj_delete_async(s_root);
+        s_root = nullptr;
+    }
+}
+
+lv_obj_t* label(lv_obj_t* parent, const char* text, const lv_font_t* font)
+{
+    lv_obj_t* l = lv_label_create(parent);
+    lv_obj_set_style_text_font(l, font, 0);
+    lv_obj_set_style_text_color(l, lv_color_white(), 0);
+    lv_label_set_text(l, text);
+    return l;
+}
+
+using Click = void (*)(lv_event_t*);
+
+lv_obj_t* button(lv_obj_t* parent, const char* text, int width_pct, Click on_click, void* user = nullptr)
+{
+    lv_obj_t* b = lv_button_create(parent);
+    lv_obj_set_width(b, LV_PCT(width_pct));
+    lv_obj_set_height(b, 38);
+    lv_obj_t* l = label(b, text, &lv_font_montserrat_16);
+    lv_obj_center(l);
+    lv_obj_add_event_cb(b, on_click, LV_EVENT_CLICKED, user);
+    return b;
+}
+
+// A row that wraps: new buttons start a new line only when asked.
+void new_row(lv_obj_t* o)
+{
+    lv_obj_add_flag(o, LV_OBJ_FLAG_FLEX_IN_NEW_TRACK);
+}
+
+void clear_page()
+{
+    if (s_timer != nullptr) {
+        lv_timer_delete(s_timer);
+        s_timer = nullptr;
+    }
+    lv_obj_clean(s_root);
+#if CONFIG_MAIPAI_TZ
+    s_zone_lbl = s_time_lbl = s_note_lbl = nullptr;
+#endif
+}
+
+void on_back_menu(lv_event_t*) { show(PAGE_MENU); }
+void on_close(lv_event_t*) { close_all(); }
+void on_open_page(lv_event_t* e) { show(static_cast<int>(reinterpret_cast<intptr_t>(lv_event_get_user_data(e)))); }
+
+#if CONFIG_MAIPAI_TZ
+void tz_refresh()
+{
+    if (s_zone_lbl == nullptr) {
+        return;
+    }
+    char line[40];
+    mz_line(line, sizeof(line), s_zone);
+    lv_label_set_text(s_zone_lbl, line);
+    // The time now in the zone that is saved (it changes when Save is pressed, not while picking).
+    char hhmm[8];
+    maipai_tz_local_hhmm(hhmm, sizeof(hhmm));
+    char t[80];
+    if (hhmm[0] != '\0') {
+        snprintf(t, sizeof(t), "%s %s", tx("Saved zone time now:", "Hora ahora en la zona guardada:"), hhmm);
+    } else {
+        snprintf(t, sizeof(t), "%s", tx("The clock is not set yet. Home sets it when it connects.",
+                                       "El reloj aun no esta puesto. La casa lo pone al conectarse."));
+    }
+    lv_label_set_text(s_time_lbl, t);
+}
+
+void tz_tick(lv_timer_t*) { tz_refresh(); }
+void on_tz_prev(lv_event_t*) { s_zone = mz_step(s_zone, -1); tz_refresh(); }
+void on_tz_next(lv_event_t*) { s_zone = mz_step(s_zone, +1); tz_refresh(); }
+void on_tz_save(lv_event_t*)
+{
+    if (maipai_tz_set(s_zone) && s_note_lbl != nullptr) {
+        lv_label_set_text(s_note_lbl, tx("Saved.", "Guardado."));
+    }
+}
+
+void build_tz()
+{
+    s_zone = maipai_tz_current();
+    if (s_zone < 0) {
+        s_zone = mz_default_index();
+    }
+    lv_obj_t* title = label(s_root, tx("Time zone", "Zona horaria"), &lv_font_montserrat_20);
+    lv_obj_set_width(title, LV_PCT(100));
+    lv_obj_set_style_text_align(title, LV_TEXT_ALIGN_CENTER, 0);
+    lv_obj_t* prev = button(s_root, "<", 22, on_tz_prev);
+    new_row(prev);
+    s_zone_lbl = label(s_root, "", &lv_font_montserrat_20);
+    lv_obj_set_width(s_zone_lbl, LV_PCT(48));
+    lv_obj_set_style_text_align(s_zone_lbl, LV_TEXT_ALIGN_CENTER, 0);
+    button(s_root, ">", 22, on_tz_next);
+    s_time_lbl = label(s_root, "", &lv_font_montserrat_16);
+    lv_obj_set_width(s_time_lbl, LV_PCT(100));
+    lv_label_set_long_mode(s_time_lbl, LV_LABEL_LONG_WRAP);
+    lv_obj_set_style_text_align(s_time_lbl, LV_TEXT_ALIGN_CENTER, 0);
+    new_row(s_time_lbl);
+    s_note_lbl = label(s_root, "", &lv_font_montserrat_16);
+    lv_obj_set_width(s_note_lbl, LV_PCT(100));
+    lv_obj_set_style_text_align(s_note_lbl, LV_TEXT_ALIGN_CENTER, 0);
+    new_row(s_note_lbl);
+    lv_obj_t* save = button(s_root, tx("Save", "Guardar"), 48, on_tz_save);
+    new_row(save);
+    button(s_root, tx("Back", "Atras"), 48, on_back_menu);
+    tz_refresh();
+    s_timer = lv_timer_create(tz_tick, 1000, nullptr);
+}
+#endif
+
+
+
+void build_menu()
+{
+    lv_obj_t* title = label(s_root, tx("More", "Mas"), &lv_font_montserrat_20);
+    lv_obj_set_width(title, LV_PCT(100));
+    lv_obj_set_style_text_align(title, LV_TEXT_ALIGN_CENTER, 0);
+#if CONFIG_MAIPAI_TZ
+    new_row(button(s_root, tx("Time zone", "Zona horaria"), 100, on_open_page,
+                   reinterpret_cast<void*>(static_cast<intptr_t>(PAGE_TZ))));
+#endif
+    new_row(button(s_root, tx("Done", "Listo"), 100, on_close));
+}
+
+void show(int page)
+{
+    if (s_root == nullptr) {
+        return;
+    }
+    clear_page();
+    s_page = page;
+    switch (page) {
+#if CONFIG_MAIPAI_TZ
+        case PAGE_TZ: build_tz(); return;
+#endif
+        default: break;
+    }
+    s_page = PAGE_MENU;
+    build_menu();
+}
+}  // namespace
+
+void maipai_more_open()
+{
+    if (s_root != nullptr) {
+        return;
+    }
+    s_es = maipai_face_config().lang == MF_LANG_ES;
+    s_root = lv_obj_create(lv_layer_top());
+    lv_obj_set_size(s_root, lv_pct(100), lv_pct(100));
+    lv_obj_set_style_bg_color(s_root, lv_color_black(), 0);
+    lv_obj_set_style_bg_opa(s_root, LV_OPA_COVER, 0);
+    lv_obj_set_style_border_width(s_root, 0, 0);
+    lv_obj_set_style_radius(s_root, 0, 0);
+    lv_obj_set_style_pad_all(s_root, 8, 0);
+    lv_obj_set_style_pad_row(s_root, 6, 0);
+    lv_obj_set_style_pad_column(s_root, 6, 0);
+    lv_obj_remove_flag(s_root, LV_OBJ_FLAG_SCROLLABLE);
+    lv_obj_set_flex_flow(s_root, LV_FLEX_FLOW_ROW_WRAP);
+    lv_obj_set_flex_align(s_root, LV_FLEX_ALIGN_CENTER, LV_FLEX_ALIGN_CENTER, LV_FLEX_ALIGN_START);
+    show(PAGE_MENU);
+}
+#endif
