# Intent: Bench only (CONFIG_MAIPAI_SERIAL_TOOLS). self.bench.power_probe {move} reads what the unit can tell about its power: the power chip's status, ADC and input-limit registers (decoded and raw), each servo's supply voltage, load, current and temperature from the servo bus, and the sag of the servo supply and of the cable voltage during a small controlled head move, with a plain verdict (unknown, healthy, weak, poor). It changes nothing in the limiter. Memory cost: none in a release image (bench only).
# Placement: unit
# Upstream: firmware/main/hal/hal_servo.cpp, board/stackchan.cc and board/hal_bridge.h (the stock HAL, MIT)
# Check after a flash: self.bench.power_probe answers vbus_mv near 5000 on a cable and near 0 without, vbat_mv near the battery voltage, both servos ok with volts_tenths about 50 to 80, and a sag figure after the small move.
# Kconfig: none new

diff --git a/firmware/main/hal/maipai_power_core.h b/firmware/main/hal/maipai_power_core.h
new file mode 100644
--- /dev/null
+++ b/firmware/main/hal/maipai_power_core.h
@@ -0,0 +1,67 @@
+/*
+ * SPDX-License-Identifier: MIT
+ *
+ * Power readings (patch SF48, bench only): the pure decoding and the sag figure. Plain C99; host test host/tests/firmware/power_core_test.c.
+ * The register layout is the AXP2101's as read by the unit's own code (status 0x01, battery gauge 0xA4, ADC enables 0x30) and the chip's datasheet for
+ * the ADC and input-limit registers: the probe also returns the raw bytes, so every decoding here can be checked against the datasheet on a real unit.
+ *   status 0x00: bit 5 VBUS good, bit 3 battery present.
+ *   status 0x01: bits 6..5 current direction (1 charging, 2 discharging, 0 standby), bits 2..0 charge state.
+ *   ADC (when enabled in 0x30): VBAT 0x34/0x35, VBUS 0x38/0x39, VSYS 0x3A/0x3B: a 14 bit value in millivolts, high byte first (6 bits).
+ *   0x16 input current limit: 0..5 for 100, 500, 900, 1000, 1500, 2000 mA.  0x15 input voltage limit: 3.88 V plus 80 mV a step.
+ *   The servo bus reports the servo's supply in tenths of a volt (a byte).
+ */
+#ifndef MAIPAI_POWER_CORE_H
+#define MAIPAI_POWER_CORE_H
+
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+
+static inline int mpw_adc_mv(uint8_t high, uint8_t low) { return (int)(((unsigned)(high & 0x3f) << 8) | low); }
+static inline int mpw_vbus_good(uint8_t status0) { return (status0 >> 5) & 1; }
+static inline int mpw_battery_present(uint8_t status0) { return (status0 >> 3) & 1; }
+static inline int mpw_direction(uint8_t status1) { return (status1 >> 5) & 3; } /* 1 charging, 2 discharging, 0 standby, 3 invalid */
+static inline int mpw_charge_state(uint8_t status1) { return status1 & 7; }       /* 0 tri-charge, 1 pre, 2 constant current, 3 constant voltage, 4 done, 5 not charging */
+static inline int mpw_input_limit_ma(uint8_t reg16)
+{
+    static const int t[6] = {100, 500, 900, 1000, 1500, 2000};
+    const int i = reg16 & 7;
+    return i < 6 ? t[i] : -1;
+}
+static inline int mpw_vindpm_mv(uint8_t reg15) { return 3880 + 80 * (reg15 & 15); }
+
+/* The sag of a supply during a move: the resting reading minus the lowest reading seen while the move ran, in the reading's own unit. */
+typedef struct {
+    int base;
+    int lowest;
+    int highest;
+    int n;
+} mpw_sag_t;
+
+static inline void mpw_sag_begin(mpw_sag_t* s, int base)
+{
+    s->base = base;
+    s->lowest = base;
+    s->highest = base;
+    s->n = 0;
+}
+static inline void mpw_sag_add(mpw_sag_t* s, int reading)
+{
+    if (reading < 0) return; /* a failed read says nothing */
+    if (reading < s->lowest) s->lowest = reading;
+    if (reading > s->highest) s->highest = reading;
+    s->n++;
+}
+static inline int mpw_sag(const mpw_sag_t* s) { return s->base - s->lowest; }
+
+/* A plain verdict on the supply of a servo from its resting and loaded readings (tenths of a volt): 0 unknown, 1 healthy, 2 weak (sags more than 0.5 V or
+ * rests under 4.5 V), 3 poor (sags more than 1.0 V or rests under 4.0 V). The proposal in docs/plan/two-usb-ports.md; no limiter uses it yet. */
+static inline int mpw_supply_verdict(int rest_tenths, int sag_tenths)
+{
+    if (rest_tenths <= 0) return 0;
+    if (sag_tenths > 10 || rest_tenths < 40) return 3;
+    if (sag_tenths > 5 || rest_tenths < 45) return 2;
+    return 1;
+}
+
+#endif /* MAIPAI_POWER_CORE_H */
