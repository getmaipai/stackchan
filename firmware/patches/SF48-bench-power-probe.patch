+// Patch SF48 (bench): what a servo reports on the bus: supply voltage (tenths of a volt), load (0 to 1000), current (raw units), temperature (degrees) and position.
+// Returns false when the servo does not answer. The caller holds the servo layer's lock (servo_bus_mutex).
+bool maipai_servo_telemetry(int servo_id, int* volts_tenths, int* load, int* current, int* temp, int* pos)
+{
+    if (_scs_bus.FeedBack(servo_id) < 0) return false;
+    *pos          = _scs_bus.ReadPos(-1);
+    *load         = _scs_bus.ReadLoad(-1);
+    *volts_tenths = _scs_bus.ReadVoltage(-1);
+    *temp         = _scs_bus.ReadTemper(-1);
+    *current      = _scs_bus.ReadCurrent(-1);
+    return true;
+}
