+/*
+ * SPDX-License-Identifier: MIT
+ *
+ * Patch SF48 (bench only, CONFIG_MAIPAI_SERIAL_TOOLS): self.bench.power_probe. Reads what the unit can tell about its power: the power chip's status, ADC and
+ * input-limit registers (decoded and raw), each servo's supply voltage, load, current and temperature from the servo bus, and the sag of those readings
+ * during a small controlled head move. It changes nothing in the limiter; it exists to measure which supply the unit is on (a computer's USB, a charger, the
+ * battery). Decoding: maipai_power_core.h (host test).
+ */
+#include <sdkconfig.h>
+
+#if CONFIG_MAIPAI_SERIAL_TOOLS
+#include "maipai_power_core.h"
+#include "board/hal_bridge.h"
+#include <hal/hal.h>
+#include <stackchan/stackchan.h>
+#include <stackchan/motion/servo.h>
+#include <mcp_server.h>
+#include <esp_timer.h>
+#include <freertos/FreeRTOS.h>
+#include <freertos/task.h>
+#include <cstdio>
+#include <string>
+
+extern bool maipai_servo_telemetry(int servo_id, int* volts_tenths, int* load, int* current, int* temp, int* pos);
+
+namespace {
+const char* const kVerdict[4] = {"unknown", "healthy", "weak", "poor"};
+bool read_reg(uint8_t reg, uint8_t* v) { return hal_bridge::board_pmic_read(reg, v); }
+
+int adc_mv(uint8_t high_reg)
+{
+    uint8_t h = 0, l = 0;
+    if (!read_reg(high_reg, &h) || !read_reg(static_cast<uint8_t>(high_reg + 1), &l)) return -1;
+    return mpw_adc_mv(h, l);
+}
+
+struct Servo { int id; bool ok; int volts, load, current, temp, pos; };
+
+Servo read_servo(int id)
+{
+    Servo s{id, false, 0, 0, 0, 0, 0};
+    std::lock_guard<std::recursive_mutex> lock(stackchan::motion::servo_bus_mutex());
+    s.ok = maipai_servo_telemetry(id, &s.volts, &s.load, &s.current, &s.temp, &s.pos);
+    return s;
+}
+}  // namespace
+
+void maipai_powerprobe_register_tools()
+{
+    auto& mcp = McpServer::GetInstance();
+    mcp.AddTool("self.bench.power_probe",
+                "Bench only: what the unit can tell about its power supply. Answers the power chip's status (vbus_good, battery_present, direction, charge_state), "
+                "vbus_mv, vbat_mv and vsys_mv from its ADC, the input current and voltage limits, the raw bytes of the registers read (regs: [register, value] pairs, to check "
+                "the decoding against the datasheet), each servo's bus telemetry (volts in tenths, load, current, temperature, position) and, when move is 1 and the movement "
+                "limiter allows it, the sag of the servo supply and of the cable voltage during a small yaw move of 15 degrees (the head returns): sag_servo_tenths, "
+                "sag_vbus_mv, lowest and highest readings and a plain supply verdict (unknown, healthy, weak, poor). The battery current is not measured by this chip: only "
+                "its direction. Run it with no cable, with the side port, with the back port and with a charger, and compare.",
+                PropertyList({Property("move", kPropertyTypeInteger, 1, 0, 1)}),
+                [](const PropertyList& properties) -> ReturnValue {
+                    uint8_t r00 = 0, r01 = 0, r15 = 0, r16 = 0, r30 = 0;
+                    const bool ok0 = read_reg(0x00, &r00), ok1 = read_reg(0x01, &r01), ok15 = read_reg(0x15, &r15), ok16 = read_reg(0x16, &r16), ok30 = read_reg(0x30, &r30);
+                    const int vbus = adc_mv(0x38), vbat = adc_mv(0x34), vsys = adc_mv(0x3A);
+                    const Servo y0 = read_servo(1), p0 = read_servo(2);
+                    mpw_sag_t sag_servo, sag_vbus;
+                    mpw_sag_begin(&sag_servo, y0.ok ? y0.volts : 0);
+                    mpw_sag_begin(&sag_vbus, vbus < 0 ? 0 : vbus);
+                    bool moved = false;
+                    int worst_load = 0, worst_current = 0;
+                    if (properties["move"].value<int>() == 1 && y0.ok) {
+                        {
+                            LvglLockGuard lock;
+                            auto& motion = GetStackChan().motion();
+                            const int start = motion.yawServo().getCurrentAngle();
+                            motion.yawServo().moveWithSpeed(start + 150, 300);
+                            moved = true;
+                        }
+                        const int64_t t0 = esp_timer_get_time();
+                        while (esp_timer_get_time() - t0 < 1200000) {
+                            const Servo s = read_servo(1);
+                            if (s.ok) {
+                                mpw_sag_add(&sag_servo, s.volts);
+                                if (s.load > worst_load) worst_load = s.load;
+                                if (s.current > worst_current) worst_current = s.current;
+                            }
+                            const int v = adc_mv(0x38);
+                            mpw_sag_add(&sag_vbus, v);
+                            vTaskDelay(pdMS_TO_TICKS(30));
+                        }
+                        {
+                            LvglLockGuard lock;
+                            auto& motion = GetStackChan().motion();
+                            motion.yawServo().moveWithSpeed(motion.yawServo().getCurrentAngle() - 150, 300);
+                        }
+                    }
+                    char out[900];
+                    std::snprintf(
+                        out, sizeof(out),
+                        "{\"ok\":true,\"pmic\":{\"read\":%s,\"vbus_good\":%d,\"battery_present\":%d,\"direction\":%d,\"charge_state\":%d,\"adc_enabled_0x30\":%d,"
+                        "\"vbus_mv\":%d,\"vbat_mv\":%d,\"vsys_mv\":%d,\"input_limit_ma\":%d,\"vindpm_mv\":%d,"
+                        "\"regs\":[[\"0x00\",%u],[\"0x01\",%u],[\"0x15\",%u],[\"0x16\",%u],[\"0x30\",%u]]},"
+                        "\"servo\":[{\"id\":1,\"ok\":%s,\"volts_tenths\":%d,\"load\":%d,\"current\":%d,\"temp\":%d,\"pos\":%d},"
+                        "{\"id\":2,\"ok\":%s,\"volts_tenths\":%d,\"load\":%d,\"current\":%d,\"temp\":%d,\"pos\":%d}],"
+                        "\"move\":{\"done\":%s,\"samples\":%d,\"sag_servo_tenths\":%d,\"servo_lowest_tenths\":%d,\"sag_vbus_mv\":%d,\"vbus_lowest_mv\":%d,"
+                        "\"worst_load\":%d,\"worst_current\":%d,\"verdict\":\"%s\"}}",
+                        (ok0 && ok1) ? "true" : "false", mpw_vbus_good(r00), mpw_battery_present(r00), mpw_direction(r01), mpw_charge_state(r01), ok30 ? r30 : -1, vbus, vbat, vsys,
+                        ok16 ? mpw_input_limit_ma(r16) : -1, ok15 ? mpw_vindpm_mv(r15) : -1, ok0 ? r00 : 0u, ok1 ? r01 : 0u, ok15 ? r15 : 0u, ok16 ? r16 : 0u, ok30 ? r30 : 0u,
+                        y0.ok ? "true" : "false", y0.volts, y0.load, y0.current, y0.temp, y0.pos, p0.ok ? "true" : "false", p0.volts, p0.load, p0.current, p0.temp, p0.pos,
+                        moved ? "true" : "false", sag_servo.n, mpw_sag(&sag_servo), sag_servo.lowest, mpw_sag(&sag_vbus), sag_vbus.lowest, worst_load, worst_current,
+                        kVerdict[mpw_supply_verdict(sag_servo.base, mpw_sag(&sag_servo))]);
+                    return std::string(out);
+                });
+}
+#endif
