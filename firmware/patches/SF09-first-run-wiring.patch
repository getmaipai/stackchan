# Intent: Wires the first-run flow (screens from patch UX05b). At the first standby of a unit with no saved answers it starts the flow under the screen lock, applies and saves the language, saves the answers (language, name 0 to 5, mode home or own) so the flow never shows again, and pushes a first_run_done event for the host. Adds maipai_face_set_lang. Wi-Fi setup stays with the existing setup cover.
# Placement: unit
# Upstream: firmware/main/hal (ours)
# Check after a flash: on a unit with no saved record the flow shows once after Wi-Fi is joined; after the last step the language and name are kept across a restart and the flow does not return; self.device.get_events shows first_run_done once.
# Kconfig: none

diff --git a/firmware/main/hal/maipai_face.cc b/firmware/main/hal/maipai_face.cc
--- a/firmware/main/hal/maipai_face.cc
+++ b/firmware/main/hal/maipai_face.cc
@@ -778,6 +778,25 @@ bool maipai_face_set_style(int style)
     return true;
 }
 
+bool maipai_face_set_lang(int lang)
+{
+    if (lang < 0 || lang >= MF_LANG_COUNT) {
+        return false;
+    }
+    mf_config_t next = maipai_face_config();
+    if (next.lang == lang) {
+        return true;
+    }
+    next.lang = static_cast<uint8_t>(lang);
+    {
+        std::lock_guard<std::mutex> lock(s_mutex);
+        s_cfg = next;
+    }
+    apply(current_face(), next);  // the caller holds the LVGL lock
+    Application::GetInstance().Schedule([next]() { save(next); });  // flash is written on the main task
+    return true;
+}
+
 void maipai_face_register_tools()
 {
     auto& mcp = McpServer::GetInstance();
