@@ -0,0 +1,4 @@
+#pragma once
+// Patch SF09: the first-run flow (screens from patch UX05b) is started once, at the first standby of a unit that has no saved answers.
+// Called about every 20 ms from the update loop; it costs one flag read once the record exists.
+void maipai_firstrun_boot_poll(bool xiaozhi_ready);
diff --git a/firmware/main/hal/maipai_firstrun_wire.cc b/firmware/main/hal/maipai_firstrun_wire.cc
new file mode 100644
--- /dev/null
+++ b/firmware/main/hal/maipai_firstrun_wire.cc
@@ -0,0 +1,77 @@
+/*
+ * SPDX-License-Identifier: MIT
+ *
+ * Patch SF09: wires the first-run flow. It starts at the first standby of a unit with no saved answers, hands Wi-Fi to the existing
+ * setup cover, saves the answers (language, name 0 to 5, mode 0 home or 1 own) so the flow never shows again, applies the language,
+ * and tells the host through a first_run_done event.
+ */
+#include "maipai_firstrun_wire.h"
+#include "maipai_firstrun.h"
+#include "hal.h"
+#include "maipai_face.h"
+#include "device_events.h"
+#include "board/hal_bridge.h"
+#include <application.h>
+#include <settings.h>
+#include <ssid_manager.h>
+#include <esp_log.h>
+#include <atomic>
+#include <cstdio>
+
+namespace {
+
+const char* const kTag = "MaipaiFirstRun";
+std::atomic<bool> s_checked{false};
+
+bool record_exists()
+{
+    Settings st("mp_firstrun", false);
+    return st.GetInt("done", 0) != 0;
+}
+
+bool wifi_set() { return !SsidManager::GetInstance().GetSsidList().empty(); }
+
+bool hub_known()
+{
+    Settings st("websocket", false);
+    return !st.GetString("url").empty();
+}
+
+void apply_language(int lang) { maipai_face_set_lang(lang); }  // runs under the LVGL lock (a screen callback)
+
+void open_wifi_setup()
+{
+    // The base opens its setup cover by itself while no network is saved; the flow waits for it and is told by maipai_firstrun_wifi_done().
+    ESP_LOGI(kTag, "first run: Wi-Fi setup is handed to the setup cover");
+}
+
+void finished(int lang, int name, int mode)
+{
+    // A screen callback: LVGL lock held. The flash is written on the main task.
+    maipai_face_set_lang(lang);
+    Application::GetInstance().Schedule([lang, name, mode]() {
+        Settings st("mp_firstrun", true);
+        st.SetInt("lang", lang);
+        st.SetInt("name", name);
+        st.SetInt("mode", mode);
+        st.SetInt("done", 1);
+        char extra[64];
+        std::snprintf(extra, sizeof(extra), "\"lang\":%d,\"name\":%d,\"mode\":%d", lang, name, mode);
+        device_events_push("first_run_done", extra);
+        ESP_LOGI(kTag, "first run done: lang %d, name %d, mode %d", lang, name, mode);
+    });
+}
+
+}  // namespace
+
+void maipai_firstrun_boot_poll(bool xiaozhi_ready)
+{
+    if (s_checked.load() || !xiaozhi_ready) return;
+    s_checked.store(true);
+    if (record_exists()) return;  // answered before: never again
+    static const maipai_firstrun_host_t host = {wifi_set, hub_known, apply_language, open_wifi_setup, finished};
+    LvglLockGuard lock;
+    maipai_firstrun_init(&host);
+    maipai_firstrun_start();
+    ESP_LOGI(kTag, "first run started");
+}
