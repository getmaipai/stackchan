+static std::atomic<bool> g_hub_link_up{false};
+static std::atomic<bool> g_offline_shown{false};
+
+void hal_bridge::set_hub_link(bool up)
+{
+    if (g_hub_link_up.exchange(up) == up) {
+        return;
+    }
+    // Re-apply the Wi-Fi power save level for the new link state.
+    static_cast<M5StackCoreS3Board&>(Board::GetInstance()).ApplyWifiLevel();
+}
+
+bool hal_bridge::hub_link_up()
+{
+    return g_hub_link_up.load();
+}
+
+void hal_bridge::offline_indicator(bool on)
+{
+    g_offline_shown = on;
+    hal_bridge::leds_offline(on);
+    auto display = Board::GetInstance().GetDisplay();
+    if (display != nullptr) {
+        display->SetChatMessage("system", on ? "Offline" : "");
+    }
+}
+
+void hal_bridge::offline_indicator_refresh()
+{
+    auto display = Board::GetInstance().GetDisplay();
+    if (display != nullptr) {
+        display->SetChatMessage("system", g_offline_shown.load() ? "Offline" : "");
+    }
+}
