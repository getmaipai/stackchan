+namespace {
+// Patch SF42: one reply task for say_test (rounds 0) and barge_test (rounds > 0).
+struct SpeechArgs { int seconds; bool no_barge; bool silent; int rounds; int gap_ms; };
+
+void bench_speech_task(void* arg)
+{
+    SpeechArgs* args = static_cast<SpeechArgs*>(arg);
+    auto& app = Application::GetInstance();
+    auto& audio = app.GetAudioService();
+    const uint8_t saved_volume = hal_bridge::board_get_speaker_volume();
+    if (args->silent) {
+        s_ref.buf = static_cast<int16_t*>(heap_caps_calloc(RefRing::kCap, sizeof(int16_t), MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT));
+        if (s_ref.buf == nullptr) {
+            printf("MaipaiBarge bench: no memory for the reference ring; run without silent\n");
+            args->silent = false;
+        } else {
+            s_ref.w.store(0);
+            s_ref.r.store(0);
+            s_ref.active.store(true);
+            hal_bridge::board_set_speaker_volume(0, false);
+        }
+    }
+    const int rounds = args->rounds > 0 ? args->rounds : 1;
+    for (int round = 1; round <= rounds; round++) {
+        maipai_barge_tts_start();
+        audio.SetSpeechOpen(true);
+        app.SetDeviceState(kDeviceStateSpeaking);
+        if (args->no_barge) maipai_barge_no_barge(static_cast<uint32_t>(args->seconds) * 1000u);
+        const int64_t t0 = esp_timer_get_time();
+        const int64_t end_us = t0 + static_cast<int64_t>(args->seconds) * 1000000;
+        bool hit1 = false, hit2 = false;
+        int64_t hit2_us = 0;
+        // 60 ms slices, like the frames of a real reply: one long block would hold the speaker write for its whole length and an
+        // interruption could not cut it.
+        int q = 1;
+        uint32_t pos = 0;
+        while (esp_timer_get_time() < end_us && app.GetDeviceState() == kDeviceStateSpeaking) {
+            const int64_t el = (esp_timer_get_time() - t0) / 1000;
+            if (args->rounds > 0) {
+                if (!hit1 && el >= 1500) { hit1 = true; app.BenchInjectWakeHit(); }
+                if (hit1 && !hit2 && el >= 1500 + args->gap_ms) { hit2 = true; hit2_us = esp_timer_get_time(); app.BenchInjectWakeHit(); }
+            }
+            if (g_bench_clip_count <= 1) break;
+            const uint32_t left = g_bench_clip_len[q] - pos;
+            const uint32_t n = left < 960u ? left : 960u;
+            if (audio.PlayPcm(&g_bench_clips[g_bench_clip_off[q] + pos], n, 16000)) {
+                if (args->silent && s_ref.buf != nullptr) {
+                    uint32_t w = s_ref.w.load();
+                    for (uint32_t k = 0; k < n; k++) s_ref.buf[w++ % RefRing::kCap] = g_bench_clips[g_bench_clip_off[q] + pos + k];
+                    s_ref.w.store(w);
+                }
+                pos += n;
+                if (pos >= g_bench_clip_len[q]) {
+                    pos = 0;
+                    q = q + 1 < g_bench_clip_count - 1 ? q + 1 : 1;
+                }
+            } else {
+                vTaskDelay(pdMS_TO_TICKS(20));
+            }
+        }
+        const bool interrupted = app.GetDeviceState() != kDeviceStateSpeaking;
+        if (args->silent) s_ref.r.store(s_ref.w.load());  // the reply was dropped: the injected reference goes quiet with it
+        if (args->rounds > 0) {
+            const int ms_after = hit2 ? static_cast<int>((esp_timer_get_time() - hit2_us) / 1000) : -1;
+            printf("MaipaiBarge round=%d interrupted=%d ms=%d\n", round, interrupted ? 1 : 0, ms_after);
+        }
+        if (!interrupted) {
+            while (!audio.IsPlaybackIdle()) vTaskDelay(pdMS_TO_TICKS(100));
+        }
+        audio.ResetDecoder();
+        audio.SetSpeechOpen(false);
+        if (app.GetDeviceState() != kDeviceStateIdle) app.SetDeviceState(kDeviceStateIdle);
+        if (round < rounds) vTaskDelay(pdMS_TO_TICKS(2000));
+    }
+    if (args->silent && s_ref.buf != nullptr) {
+        s_ref.active.store(false);
+        vTaskDelay(pdMS_TO_TICKS(50));
+        heap_caps_free(s_ref.buf);
+        s_ref.buf = nullptr;
+        hal_bridge::board_set_speaker_volume(saved_volume, false);
+    }
+    delete args;
+}
+
+std::atomic<bool> s_speech_busy{false};
+
+std::string bench_start_speech_task(int seconds, bool no_barge, bool silent, int rounds, int gap_ms, int)
+{
+    if (s_speech_busy.exchange(true)) return "{\"ok\":false,\"error\":\"a reply test is already running: wait for it to end\"}";
+    auto* a = new SpeechArgs{seconds, no_barge, silent, rounds, gap_ms};
+    const BaseType_t rc = xTaskCreate([](void* arg) { bench_speech_task(arg); s_speech_busy.store(false); vTaskDelete(nullptr); }, "bench_say", 4096, a, 3, nullptr);
+    if (rc != pdPASS) {
+        delete a;
+        s_speech_busy.store(false);
+        return "{\"ok\":false,\"error\":\"no memory for the test task: try again after the unit is idle\"}";
+    }
+    return "{\"ok\":true}";
+}
+}  // namespace
