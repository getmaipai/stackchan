+        const size_t nf = data.size() / static_cast<size_t>(channels);
+        uint32_t r = s_ref.r.load();
+        const uint32_t w = s_ref.w.load();
+        for (size_t f = 0; f < nf; f++) {
+            data[f * channels + 1] = r != w ? s_ref.buf[r++ % RefRing::kCap] : 0;
+        }
+        s_ref.r.store(r);
+    }
