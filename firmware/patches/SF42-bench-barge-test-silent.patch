+// Patch SF42: the echo reference injected digitally (speaker volume 0): what the reply plays is also written here and read back as the loopback
+// channel of the microphone path in real time. One writer (the reply task), one reader (the audio input task).
+struct RefRing {
+    static constexpr uint32_t kCap = 16384;
+    int16_t* buf = nullptr;
+    std::atomic<uint32_t> w{0}, r{0};
+    std::atomic<bool> active{false};
+} s_ref;
+}  // namespace
