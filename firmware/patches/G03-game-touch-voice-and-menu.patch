+void on_game(lv_event_t* e)
+{
+    const int index = static_cast<int>(reinterpret_cast<intptr_t>(lv_event_get_user_data(e)));
+    const std::string id = maipai_games_id(index);
+    const char* why = maipai_games_start_locked(id.c_str(), "touch");
+    if (why[0] != '\0') {
+        if (s_game_note != nullptr) {
+            lv_label_set_text(s_game_note, why);
+        }
+        return;
+    }
+    close_all();
+    maipai_quick_settings_close();
