+/* ---- the control sheet's tile icons (patch UI05): the same 24 by 24 shapes, drawn instead of words ---- */
+static inline int mpg_sheet_icon_shapes(int item, mpg_shape_t* s)
+{
+    int n = 0;
+#define SH(k, X, Y, W, H) do { s[n].kind = (k); s[n].x = (X); s[n].y = (Y); s[n].w = (W); s[n].h = (H); n++; } while (0)
+    switch (item) {
+        case MPG_S_MUTE: /* a speaker and one sound wave */
+            SH(MPG_SH_ROUND, 1, 9, 6, 6);
+            SH(MPG_SH_ROUND, 6, 4, 5, 16);
+            SH(MPG_SH_RING, 9, 5, 14, 14);
+            SH(MPG_SH_CUT, 9, 3, 5, 18);
+            SH(MPG_SH_ROUND, 6, 4, 5, 16);
+            break;
+        case MPG_S_QUIET: /* a crescent moon */
+            SH(MPG_SH_CIRCLE, 3, 3, 18, 18);
+            SH(MPG_SH_CUTC, 8, 0, 16, 16);
+            break;
+        case MPG_S_LIGHT: return mpg_icon_shapes(MPG_I_LAMP, s);
+        case MPG_S_TIMERS: /* a clock face with two hands */
+            SH(MPG_SH_RING, 1, 2, 21, 21);
+            SH(MPG_SH_ROUND, 11, 6, 2, 8);
+            SH(MPG_SH_ROUND, 11, 12, 7, 2);
+            SH(MPG_SH_ROUND, 9, 0, 6, 2);
+            break;
+        case MPG_S_GAMES: /* a die showing five: a rounded square with five holes (the game pad was not liked, patch UI09) */
+            SH(MPG_SH_ROUND, 2, 2, 20, 20);
+            SH(MPG_SH_CUTC, 5, 5, 4, 4);
+            SH(MPG_SH_CUTC, 15, 5, 4, 4);
+            SH(MPG_SH_CUTC, 10, 10, 4, 4);
+            SH(MPG_SH_CUTC, 5, 15, 4, 4);
+            SH(MPG_SH_CUTC, 15, 15, 4, 4);
+            break;
+        default: /* MPG_S_COUNT, the last tile: a gear (patch UI05: the "More" tile opens the bot's own settings) */
+            SH(MPG_SH_RING, 5, 5, 14, 14);
+            SH(MPG_SH_ROUND, 10, 0, 4, 5);
+            SH(MPG_SH_ROUND, 10, 19, 4, 5);
+            SH(MPG_SH_ROUND, 0, 10, 5, 4);
+            SH(MPG_SH_ROUND, 19, 10, 5, 4);
+            SH(MPG_SH_CIRCLE, 3, 3, 5, 5);
+            SH(MPG_SH_CIRCLE, 16, 3, 5, 5);
+            SH(MPG_SH_CIRCLE, 3, 16, 5, 5);
+            SH(MPG_SH_CIRCLE, 16, 16, 5, 5);
+            break;
+    }
+#undef SH
+    return n;
+}
