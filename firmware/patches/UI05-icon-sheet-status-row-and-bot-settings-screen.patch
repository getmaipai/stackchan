+// A toggle tile: the icon in the tile's colors, inverted while it is on (a state is never told by color alone: the tile fills).
+void paint_tile(lv_obj_t* b, int item, bool on)
+{
+    lv_obj_clean(b);
+    lv_obj_set_style_bg_color(b, on ? fg(100) : fg(16), 0);
+    const lv_color_t bg = on ? fg(100) : fg(16);
+    mpg_shape_t sh[MPG_ICON_SHAPES_MAX];
+    draw_shapes(b, sh, mpg_sheet_icon_shapes(item, sh), (MPG_TILE_W - 24) / 2, (MPG_TILE_H - 24) / 2, 1, on ? lv_color_black() : fg(100), bg);
