+/* ---- the bot's own settings screen (patch UI05): the face style picker with a preview, the status icons switch ---- */
+/* Style ids are the unit's MF_STYLE_* values (maipai_face_core.h); the order is the order of the tiles. */
+#define MPG_SET_STYLES 5
+static const uint8_t MPG_SET_STYLE_ID[MPG_SET_STYLES] = {1 /* big eyes */, 9 /* eyes only */, 10 /* stock */, 0 /* classic */, 2 /* minimal */};
+static const char* const MPG_SET_STYLE_NAME[2][MPG_SET_STYLES] = {
+    {"Big eyes", "Eyes only", "Stock", "Classic", "Minimal"},
+    {"Ojos grandes", "Solo ojos", "Original", "Clasica", "Minima"},
+};
+#define MPG_SET_TILES_MAX (MPG_SET_STYLES + 1)  /* the sixth tile is the picture faces, only while a picture pack is held */
+typedef struct {
+    int16_t x, y, w, h;
+} mpg_box_t;
+/* The screen is 320 by 240: a fixed top (grabber, title, Wi-Fi and Done targets), the preview and the style tiles, the switch row. */
+static inline mpg_box_t mpg_set_wifi_box(void) { mpg_box_t b = {96, 8, 104, 44}; return b; }
+static inline mpg_box_t mpg_set_done_box(void) { mpg_box_t b = {204, 8, 108, 44}; return b; }
+static inline mpg_box_t mpg_set_preview_box(void) { mpg_box_t b = {8, 56, 112, 90}; return b; }
+static inline mpg_box_t mpg_set_tile_box(int i) { mpg_box_t b = {(int16_t)(128 + (i % 2) * 92), (int16_t)(56 + (i / 2) * 46), 90, 44}; return b; }
+static inline mpg_box_t mpg_set_switch_box(void) { mpg_box_t b = {8, 194, 198, 44}; return b; }   /* patch UI09: the More button takes the right part of the row */
+static inline mpg_box_t mpg_set_more_box(void) { mpg_box_t b = {210, 194, 102, 44}; return b; }
+/* A style's schematic face in the preview box (112 by 90): kind 0 circle, 1 rounded rectangle; x y w h and the radius. */
+typedef struct {
+    uint8_t kind;
+    int8_t x, y, w, h, r;
+} mpg_pshape_t;
+#define MPG_PSHAPES_MAX 3
+static inline int mpg_set_preview_shapes(int style_id, mpg_pshape_t* s)
+{
+    int n = 0;
+#define PS(k, X, Y, W, H, R) do { s[n].kind = (k); s[n].x = (X); s[n].y = (Y); s[n].w = (W); s[n].h = (H); s[n].r = (R); n++; } while (0)
+    switch (style_id) {
+        case 9: /* eyes only: the big eyes with no mouth */
+            PS(1, 18, 22, 30, 34, 10);
+            PS(1, 64, 22, 30, 34, 10);
+            break;
+        case 10: /* stock: small round eyes and a small mouth */
+            PS(0, 22, 28, 18, 18, 9);
+            PS(0, 72, 28, 18, 18, 9);
+            PS(1, 44, 62, 24, 4, 2);
+            break;
+        case 0: /* classic: round eyes, a wider mouth */
+            PS(0, 14, 16, 34, 34, 17);
+            PS(0, 64, 16, 34, 34, 17);
+            PS(1, 36, 68, 40, 6, 3);
+            break;
+        case 2: /* minimal: two dots */
+            PS(0, 30, 36, 10, 10, 5);
+            PS(0, 72, 36, 10, 10, 5);
+            break;
+        default: /* big eyes (the default) */
+            PS(1, 18, 20, 30, 34, 10);
+            PS(1, 64, 20, 30, 34, 10);
+            PS(1, 40, 68, 32, 6, 3);
+            break;
+    }
+#undef PS
+    return n;
+}
