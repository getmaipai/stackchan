+// ---- the bot's own settings screen (patch UI05) ----
+struct SetUi {
+    lv_obj_t* tile[MPG_SET_TILES_MAX];
+    int n;
+    lv_obj_t* prev;
+    lv_obj_t* sw;
+    lv_obj_t* sw_lbl;
+    int cur_style;
+    bool icons;
+};
+SetUi* s_su = nullptr;
+
+void drop_settings()
+{
+    if (s_set != nullptr) {
+        lv_obj_delete_async(s_set);
+        s_set = nullptr;
+    }
+    delete s_su;
+    s_su = nullptr;
+    s_set_a.store(false);
+    maipai_screen_closed(MSCR_SETTINGS);
+}
+
+void close_settings_screen()  // the manager's way to close it when another screen opens
+{
+    drop_settings();
+    publish();
+}
+
+lv_obj_t* set_button(lv_obj_t* parent, const mpg_box_t& b, bool on)
+{
+    lv_obj_t* o = box(parent, b.x, b.y, b.w, b.h, on ? fg(100) : fg(16), 10, true);
+    lv_obj_set_style_border_width(o, 1, 0);
+    lv_obj_set_style_border_color(o, fg(40), 0);
+    lv_obj_set_style_bg_color(o, fg(45), LV_STATE_PRESSED);
+    return o;
+}
+
+void set_paint_preview()
+{
+    if (s_su == nullptr) {
+        return;
+    }
+    lv_obj_clean(s_su->prev);
+    mpg_pshape_t sh[MPG_PSHAPES_MAX];
+    const int n = mpg_set_preview_shapes(s_su->cur_style, sh);
+    for (int i = 0; i < n; i++) {
+        box(s_su->prev, sh[i].x, sh[i].y, sh[i].w, sh[i].h, fg(100), sh[i].r);
+    }
+}
+
+void set_paint_tiles()
+{
+    if (s_su == nullptr) {
+        return;
+    }
+    for (int i = 0; i < s_su->n; i++) {
+        const bool on = i < MPG_SET_STYLES && MPG_SET_STYLE_ID[i] == s_su->cur_style;
+        lv_obj_set_style_bg_color(s_su->tile[i], on ? fg(100) : fg(16), 0);
+        lv_obj_t* l = lv_obj_get_child(s_su->tile[i], 0);
+        if (l != nullptr) {
+            lv_obj_set_style_text_color(l, on ? lv_color_black() : fg(100), 0);
+        }
+    }
+}
+
+void set_paint_switch()
+{
+    if (s_su == nullptr) {
+        return;
+    }
+    lv_obj_set_style_bg_color(s_su->sw, s_su->icons ? fg(100) : fg(16), 0);
+    char t[48];
+    snprintf(t, sizeof(t), "%s: %s", tx("Status icons", "Iconos de estado"), s_su->icons ? tx("on", "si") : tx("off", "no"));
+    lv_label_set_text(s_su->sw_lbl, t);
+    lv_obj_set_style_text_color(s_su->sw_lbl, s_su->icons ? lv_color_black() : fg(100), 0);
+    lv_obj_center(s_su->sw_lbl);
+}
+
+void on_set_style(lv_event_t* e)
+{
+    const int i = static_cast<int>(reinterpret_cast<intptr_t>(lv_event_get_user_data(e)));
+    if (i >= MPG_SET_STYLES) {  // the picture faces: show them on the pictures page
+        drop_settings();
+        maipai_pages_show(MPG_P_FRAME);
+        return;
+    }
+    s_su->cur_style = MPG_SET_STYLE_ID[i];
+    s_host->set_face_style(s_su->cur_style);
+    set_paint_preview();
+    set_paint_tiles();
+}
+
+void on_set_switch(lv_event_t*)
+{
+    s_su->icons = !s_su->icons;
+    s_host->set_status_icons(s_su->icons);
+    set_paint_switch();
+}
+
+void on_set_close(lv_event_t*)
+{
+    drop_settings();
+    publish();
+}
+
+void on_set_wifi(lv_event_t*)
+{
+    drop_settings();
+    publish();
+    s_host->open_wifi();  // the Wi-Fi page: only Wi-Fi content
+}
+
+void on_set_more(lv_event_t*)
+{
+    drop_settings();
+    publish();
+    s_host->open_more();  // the More screens
+}
+
+void on_set_gesture(lv_event_t*)
+{
+    if (lv_indev_get_gesture_dir(lv_indev_active()) == LV_DIR_BOTTOM) {
+        on_set_close(nullptr);
+    }
+}
+
+void build_settings()
+{
+    maipai_screen_register(MSCR_SETTINGS, close_settings_screen);
+    maipai_screen_open(MSCR_SETTINGS);  // one overlay screen at a time: whatever else was up closes first
+    drop_settings();
+    maipai_screen_open(MSCR_SETTINGS);
+    s_su = new (std::nothrow) SetUi();
+    if (s_su == nullptr) {
+        return;
+    }
+    memset(s_su, 0, sizeof(*s_su));
+    s_su->cur_style = s_host->face_style();
+    s_su->icons     = s_host->status_icons();
+    lv_obj_t* r = box(lv_layer_top(), 0, 0, 320, 240, lv_color_black(), 0, true);
+    s_set = r;
+    box(r, 136, 3, 48, 5, fg(70), 3);  // the grabber handle: a swipe down closes the screen
+    lv_obj_t* t = text(r, tx("Settings", "Ajustes"), kMid, fg(100));
+    lv_obj_set_pos(t, 8, 18);
+    mpg_box_t wb = mpg_set_wifi_box();
+    lv_obj_t* wifi = set_button(r, wb, false);
+    lv_obj_center(text(wifi, "Wi-Fi", kMid, fg(100)));
+    lv_obj_add_event_cb(wifi, on_set_wifi, LV_EVENT_CLICKED, nullptr);
+    mpg_box_t db = mpg_set_done_box();
+    lv_obj_t* done = set_button(r, db, false);
+    lv_obj_center(text(done, tx("Done", "Listo"), kMid, fg(100)));
+    lv_obj_add_event_cb(done, on_set_close, LV_EVENT_CLICKED, nullptr);
+    mpg_box_t pb = mpg_set_preview_box();
+    s_su->prev   = box(r, pb.x, pb.y, pb.w, pb.h, fg(8), 12);
+    lv_obj_set_style_border_width(s_su->prev, 1, 0);
+    lv_obj_set_style_border_color(s_su->prev, fg(40), 0);
+    s_su->n = MPG_SET_STYLES + (s_host->pictures_held() ? 1 : 0);
+    for (int i = 0; i < s_su->n; i++) {
+        lv_obj_t* b = set_button(r, mpg_set_tile_box(i), false);
+        const char* name = i < MPG_SET_STYLES ? MPG_SET_STYLE_NAME[es() ? 1 : 0][i] : tx("Pictures", "Fotos");
+        lv_obj_t* l = text(b, name, fit_font(name, 80) == kBig ? kMid : fit_font(name, 80), fg(100));
+        lv_obj_center(l);
+        s_su->tile[i] = b;
+        lv_obj_add_event_cb(b, on_set_style, LV_EVENT_CLICKED, reinterpret_cast<void*>(static_cast<intptr_t>(i)));
+    }
+    s_su->sw     = set_button(r, mpg_set_switch_box(), false);
+    s_su->sw_lbl = text(s_su->sw, "", kSmall, fg(100));
+    lv_obj_t* more = set_button(r, mpg_set_more_box(), false);
+    lv_obj_center(text(more, tx("More", "Mas"), kMid, fg(100)));
+    lv_obj_add_event_cb(more, on_set_more, LV_EVENT_CLICKED, nullptr);
+    lv_obj_add_event_cb(s_su->sw, on_set_switch, LV_EVENT_CLICKED, nullptr);
+    lv_obj_add_event_cb(r, on_set_gesture, LV_EVENT_GESTURE, nullptr);
+    set_paint_preview();
+    set_paint_tiles();
+    set_paint_switch();
+    s_g.last_touch_ms = now_ms();
+    ensure_timer();
+    publish();
+}
