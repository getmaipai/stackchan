+void sheet_clock_text(char* out, size_t n)
+{
+    struct tm t = {};
+    if (!s_host->local_time(&t)) {
+        snprintf(out, n, "--:--");
+    } else if (s_host->clock24()) {
+        snprintf(out, n, "%02d:%02d", t.tm_hour, t.tm_min);
+    } else {
+        snprintf(out, n, "%d:%02d", t.tm_hour % 12 == 0 ? 12 : t.tm_hour % 12, t.tm_min);
+    }
+}
