diff --git a/firmware/main/hal/maipai_mood.cc b/firmware/main/hal/maipai_mood.cc
new file mode 100644
--- /dev/null
+++ b/firmware/main/hal/maipai_mood.cc
@@ -0,0 +1,196 @@
+/*
+ * SPDX-License-Identifier: MIT
+ *
+ * Mood that depends on care, device side (patch M01). The rules are the plain-C core; this file reads the clock,
+ * keeps the 8-byte record in its own NVS namespace, and asks the face to redraw when the look changes. It writes at
+ * most once every 15 minutes (and at a day change), so flash wear stays far below the limit. No task, no timer.
+ */
+#include "maipai_mood.h"
+
+#if CONFIG_MAIPAI_MOOD
+#include "maipai_mood_core.h"
+#include "device_events.h"
+#include "board/hal_bridge.h"
+#include <esp_log.h>
+#include <esp_timer.h>
+#include <mcp_server.h>
+#include <nvs.h>
+#include <nvs_flash.h>
+#include <ctime>
+#include <cstdio>
+#include <mutex>
+#include <string>
+
+static const char* TAG = "MAIPAI-MOOD";
+
+namespace {
+
+const char* kNamespace      = "mp_mood";  // our own namespace
+const int64_t kSaveEveryMs  = 15 * 60 * 1000;
+std::mutex s_mutex;
+mm_t s_mood;
+bool s_ready        = false;
+bool s_test_hold    = false;  // the test tool moved care; nothing is saved until it is cleared
+int64_t s_last_save = 0;
+bool s_face_dirty   = true;   // draw the look once after boot
+
+int64_t now_ms()
+{
+    return esp_timer_get_time() / 1000;
+}
+
+void load_locked()
+{
+    if (s_ready) {
+        return;
+    }
+    s_ready = true;
+    uint8_t rec[MM_REC_BYTES] = {};
+    size_t len                = sizeof(rec);
+    nvs_handle_t h;
+    bool good = false;
+    if (nvs_open(kNamespace, NVS_READONLY, &h) == ESP_OK) {
+        good = nvs_get_blob(h, "rec", rec, &len) == ESP_OK && len == sizeof(rec) && mm_load(&s_mood, rec) == 1;
+        nvs_close(h);
+    }
+    if (!good) {
+        mm_init(&s_mood);
+    }
+    ESP_LOGW(TAG, "mood %s: care %d, day %u", good ? "loaded" : "starts fresh", s_mood.care, (unsigned)s_mood.day);
+}
+
+void save_locked(bool force)
+{
+    if (s_test_hold || !s_mood.dirty) {
+        return;
+    }
+    const int64_t now = now_ms();
+    if (!force && s_last_save != 0 && now - s_last_save < kSaveEveryMs) {
+        return;
+    }
+    uint8_t rec[MM_REC_BYTES];
+    mm_store(&s_mood, rec);
+    nvs_handle_t h;
+    if (nvs_open(kNamespace, NVS_READWRITE, &h) != ESP_OK) {
+        ESP_LOGW(TAG, "could not save the mood");
+        return;
+    }
+    const bool ok = nvs_set_blob(h, "rec", rec, sizeof(rec)) == ESP_OK && nvs_commit(h) == ESP_OK;
+    nvs_close(h);
+    if (ok) {
+        s_mood.dirty = 0;
+        s_last_save  = now;
+    } else {
+        ESP_LOGW(TAG, "could not write the mood");
+    }
+}
+
+uint32_t today()
+{
+    const time_t t = time(nullptr);
+    if (t < 1700000000) {
+        return 0;  // the clock is not set yet
+    }
+    struct tm tm_local = {};
+    localtime_r(&t, &tm_local);
+    return mm_day_from_civil(tm_local.tm_year + 1900, tm_local.tm_mon + 1, tm_local.tm_mday);
+}
+
+void announce_level(const mm_t& m)
+{
+    char extra[48];
+    snprintf(extra, sizeof(extra), "\"level\":\"%s\",\"care\":%d", mm_word(m.level), m.care);
+    device_events_push("mood", extra);
+    ESP_LOGW(TAG, "mood is now %s (care %d)", mm_word(m.level), m.care);
+    s_face_dirty = true;
+}
+
+}  // namespace
+
+int maipai_mood_face()
+{
+    std::lock_guard<std::mutex> lock(s_mutex);
+    load_locked();
+    return mm_face(s_mood.level);
+}
+
+void maipai_mood_pet()
+{
+    std::lock_guard<std::mutex> lock(s_mutex);
+    load_locked();
+    const mm_level_t before = s_mood.level;
+    if (mm_pet(&s_mood, static_cast<uint32_t>(now_ms())) != 0 && s_mood.level != before) {
+        announce_level(s_mood);
+    }
+}
+
+void maipai_mood_tick()
+{
+    bool refresh = false;
+    {
+        std::lock_guard<std::mutex> lock(s_mutex);
+        load_locked();
+        const mm_level_t before = s_mood.level;
+        if (!s_test_hold && mm_new_day(&s_mood, today()) != 0) {
+            save_locked(true);  // a day change is always written
+            if (s_mood.level != before) {
+                announce_level(s_mood);
+            }
+        }
+        save_locked(false);
+        refresh      = s_face_dirty;
+        s_face_dirty = false;
+    }
+    if (refresh) {
+        hal_bridge::mood_refresh();  // takes the LVGL lock, so never called under our own mutex
+    }
+}
+
+void maipai_mood_register_tools()
+{
+    McpServer::GetInstance().AddTool(
+        "self.mood.get",
+        "How well cared for the robot feels: care 0 to 100 (head pets raise it, days without one lower it), its level "
+        "(low shows a sad resting face, high a happy one), the pets counted today and the saved day. Answers "
+        "{ok,care,level,pets_today,day,test}.",
+        PropertyList(), [](const PropertyList&) -> ReturnValue {
+            std::lock_guard<std::mutex> lock(s_mutex);
+            load_locked();
+            char buf[128];
+            snprintf(buf, sizeof(buf), "{\"ok\":true,\"care\":%d,\"level\":\"%s\",\"pets_today\":%d,\"day\":%u,\"test\":%s}",
+                     s_mood.care, mm_word(s_mood.level), s_mood.pets_today, (unsigned)s_mood.day,
+                     s_test_hold ? "true" : "false");
+            return std::string(buf);
+        });
+    McpServer::GetInstance().AddTool(
+        "self.mood.test",
+        "Test the mood face without a week of care: care 0 to 100 acts as the care value for now and is not saved; "
+        "-1 puts the saved value back. Answers {ok,care,level}.",
+        PropertyList({Property("care", kPropertyTypeInteger, -1, -1, 100)}),
+        [](const PropertyList& properties) -> ReturnValue {
+            const int care = properties["care"].value<int>();
+            {
+                std::lock_guard<std::mutex> lock(s_mutex);
+                load_locked();
+                const mm_level_t before = s_mood.level;
+                if (care < 0) {
+                    s_test_hold = false;
+                    s_ready     = false;  // read the saved record again
+                    load_locked();
+                } else {
+                    s_test_hold = true;
+                    s_mood.care = static_cast<uint8_t>(care);
+                    s_mood.level = mm_level_for(MM_OK, care);
+                }
+                if (s_mood.level != before) {
+                    announce_level(s_mood);
+                }
+                s_face_dirty = true;
+            }
+            std::lock_guard<std::mutex> lock(s_mutex);
+            char buf[80];
+            snprintf(buf, sizeof(buf), "{\"ok\":true,\"care\":%d,\"level\":\"%s\"}", s_mood.care, mm_word(s_mood.level));
+            return std::string(buf);
+        });
+}
+#endif
