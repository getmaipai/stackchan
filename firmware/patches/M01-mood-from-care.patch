+/*
+ * SPDX-License-Identifier: MIT
+ *
+ * Mood that depends on care, saved across days (patch M01). Logic: maipai_mood_core.h. With CONFIG_MAIPAI_MOOD off
+ * nothing here is compiled and the face is always the plain one.
+ */
+#pragma once
+#include <sdkconfig.h>
+
+#if CONFIG_MAIPAI_MOOD
+// A head touch: counts as care (rate-limited inside). Safe from any task.
+void maipai_mood_pet();
+// Once a second from the daily tick: rolls the day over, saves the record when it changed, refreshes the face.
+void maipai_mood_tick();
+// Registers self.mood.get and self.mood.test.
+void maipai_mood_register_tools();
+// The look the resting face takes: 0 plain, 1 happy, 2 sad.
+int maipai_mood_face();
+#else
+inline void maipai_mood_pet() {}
+inline void maipai_mood_tick() {}
+inline void maipai_mood_register_tools() {}
+inline int maipai_mood_face() { return 0; }
+#endif
diff --git a/firmware/main/hal/maipai_mood_core.h b/firmware/main/hal/maipai_mood_core.h
new file mode 100644
--- /dev/null
+++ b/firmware/main/hal/maipai_mood_core.h
@@ -0,0 +1,187 @@
+/*
+ * SPDX-License-Identifier: MIT
+ *
+ * Mood that depends on care (patch M01). Plain C99, no firmware headers, so a host test compiles and runs it
+ * (host/tests/firmware/mood_core_test.c).
+ *
+ * One number, `care` (0 to 100). A head pet adds 4 (at most 12 counted a day, and at most one every 20 seconds, so
+ * holding a hand on the head cannot farm it). Every whole day with no pet takes 12 away, for at most 14 days. A new
+ * unit starts at 50. The face shows three looks with a little hysteresis so it never flickers at an edge:
+ * HIGH (70 or more, up to 67 on the way down) is happy, OK is the plain face, LOW (under 30, back at 33) is sad.
+ * The record is 8 bytes and survives a reboot: magic, version, care, pets today, the day (days since 2020-01-01,
+ * 0 for "no clock yet"), a spare byte and a checksum. A record that fails any check is thrown away for the start.
+ */
+#ifndef MAIPAI_MOOD_CORE_H
+#define MAIPAI_MOOD_CORE_H
+
+#include <stdint.h>
+
+#define MM_CARE_START 50
+#define MM_PET_POINTS 4
+#define MM_PETS_PER_DAY 12
+#define MM_PET_GAP_MS 20000
+#define MM_MISS_LOSS 12
+#define MM_MAX_MISSED_DAYS 14
+#define MM_HIGH_ON 70
+#define MM_HIGH_OFF 67
+#define MM_LOW_ON 30
+#define MM_LOW_OFF 33
+#define MM_REC_BYTES 8
+#define MM_MAGIC 0x4D
+#define MM_VERSION 1
+
+typedef enum { MM_LOW = 0, MM_OK, MM_HIGH } mm_level_t;
+
+typedef struct {
+    uint8_t care;         /* 0 to 100 */
+    uint8_t pets_today;   /* pets counted on `day` */
+    uint32_t day;         /* days since 2020-01-01, 0 until the clock is set */
+    uint32_t last_pet_ms; /* when the last pet was seen (counted or not) */
+    uint8_t has_pet;      /* last_pet_ms is valid */
+    uint8_t dirty;        /* the record changed and is not saved yet */
+    mm_level_t level;
+} mm_t;
+
+/* Days since 2020-01-01 for a calendar date (month 1 to 12, day 1 to 31). Returns 0 for a date before 2020. */
+static inline uint32_t mm_day_from_civil(int year, int month, int day)
+{
+    int y = month <= 2 ? year - 1 : year;
+    int era = y / 400;
+    int yoe = y - era * 400;
+    int mp = (month + 9) % 12;
+    int doy = (153 * mp + 2) / 5 + day - 1;
+    int doe = yoe * 365 + yoe / 4 - yoe / 100 + doy;
+    long days = (long)era * 146097 + doe - 719468; /* days since 1970-01-01 */
+    long since2020 = days - 18262;                 /* 2020-01-01 is day 18262 */
+    return since2020 < 1 ? 0u : (uint32_t)since2020;
+}
+
+static inline mm_level_t mm_level_for(mm_level_t prev, int care)
+{
+    if (prev == MM_HIGH) {
+        if (care >= MM_HIGH_OFF) return MM_HIGH;
+    } else if (care >= MM_HIGH_ON) {
+        return MM_HIGH;
+    }
+    if (prev == MM_LOW) {
+        if (care < MM_LOW_OFF) return MM_LOW;
+    } else if (care < MM_LOW_ON) {
+        return MM_LOW;
+    }
+    return MM_OK;
+}
+
+/* Returns 1 when the level changed. */
+static inline int mm_refresh_level(mm_t* m)
+{
+    const mm_level_t now = mm_level_for(m->level, m->care);
+    const int changed = now != m->level;
+    m->level = now;
+    return changed;
+}
+
+static inline void mm_init(mm_t* m)
+{
+    m->care = MM_CARE_START;
+    m->pets_today = 0;
+    m->day = 0;
+    m->last_pet_ms = 0;
+    m->has_pet = 0;
+    m->dirty = 0;
+    m->level = MM_OK;
+}
+
+static inline uint8_t mm_checksum(const uint8_t* r)
+{
+    unsigned sum = 0;
+    for (int i = 0; i < MM_REC_BYTES - 1; i++) sum += r[i];
+    return (uint8_t)((sum & 0xFF) ^ 0xA5);
+}
+
+static inline void mm_store(const mm_t* m, uint8_t* r)
+{
+    r[0] = MM_MAGIC;
+    r[1] = MM_VERSION;
+    r[2] = m->care;
+    r[3] = m->pets_today;
+    r[4] = (uint8_t)(m->day & 0xFF);
+    r[5] = (uint8_t)((m->day >> 8) & 0xFF);
+    r[6] = 0;
+    r[7] = mm_checksum(r);
+}
+
+/* Returns 1 when the record was good and is now in `m`; otherwise `m` is the start state and 0 comes back. */
+static inline int mm_load(mm_t* m, const uint8_t* r)
+{
+    mm_init(m);
+    if (r == 0 || r[0] != MM_MAGIC || r[1] != MM_VERSION || r[7] != mm_checksum(r) || r[2] > 100 ||
+        r[3] > MM_PETS_PER_DAY) {
+        return 0;
+    }
+    m->care = r[2];
+    m->pets_today = r[3];
+    m->day = (uint32_t)r[4] | ((uint32_t)r[5] << 8);
+    m->level = mm_level_for(MM_OK, m->care);
+    return 1;
+}
+
+/* A pet at `now_ms`. Returns 1 when it counted. */
+static inline int mm_pet(mm_t* m, uint32_t now_ms)
+{
+    const int spaced = !m->has_pet || (uint32_t)(now_ms - m->last_pet_ms) >= MM_PET_GAP_MS;
+    if (!spaced) {
+        return 0;
+    }
+    m->last_pet_ms = now_ms;
+    m->has_pet = 1;
+    if (m->pets_today >= MM_PETS_PER_DAY) {
+        return 0;
+    }
+    m->pets_today++;
+    const int care = m->care + MM_PET_POINTS;
+    m->care = (uint8_t)(care > 100 ? 100 : care);
+    m->dirty = 1;
+    mm_refresh_level(m);
+    return 1;
+}
+
+/* The calendar day is now `day` (0 means the clock is not set: nothing happens). Returns 1 when the record changed. */
+static inline int mm_new_day(mm_t* m, uint32_t day)
+{
+    if (day == 0 || day == m->day) {
+        return 0;
+    }
+    if (m->day == 0 || day < m->day) { /* first clock reading, or the clock moved back: just take the day */
+        m->day = day;
+        m->pets_today = 0;
+        m->dirty = 1;
+        return 1;
+    }
+    uint32_t missed = day - m->day - 1; /* whole days in between with no care */
+    if (m->pets_today == 0) {
+        missed += 1; /* the day that just ended had none either */
+    }
+    if (missed > MM_MAX_MISSED_DAYS) {
+        missed = MM_MAX_MISSED_DAYS;
+    }
+    const uint32_t loss = missed * MM_MISS_LOSS;
+    m->care = (uint8_t)(m->care > loss ? m->care - loss : 0);
+    m->day = day;
+    m->pets_today = 0;
+    m->dirty = 1;
+    mm_refresh_level(m);
+    return 1;
+}
+
+static inline const char* mm_word(mm_level_t level)
+{
+    return level == MM_HIGH ? "high" : (level == MM_LOW ? "low" : "ok");
+}
+
+/* The face look for the level: 0 the plain face, 1 happy, 2 sad. */
+static inline int mm_face(mm_level_t level)
+{
+    return level == MM_HIGH ? 1 : (level == MM_LOW ? 2 : 0);
+}
+
+#endif
