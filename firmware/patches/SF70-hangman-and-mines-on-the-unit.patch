+void draw_mines(Grid* g, lv_layer_t* layer)
+{
+    for (int i = 0; i < GMN_CELLS; i++) {
+        const uint8_t v = g->mines.c[i];
+        const int x = g->lay.x0 + (i % GMN_COLS) * g->lay.cw + 1, y = g->lay.y0 + (i / GMN_COLS) * g->lay.ch + 1, w = g->lay.cw - 2;
+        const bool open = (v & GMN_OPEN) != 0;
+        rect(layer, x, y, w, w, 4, open ? 0x1A2236 : 0x2C3E7A);
+        if (open && (v & GMN_MINE)) {
+            rect(layer, x + 5, y + 5, w - 10, w - 10, LV_RADIUS_CIRCLE, 0xE04848);
+        } else if (open && (v & GMN_COUNT)) {
+            text(layer, kDigit[v & GMN_COUNT], x, y + 2, x + w - 1, y + w - 1, kDigitColor[v & GMN_COUNT], &lv_font_montserrat_14);
+        } else if (!open && (v & GMN_FLAG)) {
+            rect(layer, x + 11, y + 4, 2, w - 8, 0, 0xCCCCCC);
+            rect(layer, x + 5, y + 4, 8, 7, 0, 0xF2B24A);
+        }
+    }
+    // the flag switch on the right: lit when a tap flags
+    rect(layer, 256, 90, 40, 60, 8, g->flag_mode ? 0xF2B24A : 0x2C3E7A);
+    rect(layer, 272, 100, 2, 36, 0, g->flag_mode ? 0x10141C : 0xCCCCCC);
+    rect(layer, 262, 100, 12, 10, 0, g->flag_mode ? 0x10141C : 0xF2B24A);
+}
