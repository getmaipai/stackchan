+void draw_hangman(Grid* g, lv_layer_t* layer)
+{
+    // the gallows, always; one part for each miss
+    rect(layer, 30, 118, 80, 4, 0, 0x8A6B3F);          // base
+    rect(layer, 50, 40, 4, 80, 0, 0x8A6B3F);           // pole
+    rect(layer, 50, 40, 44, 4, 0, 0x8A6B3F);           // beam
+    rect(layer, 90, 40, 3, 14, 0, 0xC8C8C8);           // rope
+    const int m = g->hang.misses;
+    if (m >= 1) rect(layer, 82, 54, 20, 20, LV_RADIUS_CIRCLE, 0xF2B24A);   // head
+    if (m >= 2) rect(layer, 90, 74, 4, 26, 0, 0xF2B24A);                    // body
+    if (m >= 3) rect(layer, 76, 78, 14, 4, 0, 0xF2B24A);                    // left arm
+    if (m >= 4) rect(layer, 94, 78, 14, 4, 0, 0xF2B24A);                    // right arm
+    if (m >= 5) rect(layer, 78, 100, 12, 4, 0, 0xF2B24A);                   // left leg
+    if (m >= 6) rect(layer, 94, 100, 12, 4, 0, 0xF2B24A);                   // right leg
+    if (m >= 7) rect(layer, 84, 62, 16, 3, 0, 0xE04848);                    // the face X, at the last miss
+    gh_shown(&g->hang, g->shown, sizeof(g->shown));
+    char spaced[GH_WORD_MAX * 2 + 1] = {0};
+    int k = 0;
+    for (int i = 0; g->shown[i] != '\0' && k + 2 < static_cast<int>(sizeof(spaced)); i++) { spaced[k++] = g->shown[i]; spaced[k++] = ' '; }
+    spaced[k > 0 ? k - 1 : 0] = '\0';
+    static char s_spaced[GH_WORD_MAX * 2 + 1];  // static: the label is drawn after this function returns
+    memcpy(s_spaced, spaced, sizeof(s_spaced));
+    text(layer, s_spaced, 112, 60, 300, 90, 0xFFFFFF, &lv_font_montserrat_24);
+    // the keys
+    for (int i = 0; i < 26; i++) {
+        const int c = i % 9, r = i / 9;
+        const bool used = (g->hang.guessed >> i) & 1u;
+        bool in_word = false;
+        for (int k2 = 0; k2 < g->hang.len; k2++) in_word |= g->hang.word[k2] == 'A' + i;
+        const int x = g->lay.x0 + c * g->lay.cw + 2, y = g->lay.y0 + r * g->lay.ch + 2;
+        rect(layer, x, y, g->lay.cw - 4, g->lay.ch - 4, 6, used ? (in_word ? 0x2E7D4F : 0x7D2E2E) : 0x2C3E7A);
+        text(layer, kLetter[i], x, y + 4, x + g->lay.cw - 5, y + g->lay.ch - 4, used ? 0xBBBBBB : 0xFFFFFF, &lv_font_montserrat_20);
+    }
+}
