diff --git a/firmware/main/hal/maipai_dances_core.h b/firmware/main/hal/maipai_dances_core.h
new file mode 100644
--- /dev/null
+++ b/firmware/main/hal/maipai_dances_core.h
@@ -0,0 +1,99 @@
+/*
+ * SPDX-License-Identifier: MIT
+ *
+ * More named dances, as data (patch V04). Plain C99, no firmware headers: host/tests/firmware/dances_core_test.c
+ * compiles it and checks every row against the limits below. A dance is a short list of steps; each step moves the
+ * head (yaw and pitch in tenths of a degree, with a speed) and sets the eyes and mouth for a time. The firmware
+ * turns a row into the same keyframes the four built-in dances use (stackchan::animation::Keyframe) while it plays,
+ * so a dance costs no RAM while none plays. Every dance starts and ends at centre so the head never drifts.
+ * Eye and mouth weight: 100 open, 50 the happy squint, 0 closed or flat (as the built-in Happy dance uses them).
+ */
+#pragma once
+#include <stdint.h>
+#include <string.h>
+
+#define MDN_MAX_STEPS 8
+#define MDN_YAW_MAX 600      /* the widest turn any built-in dance makes (look around) */
+#define MDN_PITCH_MIN (-300) /* look up */
+#define MDN_PITCH_MAX 250    /* look down */
+#define MDN_SPEED_MIN 50
+#define MDN_SPEED_MAX 1000
+#define MDN_STEP_MIN_MS 100
+#define MDN_STEP_MAX_MS 2000
+#define MDN_TOTAL_MAX_MS 8000 /* a dance never runs longer than this */
+
+typedef struct {
+    int16_t yaw;
+    int16_t pitch;
+    uint16_t speed; /* the servo speed for both axes */
+    uint8_t eye_w;
+    uint8_t mouth_w;
+    int8_t eye_x;   /* eyes shifted with the sway */
+    uint16_t ms;
+} mdn_step_t;
+
+typedef struct {
+    const char* name;
+    uint8_t count;
+    mdn_step_t step[MDN_MAX_STEPS];
+} mdn_dance_t;
+
+#define MDN_COUNT 6
+
+/* yaw, pitch, speed, eye_w, mouth_w, eye_x, ms */
+static const mdn_dance_t MDN_DANCES[MDN_COUNT] = {
+    {"sway", 6,
+     {{0, 0, 200, 100, 0, 0, 500}, {-400, -50, 150, 50, 30, -10, 1400}, {400, -50, 150, 50, 30, 10, 1400},
+      {-400, -50, 150, 50, 30, -10, 1400}, {400, -50, 150, 50, 30, 10, 1400}, {0, 0, 200, 100, 0, 0, 600}}},
+    {"nod_yes", 6,
+     {{0, 0, 300, 100, 0, 0, 300}, {0, -180, 500, 100, 0, 0, 350}, {0, 120, 500, 100, 0, 0, 350},
+      {0, -180, 500, 100, 0, 0, 350}, {0, 120, 500, 100, 0, 0, 350}, {0, 0, 300, 100, 0, 0, 400}}},
+    {"shake_no", 6,
+     {{0, 0, 300, 100, 0, 0, 300}, {-350, 0, 600, 100, 0, 0, 300}, {350, 0, 600, 100, 0, 0, 300},
+      {-350, 0, 600, 100, 0, 0, 300}, {350, 0, 600, 100, 0, 0, 300}, {0, 0, 300, 100, 0, 0, 400}}},
+    {"wiggle", 8,
+     {{0, 0, 400, 100, 0, 0, 200}, {-150, 60, 800, 60, 20, -6, 160}, {150, -60, 800, 60, 20, 6, 160},
+      {-150, 60, 800, 60, 20, -6, 160}, {150, -60, 800, 60, 20, 6, 160}, {-150, 60, 800, 60, 20, -6, 160},
+      {150, -60, 800, 60, 20, 6, 160}, {0, 0, 400, 100, 0, 0, 300}}},
+    {"bow", 4,
+     {{0, 0, 250, 100, 0, 0, 400}, {0, 250, 250, 100, 0, 0, 900}, {0, 250, 250, 100, 0, 0, 700},
+      {0, -40, 300, 100, 0, 0, 800}}},
+    {"groove", 8,
+     {{0, 0, 300, 100, 0, 0, 300}, {-250, -150, 400, 50, 20, -8, 450}, {250, 50, 400, 50, 20, 8, 450},
+      {-250, -150, 400, 50, 20, -8, 450}, {250, 50, 400, 50, 20, 8, 450}, {-250, -150, 400, 50, 20, -8, 450},
+      {250, 50, 400, 50, 20, 8, 450}, {0, 0, 300, 100, 0, 0, 500}}},
+};
+
+/* The row for a name, or NULL. */
+static inline const mdn_dance_t* mdn_find(const char* name)
+{
+    if (name == NULL) {
+        return NULL;
+    }
+    for (int i = 0; i < MDN_COUNT; i++) {
+        if (strcmp(MDN_DANCES[i].name, name) == 0) {
+            return &MDN_DANCES[i];
+        }
+    }
+    return NULL;
+}
+
+/* Why a row is refused: 0 fine, else a short word. */
+static inline const char* mdn_check(const mdn_dance_t* d)
+{
+    uint32_t total = 0;
+    if (d == NULL || d->name == NULL || d->name[0] == '\0') return "name";
+    if (d->count < 2 || d->count > MDN_MAX_STEPS) return "steps";
+    for (int i = 0; i < d->count; i++) {
+        const mdn_step_t* s = &d->step[i];
+        if (s->yaw > MDN_YAW_MAX || s->yaw < -MDN_YAW_MAX) return "yaw";
+        if (s->pitch > MDN_PITCH_MAX || s->pitch < MDN_PITCH_MIN) return "pitch";
+        if (s->speed < MDN_SPEED_MIN || s->speed > MDN_SPEED_MAX) return "speed";
+        if (s->ms < MDN_STEP_MIN_MS || s->ms > MDN_STEP_MAX_MS) return "time";
+        if (s->eye_w > 100 || s->mouth_w > 100) return "weight";
+        total += s->ms;
+    }
+    if (total > MDN_TOTAL_MAX_MS) return "length";
+    if (d->step[0].yaw != 0 || d->step[0].pitch != -0 || d->step[d->count - 1].yaw != 0) return "centre";
+    return NULL;
+}
