diff --git a/firmware/main/hal/maipai_heal.h b/firmware/main/hal/maipai_heal.h
new file mode 100644
--- /dev/null
+++ b/firmware/main/hal/maipai_heal.h
@@ -0,0 +1,29 @@
+/*
+ * SPDX-License-Identifier: MIT
+ */
+#pragma once
+#include <cstddef>
+#include <cstdint>
+
+// The self-restart guard (patch 085). A restart the unit chooses for itself (the host asked, or the main loop
+// froze for 30 s) asks here with a short reason ("host", "stall"). After delay_ms it is counted in flash and
+// carried out, unless three have already happened this hour: then it is refused, logged and reported as a
+// "heal" event (action=refused), so a fault that survives a restart can never become a reboot loop. Safe to
+// call from any task, including one whose stack is in PSRAM: the flash write and the restart run on their
+// own task with an internal stack (a flash write from a PSRAM-stack task aborts the unit). A panic is not
+// chosen, is never counted here and is never held back.
+void maipai_heal_restart(const char* why, uint32_t delay_ms);
+
+// Restarts counted in this hour's window, and whether the next request would be refused.
+void maipai_heal_status(int* count, bool* hold);
+
+// The application main loop calls this once a second. The motion sensor task watches it (maipai_heal_watch).
+void maipai_heal_main_alive();
+
+// Called by the motion sensor task every 100 ms: after 30 s without a main loop tick it asks for a restart
+// ("stall"), once per freeze. Never fires before the first tick, so setup mode and the boot are not counted.
+void maipai_heal_watch();
+
+// Boot: one "boot" event with the reset reason, this hour's count, whether a restart is held, and why the
+// last restart was chosen (empty after a power-on or a panic).
+void maipai_heal_boot_report();
diff --git a/firmware/main/hal/maipai_heal.cc b/firmware/main/hal/maipai_heal.cc
new file mode 100644
--- /dev/null
+++ b/firmware/main/hal/maipai_heal.cc
@@ -0,0 +1,205 @@
+/*
+ * SPDX-License-Identifier: MIT
+ */
+// The self-restart guard (patch 085). At most kMaxPerHour self-chosen restarts an hour. The hour is counted in
+// the unit's own running time, because the unit has no clock that survives a restart: flash holds how many
+// restarts the window has seen (heal_n) and how many seconds the window had run as of the last of them
+// (heal_s); at boot kBootGapS is added for the restart itself. A power loss does not reset the count, so the
+// window only ends after an hour of running.
+#include "maipai_heal.h"
+
+#include "device_events.h"
+
+#include <esp_log.h>
+#include <esp_system.h>
+#include <esp_timer.h>
+#include <freertos/FreeRTOS.h>
+#include <freertos/task.h>
+#include <nvs.h>
+
+#include <atomic>
+#include <cstdio>
+#include <cstring>
+#include <memory>
+#include <mutex>
+
+namespace {
+constexpr const char* kTag    = "HealGuard";
+constexpr const char* kNs     = "mp_heal";  // our own: never the websocket namespace (pairing token, Wi-Fi)
+constexpr int kMaxPerHour     = 3;
+constexpr int kWindowS        = 3600;
+constexpr int kBootGapS       = 10;  // what a restart itself costs, added to the window clock at boot
+constexpr int kStallLoops     = 300; // 30 s at the motion task's 100 ms rhythm
+
+std::mutex s_mutex;
+bool s_loaded  = false;
+int s_count    = 0;  // restarts in the current window
+int s_window_s = 0;  // window clock at boot
+std::atomic<uint32_t> s_alive{0};
+
+struct Request {
+    char why[16];
+    uint32_t delay_ms;
+};
+
+int get_int(nvs_handle_t h, const char* key)
+{
+    int32_t value = 0;
+    return nvs_get_i32(h, key, &value) == ESP_OK ? value : 0;
+}
+
+void load_locked()
+{
+    if (s_loaded) {
+        return;
+    }
+    s_loaded = true;
+    nvs_handle_t h;
+    if (nvs_open(kNs, NVS_READONLY, &h) == ESP_OK) {
+        s_count    = get_int(h, "heal_n");
+        s_window_s = get_int(h, "heal_s") + kBootGapS;
+        nvs_close(h);
+    }
+}
+
+int elapsed_locked()
+{
+    return s_window_s + static_cast<int>(esp_timer_get_time() / 1000000);
+}
+
+// A window that has run an hour starts over.
+void expire_locked()
+{
+    if (s_count > 0 && elapsed_locked() >= kWindowS) {
+        s_count    = 0;
+        s_window_s = -static_cast<int>(esp_timer_get_time() / 1000000);
+    }
+}
+
+bool save_locked(const char* why)
+{
+    nvs_handle_t h;
+    if (nvs_open(kNs, NVS_READWRITE, &h) != ESP_OK) {
+        return false;
+    }
+    esp_err_t err = nvs_set_i32(h, "heal_n", s_count + 1);
+    if (err == ESP_OK) {
+        err = nvs_set_i32(h, "heal_s", elapsed_locked());
+    }
+    if (err == ESP_OK) {
+        err = nvs_set_str(h, "heal_why", why);
+    }
+    if (err == ESP_OK) {
+        err = nvs_commit(h);
+    }
+    nvs_close(h);
+    return err == ESP_OK;
+}
+
+void restart_task(void* arg)
+{
+    std::unique_ptr<Request> request(static_cast<Request*>(arg));
+    vTaskDelay(pdMS_TO_TICKS(request->delay_ms));
+    int count = 0;
+    bool allowed;
+    {
+        std::lock_guard<std::mutex> lock(s_mutex);
+        load_locked();
+        expire_locked();
+        allowed = s_count < kMaxPerHour;
+        count   = s_count;
+    }
+    char extra[80];
+    if (!allowed) {
+        ESP_LOGW(kTag, "restart refused (%s): %d self-restarts this hour already. The unit keeps running; restart it by hand if it is stuck.",
+                 request->why, count);
+        snprintf(extra, sizeof(extra), "\"action\":\"refused\",\"why\":\"%s\",\"n\":%d", request->why, count);
+        device_events_push("heal", extra);
+        vTaskDelete(nullptr);
+        return;
+    }
+    ESP_LOGW(kTag, "restarting (%s): self-restart %d of %d this hour", request->why, count + 1, kMaxPerHour);
+    snprintf(extra, sizeof(extra), "\"action\":\"restart\",\"why\":\"%s\",\"n\":%d", request->why, count + 1);
+    device_events_push("heal", extra);
+    vTaskDelay(pdMS_TO_TICKS(300));  // the log line and the event leave first
+    {
+        std::lock_guard<std::mutex> lock(s_mutex);
+        if (!save_locked(request->why)) {
+            ESP_LOGW(kTag, "could not count this restart in flash; restarting anyway");
+        }
+    }
+    esp_restart();
+}
+}  // namespace
+
+void maipai_heal_restart(const char* why, uint32_t delay_ms)
+{
+    auto* request = new Request{};
+    snprintf(request->why, sizeof(request->why), "%s", why != nullptr ? why : "?");
+    request->delay_ms = delay_ms;
+    if (xTaskCreate(restart_task, "heal_restart", 4096, request, 5, nullptr) != pdPASS) {
+        ESP_LOGW(kTag, "could not start the restart task (%s): no memory. Nothing was restarted.", request->why);
+        delete request;
+    }
+}
+
+void maipai_heal_status(int* count, bool* hold)
+{
+    std::lock_guard<std::mutex> lock(s_mutex);
+    load_locked();
+    expire_locked();
+    if (count != nullptr) {
+        *count = s_count;
+    }
+    if (hold != nullptr) {
+        *hold = s_count >= kMaxPerHour;
+    }
+}
+
+void maipai_heal_main_alive()
+{
+    s_alive.fetch_add(1, std::memory_order_relaxed);
+}
+
+void maipai_heal_watch()
+{
+    static uint32_t last_alive = 0;
+    static int stuck_loops     = 0;
+    static bool asked          = false;
+    const uint32_t alive       = s_alive.load(std::memory_order_relaxed);
+    if (alive != last_alive) {
+        last_alive  = alive;
+        stuck_loops = 0;
+        asked       = false;
+        return;
+    }
+    if (alive > 0 && !asked && ++stuck_loops >= kStallLoops) {
+        asked = true;
+        ESP_LOGW(kTag, "main loop stalled for 30 s: asking for a self-restart");
+        maipai_heal_restart("stall", 0);
+    }
+}
+
+void maipai_heal_boot_report()
+{
+    int count = 0;
+    bool hold = false;
+    maipai_heal_status(&count, &hold);
+    char why[16] = "";
+    nvs_handle_t h;
+    if (nvs_open(kNs, NVS_READWRITE, &h) == ESP_OK) {
+        size_t size = sizeof(why);
+        if (nvs_get_str(h, "heal_why", why, &size) == ESP_OK) {
+            nvs_erase_key(h, "heal_why");  // read once: empty after a power-on or a panic
+            nvs_commit(h);
+        } else {
+            why[0] = '\0';
+        }
+        nvs_close(h);
+    }
+    char extra[120];
+    snprintf(extra, sizeof(extra), "\"reason\":%d,\"heal_n\":%d,\"heal_hold\":%d,\"heal_why\":\"%s\"",
+             static_cast<int>(esp_reset_reason()), count, hold ? 1 : 0, why);
+    ESP_LOGI(kTag, "boot: %s", extra);
+    device_events_push("boot", extra);
+}
