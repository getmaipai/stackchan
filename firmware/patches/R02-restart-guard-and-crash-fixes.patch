 uint8_t I2cDevice::ReadReg(uint8_t reg) {
-    uint8_t buffer[1];
-    ESP_ERROR_CHECK(i2c_master_transmit_receive(i2c_device_, &reg, 1, buffer, 1, 100));
-    return buffer[0];
+    // A read the part does not answer (it was not ready after a reset, or the bus hung for a moment) used to
+    // abort the unit (ESP_ERROR_CHECK, esp_err_t 0x108 on the first boot after a flash). Try three times,
+    // clearing the bus between tries, and after that log it and return 0 so the unit still boots.
+    uint8_t buffer[1] = {0};
+    esp_err_t error   = ESP_FAIL;
+    for (int attempt = 1; attempt <= 3; attempt++) {
+        error = i2c_master_transmit_receive(i2c_device_, &reg, 1, buffer, 1, 100);
+        if (error == ESP_OK) {
+            return buffer[0];
+        }
+        ESP_LOGW(TAG, "I2C register read 0x%02x failed (try %d of 3): %s", reg, attempt, esp_err_to_name(error));
+        if (attempt < 3) {
+            i2c_master_bus_reset(i2c_bus_);
+            vTaskDelay(pdMS_TO_TICKS(5));
+        }
+    }
+    ESP_LOGE(TAG, "I2C register read 0x%02x failed three times: %s. Returning 0; check the part's cable if this repeats.",
+             reg, esp_err_to_name(error));
+    return 0;
