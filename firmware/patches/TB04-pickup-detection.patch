# Intent: Pickup, carried and set-down (owner report 2026-11-16: tilt works, pickup is not recognised). The IMU task now runs every 20 ms (the shake, orientation and heal steps keep their 100 ms rhythm every fifth pass) and feeds a detector (136 bytes) that reads a push up then a slowing (each at least 100 ms) or one long push with the pose changed 8 degrees, confirms 250 ms later unless a shake cancels it, calls it carried after 1.5 s of motion, and set down after a hand-sized spike then 450 ms of stillness, or 4 s still back at the first pose. It ignores the body for 1.5 s after any head move of the unit's own (the servo update says so) and raises its bar while the unit speaks. Events lifted, carried, set_down and shaken (in the hand) with the axis; debounced 1.5 s. Reaction (pickup_reaction off, face, face_sound; default face): surprised on lift, content while carried, happy on set down, only when idle. A lift wakes a dimmed screen. The reset-reason item of the brief is patch Z01, not repeated here.
# Placement: unit (the robot reacts with no host; the host gets the events)
# Upstream: firmware/main/hal/hal_imu.cpp (M5Stack, patch I01) and stackchan/motion/servo.cpp (M5Stack, MIT); new hal/maipai_pickup_core.h, maipai_pickup.{h,cc}
# Check after a flash: read device events while lifting, carrying and putting it down with a hand; a bump on the desk, speech and a head move give none; imu stats show the 20 ms task.

diff --git a/firmware/main/hal/maipai_pickup_core.h b/firmware/main/hal/maipai_pickup_core.h
new file mode 100644
index 0000000..d4872e0
--- /dev/null
+++ b/firmware/main/hal/maipai_pickup_core.h
@@ -0,0 +1,348 @@
+/*
+ * SPDX-License-Identifier: MIT
+ *
+ * Pickup, carried and set-down detection (patch TB04): the pure logic. Fed the accelerometer (BMI270) about every
+ * 20 ms, it says "lifted", "carried", "set_down" and "shaken", each at most once per 1.5 s. Plain C99, no clock of its
+ * own, no hardware: a host compiler tests it against synthesised traces (host/tests/firmware/pickup_core_test.c).
+ *
+ * How it tells a hand from the room. A hand lifting the robot pushes it up (the reading goes above 1 g for 100 to 400 ms),
+ * then slows it (below 1 g), and the pose ends up changed; a bump on the table is a spike under 100 ms that rings down
+ * with the pose unchanged; the unit's own speaker is a small steady ripple; the unit's own head moves are told to the
+ * detector (mp_note_own) and ignored for 1.5 s; a shake reverses sign several times in a second. The detector reads
+ * nothing but the three accelerations and what the unit tells it about itself, keeps no history longer than a second or
+ * two, and stores 144 bytes.
+ */
+#ifndef MAIPAI_PICKUP_CORE_H
+#define MAIPAI_PICKUP_CORE_H
+
+#include <math.h>
+#include <stddef.h>
+#include <stdint.h>
+#include <string.h>
+
+#define MP_G 9.80665f
+
+typedef enum {
+    MP_NONE = 0,
+    MP_LIFTED,
+    MP_CARRIED,
+    MP_SET_DOWN,
+    MP_SHAKEN,
+    MP_EVENT_COUNT
+} mp_event_t;
+
+static const char* const MP_EVENT_NAMES[MP_EVENT_COUNT] = {"none", "lifted", "carried", "set_down", "shaken"};
+
+/* The numbers, in one place. Accelerations in g. */
+#define MP_DEV_START 0.09f        /* a smoothed departure from 1 g that starts an excursion */
+#define MP_DEV_END 0.045f         /* and the level it must fall under to end one */
+#define MP_DEV_START_SPEAKING 0.15f /* the same while the unit speaks (its own speaker ripples the table) */
+#define MP_LOBE_MIN_MS 100u       /* a push or a slowing shorter than this is a knock, not a hand */
+#define MP_LOBE_PAIR_MS 800u      /* up then down must follow within this */
+#define MP_TILT_LIFT_MS 150u      /* a single long push counts when the pose changed */
+#define MP_TILT_LIFT_DEG 8.0f
+#define MP_STILL_DEV 0.035f
+#define MP_STILL_MS 300u
+#define MP_CONFIRM_MS 250u        /* a candidate lift waits this long for a shake to cancel it */
+#define MP_DEBOUNCE_MS 1500u
+#define MP_OWN_HOLD_MS 1500u      /* ignored after the unit's own move or speech */
+#define MP_SHAKE_G 0.6f           /* a swing this far from the 300 ms average counts as one stroke */
+#define MP_SHAKE_STROKES 4        /* this many opposite strokes within */
+#define MP_SHAKE_WINDOW_MS 1000u
+#define MP_CARRY_MS 1500u         /* held and moving at least this long, then "carried" */
+#define MP_CARRY_ACT 0.5f
+#define MP_BUMP_G 0.16f           /* the raw spike of a hand setting it down */
+#define MP_BUMP_STILL_MS 450u     /* and stillness this long after it */
+#define MP_BUMP_WINDOW_MS 1500u
+#define MP_QUIET_DOWN_MS 4000u    /* held still, back at the first pose: put down gently */
+#define MP_QUIET_DOWN_DEG 10.0f
+
+typedef struct {
+    /* smoothing */
+    float dev_s;       /* smoothed |a| - 1 (signed) */
+    float lp[3];       /* 300 ms average of the vector, for the shake and the stroke test */
+    float ref[3];      /* the resting pose (unit vector) while the unit is on a surface */
+    float cur[3];      /* the pose now (unit vector, 100 ms average) */
+    uint32_t t_prev;
+    uint32_t still_ms; /* how long the signal has been still */
+    uint8_t ref_ok;
+    uint8_t init;
+    /* the current excursion and the last closed one */
+    int8_t ex_sign;    /* 0 none, +1 above 1 g, -1 below */
+    uint32_t ex_ms;
+    int8_t last_sign;
+    uint32_t last_dur;
+    uint32_t last_end;
+    /* a candidate lift waiting for a shake to cancel it */
+    uint8_t cand;
+    uint32_t cand_at;
+    /* shake */
+    int8_t stroke_sign[3];
+    uint32_t strokes[MP_SHAKE_STROKES];
+    uint8_t stroke_n;
+    uint32_t shake_until;
+    /* what the unit tells it */
+    uint32_t own_until;
+    uint8_t speaking;
+    /* after a lift */
+    uint8_t held;
+    uint32_t held_at;
+    float act;         /* leaky share of time moving while held */
+    uint8_t carried;
+    uint32_t bump_at;  /* when a bump was seen while held, or 0 */
+    uint32_t last_event_ms;
+    uint8_t axis;      /* 0..5: +x -x +y -y +z -z at the last event */
+} mp_t;
+
+static inline void mp_init(mp_t* d) { memset(d, 0, sizeof(*d)); }
+
+/* The unit moved its own head or spoke: ignore the body for MP_OWN_HOLD_MS. `speaking` says the speaker is on now. */
+static inline void mp_note_own(mp_t* d, uint32_t now_ms, uint32_t hold_ms, int speaking)
+{
+    const uint32_t until = now_ms + hold_ms;
+    if ((int32_t)(until - d->own_until) > 0) {
+        d->own_until = until;
+    }
+    d->speaking = speaking != 0;
+}
+
+static inline void mp_set_speaking(mp_t* d, int speaking) { d->speaking = speaking != 0; }
+
+static inline int mp_is_held(const mp_t* d) { return d->held; }
+static inline int mp_axis(const mp_t* d) { return d->axis; }
+static inline const char* mp_axis_name(int axis)
+{
+    static const char* const names[6] = {"+x", "-x", "+y", "-y", "+z", "-z"};
+    return (axis >= 0 && axis < 6) ? names[axis] : "?";
+}
+
+static inline float mp_dot(const float* a, const float* b) { return a[0] * b[0] + a[1] * b[1] + a[2] * b[2]; }
+
+static inline float mp_angle_deg(const float* a, const float* b)
+{
+    float c = mp_dot(a, b);
+    if (c > 1.0f) c = 1.0f;
+    if (c < -1.0f) c = -1.0f;
+    return acosf(c) * 57.29578f;
+}
+
+static inline int mp_axis_of(const float* v)
+{
+    int k = 0;
+    float best = fabsf(v[0]);
+    for (int i = 1; i < 3; i++) {
+        if (fabsf(v[i]) > best) {
+            best = fabsf(v[i]);
+            k = i;
+        }
+    }
+    return k * 2 + (v[k] < 0.0f ? 1 : 0);
+}
+
+static inline mp_event_t mp_emit(mp_t* d, mp_event_t ev, uint32_t now)
+{
+    if (ev != MP_SHAKEN && d->last_event_ms != 0 && now - d->last_event_ms < MP_DEBOUNCE_MS) {
+        return MP_NONE;
+    }
+    d->last_event_ms = now ? now : 1;
+    d->axis          = (uint8_t)mp_axis_of(d->cur);
+    return ev;
+}
+
+/* One sample, accelerations in m/s^2 (any orientation). Returns the event it completed, or MP_NONE. */
+static inline mp_event_t mp_update(mp_t* d, float ax, float ay, float az, uint32_t now)
+{
+    const float a[3] = {ax / MP_G, ay / MP_G, az / MP_G};
+    const float mag = sqrtf(mp_dot(a, a));
+    if (mag < 0.2f || mag > 8.0f) {
+        return MP_NONE; /* not a sensible reading: skip it */
+    }
+    const float u[3] = {a[0] / mag, a[1] / mag, a[2] / mag};
+    if (!d->init) {
+        d->init = 1;
+        d->t_prev = now;
+        for (int i = 0; i < 3; i++) {
+            d->lp[i] = a[i];
+            d->cur[i] = u[i];
+            d->ref[i] = u[i];
+        }
+        return MP_NONE;
+    }
+    uint32_t dt = now - d->t_prev;
+    d->t_prev   = now;
+    if (dt == 0) {
+        return MP_NONE;
+    }
+    if (dt > 200) {
+        dt = 200; /* a gap in the readings: treat it as one step, not a long still period */
+    }
+    const float raw = mag - 1.0f;
+    const float k60 = (float)dt / ((float)dt + 60.0f);
+    d->dev_s += (raw - d->dev_s) * k60;
+    const float k300 = (float)dt / ((float)dt + 300.0f);
+    const float k100 = (float)dt / ((float)dt + 100.0f);
+    float hp[3];
+    for (int i = 0; i < 3; i++) {
+        d->lp[i] += (a[i] - d->lp[i]) * k300;
+        hp[i] = a[i] - d->lp[i];
+        d->cur[i] += (u[i] - d->cur[i]) * k100;
+    }
+    {
+        const float n = sqrtf(mp_dot(d->cur, d->cur));
+        if (n > 0.1f) {
+            for (int i = 0; i < 3; i++) d->cur[i] /= n;
+        }
+    }
+    const float adev = fabsf(d->dev_s);
+
+    /* stillness and the resting pose */
+    if (adev < MP_STILL_DEV && fabsf(raw) < 0.08f) {
+        d->still_ms += dt;
+    } else {
+        d->still_ms = 0;
+    }
+    const int own = d->own_until != 0 && (int32_t)(now - d->own_until) < 0;
+    if (!d->held && !own && d->still_ms >= MP_STILL_MS) {
+        d->ref_ok = 1;
+        for (int i = 0; i < 3; i++) d->ref[i] += (d->cur[i] - d->ref[i]) * 0.2f;
+        const float n = sqrtf(mp_dot(d->ref, d->ref));
+        if (n > 0.1f) {
+            for (int i = 0; i < 3; i++) d->ref[i] /= n;
+        }
+    }
+
+    /* shake: strokes (a swing of at least MP_SHAKE_G from the 300 ms average, alternating) within a second */
+    mp_event_t shaken = MP_NONE;
+    for (int i = 0; i < 3; i++) {
+        int8_t s = 0;
+        if (hp[i] >= MP_SHAKE_G) s = 1;
+        else if (hp[i] <= -MP_SHAKE_G) s = -1;
+        if (s != 0 && s != d->stroke_sign[i]) {
+            if (d->stroke_sign[i] != 0) {
+                /* an opposite stroke: remember when */
+                for (int j = 0; j + 1 < MP_SHAKE_STROKES; j++) d->strokes[j] = d->strokes[j + 1];
+                d->strokes[MP_SHAKE_STROKES - 1] = now;
+                if (d->stroke_n < MP_SHAKE_STROKES) d->stroke_n++;
+            }
+            d->stroke_sign[i] = s;
+        }
+    }
+    if (d->stroke_n >= MP_SHAKE_STROKES && now - d->strokes[0] <= MP_SHAKE_WINDOW_MS && (int32_t)(now - d->shake_until) >= 0) {
+        d->shake_until = now + 1500;
+        d->stroke_n    = 0;
+        d->cand        = 0;
+        d->ex_sign     = 0;
+        d->last_sign   = 0;
+        shaken         = MP_SHAKEN;
+    }
+    if (d->stroke_n > 0 && now - d->strokes[MP_SHAKE_STROKES - 1] > MP_SHAKE_WINDOW_MS) {
+        d->stroke_n = 0;
+    }
+    const int in_shake = (int32_t)(now - d->shake_until) < 0;
+
+    /* the unit's own activity: nothing is learnt from the body while it moves or speaks */
+    const float start = d->speaking ? MP_DEV_START_SPEAKING : MP_DEV_START;
+
+    if (own || in_shake) {
+        d->ex_sign = 0;
+        d->last_sign = 0;
+        d->cand = 0;
+        if (shaken != MP_NONE && d->held) {
+            return mp_emit(d, MP_SHAKEN, now);
+        }
+        return MP_NONE;
+    }
+
+    /* excursions: the smoothed signal leaving 1 g by MP_DEV_START, until it falls under MP_DEV_END */
+    if (d->ex_sign == 0) {
+        if (d->dev_s >= start) {
+            d->ex_sign = 1;
+            d->ex_ms   = 0;
+        } else if (d->dev_s <= -start) {
+            d->ex_sign = -1;
+            d->ex_ms   = 0;
+        }
+    } else {
+        d->ex_ms += dt;
+        const int over = d->ex_sign > 0 ? d->dev_s > MP_DEV_END : d->dev_s < -MP_DEV_END;
+        if (!over) {
+            /* closed */
+            if (d->ex_ms >= MP_LOBE_MIN_MS) {
+                if (!d->held && d->last_sign != 0 && d->last_sign != d->ex_sign && d->last_sign > 0 && d->last_dur >= MP_LOBE_MIN_MS &&
+                    now - d->last_end <= MP_LOBE_PAIR_MS) {
+                    /* up, then slowing: a hand lifted it straight up */
+                    if (!d->cand) {
+                        d->cand    = 1;
+                        d->cand_at = now;
+                    }
+                } else if (!d->held && d->ex_ms >= MP_TILT_LIFT_MS && d->ref_ok) {
+                    /* one long push, and the pose changed (checked at settle below) */
+                    if (!d->cand) {
+                        d->cand    = 2;
+                        d->cand_at = now;
+                    }
+                }
+                d->last_sign = d->ex_sign;
+                d->last_dur  = d->ex_ms;
+                d->last_end  = now;
+            } else {
+                d->last_sign = 0;
+            }
+            d->ex_sign = 0;
+        }
+    }
+    if (!d->held && d->last_sign != 0 && now - d->last_end > MP_LOBE_PAIR_MS) {
+        d->last_sign = 0;
+    }
+
+    /* a candidate lift: confirmed after a short wait with no shake, and (the long-push kind) a changed pose */
+    if (!d->held && d->cand != 0 && now - d->cand_at >= MP_CONFIRM_MS) {
+        const int kind = d->cand;
+        d->cand        = 0;
+        const int moved = d->ref_ok && mp_angle_deg(d->cur, d->ref) >= MP_TILT_LIFT_DEG;
+        if (kind == 1 || moved) {
+            d->held    = 1;
+            d->held_at = now;
+            d->carried = 0;
+            d->act     = 0.0f;
+            d->bump_at = 0;
+            return mp_emit(d, MP_LIFTED, now);
+        }
+    }
+
+    if (d->held) {
+        /* moving, as a share of the last second or so */
+        const float share = (float)dt / 1200.0f;
+        d->act += ((adev > 0.04f ? 1.0f : 0.0f) - d->act) * (share > 1.0f ? 1.0f : share);
+        if (!d->carried && now - d->held_at >= MP_CARRY_MS && d->act >= MP_CARRY_ACT) {
+            d->carried = 1;
+            const mp_event_t ev = mp_emit(d, MP_CARRIED, now);
+            if (ev != MP_NONE) return ev;
+        }
+        /* set down: a hand-sized spike, then stillness; or still for a long time back at the first pose */
+        if (fabsf(raw) >= MP_BUMP_G && now - d->held_at > 600) {
+            d->bump_at = now;
+        }
+        if (d->bump_at != 0) {
+            if (now - d->bump_at > MP_BUMP_WINDOW_MS) {
+                d->bump_at = 0;
+            } else if (d->still_ms >= MP_BUMP_STILL_MS && now - d->bump_at >= MP_BUMP_STILL_MS) {
+                d->held = d->carried = 0;
+                d->bump_at = 0;
+                d->cand = 0;
+                d->last_sign = 0;
+                return mp_emit(d, MP_SET_DOWN, now);
+            }
+        }
+        if (d->still_ms >= MP_QUIET_DOWN_MS && d->ref_ok && mp_angle_deg(d->cur, d->ref) <= MP_QUIET_DOWN_DEG && now - d->held_at > MP_QUIET_DOWN_MS) {
+            d->held = d->carried = 0;
+            d->bump_at = 0;
+            d->cand = 0;
+            d->last_sign = 0;
+            return mp_emit(d, MP_SET_DOWN, now);
+        }
+    }
+    return MP_NONE;
+}
+
+#endif /* MAIPAI_PICKUP_CORE_H */
