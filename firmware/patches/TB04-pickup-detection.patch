@@ -29,8 +30,17 @@ static void _imu_task(void* param)
     mo_orient_t orientation;  // patch I01: which way is down, reported to the host as an "orientation" event
     mo_init(&orientation);
 
+    // Patch TB04: the task runs every 20 ms so the pickup detector sees a lift (100 to 400 ms) in 5 to 20 readings; the
+    // shake, orientation and heal steps keep their old 100 ms rhythm (every fifth pass).
+    int pass = 0;
