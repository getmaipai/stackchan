+/*
+ * SPDX-License-Identifier: MIT
+ *
+ * Pickup, carried and set-down, device side (patch TB04). Logic: maipai_pickup_core.h.
+ */
+#pragma once
+#include <cstdint>
+
+// The unit moved its own head (called from the servo update while an animation runs): the body is ignored for 1.5 s.
+void maipai_pickup_own_activity();
+
+// One accelerometer reading in m/s^2, about every 20 ms, from the motion task. Sends the "lifted", "carried", "set_down" and
+// "shaken" device events and applies the saved pickup reaction.
+void maipai_pickup_feed(float ax, float ay, float az);
diff --git a/firmware/main/hal/maipai_pickup.cc b/firmware/main/hal/maipai_pickup.cc
new file mode 100644
index 0000000..87a312f
--- /dev/null
+++ b/firmware/main/hal/maipai_pickup.cc
@@ -0,0 +1,82 @@
+/*
+ * SPDX-License-Identifier: MIT
+ *
+ * Pickup, carried and set-down (patch TB04): the events for the host and the unit's own reaction (setting "Pickup
+ * reaction": off, face only, face and sound; default face only). The detector is maipai_pickup_core.h (136 bytes of
+ * state, all of it in this file's static). It sees the unit's own head moves through maipai_pickup_own_activity() and
+ * the unit's own speech through the device state, and ignores the body for 1.5 s after either.
+ */
+#include "maipai_pickup.h"
+#include "maipai_pickup_core.h"
+#include "maipai_tbprefs.h"
+#include "maipai_privacy.h"
+#include "maipai_screen.h"
+#include "maipai_sounds.h"
+#include "board/hal_bridge.h"
+#include "device_events.h"
+#include <application.h>
+#include <esp_timer.h>
+#include <atomic>
+#include <cstdio>
+
+namespace {
+mp_t s_det;
+bool s_ready = false;
+std::atomic<uint32_t> s_own_until{0};
+uint32_t ms_now() { return static_cast<uint32_t>(esp_timer_get_time() / 1000); }
+
+void react(mp_event_t ev)
+{
+    const uint8_t level = maipai_tb_prefs().pickup;
+    if (level == 0 || maipai_quiet()) return;
+    const DeviceState st = Application::GetInstance().GetDeviceState();
+    if (st != kDeviceStateIdle) return;  // a conversation is not interrupted by being picked up
+    switch (ev) {
+    case MP_LIFTED:
+        hal_bridge::react_face("surprised", 1500);
+        if (level == 2) (void)maipai_sounds_play("popup");
+        break;
+    case MP_CARRIED:
+        hal_bridge::react_face("content", 4000);  // calm, a small smile
+        break;
+    case MP_SET_DOWN:
+        hal_bridge::react_face("happy", 1500);
+        if (level == 2) (void)maipai_sounds_play("success");
+        break;
+    default:
+        break;
+    }
+}
+}  // namespace
+
+void maipai_pickup_own_activity()
+{
+    s_own_until.store(ms_now() + MP_OWN_HOLD_MS);
+}
+
+void maipai_pickup_feed(float ax, float ay, float az)
+{
+    if (!s_ready) {
+        mp_init(&s_det);
+        s_ready = true;
+    }
+    const uint32_t now = ms_now();
+    const uint32_t own = s_own_until.load();
+    if (own != 0 && static_cast<int32_t>(own - now) > 0) {
+        mp_note_own(&s_det, now, own - now, 0);
+    }
+    mp_set_speaking(&s_det, Application::GetInstance().GetDeviceState() == kDeviceStateSpeaking ? 1 : 0);
+    const mp_event_t ev = mp_update(&s_det, ax, ay, az, now);
+    if (ev == MP_NONE) return;
+    char extra[48];
+    snprintf(extra, sizeof(extra), "\"axis\":\"%s\"", mp_axis_name(mp_axis(&s_det)));
+    if (ev == MP_SHAKEN) {
+        device_events_push("shaken", extra);  // shaken in the hand; the shake of the table is swallowed by the core
+        return;
+    }
+    device_events_push(MP_EVENT_NAMES[ev], extra);
+    if (ev == MP_LIFTED) {
+        maipai_screen_wake("lift");  // a lift wakes a dimmed screen
+    }
+    react(ev);
+}
