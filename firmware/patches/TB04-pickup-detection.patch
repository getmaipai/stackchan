+        pass++;
+        bool fresh = false;
         if (_bmi270 && _bmi270->update()) {
+            fresh = true;
+            maipai_pickup_feed(_bmi270->getData().accel_x, _bmi270->getData().accel_y, _bmi270->getData().accel_z);
+        }
+        if (fresh && pass % 5 == 0) {
             auto& data = _bmi270->getData();
