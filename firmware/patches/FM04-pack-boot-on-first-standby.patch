     vTaskDelete(nullptr);
 }
 
+std::atomic<bool> s_boot_started{false};
+
 }  // namespace
 
+// Called every pass of the main loop (patch FM04). Cheap: one atomic read once the task has started.
+void maipai_packs_boot_poll(bool standby_reached)
+{
+    if (s_pm == nullptr || s_boot_started.load()) return;
+    if (!mpb_should_start(0, standby_reached ? 1 : 0, static_cast<uint32_t>(esp_timer_get_time() / 1000000))) return;
+    if (s_boot_started.exchange(true)) return;
+    // Transient: ends when the cache is applied. The wake model has loaded by now, so its 6 KB internal stack no longer costs
+    // the largest free block (the 15 s timer of patch TB02 guessed at this moment).
+    if (xTaskCreate(boot_task, "pack_boot", 6144, nullptr, 1, nullptr) != pdPASS) {
+        ESP_LOGW(TAG, "the pack boot task did not start (low memory): a saved look is not applied until the next restart");
+    }
+}
