@@ -0,0 +1,24 @@
+/*
+ * SPDX-License-Identifier: MIT
+ *
+ * The cloud brain test build (patch SF96, kind cloudtest, never the default and never in a release image). In this build the unit asks the
+ * vendor's published activation service for a connection, so an owner can try the vendor's hosted brain with their own account. Everything
+ * that makes it different from the normal build is behind CONFIG_MAIPAI_CLOUDTEST. See docs/plan/cloud-brain-firmware-test.md.
+ */
+#pragma once
+#include <sdkconfig.h>
+
+#if CONFIG_MAIPAI_CLOUDTEST
+// The vendor link's settings live in their own namespaces, so the paired host's address and token (namespace "websocket") are never overwritten.
+#define MAIPAI_WS_NS "cl_websocket"
+#define MAIPAI_MQTT_NS "cl_mqtt"
+// A permanent strip on the screen: "Cloud brain test". Call once at start-up.
+void maipai_cloudtest_start_banner();
+// Only these generic tools may be called by the vendor service: the unit's privacy, lock, update, asset, game and pantry tools stay out of its reach.
+bool maipai_cloudtest_tool_allowed(const char* name);
+#else
+#define MAIPAI_WS_NS "websocket"
+#define MAIPAI_MQTT_NS "mqtt"
+inline void maipai_cloudtest_start_banner() {}
+inline bool maipai_cloudtest_tool_allowed(const char*) { return true; }
+#endif
diff --git a/firmware/main/hal/maipai_cloudtest.cc b/firmware/main/hal/maipai_cloudtest.cc
new file mode 100644
--- /dev/null
+++ b/firmware/main/hal/maipai_cloudtest.cc
@@ -0,0 +1,60 @@
+/*
+ * SPDX-License-Identifier: MIT
+ *
+ * The cloud brain test build (patch SF96): the on-screen strip and the list of tools the vendor service may call. See maipai_cloudtest.h.
+ */
+#include "maipai_cloudtest.h"
+
+#if CONFIG_MAIPAI_CLOUDTEST
+#include "hal.h"
+#include <esp_log.h>
+#include <esp_timer.h>
+#include <lvgl.h>
+#include <cstring>
+
+namespace {
+
+void draw_strip()
+{
+    LvglLockGuard lock;
+    lv_obj_t* bar = lv_obj_create(lv_layer_sys());
+    lv_obj_remove_style_all(bar);
+    lv_obj_remove_flag(bar, LV_OBJ_FLAG_CLICKABLE);
+    lv_obj_remove_flag(bar, LV_OBJ_FLAG_SCROLLABLE);
+    lv_obj_set_size(bar, 320, 16);
+    lv_obj_set_pos(bar, 0, 224);
+    lv_obj_set_style_bg_color(bar, lv_color_hex(0xF2B24A), 0);
+    lv_obj_set_style_bg_opa(bar, LV_OPA_COVER, 0);
+    lv_obj_t* t = lv_label_create(bar);
+    lv_label_set_text(t, "Cloud brain test");
+    lv_obj_set_style_text_font(t, &lv_font_montserrat_14, 0);
+    lv_obj_set_style_text_color(t, lv_color_black(), 0);
+    lv_obj_center(t);
+}
+
+void once(void*)
+{
+    draw_strip();
+}
+
+}  // namespace
+
+void maipai_cloudtest_start_banner()
+{
+    static esp_timer_handle_t timer = nullptr;
+    esp_timer_create_args_t a = {};
+    a.callback = once;
+    a.name = "cloudtest_banner";
+    if (esp_timer_create(&a, &timer) == ESP_OK) esp_timer_start_once(timer, 3ll * 1000 * 1000);   // after the display is up
+}
+
+bool maipai_cloudtest_tool_allowed(const char* name)
+{
+    static const char* const kAllowed[] = {"self.get_device_status", "self.audio_speaker.set_volume", "self.screen.set_brightness", "self.screen.set_theme"};
+    for (const char* ok : kAllowed) {
+        if (strcmp(name, ok) == 0) return true;
+    }
+    return false;
+}
+
+#endif
