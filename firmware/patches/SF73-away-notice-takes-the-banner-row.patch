         if (mrc_notice_due(away_ms, last_notice_away_ms)) {
             last_notice_away_ms = away_ms;
-            hal_bridge::notice("Can't reach Home. Check it is on and on the same Wi-Fi. I keep trying.", 30000);  // patch SF68: 30 s on the banner row (it was 9 s, easy to miss)
+            hal_bridge::notice_urgent("Can't reach Home. Check it is on and on the same Wi-Fi. I keep trying.", 20000);  // patch SF73: the privacy priority (the steady Offline look held the row), 20 s (the banner row's limit)
             char away_extra[40];
