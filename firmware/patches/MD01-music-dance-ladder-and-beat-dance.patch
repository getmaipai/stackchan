# Intent: The music dance builds up and winds down on the beat. A pure core (maipai_dance_ladder_core.h: the step rule, the pose of each step, the 90 moves a minute head budget, the ring swell) and one BeatDanceModifier that replaces BeatSway: step 1 the eyes look side to side on the beat with the head still (about 1.5 s), 2 the head nods, 3 it sways side to side, 4 pan, tilt and sway together with a soft swell of gold, lime and mint on the ring (never over half brightness, rising 40 percent and falling 60 percent of each beat, no hard flash). self.music.stage sets the step from the host (and answers stage and beat); self.music.get_status adds stage. self.robot.dance bob is the nod on the beat. The unit's own offline session runs the same ladder cycle by the judge's timeline. With no fresh beat the last grid carries on, and the sway and full dance drop to the nod after 3 s. The ladder never goes above the limiter's dance_max (ML01).
# Placement: unit
# Upstream: firmware/main/stackchan/modifiers/beat_dance.h, firmware/main/hal/maipai_dance_ladder_core.h (ours)
# Check after a flash: self.music.set enabled true, then self.music.stage 1 shows the eyes stepping side to side on a steady tempo and the head still; 2 nods; 3 sways; 4 adds the swelling ring; 0 returns eyes and head to the middle and the ring dark. (Run only with the unit upright and the limiter showing usb_limited.)
# Kconfig: CONFIG_MAIPAI_MUSIC_DANCE (existing)

diff --git a/firmware/main/hal/maipai_dance_ladder_core.h b/firmware/main/hal/maipai_dance_ladder_core.h
new file mode 100644
--- /dev/null
+++ b/firmware/main/hal/maipai_dance_ladder_core.h
@@ -0,0 +1,313 @@
+/*
+ * SPDX-License-Identifier: MIT
+ *
+ * The dance ladder (patch MD01): the pure logic of a dance that builds up and winds down on the beat. Plain C99, no
+ * ESP-IDF, no heap, no clock of its own: host/tests/firmware/dance_ladder_test.c compiles it, and the host's
+ * dance_ladder.py is its mirror (a test feeds both the same scripted seconds and compares every stage).
+ *
+ * The ladder has four steps, each adding one thing to the one before:
+ *   1 eyes      only the eyes look side to side on the beat, the head stays still (about 1.5 s)
+ *   2 nod       the head nods on the beat, the eyes follow with a small shift
+ *   3 sway      the head sways side to side, the eyes lean the same way
+ *   4 full      pan, tilt and sway together (one combined head move per beat), the peak
+ * A cycle climbs 1 to 4 (a step only when the music is loud and steady enough for the next one), holds the peak for a
+ * number of beats, then goes back down 3, 2, 1 in reverse and ends at stage 0 (still). The same descent starts at once
+ * when the music fades or stops. A stage never skips upward; a step down may skip nothing either.
+ *
+ * Time is in milliseconds on the caller's clock. A beat is `period_ms` (0 means unknown: 600 ms). All dwell times are
+ * beats at that period, held between a floor and a ceiling so a very fast or slow song stays watchable.
+ */
+#ifndef MAIPAI_DANCE_LADDER_H
+#define MAIPAI_DANCE_LADDER_H
+
+#include <stdint.h>
+#include <string.h>
+
+#define MDL_STAGE_COUNT 5 /* 0 still, 1 eyes, 2 nod, 3 sway, 4 full */
+
+/* How long each step lasts, in beats, and the least and most in milliseconds. */
+#define MDL_EYES_BEATS 3
+#define MDL_EYES_MIN_MS 1500u
+#define MDL_EYES_MAX_MS 3000u
+#define MDL_STEP_BEATS 8
+#define MDL_STEP_MIN_MS 4000u
+#define MDL_STEP_MAX_MS 8000u
+#define MDL_PEAK_BEATS 24
+#define MDL_PEAK_MIN_MS 12000u
+#define MDL_PEAK_MAX_MS 20000u
+#define MDL_DOWN_BEATS 4
+#define MDL_DOWN_MIN_MS 2000u
+#define MDL_DOWN_MAX_MS 4000u
+#define MDL_MAX_CYCLE_MS 75000u /* a cycle that has not peaked by now starts down anyway: the host listens between cycles */
+
+/* The room's loudness (a moving average of the level, int16 RMS) and the beat's confidence that each step asks for. */
+#define MDL_LEVEL_MID 800
+#define MDL_LEVEL_HIGH 1500
+#define MDL_CLIMB_LEVEL_3 800  /* to reach sway */
+#define MDL_CLIMB_LEVEL_4 1000 /* to reach the full dance */
+#define MDL_CLIMB_TC_2 20
+#define MDL_CLIMB_TC_3 30
+#define MDL_CLIMB_TC_4 35
+#define MDL_PEAK_DROP_PCT 70       /* the peak ends when the level stays under this percent of its entry value... */
+#define MDL_PEAK_DROP_MS 6000u     /* ...for this long */
+#define MDL_LOST_MS 3000u          /* no music for this long: wind down now */
+
+typedef struct {
+    uint8_t stage;     /* 0 still (done), 1..4 */
+    uint8_t down;      /* 1 while winding down */
+    uint8_t max_stage; /* 1..4: the highest step this cycle may reach (a low battery or a gentle round) */
+    uint8_t started;
+    uint32_t cycle_ms; /* when the cycle began */
+    uint32_t stage_ms; /* when the current step began */
+    int peak_level;    /* the level when the peak began */
+    uint32_t low_ms;   /* the level has been low since (0 none) */
+    uint32_t lost_ms;  /* no music since (0 none) */
+} mdl_t;
+
+typedef struct {
+    uint32_t now_ms;
+    uint32_t period_ms; /* the beat, 0 unknown */
+    int level;          /* moving average of the level */
+    int tc;             /* tempo confidence */
+    int music;          /* 1 clear music this second */
+} mdl_in_t;
+
+static inline uint32_t mdl_clamp_ms(uint32_t v, uint32_t lo, uint32_t hi) { return v < lo ? lo : (v > hi ? hi : v); }
+static inline uint32_t mdl_period(uint32_t period_ms) { return period_ms >= 250u && period_ms <= 2000u ? period_ms : 600u; }
+
+/* How long the step lasts: `down` is the way back. */
+static inline uint32_t mdl_dwell_ms(int stage, int down, uint32_t period_ms)
+{
+    const uint32_t p = mdl_period(period_ms);
+    if (down) return mdl_clamp_ms(p * MDL_DOWN_BEATS, MDL_DOWN_MIN_MS, MDL_DOWN_MAX_MS);
+    if (stage <= 1) return mdl_clamp_ms(p * MDL_EYES_BEATS, MDL_EYES_MIN_MS, MDL_EYES_MAX_MS);
+    if (stage >= 4) return mdl_clamp_ms(p * MDL_PEAK_BEATS, MDL_PEAK_MIN_MS, MDL_PEAK_MAX_MS);
+    return mdl_clamp_ms(p * MDL_STEP_BEATS, MDL_STEP_MIN_MS, MDL_STEP_MAX_MS);
+}
+
+static inline void mdl_start(mdl_t* s, int max_stage, uint32_t now_ms)
+{
+    memset(s, 0, sizeof(*s));
+    s->max_stage = (uint8_t)(max_stage < 1 ? 1 : (max_stage > 4 ? 4 : max_stage));
+    s->stage = 1;
+    s->started = 1;
+    s->cycle_ms = now_ms;
+    s->stage_ms = now_ms;
+}
+
+/* Whether the music and the beat are good enough to go up to `to`. */
+static inline int mdl_can_climb(int to, const mdl_in_t* in)
+{
+    if (!in->music) return 0;
+    switch (to) {
+        case 2: return in->tc >= MDL_CLIMB_TC_2;
+        case 3: return in->level >= MDL_CLIMB_LEVEL_3 && in->tc >= MDL_CLIMB_TC_3;
+        case 4: return in->level >= MDL_CLIMB_LEVEL_4 && in->tc >= MDL_CLIMB_TC_4;
+        default: return 1;
+    }
+}
+
+static inline void mdl_go_down(mdl_t* s, uint32_t now_ms)
+{
+    if (s->down) return;
+    s->down = 1;
+    s->stage_ms = now_ms;
+}
+
+/* One step (about once a second). Returns the stage to show now: 0 when the cycle is over (and from then on). */
+static inline int mdl_step(mdl_t* s, const mdl_in_t* in)
+{
+    if (!s->started || s->stage == 0) return 0;
+    const uint32_t now = in->now_ms;
+    /* the music fading or going: wind down */
+    if (in->music) {
+        s->lost_ms = 0;
+    } else if (s->lost_ms == 0) {
+        s->lost_ms = now ? now : 1u;
+    }
+    if (s->lost_ms != 0 && now - s->lost_ms >= MDL_LOST_MS) mdl_go_down(s, now);
+    if (!s->down && now - s->cycle_ms >= MDL_MAX_CYCLE_MS) mdl_go_down(s, now);
+    const uint32_t held = now - s->stage_ms;
+    if (s->down) {
+        if (held >= mdl_dwell_ms(s->stage, 1, in->period_ms)) {
+            if (s->stage <= 1) {
+                s->stage = 0;
+                return 0;
+            }
+            s->stage--;
+            s->stage_ms = now;
+        }
+        return s->stage;
+    }
+    if (s->stage >= 4) {
+        /* the peak: hold the beats, or end it when the level falls away */
+        if (s->peak_level == 0) s->peak_level = in->level > 1 ? in->level : 1;
+        if (in->level * 100 < s->peak_level * MDL_PEAK_DROP_PCT) {
+            if (s->low_ms == 0) s->low_ms = now ? now : 1u;
+        } else {
+            s->low_ms = 0;
+        }
+        if ((s->low_ms != 0 && now - s->low_ms >= MDL_PEAK_DROP_MS) || held >= mdl_dwell_ms(4, 0, in->period_ms)) {
+            mdl_go_down(s, now);
+        }
+        return s->stage;
+    }
+    if (held >= mdl_dwell_ms(s->stage, 0, in->period_ms) && s->stage < s->max_stage && mdl_can_climb(s->stage + 1, in)) {
+        s->stage++;
+        s->stage_ms = now;
+        s->peak_level = 0;
+        s->low_ms = 0;
+    } else if (held >= mdl_dwell_ms(s->stage, 0, in->period_ms) && s->stage >= s->max_stage) {
+        mdl_go_down(s, now); /* this cycle may not go higher: the way back starts */
+    }
+    return s->stage;
+}
+
+/* The level: a moving average of the last four seconds. */
+typedef struct {
+    int v[4];
+    int n;
+    int head;
+} mdl_energy_t;
+
+static inline void mdl_energy_reset(mdl_energy_t* e) { memset(e, 0, sizeof(*e)); }
+static inline int mdl_energy_push(mdl_energy_t* e, int level)
+{
+    e->v[e->head] = level;
+    e->head = (e->head + 1) & 3;
+    if (e->n < 4) e->n++;
+    int sum = 0;
+    for (int i = 0; i < e->n; i++) sum += e->v[i];
+    return sum / e->n;
+}
+
+/* ---------------------------------------------------------------- the motion of each step */
+
+/* Eye gaze is in the face's position units (100 is 10 px, the widest the face zone allows); the head is in tenths of a degree. */
+typedef struct {
+    int eye_x, eye_y;
+    int head;  /* 1: this beat moves the head */
+    int yaw, pitch;
+    int speed;
+} mdl_pose_t;
+
+#define MDL_EYE_FULL 100
+#define MDL_EYE_SMALL 40
+#define MDL_EYE_TILT 30
+
+/* `side` is +1 or -1 and flips every beat; `beat` counts beats (the nod and the figure eight read it); `span_ms` is the time
+ * one head move has (a beat, or two beats above about 133 BPM); `loud` is 1 at a high level. Stage 0 stands still. */
+static inline mdl_pose_t mdl_pose(int stage, int side, int beat, uint32_t span_ms, int loud)
+{
+    mdl_pose_t p;
+    memset(&p, 0, sizeof(p));
+    if (span_ms < 1u) span_ms = 600u;
+    int speed = (int)(240000u / span_ms);
+    speed = speed < 220 ? 220 : (speed > 600 ? 600 : speed);
+    const int swing = span_ms < 600u ? 200 : 300;
+    p.speed = speed;
+    switch (stage) {
+        case 1:
+            p.eye_x = side * MDL_EYE_FULL;
+            break;
+        case 2:
+            p.eye_x = side * MDL_EYE_SMALL;
+            p.head = 1;
+            p.pitch = side > 0 ? -170 : -40; /* the nod */
+            break;
+        case 3:
+            p.eye_x = side * MDL_EYE_FULL;
+            p.head = 1;
+            p.yaw = side * swing;
+            p.pitch = -100;
+            break;
+        case 4: {
+            const int up = ((beat >> 1) & 1) != 0; /* the tilt turns over every two beats: yaw and tilt trace a small figure eight */
+            p.eye_x = side * MDL_EYE_FULL;
+            p.eye_y = up ? -MDL_EYE_TILT : MDL_EYE_TILT;
+            p.head = 1;
+            p.yaw = side * swing;
+            p.pitch = up ? -170 : -30;
+            if (loud) {
+                speed = speed + speed / 10;
+                p.speed = speed > 600 ? 600 : speed;
+            }
+            break;
+        }
+        default: break;
+    }
+    return p;
+}
+
+/* A step that has lost the beat for a while may not show the full dance: no lock for 3 s, nod only. */
+static inline int mdl_effective_stage(int stage, uint32_t no_beat_ms)
+{
+    if (stage >= 3 && no_beat_ms >= 3000u) return 2;
+    return stage;
+}
+
+/* ---------------------------------------------------------------- the head budget */
+
+/* At most MDL_BUDGET_MOVES head moves in any minute: past it the head stands still for a beat and the eyes carry on. */
+#define MDL_BUDGET_MOVES 90
+#define MDL_BUDGET_WINDOW_MS 60000u
+typedef struct {
+    uint32_t t[MDL_BUDGET_MOVES];
+    int next;
+} mdl_budget_t;
+
+static inline void mdl_budget_reset(mdl_budget_t* b) { memset(b, 0, sizeof(*b)); }
+/* 1 and the move is counted, or 0 when the minute already holds 90. */
+static inline int mdl_budget_take(mdl_budget_t* b, uint32_t now_ms)
+{
+    const uint32_t oldest = b->t[b->next];
+    if (oldest != 0u && now_ms - oldest < MDL_BUDGET_WINDOW_MS) return 0;
+    b->t[b->next] = now_ms == 0u ? 1u : now_ms;
+    b->next = (b->next + 1) % MDL_BUDGET_MOVES;
+    return 1;
+}
+
+/* ---------------------------------------------------------------- the ring swell (the peak) */
+
+#define MDL_RING_CHANNEL_MAX 168
+#define MDL_RING_CAP_PCT 50 /* never brighter than half of full */
+#define MDL_RING_PIXELS 12
+
+/* The swell: a smooth hump over the beat, rising for 40 percent of it and falling for 60, so it never goes hard on or off. Returns
+ * 0..255. `phase_ms` is the time since the last beat, `span_ms` the beat (or two beats). The rise is u(2-u) and the fall 1-v^2
+ * (a quarter sine each, good to a few percent, no table). */
+static inline int mdl_swell(uint32_t phase_ms, uint32_t span_ms)
+{
+    if (span_ms < 1u) return 0;
+    const uint32_t p = phase_ms % span_ms;
+    const uint32_t rise = span_ms * 4u / 10u;
+    if (rise > 0u && p < rise) {
+        const uint32_t u = p * 1000u / rise; /* 0..999 */
+        return (int)(u * (2000u - u) / 1000u * 255u / 1000u);
+    }
+    const uint32_t fall = span_ms - rise;
+    const uint32_t v = fall > 0u ? (p - rise) * 1000u / fall : 0u; /* 0..999 */
+    return (int)((1000000u - v * v) / 1000u * 255u / 1000u);
+}
+
+/* The full ring at the peak: a gold wash from 0.30 to 0.50 of full, `swell` (0..255) from the swell above, the side lights (0..5 left, 6..11
+ * right) leaning toward `side`. Writes 12 RGB triples; no channel goes over MDL_RING_CAP_PCT percent of MDL_RING_CHANNEL_MAX. */
+static inline void mdl_ring_frame(uint8_t out[MDL_RING_PIXELS][3], int swell, int side, uint32_t turn)
+{
+    static const uint8_t col[3][3] = {{255, 204, 0}, {153, 255, 0}, {77, 255, 153}}; /* gold, lime, mint (the show's colors) */
+    const int base = 30, top = MDL_RING_CAP_PCT;                                     /* percent of full */
+    for (int i = 0; i < MDL_RING_PIXELS; i++) {
+        const int left = i < 6;
+        const int lean = (side < 0 ? left : !left) ? 8 : 0; /* the side the head goes to is a little brighter */
+        int pct = base + (top - base - 8) * swell / 255 + lean;
+        if (pct > top) pct = top;
+        const uint8_t* c = col[((uint32_t)(i / 2) + turn) % 3];
+        for (int k = 0; k < 3; k++) {
+            int v = MDL_RING_CHANNEL_MAX * pct / 100 * c[k] / 255;
+            const int cap = MDL_RING_CHANNEL_MAX * MDL_RING_CAP_PCT / 100;
+            out[i][k] = (uint8_t)(v > cap ? cap : v);
+        }
+    }
+}
+
+#endif
diff --git a/firmware/main/stackchan/modifiers/beat_dance.h b/firmware/main/stackchan/modifiers/beat_dance.h
