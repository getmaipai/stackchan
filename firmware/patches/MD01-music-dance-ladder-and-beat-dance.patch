--- /dev/null
+++ b/firmware/main/stackchan/modifiers/beat_dance.h
@@ -0,0 +1,150 @@
+/*
+ * MaiPai patch MD01: the dance that builds up on the beat of the song and winds down again (the music dance ladder,
+ * hal/maipai_dance_ladder_core.h). One modifier plays whichever step is set (maipai_music_stage_get): 1 the eyes look side to
+ * side on the beat with the head still, 2 the head nods, 3 it sways side to side, 4 pan, tilt and sway together with a
+ * soft swell of light on the ring. The beat comes from the music analysis (maipai_beat_get: the period and the time of a
+ * recent beat); with no fresh beat the last one carries on, and after three seconds without one the sway and the full
+ * dance drop to the nod. The head moves at most once per beat (every second beat above about 133 BPM, the eyes still
+ * step on every beat) and never more than 90 times a minute (mdl_budget_take). Changing the step changes a number
+ * inside the running modifier; the one that sets it (maipai_music_stage_set) adds and removes the modifier.
+ */
+#pragma once
+#include "../modifiable.h"
+#include "../../hal/maipai_dance_ladder_core.h"
+#include <hal/hal.h>
+#include <esp_timer.h>
+#include <cstdint>
+
+// hal_music (maipai_music.cc): true while a beat was measured in the last 3 seconds with a confidence of at least 30.
+bool maipai_beat_get(uint32_t* period_ms, uint32_t* ref_ms);
+// hal_mcp.cpp: the ladder step to play (0 stands still), and whether the ring may be painted (no privacy cue, no ringing timer).
+int maipai_music_stage_get();
+bool maipai_dance_ring_allowed();
+int maipai_music_level();
+
+namespace stackchan {
+
+class BeatDanceModifier : public Modifier {
+public:
+    BeatDanceModifier() : _t0(ms_now()), _beat_seen(_t0)
+    {
+        mdl_budget_reset(&_budget);
+    }
+
+    ~BeatDanceModifier() override
+    {
+        ring_dark();
+    }
+
+    void _update(Modifiable& stackchan) override
+    {
+        if (!stackchan.hasAvatar()) {
+            return;
+        }
+        const int stage = maipai_music_stage_get();
+        if (stage <= 0) {
+            ring_dark();
+            return;
+        }
+        const uint32_t now = ms_now();
+        uint32_t period = 0, ref = 0;
+        if (maipai_beat_get(&period, &ref) && period >= 250) {
+            _last_period = period;
+            _last_ref    = ref;
+            _have_last   = true;
+            _beat_seen   = now;
+        } else if (_have_last) {
+            period = _last_period;  // no fresh beat: the last grid carries on
+            ref    = _last_ref;
+        } else {
+            period = 600;  // none yet: a steady 600 ms
+            ref    = _t0;
+        }
+        const int eff = mdl_effective_stage(stage, now - _beat_seen);
+        const int32_t since = static_cast<int32_t>(now - ref);
+        const int32_t eb = since >= 0 ? since / static_cast<int32_t>(period)
+                                      : -1 - ((-since - 1) / static_cast<int32_t>(period));  // the eyes' beat
+        const int step   = period < 450 ? 2 : 1;                                             // the head's: above 133 BPM every second one
+        const int32_t hb = eb >= 0 ? eb / step : -1 - ((-eb - 1) / step);
+        if (!_have_eb || eb != _last_eb) {
+            _have_eb = true;
+            _last_eb = eb;
+            const int side = (eb & 1) ? 1 : -1;
+            const mdl_pose_t pose = mdl_pose(eff, side, static_cast<int>(hb), period * static_cast<uint32_t>(step), maipai_music_level() >= MDL_LEVEL_HIGH);
+            gaze(stackchan, pose.eye_x, pose.eye_y);
+            if (eff == 1 && _head_moved) {
+                // Back to the eyes only: the head goes level once.
+                stackchan.motion().moveWithSpeed(0, 0, 200);
+                _head_moved = false;
+            }
+            if (pose.head && (eb % step == 0) && !(_have_hb && hb == _last_hb)) {
+                _have_hb = true;
+                _last_hb = hb;
+                const int hside = (hb & 1) ? 1 : -1;
+                const mdl_pose_t hp = mdl_pose(eff, hside, static_cast<int>(hb), period * static_cast<uint32_t>(step), maipai_music_level() >= MDL_LEVEL_HIGH);
+                if (mdl_budget_take(&_budget, now)) {
+                    stackchan.motion().moveWithSpeed(hp.yaw, hp.pitch, hp.speed);
+                    _head_moved = true;
+                }
+            }
+        }
+        if (eff >= 4 && maipai_dance_ring_allowed()) {
+            if (now - _ring_at >= 50) {  // 20 a second at most
+                _ring_at = now;
+                const uint32_t span = period * static_cast<uint32_t>(step);
+                const uint32_t phase = static_cast<uint32_t>(since >= 0 ? since : -since) % span;
+                uint8_t px[MDL_RING_PIXELS][3];
+                mdl_ring_frame(px, mdl_swell(phase, span), (eb & 1) ? 1 : -1, static_cast<uint32_t>(hb >= 0 ? hb / 8 : 0));
+                auto& hal = GetHAL();
+                for (int i = 0; i < MDL_RING_PIXELS; i++) {
+                    hal.setRgbColor(static_cast<uint8_t>(i), px[i][0], px[i][1], px[i][2]);
+                }
+                hal.refreshRgb();
+                _ring_on = true;
+            }
+        } else {
+            ring_dark();
+        }
+    }
+
+private:
+    static uint32_t ms_now()
+    {
+        return static_cast<uint32_t>(esp_timer_get_time() / 1000);
+    }
+
+    static void gaze(Modifiable& stackchan, int x, int y)
+    {
+        stackchan.avatar().leftEye().setPosition(uitk::Vector2i(x, y));
+        stackchan.avatar().rightEye().setPosition(uitk::Vector2i(x, y));
+    }
+
+    void ring_dark()
+    {
+        if (!_ring_on) {
+            return;
+        }
+        _ring_on = false;
+        auto& hal = GetHAL();
+        for (int i = 0; i < MDL_RING_PIXELS; i++) {
+            hal.setRgbColor(static_cast<uint8_t>(i), 0, 0, 0);
+        }
+        hal.refreshRgb();
+    }
+
+    mdl_budget_t _budget;
+    uint32_t _t0           = 0;
+    uint32_t _beat_seen    = 0;
+    uint32_t _last_period  = 0;
+    uint32_t _last_ref     = 0;
+    uint32_t _ring_at      = 0;
+    bool _have_last        = false;
+    bool _have_eb          = false;
+    bool _have_hb          = false;
+    bool _head_moved       = false;
+    bool _ring_on          = false;
+    int32_t _last_eb       = 0;
+    int32_t _last_hb       = 0;
+};
+
