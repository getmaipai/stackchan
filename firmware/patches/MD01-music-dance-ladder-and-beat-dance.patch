+// The unit's own cycle of the dance ladder while Home is unreachable (patch MD01): climb from the eyes to the full dance on the
+// beat, hold the peak, wind down in reverse, rest two seconds, again, for as long as the judge says the session goes on.
+struct Ladder {
+    mdl_t st;
+    mdl_energy_t energy;
+    bool active = false;     // a cycle is running
+    uint32_t rest_ms = 0;    // when the last cycle ended (0 none)
+    int max_stage = 4;
+};
+Ladder s_ladder;
+
+void ladder_begin(uint32_t now_ms, int max_stage)
+{
+    mdl_start(&s_ladder.st, max_stage, now_ms);
+    mdl_energy_reset(&s_ladder.energy);
+    s_ladder.active = true;
+    s_ladder.rest_ms = 0;
+    s_ladder.max_stage = max_stage;
+    maipai_music_stage_set(1);
+}
+
+void ladder_end()
+{
+    s_ladder.active = false;
+    s_ladder.rest_ms = 0;
+    maipai_music_stage_set(0);
+}
+
+// Once a second while the unit dances on its own: steps the cycle and shows its step.
+void ladder_tick(const mm_feat_t& f, bool music, uint32_t now_ms)
+{
+    const int avg = mdl_energy_push(&s_ladder.energy, f.lv);
+    if (!s_ladder.active) {
+        if (s_ladder.rest_ms == 0) {
+            s_ladder.rest_ms = now_ms ? now_ms : 1u;
+        } else if (music && now_ms - s_ladder.rest_ms >= 2000u) {
+            ladder_begin(now_ms, s_ladder.max_stage);  // the music goes on: the next cycle
+        }
+        return;
+    }
+    uint32_t period = 0, ref = 0;
+    maipai_beat_get(&period, &ref);
+    const mdl_in_t in = {now_ms, period, avg, f.tc, music ? 1 : 0};
+    const int stage = mdl_step(&s_ladder.st, &in);
+    if (stage == 0) {
+        s_ladder.active = false;
+        s_ladder.rest_ms = now_ms ? now_ms : 1u;
+        maipai_music_stage_set(0);
+    } else if (stage != maipai_music_stage_get()) {
+        maipai_music_stage_set(stage);
+    }
+}
+
