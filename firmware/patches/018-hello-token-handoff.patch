+            Settings settings("websocket", false);
+            if (settings.GetString("token") != value) {
+                Settings writable_settings("websocket", true);
+                writable_settings.SetString("token", value);
+                ESP_LOGI(TAG, "token updated (length=%u)", static_cast<unsigned>(value.size()));
