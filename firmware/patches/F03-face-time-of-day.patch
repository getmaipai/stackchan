diff --git a/firmware/main/hal/maipai_face_tod_core.h b/firmware/main/hal/maipai_face_tod_core.h
new file mode 100644
index 0000000..87e1608
--- /dev/null
+++ b/firmware/main/hal/maipai_face_tod_core.h
@@ -0,0 +1,63 @@
+/*
+ * SPDX-License-Identifier: MIT
+ *
+ * Time-of-day face variants (patch F03): the pure logic, no ESP-IDF, no clock of its own. The caller
+ * passes the local minute of the day in. Header-only plain C99 so a host compiler can test it.
+ *
+ * Four bands (morning, day, evening, night) start at the hours in the face settings; night runs
+ * through midnight. A band changes two things only: how far the eyelids may open (a sleepier look
+ * late in the day) and how bright the drawing colour is (softer at night). Nothing else about the
+ * face changes, and a unit whose clock was never set stays in the day look.
+ */
+#ifndef MAIPAI_FACE_TOD_CORE_H
+#define MAIPAI_FACE_TOD_CORE_H
+
+#include "maipai_face_core.h"
+
+#define MF_BAND_MORNING 0
+#define MF_BAND_DAY 1
+#define MF_BAND_EVENING 2
+#define MF_BAND_NIGHT 3
+
+/* `minute` is the unit's local minute of the day (0 to 1439), or -1 while its clock is not set. */
+static inline int mf_band_for_minute(const mf_config_t* c, int minute)
+{
+    if (!c->tod || minute < 0 || minute > 1439) {
+        return MF_BAND_DAY;
+    }
+    const int hour = minute / 60;
+    if (hour >= c->tod_from[3] || hour < c->tod_from[0]) {
+        return MF_BAND_NIGHT;
+    }
+    if (hour >= c->tod_from[2]) {
+        return MF_BAND_EVENING;
+    }
+    if (hour >= c->tod_from[1]) {
+        return MF_BAND_DAY;
+    }
+    return MF_BAND_MORNING;
+}
+
+/* How far the eyelids may open, in percent of fully open. */
+static inline int mf_band_lid_cap(int band)
+{
+    switch (band) {
+        case MF_BAND_EVENING: return 90;
+        case MF_BAND_NIGHT: return 70;
+        default: return 100;
+    }
+}
+
+/* How bright the drawing colour is, in percent. */
+static inline int mf_band_dim_pct(int band)
+{
+    switch (band) {
+        case MF_BAND_EVENING: return 85;
+        case MF_BAND_NIGHT: return 55;
+        default: return 100;
+    }
+}
+
+static inline uint8_t mf_scale_channel(uint8_t v, int pct) { return (uint8_t)((v * pct + 50) / 100); }
+
+#endif /* MAIPAI_FACE_TOD_CORE_H */
