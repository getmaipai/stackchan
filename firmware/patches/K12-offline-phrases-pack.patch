# Intent: The offline phrases as a pack (V02 embedded the sixteen clips in the app image, one voice, one language). A phrase pack is a zip of the same sixteen files, ph_<group>_<n>.ogg, made by the host with the active voice and the household's language; maipai_phrasepack_core.h turns it into one PSRAM block and a table (every clip must start with the Ogg capture pattern and pass its checksum, a bad one is left out whole), maipai_phrasepack.cc swaps it in under a mutex. The wake path says the pack's clip when the pack has it, else the clip built into the image, else the tone, per clip. MAIPAI_OFFLINE_PHRASES_EMBED (default y) keeps the sixteen clips in the image as the fallback; n drops about 76 KB of flash and a unit with no pack plays the tone. self.audio.sound_info reports pack_clips.
# Placement: unit (the phrases are said by the robot with the host off; the host builds the pack from the active voice)
# Upstream: firmware/main/hal/maipai_sounds.cc (ours, V02); new hal/maipai_phrasepack_core.h, maipai_phrasepack.{h,cc}
# Check after a flash: self.audio.sound_info reports pack_clips 0 with no pack and 16 with the household's pack; self.audio.offline_phrase with dry true answers kind clip and the byte count of the pack's clip (different from the image's); the same call after self.pack.remove type phrase answers the image's clip again; with the hub stopped the wake word says the pack's no_host clip.
# Kconfig: MAIPAI_OFFLINE_PHRASES_EMBED (default y, needs MAIPAI_OFFLINE_PHRASES); off leaves the clips out of the image.

diff --git a/firmware/main/hal/maipai_phrasepack_core.h b/firmware/main/hal/maipai_phrasepack_core.h
new file mode 100644
--- /dev/null
+++ b/firmware/main/hal/maipai_phrasepack_core.h
@@ -0,0 +1,70 @@
+/*
+ * SPDX-License-Identifier: MIT
+ *
+ * The offline phrases as a pack (patch K12): the pure logic. The unit's sixteen offline clips (five groups, MS_GROUP_SIZE in
+ * maipai_sounds_core.h) used to exist only as data in the app image, in one voice and one language. A phrase pack carries the
+ * same sixteen files, ph_<group>_<n>.ogg (Ogg Opus, as the image ones), made by the host with the household's own voice and
+ * language. The shared pack loader checks and keeps it; this file turns the zip into one block of clip bytes and a table of
+ * where each clip sits. A clip the pack lacks (or one that is not an Ogg stream) stays unset, and the caller then uses the
+ * clip built into the image, when the image has one, and the tone otherwise. Plain C99, no allocation, no hardware.
+ * Host test: host/tests/firmware/phrasepack_core_test.c.
+ */
+#ifndef MAIPAI_PHRASEPACK_CORE_H
+#define MAIPAI_PHRASEPACK_CORE_H
+
+#include "maipai_pack_core.h"
+#include "maipai_sounds_core.h"
+
+#define MPH_CLIP_MAX 60000u      /* bytes of one clip (the image's are 2 to 6 KB) */
+#define MPH_CLIP_MIN 64u         /* smaller than this is not an Ogg stream */
+#define MPH_BLOCK_MAX 150000u    /* bytes of all clips together: the pack's size gate (TPK_MAX_BYTES[TPK_PHRASE]) */
+
+typedef struct {
+    uint32_t off[MS_GRP_COUNT][4]; /* offset of the clip inside the block */
+    uint32_t len[MS_GRP_COUNT][4]; /* 0: this clip is not in the pack */
+    uint32_t total;                /* bytes used in the block */
+    uint8_t count;                 /* clips found (0 to 16) */
+} mph_table_t;
+
+/* How many bytes the block must have for this zip: the sum of its usable clips. 0 when the zip holds none. */
+static inline uint32_t mph_need(const tpz_t* z)
+{
+    uint32_t need = 0;
+    char name[32];
+    for (int g = 0; g < MS_GRP_COUNT; g++) {
+        for (int v = 0; v < MS_GROUP_SIZE[g]; v++) {
+            if (!ms_phrase_file(name, sizeof(name), g, v)) continue;
+            const tpz_entry_t* e = tpz_find(z, name);
+            if (e == NULL || e->usize < MPH_CLIP_MIN || e->usize > MPH_CLIP_MAX) continue;
+            if (need + e->usize > MPH_BLOCK_MAX) continue;
+            need += e->usize;
+        }
+    }
+    return need;
+}
+
+/* Extracts the usable clips into `block` (cap bytes, at least mph_need) and fills the table. Every clip must start with the
+ * Ogg capture pattern "OggS" and pass its checksum; one that does not is left out, not half kept. TPK_OK when at least one
+ * clip is usable, else TPK_ERR_ZIP. */
+static inline tpk_err_t mph_build(const tpz_t* z, tpz_inflate_fn inflate, uint8_t* block, size_t cap, mph_table_t* t)
+{
+    memset(t, 0, sizeof(*t));
+    char name[32];
+    for (int g = 0; g < MS_GRP_COUNT; g++) {
+        for (int v = 0; v < MS_GROUP_SIZE[g]; v++) {
+            if (!ms_phrase_file(name, sizeof(name), g, v)) continue;
+            const tpz_entry_t* e = tpz_find(z, name);
+            if (e == NULL || e->usize < MPH_CLIP_MIN || e->usize > MPH_CLIP_MAX) continue;
+            if (t->total + e->usize > MPH_BLOCK_MAX || t->total + e->usize > cap) continue;
+            if (tpz_extract(z, e, block + t->total, cap - t->total, inflate) != TPK_OK) continue;
+            if (memcmp(block + t->total, "OggS", 4) != 0) continue;
+            t->off[g][v] = t->total;
+            t->len[g][v] = e->usize;
+            t->total += e->usize;
+            t->count++;
+        }
+    }
+    return t->count > 0 ? TPK_OK : TPK_ERR_ZIP;
+}
+
+#endif /* MAIPAI_PHRASEPACK_CORE_H */
