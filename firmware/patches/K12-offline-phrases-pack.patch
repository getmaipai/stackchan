+/*
+ * SPDX-License-Identifier: MIT
+ *
+ * The offline phrases as a pack, device side (patch K12). Logic: maipai_phrasepack_core.h.
+ */
+#pragma once
+#include <cstddef>
+#include <cstdint>
+#include <mutex>
+#include <string_view>
+
+// The shared pack loader calls this with a phrase pack's zip, or with null/0 to go back to the clips built into the image.
+// Returns false (and a plain reason in *why) when the pack cannot be used; the clips in use do not change then.
+bool maipai_phrasepack_load(const uint8_t* payload, size_t len, const char** why);
+
+// How many of the sixteen clips the held pack carries (0 when none is held).
+int maipai_phrasepack_count();
+
+// The pack's clip for a group and variant, or an empty view when the pack has none. The view points into the pack's own
+// block: hold maipai_phrasepack_mutex() while you read it (PlaySound copies what it needs before it returns).
+std::string_view maipai_phrasepack_clip(int group, int variant);
+std::mutex& maipai_phrasepack_mutex();
diff --git a/firmware/main/hal/maipai_phrasepack.cc b/firmware/main/hal/maipai_phrasepack.cc
new file mode 100644
--- /dev/null
+++ b/firmware/main/hal/maipai_phrasepack.cc
@@ -0,0 +1,87 @@
+/*
+ * SPDX-License-Identifier: MIT
+ *
+ * The offline phrases as a pack, device side (patch K12). One PSRAM block holds the clips (about 60 KB for sixteen); a new
+ * pack is extracted into a new block, then swapped in under the mutex, and the old block is freed. A reader holds the same
+ * mutex while it hands a clip to PlaySound, so a swap never frees a clip that is being read.
+ */
+#include "maipai_phrasepack.h"
+#include "maipai_phrasepack_core.h"
+#include <esp_heap_caps.h>
+#include <esp_log.h>
+#include "maipai_inflate.h"
+#include <cstring>
+
+static const char* TAG = "MAIPAI-PHRASEPACK";
+
+namespace {
+
+std::mutex s_mu;
+uint8_t* s_block = nullptr;
+mph_table_t* s_table = nullptr;  // 0.2 KB, PSRAM
+
+long inflate_raw(const uint8_t* in, size_t inlen, uint8_t* out, size_t cap) { return maipai_inflate_raw(in, inlen, out, cap); }  // state in PSRAM, not on this stack
+
+}  // namespace
+
+std::mutex& maipai_phrasepack_mutex() { return s_mu; }
+
+int maipai_phrasepack_count()
+{
+    std::lock_guard<std::mutex> lock(s_mu);
+    return s_table != nullptr && s_block != nullptr ? s_table->count : 0;
+}
+
+std::string_view maipai_phrasepack_clip(int group, int variant)
+{
+    if (s_table == nullptr || s_block == nullptr || group < 0 || group >= MS_GRP_COUNT || variant < 0 || variant >= MS_GROUP_SIZE[group]) {
+        return std::string_view();
+    }
+    if (s_table->len[group][variant] == 0) return std::string_view();
+    return std::string_view(reinterpret_cast<const char*>(s_block + s_table->off[group][variant]), s_table->len[group][variant]);
+}
+
+bool maipai_phrasepack_load(const uint8_t* payload, size_t len, const char** why)
+{
+    *why = "";
+    if (payload == nullptr || len == 0) {
+        std::lock_guard<std::mutex> lock(s_mu);
+        if (s_block != nullptr) heap_caps_free(s_block);
+        s_block = nullptr;
+        if (s_table != nullptr) memset(s_table, 0, sizeof(*s_table));
+        return true;
+    }
+    tpz_t* z = static_cast<tpz_t*>(heap_caps_malloc(sizeof(tpz_t), MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT));
+    if (z == nullptr) { *why = tpk_say(TPK_ERR_MEMORY, 0); return false; }
+    struct Free { void* p; ~Free() { heap_caps_free(p); } } free_z{z};
+    if (tpz_open(z, payload, len) != TPK_OK) { *why = tpk_say(TPK_ERR_ZIP, 0); return false; }
+    const uint32_t need = mph_need(z);
+    if (need == 0) { *why = tpk_say(TPK_ERR_ZIP, 0); return false; }
+    uint8_t* block = static_cast<uint8_t*>(heap_caps_malloc(need, MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT));
+    mph_table_t* table = static_cast<mph_table_t*>(heap_caps_calloc(1, sizeof(mph_table_t), MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT));
+    if (block == nullptr || table == nullptr) {
+        if (block != nullptr) heap_caps_free(block);
+        if (table != nullptr) heap_caps_free(table);
+        *why = tpk_say(TPK_ERR_MEMORY, 0);
+        return false;
+    }
+    if (mph_build(z, inflate_raw, block, need, table) != TPK_OK) {
+        heap_caps_free(block);
+        heap_caps_free(table);
+        *why = tpk_say(TPK_ERR_ZIP, 0);
+        return false;
+    }
+    uint8_t* old_block;
+    mph_table_t* old_table;
+    {
+        std::lock_guard<std::mutex> lock(s_mu);
+        old_block = s_block;
+        old_table = s_table;
+        s_block   = block;
+        s_table   = table;
+    }
+    if (old_block != nullptr) heap_caps_free(old_block);
+    if (old_table != nullptr) heap_caps_free(old_table);
+    ESP_LOGI(TAG, "phrase pack: %d of 16 clips, %u bytes", table->count, static_cast<unsigned>(table->total));
+    return true;
+}
