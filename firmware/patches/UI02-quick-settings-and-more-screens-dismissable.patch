+
+// The fixed top of every page (patch UI01): the grabber handle, the page title and a 44 px target at the top right (Back on a
+// sub page, Done on the menu), all outside the flex flow. A swipe down on the screen does the same as the target.
+void chrome(int page)
+{
+    const char* titles_en[] = {"More", "Time zone", "Network test", "Version", "Games"};
+    const char* titles_es[] = {"Mas", "Zona horaria", "Prueba de red", "Version", "Juegos"};
+    lv_obj_t* grab = lv_obj_create(s_root);
+    lv_obj_add_flag(grab, LV_OBJ_FLAG_IGNORE_LAYOUT);
+    lv_obj_remove_flag(grab, LV_OBJ_FLAG_CLICKABLE);
+    lv_obj_set_size(grab, 48, 5);
+    lv_obj_set_pos(grab, 136, 3);
+    lv_obj_set_style_radius(grab, 3, 0);
+    lv_obj_set_style_border_width(grab, 0, 0);
+    lv_obj_set_style_bg_color(grab, lv_color_hex(0xB0B0B0), 0);
+    lv_obj_set_style_bg_opa(grab, LV_OPA_COVER, 0);
+    lv_obj_t* t = label(s_root, s_es ? titles_es[page] : titles_en[page], &lv_font_montserrat_20);
+    lv_obj_add_flag(t, LV_OBJ_FLAG_IGNORE_LAYOUT);
+    lv_obj_set_pos(t, 10, 16);
+    lv_obj_t* b = button(s_root, page == PAGE_MENU ? tx("Done", "Listo") : tx("Back", "Atras"), 0, page == PAGE_MENU ? on_close : on_back_menu);
+    lv_obj_add_flag(b, LV_OBJ_FLAG_IGNORE_LAYOUT);
+    lv_obj_set_size(b, 108, 44);
+    lv_obj_set_pos(b, 204, 8);
+}
+
+void on_screen_gesture(lv_event_t*)
+{
+    const lv_dir_t dir = lv_indev_get_gesture_dir(lv_indev_active());
+    if (dir == LV_DIR_BOTTOM) {
+        if (s_page == PAGE_MENU) {
+            close_all();
+        } else {
+            lv_async_call([](void*) { show(PAGE_MENU); }, nullptr);  // the touched button may be deleted: not inside its own event
+        }
+    }
 }
 
