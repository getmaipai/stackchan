+// Patch SF72: the grid games' sounds. Made in code on first use (mgs_render, 16 kHz mono) and played through the audio service; the sound policy decides: muted, sounds off and
+// quiet hours stay silent, and the volume is the system volume. Nothing is held while no game runs.
+void play_clip(Grid* g, int clip)
+{
+    if (clip < 0 || clip >= MGS_CLIPS || !maipai_sounds_gate("popup")) return;
+    if (g->clip_buf[clip] == nullptr) {
+        const size_t want = mgs_clip_samples(clip);
+        int16_t* b = static_cast<int16_t*>(heap_caps_malloc(want * sizeof(int16_t), MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT));
+        if (b == nullptr) return;
+        const size_t n = mgs_render(clip, b, want);
+        if (n == 0) { heap_caps_free(b); return; }
+        g->clip_buf[clip] = b;
+        g->clip_n[clip]   = static_cast<uint16_t>(n);
+    }
+    (void)Application::GetInstance().GetAudioService().PlayPcm(g->clip_buf[clip], g->clip_n[clip], MGS_SFX_RATE);  // PlayPcm copies
+}
+
+void free_clips(Grid* g)
+{
+    for (int i = 0; i < MGS_CLIPS; i++) {
+        if (g->clip_buf[i] != nullptr) {
+            heap_caps_free(g->clip_buf[i]);
+            g->clip_buf[i] = nullptr;
+        }
+    }
+}
