+// Starts a disc falling into a column of the Four in a Row board (the rules core already holds the landed state; this is only the picture and the sound). Returns false for a full column.
+bool c4_drop_disc(Grid* g, int col, int owner)
+{
+    const int row = gc4_drop(&g->c4, col, owner);
+    if (row < 0) return false;
+    const uint32_t now = now_ms();
+    const int cell = row * g->lay.cols + col;
+    const int y0 = g->lay.y0 - g->lay.ch;                       // just above the board
+    const int y1 = g->lay.y0 + row * g->lay.ch + 3;
+    gan_fall(&g->anim, now, cell, owner, row, row + 1, y0, y1);
+    play_clip(g, MGS_C_GRID_DROP);
+    return true;
+}
+
+// The disc has landed (after its bounce): the game goes on, or the result is shown first (the winning four pulse, a draw shakes the board) and the game ends when that is done.
+void c4_landed(Grid* g, int owner)
+{
+    const int res = gc4_result(&g->c4);
+    if (res == GR_PLAYING) {
+        if (owner == 1) {
+            gc4_ai_start(&g->search, &g->c4, g->level, g->seed + static_cast<uint32_t>(g->moves));
+            g->unit_thinking = 1;
+            g->unit_ready_at = now_ms() + kUnitDelayMs;
+        }
+        return;
+    }
+    g->result_pending = static_cast<uint8_t>(res);
+    if (res == GR_PERSON_WON || res == GR_UNIT_WON) {
+        if (gc4_win_line(&g->c4, res == GR_PERSON_WON ? 1 : 2, g->win_cells)) {
+            g->flash_left = 4;
+            for (int k = 0; k < 4; k++) gan_flash(&g->anim, now_ms(), g->win_cells[k]);
+            return;
+        }
+    }
+    gan_shake(&g->anim, now_ms());  // a draw
+}
