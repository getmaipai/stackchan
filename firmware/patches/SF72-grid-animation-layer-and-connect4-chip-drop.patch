new file mode 100644
--- /dev/null
+++ b/firmware/main/hal/maipai_grid_anim_core.h
@@ -0,0 +1,221 @@
+/*
+ * SPDX-License-Identifier: MIT
+ *
+ * The grid engine's animation layer (patch SF72): a small list of tweens that the 30 ms game tick advances and the board's one draw callback reads. A tween moves a cell's content
+ * from one place to another over time (a disc falling into a column with gravity, then one small bounce), or pulses a cell (the winning four), or shakes the board (a draw). The
+ * rules core never waits on a tween: it already holds the landed state; the animation is only what the screen shows on the way there. The caller hides a cell while a fall is
+ * heading for it (gan_cell_hidden) and draws the falling disc at gan_fall_pos. The tick returns events (a landing, a finished fall, a finished pulse) so the caller can play a sound
+ * at each impact and start the next thing (the unit's reply, the result) only when the picture has caught up. Plain C99, no allocation, no clock of its own, a few dozen bytes a tween.
+ *
+ * Rule for input: while gan_busy() the person's taps are ignored; the unit's search starts when the person's disc has landed.
+ */
+#ifndef MAIPAI_GRID_ANIM_CORE_H
+#define MAIPAI_GRID_ANIM_CORE_H
+
+#include <stdint.h>
+#include <string.h>
+
+#define GAN_MAX 8             /* tweens at once */
+#define GAN_MS_PER_ROW 80u    /* a fall takes this long for every row it drops (ease-in), at least GAN_FALL_MIN_MS */
+#define GAN_FALL_MIN_MS 120u
+#define GAN_BOUNCE_MS 130u    /* the one small bounce after the landing */
+#define GAN_BOUNCE_MAX_PX 8
+#define GAN_FLASH_MS 120u     /* one half of a pulse: bright, then normal; three pulses */
+#define GAN_FLASH_PULSES 3
+#define GAN_SHAKE_MS 420u
+#define GAN_EV_MAX 6
+
+enum { GAN_NONE = 0, GAN_FALL, GAN_FLASH };
+enum { GAN_EV_FALL_START = 1, GAN_EV_LAND, GAN_EV_FALL_DONE, GAN_EV_FLASH_DONE, GAN_EV_SHAKE_DONE };
+
+typedef struct {
+    uint8_t kind, owner, cell, row;
+    int16_t y0, y1;       /* a fall: from y0 to y1 (pixels, top of the disc) */
+    uint16_t fall_ms;
+    uint8_t bounced;      /* the first landing was reported */
+    uint32_t t0;
+} gan_tw_t;
+
+typedef struct {
+    uint8_t type, owner, cell, row, bounce;
+} gan_ev_t;
+
+typedef struct {
+    gan_tw_t t[GAN_MAX];
+    uint32_t shake_t0;    /* 0 none */
+    uint8_t shaking;
+} gan_t;
+
+static inline void gan_init(gan_t* a) { memset(a, 0, sizeof(*a)); }
+
+static inline int gan_active(const gan_t* a)
+{
+    for (int i = 0; i < GAN_MAX; i++) {
+        if (a->t[i].kind != GAN_NONE) {
+            return 1;
+        }
+    }
+    return a->shaking;
+}
+
+/* Is a disc falling or bouncing? (the person's taps wait for this to end) */
+static inline int gan_busy(const gan_t* a) { return gan_active(a); }
+
+static inline uint32_t gan_fall_total_ms(uint32_t fall_ms) { return fall_ms + GAN_BOUNCE_MS; }
+
+static inline uint32_t gan_fall_ms_for_rows(int rows)
+{
+    const uint32_t ms = (uint32_t)(rows < 1 ? 1 : rows) * GAN_MS_PER_ROW;
+    return ms < GAN_FALL_MIN_MS ? GAN_FALL_MIN_MS : ms;
+}
+
+/* Starts a disc falling from y0 to y1 into `cell` (row `row`), `rows` rows high. Returns the tween index or -1 when the list is full. */
+static inline int gan_fall(gan_t* a, uint32_t now, int cell, int owner, int row, int rows, int y0, int y1)
+{
+    for (int i = 0; i < GAN_MAX; i++) {
+        if (a->t[i].kind == GAN_NONE) {
+            gan_tw_t* t = &a->t[i];
+            memset(t, 0, sizeof(*t));
+            t->kind = GAN_FALL;
+            t->owner = (uint8_t)owner;
+            t->cell = (uint8_t)cell;
+            t->row = (uint8_t)row;
+            t->y0 = (int16_t)y0;
+            t->y1 = (int16_t)y1;
+            t->fall_ms = (uint16_t)gan_fall_ms_for_rows(rows);
+            t->t0 = now;
+            return i;
+        }
+    }
+    return -1;
+}
+
+/* A pulse on a cell: GAN_FLASH_PULSES times bright then normal. */
+static inline int gan_flash(gan_t* a, uint32_t now, int cell)
+{
+    for (int i = 0; i < GAN_MAX; i++) {
+        if (a->t[i].kind == GAN_NONE) {
+            memset(&a->t[i], 0, sizeof(a->t[i]));
+            a->t[i].kind = GAN_FLASH;
+            a->t[i].cell = (uint8_t)cell;
+            a->t[i].t0 = now;
+            return i;
+        }
+    }
+    return -1;
+}
+
+static inline void gan_shake(gan_t* a, uint32_t now)
+{
+    a->shaking = 1;
+    a->shake_t0 = now;
+}
+
+/* The board's horizontal shake offset in pixels now (0 when not shaking): a decaying wobble. */
+static inline int gan_shake_dx(const gan_t* a, uint32_t now)
+{
+    if (!a->shaking) {
+        return 0;
+    }
+    const uint32_t e = now - a->shake_t0;
+    if (e >= GAN_SHAKE_MS) {
+        return 0;
+    }
+    const int amp = 4 - (int)(4u * e / GAN_SHAKE_MS);       /* 4 px falling to 0 */
+    return ((e / 35u) & 1u) ? -amp : amp;
+}
+
+/* Is a fall heading for this cell (the cell's disc is on its way: the board must not draw it yet)? */
+static inline int gan_cell_hidden(const gan_t* a, int cell)
+{
+    for (int i = 0; i < GAN_MAX; i++) {
+        if (a->t[i].kind == GAN_FALL && a->t[i].cell == cell) {
+            return 1;
+        }
+    }
+    return 0;
+}
+
+/* Who owns the disc falling into this cell (1 the person, 2 the unit), or 0. */
+static inline int gan_fall_owner(const gan_t* a, int cell)
+{
+    for (int i = 0; i < GAN_MAX; i++) {
+        if (a->t[i].kind == GAN_FALL && a->t[i].cell == cell) {
+            return a->t[i].owner;
+        }
+    }
+    return 0;
+}
+
+/* The y of the top of the falling disc heading for `cell`, or -1 when none: ease-in to the landing, then one small bounce. */
+static inline int gan_fall_y(const gan_t* a, int cell, uint32_t now)
+{
+    for (int i = 0; i < GAN_MAX; i++) {
+        const gan_tw_t* t = &a->t[i];
+        if (t->kind != GAN_FALL || t->cell != cell) {
+            continue;
+        }
+        const uint32_t e = now - t->t0;
+        const int dy = t->y1 - t->y0;
+        if (e < t->fall_ms) {
+            const int32_t u = (int32_t)(e * 1000u / t->fall_ms);            /* 0..1000 */
+            return t->y0 + (int)(((int64_t)dy * u * u) / 1000000);          /* gravity: distance grows with the square of time */
+        }
+        const uint32_t b = e - t->fall_ms;                                    /* the bounce: a parabola up and down */
+        if (b >= GAN_BOUNCE_MS) {
+            return t->y1;
+        }
+        int h = dy / 6;
+        if (h > GAN_BOUNCE_MAX_PX) {
+            h = GAN_BOUNCE_MAX_PX;
+        }
+        const int32_t u = (int32_t)(b * 1000u / GAN_BOUNCE_MS);              /* 0..1000 */
+        return t->y1 - (int)((int64_t)h * 4 * u * (1000 - u) / 1000000);
+    }
+    return -1;
+}
+
+/* Is the cell lit in its pulse now? (bright on the even half-periods, for GAN_FLASH_PULSES pulses; false when it has no pulse) */
+static inline int gan_flash_on(const gan_t* a, int cell, uint32_t now)
+{
+    for (int i = 0; i < GAN_MAX; i++) {
+        if (a->t[i].kind == GAN_FLASH && a->t[i].cell == cell) {
+            const uint32_t e = now - a->t[i].t0;
+            return e < GAN_FLASH_MS * 2u * GAN_FLASH_PULSES && ((e / GAN_FLASH_MS) & 1u) == 0;  /* never lit past the last pulse, even before the tick removes it */
+        }
+    }
+    return 0;
+}
+
+/* Advances the list to `now`; returns the events since the last call (at most GAN_EV_MAX; the rest wait for the next tick). */
+static inline int gan_tick(gan_t* a, uint32_t now, gan_ev_t* ev)
+{
+    int n = 0;
+    for (int i = 0; i < GAN_MAX && n < GAN_EV_MAX - 1; i++) {
+        gan_tw_t* t = &a->t[i];
+        if (t->kind == GAN_FALL) {
+            const uint32_t e = now - t->t0;
+            if (!t->bounced && e >= t->fall_ms) {
+                t->bounced = 1;
+                ev[n++] = (gan_ev_t){GAN_EV_LAND, t->owner, t->cell, t->row, 0};
+            }
+            if (e >= gan_fall_total_ms(t->fall_ms) && n < GAN_EV_MAX - 1) {
+                ev[n++] = (gan_ev_t){GAN_EV_LAND, t->owner, t->cell, t->row, 1};        /* the second, smaller impact after the bounce */
+                ev[n++] = (gan_ev_t){GAN_EV_FALL_DONE, t->owner, t->cell, t->row, 0};
+                t->kind = GAN_NONE;
+            }
+        } else if (t->kind == GAN_FLASH) {
+            if (now - t->t0 >= GAN_FLASH_MS * 2u * GAN_FLASH_PULSES) {
+                ev[n++] = (gan_ev_t){GAN_EV_FLASH_DONE, 0, t->cell, 0, 0};
+                t->kind = GAN_NONE;
+            }
+        }
+    }
+    if (a->shaking && now - a->shake_t0 >= GAN_SHAKE_MS && n < GAN_EV_MAX) {
+        a->shaking = 0;
+        ev[n++] = (gan_ev_t){GAN_EV_SHAKE_DONE, 0, 0, 0, 0};
+    }
+    return n;
+}
+
+#endif /* MAIPAI_GRID_ANIM_CORE_H */
