+/* The four cells of a winning line of `who` (patch SF72): cells[4] get the indices, returns 1; 0 when there is none. */
+static inline int gc4_win_line(const gc4_board_t* g, int who, int cells[4])
+{
+    static const int dr[4] = {0, 1, 1, 1}, dc[4] = {1, 0, 1, -1};
+    for (int r = 0; r < GC4_ROWS; r++) {
+        for (int c = 0; c < GC4_COLS; c++) {
+            if (g->b[r * GC4_COLS + c] != who) {
+                continue;
+            }
+            for (int d = 0; d < 4; d++) {
+                int k = 0;
+                int rr = r, cc = c;
+                while (k < 4 && rr >= 0 && rr < GC4_ROWS && cc >= 0 && cc < GC4_COLS && g->b[rr * GC4_COLS + cc] == who) {
+                    cells[k++] = rr * GC4_COLS + cc;
+                    rr += dr[d];
+                    cc += dc[d];
+                }
+                if (k == 4) {
+                    return 1;
+                }
+            }
+        }
+    }
+    return 0;
+}
