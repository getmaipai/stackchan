+/* Turning the auto lock off needs the current code when one is set (patch SF01): without it, anyone at an unlocked unit
+ * could stop it from ever locking itself. The on-unit picker keeps mlk_set_auto. */
+static inline int mlk_set_auto_checked(mlk_t* s, int minutes, const char* current)
+{
+    if (s->locked) return MLK_R_LOCKED;
+    if (!mlk_auto_ok(minutes)) return MLK_R_BAD_MINUTES;
+    if (s->has_code && minutes == 0) {
+        if (current == NULL || current[0] == '\0') return MLK_R_CURRENT_NEEDED;
+        if (!mlk_check(s, current)) return MLK_R_WRONG_CURRENT;
+    }
+    s->auto_min = (uint8_t)minutes;
+    return MLK_R_OK;
+}
+
+/* The lock tools take a current code, so they need an attempt limit (patch SF01): LK_TOOL_MAX_FAILS wrong ones in a row and
+ * every tool answers "too_many" for LK_TOOL_LOCKOUT_MS. Call mlk_tool_open before the tool acts and mlk_tool_note with its result. */
+static inline int mlk_tool_open(mlk_t* s, uint32_t now)
+{
+    return mt_pending_clear(now, &s->tool_block_until_ms) ? MLK_R_TOO_MANY : MLK_R_OK;
+}
+static inline void mlk_tool_note(mlk_t* s, uint32_t now, int reason)
+{
+    if (reason == MLK_R_WRONG_CURRENT) {
+        if (++s->tool_fails >= LK_TOOL_MAX_FAILS) {
+            s->tool_fails = 0;
+            s->tool_block_until_ms = mt_stamp(now, LK_TOOL_LOCKOUT_MS);
+        }
+    } else if (reason == MLK_R_OK) {
+        s->tool_fails = 0;
+    }
+}
+
