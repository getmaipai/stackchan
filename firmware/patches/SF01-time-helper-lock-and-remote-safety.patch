new file mode 100644
--- /dev/null
+++ b/firmware/main/hal/maipai_time_core.h
@@ -0,0 +1,55 @@
+/*
+ * SPDX-License-Identifier: MIT
+ *
+ * One way to compare 32-bit millisecond stamps (patch SF01). Plain C99, no clock of its own.
+ *
+ * The defect it removes: a stamp that starts at 0 and is compared with `(int32_t)(now - stamp) < 0` reads as "in the future" for good once
+ * the unit has run 2^31 ms (24.9 days), so a grace, hold, quiet or lockout window never ends. The rules here:
+ *   - A stamp of 0 means "not armed". mt_stamp() never returns 0, so a real deadline is never mistaken for it.
+ *   - mt_pending() is true only for an armed stamp that has not been reached.
+ *   - Elapsed time is always an unsigned difference (mt_elapsed), which stays right for 49.7 days of staleness.
+ *   - A stamp that has been reached is cleared by mt_expire() wherever the state can change, so it cannot look future again.
+ * Host test: host/tests/firmware/safety_core_test.c.
+ */
+#ifndef MAIPAI_TIME_CORE_H
+#define MAIPAI_TIME_CORE_H
+
+#include <stdint.h>
+
+#define MT_HALF 0x80000000u
+
+/* A deadline `delay` ms after `now`; never 0. */
+static inline uint32_t mt_stamp(uint32_t now, uint32_t delay)
+{
+    const uint32_t t = now + delay;
+    return t == 0u ? 1u : t;
+}
+
+/* ms since `then` (unsigned, wrap safe). */
+static inline uint32_t mt_elapsed(uint32_t now, uint32_t then) { return (uint32_t)(now - then); }
+
+/* True when now is at or after `at` (valid while `at` is within 24.9 days of now). */
+static inline int mt_reached(uint32_t now, uint32_t at) { return (uint32_t)(now - at) < MT_HALF; }
+
+/* True while an armed deadline has not been reached. */
+static inline int mt_pending(uint32_t now, uint32_t at) { return at != 0u && !mt_reached(now, at); }
+
+/* mt_pending that also disarms the stamp once it has been reached, so it cannot flip back after a wrap. */
+static inline int mt_pending_clear(uint32_t now, uint32_t* at)
+{
+    if (*at == 0u) return 0;
+    if (mt_reached(now, *at)) {
+        *at = 0u;
+        return 0;
+    }
+    return 1;
+}
+
+/* Raise a deadline to `until` when it is armed and earlier, or arm it when it is not armed or already reached. */
+static inline void mt_extend(uint32_t now, uint32_t* at, uint32_t until)
+{
+    if (until == 0u) until = 1u;
+    if (!mt_pending(now, *at) || mt_reached(until, *at)) *at = until;
+}
+
+#endif /* MAIPAI_TIME_CORE_H */
