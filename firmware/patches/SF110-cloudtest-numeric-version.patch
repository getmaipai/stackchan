# SF110: the cloud brain test image sends the numeric firmware version to the vendor's update check
#
# Intent: the vendor's update check reads a version as dotted numbers and refused "1.6.2-maipai.1", so the cloud test image never reached the vendor. The cloud test image
#   (CONFIG_MAIPAI_CLOUDTEST) now reports "1.6.2". The other images and our own displays keep the full string. The "camera address is not the paired host" warning is said once per boot.
# Placement: body (the unit's own update check); cloud test image only for the version, every image for the warning.
# Upstream: none (MaiPai code only).
# Check after a flash: cloudtest image: the console shows "Current version: 1.6.2" and a connection to the vendor's check; no "invalid version segment" line.
# Kconfig: none (uses CONFIG_MAIPAI_CLOUDTEST).
# Memory cost: 24 bytes of stack for a moment; nothing while the cloud test image is off.

diff --git a/firmware/xiaozhi-esp32/main/ota.cc b/firmware/xiaozhi-esp32/main/ota.cc
--- a/firmware/xiaozhi-esp32/main/ota.cc
+++ b/firmware/xiaozhi-esp32/main/ota.cc
@@ -27,6 +27,7 @@
 #include <vector>
 
 #include <hal/maipai_cloudtest.h>
+#include <hal/maipai_ota_version_core.h>
 #include <hal/maipai_hosted.h>
 
 #define TAG "Ota"
@@ -96,6 +97,13 @@ NetworkResult<> Ota::CheckVersion() {
 
     // Check if there is a new firmware version available
     current_version_ = app_desc->version;
+#if CONFIG_MAIPAI_CLOUDTEST
+    {   // patch SF110: the vendor check reads a version as dotted numbers, so the cloud test image sends the numeric part only
+        char num[24];
+        mov_numeric(app_desc->version, num, sizeof(num));
+        current_version_ = num;
+    }
+#endif
     ESP_LOGI(TAG, "Current version: %s", current_version_.c_str());
 
     std::string url = GetCheckVersionUrl();
