diff --git a/firmware/main/hal/maipai_ota_version_core.h b/firmware/main/hal/maipai_ota_version_core.h
new file mode 100644
--- /dev/null
+++ b/firmware/main/hal/maipai_ota_version_core.h
@@ -0,0 +1,37 @@
+/*
+ * SPDX-License-Identifier: MIT
+ *
+ * The numeric part of the firmware's version string (patch SF110). The vendor's update check parses a version as dot separated numbers, so "1.6.2-maipai.1" is refused
+ * ("invalid version segment"). Only the cloud brain test image sends the numeric part. Pure C99.
+ */
+#ifndef MAIPAI_OTA_VERSION_CORE_H
+#define MAIPAI_OTA_VERSION_CORE_H
+
+#include <stddef.h>
+
+// Copies the leading digits-and-dots prefix of `in` ("1.6.2-maipai.1" gives "1.6.2") into out (size n, always terminated when n is 1 or more). A trailing dot is dropped; no digits at all gives "0".
+// Returns the length written.
+static inline size_t mov_numeric(const char* in, char* out, size_t n)
+{
+    size_t len = 0;
+    if (n == 0) return 0;
+    if (n == 1) {
+        out[0] = '\0';
+        return 0;
+    }
+    if (in != 0) {
+        while (in[len] != '\0' && len + 1 < n && ((in[len] >= '0' && in[len] <= '9') || in[len] == '.')) {
+            out[len] = in[len];
+            len++;
+        }
+    }
+    while (len > 0 && out[len - 1] == '.') len--;
+    if (len == 0) {
+        out[0] = '0';
+        len = 1;
+    }
+    out[len] = '\0';
+    return len;
+}
+
+#endif
