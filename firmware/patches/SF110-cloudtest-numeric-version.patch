             Settings paired("websocket", false);
             std::string paired_host = UpdateUrlHost(paired.GetString("url"));
             if (paired_host.empty() || UpdateUrlHost(url_str) != paired_host) {
-                ESP_LOGW(TAG, "Ignored a camera address that is not the paired host; the host must send its own address");
+                static bool s_warned = false;   // patch SF110: said once per boot (the host repeats the request)
+                if (!s_warned) {
