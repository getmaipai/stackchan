+
+void measure(const std::string& text, const lv_font_t* font, int max_w, lv_point_t* size)
+{
+    lv_text_get_size(size, text.c_str(), font, 0, 0, max_w, LV_TEXT_FLAG_NONE);
+}
+
+// Splits a sentence into pages of at most two lines at word boundaries.
+std::vector<std::string> paginate(const std::string& text, const lv_font_t* font, int max_w)
+{
+    std::vector<std::string> pages;
+    const int line_h = lv_font_get_line_height(font);
+    std::string cur;
+    size_t i = 0;
+    while (i < text.size()) {
+        size_t j = text.find(' ', i);
+        if (j == std::string::npos) j = text.size();
+        const std::string word = text.substr(i, j - i);
+        i                      = j + 1;
+        if (word.empty()) continue;
+        const std::string trial = cur.empty() ? word : cur + " " + word;
+        lv_point_t sz;
+        measure(trial, font, max_w, &sz);
+        if (sz.y > line_h * _max_lines && !cur.empty()) {
+            pages.push_back(cur);
+            cur = word;
+        } else {
+            cur = trial;
+        }
+    }
+    if (!cur.empty()) pages.push_back(cur);
+    return pages;
+}
