diff --git a/firmware/main/hal/maipai_nettest.cc b/firmware/main/hal/maipai_nettest.cc
new file mode 100644
--- /dev/null
+++ b/firmware/main/hal/maipai_nettest.cc
@@ -0,0 +1,84 @@
+/*
+ * SPDX-License-Identifier: MIT
+ *
+ * Network test, device side (patch U04). Everything here is a read of state the unit already holds: the Wi-Fi driver,
+ * the saved host address, the open link to the host and the private network client. The link to the host being open is
+ * the proof that the path works, so nothing is sent anywhere to test it.
+ */
+#include <sdkconfig.h>
+#if CONFIG_MAIPAI_NETTEST
+#include "maipai_nettest.h"
+#include "maipai_face.h"
+#include "maipai_tailnet.h"
+#include "board/hal_bridge.h"
+#include <mcp_server.h>
+#include <cJSON.h>
+#include <esp_netif.h>
+#include <esp_wifi.h>
+#include <settings.h>
+#include <ssid_manager.h>
+#include <string>
+
+void maipai_nettest_run(mn_result_t* out, int* lang_out)
+{
+    mn_input_t in = {};
+    wifi_ap_record_t ap = {};
+    if (esp_wifi_sta_get_ap_info(&ap) == ESP_OK) {
+        in.wifi_joined = 1;
+        in.rssi        = ap.rssi;
+    }
+    esp_netif_t* sta = esp_netif_get_handle_from_ifkey("WIFI_STA_DEF");
+    esp_netif_ip_info_t ip = {};
+    in.has_ip = sta != nullptr && esp_netif_get_ip_info(sta, &ip) == ESP_OK && ip.ip.addr != 0;
+    in.saved_networks = static_cast<uint8_t>(SsidManager::GetInstance().GetSsidList().size());
+    {
+        Settings settings("websocket", false);
+        in.host_set = !settings.GetString("url").empty();
+    }
+    in.host_link_up = hal_bridge::hub_link_up();
+    in.tailnet_built = maipai_tailnet_compiled();
+    in.tailnet_key   = maipai_tailnet_key_saved();
+    in.tailnet_ready = maipai_tailnet_ready();
+    const int lang = maipai_face_config().lang == MF_LANG_ES ? MN_ES : MN_EN;
+    mn_judge(&in, lang, out);
+    if (lang_out != nullptr) {
+        *lang_out = lang;
+    }
+}
+
+void maipai_nettest_register_tools()
+{
+    McpServer::GetInstance().AddTool(
+        "self.network.test",
+        "Check the unit's own network in plain words: Wi-Fi, the link to the home host and, when built in, the private "
+        "network. It reads what the unit already knows and sends nothing. Answers {ok,problems,summary,fix,steps:[{step,"
+        "state,line}]} where state is ok, bad or skipped; fix says what to do about the first problem.",
+        std::vector<Property>{}, [](const PropertyList&) -> ReturnValue {
+            mn_result_t r;
+            int lang = MN_EN;
+            maipai_nettest_run(&r, &lang);
+            static const char* const names[MN_STEPS] = {"wifi", "host", "private"};
+            static const char* const states[3]       = {"ok", "bad", "skipped"};
+            char summary[64];
+            mn_summary(&r, lang, summary, sizeof(summary));
+            cJSON* root = cJSON_CreateObject();
+            cJSON_AddBoolToObject(root, "ok", true);
+            cJSON_AddNumberToObject(root, "problems", r.problems);
+            cJSON_AddStringToObject(root, "summary", summary);
+            cJSON_AddStringToObject(root, "fix", r.fix);
+            cJSON* steps = cJSON_AddArrayToObject(root, "steps");
+            for (int i = 0; i < MN_STEPS; i++) {
+                cJSON* s = cJSON_CreateObject();
+                cJSON_AddStringToObject(s, "step", names[i]);
+                cJSON_AddStringToObject(s, "state", states[r.state[i]]);
+                cJSON_AddStringToObject(s, "line", r.line[i]);
+                cJSON_AddItemToArray(steps, s);
+            }
+            char* text      = cJSON_PrintUnformatted(root);
+            std::string out = text != nullptr ? text : "{\"ok\":false,\"error\":\"out of memory: try again\"}";
+            cJSON_free(text);
+            cJSON_Delete(root);
+            return out;
+        });
+}
+#endif
