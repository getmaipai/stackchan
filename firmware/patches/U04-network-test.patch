+ */
+#pragma once
+#include <sdkconfig.h>
+
+#if CONFIG_MAIPAI_NETTEST
+#include "maipai_nettest_core.h"
+// Reads the Wi-Fi, host link and private network state and judges it in the saved language.
+void maipai_nettest_run(mn_result_t* out, int* lang);
