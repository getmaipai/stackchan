diff --git a/firmware/main/hal/maipai_nettest_core.h b/firmware/main/hal/maipai_nettest_core.h
new file mode 100644
--- /dev/null
+++ b/firmware/main/hal/maipai_nettest_core.h
@@ -0,0 +1,151 @@
+/*
+ * SPDX-License-Identifier: MIT
+ *
+ * Network test (patch U04): the pure logic that turns what the unit already knows (Wi-Fi, its address, the link to the
+ * host, the private network when it is built in) into plain words and the one thing to do next. It makes no network
+ * call of its own: a working link to the host is the proof that the path works, and nothing new leaves the home.
+ * Header-only plain C99 so a host compiler can test it; the device side is in maipai_more.cc (screen) and
+ * maipai_tz.cc (the tool). English and Spanish; other languages use English.
+ */
+#ifndef MAIPAI_NETTEST_CORE_H
+#define MAIPAI_NETTEST_CORE_H
+
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+
+#define MN_EN 0
+#define MN_ES 1
+
+/* What the unit knows. tailnet_* are ignored unless tailnet_built is 1. */
+typedef struct {
+    uint8_t wifi_joined;     /* the unit is joined to a Wi-Fi network */
+    int8_t rssi;             /* signal strength in dBm, 0 when unknown */
+    uint8_t has_ip;          /* the unit has an address on that network */
+    uint8_t saved_networks;  /* how many networks are saved on the unit */
+    uint8_t host_set;        /* the address of the home host is saved */
+    uint8_t host_link_up;    /* the link to the home host is open now */
+    uint8_t tailnet_built;   /* this firmware has the private network client */
+    uint8_t tailnet_key;     /* a pairing key (or an earlier join) is saved */
+    uint8_t tailnet_ready;   /* the private network is connected now */
+} mn_input_t;
+
+#define MN_STEPS 3
+#define MN_LINE 72
+
+typedef enum { MN_OK = 0, MN_BAD = 1, MN_SKIP = 2 } mn_state_t;
+
+typedef struct {
+    mn_state_t state[MN_STEPS]; /* 0 Wi-Fi, 1 home host, 2 private network */
+    char line[MN_STEPS][MN_LINE];
+    char fix[MN_LINE * 2];      /* what to do about the first problem; empty when nothing is wrong */
+    int problems;
+} mn_result_t;
+
+/* Signal strength in words, so a person sees "weak" and not "-82". */
+static inline const char* mn_signal_word(int rssi, int lang)
+{
+    if (rssi == 0) {
+        return lang == MN_ES ? "senal desconocida" : "signal unknown";
+    }
+    if (rssi >= -60) {
+        return lang == MN_ES ? "senal fuerte" : "strong signal";
+    }
+    if (rssi >= -75) {
+        return lang == MN_ES ? "senal buena" : "good signal";
+    }
+    return lang == MN_ES ? "senal debil" : "weak signal";
+}
+
+static inline void mn_judge(const mn_input_t* in, int lang, mn_result_t* out)
+{
+    const int es = lang == MN_ES;
+    memset(out, 0, sizeof(*out));
+    /* 1. Wi-Fi */
+    if (!in->wifi_joined || !in->has_ip) {
+        out->state[0] = MN_BAD;
+        snprintf(out->line[0], MN_LINE, "%s", es ? "Wi-Fi: sin conexion" : "Wi-Fi: not connected");
+        if (in->saved_networks == 0) {
+            snprintf(out->fix, sizeof(out->fix), "%s",
+                     es ? "No hay red guardada. Abre el ajuste de Wi-Fi del robot y elige tu red."
+                        : "No network is saved. Open the robot's Wi-Fi setup and pick your network.");
+        } else {
+            snprintf(out->fix, sizeof(out->fix), "%s",
+                     es ? "Acerca el robot al router y comprueba que la red este encendida; si cambio la clave, repite el ajuste de Wi-Fi."
+                        : "Move the robot closer to the router and check the network is on; if the password changed, repeat the Wi-Fi setup.");
+        }
+        out->problems++;
+    } else {
+        out->state[0] = MN_OK;
+        snprintf(out->line[0], MN_LINE, es ? "Wi-Fi: conectado, %s" : "Wi-Fi: connected, %s", mn_signal_word(in->rssi, lang));
+        if (in->rssi != 0 && in->rssi < -75) {
+            snprintf(out->fix, sizeof(out->fix), "%s",
+                     es ? "La senal es debil. Acerca el robot al router para que la voz no se corte."
+                        : "The signal is weak. Move the robot closer to the router so the voice does not cut out.");
+        }
+    }
+    /* 2. The home host */
+    if (out->state[0] == MN_BAD) {
+        out->state[1] = MN_SKIP;
+        snprintf(out->line[1], MN_LINE, "%s", es ? "Casa: sin probar" : "Home host: not tested");
+    } else if (!in->host_set) {
+        out->state[1] = MN_BAD;
+        snprintf(out->line[1], MN_LINE, "%s", es ? "Casa: sin direccion" : "Home host: no address saved");
+        if (out->fix[0] == '\0') {
+            snprintf(out->fix, sizeof(out->fix), "%s",
+                     es ? "Falta la direccion de casa. Abre la pagina de ajuste del robot y escribela."
+                        : "The home address is missing. Open the robot's setup page and type it in.");
+        }
+        out->problems++;
+    } else if (!in->host_link_up) {
+        out->state[1] = MN_BAD;
+        snprintf(out->line[1], MN_LINE, "%s", es ? "Casa: no responde" : "Home host: not answering");
+        if (out->fix[0] == '\0') {
+            snprintf(out->fix, sizeof(out->fix), "%s",
+                     es ? "Comprueba que el ordenador de casa este encendido y ejecutando el anfitrion, en la misma red."
+                        : "Check that the home computer is on and running the host, on the same network.");
+        }
+        out->problems++;
+    } else {
+        out->state[1] = MN_OK;
+        snprintf(out->line[1], MN_LINE, "%s", es ? "Casa: conectado" : "Home host: connected");
+    }
+    /* 3. The private network (travel), only when this firmware has it */
+    if (!in->tailnet_built) {
+        out->state[2] = MN_SKIP;
+        snprintf(out->line[2], MN_LINE, "%s", es ? "Red privada: no incluida" : "Private network: not in this build");
+    } else if (in->tailnet_ready) {
+        out->state[2] = MN_OK;
+        snprintf(out->line[2], MN_LINE, "%s", es ? "Red privada: conectada" : "Private network: connected");
+    } else if (!in->tailnet_key) {
+        out->state[2] = MN_SKIP;
+        snprintf(out->line[2], MN_LINE, "%s", es ? "Red privada: sin clave (solo para viajar)" : "Private network: no key (only for travel)");
+    } else {
+        out->state[2] = in->host_link_up ? MN_SKIP : MN_BAD;
+        snprintf(out->line[2], MN_LINE, "%s",
+                 in->host_link_up ? (es ? "Red privada: en espera (casa responde)" : "Private network: standby (home answers)")
+                                  : (es ? "Red privada: aun sin conectar" : "Private network: not connected yet"));
+        if (out->state[2] == MN_BAD && out->fix[0] == '\0') {
+            snprintf(out->fix, sizeof(out->fix), "%s",
+                     es ? "Espera un minuto; si sigue igual, pide una clave de viaje nueva y escribela en la pagina de ajuste."
+                        : "Wait a minute; if it stays this way, get a new travel key and type it into the setup page.");
+        }
+        if (out->state[2] == MN_BAD) {
+            out->problems++;
+        }
+    }
+    if (out->problems == 0 && out->fix[0] == '\0') {
+        snprintf(out->fix, sizeof(out->fix), "%s", "");
+    }
+}
+
+/* One plain summary line: "All good." or how many things need a look. */
+static inline int mn_summary(const mn_result_t* r, int lang, char* out, size_t cap)
+{
+    if (r->problems == 0) {
+        return snprintf(out, cap, "%s", lang == MN_ES ? "Todo bien." : "All good.");
+    }
+    return snprintf(out, cap, lang == MN_ES ? "%d cosa(s) por revisar." : "%d thing(s) to check.", r->problems);
+}
+
+#endif
