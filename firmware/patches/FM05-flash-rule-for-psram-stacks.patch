# Intent: Review fix (2026-11-16): close the class of boot loop where a task with its stack in PSRAM reaches flash. scripts/psram-stack-lint.py (run by host/tests/test_psram_stack_lint.py) lists every PSRAM-stack task in the patched tree and follows its calls by name to NVS, the flash driver, the partition API and saved settings; it finds the two old faults (ring task, music worker) in the earlier trees. This patch fixes what the lint found in the merged tree: the pickup reaction (IMU task, PSRAM stack) could reach the saved speaker volume through a late find restore, and could be the first reader of the saved privacy state or the sound policy. New hal/maipai_stackrule.h: maipai_flash_stack_ok(what) says no and logs the task name when the stack is not internal (and stops in bench builds). The privacy loader and the sound policy loader use it and, on a PSRAM stack that arrives before the main task has read them, answer closed (muted and quiet) and the default policy; the late volume restore runs only on an internal stack; the find=1 volume work is its own function reached only from the tool. The Settings class itself logs the same fault (the settings reader check, patch M05 of the headroom pass).
# Placement: unit (a boot-loop class closed in the robot firmware)
# Upstream: main/hal/{maipai_privacy.cpp,maipai_sounds.cc} (ours, patches 105, 115 and TC02); new file hal/maipai_stackrule.h
# Check after a flash: no assert or reboot in 15 minutes with a pickup, a find and a listen test; lint exits 0 on the patched tree.

diff --git a/firmware/main/hal/maipai_stackrule.h b/firmware/main/hal/maipai_stackrule.h
new file mode 100644
--- /dev/null
+++ b/firmware/main/hal/maipai_stackrule.h
@@ -0,0 +1,35 @@
+/*
+ * SPDX-License-Identifier: MIT
+ *
+ * The PSRAM-stack rule (patch FM05). A flash call (NVS, the flash driver, saved settings) made on a task whose stack is in PSRAM
+ * asserts in esp_task_stack_is_sane_cache_disabled and reboots the unit; it did twice on 2026-11-16 (the listening ring task, the
+ * music worker). A function that reads flash calls maipai_flash_stack_ok first and does not read when it says no. A bench build
+ * (CONFIG_MAIPAI_FACE_BENCH) or one with MAIPAI_DEBUG_ASSERTS also stops with the task's name, so the first wrong caller is found at once.
+ * scripts/psram-stack-lint.py finds such callers in the source before a build.
+ */
+#pragma once
+
+#include <sdkconfig.h>
+#include <esp_log.h>
+#include <esp_memory_utils.h>
+#include <freertos/FreeRTOS.h>
+#include <freertos/task.h>
+
+#include <cassert>
+
+static inline bool maipai_stack_is_internal()
+{
+    return esp_ptr_internal(__builtin_frame_address(0));
+}
+
+// True when the caller's stack is in internal RAM and flash may be read. False: log which task asked and why it must not.
+static inline bool maipai_flash_stack_ok(const char* what)
+{
+    if (maipai_stack_is_internal()) return true;
+    ESP_LOGE("StackRule", "%s needs flash but task %s has its stack in PSRAM; it was not read. Read it once on the main task first.", what,
+             pcTaskGetName(nullptr));
+#if defined(MAIPAI_DEBUG_ASSERTS) || (defined(CONFIG_MAIPAI_FACE_BENCH) && CONFIG_MAIPAI_FACE_BENCH)
+    assert(!"flash read on a PSRAM stack");
+#endif
+    return false;
+}
