new file mode 100644
--- /dev/null
+++ b/firmware/main/hal/maipai_facedet_core.h
@@ -0,0 +1,269 @@
+/*
+ * SPDX-License-Identifier: MIT
+ *
+ * Face detection on the unit, the pure part (patch FD02). Plain C99, no ESP call, no clock of its own, no allocation: a host
+ * compiler tests it (host/tests/firmware/facedet_core_test.c). The device file maipai_facedet.cc owns the model, the camera and
+ * the task; everything it has to decide or compute without hardware is here:
+ *   - fd_convert_rgb888: a window of a camera frame (YUYV, UYVY, RGB565 little endian or gray) to the 8-bit RGB the face models
+ *     take, with an optional red/blue swap (a wrong channel order halves the hit rate, so the bench can try both);
+ *   - fd_crop_origin: where a crop window of the frame sits (centered on a point, kept inside the frame, even column for YUV);
+ *   - fd_pick: the one face to follow out of the boxes a model found (the biggest near the middle, above the score floor);
+ *   - fd_ring_t and fd_percentile: the p50 and p99 of the measured milliseconds;
+ *   - fd_period_ms and fd_model_parse: the rate clamp (2 to 5 a second) and the model names.
+ * Placement: unit. Upstream: none (ours).
+ */
+#ifndef MAIPAI_FACEDET_CORE_H
+#define MAIPAI_FACEDET_CORE_H
+
+#include <math.h>
+#include <stddef.h>
+#include <stdint.h>
+#include <string.h>
+
+#include "maipai_seek_wire_core.h"
+
+#define FD_FRAME_W 320
+#define FD_FRAME_H 240
+#define FD_CROP_W 160
+#define FD_CROP_H 120
+#define FD_RATE_MIN_HZ 2
+#define FD_RATE_MAX_HZ 5
+#define FD_SAMPLES 256
+
+enum { FD_MODEL_MSRMNP = 0, FD_MODEL_PICO224 = 1, FD_MODEL_COUNT };
+static const char* const FD_MODEL_NAMES[FD_MODEL_COUNT] = {"msrmnp", "pico224"};
+
+/* "msrmnp" or "msr" is 0, "pico224" or "pico" is 1, anything else -1. */
+static inline int fd_model_parse(const char* s)
+{
+    if (s == NULL) {
+        return -1;
+    }
+    if (strcmp(s, "msrmnp") == 0 || strcmp(s, "msr") == 0) {
+        return FD_MODEL_MSRMNP;
+    }
+    if (strcmp(s, "pico224") == 0 || strcmp(s, "pico") == 0) {
+        return FD_MODEL_PICO224;
+    }
+    return -1;
+}
+
+/* Milliseconds between two detections for a rate in hertz: 2 to 5 a second, 0 or less means the default of 3. */
+static inline uint32_t fd_period_ms(int hz)
+{
+    if (hz <= 0) {
+        hz = 3;
+    }
+    if (hz < FD_RATE_MIN_HZ) {
+        hz = FD_RATE_MIN_HZ;
+    }
+    if (hz > FD_RATE_MAX_HZ) {
+        hz = FD_RATE_MAX_HZ;
+    }
+    return 1000u / (uint32_t)hz;
+}
+
+/* ---- the picture: a window of a camera frame to RGB888 --------------------------------------------------------------------------- */
+
+static inline uint8_t fd_clamp8(int v)
+{
+    return (uint8_t)(v < 0 ? 0 : v > 255 ? 255 : v);
+}
+
+/* BT.601 limited range, integer. */
+static inline void fd_yuv_to_rgb(int y, int u, int v, uint8_t* r, uint8_t* g, uint8_t* b)
+{
+    int c = (y - 16) * 298, d = u - 128, e = v - 128;
+    *r = fd_clamp8((c + 409 * e + 128) >> 8);
+    *g = fd_clamp8((c - 100 * d - 208 * e + 128) >> 8);
+    *b = fd_clamp8((c + 516 * d + 128) >> 8);
+}
+
+/* Converts the cw by ch window at (x0, y0) of a w by h frame in `fmt` (MW_FMT_*) into `dst` (cw * ch * 3 bytes, RGB order, or BGR order
+ * when swap_rb). Returns 0, or -1 when the window is outside the frame, the format is unknown, the buffer is too short or a YUV window
+ * starts on an odd column. */
+static inline int fd_convert_rgb888(const uint8_t* src, size_t len, int w, int h, int fmt, int x0, int y0, int cw, int ch, uint8_t* dst,
+                                    int swap_rb)
+{
+    int bpp = mw_bpp(fmt);
+    if (src == NULL || dst == NULL || bpp == 0 || w <= 0 || h <= 0 || cw <= 0 || ch <= 0 || x0 < 0 || y0 < 0 || x0 + cw > w || y0 + ch > h ||
+        len < (size_t)w * (size_t)h * (size_t)bpp) {
+        return -1;
+    }
+    if ((fmt == MW_FMT_YUYV || fmt == MW_FMT_UYVY) && (x0 & 1)) {
+        return -1;
+    }
+    for (int j = 0; j < ch; j++) {
+        uint8_t* o = dst + (size_t)j * (size_t)cw * 3u;
+        for (int i = 0; i < cw; i++) {
+            int x = x0 + i, y = y0 + j;
+            uint8_t r, g, b;
+            const uint8_t* p = src + ((size_t)y * (size_t)w + (size_t)x) * (size_t)bpp;
+            if (fmt == MW_FMT_RGB565) {
+                int v = p[0] | (p[1] << 8);
+                int rr = (v >> 11) & 31, gg = (v >> 5) & 63, bb = v & 31;
+                r = (uint8_t)((rr << 3) | (rr >> 2));
+                g = (uint8_t)((gg << 2) | (gg >> 4));
+                b = (uint8_t)((bb << 3) | (bb >> 2));
+            } else if (fmt == MW_FMT_GREY) {
+                r = g = b = p[0];
+            } else {
+                const uint8_t* q = src + ((size_t)y * (size_t)w + (size_t)(x & ~1)) * 2u; /* the pair of pixels this one is in */
+                int yy, u, v;
+                if (fmt == MW_FMT_YUYV) {
+                    yy = q[(x & 1) ? 2 : 0];
+                    u = q[1];
+                    v = q[3];
+                } else {
+                    yy = q[(x & 1) ? 3 : 1];
+                    u = q[0];
+                    v = q[2];
+                }
+                fd_yuv_to_rgb(yy, u, v, &r, &g, &b);
+            }
+            if (swap_rb) {
+                o[0] = b;
+                o[1] = g;
+                o[2] = r;
+            } else {
+                o[0] = r;
+                o[1] = g;
+                o[2] = b;
+            }
+            o += 3;
+        }
+    }
+    return 0;
+}
+
+/* The top-left corner of a cw by ch window centered on (cx, cy) in a fw by fh frame, kept inside it, on an even column. */
+static inline void fd_crop_origin(int fw, int fh, int cw, int ch, float cx, float cy, int* x0, int* y0)
+{
+    int x = (int)(cx - (float)cw * 0.5f), y = (int)(cy - (float)ch * 0.5f);
+    if (x > fw - cw) {
+        x = fw - cw;
+    }
+    if (y > fh - ch) {
+        y = fh - ch;
+    }
+    if (x < 0) {
+        x = 0;
+    }
+    if (y < 0) {
+        y = 0;
+    }
+    *x0 = x & ~1;
+    *y0 = y;
+}
+
+/* ---- the face to follow ----------------------------------------------------------------------------------------------------------- */
+
+typedef struct {
+    float x0, y0, x1, y1; /* corners in frame pixels */
+    float score;
+} fd_box_t;
+
+typedef struct {
+    uint8_t valid;
+    float cx, cy; /* center in frame pixels */
+    float w, h;
+    float score;
+    uint32_t at_ms; /* when the picture was taken */
+    uint32_t seq;
+} fd_face_t;
+
+/* One face out of n boxes: those with score at least `thr`, the largest weighted by how near the middle of the frame it is (a box
+ * in the middle counts fully, one at the edge half). Returns 1 with `out` filled (at_ms and seq are the caller's), 0 when none. */
+static inline int fd_pick(const fd_box_t* b, int n, float thr, int fw, int fh, fd_face_t* out)
+{
+    int best = -1;
+    float best_v = 0.0f;
+    for (int i = 0; i < n; i++) {
+        if (b[i].score < thr || b[i].x1 <= b[i].x0 || b[i].y1 <= b[i].y0) {
+            continue;
+        }
+        float cx = (b[i].x0 + b[i].x1) * 0.5f;
+        float area = (b[i].x1 - b[i].x0) * (b[i].y1 - b[i].y0);
+        float off = fabsf(cx / (float)fw - 0.5f); /* 0 in the middle, 0.5 at an edge */
+        float v = area * (1.0f - off);
+        if (v > best_v) {
+            best_v = v;
+            best = i;
+        }
+    }
+    if (best < 0) {
+        return 0;
+    }
+    out->valid = 1;
+    out->cx = (b[best].x0 + b[best].x1) * 0.5f;
+    out->cy = (b[best].y0 + b[best].y1) * 0.5f;
+    out->w = b[best].x1 - b[best].x0;
+    out->h = b[best].y1 - b[best].y0;
+    out->score = b[best].score;
+    (void)fh;
+    return 1;
+}
+
+/* ---- the measured times ----------------------------------------------------------------------------------------------------------- */
+
+typedef struct {
+    uint32_t v[FD_SAMPLES];
+    int n;        /* samples held (the newest FD_SAMPLES) */
+    uint32_t seen; /* samples ever added */
+} fd_ring_t;
+
+static inline void fd_ring_clear(fd_ring_t* r)
+{
+    r->n = 0;
+    r->seen = 0;
+}
+
+static inline void fd_ring_add(fd_ring_t* r, uint32_t x)
+{
+    r->v[r->seen % FD_SAMPLES] = x;
+    r->seen++;
+    r->n = r->seen < FD_SAMPLES ? (int)r->seen : FD_SAMPLES;
+}
+
+/* Nearest-rank percentile (pct 1 to 100) of what the ring holds; 0 when empty. */
+static inline uint32_t fd_percentile(const fd_ring_t* r, int pct)
+{
+    if (r->n <= 0) {
+        return 0;
+    }
+    uint32_t s[FD_SAMPLES];
+    int n = r->n;
+    for (int i = 0; i < n; i++) {
+        s[i] = r->v[i];
+    }
+    for (int i = 1; i < n; i++) { /* insertion sort: at most 256 values */
+        uint32_t x = s[i];
+        int j = i - 1;
+        while (j >= 0 && s[j] > x) {
+            s[j + 1] = s[j];
+            j--;
+        }
+        s[j + 1] = x;
+    }
+    if (pct < 1) {
+        pct = 1;
+    }
+    if (pct > 100) {
+        pct = 100;
+    }
+    int rank = (pct * n + 99) / 100; /* 1-based nearest rank */
+    return s[rank - 1];
+}
+
+static inline uint32_t fd_ring_max(const fd_ring_t* r)
+{
+    uint32_t m = 0;
+    for (int i = 0; i < r->n; i++) {
+        if (r->v[i] > m) {
+            m = r->v[i];
+        }
+    }
+    return m;
+}
+
+#endif /* MAIPAI_FACEDET_CORE_H */
