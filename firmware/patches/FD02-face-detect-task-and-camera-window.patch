+
+// Patch FD02: the frame for the face detector (see the header). Same lock and the same two-read rule as SeekGrab. Experiment image only.
+#if defined(CONFIG_MAIPAI_FACE_DETECT) && CONFIG_MAIPAI_FACE_DETECT
+int StackChanCamera::DetectGrab(DetectSink sink, void* ctx)
+{
+    if (maipai_vision_off()) {
+        return 2;
+    }
+    auto lock = TryLockFrame();
+    if (!lock.owns_lock()) {
+        return 1;
+    }
+    if (!CaptureFrame(false, 1) || frame_.data == nullptr) {
+        return 2;
+    }
+    int fmt = MW_FMT_NONE;
+    switch (frame_.format) {
+        case V4L2_PIX_FMT_YUYV: fmt = MW_FMT_YUYV; break;
+        case V4L2_PIX_FMT_UYVY: fmt = MW_FMT_UYVY; break;
+        case V4L2_PIX_FMT_RGB565: fmt = MW_FMT_RGB565; break;
+        case V4L2_PIX_FMT_GREY: fmt = MW_FMT_GREY; break;
+        default: break;
+    }
+    const int rc = sink != nullptr ? sink(ctx, frame_.data, frame_.len, frame_.width, frame_.height, fmt) : 1;
+    heap_caps_free(frame_.data);
+    frame_.data   = nullptr;
+    frame_.len    = 0;
+    frame_.format = 0;
+    return rc == 0 ? 0 : 2;
+}
+#endif  // CONFIG_MAIPAI_FACE_DETECT
