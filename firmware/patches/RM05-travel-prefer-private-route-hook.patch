diff --git a/firmware/main/hal/maipai_tailnet_core.h b/firmware/main/hal/maipai_tailnet_core.h
--- a/firmware/main/hal/maipai_tailnet_core.h
+++ b/firmware/main/hal/maipai_tailnet_core.h
@@ -239,3 +239,32 @@ static inline void mt_region_moved(mt_region_t* r, int64_t now_ms)
     r->moves++;
     r->last_move_ms = now_ms;
 }
+
+/* The prefer-private-route test hook (patch RM05): "use the private network for the next N minutes". The deadline is
+ * kept in milliseconds of uptime; 0 means off. Never saved, so a restart clears it. Returns the deadline for a request
+ * of `minutes` (1 to MT_PREFER_MAX_MIN, anything else is refused with 0) made at `now_ms`. */
+#define MT_PREFER_MAX_MIN 60
+
+static inline int64_t mt_prefer_deadline(int64_t now_ms, int minutes)
+{
+    if (minutes < 1 || minutes > MT_PREFER_MAX_MIN) {
+        return 0;
+    }
+    return now_ms + (int64_t)minutes * 60000;
+}
+
+/* True while the hook is on: a deadline is set and has not passed. */
+static inline int mt_prefer_active(int64_t deadline_ms, int64_t now_ms)
+{
+    return deadline_ms != 0 && now_ms < deadline_ms;
+}
+
+/* The route the next connect uses with the hook: the private route (1) while the hook is on and the private network is
+ * ready with a saved hub address; otherwise the route the normal rule chose. */
+static inline int mt_prefer_route(int normal_route, int prefer_on, int tailnet_ready, int peer_saved)
+{
+    if (prefer_on && tailnet_ready && peer_saved) {
+        return 1;
+    }
+    return normal_route;
+}
