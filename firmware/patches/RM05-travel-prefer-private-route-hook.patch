+}
+
+bool maipai_tailnet_prefer_take()
+{
+    static unsigned seen = 0;
+    const unsigned gen = s_prefer_gen;
+    if (gen == seen) {
+        return false;
+    }
+    seen = gen;
+    return true;
+}
