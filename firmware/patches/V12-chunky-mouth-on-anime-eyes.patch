+/* The shape the mouth eases toward: the emotion's resting shape scaled to the style (width over 36, thickness over 8), shut and calm
+ * when sealed (mute), yawning when tired, and opened by the voice or the weight it was given (open01 0 to 1). */
+static inline ml_mouth_t ml_mouth_target(const ml_style_t* st, int emotion, int sealed, int speaking, float open01, uint32_t ms)
+{
+    const float kw = (float)st->mouth_w / 36.0f;
+    const float kt = 0.5f + 0.5f * ((float)st->mouth_t / 8.0f);
+    ml_mouth_t base = ML_LOOKS[emotion >= 0 && emotion < ML_COUNT ? emotion : 0].mouth;
+    base.w *= kw;
+    base.t *= kt;
+    if (sealed) {
+        base.bend = 0.0f;
+        base.wob = 0.0f;
+        base.split = 0.0f;
+        base.w = 30.0f * kw;
+        base.t = 5.0f * kt;
+    }
+    ml_mouth_t target = base;
+    if (!sealed && emotion == ML_TIRED && !speaking) target = ml_mouth_yawn(base, ms);
+    if (open01 > 0.0f && !sealed) target = ml_mouth_speaking(target, open01, (float)st->mouth_w / 46.0f);
+    return target;
+}
+
+/* The time constant: 40 ms while the voice opens it, 105 while it closes after speech, 90 for a change of mood. */
+static inline float ml_mouth_tau(const ml_mouth_t* cur, const ml_mouth_t* target, int speaking, float open01)
+{
+    return (target->t > cur->t && (speaking || open01 > 0.0f)) ? 40.0f : (speaking ? 105.0f : ML_MOUTH_TAU_MS);
+}
