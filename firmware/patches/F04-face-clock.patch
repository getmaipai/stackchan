 // Once a second, in the LVGL task (the lock is held): the work that follows the clock.
+
+#if CONFIG_MAIPAI_FACE_CLOCK
+namespace {
+std::atomic<uint32_t> s_last_active{0};
+std::atomic<uint32_t> s_forced_until{0};  // 0: nobody asked for the clock
+
+uint32_t mono_s()
+{
+    return static_cast<uint32_t>(esp_timer_get_time() / 1000000);
+}
+
+struct ClockUi {
+    lv_obj_t* root     = nullptr;
+    lv_obj_t* seg[4][7] = {};
+    lv_obj_t* colon[2] = {};
+    lv_obj_t* ampm     = nullptr;
+    lv_obj_t* date     = nullptr;
+    lv_obj_t* arc      = nullptr;
+    int shown_digit[4] = {-1, -1, -1, -1};
+    int band           = -1;
+    int ring           = 0;
+} s_ui;
+
+lv_obj_t* make_bar(lv_obj_t* parent, int x, int y, int w, int h, lv_color_t colour, int radius)
+{
+    lv_obj_t* o = lv_obj_create(parent);
+    lv_obj_remove_style_all(o);
+    lv_obj_remove_flag(o, LV_OBJ_FLAG_SCROLLABLE);
+    lv_obj_remove_flag(o, LV_OBJ_FLAG_CLICKABLE);  // a touch on the clock is a touch on the face
+    lv_obj_set_pos(o, x, y);
+    lv_obj_set_size(o, w, h);
+    lv_obj_set_style_radius(o, radius, 0);
+    lv_obj_set_style_bg_opa(o, LV_OPA_COVER, 0);
+    lv_obj_set_style_bg_color(o, colour, 0);
+    return o;
+}
+
+void clock_hide()
+{
+    if (s_ui.root != nullptr) {
+        lv_obj_delete(s_ui.root);
+        s_ui = ClockUi();
+    }
+}
+
+// The clock is dimmed at night whatever the time-of-day setting says (features.md, Clock face).
+lv_color_t clock_colour(const mf_config_t& c, int band, int pct_extra)
+{
+    uint8_t r, g, b;
+    mf_foreground(&c, &r, &g, &b);
+    const int pct = mf_band_dim_pct(band) * pct_extra / 100;
+    return lv_color_make(mf_scale_channel(r, pct), mf_scale_channel(g, pct), mf_scale_channel(b, pct));
+}
+
+void clock_build(lv_obj_t* panel, const mf_config_t& c, int band)
+{
+    const mf_clock_layout_t l = mf_clock_layout(c.clock_style);
+    const lv_color_t fg       = clock_colour(c, band, 100);
+    s_ui                      = ClockUi();
+    s_ui.ring                 = l.ring;
+    s_ui.band                 = band;
+    s_ui.root                 = make_bar(panel, 0, 0, 320, 240, lv_color_black(), 0);
+    const int width           = mf_clock_width(&l);
+    const int x0              = (320 - width) / 2;
+    const int y0              = (240 - l.digit_h) / 2 - (l.ring ? 6 : 14);
+    if (l.ring) {
+        s_ui.arc = lv_arc_create(s_ui.root);
+        lv_obj_remove_flag(s_ui.arc, LV_OBJ_FLAG_CLICKABLE);
+        lv_obj_remove_style(s_ui.arc, nullptr, LV_PART_KNOB);
+        lv_obj_set_size(s_ui.arc, 224, 224);
+        lv_obj_center(s_ui.arc);
+        lv_arc_set_rotation(s_ui.arc, 270);
+        lv_arc_set_bg_angles(s_ui.arc, 0, 360);
+        lv_arc_set_range(s_ui.arc, 0, 60);
+        lv_obj_set_style_arc_width(s_ui.arc, 6, LV_PART_MAIN);
+        lv_obj_set_style_arc_width(s_ui.arc, 6, LV_PART_INDICATOR);
+        lv_obj_set_style_arc_color(s_ui.arc, clock_colour(c, band, 25), LV_PART_MAIN);
+        lv_obj_set_style_arc_color(s_ui.arc, fg, LV_PART_INDICATOR);
+    }
+    const int xs[4] = {x0, x0 + l.digit_w + l.gap, x0 + 2 * l.digit_w + l.gap + l.colon_w,
+                       x0 + 3 * l.digit_w + 2 * l.gap + l.colon_w};
+    for (int d = 0; d < 4; d++) {
+        for (int sgm = 0; sgm < 7; sgm++) {
+            int rx, ry, rw, rh;
+            mf_seg_rect(sgm, xs[d], y0, l.digit_w, l.digit_h, l.bar, &rx, &ry, &rw, &rh);
+            s_ui.seg[d][sgm] = make_bar(s_ui.root, rx, ry, rw, rh, fg, l.bar / 3);
+            lv_obj_add_flag(s_ui.seg[d][sgm], LV_OBJ_FLAG_HIDDEN);
+        }
+    }
+    const int cx = x0 + 2 * l.digit_w + l.gap + (l.colon_w - l.bar) / 2;
+    s_ui.colon[0] = make_bar(s_ui.root, cx, y0 + l.digit_h / 3 - l.bar / 2, l.bar, l.bar, fg, l.bar / 3);
+    s_ui.colon[1] = make_bar(s_ui.root, cx, y0 + 2 * l.digit_h / 3 - l.bar / 2, l.bar, l.bar, fg, l.bar / 3);
+    s_ui.date = lv_label_create(s_ui.root);
+    lv_obj_set_style_text_font(s_ui.date, &lv_font_montserrat_20, 0);
+    lv_obj_set_style_text_color(s_ui.date, clock_colour(c, band, 70), 0);
+    lv_obj_align(s_ui.date, LV_ALIGN_TOP_MID, 0, y0 + l.digit_h + 14);
+    if (!c.clock24) {
+        s_ui.ampm = lv_label_create(s_ui.root);
+        lv_obj_set_style_text_font(s_ui.ampm, &lv_font_montserrat_20, 0);
+        lv_obj_set_style_text_color(s_ui.ampm, clock_colour(c, band, 70), 0);
+        lv_obj_align(s_ui.ampm, LV_ALIGN_TOP_LEFT, x0 + width - 30, y0 - 26);
+    }
+}
+
+void clock_recolour(const mf_config_t& c, int band)
+{
+    const lv_color_t fg = clock_colour(c, band, 100);
+    for (auto& row : s_ui.seg) {
+        for (lv_obj_t* o : row) {
+            lv_obj_set_style_bg_color(o, fg, 0);
+        }
+    }
+    for (lv_obj_t* o : s_ui.colon) {
+        lv_obj_set_style_bg_color(o, fg, 0);
+    }
+    lv_obj_set_style_text_color(s_ui.date, clock_colour(c, band, 70), 0);
+    if (s_ui.ampm != nullptr) {
+        lv_obj_set_style_text_color(s_ui.ampm, clock_colour(c, band, 70), 0);
+    }
+    if (s_ui.arc != nullptr) {
+        lv_obj_set_style_arc_color(s_ui.arc, clock_colour(c, band, 25), LV_PART_MAIN);
+        lv_obj_set_style_arc_color(s_ui.arc, fg, LV_PART_INDICATOR);
+    }
+    s_ui.band = band;
+}
+
+void clock_paint(const mf_config_t& c, int band)
+{
+    if (band != s_ui.band) {
+        clock_recolour(c, band);
+    }
+    const time_t t     = time(nullptr);
+    struct tm tm_local = {};
+    localtime_r(&t, &tm_local);
+    int digits[4];
+    const int ampm = mf_clock_digits(tm_local.tm_hour, tm_local.tm_min, c.clock24, digits);
+    for (int d = 0; d < 4; d++) {
+        if (digits[d] == s_ui.shown_digit[d]) {
+            continue;
+        }
+        s_ui.shown_digit[d]  = digits[d];
+        const uint8_t mask   = mf_digit_segments(digits[d]);
+        for (int sgm = 0; sgm < 7; sgm++) {
+            if (mask & (1 << sgm)) {
+                lv_obj_remove_flag(s_ui.seg[d][sgm], LV_OBJ_FLAG_HIDDEN);
+            } else {
+                lv_obj_add_flag(s_ui.seg[d][sgm], LV_OBJ_FLAG_HIDDEN);
+            }
+        }
+    }
+    const bool dots = (tm_local.tm_sec % 2) == 0;
+    for (lv_obj_t* o : s_ui.colon) {
+        if (dots) {
+            lv_obj_remove_flag(o, LV_OBJ_FLAG_HIDDEN);
+        } else {
+            lv_obj_add_flag(o, LV_OBJ_FLAG_HIDDEN);
+        }
+    }
+    char line[24];
+    mf_date_line(line, sizeof(line), c.lang, tm_local.tm_wday, tm_local.tm_mday, tm_local.tm_mon);
+    if (strcmp(lv_label_get_text(s_ui.date), line) != 0) {
+        lv_label_set_text(s_ui.date, line);
+    }
+    if (s_ui.ampm != nullptr) {
+        lv_label_set_text(s_ui.ampm, ampm == MF_AMPM_PM ? "PM" : "AM");
+    }
+    if (s_ui.arc != nullptr) {
+        lv_arc_set_value(s_ui.arc, tm_local.tm_sec);
+    }
+}
+
+// The once-a-second clock work (the LVGL lock is held).
+void clock_tick(const mf_config_t& c)
+{
+    const uint32_t now = mono_s();
+    const bool standby = hal_bridge::is_xiaozhi_idle();
+    // A mute, vision-off or quiet look and a ringing timer are never covered by the clock.
+    const bool blocked = maipai_privacy_bits() != 0 || maipai_timers_ringing();
+    if (!standby || blocked) {
+        s_last_active = now;  // busy: the idle count starts again
+    }
+    mf_clock_state_t st;
+    st.last_active_s  = s_last_active.load();
+    st.forced_until_s = s_forced_until.load();
+    const int minute  = local_minute();
+    const bool want   = mf_clock_wanted(&st, now, c.clock_idle_s, standby, blocked, minute >= 0);
+    auto* face        = current_face();
+    if (!want || face == nullptr || face->getPanel() == nullptr) {
+        clock_hide();
+        return;
+    }
+    mf_config_t forced = c;
+    forced.tod         = 1;  // the clock dims at night whatever the face setting says
+    const int band     = mf_band_for_minute(&forced, minute);
+    if (s_ui.root == nullptr) {
+        clock_build(face->getPanel()->get(), c, band);
+    }
+    clock_paint(c, band);
+}
+}  // namespace
+
+bool maipai_face_touched()
+{
+    s_last_active  = mono_s();
+    s_forced_until = 0;
+    if (s_ui.root == nullptr) {
+        return false;
+    }
+    clock_hide();
+    return true;
+}
+#endif
+
 #define MAIPAI_FACE_TICKS (CONFIG_MAIPAI_FACE_TOD || CONFIG_MAIPAI_FACE_CLOCK || CONFIG_MAIPAI_FACE_TIMERS)
