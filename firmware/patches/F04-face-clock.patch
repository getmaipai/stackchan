@@ -251,6 +471,9 @@ static void face_tick(lv_timer_t*)
         apply(current_face(), c);
     }
 #endif
+#if CONFIG_MAIPAI_FACE_CLOCK
+    clock_tick(c);
+#endif
 }
 #endif
 
