diff --git a/firmware/main/hal/maipai_face_clock_core.h b/firmware/main/hal/maipai_face_clock_core.h
new file mode 100644
index 0000000..97ce148
--- /dev/null
+++ b/firmware/main/hal/maipai_face_clock_core.h
@@ -0,0 +1,135 @@
+/*
+ * SPDX-License-Identifier: MIT
+ *
+ * The clock face (patch F04): the pure logic, no ESP-IDF, no clock of its own. The caller passes the
+ * time in. Header-only plain C99 so a host compiler can test it.
+ *
+ * Big digits are drawn from seven bars each, so no large font is needed and they scale cleanly. The
+ * clock face works with no host once the time is set. English and Spanish day and month names are
+ * plain ASCII (the screen font has no accents; the language pack adds them later).
+ */
+#ifndef MAIPAI_FACE_CLOCK_CORE_H
+#define MAIPAI_FACE_CLOCK_CORE_H
+
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+#include "maipai_face_core.h"
+
+/* Segment bits: a top, b top right, c bottom right, d bottom, e bottom left, f top left, g middle. */
+static const uint8_t MF_DIGIT_MASK[10] = {0x3F, 0x06, 0x5B, 0x4F, 0x66, 0x6D, 0x7D, 0x07, 0x7F, 0x6F};
+
+#define MF_AMPM_NONE 0
+#define MF_AMPM_AM 1
+#define MF_AMPM_PM 2
+#define MF_DIGIT_BLANK 10 /* no digit: the leading zero of a 12 hour clock */
+
+/* Splits a time into the four digits. A 12 hour clock shows 12 at midnight and noon and no leading zero. */
+static inline int mf_clock_digits(int hour, int minute, int clock24, int digits[4])
+{
+    int ampm = MF_AMPM_NONE;
+    int h    = hour;
+    if (!clock24) {
+        ampm = hour >= 12 ? MF_AMPM_PM : MF_AMPM_AM;
+        h    = hour % 12;
+        if (h == 0) {
+            h = 12;
+        }
+    }
+    digits[0] = h / 10;
+    digits[1] = h % 10;
+    digits[2] = minute / 10;
+    digits[3] = minute % 10;
+    if (!clock24 && digits[0] == 0) {
+        digits[0] = MF_DIGIT_BLANK;
+    }
+    return ampm;
+}
+
+static inline uint8_t mf_digit_segments(int digit)
+{
+    return (digit >= 0 && digit <= 9) ? MF_DIGIT_MASK[digit] : 0;
+}
+
+/* The rectangle of bar `seg` (0 a to 6 g) of a digit whose box is x, y, w, h with bars t thick. h must be 3t + 2L. */
+static inline void mf_seg_rect(int seg, int x, int y, int w, int h, int t, int* rx, int* ry, int* rw, int* rh)
+{
+    const int len = (h - 3 * t) / 2;
+    switch (seg) {
+        case 0: *rx = x + t;     *ry = y;               *rw = w - 2 * t; *rh = t;   break; /* a */
+        case 1: *rx = x + w - t; *ry = y + t;           *rw = t;         *rh = len; break; /* b */
+        case 2: *rx = x + w - t; *ry = y + 2 * t + len; *rw = t;         *rh = len; break; /* c */
+        case 3: *rx = x + t;     *ry = y + 2 * t + 2 * len; *rw = w - 2 * t; *rh = t; break; /* d */
+        case 4: *rx = x;         *ry = y + 2 * t + len; *rw = t;         *rh = len; break; /* e */
+        case 5: *rx = x;         *ry = y + t;           *rw = t;         *rh = len; break; /* f */
+        default: *rx = x + t;    *ry = y + t + len;     *rw = w - 2 * t; *rh = t;   break; /* g */
+    }
+}
+
+typedef struct {
+    int digit_w, digit_h, bar, gap, colon_w; /* pixels */
+    int ring;                                /* 1: a ring around the digits */
+} mf_clock_layout_t;
+
+/* Big digits fill the screen; the ring style is smaller so the digits sit inside the ring. h = 3 bar + 2 L. */
+static inline mf_clock_layout_t mf_clock_layout(int ring_style)
+{
+    mf_clock_layout_t l;
+    if (ring_style) {
+        l.digit_w = 36; l.digit_h = 69; l.bar = 7; l.gap = 8; l.colon_w = 18; l.ring = 1;
+    } else {
+        l.digit_w = 44; l.digit_h = 87; l.bar = 9; l.gap = 10; l.colon_w = 22; l.ring = 0;
+    }
+    return l;
+}
+
+static inline int mf_clock_width(const mf_clock_layout_t* l)
+{
+    return 4 * l->digit_w + 2 * l->gap + l->colon_w;
+}
+
+static const char* const MF_WEEKDAY[2][7] = {
+    {"Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"},
+    {"dom", "lun", "mar", "mie", "jue", "vie", "sab"},
+};
+static const char* const MF_MONTH[2][12] = {
+    {"Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"},
+    {"ene", "feb", "mar", "abr", "may", "jun", "jul", "ago", "sep", "oct", "nov", "dic"},
+};
+
+/* The date line: "Sun Nov 15" in English, "dom 15 nov" in Spanish (day before month). wday 0 is Sunday, mon 0 is January. */
+static inline void mf_date_line(char* out, size_t n, int lang, int wday, int mday, int mon)
+{
+    const int lg = lang == MF_LANG_ES ? 1 : 0;
+    if (wday < 0 || wday > 6 || mon < 0 || mon > 11 || mday < 1 || mday > 31) {
+        if (n > 0) {
+            out[0] = '\0';
+        }
+        return;
+    }
+    if (lg) {
+        snprintf(out, n, "%s %d %s", MF_WEEKDAY[1][wday], mday, MF_MONTH[1][mon]);
+    } else {
+        snprintf(out, n, "%s %s %d", MF_WEEKDAY[0][wday], MF_MONTH[0][mon], mday);
+    }
+}
+
+/* When the clock face shows. The clock never covers a privacy state or a ring, and any touch or activity ends it. */
+typedef struct {
+    uint32_t last_active_s; /* when the unit was last busy or touched */
+    uint32_t forced_until_s;/* a host or person asked for the clock until this time (0: not asked) */
+} mf_clock_state_t;
+
+static inline int mf_clock_wanted(const mf_clock_state_t* s, uint32_t now_s, int idle_cfg_s, int standby, int blocked,
+                                  int clock_known)
+{
+    if (!clock_known || blocked || !standby) {
+        return 0;
+    }
+    if (s->forced_until_s != 0 && now_s < s->forced_until_s) {
+        return 1;
+    }
+    return idle_cfg_s > 0 && now_s - s->last_active_s >= (uint32_t)idle_cfg_s;
+}
