+static volatile uint16_t s_region_saved = 0;  // patch RM04: learned relay region, used as the client's default at the next start
+static volatile int s_relay_home = 0;         // patch RM04: the relay region the client is on now (status only)
+static volatile int s_relay_hub  = 0;         // patch RM04: the hub's home relay region from the network map (status only)
+static mt_region_t s_region      = {0, 0};
 
 bool maipai_tailnet_compiled()
 {
@@ -111,6 +116,10 @@ static void load_saved()
     if (nvs_get_str(h, kKeyPeer, peer, &len) == ESP_OK && mt_peer_ok(peer)) {
         strlcpy(s_peer, peer, sizeof(s_peer));
     }
+    uint16_t region = 0;
+    if (nvs_get_u16(h, kKeyRegion, &region) == ESP_OK) {
+        s_region_saved = region;
+    }
     size_t klen = 0;
     s_key_saved = nvs_get_str(h, kKeyKey, nullptr, &klen) == ESP_OK && klen > 1;
     nvs_close(h);
@@ -212,6 +221,54 @@ static void on_state(microlink_t* ml, microlink_state_t state, void*)
     push_state_event();
 }
 
+// Patch RM04: move the client's home relay to the hub's relay region (see maipai_tailnet_core.h). Runs on the timer task
+// (an internal stack: the NVS write is safe here).
+static void follow_hub_relay()
+{
+    const uint32_t hub_ip = mt_parse_ip(s_peer);
+    if (hub_ip == 0 || s_ml == nullptr) {
+        return;  // no hub address saved: nothing to follow
+    }
+    microlink_diag_t diag;
+    if (microlink_get_diag(s_ml, &diag) != ESP_OK) {
+        return;
+    }
+    int hub_region = 0;
+    for (int i = 0; i < diag.peer_count; i++) {
+        microlink_peer_info_t peer;
+        if (microlink_get_peer_info(s_ml, i, &peer) == ESP_OK && peer.vpn_ip == hub_ip) {
+            hub_region = peer.derp_region;
+            break;
+        }
+    }
+    s_relay_home = diag.derp_home_region;
+    s_relay_hub  = hub_region;
+    const int64_t now_ms = esp_timer_get_time() / 1000;
+    const int want = mt_region_wanted(&s_region, now_ms, diag.derp_home_region, hub_region, s_state == ML_STATE_CONNECTED ? 1 : 0);
+    if (want != 0) {
+        const esp_err_t err = microlink_set_home_derp_region(s_ml, (uint16_t)want);
+        if (err == ESP_OK) {
+            mt_region_moved(&s_region, now_ms);
+            ESP_LOGW(TAG, "the hub is on relay region %d, this unit was on %d: moving the home relay to the hub's region", want,
+                     (int)diag.derp_home_region);
+            device_events_push("tailnet_state", "\"state\":\"relay_moved\",\"ip\":\"\"");
+        } else {
+            ESP_LOGW(TAG, "the hub's relay region %d is not usable from here (%s)", want, esp_err_to_name(err));
+            mt_region_moved(&s_region, now_ms);  // counts as a try: no retry storm
+        }
+    }
+    // Remember the region the unit is homed on once it equals the hub's, so the next start begins there.
+    if (hub_region > 0 && diag.derp_home_region == hub_region && s_region_saved != hub_region) {
+        nvs_handle_t h;
+        if (nvs_open(kNamespace, NVS_READWRITE, &h) == ESP_OK) {
+            nvs_set_u16(h, kKeyRegion, (uint16_t)hub_region);
+            nvs_commit(h);
+            nvs_close(h);
+            s_region_saved = (uint16_t)hub_region;
+        }
+    }
+}
