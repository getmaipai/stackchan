+
+/* The home relay region (patch RM04). Two private-network nodes can only start a handshake through a relay when both
+ * are connected to the same relay region: a node sends to a peer through its own home relay, and the peer listens on
+ * its own. The client picks a default region, so a unit whose default differs from the hub's relay could join the
+ * network and still never reach the hub unless the hub spoke first (seen on the old firmware, 2026-11-15, where the
+ * answer was to pin the hub's region by hand). The unit now learns the hub's region from the network map and moves its
+ * home relay there. `home` is the region the client is on, `hub` the hub's home region (0 = unknown). Moves are
+ * limited: at most MT_REGION_MAX_MOVES a boot, MT_REGION_GAP_MS apart, so a hub that flips between regions can never
+ * make the unit reconnect its relay over and over. */
+#define MT_REGION_MAX_MOVES 3
+#define MT_REGION_GAP_MS 60000
+
+typedef struct {
+    int moves;
+    int64_t last_move_ms;
+} mt_region_t;
+
+/* The region to move the home relay to now, or 0 to stay. Pure: call mt_region_moved after a move really happened. */
+static inline int mt_region_wanted(const mt_region_t* r, int64_t now_ms, int home, int hub, int connected)
+{
+    if (!connected || hub <= 0 || home <= 0 || hub == home) {
+        return 0;
+    }
+    if (r->moves >= MT_REGION_MAX_MOVES) {
+        return 0;
+    }
+    if (r->moves > 0 && now_ms - r->last_move_ms < MT_REGION_GAP_MS) {
+        return 0;
+    }
+    return hub;
+}
+
+static inline void mt_region_moved(mt_region_t* r, int64_t now_ms)
+{
+    r->moves++;
+    r->last_move_ms = now_ms;
+}
