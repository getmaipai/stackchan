+/*
+ * SPDX-License-Identifier: MIT
+ *
+ * Music dance on the unit (patch V03): sound-reactive nodding, dancing and mood faces while the link to Home is down.
+ * With CONFIG_MAIPAI_MUSIC_DANCE off nothing here is compiled.
+ */
+#pragma once
+#include <sdkconfig.h>
+
+#if CONFIG_MAIPAI_MUSIC_DANCE
+// Starts the analysis task and registers self.music.set and self.music.get_status. Off at boot until the host (or the
+// saved choice) turns it on.
+void maipai_music_init();
+#else
+inline void maipai_music_init() {}
+#endif
diff --git a/firmware/main/hal/maipai_music_core.h b/firmware/main/hal/maipai_music_core.h
new file mode 100644
--- /dev/null
+++ b/firmware/main/hal/maipai_music_core.h
@@ -0,0 +1,393 @@
+/*
+ * Music features (MaiPai patch 100): plain C, no ESP-IDF, so a host test can compile and run it.
+ *
+ * Front end (mm_front_*): takes channel 0 of the codec at its own rate, one sample at a time, removes
+ * DC, and for every 20 ms frame adds up the energy in four bands (about 60-250, 250-1000, 1000-3000,
+ * 3000-8000 Hz, four band-pass biquads), the total energy and the zero crossings.
+ * Analysis (mm_an_*): one call per frame keeps the last 6 s of a log-energy envelope, an onset signal
+ * (the rise of the four band log energies, summed) and the zero-crossing counts. Once a second
+ * mm_summarize turns them into the numbers the host decides on: the level, the band shares, a tempo
+ * (autocorrelation of the onset signal over 60 to 187 BPM) with its confidence, the spectral
+ * flatness of the bands, the zero-crossing rate and its spread, the share of the envelope's energy
+ * at 3 to 6 Hz (high for speech: the syllable rate) and the share of near-silent frames (speech has
+ * pauses). Nothing here keeps or returns audio. Single precision floats only (the S3 has no
+ * double-precision unit). Written to compile as C99 and as C++.
+ */
+#ifndef MAIPAI_MUSIC_CORE_H
+#define MAIPAI_MUSIC_CORE_H
+
+#include <math.h>
+#include <stdint.h>
+#include <string.h>
+
+#define MM_BANDS 4
+#define MM_FPS 50                 /* frames per second: 20 ms frames */
+#define MM_RING 300               /* 6 s of frames */
+#define MM_MIN_FRAMES 150         /* 3 s of history before a summary means anything */
+#define MM_MIN_LAG 16             /* 187 BPM */
+#define MM_MAX_LAG 50             /* 60 BPM */
+#define MM_MOD_FRAMES 150         /* the envelope window for the 3 to 6 Hz share */
+#define MM_MOD_FREQS 7
+#define MM_ZC_THRESHOLD 16.0f     /* Schmitt trigger for zero crossings, int16 units */
+#define MM_MIN_ONSET_STD 15       /* under 0.15 log2 units of onset variation there is no beat to find */
+#define MM_PAUSE_RATIO 0.1f       /* a frame under a tenth of the window's mean energy is a pause */
+
+typedef struct {
+    float b0, b1, b2, a1, a2;
+    float z1, z2;
+} mm_bq_t;
+
+typedef struct {
+    int rate;
+    int frame_len;   /* samples per 20 ms frame */
+    mm_bq_t bq[MM_BANDS];
+    float hp_prev_x, hp_prev_y, hp_r;
+    int zc_sign;
+    /* the frame being built */
+    float e[MM_BANDS];
+    float etot;
+    int zc;
+    int n;
+} mm_front_t;
+
+typedef struct {
+    float e[MM_BANDS];  /* sum of squares per band over the frame */
+    float etot;         /* sum of squares of the DC-removed signal */
+    int zc;             /* zero crossings */
+    int n;              /* samples in the frame */
+} mm_frame_t;
+
+typedef struct {
+    int16_t onset[MM_RING];  /* log2 units times 64 */
+    int16_t lenv[MM_RING];   /* log2(1 + mean square) times 64 */
+    uint8_t zc[MM_RING];
+    int head;                /* next slot */
+    int count;               /* frames held, up to MM_RING */
+    float prev_lb[MM_BANDS];
+    int have_prev;
+    float b_avg[MM_BANDS];   /* band mean squares, about 1 s time constant */
+    float lev_sum;           /* mean squares since the last summary */
+    int lev_n;
+    float scratch[MM_RING];  /* working room for mm_summarize, so no big array sits on a task stack */
+} mm_an_t;
+
+typedef struct {
+    int valid;     /* 0 when there is not enough history */
+    int lv;        /* RMS of the DC-removed signal over the last second, int16 units */
+    int b[MM_BANDS]; /* band shares, percent */
+    int bpm;       /* 0 when no tempo peak */
+    int tc;        /* tempo confidence, 0..100 */
+    int fl;        /* spectral flatness of the band densities, 0..100 */
+    int zc;        /* mean zero crossings per 20 ms frame over the active frames */
+    int zs;        /* spread (std / mean) of those, percent */
+    int mo;        /* share of the envelope's variance at 3 to 6 Hz, 0..100 */
+    int ps;        /* share of near-silent frames, 0..100 */
+    int on;        /* onset strength: std of the onset signal, log2 units times 100 */
+} mm_feat_t;
+
+static const float mm_band_hz[MM_BANDS]  = {120.0f, 500.0f, 1730.0f, 4900.0f};
+static const float mm_band_q[MM_BANDS]   = {0.63f, 0.67f, 0.87f, 0.98f};
+static const float mm_band_bw[MM_BANDS]  = {190.0f, 750.0f, 2000.0f, 5000.0f};
+
+static inline float mm_clampf(float x, float lo, float hi)
+{
+    return x < lo ? lo : (x > hi ? hi : x);
+}
+
+static inline int mm_round(float x)
+{
+    return (int)(x >= 0.0f ? x + 0.5f : x - 0.5f);
+}
+
+static inline float mm_bq_run(mm_bq_t* q, float x)
+{
+    const float y = q->b0 * x + q->z1;
+    q->z1         = q->b1 * x - q->a1 * y + q->z2;
+    q->z2         = q->b2 * x - q->a2 * y;
+    return y;
+}
+
+static inline void mm_front_reset(mm_front_t* f)
+{
+    int i;
+    for (i = 0; i < MM_BANDS; ++i) {
+        f->bq[i].z1 = f->bq[i].z2 = 0.0f;
+        f->e[i] = 0.0f;
+    }
+    f->hp_prev_x = f->hp_prev_y = 0.0f;
+    f->zc_sign = 0;
+    f->etot = 0.0f;
+    f->zc = 0;
+    f->n = 0;
+}
+
+static inline void mm_front_init(mm_front_t* f, int rate)
+{
+    int i;
+    memset(f, 0, sizeof(*f));
+    f->rate      = rate;
+    f->frame_len = rate / MM_FPS;
+    f->hp_r      = 1.0f - 6.2831853f * 20.0f / (float)rate;
+    for (i = 0; i < MM_BANDS; ++i) {
+        float w0    = 6.2831853f * mm_band_hz[i] / (float)rate;
+        float alpha = sinf(w0) / (2.0f * mm_band_q[i]);
+        float a0    = 1.0f + alpha;
+        f->bq[i].b0 = alpha / a0;
+        f->bq[i].b1 = 0.0f;
+        f->bq[i].b2 = -alpha / a0;
+        f->bq[i].a1 = -2.0f * cosf(w0) / a0;
+        f->bq[i].a2 = (1.0f - alpha) / a0;
+    }
+}
+
+/* Feed `frames` samples of one channel (`stride` int16 apart). Completed 20 ms frames go to `out`
+ * (room for at least frames / frame_len + 1); returns how many. */
+static inline int mm_front_feed(mm_front_t* f, const int16_t* x, int frames, int stride, mm_frame_t* out)
+{
+    int done = 0, i, b;
+    for (i = 0; i < frames; ++i) {
+        const float s = (float)x[i * stride];
+        const float y = s - f->hp_prev_x + f->hp_r * f->hp_prev_y;
+        f->hp_prev_x  = s;
+        f->hp_prev_y  = y;
+        f->etot += y * y;
+        for (b = 0; b < MM_BANDS; ++b) {
+            const float yb = mm_bq_run(&f->bq[b], y);
+            f->e[b] += yb * yb;
+        }
+        if (y > MM_ZC_THRESHOLD && f->zc_sign <= 0) {
+            f->zc_sign = 1;
+            f->zc++;
+        } else if (y < -MM_ZC_THRESHOLD && f->zc_sign >= 0) {
+            f->zc_sign = -1;
+            f->zc++;
+        }
+        if (++f->n >= f->frame_len) {
+            for (b = 0; b < MM_BANDS; ++b) {
+                out[done].e[b] = f->e[b];
+                f->e[b]        = 0.0f;
+            }
+            out[done].etot = f->etot;
+            out[done].zc   = f->zc;
+            out[done].n    = f->n;
+            f->etot = 0.0f;
+            f->zc   = 0;
+            f->n    = 0;
+            ++done;
+        }
+    }
+    return done;
+}
+
+static inline void mm_an_reset(mm_an_t* a)
+{
+    memset(a, 0, sizeof(*a));
+}
+
+static inline int mm_ring_at(const mm_an_t* a, int back)
+{
+    return (a->head - 1 - back + 2 * MM_RING) % MM_RING;
+}
+
+static inline int16_t mm_q64(float v)
+{
+    const float s = v * 64.0f;
+    return (int16_t)(s > 32000.0f ? 32000.0f : (s < -32000.0f ? -32000.0f : s));
+}
+
+static inline void mm_an_push(mm_an_t* a, const mm_frame_t* fr)
+{
+    float onset = 0.0f;
+    float nn    = fr->n > 0 ? (float)fr->n : 1.0f;
+    int b;
+    for (b = 0; b < MM_BANDS; ++b) {
+        const float ms = fr->e[b] / nn;
+        const float lb = log2f(1.0f + ms);
+        if (a->have_prev && lb > a->prev_lb[b]) {
+            onset += lb - a->prev_lb[b];
+        }
+        a->prev_lb[b] = lb;
+        a->b_avg[b]   = a->have_prev ? a->b_avg[b] + (ms - a->b_avg[b]) * 0.02f : ms;
+    }
+    a->have_prev          = 1;
+    a->onset[a->head]     = mm_q64(onset);
+    a->lenv[a->head]      = mm_q64(log2f(1.0f + fr->etot / nn));
+    a->zc[a->head]        = (uint8_t)(fr->zc > 255 ? 255 : fr->zc);
+    a->head               = (a->head + 1) % MM_RING;
+    if (a->count < MM_RING) {
+        ++a->count;
+    }
+    a->lev_sum += fr->etot / nn;
+    a->lev_n++;
+}
+
+/* Tempo from the autocorrelation of the onset signal; 0 bpm when there is no usable peak. */
+static inline void mm_tempo(mm_an_t* a, int* bpm, int* conf, int* onset_std)
+{
+    float* x = a->scratch;
+    float mean = 0.0f, r0 = 0.0f, best = 0.0f, r[MM_MAX_LAG + 2];
+    int n = a->count, i, lag, best_lag = 0;
+    *bpm  = 0;
+    *conf = 0;
+    *onset_std = 0;
+    if (n < MM_MIN_FRAMES) {
+        return;
+    }
+    for (i = 0; i < n; ++i) {
+        x[n - 1 - i] = (float)a->onset[mm_ring_at(a, i)];  /* oldest first */
+        mean += x[n - 1 - i];
+    }
+    mean /= (float)n;
+    for (i = 0; i < n; ++i) {
+        x[i] -= mean;
+        r0 += x[i] * x[i];
+    }
+    *onset_std = mm_round(100.0f * sqrtf(r0 / (float)n) / 64.0f);
+    if (*onset_std < MM_MIN_ONSET_STD) {
+        return;  /* a steady sound has no beat; frame-phase ripple must not read as one */
+    }
+    for (lag = 0; lag <= MM_MAX_LAG + 1; ++lag) {
+        float s = 0.0f;
+        if (lag < MM_MIN_LAG - 1 || lag > MM_MAX_LAG + 1) {
+            r[lag] = 0.0f;
+            continue;
+        }
+        for (i = lag; i < n; ++i) {
+            s += x[i] * x[i - lag];
+        }
+        r[lag] = s / r0;
+    }
+    for (lag = MM_MIN_LAG; lag <= MM_MAX_LAG; ++lag) {
+        if (r[lag] > best && r[lag] >= r[lag - 1] && r[lag] >= r[lag + 1]) {
+            best     = r[lag];
+            best_lag = lag;
+        }
+    }
+    if (best_lag == 0) {
+        return;
+    }
+    /* A slow peak whose double-speed lag is nearly as strong is the beat at half speed. */
+    if (best_lag > 32 && best_lag / 2 >= MM_MIN_LAG) {
+        const int half = best_lag / 2;
+        float h        = r[half];
+        if (half + 1 <= MM_MAX_LAG && r[half + 1] > h) {
+            h = r[half + 1];
+        }
+        if (r[half - 1] > h) {
+            h = r[half - 1];
+        }
+        if (h >= 0.7f * best) {
+            best_lag = r[half] >= r[half - 1] && r[half] >= r[half + 1] ? half
+                       : (r[half + 1] > r[half - 1] ? half + 1 : half - 1);
+            if (best_lag < MM_MIN_LAG) {
+                best_lag = MM_MIN_LAG;
+            }
+            best = r[best_lag];
+        }
+    }
+    {
+        float lagf = (float)best_lag;
+        const float y0 = r[best_lag - 1], y1 = r[best_lag], y2 = r[best_lag + 1];
+        const float d  = y0 - 2.0f * y1 + y2;
+        if (d < 0.0f) {
+            lagf += 0.5f * (y0 - y2) / d;
+        }
+        *bpm  = mm_round(60.0f * (float)MM_FPS / lagf);
+        *conf = mm_round(mm_clampf(best, 0.0f, 1.0f) * 100.0f);
+    }
+}
+
+/* Once a second. Resets the level accumulator. */
+static inline void mm_summarize(mm_an_t* a, mm_feat_t* o)
+{
+    float* lin = a->scratch;
+    float mean_e = 0.0f, tot = 0.0f, lnsum = 0.0f, dens_sum = 0.0f;
+    int n = a->count, i, b, pauses = 0, active = 0;
+    memset(o, 0, sizeof(*o));
+    o->lv = a->lev_n > 0 ? mm_round(sqrtf(a->lev_sum / (float)a->lev_n)) : 0;
+    a->lev_sum = 0.0f;
+    a->lev_n   = 0;
+    if (n < MM_MIN_FRAMES) {
+        return;
+    }
+    o->valid = 1;
+    for (b = 0; b < MM_BANDS; ++b) {
+        tot += a->b_avg[b];
+    }
+    if (tot > 0.0f) {
+        for (b = 0; b < MM_BANDS; ++b) {
+            o->b[b] = mm_round(100.0f * a->b_avg[b] / tot);
+        }
+    }
+    for (b = 0; b < MM_BANDS; ++b) {
+        float d = a->b_avg[b] / mm_band_bw[b];
+        if (d < 1e-3f) {
+            d = 1e-3f;
+        }
+        lnsum += logf(d);
+        dens_sum += d;
+    }
+    o->fl = mm_round(100.0f * mm_clampf(expf(lnsum / (float)MM_BANDS) / (dens_sum / (float)MM_BANDS), 0.0f, 1.0f));
+    mm_tempo(a, &o->bpm, &o->tc, &o->on);
+    for (i = 0; i < n; ++i) {
+        lin[i] = exp2f((float)a->lenv[mm_ring_at(a, i)] / 64.0f);
+        mean_e += lin[i];
+    }
+    mean_e /= (float)n;
+    {
+        float zsum = 0.0f, zsq = 0.0f;
+        for (i = 0; i < n; ++i) {
+            if (lin[i] < MM_PAUSE_RATIO * mean_e) {
+                ++pauses;
+            } else {
+                const float z = (float)a->zc[mm_ring_at(a, i)];
+                zsum += z;
+                zsq += z * z;
+                ++active;
+            }
+        }
+        o->ps = mm_round(100.0f * (float)pauses / (float)n);
+        if (active > 0) {
+            const float m = zsum / (float)active;
+            float var     = zsq / (float)active - m * m;
+            if (var < 0.0f) {
+                var = 0.0f;
+            }
+            o->zc = mm_round(m);
+            o->zs = m > 0.0f ? mm_round(100.0f * sqrtf(var) / m) : 0;
+        }
+    }
+    {
+        /* Variance share of the log-energy envelope at 3 to 6 Hz (Goertzel at seven frequencies). */
+        const int m = n < MM_MOD_FRAMES ? n : MM_MOD_FRAMES;
+        float mean = 0.0f, ssx = 0.0f, share = 0.0f;
+        float* x = a->scratch;
+        int k;
+        for (i = 0; i < m; ++i) {
+            x[m - 1 - i] = (float)a->lenv[mm_ring_at(a, i)] / 64.0f;
+            mean += x[m - 1 - i];
+        }
+        mean /= (float)m;
+        for (i = 0; i < m; ++i) {
+            x[i] -= mean;
+            ssx += x[i] * x[i];
+        }
+        if (ssx > 1e-3f) {
+            for (k = 0; k < MM_MOD_FREQS; ++k) {
+                const float f = 3.0f + 0.5f * (float)k;
+                const float c = 2.0f * cosf(6.2831853f * f / (float)MM_FPS);
+                float s1 = 0.0f, s2 = 0.0f, p;
+                for (i = 0; i < m; ++i) {
+                    const float s0 = x[i] + c * s1 - s2;
+                    s2 = s1;
+                    s1 = s0;
+                }
+                p = s1 * s1 + s2 * s2 - c * s1 * s2;
+                share += 2.0f * p / ((float)m * ssx);
+            }
+            o->mo = mm_round(100.0f * mm_clampf(share, 0.0f, 1.0f));
+        }
+    }
+}
+
+#endif /* MAIPAI_MUSIC_CORE_H */
diff --git a/firmware/main/hal/maipai_music_judge.h b/firmware/main/hal/maipai_music_judge.h
new file mode 100644
--- /dev/null
+++ b/firmware/main/hal/maipai_music_judge.h
@@ -0,0 +1,157 @@
+#ifndef MAIPAI_MUSIC_JUDGE_H
+#define MAIPAI_MUSIC_JUDGE_H
+
+#include <stdint.h>
+
+#define MMJ_MIN_LEVEL 400
+#define MMJ_MIN_BPM 60
+#define MMJ_MAX_BPM 187
+#define MMJ_STEADY_TC_MIN 8
+#define MMJ_STEADY_LEVEL 800
+#define MMJ_STEADY_MO_MAX 32
+#define MMJ_STEADY_PS_MAX 20
+#define MMJ_STEADY_FL_MAX 97
+#define MMJ_DETECT_MS 3000U
+#define MMJ_GAP_MS 2500U
+#define MMJ_NOD_TO_DANCE_MS 15000U
+#define MMJ_END_SILENCE_MS 3000U
+#define MMJ_MIN_GAP_MS 120000U
+#define MMJ_SESSION_GAP_MS 60000U
+#define MMJ_BREAK_MS 90000U
+#define MMJ_BLOCK_USB_MS 300000U
+#define MMJ_BLOCK_BATTERY_MS 120000U
+
+typedef struct {
+    int lv, bpm, tc, fl, mo, ps;
+    int muted;
+} mmj_feat_t;
+
+typedef enum { MMJ_SENS_LOW, MMJ_SENS_MEDIUM, MMJ_SENS_HIGH } mmj_sens_t;
+typedef enum {
+    MMJ_BELOW_LEVEL_GATE,
+    MMJ_WEAK_BEAT,
+    MMJ_NO_TEMPO,
+    MMJ_TEMPO_OUT_OF_RANGE,
+    MMJ_TOO_FLAT,
+    MMJ_SPEECH_LIKE_MODULATION,
+    MMJ_SPEECH_LIKE_PAUSES,
+    MMJ_SELF_HEARING_BLANK,
+    MMJ_MUSIC
+} mmj_reason_t;
+
+typedef struct { int music; mmj_reason_t reason; } mmj_verdict_t;
+
+typedef struct { int tc_min, mo_max, ps_max, ps_tc_free, fl_max; } mmj_sensitivity_t;
+static const mmj_sensitivity_t MMJ_SENSITIVITIES[] = {
+    {40, 40, 40, 50, 88}, {20, 45, 40, 50, 88}, {14, 55, 40, 50, 88}
+};
+
+static inline int mmj_steady(const mmj_feat_t *f) {
+    return f->lv >= MMJ_STEADY_LEVEL && f->bpm > 0 && f->tc >= MMJ_STEADY_TC_MIN &&
+           f->mo < MMJ_STEADY_MO_MAX && f->ps < MMJ_STEADY_PS_MAX && f->fl < MMJ_STEADY_FL_MAX;
+}
+
+static inline mmj_verdict_t mmj_make(int yes, mmj_reason_t why) {
+    mmj_verdict_t v = {yes, why}; return v;
+}
+
+static inline mmj_verdict_t mmj_judge(const mmj_feat_t *f, mmj_sens_t sensitivity, int relaxed) {
+    mmj_sensitivity_t s;
+    int tc_min, mo_max, ps_max, fl_max;
+    if (sensitivity < MMJ_SENS_LOW || sensitivity > MMJ_SENS_HIGH) sensitivity = MMJ_SENS_MEDIUM;
+    s = MMJ_SENSITIVITIES[sensitivity];
+    tc_min = s.tc_min; mo_max = s.mo_max; ps_max = s.ps_max; fl_max = s.fl_max;
+    if (relaxed) { tc_min = tc_min / 2; if (tc_min < 8) tc_min = 8; fl_max += 10; mo_max += 10; ps_max += 10; }
+    if (f->muted) return mmj_make(0, MMJ_SELF_HEARING_BLANK);
+    if (f->lv < MMJ_MIN_LEVEL) return mmj_make(0, MMJ_BELOW_LEVEL_GATE);
+    if (sensitivity != MMJ_SENS_LOW && mmj_steady(f)) return mmj_make(1, MMJ_MUSIC);
+    if (f->tc < tc_min) return mmj_make(0, MMJ_WEAK_BEAT);
+    if (f->bpm == 0) return mmj_make(0, MMJ_NO_TEMPO);
+    if (f->bpm < MMJ_MIN_BPM || f->bpm > MMJ_MAX_BPM) return mmj_make(0, MMJ_TEMPO_OUT_OF_RANGE);
+    if (f->fl >= fl_max) return mmj_make(0, MMJ_TOO_FLAT);
+    if (f->mo >= mo_max) return mmj_make(0, MMJ_SPEECH_LIKE_MODULATION);
+    if (f->ps >= ps_max && f->tc < s.ps_tc_free) return mmj_make(0, MMJ_SPEECH_LIKE_PAUSES);
+    return mmj_make(1, MMJ_MUSIC);
+}
+
+typedef enum { MMJ_ACTION_NONE, MMJ_ACTION_NOD, MMJ_ACTION_DANCE, MMJ_ACTION_BREAK, MMJ_ACTION_PAUSE, MMJ_ACTION_END } mmj_action_t;
+
+/* The unit's own music session (no hub), the same cycles as the host's music_dance.py: the slow start (the nod,
+ * then the dance 20 s later), a dance block (5 minutes charging, 2 minutes on battery: mmj_session_set_block_ms),
+ * then the SLOW MOOD for 90 s (MMJ_ACTION_BREAK: the gentle sway goes on, it does not stop), then the dance again,
+ * and so on for as long as the music goes on. No music for 9 s pauses the dance (MMJ_ACTION_PAUSE: the caller stops
+ * it; it starts again as soon as clear music returns); a gap of 60 s ends the session (MMJ_ACTION_END). No hourly
+ * or daily caps. The caller stops the dance on PAUSE and END only. */
+typedef struct {
+    uint32_t run_start, last_music, nod_at, block_at, break_at, last_end, block_ms;
+    uint8_t state; /* 0 idle, 1 nod and watch, 2 dancing, 3 paused (no music), 4 slow mood */
+    uint8_t resume_state; /* the state to go back to after a pause: 2 or 4 */
+    uint32_t paused_at;
+    uint8_t has_music, has_end;
+} mmj_session_t;
+
+static inline uint32_t mmj_elapsed(uint32_t now, uint32_t then) { return now - then; }
+static inline void mmj_session_set_block_ms(mmj_session_t *s, uint32_t ms) { s->block_ms = ms; }
+static inline void mmj_session_init(mmj_session_t *s) {
+    s->run_start = s->last_music = s->nod_at = s->block_at = s->break_at = s->last_end = 0;
+    s->block_ms = MMJ_BLOCK_BATTERY_MS;
+    s->state = s->has_music = s->has_end = 0;
+    s->resume_state = 2;
+    s->paused_at = 0;
+}
+/* Call once per second with this second's verdict. */
+static inline mmj_action_t mmj_session_step(mmj_session_t *s, uint32_t now_ms, int music) {
+    uint32_t silence;
+    if (music) {
+        if (!s->has_music || mmj_elapsed(now_ms, s->last_music) > MMJ_GAP_MS) s->run_start = now_ms;
+        s->last_music = now_ms;
+        s->has_music = 1;
+    }
+    silence = s->has_music ? mmj_elapsed(now_ms, s->last_music) : 0xFFFFFFFFU;
+    switch (s->state) {
+    case 0:
+        if (music && (!s->has_end || mmj_elapsed(now_ms, s->last_end) >= MMJ_MIN_GAP_MS) &&
+            mmj_elapsed(now_ms, s->run_start) >= MMJ_DETECT_MS) {
+            s->state = 1; s->nod_at = now_ms;
+            return MMJ_ACTION_NOD;
+        }
+        return MMJ_ACTION_NONE;
+    case 1:
+        if (silence >= MMJ_END_SILENCE_MS) { s->state = 0; s->last_end = now_ms; s->has_end = 1; return MMJ_ACTION_END; }
+        if (music && mmj_elapsed(now_ms, s->nod_at) >= MMJ_NOD_TO_DANCE_MS) {
+            s->state = 2; s->block_at = now_ms;
+            return MMJ_ACTION_DANCE;
+        }
+        return MMJ_ACTION_NONE;
+    case 2: /* dancing */
+        if (silence >= MMJ_SESSION_GAP_MS) { s->state = 0; s->last_end = now_ms; s->has_end = 1; return MMJ_ACTION_END; }
+        if (silence >= MMJ_END_SILENCE_MS) { s->resume_state = 2; s->paused_at = now_ms; s->state = 3; return MMJ_ACTION_PAUSE; }
+        if (mmj_elapsed(now_ms, s->block_at) >= s->block_ms) {
+            s->state = 4; s->break_at = now_ms;
+            return MMJ_ACTION_BREAK;
+        }
+        return MMJ_ACTION_NONE;
+    case 4: /* the slow mood */
+        if (silence >= MMJ_SESSION_GAP_MS) { s->state = 0; s->last_end = now_ms; s->has_end = 1; return MMJ_ACTION_END; }
+        if (silence >= MMJ_END_SILENCE_MS) { s->resume_state = 4; s->paused_at = now_ms; s->state = 3; return MMJ_ACTION_PAUSE; }
+        if (music && mmj_elapsed(now_ms, s->break_at) >= MMJ_BREAK_MS) {
+            s->state = 2; s->block_at = now_ms;
+            return MMJ_ACTION_DANCE;
+        }
+        return MMJ_ACTION_NONE;
+    default: /* 3: paused, no music */
+        if (silence >= MMJ_SESSION_GAP_MS) { s->state = 0; s->last_end = now_ms; s->has_end = 1; return MMJ_ACTION_END; }
+        if (music) { /* right back to the mood it was in: the block timers move on by the pause */
+            uint32_t gap = mmj_elapsed(now_ms, s->paused_at);
+            if (s->resume_state == 4) {
+                s->state = 4; s->break_at += gap;
+                return MMJ_ACTION_BREAK; /* the slow mood */
+            }
+            s->state = 2; s->block_at += gap;
+            return MMJ_ACTION_DANCE;
+        }
+        return MMJ_ACTION_NONE;
+    }
+}
+
+#endif
diff --git a/firmware/main/hal/maipai_music_mood_core.h b/firmware/main/hal/maipai_music_mood_core.h
new file mode 100644
--- /dev/null
+++ b/firmware/main/hal/maipai_music_mood_core.h
@@ -0,0 +1,31 @@
+/*
+ * SPDX-License-Identifier: MIT
+ *
+ * Mood faces for music (patch V03). Plain C99, no firmware headers: host/tests/firmware/music_mood_test.c compiles it.
+ * Which face the unit wears while it nods or dances to a song: a calm song keeps the plain happy face, a middling
+ * one swaps happy and laughing every 12 seconds, a fast loud one laughs. The caller changes the face only when this
+ * answers a different one, so the face never flickers.
+ */
+#pragma once
+#include <stdint.h>
+
+#define MMM_FACE_COUNT 2
+static const char* const MMM_FACES[MMM_FACE_COUNT] = {"happy", "laughing"};
+
+#define MMM_SWAP_S 12      /* a middling song swaps its face this often */
+#define MMM_FAST_BPM 125   /* at or above this and loud: laughing */
+#define MMM_FAST_LEVEL 1500
+#define MMM_MID_BPM 95
+
+/* bpm and lv (the level, int16 RMS) are this second's measurement (bpm 0: no tempo); `since_s` is the seconds since
+ * the nod began. Returns an index into MMM_FACES. */
+static inline int mmm_face(int bpm, int lv, uint32_t since_s)
+{
+    if (bpm >= MMM_FAST_BPM && lv >= MMM_FAST_LEVEL) {
+        return 1;
+    }
+    if (bpm >= MMM_MID_BPM) {
+        return (int)((since_s / MMM_SWAP_S) & 1u);
+    }
+    return 0;
+}
diff --git a/firmware/main/stackchan/modifiers/beat_sway.h b/firmware/main/stackchan/modifiers/beat_sway.h
new file mode 100644
--- /dev/null
+++ b/firmware/main/stackchan/modifiers/beat_sway.h
@@ -0,0 +1,106 @@
+/*
+ * MaiPai patch 128: the head sways on the beat of the song (owner 2026-11-13: "any way to have StackChan dance to
+ * the beat of the song"). The music analysis (hal_music.cpp) publishes the song's beat period and the time of a
+ * recent beat; this modifier moves the head once per beat, side to side with a small bob, at the song's tempo, with
+ * the happy squint of the Happy dance. Without a fresh beat it plays the Happy keyframes instead, so the head never
+ * stands still while music plays. It never ends by itself: the dance code removes it.
+ */
+#pragma once
+#include "../modifiable.h"
+#include "../animation/animation.h"
+#include "dance.h"
+#include <esp_timer.h>
+#include <cstdint>
+
+// hal_music.cpp: true while a beat (period and the time of a recent beat, both on the esp_timer millisecond clock)
+// was measured in the last 3 seconds with a confidence of at least 30.
+bool maipai_beat_get(uint32_t* period_ms, uint32_t* ref_ms);
+
+namespace stackchan {
+
+class BeatSwayModifier : public Modifier {
+public:
+    // bob_only: the head nods up and down on the beat and nothing else (the first stage of a music session,
+    // before the full dance); it keeps the last known beat, or 600 ms, when the beat is unclear.
+    explicit BeatSwayModifier(bool bob_only = false)
+        : _fallback(DanceModifier::Happy, true),
+          _bob_only(bob_only),
+          _t0(static_cast<uint32_t>(esp_timer_get_time() / 1000))
+    {
+    }
+
+    void _update(Modifiable& stackchan) override
+    {
+        if (!stackchan.hasAvatar()) {
+            return;
+        }
+        uint32_t period = 0, ref = 0;
+        const uint32_t now = static_cast<uint32_t>(esp_timer_get_time() / 1000);
+        bool have          = maipai_beat_get(&period, &ref) && period >= 250;
+        if (have) {
+            _last_period = period;
+            _last_ref    = ref;
+            _have_last   = true;
+        } else if (_bob_only) {
+            period = _have_last ? _last_period : 600;
+            ref    = _have_last ? _last_ref : _t0;
+            have   = true;
+        }
+        if (!have) {
+            // No beat to follow right now: the plain Happy sway keeps the head moving.
+            if (!_fallback_running) {
+                _fallback.start();
+                _fallback_running = true;
+            }
+            _fallback.update();
+            _have_beat = false;
+            return;
+        }
+        _fallback_running = false;
+        const int32_t step = period < 450 ? 2 : 1;  // above about 133 BPM: every second beat
+        const int32_t since = static_cast<int32_t>(now - ref);
+        const int32_t beat  = since >= 0 ? since / static_cast<int32_t>(period)
+                                         : -1 - ((-since - 1) / static_cast<int32_t>(period));
+        const int32_t b     = beat >= 0 ? beat / step : -1 - ((-beat - 1) / step);
+        if (_have_beat && b == _last_b) {
+            return;
+        }
+        _have_beat = true;
+        _last_b    = b;
+        const int side         = (b & 1) ? 1 : -1;
+        const uint32_t span_ms = period * static_cast<uint32_t>(step);
+        int speed              = static_cast<int>(240000U / span_ms);
+        speed                  = speed < 220 ? 220 : (speed > 600 ? 600 : speed);
+        if (_bob_only) {
+            // Up and down only: the head nods on every beat (0.1 degree units, level is about -100).
+            stackchan.motion().moveWithSpeed(0, side > 0 ? -170 : -40, speed);
+            return;
+        }
+        const int swing = span_ms < 600 ? 200 : 300;  // smaller swings for quick songs
+        // The Happy dance's own yaw and pitch (0.1 degree units): side to side, the head a little down, a small bob.
+        stackchan.motion().moveWithSpeed(side * swing, side > 0 ? -120 : -80, speed);
+        // The Happy squint: eyes at weight 50 shifted with the sway, the mouth open at weight 50, sizes neutral.
+        auto squint = [](avatar::Feature& feat, int x) {
+            feat.setPosition(uitk::Vector2i(x, 0));
+            feat.setRotation(0);
+            feat.setWeight(50);
+            feat.setSize(0);
+        };
+        squint(stackchan.avatar().leftEye(), side * 10);
+        squint(stackchan.avatar().rightEye(), side * 10);
+        squint(stackchan.avatar().mouth(), 0);
+    }
+
+private:
+    animation::Timeline _fallback;
+    bool _bob_only         = false;
+    uint32_t _t0           = 0;
+    uint32_t _last_period  = 0;
+    uint32_t _last_ref     = 0;
+    bool _have_last        = false;
+    bool _fallback_running = false;
+    bool _have_beat        = false;
+    int32_t _last_b        = 0;
+};
+
+}  // namespace stackchan
