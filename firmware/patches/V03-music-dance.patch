diff --git a/firmware/main/hal/maipai_beat.h b/firmware/main/hal/maipai_beat.h
new file mode 100644
--- /dev/null
+++ b/firmware/main/hal/maipai_beat.h
@@ -0,0 +1,96 @@
+#ifndef MAIPAI_BEAT_H
+#define MAIPAI_BEAT_H
+
+/* The beat of a song, from the onset signal the unit already measures (maipai_music_core.h): plain C99, no
+ * hardware. mb_fold_bpm folds the autocorrelation's tempo (often a half or a double) into 70 to 140 BPM;
+ * mb_phase finds where the beats fall in the last few seconds of the onset signal; mb_next_beat_ms says when
+ * the next one comes. The dance sways on those times and follows the tempo. */
+
+#include <stdint.h>
+
+#define MB_MAX_FRAMES 512
+#define MB_MAX_PERIOD_FRAMES 64
+
+typedef struct {
+    int confidence;       /* 0..100: how much better the best phase is than an average one */
+    int last_beat_ms_ago; /* from the newest frame back to the latest beat */
+    int period_ms;        /* one beat, after folding */
+} mb_beat_t;
+
+static inline int mb_fold_bpm(int bpm) {
+    if (bpm <= 0) return 0;
+    while (bpm < 70) bpm *= 2;
+    while (bpm > 140) bpm = (bpm + 1) / 2;
+    return bpm;
+}
+
+/* onset_oldest_first: n_frames values, one per frame_ms. Returns the confidence (0 when there is no usable
+ * beat). Recent beats weigh more, so a tempo that is a few percent off still lands the newest beat. */
+static inline int mb_phase(const int16_t *onset_oldest_first, int n_frames, int frame_ms, int bpm,
+                           mb_beat_t *out) {
+    int folded, period_ms, period_frames, offset, i, median = 0, best_offset = 0, last_idx;
+    int16_t sorted[MB_MAX_FRAMES];
+    int64_t total = 0, best = -1;
+    if (out == 0) return 0;
+    out->confidence = 0;
+    out->last_beat_ms_ago = 0;
+    out->period_ms = 0;
+    if (onset_oldest_first == 0 || n_frames <= 0 || frame_ms <= 0 || bpm <= 0) return 0;
+    folded = mb_fold_bpm(bpm);
+    period_ms = 60000 / folded;
+    period_frames = (period_ms + frame_ms / 2) / frame_ms;
+    if (period_frames < 2 || period_frames > MB_MAX_PERIOD_FRAMES) return 0;
+    if (n_frames > MB_MAX_FRAMES) {
+        onset_oldest_first += n_frames - MB_MAX_FRAMES; /* keep the newest */
+        n_frames = MB_MAX_FRAMES;
+    }
+    if (n_frames < 2 * period_frames) return 0;
+    for (i = 0; i < n_frames; i++) sorted[i] = onset_oldest_first[i];
+    for (i = 1; i < n_frames; i++) { /* insertion sort, n is at most 512 */
+        int16_t v = sorted[i];
+        int j;
+        for (j = i; j > 0 && sorted[j - 1] > v; j--) sorted[j] = sorted[j - 1];
+        sorted[j] = v;
+    }
+    median = sorted[n_frames / 2];
+    for (offset = 0; offset < period_frames; offset++) {
+        int64_t score = 0;
+        for (i = offset; i < n_frames; i += period_frames) {
+            int k, v = 0;
+            for (k = -1; k <= 1; k++) { /* one frame of jitter either side */
+                int at = i + k;
+                if (at >= 0 && at < n_frames && onset_oldest_first[at] - median > v)
+                    v = onset_oldest_first[at] - median;
+            }
+            score += (int64_t)v * (n_frames + 3 * i); /* newer beats weigh up to four times more */
+        }
+        total += score;
+        if (score > best) { best = score; best_offset = offset; }
+    }
+    if (best <= 0) return 0;
+    {
+        int64_t mean = total / period_frames;
+        int confidence = (int)(((best - mean) * 100) / best);
+        if (confidence < 0) confidence = 0;
+        if (confidence > 100) confidence = 100;
+        out->confidence = confidence;
+    }
+    last_idx = best_offset + ((n_frames - 1 - best_offset) / period_frames) * period_frames;
+    out->period_ms = period_ms;
+    out->last_beat_ms_ago = (n_frames - 1 - last_idx) * frame_ms;
+    return out->confidence;
+}
+
+/* The next beat on the caller's clock: the first beat time after now_ms, advancing by whole periods from the
+ * moment the phase was computed (computed_at_ms). Wrap safe. */
+static inline uint32_t mb_next_beat_ms(const mb_beat_t *b, uint32_t now_ms, uint32_t computed_at_ms) {
+    uint32_t elapsed, since, period, wait;
+    if (b == 0 || b->period_ms <= 0) return now_ms;
+    period = (uint32_t)b->period_ms;
+    elapsed = now_ms - computed_at_ms;
+    since = (uint32_t)b->last_beat_ms_ago + elapsed;
+    wait = period - (since % period);
+    return now_ms + wait;
+}
+
+#endif
diff --git a/firmware/main/hal/maipai_music.cc b/firmware/main/hal/maipai_music.cc
new file mode 100644
--- /dev/null
+++ b/firmware/main/hal/maipai_music.cc
@@ -0,0 +1,470 @@
+/*
+ * SPDX-License-Identifier: MIT
+ *
+ * Music dance on the unit (patch V03). The audio input task hands every chunk it reads from the codec (24 kHz, two
+ * channels, before the 16 kHz resampler) to maipai_music_tap. The tap looks at channel 0 only and runs the sample
+ * level front end of maipai_music_core.h; a small low-priority worker (PSRAM stack and history) turns the frames into
+ * a few numbers once a second (level, tempo, flatness, speech-like modulation, pauses). No audio leaves the unit and
+ * none is kept: only those numbers, and only as the plain C judge's verdict.
+ *
+ * With Home reachable the unit sends the numbers as "music_feat" events and the host decides. With the link down the
+ * unit decides itself with the same judge (maipai_music_judge.h, tested equal to the host's): a nod with a happy
+ * face, a head bob on the beat, then the dance that sways on the song's beat (beat_sway.h), a slow mood between
+ * blocks, and a stop when the music stops. Never while muted, in full quiet, listening, speaking, or on a low battery.
+ * The unit never hears itself: the tap is told to stand still while it listens, speaks or plays (and 1.5 s after).
+ */
+#include "maipai_music.h"
+
+#if CONFIG_MAIPAI_MUSIC_DANCE
+
+#include <algorithm>
+#include <atomic>
+#include <cstdint>
+#include <cstdio>
+#include <cstring>
+#include <string>
+#include <esp_heap_caps.h>
+#include <esp_log.h>
+#include <esp_timer.h>
+#include <freertos/FreeRTOS.h>
+#include <freertos/queue.h>
+#include <freertos/task.h>
+#include <mcp_server.h>
+#include <nvs.h>
+#include <nvs_flash.h>
+#include <application.h>
+#include "board/hal_bridge.h"
+#include "device_events.h"
+#include "hal.h"
+#include "maipai_privacy.h"
+#include "maipai_music_core.h"
+#include "maipai_music_judge.h"
+#include "maipai_music_mood_core.h"
+#include "maipai_beat.h"
+
+void maipai_music_dance_start();
+void maipai_music_dance_stop();
+void maipai_music_bob_start();
+
+static const char* TAG = "MAIPAI-MUSIC";
+
+namespace {
+
+constexpr int kGateRms = 400;     // the room must be this loud (int16 RMS, channel 0); a quiet room is 80 to 110
+constexpr int kChunkMax = 480;    // samples per pass through the front end: at most 2 frames
+constexpr int kQueueDepth = 16;   // 0.3 s of frames
+constexpr const char* kNvsNamespace = "mp_music";  // its own namespace, never the websocket one
+constexpr const char* kNvsKey = "on";
+
+struct Msg {
+    mm_frame_t frame;
+    uint8_t reset;  // 1: forget the history (the unit spoke, listened or was muted)
+};
+
+mm_front_t s_front;
+bool s_front_ready = false;
+int s_front_rate = 0;
+bool s_was_suppressed = true;
+QueueHandle_t s_queue = nullptr;
+mm_an_t* s_an = nullptr;
+std::atomic<bool> s_enabled{false};  // the host's switch (self.music.set); off at boot until the saved choice says on
+std::atomic<uint32_t> s_beat_period_ms{0};
+std::atomic<uint32_t> s_beat_ref_ms{0};
+std::atomic<uint32_t> s_beat_pub_ms{0};
+std::atomic<int> s_beat_conf{0};
+std::atomic<uint32_t> s_dropped{0};
+std::atomic<uint32_t> s_suppressed_chunks{0};
+std::atomic<int> s_state{0};          // the offline session state, for self.music.get_status (0 idle .. 4 slow mood)
+std::atomic<uint32_t> s_dances{0};    // dances started offline since boot
+std::atomic<int> s_last_bpm{0};
+
+// The beat of the song: from the last 6 s of onset frames and the tempo estimate, find where the beats fall and
+// publish the period and the time of a recent beat for the dance (beat_sway.h). A steady grid: the tempo is the median
+// of the last 8 folded estimates, a beat needs most of them to agree, and the phase is nudged toward each new
+// measurement instead of jumping to it.
+void publish_beat(const mm_feat_t& f, uint32_t now_ms)
+{
+    static uint32_t period_hist[8] = {};
+    static int hist_n = 0, hist_head = 0;
+    static bool grid_valid = false;
+    static uint32_t grid_ref = 0, grid_period = 0;
+    const int n = s_an->count;
+    if (f.bpm <= 0 || f.tc < 12 || n < MM_MIN_FRAMES) {
+        s_beat_conf.store(0);
+        grid_valid = false;
+        return;
+    }
+    period_hist[hist_head] = static_cast<uint32_t>(60000 / mb_fold_bpm(f.bpm));
+    hist_head = (hist_head + 1) % 8;
+    if (hist_n < 8) {
+        ++hist_n;
+    }
+    uint32_t sorted[8];
+    for (int i = 0; i < hist_n; ++i) {
+        sorted[i] = period_hist[i];
+    }
+    for (int i = 1; i < hist_n; ++i) {
+        const uint32_t v = sorted[i];
+        int k = i;
+        for (; k > 0 && sorted[k - 1] > v; --k) {
+            sorted[k] = sorted[k - 1];
+        }
+        sorted[k] = v;
+    }
+    const uint32_t median = sorted[hist_n / 2];
+    int agree = 0;
+    for (int i = 0; i < hist_n; ++i) {
+        const uint32_t d = period_hist[i] > median ? period_hist[i] - median : median - period_hist[i];
+        if (d * 100 <= median * 6) {
+            ++agree;
+        }
+    }
+    if (hist_n < 4 || agree < 4 || median < 250) {
+        s_beat_conf.store(0);
+        grid_valid = false;
+        return;
+    }
+    int16_t onset[MM_RING];
+    for (int i = 0; i < n; ++i) {
+        onset[n - 1 - i] = s_an->onset[mm_ring_at(s_an, i)];  // oldest first
+    }
+    mb_beat_t beat;
+    const int conf = mb_phase(onset, n, 1000 / MM_FPS, static_cast<int>(60000 / median), &beat);
+    if (conf < 25 || beat.period_ms <= 0) {
+        if (!grid_valid || now_ms - s_beat_pub_ms.load() > 3000) {
+            s_beat_conf.store(0);
+        }
+        return;  // a weak second keeps the grid already published
+    }
+    const uint32_t measured_ref = now_ms - static_cast<uint32_t>(beat.last_beat_ms_ago);
+    if (!grid_valid) {
+        grid_ref = measured_ref;
+        grid_period = static_cast<uint32_t>(beat.period_ms);
+        grid_valid = true;
+    } else {
+        const int32_t period = static_cast<int32_t>(grid_period);
+        int32_t d = static_cast<int32_t>(measured_ref - grid_ref) % period;
+        if (d > period / 2) {
+            d -= period;
+        } else if (d < -period / 2) {
+            d += period;
+        }
+        grid_ref += static_cast<uint32_t>(d * 3 / 10);
+        grid_period = (grid_period * 7 + static_cast<uint32_t>(beat.period_ms) * 3) / 10;
+    }
+    s_beat_period_ms.store(grid_period);
+    s_beat_ref_ms.store(grid_ref);
+    s_beat_conf.store(conf >= 30 ? conf : 30);
+    s_beat_pub_ms.store(now_ms);
+}
+
+void set_face(int idx)
+{
+    hal_bridge::react_face(MMM_FACES[idx], 4000);
+}
+
+// The unit's own music session while Home is unreachable: the nod, the dance 15 s later, a dance block (5 minutes
+// charging, 2 on battery), a 90 s slow mood, the dance again, for as long as the music goes on; a gap of 60 s ends it.
+void offline_music_step(const mm_feat_t& f)
+{
+    static mmj_session_t session;
+    static bool initialized = false;
+    static bool dancing = false;
+    static uint32_t nod_ms = 0;
+    static int face = -1;
+    if (!initialized) {
+        mmj_session_init(&session);
+        initialized = true;
+    }
+    auto stop_all = [&](const char* why) {
+        if (dancing) {
+            maipai_music_dance_stop();
+            dancing = false;
+        }
+        face = -1;
+        s_state.store(0);
+        ESP_LOGI(TAG, "offline music: end (%s)", why);
+        mmj_session_init(&session);
+    };
+    if (hal_bridge::hub_link_up()) {
+        if (dancing || session.state != 0) {
+            stop_all("hub link up");  // the host decides while Home is reachable
+        }
+        return;
+    }
+    if (!s_enabled.load()) {
+        if (dancing || session.state != 0) {
+            stop_all("features off");
+        }
+        return;
+    }
+    const DeviceState state = Application::GetInstance().GetDeviceState();
+    const bool busy = state == kDeviceStateListening || state == kDeviceStateSpeaking ||
+                      state == kDeviceStateConnecting || state == kDeviceStateUpgrading ||
+                      state == kDeviceStateAudioTesting;
+    int battery = 100;
+    bool charging = false, on_cable = false;
+    if (!hal_bridge::board_battery_state(&battery, &charging, &on_cable)) {
+        battery = 100;
+    }
+    charging = charging || on_cable;
+    if (maipai_muted() || maipai_quiet() || busy || (!charging && battery < 20)) {
+        if (dancing || session.state != 0) {
+            stop_all("safety gate");
+        }
+        return;
+    }
+    if (dancing && !charging && battery < 40) {
+        stop_all("battery below dance threshold");
+        return;
+    }
+    const uint32_t now_ms = static_cast<uint32_t>(esp_timer_get_time() / 1000);
+    mmj_session_set_block_ms(&session, charging ? MMJ_BLOCK_USB_MS : MMJ_BLOCK_BATTERY_MS);
+    mmj_feat_t input = {f.lv, f.bpm, f.tc, f.fl, f.mo, f.ps, 0};
+    const mmj_verdict_t verdict = mmj_judge(&input, MMJ_SENS_MEDIUM, session.state != 0);
+    const mmj_action_t action = mmj_session_step(&session, now_ms, verdict.music);
+    s_state.store(session.state);
+    if (action == MMJ_ACTION_NOD) {
+        ESP_LOGI(TAG, "offline music: nod");
+        nod_ms = now_ms;
+        face = mmm_face(f.bpm, f.lv, 0);
+        set_face(face);
+        if (!dancing) {
+            maipai_music_bob_start();  // nodding on the beat for a while before the full dance
+            dancing = true;
+        }
+    } else if (action == MMJ_ACTION_DANCE) {
+        if (charging || battery >= 40) {
+            maipai_music_dance_start();
+            dancing = true;
+            s_dances.fetch_add(1);
+            ESP_LOGI(TAG, "offline music: dance");
+        }
+    } else if (action == MMJ_ACTION_BREAK) {
+        // The slow mood between dance blocks: the gentle sway goes on until the next full dance.
+        if (!dancing && (charging || battery >= 40)) {
+            maipai_music_dance_start();
+            dancing = true;
+        }
+        set_face(0);
+        face = 0;
+        ESP_LOGI(TAG, "offline music: slow mood");
+    } else if (action == MMJ_ACTION_PAUSE) {
+        if (dancing) {
+            maipai_music_dance_stop();
+            dancing = false;
+        }
+        ESP_LOGI(TAG, "offline music: paused, no music");
+    } else if (action == MMJ_ACTION_END) {
+        stop_all("music stopped");
+    } else if (dancing && verdict.music && session.state != 4) {
+        // The mood face follows the song: it changes only when the answer changes.
+        const int want = mmm_face(f.bpm, f.lv, (now_ms - nod_ms) / 1000);
+        if (want != face) {
+            face = want;
+            set_face(face);
+        }
+    }
+}
+
+void send_reset()
+{
+    Msg m{};
+    m.reset = 1;
+    if (xQueueSend(s_queue, &m, 0) != pdTRUE) {
+        s_dropped.fetch_add(1);
+    }
+}
+
+void worker_task(void*)
+{
+    Msg m;
+    int frames = 0;
+    while (true) {
+        if (xQueueReceive(s_queue, &m, pdMS_TO_TICKS(1000)) != pdTRUE) {
+            // No frames for a second: the tap stood still (muted, in quiet, listening, speaking) or the microphone is
+            // off. The session steps with "no music" so a dance ends, and the safety gates are checked again.
+            offline_music_step(mm_feat_t{});
+            continue;
+        }
+        if (m.reset) {
+            mm_an_reset(s_an);
+            frames = 0;
+            offline_music_step(mm_feat_t{});  // a switch off, a mute or the unit's own sound: lets the session end
+            continue;
+        }
+        mm_an_push(s_an, &m.frame);
+        if (++frames % MM_FPS != 0) {
+            continue;
+        }
+        mm_feat_t f;
+        mm_summarize(s_an, &f);
+        if (!f.valid) {
+            continue;
+        }
+        const uint32_t now_ms = static_cast<uint32_t>(esp_timer_get_time() / 1000);
+        s_last_bpm.store(f.bpm);
+        offline_music_step(f);
+        publish_beat(f, now_ms);
+        if (f.lv >= kGateRms && hal_bridge::hub_link_up() && !maipai_muted()) {
+            char extra[128];
+            snprintf(extra, sizeof(extra),
+                     "\"lv\":%d,\"b0\":%d,\"b1\":%d,\"b2\":%d,\"b3\":%d,\"bpm\":%d,\"tc\":%d,\"fl\":%d,"
+                     "\"zc\":%d,\"zs\":%d,\"mo\":%d,\"ps\":%d,\"on\":%d",
+                     f.lv, f.b[0], f.b[1], f.b[2], f.b[3], f.bpm, f.tc, f.fl, f.zc, f.zs, f.mo, f.ps, f.on);
+            device_events_push("music_feat", extra);
+        }
+    }
+}
+
+bool nvs_enabled()
+{
+    nvs_handle_t h;
+    uint8_t v = 0;
+    if (nvs_open(kNvsNamespace, NVS_READONLY, &h) == ESP_OK) {
+        if (nvs_get_u8(h, kNvsKey, &v) != ESP_OK) {
+            v = 0;
+        }
+        nvs_close(h);
+    }
+    return v == 1;
+}
+
+void set_enabled(bool enabled, bool persist)
+{
+    const bool was = s_enabled.exchange(enabled);
+    if (!enabled && was) {
+        s_was_suppressed = true;  // the next "on" starts from a clean history
+        s_front_ready = false;
+        if (s_queue != nullptr) {
+            send_reset();
+        }
+    }
+    if (persist && was != enabled) {
+        nvs_handle_t h;
+        if (nvs_open(kNvsNamespace, NVS_READWRITE, &h) == ESP_OK) {
+            nvs_set_u8(h, kNvsKey, enabled ? 1 : 0);
+            nvs_commit(h);
+            nvs_close(h);
+        }
+    }
+    ESP_LOGI(TAG, "music features %s", enabled ? "on" : "off");
+}
+
+}  // namespace
+
+// The beat of the song for the dance (beat_sway.h): true while a beat was measured in the last 3 seconds with a
+// confidence of at least 30. Both numbers are on the esp_timer millisecond clock.
+bool maipai_beat_get(uint32_t* period_ms, uint32_t* ref_ms)
+{
+    const uint32_t now = static_cast<uint32_t>(esp_timer_get_time() / 1000);
+    if (s_beat_conf.load() < 30 || now - s_beat_pub_ms.load() > 3000 || s_beat_period_ms.load() == 0) {
+        return false;
+    }
+    *period_ms = s_beat_period_ms.load();
+    *ref_ms = s_beat_ref_ms.load();
+    return true;
+}
+
+// One atomic read for the audio input task: whether the features are on and ready.
+bool maipai_music_active()
+{
+    return s_enabled.load() && s_queue != nullptr;
+}
+
+// Called by the audio input task for every chunk read from the codec. `suppress` is true while the unit listens, speaks
+// or played in the last 1.5 s. Never allocates, logs or does JSON.
+void maipai_music_tap(const int16_t* interleaved, size_t frames, int channels, int sample_rate, bool suppress)
+{
+    if (!s_enabled.load() || s_queue == nullptr || interleaved == nullptr || channels < 1 || sample_rate < 8000) {
+        return;  // switched off: no analysis, no event, nothing counted
+    }
+    if (suppress || maipai_muted() || maipai_quiet()) {
+        s_suppressed_chunks.fetch_add(1);
+        if (!s_was_suppressed) {
+            s_was_suppressed = true;
+            s_front_ready = false;
+            send_reset();
+        }
+        return;
+    }
+    if (s_was_suppressed || !s_front_ready || s_front_rate != sample_rate) {
+        mm_front_init(&s_front, sample_rate);
+        s_front_ready = true;
+        s_front_rate = sample_rate;
+        s_was_suppressed = false;
+        send_reset();
+    }
+    mm_frame_t out[4];
+    size_t done = 0;
+    while (done < frames) {
+        const int n = static_cast<int>(std::min<size_t>(kChunkMax, frames - done));
+        const int got = mm_front_feed(&s_front, interleaved + done * channels, n, channels, out);
+        for (int i = 0; i < got; ++i) {
+            Msg m{};
+            m.frame = out[i];
+            if (xQueueSend(s_queue, &m, 0) != pdTRUE) {
+                s_dropped.fetch_add(1);
+            }
+        }
+        done += n;
+    }
+}
+
+void maipai_music_init()
+{
+    if (s_queue != nullptr) {
+        return;
+    }
+    s_an = static_cast<mm_an_t*>(heap_caps_calloc(1, sizeof(mm_an_t), MALLOC_CAP_SPIRAM));
+    s_queue = xQueueCreate(kQueueDepth, sizeof(Msg));
+    if (s_an == nullptr || s_queue == nullptr) {
+        ESP_LOGE(TAG, "no memory for the music features; the feature is off");
+        if (s_an != nullptr) {
+            heap_caps_free(s_an);
+            s_an = nullptr;
+        }
+        s_queue = nullptr;  // (a created queue is kept: the call is made once, at boot)
+        return;
+    }
+    // The worker's stack is in PSRAM, and a task on a PSRAM stack must never read flash (the cache is off during a
+    // flash read: the assert in spi_flash_disable_interrupts_caches_and_other_cpu fires). The saved privacy choice is
+    // read from flash lazily on its first use, so read it here, on this task's internal stack, before the worker runs.
+    (void)maipai_muted();
+    xTaskCreatePinnedToCoreWithCaps(worker_task, "musicfeat", 4096, nullptr, 1, nullptr, 1, MALLOC_CAP_SPIRAM);
+    ESP_LOGI(TAG, "music dance ready: %u byte history in PSRAM, gate rms %d", static_cast<unsigned>(sizeof(mm_an_t)),
+             kGateRms);
+    set_enabled(nvs_enabled(), false);  // off at boot unless the host last turned it on
+    McpServer::GetInstance().AddTool(
+        "self.music.set",
+        "Turn the on-unit music features on or off. Off by default; the unit analyses the room's sound only while on, "
+        "never while muted or in full quiet or while it listens or speaks. With Home reachable it sends numbers (never "
+        "audio) and the host decides; without Home it nods and dances to the beat itself. Answers the new state.",
+        PropertyList({Property("enabled", kPropertyTypeBoolean)}), [](const PropertyList& properties) -> ReturnValue {
+            const bool on = properties["enabled"].value<bool>();
+            set_enabled(on, true);
+            return std::string(on ? R"({"ok":true,"enabled":true})" : R"({"ok":true,"enabled":false})");
+        });
+    McpServer::GetInstance().AddTool(
+        "self.music.get_status",
+        "What the on-unit music features are doing: enabled, the offline session state (idle, nod, dance, paused, slow "
+        "mood), the last tempo heard, the beat period when one is held, dances started offline since boot, and the "
+        "frames dropped or skipped while the unit heard itself.",
+        PropertyList(), [](const PropertyList&) -> ReturnValue {
+            static const char* const kStates[] = {"idle", "nod", "dance", "paused", "slow_mood"};
+            const int st = s_state.load();
+            uint32_t period = 0, ref = 0;
+            const bool beat = maipai_beat_get(&period, &ref);
+            char out[256];
+            snprintf(out, sizeof(out),
+                     "{\"ok\":true,\"enabled\":%s,\"state\":\"%s\",\"bpm\":%d,\"beat_ms\":%u,\"dances\":%u,"
+                     "\"dropped\":%u,\"suppressed\":%u,\"link\":%s}",
+                     s_enabled.load() ? "true" : "false", kStates[st >= 0 && st <= 4 ? st : 0], s_last_bpm.load(),
+                     beat ? static_cast<unsigned>(period) : 0u, static_cast<unsigned>(s_dances.load()),
+                     static_cast<unsigned>(s_dropped.load()), static_cast<unsigned>(s_suppressed_chunks.load()),
+                     hal_bridge::hub_link_up() ? "true" : "false");
+            return std::string(out);
+        });
+}
+
+#endif  // CONFIG_MAIPAI_MUSIC_DANCE
