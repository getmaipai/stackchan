+
 bool AudioService::ReadAudioData(std::vector<int16_t>& data, int sample_rate, int samples) {
     if (maipai_mic_blocked()) {
         // Muted or in full quiet (patch 107): nothing reads the microphone and nothing is fed to the wake word.
@@ -203,12 +209,31 @@
         esp_timer_start_periodic(audio_power_timer_, AUDIO_POWER_CHECK_INTERVAL_MS * 1000);
         codec_->EnableInput(true);
     }
+
+#if CONFIG_MAIPAI_MUSIC_DANCE
+    // The unit must not hear itself: no music features while it listens (the audio processor runs), while anything
+    // waits to play or played in the last 1.5 s (speech, tones). Nothing in the chunk changes. Not reached while
+    // muted or in full quiet: ReadAudioData returned above (patch 107).
+    auto music_tap = [this](const std::vector<int16_t>& chunk) {
