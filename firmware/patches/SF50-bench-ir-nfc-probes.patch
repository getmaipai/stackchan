+config MAIPAI_BENCH_IR
+    bool "Bench only: probes for the internal bus, the NFC chip and the infrared receiver"
+    depends on MAIPAI_SERIAL_TOOLS
+    default n
+    help
+        self.bench.i2c_scan, self.bench.nfc_probe and self.bench.ir_rx: read-only probes (an address scan, one identity register of the NFC
+        chip, the infrared receiver pin as an input). Nothing is transmitted. Off in every shipped image: no tool, no code.
+
+config MAIPAI_BENCH_IR_TX
