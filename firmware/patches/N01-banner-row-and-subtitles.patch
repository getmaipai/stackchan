+/*
+ * SPDX-License-Identifier: MIT
+ *
+ * The banner row (patch N01): the one place for information, a rounded row at the top of the screen. Logic and geometry:
+ * maipai_banner_core.h. Every post is safe from any task and takes no LVGL lock: it only changes the queue; the row is drawn by
+ * its own LVGL timer. Nothing informational is drawn over the mouth or the lower half of the screen.
+ */
+#pragma once
+
+#include <lvgl.h>
+#include <stdint.h>
+
+#include "maipai_banner_core.h"
+#include "maipai_subtitles.h"
+
+struct maipai_banner_status_t {
+    int battery_level = -1;  // percent, -1 unknown
+    bool charging     = false;
+    bool on_cable     = false;
+    int wifi_bars     = 4;   // 0 to 4
+    bool wifi_up      = true;
+    bool hub_up       = true;
+    bool mic_live     = false;
+};
+
+// Starts the timer; the row and the strip are built on the top layer when something shows. LVGL lock held. fg gives the face's
+// foreground color (it follows the face's color setting); poll (optional) is read every 2 s for the strip.
+void maipai_banner_attach(lv_color_t (*fg)(), void (*poll)(maipai_banner_status_t*));
+// A message. prio: MB_PRIO_*, tag: MB_TAG_*, hold_ms 0 = until cleared.
+void maipai_banner_post(const char* text, int icon, int prio, int tag, uint32_t hold_ms);
+void maipai_banner_clear_tag(int tag);
+// The remote session chip (violet, steady) while a controller is connected.
+void maipai_banner_session(bool on, const char* label);
+// A strip glyph on or off (MB_FLAG_*); hold_ms > 0 ends it by itself.
+void maipai_banner_flag(int flag, bool on, uint32_t hold_ms);
+// "Top bar" setting: MB_BAR_HIDDEN (default) or MB_BAR_ALWAYS.
+void maipai_banner_set_bar_mode(int mode);
+// "Captions" setting: MB_CAP_OFF, MB_CAP_SUBTITLES (the strip at the bottom, the default when on) or MB_CAP_BANNER (the row).
+// The avatar's words (setSpeech) are routed accordingly; an empty text means the robot stopped talking.
+void maipai_banner_set_captions(int mode);
+int maipai_banner_captions();
+// While true the words are shown as still subtitles whatever the mode says (the Wi-Fi setup hint must stay readable).
+void maipai_banner_bypass(bool on);
+// True while the row (or a chip) is on screen (for the tests and the bench).
+bool maipai_banner_visible();
+// One timer step (the host renderer calls it by hand; on the unit the LVGL timer does).
+void maipai_banner_step();
