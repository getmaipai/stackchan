index 0000000..f9d9686
--- /dev/null
+++ b/firmware/main/hal/maipai_banner_core.h
@@ -0,0 +1,453 @@
+/*
+ * SPDX-License-Identifier: MIT
+ *
+ * The banner row (patch N01) and the fixed zones of the screen. Pure logic, no LVGL: the message queue with priorities and a
+ * minimum display time, the session chip, the small icon strip, the marquee offset, and the geometry the settings page preview
+ * shares (host/maipai_body/banner_table.json is what this file prints).
+ *
+ * The screen has three fixed zones and nothing moves between them (owner decision 2026-11-16): the banner zone (y 0 to 28,
+ * reserved even when empty), the face zone (y 28 to 184) and the subtitle zone (y 184 to 240). The banner row is ONE rectangle:
+ * the same x, y, width, height and corner radius for every message; only what is inside changes (icon left, text, strip right).
+ * A text longer than its text area scrolls (marquee); a short one never shrinks the row. The row fades in and out at full width.
+ *
+ *  - a message has a text, an icon, a priority (privacy and remote cues first, then notices, then captions), a tag (a new
+ *    message with the same tag and priority replaces the old one in place, so "Volume 40" never queues behind "Volume 30")
+ *    and a hold time (0: until cleared);
+ *  - a message shows at least MB_MIN_MS; a more urgent one waits for that and then takes the row, the one it displaced is
+ *    queued again; captions never queue behind anything but the one caption slot (the newest wins);
+ *  - while a remote session is on and no message shows, the row shows the session chip inside the row (steady, never blinking);
+ *    a heartbeat renewal changes nothing (no redraw);
+ *  - the strip holds small glyphs: the cues that must always show (mic live, camera on, remote) and battery or Wi-Fi only
+ *    when something is wrong (or always, when the owner chose "show battery and Wi-Fi always").
+ * Nothing here allocates. Times are milliseconds from any steady clock; 32-bit wrap is handled.
+ */
+#ifndef MAIPAI_BANNER_CORE_H
+#define MAIPAI_BANNER_CORE_H
+
+#include <stddef.h>
+#include <stdint.h>
+#include <string.h>
+
+/* ---- the zones and the row (pixels on the 320 by 240 screen) ---- */
+#define MB_SCREEN_W 320
+#define MB_SCREEN_H 240
+#define MB_ZONE_BANNER_Y0 0
+#define MB_ZONE_BANNER_Y1 28
+#define MB_ZONE_FACE_Y0 28
+#define MB_ZONE_FACE_Y1 184
+#define MB_ZONE_SUB_Y0 184
+#define MB_ZONE_SUB_Y1 240
+#define MB_ROW_X 4
+#define MB_ROW_Y 1
+#define MB_ROW_W 312
+#define MB_ROW_H 26
+#define MB_ROW_R 13
+#define MB_PAD_X 8
+#define MB_ICON_W 22     /* the leading icon box */
+#define MB_STRIP_GLYPH_W 20
+#define MB_STRIP_GAP 4
+#define MB_FADE_MS 150   /* the row fades in and out at full width */
+#define MB_FONT_PX 14
+
+#define MB_TEXT_MAX 120
+#define MB_QUEUE 4
+#define MB_MIN_MS 1500u
+#define MB_MAX_HOLD_MS 20000u
+#define MB_SCROLL_PX_S 36
+#define MB_SCROLL_PAUSE_MS 900u
+
+enum { MB_PRIO_PRIVACY = 0, MB_PRIO_NOTICE = 1, MB_PRIO_CAPTION = 2 };
+enum {
+    MB_ICON_NONE = 0,
+    MB_ICON_REMOTE,
+    MB_ICON_CHECK,
+    MB_ICON_BATTERY,
+    MB_ICON_WIFI_OFF,
+    MB_ICON_BARS,
+    MB_ICON_RING,
+    MB_ICON_SPEECH,
+    MB_ICON_KEY,
+    MB_ICON_COUNT
+};
+enum { MB_TAG_NONE = 0, MB_TAG_CAPTION, MB_TAG_VOLUME, MB_TAG_SAY, MB_TAG_CUE, MB_TAG_FIND, MB_TAG_LINK, MB_TAG_GAME };
+enum { MB_FLAG_MIC = 0, MB_FLAG_CAMERA, MB_FLAG_REMOTE, MB_FLAG_BATTERY, MB_FLAG_WIFI, MB_FLAG_COUNT };
+enum { MB_FIT_ONE = 0, MB_FIT_MARQUEE };
+enum { MB_BAR_HIDDEN = 0, MB_BAR_ALWAYS = 1 }; /* the "Top bar" setting */
+
+#define MB_FLAG_ALWAYS_ON ((1u << MB_FLAG_MIC) | (1u << MB_FLAG_CAMERA) | (1u << MB_FLAG_REMOTE)) /* privacy cues: never hidden */
+
+typedef struct {
+    char text[MB_TEXT_MAX];
+    uint8_t icon;
+    uint8_t prio;
+    uint8_t tag;
+    uint8_t sticky;   /* shown until cleared */
+    uint32_t hold_ms; /* meaningful when not sticky */
+} mb_msg_t;
+
+typedef struct {
+    mb_msg_t cur;
+    uint8_t has_cur;
+    uint32_t shown_ms;
+    uint32_t until_ms;
+    mb_msg_t q[MB_QUEUE];
+    uint8_t nq;
+    uint8_t session;
+    char session_label[24];
+    uint32_t strip;                  /* bit per MB_FLAG_* */
+    uint32_t strip_until[MB_FLAG_COUNT]; /* 0: no expiry */
+    uint8_t bar_mode;
+    uint32_t rev;                    /* bumps on every visible change: the drawing runs only then */
+} mb_t;
+
+static inline int mb_due(uint32_t now, uint32_t at) { return (int32_t)(now - at) >= 0; }
+
+static inline void mb_init(mb_t* b)
+{
+    memset(b, 0, sizeof(*b));
+}
+
+static inline void mb_copy_text(char* dst, const char* src)
+{
+    size_t n = src != NULL ? strlen(src) : 0;
+    if (n >= MB_TEXT_MAX) n = MB_TEXT_MAX - 1;
+    if (n > 0) memcpy(dst, src, n);
+    dst[n] = '\0';
+}
+
+static inline void mb_show(mb_t* b, const mb_msg_t* m, uint32_t now)
+{
+    b->cur = *m;
+    b->has_cur = 1;
+    b->shown_ms = now;
+    if (m->sticky) {
+        b->until_ms = 0;
+    } else {
+        uint32_t hold = m->hold_ms < MB_MIN_MS ? MB_MIN_MS : m->hold_ms;
+        if (hold > MB_MAX_HOLD_MS) hold = MB_MAX_HOLD_MS;
+        b->until_ms = now + hold;
+    }
+    b->rev++;
+}
+
+static inline int mb_q_worst(const mb_t* b) /* the index of the entry to drop: the lowest priority, the oldest of those */
+{
+    int w = 0;
+    for (int i = 1; i < b->nq; i++) {
+        if (b->q[i].prio > b->q[w].prio) w = i;
+    }
+    return w;
+}
+
+static inline void mb_q_remove(mb_t* b, int i)
+{
+    for (int k = i; k + 1 < b->nq; k++) b->q[k] = b->q[k + 1];
+    b->nq--;
+}
+
+static inline void mb_q_push_front(mb_t* b, const mb_msg_t* m)
+{
+    if (b->nq >= MB_QUEUE) b->nq = MB_QUEUE - 1; /* the oldest tail entry makes room */
+    for (int k = b->nq; k > 0; k--) b->q[k] = b->q[k - 1];
+    b->q[0] = *m;
+    b->nq++;
+}
+
+/* Posts a message. Returns 1 when it shows now or waits in the queue, 0 when it was dropped (queue full of more urgent ones). */
+static inline int mb_post(mb_t* b, uint32_t now, const char* text, int icon, int prio, int tag, uint32_t hold_ms)
+{
+    if (text == NULL || text[0] == '\0') return 0;
+    mb_msg_t m;
+    memset(&m, 0, sizeof(m));
+    mb_copy_text(m.text, text);
+    m.icon = (uint8_t)(icon >= 0 && icon < MB_ICON_COUNT ? icon : MB_ICON_NONE);
+    m.prio = (uint8_t)(prio < 0 ? 0 : (prio > MB_PRIO_CAPTION ? MB_PRIO_CAPTION : prio));
+    m.tag = (uint8_t)tag;
+    m.sticky = hold_ms == 0 ? 1 : 0;
+    m.hold_ms = hold_ms;
+    /* the same tag and priority: replace in place (a refresh of the same words only extends the hold) */
+    if (m.tag != MB_TAG_NONE) {
+        if (b->has_cur && b->cur.tag == m.tag && b->cur.prio == m.prio) {
+            const int same = strcmp(b->cur.text, m.text) == 0 && b->cur.icon == m.icon;
+            const uint32_t shown = b->shown_ms;
+            mb_show(b, &m, now);
+            if (same) b->shown_ms = shown; /* keeps the marquee where it is */
+            else b->shown_ms = now;
+            return 1;
+        }
+        for (int i = 0; i < b->nq; i++) {
+            if (b->q[i].tag == m.tag && b->q[i].prio == m.prio) {
+                b->q[i] = m;
+                return 1;
+            }
+        }
+    }
+    if (!b->has_cur) {
+        mb_show(b, &m, now);
+        return 1;
+    }
+    if (m.prio == MB_PRIO_CAPTION && b->cur.prio == MB_PRIO_CAPTION) { /* the newest caption wins */
+        mb_show(b, &m, now);
+        return 1;
+    }
+    if (m.prio < b->cur.prio && (uint32_t)(now - b->shown_ms) >= MB_MIN_MS) { /* more urgent, and the minimum time is up */
+        if (!b->cur.sticky && b->cur.prio != MB_PRIO_CAPTION && !mb_due(now, b->until_ms)) {
+            mb_msg_t old = b->cur;
+            old.hold_ms = b->until_ms - now;
+            mb_q_push_front(b, &old);
+        }
+        mb_show(b, &m, now);
+        return 1;
+    }
+    if (b->nq >= MB_QUEUE) {
+        const int w = mb_q_worst(b);
+        if (b->q[w].prio < m.prio) return 0;
+        mb_q_remove(b, w);
+    }
+    b->q[b->nq++] = m;
+    return 1;
+}
+
+/* Clears the messages with this tag: the showing one ends once its minimum time is up (at once when sticky), queued ones go. */
+static inline int mb_clear_tag(mb_t* b, uint32_t now, int tag)
+{
+    int changed = 0;
+    for (int i = b->nq - 1; i >= 0; i--) {
+        if (b->q[i].tag == tag) {
+            mb_q_remove(b, i);
+            changed = 1;
+        }
+    }
+    if (b->has_cur && b->cur.tag == tag) {
+        if ((uint32_t)(now - b->shown_ms) >= MB_MIN_MS || b->cur.sticky) {
+            b->has_cur = 0;
+            b->rev++;
+        } else {
+            b->cur.sticky = 0;
+            b->until_ms = b->shown_ms + MB_MIN_MS;
+        }
+        changed = 1;
+    }
+    return changed;
+}
+
+/* The clock: expires the showing message, promotes the queue, lets a more urgent queued one take the row. 1 when the row changed. */
+static inline int mb_tick(mb_t* b, uint32_t now)
+{
+    const uint32_t before = b->rev;
+    for (int i = b->nq - 1; i >= 0; i--) { /* an entry whose own time ran out while it waited is stale */
+        if (!b->q[i].sticky && b->q[i].hold_ms == 0) mb_q_remove(b, i);
+    }
+    if (b->has_cur && !b->cur.sticky && mb_due(now, b->until_ms) && (uint32_t)(now - b->shown_ms) >= MB_MIN_MS) {
+        b->has_cur = 0;
+        b->rev++;
+    }
+    if (b->has_cur && b->nq > 0 && (uint32_t)(now - b->shown_ms) >= MB_MIN_MS) {
+        int best = -1;
+        for (int i = 0; i < b->nq; i++) {
+            if (b->q[i].prio < b->cur.prio && (best < 0 || b->q[i].prio < b->q[best].prio)) best = i;
+        }
+        if (best >= 0) {
+            mb_msg_t next = b->q[best];
+            mb_q_remove(b, best);
+            if (!b->cur.sticky && b->cur.prio != MB_PRIO_CAPTION && !mb_due(now, b->until_ms)) {
+                mb_msg_t old = b->cur;
+                old.hold_ms = b->until_ms - now;
+                mb_q_push_front(b, &old);
+            }
+            mb_show(b, &next, now);
+        }
+    }
+    if (!b->has_cur && b->nq > 0) {
+        int best = 0;
+        for (int i = 1; i < b->nq; i++) {
+            if (b->q[i].prio < b->q[best].prio) best = i;
+        }
+        mb_msg_t next = b->q[best];
+        mb_q_remove(b, best);
+        mb_show(b, &next, now);
+    }
+    for (int f = 0; f < MB_FLAG_COUNT; f++) { /* strip glyphs with an expiry */
+        if ((b->strip & (1u << f)) && b->strip_until[f] != 0 && mb_due(now, b->strip_until[f])) {
+            b->strip &= ~(1u << f);
+            b->strip_until[f] = 0;
+            b->rev++;
+        }
+    }
+    return b->rev != before;
+}
+
+/* ---- the session chip ---- */
+/* A heartbeat renewal (the same state, the same label) changes nothing and never bumps rev, so the row is not redrawn. */
+static inline void mb_session(mb_t* b, int on, const char* label)
+{
+    char text[24];
+    if (label == NULL || label[0] == '\0' || strcmp(label, "remote") == 0) {
+        text[0] = '\0'; /* the controller has no name of its own: the chip says only "Remote connected" */
+    } else {
+        size_t n = strlen(label);
+        if (n > 20) n = 20;
+        memcpy(text, label, n);
+        text[n] = '\0';
+    }
+    const uint8_t was = b->session;
+    b->session = on ? 1 : 0;
+    if (on && strcmp(text, b->session_label) != 0) {
+        strcpy(b->session_label, text);
+        b->rev++;
+    }
+    if (was != b->session) b->rev++;
+    const uint32_t bit = 1u << MB_FLAG_REMOTE;
+    const uint32_t had = b->strip & bit;
+    if (on) b->strip |= bit;
+    else b->strip &= ~bit;
+    if (had != (b->strip & bit)) b->rev++;
+}
+
+/* What the row shows now: a message, the session chip, or nothing. kind 0 nothing, 1 message, 2 chip. */
+static inline int mb_content(const mb_t* b, const char** text_out, int* icon_out, int* prio_out)
+{
+    static char chip[48];
+    if (b->has_cur) {
+        *text_out = b->cur.text;
+        *icon_out = b->cur.icon;
+        *prio_out = b->cur.prio;
+        return 1;
+    }
+    if (b->session) {
+        strcpy(chip, "Remote connected");
+        if (b->session_label[0] != '\0') {
+            strcat(chip, ": ");
+            strncat(chip, b->session_label, sizeof(chip) - strlen(chip) - 1);
+        }
+        *text_out = chip;
+        *icon_out = MB_ICON_REMOTE;
+        *prio_out = MB_PRIO_PRIVACY;
+        return 2;
+    }
+    *text_out = "";
+    *icon_out = MB_ICON_NONE;
+    *prio_out = MB_PRIO_CAPTION;
+    return 0;
+}
+
+/* ---- the strip ---- */
+static inline void mb_flag(mb_t* b, int flag, int on, uint32_t now, uint32_t hold_ms)
+{
+    if (flag < 0 || flag >= MB_FLAG_COUNT) return;
+    const uint32_t bit = 1u << flag;
+    const int was = (b->strip & bit) != 0;
+    if (on) b->strip |= bit;
+    else b->strip &= ~bit;
+    b->strip_until[flag] = (on && hold_ms > 0) ? (now + hold_ms) | 1u : 0;
+    if (was != (on != 0)) b->rev++;
+}
+
+/* Battery: shown when under 20 percent and not charging, briefly after a cable goes in, or always when the owner chose so. */
+static inline int mb_battery_shown(int level, int charging, int on_cable, int bar_mode, int blip)
+{
+    if (level < 0) return 0;
+    if (bar_mode == MB_BAR_ALWAYS) return 1;
+    if (blip && charging) return 1;
+    return level < 20 && !charging && !on_cable;
+}
+
+static inline int mb_wifi_shown(int wifi_up, int hub_up, int bar_mode)
+{
+    if (bar_mode == MB_BAR_ALWAYS) return 1;
+    return !wifi_up || !hub_up;
+}
+
+/* The strip bits that show: the privacy cues always, the rest per the setting (the unit sets MB_FLAG_BATTERY and MB_FLAG_WIFI
+ * only when mb_battery_shown and mb_wifi_shown say so). */
+static inline uint32_t mb_strip_visible(const mb_t* b) { return b->strip; }
+
+static inline int mb_strip_count(uint32_t bits)
+{
+    int n = 0;
+    for (int i = 0; i < MB_FLAG_COUNT; i++) n += (bits >> i) & 1u;
+    return n;
+}
+
+static inline int mb_strip_w(uint32_t bits)
+{
+    const int n = mb_strip_count(bits);
+    return n == 0 ? 0 : n * MB_STRIP_GLYPH_W + (n - 1) * MB_STRIP_GAP;
+}
+
+/* ---- fitting and the marquee ---- */
+/* The room for the text in the row with this strip: the row is always the same; the strip takes its glyphs' width off the text. */
+static inline int mb_text_room(uint32_t strip_bits, int icon)
+{
+    int w = MB_ROW_W - 2 * MB_PAD_X - (icon != MB_ICON_NONE ? MB_ICON_W + 4 : 0);
+    const int s = mb_strip_w(strip_bits);
+    if (s > 0) w -= s + 6;
+    return w;
+}
+
+/* text_w: its width on one line. A text that fits shows as it is; a longer one scrolls. The row never changes size. */
+static inline int mb_fit(int text_w, int room) { return text_w <= room ? MB_FIT_ONE : MB_FIT_MARQUEE; }
+
+static inline uint32_t mb_marquee_pass_ms(int overflow_px)
+{
+    if (overflow_px <= 0) return 0;
+    return 2u * MB_SCROLL_PAUSE_MS + (uint32_t)overflow_px * 1000u / MB_SCROLL_PX_S;
+}
+
+/* How far the text has moved left, 0 to overflow_px, after t_ms on screen: waits, scrolls to the end, waits, then starts over. */
+static inline int mb_marquee_x(uint32_t t_ms, int overflow_px)
+{
+    if (overflow_px <= 0) return 0;
+    const uint32_t scroll = (uint32_t)overflow_px * 1000u / MB_SCROLL_PX_S;
+    const uint32_t period = 2u * MB_SCROLL_PAUSE_MS + scroll + 400u;
+    const uint32_t t = t_ms % period;
+    if (t < MB_SCROLL_PAUSE_MS) return 0;
+    if (t < MB_SCROLL_PAUSE_MS + scroll) return (int)((t - MB_SCROLL_PAUSE_MS) * (uint32_t)MB_SCROLL_PX_S / 1000u);
+    return overflow_px;
+}
+
+/* The fade of the row: 0 to 255, one step of dt_ms toward fully shown (visible) or gone. Always arrives. */
+static inline int mb_fade_step(int opa, int visible, uint32_t dt_ms)
+{
+    const int goal = visible ? 255 : 0;
+    int step = (int)((dt_ms > 100u ? 100u : dt_ms) * 255u / MB_FADE_MS);
+    if (step < 1) step = 1;
+    if (opa < goal) return opa + step > goal ? goal : opa + step;
+    if (opa > goal) return opa - step < goal ? goal : opa - step;
+    return opa;
+}
+
+/* ---- rectangles (x0, y0 inclusive, x1, y1 exclusive) for the layout test and the preview ---- */
+typedef struct {
+    int x0, y0, x1, y1;
+} mb_rect_t;
+
+static inline mb_rect_t mb_rect(int x0, int y0, int x1, int y1)
+{
+    mb_rect_t r = {x0, y0, x1, y1};
+    return r;
+}
+static inline mb_rect_t mb_zone_banner(void) { return mb_rect(0, MB_ZONE_BANNER_Y0, MB_SCREEN_W, MB_ZONE_BANNER_Y1); }
+static inline mb_rect_t mb_zone_face(void) { return mb_rect(0, MB_ZONE_FACE_Y0, MB_SCREEN_W, MB_ZONE_FACE_Y1); }
+static inline mb_rect_t mb_zone_sub(void) { return mb_rect(0, MB_ZONE_SUB_Y0, MB_SCREEN_W, MB_ZONE_SUB_Y1); }
+/* The row: the same rectangle for every message, every chip and every length of text. */
+static inline mb_rect_t mb_row_rect(void) { return mb_rect(MB_ROW_X, MB_ROW_Y, MB_ROW_X + MB_ROW_W, MB_ROW_Y + MB_ROW_H); }
+static inline int mb_rect_overlap(mb_rect_t a, mb_rect_t b) { return a.x0 < b.x1 && b.x0 < a.x1 && a.y0 < b.y1 && b.y0 < a.y1; }
+static inline int mb_rect_inside(mb_rect_t inner, mb_rect_t outer)
+{
+    return inner.x0 >= outer.x0 && inner.x1 <= outer.x1 && inner.y0 >= outer.y0 && inner.y1 <= outer.y1;
+}
+
+/* ---- the settings ---- */
+enum { MB_CAP_OFF = 0, MB_CAP_SUBTITLES = 1, MB_CAP_BANNER = 2 };
+
+/* How long a caption shows: about 55 ms a character, at least 2.6 s, at most 12 s. */
+static inline uint32_t mb_caption_hold(int chars)
+{
+    uint32_t ms = (uint32_t)chars * 55u;
+    if (ms < 2600u) ms = 2600u;
+    if (ms > 12000u) ms = 12000u;
+    return ms;
+}
+
+#endif
