new file mode 100644
--- /dev/null
+++ b/firmware/main/hal/maipai_lang.h
@@ -0,0 +1,20 @@
+/*
+ * SPDX-License-Identifier: MIT
+ *
+ * Screen words as a language pack, device side (patch K11). Logic and the pack format: maipai_lang_core.h.
+ */
+#pragma once
+#include <cstddef>
+#include <cstdint>
+#include "maipai_lang_core.h"
+
+// The words to draw for the face's language (MF_LANG_* index): the loaded language pack when its code is that language's,
+// otherwise the English words built into the image. Never null. Safe to call from the LVGL task.
+const mlw_t* maipai_lang_words(int lang_index);
+
+// The shared pack loader calls this with a language pack's zip, or with null/0 to go back to English only.
+// Returns false (and a plain reason in *why) when the pack cannot be used; the words in use do not change then.
+bool maipai_lang_load_pack(const uint8_t* payload, size_t len, const char** why);
+
+// The code of the loaded pack ("fr"), or "" when only English is in use.
+const char* maipai_lang_loaded_code();
diff --git a/firmware/main/hal/maipai_lang.cc b/firmware/main/hal/maipai_lang.cc
new file mode 100644
--- /dev/null
+++ b/firmware/main/hal/maipai_lang.cc
@@ -0,0 +1,75 @@
+/*
+ * SPDX-License-Identifier: MIT
+ *
+ * Screen words as a language pack, device side (patch K11). Two 181-byte slots in PSRAM: a new pack is parsed into the one not
+ * in use and then made current with one atomic store, so the LVGL task never reads a half-written table. A slot is reused
+ * only by the pack after next; a draw takes microseconds, and the words are plain ASCII that always end in a zero byte.
+ */
+#include "maipai_lang.h"
+#include "maipai_face_core.h"
+#include "maipai_pack_core.h"
+#include <esp_heap_caps.h>
+#include <esp_log.h>
+#include "maipai_inflate.h"
+#include <atomic>
+#include <cstring>
+
+static const char* TAG = "MAIPAI-LANG";
+
+namespace {
+
+mlw_t* s_slot[2]        = {nullptr, nullptr};
+std::atomic<int> s_cur{-1};  // -1: English only
+char s_code[4]          = "";
+
+long inflate_raw(const uint8_t* in, size_t inlen, uint8_t* out, size_t cap) { return maipai_inflate_raw(in, inlen, out, cap); }  // state in PSRAM, not on this stack
+
+}  // namespace
+
+const mlw_t* maipai_lang_words(int lang_index)
+{
+    const int cur = s_cur.load(std::memory_order_acquire);
+    if (cur < 0 || lang_index < 0 || lang_index >= MF_LANG_COUNT) return &MLW_EN;
+    return mlw_for(s_slot[cur], MF_LANG_CODES[lang_index]);
+}
+
+const char* maipai_lang_loaded_code() { return s_cur.load() < 0 ? "" : s_code; }
+
+bool maipai_lang_load_pack(const uint8_t* payload, size_t len, const char** why)
+{
+    *why = "";
+    if (payload == nullptr || len == 0) {
+        s_cur.store(-1, std::memory_order_release);
+        s_code[0] = 0;
+        return true;
+    }
+    tpz_t* z = static_cast<tpz_t*>(heap_caps_malloc(sizeof(tpz_t), MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT));
+    if (z == nullptr) { *why = tpk_say(TPK_ERR_MEMORY, 0); return false; }
+    struct Free { void* p; ~Free() { heap_caps_free(p); } } free_z{z};
+    if (tpz_open(z, payload, len) != TPK_OK) { *why = tpk_say(TPK_ERR_ZIP, 0); return false; }
+    const tpz_entry_t* e = tpz_find(z, "words.txt");
+    if (e == nullptr || e->usize == 0 || e->usize > MLW_FILE_MAX) { *why = tpk_say(TPK_ERR_ZIP, 0); return false; }
+    char* text = static_cast<char*>(heap_caps_malloc(e->usize + 1, MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT));
+    if (text == nullptr) { *why = tpk_say(TPK_ERR_MEMORY, 0); return false; }
+    struct Free2 { void* p; ~Free2() { heap_caps_free(p); } } free_t{text};
+    if (tpz_extract(z, e, reinterpret_cast<uint8_t*>(text), e->usize, inflate_raw) != TPK_OK) { *why = tpk_say(TPK_ERR_ZIP, 0); return false; }
+    const int cur  = s_cur.load();
+    const int next = cur == 0 ? 1 : 0;
+    if (s_slot[next] == nullptr) {
+        s_slot[next] = static_cast<mlw_t*>(heap_caps_calloc(1, sizeof(mlw_t), MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT));
+        if (s_slot[next] == nullptr) { *why = tpk_say(TPK_ERR_MEMORY, 0); return false; }
+    }
+    mlw_t parsed;
+    const mlw_err_t pe = mlw_parse(text, e->usize, &parsed);
+    if (pe != MLW_OK) {
+        ESP_LOGW(TAG, "language pack refused: %s", MLW_ERR_WORDS[pe]);
+        *why = tpk_say(TPK_ERR_ZIP, 0);
+        return false;
+    }
+    memcpy(s_slot[next], &parsed, sizeof(parsed));
+    strncpy(s_code, parsed.code, 3);
+    s_code[3] = 0;
+    s_cur.store(next, std::memory_order_release);
+    ESP_LOGI(TAG, "language pack: %s", parsed.code);
+    return true;
+}
