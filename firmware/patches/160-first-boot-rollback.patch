 // True while an update is downloading or being checked.
 bool maipai_update_active();
+
+// Patch 160: first-boot check of a wirelessly installed image. The image is confirmed (rollback cancelled)
+// only when the unit has run 20 seconds and reached the host; a timer started at boot rolls the unit back
+// to the old slot when that has not happened within 60 seconds, a hang included. Images flashed over USB
+// are never pending and are not affected.
+void maipai_update_arm();
+void maipai_update_confirm_poll();
diff --git a/firmware/main/hal/maipai_update.cc b/firmware/main/hal/maipai_update.cc
--- a/firmware/main/hal/maipai_update.cc
+++ b/firmware/main/hal/maipai_update.cc
@@ -4,6 +4,7 @@
 #include "maipai_update.h"
 #include "hal.h"
 #include "device_events.h"
+#include "board/hal_bridge.h"
 #include <application.h>
 #include <ota.h>
 #include <settings.h>
@@ -12,6 +13,7 @@
 #include <esp_log.h>
 #include <esp_ota_ops.h>
 #include <esp_system.h>
+#include <esp_timer.h>
 #include <freertos/FreeRTOS.h>
 #include <freertos/task.h>
 #include <atomic>
@@ -140,3 +142,50 @@ std::string maipai_update_start(const char* url, size_t size, const char* versio
     }
     return "";
 }
+
+namespace {
+
+constexpr int64_t kConfirmAfterUs = 20LL * 1000000;
+constexpr int64_t kRollbackAfterUs = 60LL * 1000000;
+esp_timer_handle_t s_rollback_timer = nullptr;
+
+bool image_pending()
+{
+    const esp_partition_t* running = esp_ota_get_running_partition();
+    esp_ota_img_states_t state;
+    return running != nullptr && esp_ota_get_state_partition(running, &state) == ESP_OK &&
+           state == ESP_OTA_IMG_PENDING_VERIFY;
+}
+
+void rollback_now(void*)
+{
+    if (!image_pending()) return;
+    ESP_LOGE(kTag,
+             "The new firmware did not reach the host within 60 seconds. Going back to the previous firmware. "
+             "Check the host and the Wi-Fi, then start the update again.");
+    esp_ota_mark_app_invalid_rollback_and_reboot();
+}
+
+}  // namespace
+
+void maipai_update_arm()
+{
+    if (!image_pending()) return;
+    ESP_LOGI(kTag, "this image was installed wirelessly and is pending: it is kept once it reaches the host, else rolled back in 60 s");
+    const esp_timer_create_args_t args = {.callback = rollback_now, .name = "fwrollback"};
+    if (esp_timer_create(&args, &s_rollback_timer) == ESP_OK) {
+        esp_timer_start_once(s_rollback_timer, kRollbackAfterUs);
+    }
+}
+
+void maipai_update_confirm_poll()
+{
+    if (s_rollback_timer == nullptr || esp_timer_get_time() < kConfirmAfterUs) return;
+    if (!hal_bridge::hub_link_up() || !image_pending()) return;
+    esp_timer_stop(s_rollback_timer);
+    esp_timer_delete(s_rollback_timer);
+    s_rollback_timer = nullptr;
+    ESP_LOGI(kTag, "the new image reached the host; keeping it");
+    esp_ota_mark_app_valid_cancel_rollback();
+    device_events_push("firmware_update_validated", "");
+}
