+/* HMAC-SHA-256 (RFC 2104): a key over 64 bytes is hashed first; a message over 400 bytes is refused (out is all zero, which no caller accepts as a key). */
 static inline void mly_hmac(const uint8_t* key, size_t klen, const uint8_t* msg, size_t mlen, uint8_t out[32])
