+        memset(out, 0, 32);
+        return;
+    }
+    if (klen > 64) {
+        mly_sha256(key, klen, k);
+    } else {
+        memcpy(k, key, klen);
+    }
     for (int i = 0; i < 64; i++) buf[i] = (uint8_t)(k[i] ^ 0x36);
     memcpy(buf + 64, msg, mlen);
     mly_sha256(buf, 64 + mlen, inner);
