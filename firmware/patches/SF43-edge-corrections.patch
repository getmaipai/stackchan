# Intent: Small corrections to bench tools and edges. The volume and brightness sliders save only the value that is still live after the 700 ms window, and save at once if the timer cannot be made. A mouth cue append that arrives with no list held and late times is refused (it would be played by the next reply). The link key schedule hashes an HMAC key over 64 bytes (RFC 2104), refuses a message over 400 bytes (all-zero output) and lower-cases the device id itself; an unused key pair is destroyed when pairing fails or the second pair cannot be made. self.bench.set_head answers the animation angle and says so (angle_source animation); self.bench.mic3_check restores the speaker volume when its buffer cannot be allocated and refuses a slot change during a turn.
# Placement: unit
# Upstream: firmware/main/hal (ours)
# Check after a flash: moving the volume slider and a host volume change within a second leaves the host's value saved; self.bench.set_head answers angle_source animation; a failed pairing leaves no key pair held.
# Kconfig: none new

diff --git a/firmware/main/hal/maipai_pages_unit.cc b/firmware/main/hal/maipai_pages_unit.cc
--- a/firmware/main/hal/maipai_pages_unit.cc
+++ b/firmware/main/hal/maipai_pages_unit.cc
@@ -68,25 +68,36 @@ std::atomic<int> s_pend_volume{-1};
 std::atomic<int> s_pend_brightness{-1};
 esp_timer_handle_t s_slider_timer = nullptr;
 
+// Saves the slider values that are still the live ones: if the host or a power rule changed the volume or the brightness inside the window, that
+// change saved itself and the slider's older value is dropped (it would otherwise undo it).
+void save_pending_sliders()
+{
+    Application::GetInstance().Schedule([]() {
+        const int v = s_pend_volume.exchange(-1);
+        if (v >= 0) {
+            if (auto* codec = Board::GetInstance().GetAudioCodec()) {
+                if (codec->output_volume() == v) codec->SetOutputVolume(v);
+            }
+        }
+        const int br = s_pend_brightness.exchange(-1);
+        if (br >= 0) {
+            if (auto* b = Board::GetInstance().GetBacklight()) {
+                if (b->brightness() == br) b->SetBrightness(br, true);
+            }
+        }
+    });
+}
+
 void arm_slider_save()
 {
     if (s_slider_timer == nullptr) {
         esp_timer_create_args_t args = {};
-        args.callback = [](void*) {
-            Application::GetInstance().Schedule([]() {
-                const int v = s_pend_volume.exchange(-1);
-                if (v >= 0) {
-                    if (auto* codec = Board::GetInstance().GetAudioCodec()) codec->SetOutputVolume(v);
-                }
-                const int br = s_pend_brightness.exchange(-1);
-                if (br >= 0) {
-                    if (auto* b = Board::GetInstance().GetBacklight()) b->SetBrightness(br, true);
-                }
-            });
-        };
+        args.callback = [](void*) { save_pending_sliders(); };
         args.name = "slider_save";
         if (esp_timer_create(&args, &s_slider_timer) != ESP_OK) {
             s_slider_timer = nullptr;
+            ESP_LOGW(TAG, "The slider save timer could not be made; the value is saved at once");
+            save_pending_sliders();
             return;
         }
     }
@@ -324,7 +335,7 @@ public:
     {
         // Patch SF19: the slider changes the volume at once and the flash is written once, 700 ms after the last change.
         hal_bridge::board_set_speaker_volume(static_cast<uint8_t>(v < 0 ? 0 : (v > 100 ? 100 : v)), false);
-        s_pend_volume.store(v);
+        s_pend_volume.store(v < 0 ? 0 : (v > 100 ? 100 : v));
         arm_slider_save();
     }
     int brightness() override
