diff --git a/firmware/main/hal/maipai_banner_tools.cc b/firmware/main/hal/maipai_banner_tools.cc
new file mode 100644
--- /dev/null
+++ b/firmware/main/hal/maipai_banner_tools.cc
@@ -0,0 +1,26 @@
+/*
+ * SPDX-License-Identifier: MIT
+ *
+ * self.banner.face_seen (patch NX05): the host's face model, or the unit's own detector, says a face was seen; the face glyph shows in the banner
+ * strip next to the mic glyph for a few seconds. Logic: maipai_status_core.h (hold and rate). Drawing: maipai_banner.cc.
+ */
+#include <sdkconfig.h>
+
+#if CONFIG_MAIPAI_BANNER_ROW
+#include "maipai_banner.h"
+#include <mcp_server.h>
+#include <string>
+
+void maipai_banner_register_tools()
+{
+    auto& mcp = McpServer::GetInstance();
+    mcp.AddTool("self.banner.face_seen",
+                "A face was seen: shows a small face glyph in the banner strip, next to the microphone glyph, for `seconds` (default 3, at most 10), only while "
+                "the Status icons setting is on. Reports closer than half a second apart are ignored. Answers {ok, shown, reason}; reason is status_icons_off "
+                "or rate_limited when shown is false.",
+                PropertyList({Property("seconds", kPropertyTypeInteger, 3, 1, 10)}), [](const PropertyList& properties) -> ReturnValue {
+                    const bool shown = maipai_banner_face_seen(properties["seconds"].value<int>());
+                    return std::string(shown ? "{\"ok\":true,\"shown\":true}" : "{\"ok\":true,\"shown\":false,\"reason\":\"status_icons_off_or_rate_limited\"}");
+                });
+}
+#endif
