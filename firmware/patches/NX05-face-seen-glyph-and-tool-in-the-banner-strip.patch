+bool maipai_banner_face_seen(int seconds)
+{
+    if (s_b == nullptr || !s_status_icons.load()) {
+        return false;
+    }
+    const uint32_t now = now_ms();
+    uint32_t last = s_face_last_ms.load();
+    if (!mst_face_due(last, now)) {
+        return false;
+    }
+    s_face_last_ms.store(now | 1u);
+    std::lock_guard<std::mutex> lock(s_mu);
+    mb_flag(s_b, MB_FLAG_FACE, 1, now, mst_face_hold_ms(seconds));
+    return true;
+}
