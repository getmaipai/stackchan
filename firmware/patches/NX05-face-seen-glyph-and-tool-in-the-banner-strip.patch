+++ b/firmware/main/hal/maipai_status_core.h
@@ -45,4 +45,29 @@ static inline uint32_t mst_mic_hold_until(uint32_t now)
     return t == 0u ? 1u : t;
 }
 
+/* The face-seen glyph (patch NX05): a small face in the strip next to the mic glyph while a face was seen in the last few seconds. The unit's own
+ * detector and the host's face model both report a face; a report keeps the glyph for `seconds` (default 3, at most 10), and reports closer than
+ * MST_FACE_RATE_MS apart are ignored, so a detector at 5 Hz never makes the row work harder than it must. Like the status messages it shows only
+ * while the "Status icons" setting is on, and it never takes the place of the camera cue, the remote chip, the privacy cues or the lock cue (the
+ * strip holds every glyph side by side). */
+#define MST_FACE_SECONDS_DEFAULT 3
+#define MST_FACE_SECONDS_MAX 10
+#define MST_FACE_RATE_MS 500u
+
+static inline uint32_t mst_face_hold_ms(int seconds)
+{
+    if (seconds <= 0) {
+        seconds = MST_FACE_SECONDS_DEFAULT;
+    }
+    if (seconds > MST_FACE_SECONDS_MAX) {
+        seconds = MST_FACE_SECONDS_MAX;
+    }
+    return (uint32_t)seconds * 1000u;
+}
+/* A report is taken when none was taken in the last MST_FACE_RATE_MS (last_ms 0: none yet). */
+static inline int mst_face_due(uint32_t last_ms, uint32_t now)
+{
+    return last_ms == 0u || (uint32_t)(now - last_ms) >= MST_FACE_RATE_MS;
+}
+
 #endif /* MAIPAI_STATUS_CORE_H */
