+/* The progress bar's fill, from the time left and the time the timer was started with (0 to MAC_TROW_BAR_W). */
+static inline int mac_bar_fill(int32_t left_s, int32_t total_s)
+{
+    if (total_s <= 0 || left_s <= 0) {
+        return 0;
+    }
+    if (left_s >= total_s) {
+        return MAC_TROW_BAR_W;
+    }
+    const int f = (int)((int64_t)left_s * MAC_TROW_BAR_W / total_s);
+    return f < 2 ? 2 : f;
+}
