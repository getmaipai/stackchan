-void StackChanAvatarDisplay::ShowBootCover(const char* text, int ring_kind)
+// ---------------------------------------------------------------------------------------------------------------
+// Link looks (patch R03): drawn from rectangles and one line, so no font and no image is added. A glyph is built
+// on a unit u: Wi-Fi bars 11u wide and 8u high (four bars, a slash across them when the link is down), and a key
+// 11u wide and 5u high (a ring, a shaft and two teeth).
+// ---------------------------------------------------------------------------------------------------------------
+struct LinkGlyph {
+    lv_obj_t* row     = nullptr;
+    lv_obj_t* wifi    = nullptr;
+    lv_obj_t* bars[4] = {};
+    lv_obj_t* slash   = nullptr;
+    lv_obj_t* key     = nullptr;
+    lv_obj_t* key_parts[4] = {};
+    lv_point_precise_t slash_points[2] = {};
+    int unit = 1;
+};
+
+static lv_obj_t* link_rect(lv_obj_t* parent, int x, int y, int w, int h, int radius)
+{
+    lv_obj_t* object = lv_obj_create(parent);
+    lv_obj_remove_style_all(object);
+    lv_obj_remove_flag(object, LV_OBJ_FLAG_CLICKABLE);
+    lv_obj_remove_flag(object, LV_OBJ_FLAG_SCROLLABLE);
+    lv_obj_set_size(object, w, h);
+    lv_obj_set_pos(object, x, y);
+    lv_obj_set_style_radius(object, radius, 0);
+    lv_obj_set_style_bg_opa(object, LV_OPA_COVER, 0);
+    return object;
+}
+
+static lv_color_t link_on(bool cover)
+{
+    return cover ? lv_color_white() : lv_color_make(120, 140, 160);  // the strip is muted grey-blue
+}
+
+static lv_color_t link_off(bool cover)
 {
+    return cover ? lv_color_make(60, 60, 60) : lv_color_make(50, 58, 66);
+}
+
+static LinkGlyph* link_glyph_new(lv_obj_t* parent, int unit, bool want_wifi, bool want_key, bool cover)
+{
+    auto* glyph = new (std::nothrow) LinkGlyph();
+    if (glyph == nullptr) {
+        return nullptr;
+    }
+    glyph->unit = unit;
+    glyph->row  = lv_obj_create(parent);
+    lv_obj_remove_style_all(glyph->row);
+    lv_obj_remove_flag(glyph->row, LV_OBJ_FLAG_CLICKABLE);
+    lv_obj_remove_flag(glyph->row, LV_OBJ_FLAG_SCROLLABLE);
+    lv_obj_set_size(glyph->row, LV_SIZE_CONTENT, LV_SIZE_CONTENT);
+    lv_obj_set_flex_flow(glyph->row, LV_FLEX_FLOW_ROW);
+    lv_obj_set_flex_align(glyph->row, LV_FLEX_ALIGN_CENTER, LV_FLEX_ALIGN_CENTER, LV_FLEX_ALIGN_CENTER);
+    lv_obj_set_style_pad_column(glyph->row, 3 * unit, 0);
+    if (want_wifi) {
+        glyph->wifi = lv_obj_create(glyph->row);
+        lv_obj_remove_style_all(glyph->wifi);
+        lv_obj_remove_flag(glyph->wifi, LV_OBJ_FLAG_CLICKABLE);
+        lv_obj_remove_flag(glyph->wifi, LV_OBJ_FLAG_SCROLLABLE);
+        lv_obj_set_size(glyph->wifi, 11 * unit, 8 * unit);
+        for (int i = 0; i < 4; i++) {
+            const int h = 2 * unit * (i + 1);
+            glyph->bars[i] = link_rect(glyph->wifi, i * 3 * unit, 8 * unit - h, 2 * unit, h, unit > 3 ? 2 : 1);
+            lv_obj_set_style_bg_color(glyph->bars[i], link_off(cover), 0);
+        }
+        glyph->slash_points[0] = {0, static_cast<lv_value_precise_t>(8 * unit)};
+        glyph->slash_points[1] = {static_cast<lv_value_precise_t>(11 * unit), 0};
+        glyph->slash = lv_line_create(glyph->wifi);
+        lv_line_set_points(glyph->slash, glyph->slash_points, 2);
+        lv_obj_set_style_line_width(glyph->slash, unit > 3 ? unit / 2 + 1 : 2, 0);
+        lv_obj_set_style_line_color(glyph->slash, link_on(cover), 0);
+        lv_obj_set_style_line_rounded(glyph->slash, true, 0);
+        lv_obj_add_flag(glyph->slash, LV_OBJ_FLAG_HIDDEN);
+    }
+    if (want_key) {
+        glyph->key = lv_obj_create(glyph->row);
+        lv_obj_remove_style_all(glyph->key);
+        lv_obj_remove_flag(glyph->key, LV_OBJ_FLAG_CLICKABLE);
+        lv_obj_remove_flag(glyph->key, LV_OBJ_FLAG_SCROLLABLE);
+        lv_obj_set_size(glyph->key, 11 * unit, 5 * unit);
+        // The ring: an empty circle with a border; the shaft and the two teeth are filled.
+        glyph->key_parts[0] = link_rect(glyph->key, 0, 0, 5 * unit, 5 * unit, LV_RADIUS_CIRCLE);
+        lv_obj_set_style_bg_opa(glyph->key_parts[0], LV_OPA_TRANSP, 0);
+        lv_obj_set_style_border_width(glyph->key_parts[0], unit > 3 ? unit : 2, 0);
+        lv_obj_set_style_border_color(glyph->key_parts[0], link_on(cover), 0);
+        glyph->key_parts[1] = link_rect(glyph->key, 5 * unit, 2 * unit, 6 * unit, unit, 0);
+        glyph->key_parts[2] = link_rect(glyph->key, 8 * unit, 3 * unit, unit, 2 * unit, 0);
+        glyph->key_parts[3] = link_rect(glyph->key, 10 * unit, 3 * unit, unit, 2 * unit, 0);
+        for (int i = 1; i < 4; i++) {
+            lv_obj_set_style_bg_color(glyph->key_parts[i], link_on(cover), 0);
+        }
+    }
+    return glyph;
+}
+
+// How many bars are lit (0 to 4) and whether the slash is drawn.
+static void link_glyph_bars(LinkGlyph* glyph, int lit, bool slash, bool cover)
+{
+    if (glyph == nullptr || glyph->wifi == nullptr) {
+        return;
+    }
+    for (int i = 0; i < 4; i++) {
+        lv_obj_set_style_bg_color(glyph->bars[i], i < lit ? link_on(cover) : link_off(cover), 0);
+    }
+    if (slash) {
+        lv_obj_remove_flag(glyph->slash, LV_OBJ_FLAG_HIDDEN);
+    } else {
+        lv_obj_add_flag(glyph->slash, LV_OBJ_FLAG_HIDDEN);
+    }
+}
+
+static void link_glyph_free(LinkGlyph*& glyph)
+{
+    if (glyph != nullptr) {
+        if (glyph->row != nullptr) {
+            lv_obj_delete(glyph->row);
+        }
+        delete glyph;
+        glyph = nullptr;
+    }
+}
+
+// What the cover's glyph slot shows: 0 the bars cycling (connecting), 1 bars with the slash (Wi-Fi setup
+// needed), 2 the slash and a key (waiting for Home to approve), -1 nothing.
+void StackChanAvatarDisplay::SetCoverGlyph(int kind)
+{
+    cover_glyph_kind_ = kind;
+    if (boot_cover_ == nullptr || kind < 0) {
+        link_glyph_free(cover_glyph_);
+        UpdateLinkTimer();
+        return;
+    }
+    link_glyph_free(cover_glyph_);
+    // The shipped look at 1.5 times: 6 px units make the bars 66 by 48.
+    cover_glyph_ = link_glyph_new(boot_cover_, 6, true, kind == 2, true);
+    if (cover_glyph_ != nullptr) {
+        lv_obj_move_to_index(cover_glyph_->row, 0);
+        link_glyph_bars(cover_glyph_, kind == 0 ? 1 : 0, kind != 0, true);
+    }
+    UpdateLinkTimer();
+}
+
+void StackChanAvatarDisplay::UpdateLinkTimer()
+{
+    const bool cover_cycles = cover_glyph_ != nullptr && cover_glyph_kind_ == 0;
+    const bool strip_cycles = strip_glyph_ != nullptr && link_look_ == 1;
+    if ((cover_cycles || strip_cycles) && link_timer_ == nullptr) {
+        link_timer_ = lv_timer_create(LinkTick, 350, this);
+    } else if (!cover_cycles && !strip_cycles && link_timer_ != nullptr) {
+        lv_timer_delete(link_timer_);
+        link_timer_ = nullptr;
+    }
+}
+
+void StackChanAvatarDisplay::LinkTick(lv_timer_t* timer)
+{
+    auto* self = static_cast<StackChanAvatarDisplay*>(lv_timer_get_user_data(timer));
+    if (self == nullptr) {
+        return;
+    }
+    self->link_step_ = (self->link_step_ + 1) % 5;  // 0 to 4 bars lit, then around again
+    if (self->cover_glyph_ != nullptr && self->cover_glyph_kind_ == 0) {
+        link_glyph_bars(self->cover_glyph_, self->link_step_, false, true);
+    }
+    if (self->strip_glyph_ != nullptr && self->link_look_ == 1) {
+        link_glyph_bars(self->strip_glyph_, self->link_step_, false, false);
+    }
+}
+
+// The corner strip shown on the face once it is up: the bars cycling with no words (connecting), the slashed
+// bars and "Offline", or a key and "Waiting for approval".
+void StackChanAvatarDisplay::ShowStrip(int look)
+{
+    if (strip_ == nullptr) {
+        strip_ = lv_obj_create(lv_layer_top());
+        lv_obj_remove_style_all(strip_);
+        lv_obj_remove_flag(strip_, LV_OBJ_FLAG_CLICKABLE);
+        lv_obj_remove_flag(strip_, LV_OBJ_FLAG_SCROLLABLE);
+        lv_obj_set_size(strip_, LV_SIZE_CONTENT, LV_SIZE_CONTENT);
+        lv_obj_set_pos(strip_, 6, 5);
+        lv_obj_set_flex_flow(strip_, LV_FLEX_FLOW_ROW);
+        lv_obj_set_flex_align(strip_, LV_FLEX_ALIGN_START, LV_FLEX_ALIGN_CENTER, LV_FLEX_ALIGN_CENTER);
+        lv_obj_set_style_pad_column(strip_, 5, 0);
+    }
+    link_glyph_free(strip_glyph_);
+    if (strip_label_ != nullptr) {
+        lv_obj_delete(strip_label_);
+        strip_label_ = nullptr;
+    }
+    strip_glyph_ = link_glyph_new(strip_, 2, look != 3, look == 3, false);
+    if (look != 3) {
+        link_glyph_bars(strip_glyph_, look == 1 ? link_step_ : 0, look == 2, false);
+    }
+    if (look != 1) {
+        strip_label_ = lv_label_create(strip_);
+        lv_obj_set_style_text_font(strip_label_, &BUILTIN_TEXT_FONT, 0);
+        lv_obj_set_style_text_color(strip_label_, link_on(false), 0);
+        lv_label_set_text(strip_label_, look == 2 ? "Offline" : "Waiting for approval");
+    }
+    UpdateLinkTimer();
+}
+
+void StackChanAvatarDisplay::HideStrip()
+{
+    link_glyph_free(strip_glyph_);
+    if (strip_ != nullptr) {
+        lv_obj_delete(strip_);
+        strip_       = nullptr;
+        strip_label_ = nullptr;
+    }
+    UpdateLinkTimer();
+}
+
+// The one place that picks the look from the hub link. The caller holds the LVGL lock.
+//   Before the first face: the cover shows "Waiting for Home to approve me" with the slash and a key while
+//   Home refuses; every other link state leaves the cover to the boot status (Wi-Fi, Home).
+//   After it: nothing when linked; the strip when not; the dim amber ring while offline; the cyan blink
+//   while waiting for approval (the steady amber steps aside).
+void StackChanAvatarDisplay::ApplyLink()
+{
+    if (boot_cover_ == nullptr) {
+        return;
+    }
+    hal_bridge::leds_offline(link_look_ == 2);
+    if (!boot_done_) {
+        if (link_look_ == 3) {
+            ShowBootCover("Waiting for Home to approve me", 2, 2);
+        } else if (cover_glyph_kind_ == 2) {
+            ShowBootCover("Connecting to Home...", 1, 0);
+        }
+        return;
+    }
+    if (link_look_ == 0) {
+        HideStrip();
+    } else {
+        ShowStrip(link_look_);
+    }
+    if (link_look_ == 3 && !approval_ring_) {
+        approval_ring_      = true;
+        boot_ring_kind_     = 2;
+        boot_ring_start_ms_ = GetHAL().millis();
+        boot_ring_last_on_  = false;
+        if (boot_ring_timer_ == nullptr) {
+            boot_ring_timer_ = lv_timer_create(BootRingTick, 100, this);
+        }
+    } else if (link_look_ != 3 && approval_ring_) {
+        approval_ring_ = false;
+        if (boot_ring_timer_ != nullptr) {
+            lv_timer_delete(boot_ring_timer_);
+            boot_ring_timer_ = nullptr;
+        }
+        boot_ring_last_on_ = false;
+        for (int i = 0; i < 12; i++) {
+            GetHAL().setRgbColor(i, 35, 35, 31);  // the ring as the first face leaves it (HideBootCover)
+        }
+        GetHAL().refreshRgb();
+    }
+}
+
+void StackChanAvatarDisplay::SetLinkLook(int look)
+{
+    LvglLock();
+    if (link_look_ != look) {
+        ESP_LOGI(TAG, "link look: %d -> %d (0 up, 1 connecting, 2 offline, 3 waiting for approval)", link_look_, look);
+        link_look_ = look;
+        ApplyLink();
+        UpdateLinkTimer();
+    }
+    LvglUnlock();
+}
+
+void hal_bridge::link_look(int look)
+{
+    auto display = static_cast<StackChanAvatarDisplay*>(Board::GetInstance().GetDisplay());
+    if (display != nullptr) {
+        display->SetLinkLook(look);
+    }
+}
