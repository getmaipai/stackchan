+/*
+ * SPDX-License-Identifier: MIT
+ */
+#pragma once
+
+// Reset on the device (patch R01). Only the on-screen reset screen starts it: there is no host command,
+// tool or setting that calls these functions.
+
+// Boot, right after flash storage is ready and before anything reads a setting: if a reset was started and
+// did not finish (power loss, a failed erase), finish it now. Does nothing when no reset is pending.
+void maipai_reset_resume();
+
+// Start the reset on its own task (internal stack, safe to call from the screen's task). Returns false
+// only when a reset is already running. The task marks the reset pending, erases Wi-Fi networks, pairing
+// and settings, removes the mark, logs one line and restarts into setup mode.
+bool maipai_reset_start();
+
+// True after a reset started and could not finish (the screen then shows the failure line). Cleared by the
+// next maipai_reset_start.
+bool maipai_reset_failed();
diff --git a/firmware/main/hal/maipai_reset.cc b/firmware/main/hal/maipai_reset.cc
new file mode 100644
--- /dev/null
+++ b/firmware/main/hal/maipai_reset.cc
@@ -0,0 +1,168 @@
+/*
+ * SPDX-License-Identifier: MIT
+ */
+// Reset on the device (patch R01). The clear is never half-done. The order is:
+//   1. write the "pending" mark (namespace mp_reset) and commit it: if that fails, nothing is erased;
+//   2. erase every namespace except the keep list (maipai_reset_core.h): this is repeatable, so a power
+//      loss anywhere in it only means the next boot runs it again (maipai_reset_resume);
+//   3. erase the mark, then restart. The restart finds no Wi-Fi network and starts setup mode.
+// There is nothing resident: no task, timer or buffer exists until a person finishes the hold.
+#include "maipai_reset.h"
+
+#include "maipai_reset_core.h"
+
+#include <esp_log.h>
+#include <esp_system.h>
+#include <freertos/FreeRTOS.h>
+#include <freertos/task.h>
+#include <nvs.h>
+#include <nvs_flash.h>
+
+#include <atomic>
+#include <string>
+#include <vector>
+
+namespace {
+constexpr const char* kTag    = "MaiPaiReset";
+constexpr const char* kMarkNs = "mp_reset";
+constexpr const char* kMarkKey = "pending";
+
+std::atomic<bool> s_running{false};
+std::atomic<bool> s_failed{false};
+
+bool pending()
+{
+    nvs_handle_t h;
+    if (nvs_open(kMarkNs, NVS_READONLY, &h) != ESP_OK) {
+        return false;
+    }
+    uint8_t value = 0;
+    const bool yes = nvs_get_u8(h, kMarkKey, &value) == ESP_OK && value == 1;
+    nvs_close(h);
+    return yes;
+}
+
+esp_err_t set_mark(bool on)
+{
+    nvs_handle_t h;
+    esp_err_t err = nvs_open(kMarkNs, NVS_READWRITE, &h);
+    if (err != ESP_OK) {
+        return err;
+    }
+    err = on ? nvs_set_u8(h, kMarkKey, 1) : nvs_erase_all(h);
+    if (err == ESP_OK) {
+        err = nvs_commit(h);
+    }
+    nvs_close(h);
+    return err;
+}
+
+// Every namespace that holds something, listed once. Collected first, then erased, so the erase never
+// walks storage it is changing.
+std::vector<std::string> namespaces()
+{
+    std::vector<std::string> names;
+    nvs_iterator_t it = nullptr;
+    esp_err_t err     = nvs_entry_find(NVS_DEFAULT_PART_NAME, nullptr, NVS_TYPE_ANY, &it);
+    while (err == ESP_OK && it != nullptr) {
+        nvs_entry_info_t info;
+        nvs_entry_info(it, &info);
+        bool seen = false;
+        for (const auto& name : names) {
+            if (name == info.namespace_name) {
+                seen = true;
+                break;
+            }
+        }
+        if (!seen) {
+            names.emplace_back(info.namespace_name);
+        }
+        err = nvs_entry_next(&it);
+    }
+    nvs_release_iterator(it);
+    return names;
+}
+
+// Returns true when every namespace outside the keep list is empty afterwards.
+bool erase_settings()
+{
+    bool ok = true;
+    for (const auto& name : namespaces()) {
+        if (mrc_keep_namespace(name.c_str())) {
+            continue;
+        }
+        nvs_handle_t h;
+        esp_err_t err = nvs_open(name.c_str(), NVS_READWRITE, &h);
+        if (err == ESP_OK) {
+            err = nvs_erase_all(h);
+            if (err == ESP_OK) {
+                err = nvs_commit(h);
+            }
+            nvs_close(h);
+        }
+        if (err != ESP_OK) {
+            ESP_LOGW(kTag, "could not erase the saved settings in \"%s\" (%s)", name.c_str(), esp_err_to_name(err));
+            ok = false;
+        }
+    }
+    return ok;
+}
+
+void reset_task(void*)
+{
+    if (set_mark(true) != ESP_OK) {
+        ESP_LOGW(kTag, "reset not started: the flash would not take the pending mark. Nothing was erased. Hold the button again.");
+        s_failed  = true;
+        s_running = false;
+        vTaskDelete(nullptr);
+        return;
+    }
+    if (!erase_settings()) {
+        ESP_LOGW(kTag, "reset did not finish. It stays pending and finishes on the next start.");
+        s_failed  = true;  // the screen shows the failure line; the next boot completes the clear
+        s_running = false;
+        vTaskDelete(nullptr);
+        return;
+    }
+    set_mark(false);
+    ESP_LOGW(kTag, "reset done: saved Wi-Fi, pairing and settings erased on the unit's own screen; restarting into setup mode");
+    vTaskDelay(pdMS_TO_TICKS(200));  // the log line leaves first
+    esp_restart();
+}
+}  // namespace
+
+void maipai_reset_resume()
+{
+    if (!pending()) {
+        return;
+    }
+    ESP_LOGW(kTag, "a reset was interrupted: finishing it now");
+    if (erase_settings()) {
+        set_mark(false);
+        ESP_LOGW(kTag, "reset finished on this start; the unit asks for Wi-Fi setup");
+    } else {
+        ESP_LOGW(kTag, "reset still not finished. It stays pending and runs again on the next start.");
+    }
+}
+
+bool maipai_reset_start()
+{
+    bool expected = false;
+    if (!s_running.compare_exchange_strong(expected, true)) {
+        return false;
+    }
+    s_failed = false;
+    // Internal 4 KB stack: a flash write from a task whose stack is in PSRAM aborts the unit.
+    if (xTaskCreate(reset_task, "mp_reset", 4096, nullptr, 5, nullptr) != pdPASS) {
+        ESP_LOGW(kTag, "reset not started: no memory for its task. Nothing was erased. Hold the button again.");
+        s_failed  = true;
+        s_running = false;
+        return false;
+    }
+    return true;
+}
+
+bool maipai_reset_failed()
+{
+    return s_failed.load();
+}
