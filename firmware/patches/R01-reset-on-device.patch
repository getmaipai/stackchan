+void StackChanAvatarDisplay::ResetTick(lv_timer_t* timer)
+{
+    auto* self = static_cast<StackChanAvatarDisplay*>(lv_timer_get_user_data(timer));
+    if (self == nullptr || self->reset_panel_ == nullptr) {
+        return;
+    }
+    const mrc_lang_t lang = mrc_lang_from_code(Lang::CODE);
+    if (self->reset_fired_) {
+        // The reset runs on its own task and restarts the unit. Only a failure comes back here.
+        if (maipai_reset_failed()) {
+            self->reset_fired_ = false;
+            lv_label_set_text(self->reset_note_, mrc_text(lang, MRC_STR_FAILED));
+            lv_bar_set_value(self->reset_bar_, 0, LV_ANIM_OFF);
+        }
+        return;
+    }
+    if (!self->reset_down_) {
+        return;
+    }
+    const uint32_t now = lv_tick_get();
+    lv_bar_set_value(self->reset_bar_, mrc_hold_percent(self->reset_down_ms_, now), LV_ANIM_OFF);
+    if (mrc_hold_complete(self->reset_down_ms_, now)) {
+        self->reset_fired_ = true;
+        self->reset_down_  = false;
+        lv_label_set_text(lv_obj_get_child(self->reset_hold_, 0), mrc_text(lang, MRC_STR_HOLDING));
+        if (!maipai_reset_start()) {
+            self->reset_fired_ = false;
+        }
+    }
+}
+
+void StackChanAvatarDisplay::CloseResetConfirm()
+{
+    if (reset_timer_ != nullptr) {
+        lv_timer_delete(reset_timer_);
+        reset_timer_ = nullptr;
+    }
+    if (reset_panel_ != nullptr) {
+        lv_obj_delete_async(reset_panel_);  // runs from the panel's own button callback
+        reset_panel_ = nullptr;
+    }
+    reset_bar_   = nullptr;
+    reset_hold_  = nullptr;
+    reset_note_  = nullptr;
+    reset_down_  = false;
+    reset_fired_ = false;
+}
