diff --git a/firmware/main/hal/maipai_reset_core.h b/firmware/main/hal/maipai_reset_core.h
new file mode 100644
--- /dev/null
+++ b/firmware/main/hal/maipai_reset_core.h
@@ -0,0 +1,90 @@
+/*
+ * SPDX-License-Identifier: MIT
+ *
+ * Reset on the device (patch R01): the words, the hold timing and the keep list. Plain C99 with no firmware
+ * headers, so a host test compiles and runs it (host/tests/firmware/reset_core_test.c).
+ *
+ * The screen text is English or Spanish. The built-in screen font has no accented letters, so the Spanish
+ * lines are written without them.
+ */
+#ifndef MAIPAI_RESET_CORE_H
+#define MAIPAI_RESET_CORE_H
+
+#include <stdint.h>
+#include <string.h>
+
+#define MRC_HOLD_MS 3000 /* how long the button must stay down before anything is erased */
+
+typedef enum { MRC_LANG_EN = 0, MRC_LANG_ES } mrc_lang_t;
+
+typedef enum {
+    MRC_STR_BUTTON = 0, /* the entry in quick settings */
+    MRC_STR_TITLE,
+    MRC_STR_BODY,    /* what will be erased, in plain words */
+    MRC_STR_HOLD,    /* the hold button, idle */
+    MRC_STR_HOLDING, /* the hold button, while held */
+    MRC_STR_CANCEL,
+    MRC_STR_FAILED, /* the clear did not finish */
+    MRC_STR_COUNT
+} mrc_str_t;
+
+static inline mrc_lang_t mrc_lang_from_code(const char* code)
+{
+    return (code != NULL && code[0] == 'e' && code[1] == 's') ? MRC_LANG_ES : MRC_LANG_EN;
+}
+
+static inline const char* mrc_text(mrc_lang_t lang, mrc_str_t which)
+{
+    static const char* const en[MRC_STR_COUNT] = {
+        "Reset",
+        "Reset the robot",
+        ("This erases saved Wi-Fi networks, pairing and settings. Then the robot asks for Wi-Fi setup again. "
+         "Nothing is erased until you hold the button for 3 seconds."),
+        "Hold 3 s to erase",
+        "Keep holding...",
+        "Cancel",
+        "The reset could not finish. Hold the button again, or restart the robot: it finishes on the next start.",
+    };
+    static const char* const es[MRC_STR_COUNT] = {
+        "Restablecer",
+        "Restablecer el robot",
+        ("Esto borra las redes Wi-Fi, el emparejamiento y los ajustes guardados. Luego el robot pide Wi-Fi de "
+         "nuevo. No se borra nada hasta que mantengas el boton 3 segundos."),
+        "Mantener 3 s para borrar",
+        "Sigue manteniendo...",
+        "Cancelar",
+        "No se pudo terminar. Manten el boton otra vez o reinicia el robot: termina en el proximo inicio.",
+    };
+    if ((int)which < 0 || which >= MRC_STR_COUNT) {
+        return "";
+    }
+    return lang == MRC_LANG_ES ? es[which] : en[which];
+}
+
+/* Hold progress 0..100 for a finger down since down_ms, at now_ms. */
+static inline int mrc_hold_percent(uint32_t down_ms, uint32_t now_ms)
+{
+    const uint32_t held = now_ms - down_ms;
+    if (held >= MRC_HOLD_MS) {
+        return 100;
+    }
+    return (int)((held * 100u) / MRC_HOLD_MS);
+}
+
+static inline int mrc_hold_complete(uint32_t down_ms, uint32_t now_ms)
+{
+    return (now_ms - down_ms) >= MRC_HOLD_MS;
+}
+
+/* Namespaces of the unit's flash settings a reset leaves alone:
+ *   mp_reset  the reset's own marker (it is removed last, when the clear is done)
+ *   servo     the head's zero-position calibration: a measurement of this unit, not a setting
+ *   phy       the radio calibration: a measurement of this unit, rebuilt slowly if lost
+ * Everything else is erased: saved Wi-Fi networks (wifi, nvs.net80211), pairing (websocket), the privacy
+ * state, sounds, face, timers and every other setting. */
+static inline int mrc_keep_namespace(const char* ns)
+{
+    return ns != NULL && (strcmp(ns, "mp_reset") == 0 || strcmp(ns, "servo") == 0 || strcmp(ns, "phy") == 0);
+}
+
+#endif
