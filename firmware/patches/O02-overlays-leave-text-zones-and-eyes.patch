+// Patch O01: whether anything of the banner zone (y 0 to 27) is on screen: the row or its chip, or a glyph of the strip. The overlays leave
+// the zone alone while it is busy (the text layers draw above the overlays).
+bool maipai_banner_zone_busy()
+{
+    if (s_b == nullptr) return false;
+    std::lock_guard<std::mutex> lock(s_mu);
+    return s_b->has_cur || s_b->session || mb_strip_visible(s_b) != 0;
+}
