+/*
+ * SPDX-License-Identifier: MIT
+ *
+ * Face bench tools (patch H01): how fast the face draws, and a dump of what it draws. Bench builds only
+ * (CONFIG_MAIPAI_FACE_BENCH, off in every shipped image: no counter, no tool, no code).
+ */
+#pragma once
+#include <sdkconfig.h>
+#include <lvgl.h>
+
+#if CONFIG_MAIPAI_FACE_BENCH
+// Counts screen refreshes and flushed pixels. Call once after the display exists (LVGL lock held).
+void maipai_facebench_attach(lv_display_t* display);
+// Once per pass of the avatar update loop.
+void maipai_facebench_loop_tick();
+// Registers self.face.bench_fps, bench_run, bench_speak and snapshot.
+void maipai_facebench_register_tools();
+#else
+inline void maipai_facebench_attach(lv_display_t*) {}
+inline void maipai_facebench_loop_tick() {}
+inline void maipai_facebench_register_tools() {}
+#endif
