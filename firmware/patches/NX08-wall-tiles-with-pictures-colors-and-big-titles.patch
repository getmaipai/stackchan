+/* Inside a tile (patch NX08): the picture box (48 by 44, centered, 6 px from the top), the dark label plate under it (the title in the 24 px font on
+ * a plate, so the words never sit on busy art) and, on the games wall, the best score as a small pill in the top right corner. */
+#define MAC_TILE_ART_W 48
+#define MAC_TILE_ART_H 44
+#define MAC_TILE_ART_Y 6
+#define MAC_TILE_PLATE_H 28
+#define MAC_TILE_PLATE_PAD 4
+static inline void mac_tile_art_box(int* x, int* y, int* w, int* h) { *x = (MAC_WALL_TILE_W - MAC_TILE_ART_W) / 2; *y = MAC_TILE_ART_Y; *w = MAC_TILE_ART_W; *h = MAC_TILE_ART_H; }
+static inline void mac_tile_plate_box(int* x, int* y, int* w, int* h) { *x = MAC_TILE_PLATE_PAD; *y = MAC_WALL_TILE_H - MAC_TILE_PLATE_PAD - MAC_TILE_PLATE_H; *w = MAC_WALL_TILE_W - 2 * MAC_TILE_PLATE_PAD; *h = MAC_TILE_PLATE_H; }
+
+/* Each item's own accent, 0xRRGGBB: the tile's background is this color at a quarter strength, its border at two thirds, and the picture is drawn in
+ * the bright color. Words stay on the dark plate and every item has its own picture, so color is never the only sign. */
+static const uint32_t MAC_APP_ACCENT[MAC_APP_COUNT] = {0x28BEBE /* timers */, 0xFAAA28 /* alarms */, 0x5AAAFF /* clock */, 0x965AE6 /* quick actions */,
+                                                       0x46BE6E /* pictures */, 0xF0783C /* dashboard */, 0xE646AA /* dance */, 0xA8B4C8 /* lock */};
+static inline uint32_t mac_game_accent(const char* id)
+{
+    static const struct { const char* id; uint32_t c; } T[] = {{"memory", 0x5B6CF0}, {"whack", 0x46A83C}, {"tictactoe", 0x2FA8C8}, {"bopit", 0x2F78F0},
+                                                              {"rps", 0xF09A32}, {"eightball", 0x7A5AD8}, {"dice", 0xD8505A}};
+    for (unsigned i = 0; id != NULL && i < sizeof(T) / sizeof(T[0]); i++) {
+        if (strcmp(T[i].id, id) == 0) {
+            return T[i].c;
+        }
+    }
+    return 0x8C96AA;
+}
+/* Strength in percent of an accent color for the tile (background, border, pressed). The tile never gets lighter than the label plate's contrast needs. */
+#define MAC_TILE_BG_PCT 26
+#define MAC_TILE_BORDER_PCT 70
+#define MAC_TILE_PRESSED_PCT 48
+static inline void mac_rgb(uint32_t c, int* r, int* g, int* b) { *r = (int)((c >> 16) & 255u); *g = (int)((c >> 8) & 255u); *b = (int)(c & 255u); }
+/* The relative brightness (0 to 255, integer luma) of an accent at a strength: the test keeps the tile background dark enough for light words. */
+static inline int mac_luma_pct(uint32_t c, int pct)
+{
+    int r, g, b;
+    mac_rgb(c, &r, &g, &b);
+    return ((r * 54 + g * 183 + b * 19) / 256) * pct / 100;
+}
+
 static inline int mac_wall_pages(int total) { return total <= 0 ? 1 : (total + MAC_WALL_PER_PAGE - 1) / MAC_WALL_PER_PAGE; }
