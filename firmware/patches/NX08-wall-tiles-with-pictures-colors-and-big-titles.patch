+// ---- patch NX08: the pictures of the wall tiles, drawn from LVGL shapes when the wall opens and freed with it (no bitmap, no font) ----
+lv_color_t acc(uint32_t c, int pct = 100)
+{
+    int r, g, b;
+    mac_rgb(c, &r, &g, &b);
+    return shade(lv_color_make((uint8_t)r, (uint8_t)g, (uint8_t)b), pct * night_pct() / 100);
+}
+lv_obj_t* disc(lv_obj_t* p, int x, int y, int d, lv_color_t c) { return box(p, x, y, d, d, c, LV_RADIUS_CIRCLE); }
+lv_obj_t* hoop(lv_obj_t* p, int x, int y, int d, int bw, lv_color_t c)
+{
+    lv_obj_t* o = box(p, x, y, d, d, c, LV_RADIUS_CIRCLE);
+    lv_obj_set_style_bg_opa(o, LV_OPA_TRANSP, 0);
+    lv_obj_set_style_border_width(o, bw, 0);
+    lv_obj_set_style_border_color(o, c, 0);
+    return o;
+}
+lv_obj_t* stroke(lv_obj_t* p, const lv_point_precise_t* pts, int n, lv_color_t c, int w)
+{
+    lv_obj_t* l = lv_line_create(p);
+    lv_obj_remove_flag(l, LV_OBJ_FLAG_CLICKABLE);
+    lv_line_set_points(l, pts, static_cast<uint32_t>(n));
+    lv_obj_set_style_line_width(l, w, 0);
+    lv_obj_set_style_line_color(l, c, 0);
+    lv_obj_set_style_line_rounded(l, true, 0);
+    return l;
+}
