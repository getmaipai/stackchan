+// Counts every emotion change, so a word reaction (patch U02) only puts the face back if nothing else changed it.
+static std::atomic<uint32_t> s_emotion_seq{0};
+static lv_timer_t* s_react_timer = nullptr;
+
+// A word reaction's face (patch U02): drawn straight on the avatar, so it has none of the side effects of the host's
+// emotions (the sleepy emotion's "Zzz" bubble and its sleeping state). The face goes back to the resting one after
+// `hold_ms` unless another emotion was set meanwhile.
+void StackChanAvatarDisplay::ReactFace(const char* emotion, int hold_ms)
+{
+    auto& stackchan = GetStackChan();
+    if (!stackchan.hasAvatar() || emotion == nullptr || quiet_face_ || is_sleeping_) {
+        return;
+    }
+    DisplayLockGuard lock(this);
+    Emotion e = Emotion::Neutral;
+    if (strcmp(emotion, "happy") == 0) {
+        e = Emotion::Happy;
+    } else if (strcmp(emotion, "sad") == 0) {
+        e = Emotion::Sad;
+    } else if (strcmp(emotion, "angry") == 0) {
+        e = Emotion::Angry;
+    } else if (strcmp(emotion, "doubtful") == 0) {
+        e = Emotion::Doubt;
+    } else if (strcmp(emotion, "sleepy") == 0) {
+        e = Emotion::Sleepy;
+    } else {
+        return;
+    }
+    stackchan.avatar().setEmotion(e);
+    mood_baseline_ = false;
+    auto blink_modifier = static_cast<BlinkModifier*>(stackchan.getModifier(blink_modifier_id_));
+    if (blink_modifier) {
+        blink_modifier->resyncEyeWeights();
+    }
+    const uint32_t mine = ++s_emotion_seq;
+    if (s_react_timer != nullptr) {
+        lv_timer_delete(s_react_timer);
+    }
+    s_react_timer = lv_timer_create(
+        [](lv_timer_t* timer) {
+            const uint32_t seq = static_cast<uint32_t>(reinterpret_cast<uintptr_t>(lv_timer_get_user_data(timer)));
+            s_react_timer      = nullptr;
+            auto d             = static_cast<StackChanAvatarDisplay*>(Board::GetInstance().GetDisplay());
+            if (d != nullptr && s_emotion_seq.load() == seq) {
+                d->SetEmotion("neutral");
+            }
+        },
+        hold_ms > 0 ? hold_ms : 3500, reinterpret_cast<void*>(static_cast<uintptr_t>(mine)));
+    lv_timer_set_repeat_count(s_react_timer, 1);
+}
+
+void hal_bridge::react_face(const char* emotion, int hold_ms)
+{
+    auto display = static_cast<StackChanAvatarDisplay*>(Board::GetInstance().GetDisplay());
+    if (display != nullptr) {
+        display->ReactFace(emotion, hold_ms);
+    }
+}
