diff --git a/firmware/main/hal/maipai_react.cc b/firmware/main/hal/maipai_react.cc
new file mode 100644
--- /dev/null
+++ b/firmware/main/hal/maipai_react.cc
@@ -0,0 +1,274 @@
+/*
+ * SPDX-License-Identifier: MIT
+ *
+ * Word reactions, device side (patch U02). The table lives in RAM (about 1.1 KB) and in one small record in its own
+ * NVS namespace; with no record the built-in table is used. A matching line plays at most one reaction every 4 seconds
+ * and the same phrase at most every 20 seconds. No task and no timer of its own.
+ */
+#include <sdkconfig.h>
+#if CONFIG_MAIPAI_REACT
+#include "maipai_react.h"
+#include "maipai_react_core.h"
+#include "maipai_decor.h"
+#include "maipai_privacy.h"
+#include "maipai_sounds.h"
+#include "board/hal_bridge.h"
+#include "hal.h"
+#include <mcp_server.h>
+#include <cJSON.h>
+#include <esp_log.h>
+#include <esp_timer.h>
+#include <nvs.h>
+#include <nvs_flash.h>
+#include <cstdio>
+#include <mutex>
+#include <string>
+
+static const char* TAG        = "MAIPAI-REACT";
+static const char* kNamespace = "mp_react";  // our own
+static const char* kKey       = "t1";
+
+// Defined in hal_mcp.cpp: plays one of the built-in dances (the same code the self.robot.dance tool runs).
+bool maipai_dance_play(const char* name);
+
+namespace {
+std::mutex s_mutex;  // a leaf lock: nothing else is taken while it is held
+mr_table_t s_table;
+bool s_loaded        = false;
+bool s_saved_table   = false;  // false: the built-in table is in use
+int64_t s_last_at[MR_MAX] = {};
+int64_t s_last_any   = -MR_GAP_MS;
+
+int64_t now_ms()
+{
+    return esp_timer_get_time() / 1000;
+}
+
+void load_locked()
+{
+    if (s_loaded) {
+        return;
+    }
+    s_loaded = true;
+    mr_defaults(&s_table);
+    nvs_handle_t h;
+    if (nvs_open(kNamespace, NVS_READONLY, &h) != ESP_OK) {
+        return;
+    }
+    uint8_t buf[MR_BLOB_MAX];
+    size_t n = sizeof(buf);
+    if (nvs_get_blob(h, kKey, buf, &n) == ESP_OK) {
+        mr_table_t loaded;
+        if (mr_load(&loaded, buf, n) == MR_OK) {
+            s_table       = loaded;
+            s_saved_table = true;
+        } else {
+            ESP_LOGW(TAG, "saved reactions unreadable (%u bytes): using the built-in table", static_cast<unsigned>(n));
+        }
+    }
+    nvs_close(h);
+}
+
+bool save_locked(const mr_table_t& t)
+{
+    uint8_t buf[MR_BLOB_MAX];
+    const size_t n = mr_save(&t, buf, sizeof(buf));
+    nvs_handle_t h;
+    if (n == 0 || nvs_open(kNamespace, NVS_READWRITE, &h) != ESP_OK) {
+        return false;
+    }
+    const bool ok = nvs_set_blob(h, kKey, buf, n) == ESP_OK && nvs_commit(h) == ESP_OK;
+    nvs_close(h);
+    return ok;
+}
+
+bool erase_saved()
+{
+    nvs_handle_t h;
+    if (nvs_open(kNamespace, NVS_READWRITE, &h) != ESP_OK) {
+        return false;
+    }
+    nvs_erase_key(h, kKey);  // a missing key is fine: the built-in table is already in use
+    const bool ok = nvs_commit(h) == ESP_OK;
+    nvs_close(h);
+    return ok;
+}
+
+std::string table_json(const mr_table_t& t, bool builtin)
+{
+    cJSON* root = cJSON_CreateObject();
+    cJSON_AddBoolToObject(root, "ok", true);
+    cJSON_AddBoolToObject(root, "builtin", builtin);
+    cJSON* rows = cJSON_AddArrayToObject(root, "table");
+    for (int i = 0; i < t.n; i++) {
+        cJSON* r = cJSON_CreateObject();
+        cJSON_AddStringToObject(r, "say", t.e[i].phrase);
+        cJSON_AddStringToObject(r, "face", MR_FACES[t.e[i].face]);
+        cJSON_AddStringToObject(r, "sound", MR_SOUNDS[t.e[i].sound]);
+        cJSON_AddStringToObject(r, "decor", MD_NAMES[t.e[i].decor]);
+        cJSON_AddStringToObject(r, "dance", MR_DANCES[t.e[i].dance]);
+        cJSON_AddItemToArray(rows, r);
+    }
+    char* text = cJSON_PrintUnformatted(root);
+    std::string out = text != nullptr ? text : "{\"ok\":false,\"error\":\"out of memory: try again\"}";
+    cJSON_free(text);
+    cJSON_Delete(root);
+    return out;
+}
+
+std::string error_json(int err, int row)
+{
+    char buf[200];
+    snprintf(buf, sizeof(buf), "{\"ok\":false,\"error\":\"row %d: %s\"}", row + 1, mr_err_word(err));
+    return buf;
+}
+
+const char* str_of(const cJSON* obj, const char* key)
+{
+    const cJSON* it = cJSON_GetObjectItemCaseSensitive(obj, key);
+    return cJSON_IsString(it) && it->valuestring != nullptr ? it->valuestring : "";
+}
+
+void play(const mr_entry_t& e)
+{
+    if (e.face != 0) {
+        hal_bridge::react_face(MR_FACES[e.face], MR_HOLD_MS);
+    }
+#if CONFIG_MAIPAI_FACE_DECOR
+    if (e.decor != 0) {
+        LvglLockGuard lock;
+        maipai_decor_show(e.decor, 4);
+    }
+#endif
+    if (e.sound != 0) {
+        maipai_sounds_play(MR_SOUNDS[e.sound]);
+    }
+    if (e.dance != 0) {
+        maipai_dance_play(MR_DANCES[e.dance]);
+    }
+}
+}  // namespace
+
+void maipai_react_text(const char* role, const char* text)
+{
+    if (role == nullptr || text == nullptr || (strcmp(role, "user") != 0 && strcmp(role, "assistant") != 0)) {
+        return;
+    }
+    if (maipai_privacy_bits() != 0) {
+        return;  // a mute, vision-off or quiet look is not decorated or danced over
+    }
+    mr_entry_t hit;
+    {
+        std::lock_guard<std::mutex> lock(s_mutex);
+        load_locked();
+        const int i = mr_match(&s_table, text);
+        if (i < 0) {
+            return;
+        }
+        const int64_t now = now_ms();
+        if (now - s_last_any < MR_GAP_MS || now - s_last_at[i] < MR_COOLDOWN_MS) {
+            return;
+        }
+        s_last_any   = now;
+        s_last_at[i] = now;
+        hit          = s_table.e[i];
+    }
+    ESP_LOGI(TAG, "reaction: %s", hit.phrase);
+    play(hit);
+}
+
+void maipai_react_register_tools()
+{
+    auto& mcp = McpServer::GetInstance();
+    mcp.AddTool("self.reaction.get_table",
+                "The word reactions in force: each row has say (the words), face (none, happy, sad, angry, doubtful, "
+                "sleepy), sound (none, success, popup, goodbye, charged, needs_you, vibration), decor (a face "
+                "decorator or none) and dance (none, happy, robot, panic, look_around). builtin is true while no table "
+                "of your own is saved. Answers {ok,builtin,table}.",
+                std::vector<Property>{}, [](const PropertyList&) -> ReturnValue {
+                    std::lock_guard<std::mutex> lock(s_mutex);
+                    load_locked();
+                    return table_json(s_table, !s_saved_table);
+                });
+    mcp.AddTool("self.reaction.set_table",
+                "Replace the word reactions. table is a JSON list of rows like "
+                "[{\\\"say\\\":\\\"hello\\\",\\\"face\\\":\\\"happy\\\",\\\"sound\\\":\\\"\\\",\\\"decor\\\":\\\"sparkles\\\","
+                "\\\"dance\\\":\\\"\\\"}]. At most 40 rows; the words are 2 to 23 letters or numbers. Nothing changes unless "
+                "every row is valid. An empty list turns every reaction off. Answers the new table or {ok:false,error}.",
+                PropertyList({Property("table", kPropertyTypeString, std::string("[]"))}),
+                [](const PropertyList& properties) -> ReturnValue {
+                    const std::string text = properties["table"].value<std::string>();
+                    cJSON* root            = cJSON_Parse(text.c_str());
+                    if (root == nullptr || !cJSON_IsArray(root)) {
+                        cJSON_Delete(root);
+                        return std::string("{\"ok\":false,\"error\":\"table is not a JSON list: send rows like "
+                                           "{\\\"say\\\":\\\"hello\\\",\\\"face\\\":\\\"happy\\\"}\"}");
+                    }
+                    mr_table_t next;
+                    mr_clear(&next);
+                    const int rows = cJSON_GetArraySize(root);
+                    for (int i = 0; i < rows; i++) {
+                        const cJSON* row = cJSON_GetArrayItem(root, i);
+                        if (!cJSON_IsObject(row)) {
+                            cJSON_Delete(root);
+                            return error_json(MR_ERR_PHRASE, i);
+                        }
+                        const int err = mr_add(&next, str_of(row, "say"), str_of(row, "face"), str_of(row, "sound"),
+                                               str_of(row, "decor"), str_of(row, "dance"));
+                        if (err != MR_OK) {
+                            cJSON_Delete(root);
+                            return error_json(err, i);
+                        }
+                    }
+                    cJSON_Delete(root);
+                    std::lock_guard<std::mutex> lock(s_mutex);
+                    load_locked();
+                    if (!save_locked(next)) {
+                        return std::string("{\"ok\":false,\"error\":\"the table could not be saved: flash is not "
+                                           "writable, try again\"}");
+                    }
+                    s_table       = next;
+                    s_saved_table = true;
+                    return table_json(s_table, false);
+                });
+    mcp.AddTool("self.reaction.reset", "Go back to the built-in word reactions. Answers the table.",
+                std::vector<Property>{}, [](const PropertyList&) -> ReturnValue {
+                    std::lock_guard<std::mutex> lock(s_mutex);
+                    load_locked();
+                    if (!erase_saved()) {
+                        return std::string("{\"ok\":false,\"error\":\"the saved table could not be removed: try again\"}");
+                    }
+                    mr_defaults(&s_table);
+                    s_saved_table = false;
+                    return table_json(s_table, true);
+                });
+    mcp.AddTool("self.reaction.test",
+                "Say what the table would do for some words, without doing it: answers {ok,match,face,sound,decor,dance} "
+                "or {ok,match:false}. Set play true to run the reaction now (it still follows the mute and the sound "
+                "policy).",
+                PropertyList({Property("text", kPropertyTypeString, std::string("")),
+                              Property("play", kPropertyTypeBoolean, false)}),
+                [](const PropertyList& properties) -> ReturnValue {
+                    const std::string text = properties["text"].value<std::string>();
+                    mr_entry_t hit;
+                    {
+                        std::lock_guard<std::mutex> lock(s_mutex);
+                        load_locked();
+                        const int i = mr_match(&s_table, text.c_str());
+                        if (i < 0) {
+                            return std::string("{\"ok\":true,\"match\":false}");
+                        }
+                        hit = s_table.e[i];
+                    }
+                    if (properties["play"].value<bool>() && maipai_privacy_bits() == 0) {
+                        play(hit);
+                    }
+                    char buf[220];
+                    snprintf(buf, sizeof(buf),
+                             "{\"ok\":true,\"match\":true,\"say\":\"%s\",\"face\":\"%s\",\"sound\":\"%s\",\"decor\":\"%s\","
+                             "\"dance\":\"%s\"}",
+                             hit.phrase, MR_FACES[hit.face], MR_SOUNDS[hit.sound], MD_NAMES[hit.decor], MR_DANCES[hit.dance]);
+                    return std::string(buf);
+                });
+}
+#endif
