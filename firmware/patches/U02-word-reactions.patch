+/*
+ * SPDX-License-Identifier: MIT
+ *
+ * Word reactions, device side (patch U02). Logic: maipai_react_core.h. With CONFIG_MAIPAI_REACT off nothing here is
+ * compiled and the words the unit hears or says change nothing.
+ */
+#pragma once
+#include <sdkconfig.h>
+
+#if CONFIG_MAIPAI_REACT
+// The words of a line the person said or the unit is saying (role "user" or "assistant"). If they match a reaction
+// that is not cooling down, the reaction plays: a face for a few seconds, a quiet sound through the sound policy,
+// a decorator and optionally a dance. Safe from any task; takes the LVGL lock itself. Does nothing in a mute, a
+// vision-off or quiet look.
+void maipai_react_text(const char* role, const char* text);
+// Registers self.reaction.get_table, set_table, reset and test.
+void maipai_react_register_tools();
+#else
+inline void maipai_react_text(const char*, const char*) {}
+inline void maipai_react_register_tools() {}
+#endif
diff --git a/firmware/main/hal/maipai_react_core.h b/firmware/main/hal/maipai_react_core.h
new file mode 100644
--- /dev/null
+++ b/firmware/main/hal/maipai_react_core.h
@@ -0,0 +1,356 @@
+/*
+ * SPDX-License-Identifier: MIT
+ *
+ * Word reactions (patch U02): a data table that maps a few words or phrases, in several languages, to a face, a quiet
+ * sound, a decorator and optionally a dance. The pure logic: folding text for matching, the table, the checks and the
+ * saved record. Header-only plain C99 so a host compiler can test it; the device side is maipai_react.cc.
+ * Needs maipai_decor_core.h (the decorator names are defined there, once).
+ *
+ * Matching folds the text to lower-case ASCII with accents removed and punctuation turned into spaces, then looks for
+ * the phrase as whole words ("sorry" does not match "sorrow"). The longest matching phrase wins, so "thank you" beats
+ * "you". The table is saved as one small record; with none saved the built-in table (English, Spanish, French, German,
+ * Portuguese and Italian pairs) is used.
+ */
+#ifndef MAIPAI_REACT_CORE_H
+#define MAIPAI_REACT_CORE_H
+
+#include <stdint.h>
+#include <string.h>
+#include "maipai_decor_core.h"
+
+#define MR_MAX 40
+#define MR_PHRASE 24 /* folded phrase, with its end byte */
+#define MR_MIN_PHRASE 2
+#define MR_BLOB_VERSION 1
+
+#define MR_OK 0
+#define MR_ERR_PHRASE -1
+#define MR_ERR_FACE -2
+#define MR_ERR_SOUND -3
+#define MR_ERR_DECOR -4
+#define MR_ERR_DANCE -5
+#define MR_ERR_FULL -6
+#define MR_ERR_DUP -7
+#define MR_ERR_EMPTY -8
+#define MR_ERR_BLOB -9
+
+#define MR_FACE_COUNT 6
+static const char* const MR_FACES[MR_FACE_COUNT] = {"none", "happy", "sad", "angry", "doubtful", "sleepy"};
+
+/* The quiet sounds a reaction may use (not the alarm-like ones: exclamation, low_battery, offline). */
+#define MR_SOUND_COUNT 7
+static const char* const MR_SOUNDS[MR_SOUND_COUNT] = {"none",    "success",  "popup",     "goodbye",
+                                                      "charged", "needs_you", "vibration"};
+
+#define MR_DANCE_COUNT 5
+static const char* const MR_DANCES[MR_DANCE_COUNT] = {"none", "happy", "robot", "panic", "look_around"};
+
+#define MR_HOLD_MS 3500      /* how long a reaction face stays before the face goes back */
+#define MR_COOLDOWN_MS 20000 /* the same phrase does not react again inside this time */
+#define MR_GAP_MS 4000       /* nor does any reaction follow another this soon */
+
+typedef struct {
+    char phrase[MR_PHRASE]; /* folded: lower-case ASCII words separated by single spaces */
+    uint8_t face;           /* index into MR_FACES */
+    uint8_t sound;          /* index into MR_SOUNDS */
+    uint8_t decor;          /* an MD_* kind (0 none) */
+    uint8_t dance;          /* index into MR_DANCES */
+} mr_entry_t;
+
+typedef struct {
+    uint8_t n;
+    mr_entry_t e[MR_MAX];
+} mr_table_t;
+
+/* Lower-case ASCII, accents removed, anything else a single space, no leading or trailing space. Returns the length. */
+static inline int mr_fold(const char* in, char* out, int cap)
+{
+    int n = 0;
+    int pending_space = 0;
+    if (in == NULL || cap < 1) {
+        if (cap > 0) {
+            out[0] = '\0';
+        }
+        return 0;
+    }
+    for (const unsigned char* p = (const unsigned char*)in; *p != '\0'; p++) {
+        char c = 0;
+        const char* two = NULL;
+        if (*p < 0x80) {
+            if (*p >= 'A' && *p <= 'Z') {
+                c = (char)(*p - 'A' + 'a');
+            } else if ((*p >= 'a' && *p <= 'z') || (*p >= '0' && *p <= '9')) {
+                c = (char)*p;
+            } else if (*p == '\'') {
+                continue; /* "t'aime" reads as "taime"; the phrase is folded the same way */
+            }
+        } else if (*p == 0xC3 && p[1] != '\0') {
+            /* Latin-1 letters: the second byte 0x80 to 0xBF is the code point minus 0x40 */
+            static const char* const map =
+                "aaaaaaaceeeeiiiidnooooo/ouuuuytsaaaaaaaceeeeiiiidnooooo/ouuuuyty"; /* 0xC0 to 0xFF */
+            const int idx = p[1] - 0x80;
+            p++;
+            if (idx >= 0 && idx < 64) {
+                c = map[idx];
+                if (c == '/') {
+                    c = 0;
+                } else if (idx == 0x1F) { /* the sharp s */
+                    two = "ss";
+                } else if (idx == 0x06 || idx == 0x26) { /* the ae ligature */
+                    two = "ae";
+                }
+            }
+        } else if (*p >= 0xC0) { /* another multi-byte letter: a gap */
+            while (p[1] != '\0' && (p[1] & 0xC0) == 0x80) {
+                p++;
+            }
+        }
+        if (c == 0 && two == NULL) {
+            if (n > 0) {
+                pending_space = 1;
+            }
+            continue;
+        }
+        const char* src = two != NULL ? two : &c;
+        const int len = two != NULL ? 2 : 1;
+        if (pending_space && n < cap - 1) {
+            out[n++] = ' ';
+        }
+        pending_space = 0;
+        for (int k = 0; k < len && n < cap - 1; k++) {
+            out[n++] = src[k];
+        }
+    }
+    out[n] = '\0';
+    return n;
+}
+
+static inline int mr_index_of(const char* const* list, int count, const char* name)
+{
+    if (name == NULL || name[0] == '\0') {
+        return 0; /* an empty name means none */
+    }
+    for (int i = 0; i < count; i++) {
+        if (strcmp(list[i], name) == 0) {
+            return i;
+        }
+    }
+    return -1;
+}
+
+static inline const char* mr_err_word(int err)
+{
+    switch (err) {
+        case MR_ERR_PHRASE: return "the words must be 2 to 23 letters or numbers";
+        case MR_ERR_FACE: return "the face must be none, happy, sad, angry, doubtful or sleepy";
+        case MR_ERR_SOUND: return "the sound must be none, success, popup, goodbye, charged, needs_you or vibration";
+        case MR_ERR_DECOR: return "the decorator must be none, sweat, shy, dizzy, heart, anger, tears, sparkles, stars or zzz";
+        case MR_ERR_DANCE: return "the dance must be none, happy, robot, panic or look_around";
+        case MR_ERR_FULL: return "the table holds at most 40 reactions";
+        case MR_ERR_DUP: return "those words are already in the table";
+        case MR_ERR_EMPTY: return "a reaction needs at least a face, a sound, a decorator or a dance";
+        case MR_ERR_BLOB: return "the saved table was damaged";
+        default: return "ok";
+    }
+}
+
+static inline void mr_clear(mr_table_t* t) { memset(t, 0, sizeof(*t)); }
+
+/* Adds one reaction. The phrase is folded here. Nothing is added on an error. */
+static inline int mr_add(mr_table_t* t, const char* phrase, const char* face, const char* sound, const char* decor,
+                         const char* dance)
+{
+    mr_entry_t e;
+    memset(&e, 0, sizeof(e));
+    char folded[MR_PHRASE + 8];
+    /* a phrase longer than the limit folds to more than the limit: refuse it rather than cut it */
+    const int len = mr_fold(phrase, folded, (int)sizeof(folded));
+    if (len < MR_MIN_PHRASE || len >= MR_PHRASE) {
+        return MR_ERR_PHRASE;
+    }
+    const int f = mr_index_of(MR_FACES, MR_FACE_COUNT, face);
+    if (f < 0) return MR_ERR_FACE;
+    const int s = mr_index_of(MR_SOUNDS, MR_SOUND_COUNT, sound);
+    if (s < 0) return MR_ERR_SOUND;
+    const int d = (decor == NULL || decor[0] == '\0') ? 0 : md_from_name(decor);
+    if (d < 0) return MR_ERR_DECOR;
+    const int a = mr_index_of(MR_DANCES, MR_DANCE_COUNT, dance);
+    if (a < 0) return MR_ERR_DANCE;
+    if (f == 0 && s == 0 && d == 0 && a == 0) {
+        return MR_ERR_EMPTY;
+    }
+    if (t->n >= MR_MAX) {
+        return MR_ERR_FULL;
+    }
+    for (int i = 0; i < t->n; i++) {
+        if (strcmp(t->e[i].phrase, folded) == 0) {
+            return MR_ERR_DUP;
+        }
+    }
+    memcpy(e.phrase, folded, (size_t)len + 1);
+    e.face = (uint8_t)f;
+    e.sound = (uint8_t)s;
+    e.decor = (uint8_t)d;
+    e.dance = (uint8_t)a;
+    t->e[t->n++] = e;
+    return MR_OK;
+}
+
+/* The index of the reaction for `text`, or -1. The longest phrase wins; on a tie the earlier row wins. */
+static inline int mr_match(const mr_table_t* t, const char* text)
+{
+    char folded[162];
+    const int len = mr_fold(text, folded, (int)sizeof(folded) - 2);
+    if (len == 0) {
+        return -1;
+    }
+    /* pad with a space on each side so every phrase is looked for as whole words */
+    char hay[170];
+    hay[0] = ' ';
+    memcpy(hay + 1, folded, (size_t)len);
+    hay[len + 1] = ' ';
+    hay[len + 2] = '\0';
+    int best = -1;
+    int best_len = 0;
+    for (int i = 0; i < t->n; i++) {
+        char needle[MR_PHRASE + 2];
+        const int pl = (int)strlen(t->e[i].phrase);
+        needle[0] = ' ';
+        memcpy(needle + 1, t->e[i].phrase, (size_t)pl);
+        needle[pl + 1] = ' ';
+        needle[pl + 2] = '\0';
+        if (strstr(hay, needle) != NULL && pl > best_len) {
+            best = i;
+            best_len = pl;
+        }
+    }
+    return best;
+}
+
+/* Built-in pairs. Rows: phrase, face, sound, decorator, dance. */
+typedef struct {
+    const char* phrase;
+    const char* face;
+    const char* sound;
+    const char* decor;
+    const char* dance;
+} mr_default_t;
+
+static const mr_default_t MR_DEFAULTS[] = {
+    /* English */
+    {"hello", "happy", "", "sparkles", ""},
+    {"thanks", "happy", "success", "sparkles", ""},
+    {"thank you", "happy", "success", "sparkles", ""},
+    {"love", "happy", "", "heart", "happy"},
+    {"sorry", "sad", "", "sweat", ""},
+    {"good night", "sleepy", "goodbye", "zzz", ""},
+    /* Spanish */
+    {"hola", "happy", "", "sparkles", ""},
+    {"gracias", "happy", "success", "sparkles", ""},
+    {"te quiero", "happy", "", "heart", "happy"},
+    {"lo siento", "sad", "", "sweat", ""},
+    {"buenas noches", "sleepy", "goodbye", "zzz", ""},
+    /* French */
+    {"bonjour", "happy", "", "sparkles", ""},
+    {"merci", "happy", "success", "sparkles", ""},
+    {"je taime", "happy", "", "heart", "happy"},
+    {"je t aime", "happy", "", "heart", "happy"},
+    {"desole", "sad", "", "sweat", ""},
+    {"bonne nuit", "sleepy", "goodbye", "zzz", ""},
+    /* German */
+    {"hallo", "happy", "", "sparkles", ""},
+    {"danke", "happy", "success", "sparkles", ""},
+    {"ich liebe dich", "happy", "", "heart", "happy"},
+    {"tut mir leid", "sad", "", "sweat", ""},
+    {"gute nacht", "sleepy", "goodbye", "zzz", ""},
+    /* Portuguese */
+    {"ola", "happy", "", "sparkles", ""},
+    {"obrigado", "happy", "success", "sparkles", ""},
+    {"obrigada", "happy", "success", "sparkles", ""},
+    {"te amo", "happy", "", "heart", "happy"},
+    {"desculpa", "sad", "", "sweat", ""},
+    {"boa noite", "sleepy", "goodbye", "zzz", ""},
+    /* Italian */
+    {"ciao", "happy", "", "sparkles", ""},
+    {"grazie", "happy", "success", "sparkles", ""},
+    {"ti voglio bene", "happy", "", "heart", "happy"},
+    {"scusa", "sad", "", "sweat", ""},
+    {"buonanotte", "sleepy", "goodbye", "zzz", ""},
+};
+#define MR_DEFAULT_COUNT ((int)(sizeof(MR_DEFAULTS) / sizeof(MR_DEFAULTS[0])))
+
+static inline void mr_defaults(mr_table_t* t)
+{
+    mr_clear(t);
+    for (int i = 0; i < MR_DEFAULT_COUNT && i < MR_MAX; i++) {
+        (void)mr_add(t, MR_DEFAULTS[i].phrase, MR_DEFAULTS[i].face, MR_DEFAULTS[i].sound, MR_DEFAULTS[i].decor,
+                     MR_DEFAULTS[i].dance);
+    }
+}
+
+/* ---- the saved record: version, count, rows, one checksum byte ---- */
+
+#define MR_ROW_BYTES (MR_PHRASE + 4)
+#define MR_BLOB_MAX (2 + MR_MAX * MR_ROW_BYTES + 1)
+
+static inline uint8_t mr_sum(const uint8_t* p, size_t n)
+{
+    uint8_t s = 0x5A;
+    for (size_t i = 0; i < n; i++) {
+        s = (uint8_t)((s << 1 | s >> 7) ^ p[i]);
+    }
+    return s;
+}
+
+static inline size_t mr_save(const mr_table_t* t, uint8_t* out, size_t cap)
+{
+    const size_t need = 2 + (size_t)t->n * MR_ROW_BYTES + 1;
+    if (cap < need) {
+        return 0;
+    }
+    out[0] = MR_BLOB_VERSION;
+    out[1] = t->n;
+    size_t o = 2;
+    for (int i = 0; i < t->n; i++) {
+        memcpy(out + o, t->e[i].phrase, MR_PHRASE);
+        out[o + MR_PHRASE] = t->e[i].face;
+        out[o + MR_PHRASE + 1] = t->e[i].sound;
+        out[o + MR_PHRASE + 2] = t->e[i].decor;
+        out[o + MR_PHRASE + 3] = t->e[i].dance;
+        o += MR_ROW_BYTES;
+    }
+    out[o] = mr_sum(out, o);
+    return o + 1;
+}
+
+/* Reads a record into `t`. On any damage `t` is left empty and MR_ERR_BLOB comes back. */
+static inline int mr_load(mr_table_t* t, const uint8_t* in, size_t len)
+{
+    mr_clear(t);
+    if (in == NULL || len < 3 || in[0] != MR_BLOB_VERSION || in[1] > MR_MAX) {
+        return MR_ERR_BLOB;
+    }
+    const size_t need = 2 + (size_t)in[1] * MR_ROW_BYTES + 1;
+    if (len != need || in[need - 1] != mr_sum(in, need - 1)) {
+        return MR_ERR_BLOB;
+    }
+    size_t o = 2;
+    for (int i = 0; i < in[1]; i++) {
+        mr_entry_t* e = &t->e[i];
+        memcpy(e->phrase, in + o, MR_PHRASE);
+        e->face = in[o + MR_PHRASE];
+        e->sound = in[o + MR_PHRASE + 1];
+        e->decor = in[o + MR_PHRASE + 2];
+        e->dance = in[o + MR_PHRASE + 3];
+        o += MR_ROW_BYTES;
+        if (e->phrase[MR_PHRASE - 1] != '\0' || e->face >= MR_FACE_COUNT || e->sound >= MR_SOUND_COUNT ||
+            e->decor >= MD_COUNT || e->dance >= MR_DANCE_COUNT) {
+            mr_clear(t);
+            return MR_ERR_BLOB;
+        }
+    }
+    t->n = in[1];
+    return MR_OK;
+}
+
+#endif
diff --git a/firmware/sdkconfig.core.defaults b/firmware/sdkconfig.core.defaults
--- a/firmware/sdkconfig.core.defaults
+++ b/firmware/sdkconfig.core.defaults
@@ -13,6 +13,7 @@ CONFIG_MAIPAI_FACE_CLOCK=y
 CONFIG_MAIPAI_FACE_THINKING=y
 CONFIG_MAIPAI_FACE_TIMERS=y
 CONFIG_MAIPAI_FACE_DECOR=y
