# Intent: Skip remote activation and OTA checks and open the provisioned websocket.
# Placement: unit (local pairing and voice channel configuration)
diff --git a/firmware/main/Kconfig.projbuild b/firmware/main/Kconfig.projbuild
index c19aa66..aef1819 100644
--- a/firmware/main/Kconfig.projbuild
+++ b/firmware/main/Kconfig.projbuild
@@ -1,5 +1,11 @@
 menu "StackChan Server"
 
+config STACKCHAN_OTA_CHECK
+    bool "Check remote OTA and activation service"
+    default n
+    help
+        Enable remote activation and firmware checks. Leave disabled when the websocket endpoint is provisioned in NVS.
+
 config STACKCHAN_SERVER_URL
     string "StackChan server base URL"
     default "http://47.113.125.164:12800"
diff --git a/firmware/xiaozhi-esp32/main/application.cc b/firmware/xiaozhi-esp32/main/application.cc
--- a/firmware/xiaozhi-esp32/main/application.cc
+++ b/firmware/xiaozhi-esp32/main/application.cc
@@ -366,11 +366,10 @@
     // Create OTA object for activation process
     ota_ = std::make_unique<Ota>();
 
-    // Check for new assets version
-    CheckAssetsVersion();
-
-    // Check for new firmware version
+#if CONFIG_STACKCHAN_OTA_CHECK
+    CheckAssetsVersion();
     CheckNewVersion();
+#endif
 
     // Initialize the protocol
     InitializeProtocol();
@@ -535,6 +534,7 @@
 
     display->SetStatus(Lang::Strings::LOADING_PROTOCOL);
 
+#if CONFIG_STACKCHAN_OTA_CHECK
     if (ota_->HasMqttConfig()) {
         protocol_ = std::make_unique<MqttProtocol>();
     } else if (ota_->HasWebsocketConfig()) {
@@ -543,6 +543,9 @@
         ESP_LOGW(TAG, "No protocol specified in the OTA config, using MQTT");
         protocol_ = std::make_unique<MqttProtocol>();
     }
+#else
+    protocol_ = std::make_unique<WebsocketProtocol>();
+#endif
 
     protocol_->OnConnected([this]() { DismissAlert(); });
 
