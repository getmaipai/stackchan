+// Patch SF26 (bench): which TDM slot is the second channel; the input is reopened when it is on.
+void CoreS3AudioCodec::SetTalkSlot(int slot) {
+    if (slot < 1 || slot > 3 || slot == s_talk_slot) {
+        return;
+    }
+    s_talk_slot = slot;
+    if (input_enabled_) {
+        EnableInput(false);
+        EnableInput(true);
+    }
+}
+
+void maipai_mic3_set_slot(int slot) {
+    if (auto* codec = CoreS3AudioCodec::Instance()) {
+        codec->SetTalkSlot(slot);
+    }
+}
+
+int maipai_mic3_get_slot() { return s_talk_slot; }
