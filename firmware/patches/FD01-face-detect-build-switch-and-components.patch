@@ -0,0 +1,8 @@
+# Patch FD01: the face detection experiment (bench image only). Rides on top of sdkconfig.bench.defaults and sdkconfig.gate.defaults.
+CONFIG_MAIPAI_FACE_DETECT=y
+CONFIG_MAIPAI_FACE_TRACK=y
+# The model package: both model families in the app image as read-only data, no partition change.
+CONFIG_FLASH_HUMAN_FACE_DETECT_MSRMNP_S8_V1=y
+CONFIG_FLASH_ESPDET_PICO_224_224_FACE=y
+CONFIG_FLASH_ESPDET_PICO_416_416_FACE=n
+CONFIG_HUMAN_FACE_DETECT_MODEL_IN_FLASH_RODATA=y
