+    depends on MAIPAI_FACE_TRACK
+    default n
+
+config MAIPAI_FACE_TRACK_HOUR_MIN
+    int "Most minutes of tracking in one hour (servo wear ceiling)"
+    depends on MAIPAI_FACE_TRACK
