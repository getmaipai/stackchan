+# Face detection experiment (patch FD01): esp-dl and the face model package are in the build only when CONFIG_MAIPAI_FACE_DETECT
+# is on (main/idf_component.yml); the models ride in the app image as flash data (read in place), picked by sdkconfig.fdetect.defaults.
+if(CONFIG_MAIPAI_FACE_DETECT)
+    idf_component_optional_requires(PRIVATE espressif__esp-dl espressif__human_face_detect)
+    # esp-dl compiles all 81 operators (1.44 MB of code) unless told which the models use: maipai_facedet.compile_req.yml names the
+    # ten the two face model families need (made by scripts/fw-facedet-req.py from the downloaded models).
+    idf_build_get_property(MAIPAI_FD_COMPONENTS BUILD_COMPONENTS)
+    if("espressif__esp-dl" IN_LIST MAIPAI_FD_COMPONENTS)
+        idf_component_get_property(MAIPAI_FD_DL_DIR espressif__esp-dl COMPONENT_DIR)
+        include(${MAIPAI_FD_DL_DIR}/cmake/compile_register.cmake)
+        esp_dl_compile_add_yml(${CMAKE_CURRENT_LIST_DIR}/../maipai_facedet.compile_req.yml)
+    endif()
+    message(STATUS "Face detection: on (esp-dl and human_face_detect, models in the app image)")
+endif()
+
