+/* SPDX-License-Identifier: MIT
+ * Patch FD01: stand-in for the voice bench clips on the face detection image (CONFIG_MAIPAI_FACE_DETECT). The 562 KB of speech does not
+ * fit the 5 MB app slot next to the detector library, so seven one-sample silences keep the voice bench linking. The voice bench is not
+ * meant to run on this image. Only built with the switch on (main/CMakeLists.txt drops maipai_bench_clips.c then). */
+#include <sdkconfig.h>
+#include <stdint.h>
+#if defined(CONFIG_MAIPAI_FACE_DETECT) && CONFIG_MAIPAI_FACE_DETECT && defined(CONFIG_MAIPAI_SERIAL_TOOLS)
+const int g_bench_clip_count = 7;
+const uint32_t g_bench_clip_off[] = {0, 1, 2, 3, 4, 5, 6};
+const uint32_t g_bench_clip_len[] = {1, 1, 1, 1, 1, 1, 1};
+const int16_t g_bench_clips[7] = {0, 0, 0, 0, 0, 0, 0};
+#endif
