+    default 0 if MAIPAI_FACE_DETECT_MODEL_MSRMNP
+    default 1 if MAIPAI_FACE_DETECT_MODEL_PICO224
+
+config MAIPAI_FACE_DETECT_RATE_HZ
+    int "Detections a second while looking (2 to 5)"
+    range 2 5
+    default 3
+
+config MAIPAI_FACE_DETECT_SCORE_PCT
+    int "Smallest score that counts as a face, in percent"
+    range 30 95
+    default 50
+
+config MAIPAI_FACE_DETECT_UNLOAD_S
+    int "Seconds after the last use before the model is freed"
+    range 3 120
+    default 10
+
+config MAIPAI_FACE_DETECT_MIN_FREE_INTERNAL
+    int "Internal RAM that must be free before a model loads, in bytes"
+    default 40000
+
+config MAIPAI_FACE_DETECT_MIN_BLOCK_INTERNAL
+    int "Largest internal block that must exist before a model loads, in bytes"
+    default 24000
+
+config MAIPAI_FACE_TRACK
+    bool "The seeker's head follows a detected face (patch FD04); the runtime switch starts off"
+    default n
+    help
+        Compiles the face tracker (pan and tilt control with a dead band, a rate limit, a wear budget and a stall guard) into the seek
+        task. The tracker still does nothing until self.look.detect_track turns it on (it never starts by itself after a boot), and
+        never runs while a host holds the look lease, the unit is asleep, locked, carried or muted. Off: no code.
+
+config MAIPAI_FACE_TRACK_TILT
