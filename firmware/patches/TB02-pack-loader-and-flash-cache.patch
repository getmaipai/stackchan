# Intent: The shared pack loader (owner decision 2026-11-16): one way for every optional data set (look, language, filler, sound, dance, game) to reach the robot. self.pack.status, begin, data, commit and remove, in the host's own shapes (host/maipai_body/packs.py). The unit checks the SHA-256 of the whole payload, size-gates by type, gives the pack to its user (the picture-face look, the filler sounds) and writes it to a flash cache only when it differs from what the cache holds. The cache is the last 1,572,864 bytes of the assets partition (it starts at 4,653,056; the asset image is 4,463,226), two ping-pong directory sectors and 4 KB data sectors, written data first then directory, so a power cut leaves the old pack, the new pack or the built-in set. It is scanned at boot with a checksum of every held pack; a missing or damaged pack means the built-in set, and status says which. Picture faces move onto it: a look pack is a zip with look.json and one stored file per frame; maipai_picface_apply_look builds the pack from it and shows it like the older facepic.commit (which is now one shared function). The self.facepic.* tools stay for hosts that still use them; they do not persist.
# Placement: unit (the cache is the robot's own flash; the host library is the host's)
# Upstream: firmware/main/hal/maipai_picface.{h,cc} (ours, H03, H04); new hal/maipai_pack_core.h, maipai_packcache_core.h, maipai_packs.{h,cc}; miniz as the picture faces already use it
# Check after a flash: self.pack.status for each type; send a look pack, power cycle with the host off, and the look is back; flip a bit of the cache (bench) and status says damaged and the face is Big eyes; read the flash back hash of the region.

diff --git a/firmware/main/hal/maipai_pack_core.h b/firmware/main/hal/maipai_pack_core.h
new file mode 100644
index 0000000..3a82e41
--- /dev/null
+++ b/firmware/main/hal/maipai_pack_core.h
@@ -0,0 +1,449 @@
+/*
+ * SPDX-License-Identifier: MIT
+ *
+ * The shared pack loader (patch TB02): the pure logic. One way to get an optional data set onto the robot, for every
+ * kind of set: looks, languages, filler sounds, sounds, dances, games. The host holds the library and sends only the
+ * pack the person picked; the unit keeps the active one of each type in flash (maipai_packcache_core.h), checks its
+ * checksum at boot, and falls back to the built-in set when a pack is missing or damaged.
+ *
+ * What a pack is: a type, a name, a version, a size, a SHA-256 of the payload, and the payload, which is a zip file
+ * (stored or deflated entries). This file holds: SHA-256, the receiver (begin, data in order, commit with the checksum
+ * test), the size gate per type, and a zip walker that never trusts the file: every offset and size is checked against
+ * the buffer before it is used. Plain C99, no hardware, no allocation: the caller owns the buffer.
+ * Host test (with damaged packs fuzzed): host/tests/firmware/pack_core_test.c.
+ */
+#ifndef MAIPAI_PACK_CORE_H
+#define MAIPAI_PACK_CORE_H
+
+#include <stddef.h>
+#include <stdint.h>
+#include <string.h>
+
+/* ---- types and the size gate (the numbers are the host's: host/maipai_body/packs.py MAX_BYTES) ---- */
+
+#define TPK_LOOK 0
+#define TPK_LANGUAGE 1
+#define TPK_FILLER 2
+#define TPK_SOUND 3
+#define TPK_DANCE 4
+#define TPK_GAME 5
+#define TPK_TYPES 6
+
+static const char* const TPK_TYPE_NAMES[TPK_TYPES] = {"look", "language", "filler", "sound", "dance", "game"};
+static const uint32_t TPK_MAX_BYTES[TPK_TYPES]     = {1000000u, 200000u, 400000u, 400000u, 100000u, 200000u};
+#define TPK_NAME_MAX 40 /* characters, with the end mark 41 bytes */
+
+static inline int tpk_type_by_name(const char* name)
+{
+    if (name == NULL) return -1;
+    for (int i = 0; i < TPK_TYPES; i++) {
+        if (strcmp(name, TPK_TYPE_NAMES[i]) == 0) return i;
+    }
+    return -1;
+}
+
+/* A name is 1 to 40 of letters, digits, space, dot, dash, underscore, and starts with a letter or digit. */
+static inline int tpk_name_ok(const char* s)
+{
+    if (s == NULL) return 0;
+    const size_t n = strlen(s);
+    if (n == 0 || n > TPK_NAME_MAX) return 0;
+    for (size_t i = 0; i < n; i++) {
+        const char c = s[i];
+        const int alnum = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9');
+        if (i == 0 && !alnum) return 0;
+        if (!alnum && c != ' ' && c != '.' && c != '-' && c != '_') return 0;
+    }
+    return 1;
+}
+
+/* ---- SHA-256 (FIPS 180-4) ---- */
+
+typedef struct {
+    uint32_t h[8];
+    uint8_t buf[64];
+    uint64_t total;
+    uint32_t fill;
+} tpk_sha_t;
+
+static const uint32_t TPK_K[64] = {
+    0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5, 0xd807aa98, 0x12835b01, 0x243185be,
+    0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174, 0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa,
+    0x5cb0a9dc, 0x76f988da, 0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967, 0x27b70a85,
+    0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85, 0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3,
+    0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070, 0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f,
+    0x682e6ff3, 0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2};
+
+#define TPK_ROR(x, n) (((x) >> (n)) | ((x) << (32 - (n))))
+
+static inline void tpk_sha_block(tpk_sha_t* s, const uint8_t* p)
+{
+    uint32_t w[64];
+    for (int i = 0; i < 16; i++) {
+        w[i] = ((uint32_t)p[4 * i] << 24) | ((uint32_t)p[4 * i + 1] << 16) | ((uint32_t)p[4 * i + 2] << 8) | (uint32_t)p[4 * i + 3];
+    }
+    for (int i = 16; i < 64; i++) {
+        const uint32_t s0 = TPK_ROR(w[i - 15], 7) ^ TPK_ROR(w[i - 15], 18) ^ (w[i - 15] >> 3);
+        const uint32_t s1 = TPK_ROR(w[i - 2], 17) ^ TPK_ROR(w[i - 2], 19) ^ (w[i - 2] >> 10);
+        w[i]              = w[i - 16] + s0 + w[i - 7] + s1;
+    }
+    uint32_t a = s->h[0], b = s->h[1], c = s->h[2], d = s->h[3], e = s->h[4], f = s->h[5], g = s->h[6], h = s->h[7];
+    for (int i = 0; i < 64; i++) {
+        const uint32_t S1  = TPK_ROR(e, 6) ^ TPK_ROR(e, 11) ^ TPK_ROR(e, 25);
+        const uint32_t ch  = (e & f) ^ (~e & g);
+        const uint32_t t1  = h + S1 + ch + TPK_K[i] + w[i];
+        const uint32_t S0  = TPK_ROR(a, 2) ^ TPK_ROR(a, 13) ^ TPK_ROR(a, 22);
+        const uint32_t maj = (a & b) ^ (a & c) ^ (b & c);
+        const uint32_t t2  = S0 + maj;
+        h = g; g = f; f = e; e = d + t1; d = c; c = b; b = a; a = t1 + t2;
+    }
+    s->h[0] += a; s->h[1] += b; s->h[2] += c; s->h[3] += d; s->h[4] += e; s->h[5] += f; s->h[6] += g; s->h[7] += h;
+}
+
+static inline void tpk_sha_init(tpk_sha_t* s)
+{
+    static const uint32_t iv[8] = {0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19};
+    memcpy(s->h, iv, sizeof(iv));
+    s->total = 0;
+    s->fill  = 0;
+}
+
+static inline void tpk_sha_update(tpk_sha_t* s, const uint8_t* data, size_t len)
+{
+    s->total += len;
+    while (len > 0) {
+        if (s->fill == 0 && len >= 64) {
+            tpk_sha_block(s, data);
+            data += 64;
+            len -= 64;
+            continue;
+        }
+        size_t take = 64 - s->fill;
+        if (take > len) take = len;
+        memcpy(s->buf + s->fill, data, take);
+        s->fill += (uint32_t)take;
+        data += take;
+        len -= take;
+        if (s->fill == 64) {
+            tpk_sha_block(s, s->buf);
+            s->fill = 0;
+        }
+    }
+}
+
+static inline void tpk_sha_final(tpk_sha_t* s, uint8_t out[32])
+{
+    const uint64_t bits = s->total * 8u;
+    uint8_t pad         = 0x80;
+    tpk_sha_update(s, &pad, 1);
+    pad = 0;
+    while (s->fill != 56) {
+        tpk_sha_update(s, &pad, 1);
+    }
+    uint8_t len[8];
+    for (int i = 0; i < 8; i++) len[i] = (uint8_t)(bits >> (56 - 8 * i));
+    tpk_sha_update(s, len, 8);
+    for (int i = 0; i < 8; i++) {
+        out[4 * i]     = (uint8_t)(s->h[i] >> 24);
+        out[4 * i + 1] = (uint8_t)(s->h[i] >> 16);
+        out[4 * i + 2] = (uint8_t)(s->h[i] >> 8);
+        out[4 * i + 3] = (uint8_t)(s->h[i]);
+    }
+}
+
+static inline void tpk_sha_hex(const uint8_t d[32], char out[65])
+{
+    static const char hx[] = "0123456789abcdef";
+    for (int i = 0; i < 32; i++) {
+        out[2 * i]     = hx[d[i] >> 4];
+        out[2 * i + 1] = hx[d[i] & 15];
+    }
+    out[64] = 0;
+}
+
+/* 64 hex digits (either case) to 32 bytes; 0 when it is anything else. */
+static inline int tpk_sha_from_hex(const char* s, uint8_t out[32])
+{
+    if (s == NULL || strlen(s) != 64) return 0;
+    for (int i = 0; i < 32; i++) {
+        int v[2];
+        for (int k = 0; k < 2; k++) {
+            const char c = s[2 * i + k];
+            v[k]         = (c >= '0' && c <= '9') ? c - '0' : (c >= 'a' && c <= 'f') ? c - 'a' + 10 : (c >= 'A' && c <= 'F') ? c - 'A' + 10 : -1;
+            if (v[k] < 0) return 0;
+        }
+        out[i] = (uint8_t)(v[0] * 16 + v[1]);
+    }
+    return 1;
+}
+
+/* CRC-32 (zlib's, the zip format's). Start with 0. */
+static inline uint32_t tpk_crc32(uint32_t crc, const uint8_t* p, size_t n)
+{
+    crc = ~crc;
+    for (size_t i = 0; i < n; i++) {
+        crc ^= p[i];
+        for (int k = 0; k < 8; k++) crc = (crc >> 1) ^ (0xEDB88320u & (0u - (crc & 1u)));
+    }
+    return ~crc;
+}
+
+/* ---- errors, each with plain words (what went wrong, then what to do) ---- */
+
+typedef enum {
+    TPK_OK = 0,
+    TPK_ERR_TYPE,
+    TPK_ERR_NAME,
+    TPK_ERR_SIZE,    /* zero, or over the gate for the type */
+    TPK_ERR_SUM,     /* the checksum text is not 64 hex digits */
+    TPK_ERR_ORDER,   /* a piece arrived out of order */
+    TPK_ERR_RANGE,   /* a piece runs past the end */
+    TPK_ERR_NOT_STARTED,
+    TPK_ERR_SHORT,   /* commit before every byte arrived */
+    TPK_ERR_MISMATCH,/* the checksum does not match the bytes */
+    TPK_ERR_ZIP,     /* the payload is not a zip file the robot can read */
+    TPK_ERR_MEMORY,
+    TPK_ERR_FLASH,   /* the flash cache could not be written (the pack still works until the next restart) */
+    TPK_ERR_FULL,    /* the flash cache has no room for it */
+    TPK_ERR_BUSY,    /* an earlier pack is still being saved to flash */
+    TPK_ERR_COUNT
+} tpk_err_t;
+
+static const char* const TPK_ERR_CODES[TPK_ERR_COUNT] = {"ok",     "type",  "name",   "size",     "sum",     "order", "range",
+                                                          "not_started", "short", "mismatch", "zip", "memory", "flash", "full", "busy"};
+
