+}
+
+/* ---- the receiver: begin, data in order, commit ---- */
+
+typedef struct {
+    uint8_t active;
+    uint8_t type;
+    char name[TPK_NAME_MAX + 1];
+    uint32_t version;
+    uint32_t size;
+    uint32_t got;
+    uint8_t want[32];
+    tpk_sha_t sha;
+} tpk_rx_t;
+
+static inline void tpk_rx_init(tpk_rx_t* r) { memset(r, 0, sizeof(*r)); }
+
+/* Start a pack. The caller then holds a buffer of `size` bytes and passes each piece to tpk_rx_data. */
+static inline tpk_err_t tpk_rx_begin(tpk_rx_t* r, const char* type, const char* name, uint32_t version, uint32_t size, const char* sha_hex)
+{
+    r->active = 0;
+    const int t = tpk_type_by_name(type);
+    if (t < 0) return TPK_ERR_TYPE;
+    if (!tpk_name_ok(name)) return TPK_ERR_NAME;
+    if (size == 0 || size > TPK_MAX_BYTES[t]) return TPK_ERR_SIZE;
+    if (!tpk_sha_from_hex(sha_hex, r->want)) return TPK_ERR_SUM;
+    r->type = (uint8_t)t;
+    strncpy(r->name, name, TPK_NAME_MAX);
+    r->name[TPK_NAME_MAX] = 0;
+    r->version            = version;
+    r->size               = size;
+    r->got                = 0;
+    tpk_sha_init(&r->sha);
+    r->active = 1;
+    return TPK_OK;
+}
+
+/* A piece at offset `at`. Pieces arrive in order and are written by the caller at buf[at]; a repeat of the last piece
+ * after a lost reply is refused as out of order, not silently counted twice. */
+static inline tpk_err_t tpk_rx_data(tpk_rx_t* r, uint32_t at, const uint8_t* piece, size_t n)
+{
+    if (!r->active) return TPK_ERR_NOT_STARTED;
+    if (at != r->got) return TPK_ERR_ORDER;
+    if (n == 0 || (uint64_t)at + n > r->size) return TPK_ERR_RANGE;
+    tpk_sha_update(&r->sha, piece, n);
+    r->got += (uint32_t)n;
+    return TPK_OK;
+}
+
+static inline tpk_err_t tpk_rx_commit(tpk_rx_t* r)
+{
+    if (!r->active) return TPK_ERR_NOT_STARTED;
+    if (r->got != r->size) return TPK_ERR_SHORT;
+    uint8_t got[32];
+    tpk_sha_final(&r->sha, got);
+    r->active = 0;
+    uint8_t diff = 0;
+    for (int i = 0; i < 32; i++) diff |= (uint8_t)(got[i] ^ r->want[i]);
+    return diff == 0 ? TPK_OK : TPK_ERR_MISMATCH;
+}
+
+static inline void tpk_rx_abort(tpk_rx_t* r) { r->active = 0; }
+
+/* ---- the zip walker: nothing in the file is trusted ---- */
+
+#define TPZ_MAX_ENTRIES 64
+#define TPZ_NAME_MAX 63
+#define TPZ_MAX_ENTRY_BYTES (2u * 1024u * 1024u)  /* one file, inflated */
+#define TPZ_MAX_TOTAL_BYTES (6u * 1024u * 1024u)  /* all files, inflated (a deflate bomb is refused here) */
+
+typedef struct {
+    char name[TPZ_NAME_MAX + 1];
+    uint8_t method;  /* 0 stored, 8 deflated */
+    uint32_t csize;  /* bytes in the file */
+    uint32_t usize;  /* bytes once inflated */
+    uint32_t crc;
+    uint32_t off;    /* where the entry's bytes start in the buffer */
+} tpz_entry_t;
+
+typedef struct {
+    const uint8_t* buf;
+    size_t len;
+    uint16_t count;
+    tpz_entry_t e[TPZ_MAX_ENTRIES]; /* 80 bytes each: the caller keeps this on its own storage, not the stack */
+} tpz_t;
+
+static inline uint16_t tpz_u16(const uint8_t* p) { return (uint16_t)(p[0] | (p[1] << 8)); }
+static inline uint32_t tpz_u32(const uint8_t* p) { return (uint32_t)p[0] | ((uint32_t)p[1] << 8) | ((uint32_t)p[2] << 16) | ((uint32_t)p[3] << 24); }
+
+/* Opens a zip held in memory. Refuses (TPK_ERR_ZIP) anything it cannot prove is inside the buffer: bad signatures, more
+ * than TPZ_MAX_ENTRIES, an encrypted or split or Zip64 file, a method other than stored and deflate, names with a path
+ * (a slash, a backslash, ".."), repeated names, entry bytes outside the buffer, and sizes beyond the caps. */
+static inline tpk_err_t tpz_open(tpz_t* z, const uint8_t* buf, size_t len)
+{
+    memset(z, 0, sizeof(*z));
+    z->buf = buf;
+    z->len = len;
+    if (buf == NULL || len < 22) return TPK_ERR_ZIP;
+    /* the end-of-central-directory record: at most 22 + 65535 bytes from the end */
+    size_t eocd    = 0;
+    int found      = 0;
+    size_t lowest  = len > 22u + 65535u ? len - 22u - 65535u : 0;
+    for (size_t i = len - 22 + 1; i-- > lowest;) {
+        if (buf[i] == 'P' && buf[i + 1] == 'K' && buf[i + 2] == 5 && buf[i + 3] == 6) {
+            eocd  = i;
+            found = 1;
+            break;
+        }
+    }
+    if (!found) return TPK_ERR_ZIP;
+    const uint16_t disk = tpz_u16(buf + eocd + 4), cd_disk = tpz_u16(buf + eocd + 6);
+    const uint16_t here = tpz_u16(buf + eocd + 8), total = tpz_u16(buf + eocd + 10);
+    const uint32_t cd_size = tpz_u32(buf + eocd + 12), cd_off = tpz_u32(buf + eocd + 16);
+    if (disk != 0 || cd_disk != 0 || here != total || total == 0 || total > TPZ_MAX_ENTRIES) return TPK_ERR_ZIP;
+    if (cd_off > eocd || cd_size > eocd - cd_off) return TPK_ERR_ZIP;
+    size_t p            = cd_off;
+    const size_t cd_end = (size_t)cd_off + cd_size;
+    uint64_t sum        = 0;
+    for (uint16_t i = 0; i < total; i++) {
+        if (p + 46 > cd_end || tpz_u32(buf + p) != 0x02014b50u) return TPK_ERR_ZIP;
+        const uint16_t flags  = tpz_u16(buf + p + 8);
+        const uint16_t method = tpz_u16(buf + p + 10);
+        const uint32_t crc    = tpz_u32(buf + p + 16);
+        const uint32_t csize  = tpz_u32(buf + p + 20);
+        const uint32_t usize  = tpz_u32(buf + p + 24);
+        const uint16_t nlen = tpz_u16(buf + p + 28), xlen = tpz_u16(buf + p + 30), clen = tpz_u16(buf + p + 32);
+        const uint16_t dnum = tpz_u16(buf + p + 34);
+        const uint32_t lho  = tpz_u32(buf + p + 42);
+        if ((flags & 0x0001) != 0 /* encrypted */ || dnum != 0) return TPK_ERR_ZIP;
+        if (method != 0 && method != 8) return TPK_ERR_ZIP;
+        if (csize == 0xFFFFFFFFu || usize == 0xFFFFFFFFu || lho == 0xFFFFFFFFu) return TPK_ERR_ZIP; /* Zip64 */
+        if (nlen == 0 || nlen > TPZ_NAME_MAX) return TPK_ERR_ZIP;
+        if (p + 46 + (size_t)nlen + xlen + clen > cd_end) return TPK_ERR_ZIP;
+        if (method == 0 && csize != usize) return TPK_ERR_ZIP;
+        if (usize > TPZ_MAX_ENTRY_BYTES) return TPK_ERR_ZIP;
+        sum += usize;
+        if (sum > TPZ_MAX_TOTAL_BYTES) return TPK_ERR_ZIP;
+        tpz_entry_t* e = &z->e[i];
+        for (uint16_t k = 0; k < nlen; k++) {
+            const char c = (char)buf[p + 46 + k];
+            if (c == '/' || c == '\\' || c == 0 || (unsigned char)c < 32) return TPK_ERR_ZIP;
+            e->name[k] = c;
+        }
+        e->name[nlen] = 0;
+        if (strcmp(e->name, "..") == 0 || strstr(e->name, "..") != NULL) return TPK_ERR_ZIP;
+        for (uint16_t k = 0; k < i; k++) {
+            if (strcmp(z->e[k].name, e->name) == 0) return TPK_ERR_ZIP;
+        }
+        /* the local header: its own signature and name length, then the bytes */
+        if ((uint64_t)lho + 30 > cd_off) return TPK_ERR_ZIP; /* entries live before the directory */
+        if (tpz_u32(buf + lho) != 0x04034b50u) return TPK_ERR_ZIP;
+        const uint16_t lnlen = tpz_u16(buf + lho + 26), lxlen = tpz_u16(buf + lho + 28);
+        const uint64_t data  = (uint64_t)lho + 30 + lnlen + lxlen;
+        if (data > cd_off || (uint64_t)csize > cd_off - data) return TPK_ERR_ZIP;
+        e->method = (uint8_t)method;
+        e->csize  = csize;
+        e->usize  = usize;
+        e->crc    = crc;
+        e->off    = (uint32_t)data;
+        p += 46u + nlen + xlen + clen;
+    }
+    z->count = total;
+    return TPK_OK;
+}
+
+static inline const tpz_entry_t* tpz_find(const tpz_t* z, const char* name)
+{
+    for (uint16_t i = 0; i < z->count; i++) {
+        if (strcmp(z->e[i].name, name) == 0) return &z->e[i];
+    }
+    return NULL;
+}
+
+/* The bytes of a stored entry in place (NULL for a deflated one), checked against its CRC. */
+static inline const uint8_t* tpz_stored(const tpz_t* z, const tpz_entry_t* e)
+{
+    if (e == NULL || e->method != 0) return NULL;
+    if (tpk_crc32(0, z->buf + e->off, e->usize) != e->crc) return NULL;
+    return z->buf + e->off;
+}
+
+/* Inflates an entry into `out` (size at least usize) through `inflate(in, inlen, out, outcap)`, which answers the bytes
+ * produced or a negative number; the result is checked against the stated size and the CRC. A stored entry is copied. */
+typedef long (*tpz_inflate_fn)(const uint8_t* in, size_t inlen, uint8_t* out, size_t outcap);
+
+static inline tpk_err_t tpz_extract(const tpz_t* z, const tpz_entry_t* e, uint8_t* out, size_t cap, tpz_inflate_fn inflate)
+{
+    if (e == NULL || cap < e->usize) return TPK_ERR_MEMORY;
+    if (e->method == 0) {
+        memcpy(out, z->buf + e->off, e->usize);
+    } else {
+        if (inflate == NULL) return TPK_ERR_ZIP;
+        const long n = inflate(z->buf + e->off, e->csize, out, e->usize);
+        if (n < 0 || (uint32_t)n != e->usize) return TPK_ERR_ZIP;
+    }
+    return tpk_crc32(0, out, e->usize) == e->crc ? TPK_OK : TPK_ERR_ZIP;
+}
+
+#endif /* MAIPAI_PACK_CORE_H */
diff --git a/firmware/main/hal/maipai_packcache_core.h b/firmware/main/hal/maipai_packcache_core.h
new file mode 100644
index 0000000..c453d98
--- /dev/null
+++ b/firmware/main/hal/maipai_packcache_core.h
@@ -0,0 +1,328 @@
+/*
+ * SPDX-License-Identifier: MIT
+ *
+ * The flash cache of the active pack of each type (patch TB02): the pure logic. The robot keeps the pack the person
+ * chose in flash, so it shows the same look and has the same sounds after a power cycle with the host off. The cache is
+ * written only when the pack changes (flash wear), checked at boot, and a missing or damaged pack means the built-in
+ * set, with the cause named. Plain C99; the flash is reached through three functions, so a host test can drive it with
+ * a RAM flash that cuts the power at every step.
+ *
+ * Where: the tail of the assets partition, below the firmware's own assets. The assets image is 4,463,226 bytes in a
+ * 6,225,920 byte partition; the cache takes the last 1,572,864 bytes (0x180000), which starts at 4,653,056, leaving 189,830
+ * bytes of margin for the asset image to grow. (Writing a new assets image over the partition erases only what it covers.)
+ *
+ * Layout: sector 0 and sector 1 hold the directory in turn (the newer valid one wins: a power cut while writing leaves the
+ * older one standing); 4096-byte data sectors follow. Each pack is one run of whole sectors. A directory entry names the
+ * type, pack name, version, size, SHA-256 and the run. Order of a write: data first, then the directory that points at it;
+ * so a cut at any step leaves either the old pack, the new pack, or no pack of that type (never a mixture).
+ * Host test: host/tests/firmware/packcache_core_test.c.
+ */
+#ifndef MAIPAI_PACKCACHE_CORE_H
+#define MAIPAI_PACKCACHE_CORE_H
+
+#include "maipai_pack_core.h"
+
+#define TPC_SECTOR 4096u
+#define TPC_ASSETS_PARTITION_BYTES 0x5F0000u
+#define TPC_REGION_BYTES 0x180000u
+#define TPC_REGION_START (TPC_ASSETS_PARTITION_BYTES - TPC_REGION_BYTES) /* 0x470000 = 4,653,056 */
+#define TPC_DIR_SECTORS 2u
+#define TPC_DATA_SECTORS (TPC_REGION_BYTES / TPC_SECTOR - TPC_DIR_SECTORS) /* 382 */
+#define TPC_MAGIC 0x4B50414Du /* "MAPK" */
+#define TPC_FORMAT 1u
+
+/* One directory entry, 96 bytes on flash. */
+typedef struct {
+    uint8_t type;      /* TPK_*; 0xFF is an empty slot */
+    uint8_t name_len;
+    uint16_t first;    /* first data sector */
+    uint16_t nsect;    /* sectors held */
+    uint16_t pad;
+    uint32_t version;
+    uint32_t size;     /* payload bytes */
+    uint8_t sha[32];
+    char name[TPK_NAME_MAX + 1]; /* 41 */
+    uint8_t reserved[7];
+} tpc_entry_t;
+
+#define TPC_ENTRY_BYTES 96u
+
+/* What the cache knows. */
+typedef struct {
+    tpc_entry_t e[TPK_TYPES];
+    uint8_t have[TPK_TYPES]; /* 1 when the directory holds a pack of this type */
+    uint32_t seq;            /* the directory's sequence number */
+    uint8_t slot;            /* which directory sector the current one is in (0 or 1); 2 when there is none */
+} tpc_dir_t;
+
+typedef struct {
+    int (*read)(void* ctx, uint32_t off, uint8_t* buf, size_t len);        /* region offset; 0 on success */
+    int (*erase)(void* ctx, uint32_t off, size_t len);                     /* whole sectors; 0 on success */
+    int (*write)(void* ctx, uint32_t off, const uint8_t* buf, size_t len); /* into erased bytes; 0 on success */
+    void (*pause)(void* ctx);                                              /* between sectors: yield, wait for a quiet moment */
+} tpc_ops_t;
+
+/* Per type, what the boot scan found. */
+#define TPC_ST_EMPTY 0   /* no pack: the built-in set */
+#define TPC_ST_OK 1      /* checked and good */
+#define TPC_ST_DAMAGED 2 /* the directory names a pack whose bytes do not match: the built-in set */
+static const char* const TPC_ST_NAMES[3] = {"empty", "ok", "damaged"};
+
+typedef struct {
+    uint8_t status[TPK_TYPES];
+    uint8_t dir_found;      /* a valid directory sector was found */
+    uint8_t dir_corrupt;    /* a directory sector was written to but is not valid (a cut write or damage) */
+} tpc_report_t;
+
+/* ---- directory (de)coding ---- */
+
+static inline uint32_t tpc_dir_crc(const uint8_t* sector_bytes, size_t covered) { return tpk_crc32(0, sector_bytes, covered); }
+
+#define TPC_HDR_BYTES 16u /* magic, format, count, seq, crc */
+#define TPC_DIR_COVERED (TPC_HDR_BYTES + TPK_TYPES * TPC_ENTRY_BYTES)
+
+static inline void tpc_put32(uint8_t* p, uint32_t v) { p[0] = (uint8_t)v; p[1] = (uint8_t)(v >> 8); p[2] = (uint8_t)(v >> 16); p[3] = (uint8_t)(v >> 24); }
+static inline void tpc_put16(uint8_t* p, uint16_t v) { p[0] = (uint8_t)v; p[1] = (uint8_t)(v >> 8); }
+
+static inline void tpc_encode(const tpc_dir_t* d, uint8_t out[TPC_SECTOR])
+{
+    memset(out, 0xFF, TPC_SECTOR);
+    uint8_t count = 0;
+    for (int t = 0; t < TPK_TYPES; t++) count += d->have[t] ? 1 : 0;
+    tpc_put32(out, TPC_MAGIC);
+    tpc_put16(out + 4, (uint16_t)TPC_FORMAT);
+    tpc_put16(out + 6, count);
+    tpc_put32(out + 8, d->seq);
+    tpc_put32(out + 12, 0);
+    for (int t = 0; t < TPK_TYPES; t++) {
+        uint8_t* p = out + TPC_HDR_BYTES + (size_t)t * TPC_ENTRY_BYTES;
+        memset(p, 0xFF, TPC_ENTRY_BYTES);
+        if (!d->have[t]) continue;
+        const tpc_entry_t* e = &d->e[t];
+        p[0] = e->type;
+        p[1] = e->name_len;
+        tpc_put16(p + 2, e->first);
+        tpc_put16(p + 4, e->nsect);
+        tpc_put16(p + 6, 0);
+        tpc_put32(p + 8, e->version);
+        tpc_put32(p + 12, e->size);
+        memcpy(p + 16, e->sha, 32);
+        memset(p + 48, 0, TPK_NAME_MAX + 1);
+        memcpy(p + 48, e->name, e->name_len);
+        memset(p + 89, 0, 7);
+    }
+    /* the crc covers the header with its own field zeroed */
+    tpc_put32(out + 12, 0);
+    const uint32_t crc = tpc_dir_crc(out, TPC_DIR_COVERED);
+    tpc_put32(out + 12, crc);
+}
+
+/* 1 when the sector holds a valid directory; fills `d` (and its seq). */
+static inline int tpc_decode(const uint8_t* in, tpc_dir_t* d)
+{
+    if (tpz_u32(in) != TPC_MAGIC || tpz_u16(in + 4) != TPC_FORMAT) return 0;
+    uint8_t tmp[TPC_DIR_COVERED];
+    memcpy(tmp, in, sizeof(tmp));
+    const uint32_t want = tpz_u32(tmp + 12);
+    tpc_put32(tmp + 12, 0);
+    if (tpc_dir_crc(tmp, sizeof(tmp)) != want) return 0;
+    memset(d, 0, sizeof(*d));
+    d->seq = tpz_u32(in + 8);
+    for (int t = 0; t < TPK_TYPES; t++) {
+        const uint8_t* p = in + TPC_HDR_BYTES + (size_t)t * TPC_ENTRY_BYTES;
+        if (p[0] == 0xFF) continue;
+        if (p[0] != (uint8_t)t || p[1] == 0 || p[1] > TPK_NAME_MAX) return 0;
+        tpc_entry_t* e = &d->e[t];
+        e->type     = p[0];
+        e->name_len = p[1];
+        e->first    = tpz_u16(p + 2);
+        e->nsect    = tpz_u16(p + 4);
+        e->version  = tpz_u32(p + 8);
+        e->size     = tpz_u32(p + 12);
+        memcpy(e->sha, p + 16, 32);
+        memcpy(e->name, p + 48, e->name_len);
+        e->name[e->name_len] = 0;
+        d->have[t] = 1;
+    }
+    return 1;
+}
+
+static inline uint32_t tpc_sectors_for(uint32_t bytes) { return (bytes + TPC_SECTOR - 1u) / TPC_SECTOR; }
+
+/* An entry is believable: inside the data area, the size fits its sectors and its type's gate. */
+static inline int tpc_entry_sane(const tpc_entry_t* e, int type)
+{
+    if (e->type != type || e->size == 0 || e->size > TPK_MAX_BYTES[type]) return 0;
+    if (e->nsect == 0 || e->nsect != tpc_sectors_for(e->size)) return 0;
+    if ((uint32_t)e->first + e->nsect > TPC_DATA_SECTORS) return 0;
+    return tpk_name_ok(e->name);
+}
+
+static inline int tpc_overlap(const tpc_entry_t* a, const tpc_entry_t* b)
+{
+    return a->first < b->first + b->nsect && b->first < a->first + a->nsect;
+}
+
+/* Reads the pack bytes of an entry through `read` in 1 KB steps and checks the SHA-256; 1 when it matches. */
+static inline int tpc_verify(const tpc_ops_t* ops, void* ctx, const tpc_entry_t* e)
+{
+    tpk_sha_t sha;
+    tpk_sha_init(&sha);
+    uint8_t buf[1024];
+    const uint32_t base = TPC_DIR_SECTORS * TPC_SECTOR + (uint32_t)e->first * TPC_SECTOR;
+    uint32_t done       = 0;
+    while (done < e->size) {
+        const size_t n = e->size - done < sizeof(buf) ? (size_t)(e->size - done) : sizeof(buf);
+        if (ops->read(ctx, base + done, buf, n) != 0) return 0;
+        tpk_sha_update(&sha, buf, n);
+        done += (uint32_t)n;
+        if ((done & 0x3FFFu) == 0 && ops->pause) ops->pause(ctx);
+    }
+    uint8_t got[32];
+    tpk_sha_final(&sha, got);
+    return memcmp(got, e->sha, 32) == 0;
+}
+
+/* The boot scan (`sector` is a caller-owned scratch of TPC_SECTOR bytes, so the core keeps no RAM of its own): the newest valid directory, then each entry checked (sane, no overlap, SHA-256). Nothing is written. */
+static inline void tpc_scan(const tpc_ops_t* ops, void* ctx, uint8_t* sector, tpc_dir_t* out, tpc_report_t* rep)
+{
+    memset(out, 0, sizeof(*out));
+    memset(rep, 0, sizeof(*rep));
+    out->slot = 2;
+    tpc_dir_t cand[2];
+    int ok[2] = {0, 0};
+    for (int s = 0; s < 2; s++) {
+        if (ops->read(ctx, (uint32_t)s * TPC_SECTOR, sector, TPC_SECTOR) != 0) continue;
+        ok[s] = tpc_decode(sector, &cand[s]);
+        if (!ok[s]) {
+            int blank = 1;
+            for (size_t i = 0; i < TPC_SECTOR; i++) {
+                if (sector[i] != 0xFF) { blank = 0; break; }
+            }
+            if (!blank) rep->dir_corrupt = 1;
+        }
+    }
+    int pick = -1;
+    if (ok[0] && ok[1]) pick = ((int32_t)(cand[1].seq - cand[0].seq) > 0) ? 1 : 0;
+    else if (ok[0]) pick = 0;
+    else if (ok[1]) pick = 1;
+    if (pick < 0) return;
+    *out        = cand[pick];
+    out->slot   = (uint8_t)pick;
+    rep->dir_found = 1;
+    for (int t = 0; t < TPK_TYPES; t++) {
+        if (!out->have[t]) continue;
+        int good = tpc_entry_sane(&out->e[t], t);
+        for (int u = 0; good && u < t; u++) {
+            if (out->have[u] && tpc_overlap(&out->e[t], &out->e[u])) good = 0;
+        }
+        if (good) good = tpc_verify(ops, ctx, &out->e[t]);
+        rep->status[t] = good ? TPC_ST_OK : TPC_ST_DAMAGED;
+        if (!good) out->have[t] = 0; /* the built-in set; the directory on flash is not rewritten at boot */
+    }
+}
+
+/* ---- allocation ---- */
+
+/* First fit for `nsect` sectors among the data sectors not used by any entry except `skip_type` (-1: none skipped). */
+static inline int tpc_find_run(const tpc_dir_t* d, int skip_type, uint32_t nsect)
+{
+    uint8_t used[TPC_DATA_SECTORS];
+    memset(used, 0, sizeof(used));
+    for (int t = 0; t < TPK_TYPES; t++) {
+        if (!d->have[t] || t == skip_type) continue;
+        for (uint32_t k = 0; k < d->e[t].nsect && d->e[t].first + k < TPC_DATA_SECTORS; k++) used[d->e[t].first + k] = 1;
+    }
+    uint32_t run = 0;
+    for (uint32_t i = 0; i < TPC_DATA_SECTORS; i++) {
+        run = used[i] ? 0 : run + 1;
+        if (run == nsect) return (int)(i + 1 - nsect);
+    }
+    return -1;
+}
+
+static inline tpk_err_t tpc_write_dir(const tpc_ops_t* ops, void* ctx, uint8_t* sector, tpc_dir_t* d)
+{
+    const uint8_t target = (d->slot == 0) ? 1 : 0; /* the older one, or sector 0 when there is none */
+    d->seq++;
+    tpc_encode(d, sector);
+    if (ops->erase(ctx, (uint32_t)target * TPC_SECTOR, TPC_SECTOR) != 0) return TPK_ERR_FLASH;
+    if (ops->write(ctx, (uint32_t)target * TPC_SECTOR, sector, TPC_SECTOR) != 0) return TPK_ERR_FLASH;
+    d->slot = target;
+    return TPK_OK;
+}
+
+/* Writes a pack (the whole payload in `data`) as the cached pack of `type`, replacing any earlier one. The old pack stays
+ * valid until the new directory is down, when there is room for both; when there is not, the old one is dropped first
+ * (a cut then leaves the built-in set). Verifies what it wrote before the directory points at it. */
+static inline tpk_err_t tpc_store(const tpc_ops_t* ops, void* ctx, uint8_t* sector, tpc_dir_t* d, int type, const char* name, uint32_t version, const uint8_t* data,
+                                  uint32_t size, const uint8_t sha[32])
+{
+    if (type < 0 || type >= TPK_TYPES) return TPK_ERR_TYPE;
+    if (!tpk_name_ok(name)) return TPK_ERR_NAME;
+    if (size == 0 || size > TPK_MAX_BYTES[type]) return TPK_ERR_SIZE;
+    const uint32_t nsect = tpc_sectors_for(size);
+    int run = tpc_find_run(d, -1, nsect);
+    if (run < 0) {
+        /* no room beside the old pack of this type: drop it first, then look again */
+        if (!d->have[type]) return TPK_ERR_FULL;
+        run = tpc_find_run(d, type, nsect);
+        if (run < 0) return TPK_ERR_FULL;
+        d->have[type] = 0;
+        const tpk_err_t e = tpc_write_dir(ops, ctx, sector, d);
+        if (e != TPK_OK) return e;
+    }
+    for (uint32_t s = 0; s < nsect; s++) {
+        const uint32_t off = TPC_DIR_SECTORS * TPC_SECTOR + (uint32_t)(run + (int)s) * TPC_SECTOR;
+        if (ops->erase(ctx, off, TPC_SECTOR) != 0) return TPK_ERR_FLASH;
+        const uint32_t at  = s * TPC_SECTOR;
+        const size_t n     = size - at < TPC_SECTOR ? (size_t)(size - at) : TPC_SECTOR;
+        if (ops->write(ctx, off, data + at, n) != 0) return TPK_ERR_FLASH;
+        if (ops->pause) ops->pause(ctx);
+    }
+    tpc_entry_t e;
+    memset(&e, 0, sizeof(e));
+    e.type     = (uint8_t)type;
+    e.name_len = (uint8_t)strlen(name);
+    e.first    = (uint16_t)run;
+    e.nsect    = (uint16_t)nsect;
+    e.version  = version;
+    e.size     = size;
+    memcpy(e.sha, sha, 32);
+    memcpy(e.name, name, e.name_len);
+    if (!tpc_verify(ops, ctx, &e)) return TPK_ERR_FLASH;
+    tpc_dir_t next = *d;
+    next.e[type]    = e;
+    next.have[type] = 1;
+    const tpk_err_t w = tpc_write_dir(ops, ctx, sector, &next);
+    if (w != TPK_OK) return w;
+    *d = next;
+    return TPK_OK;
+}
+
+static inline tpk_err_t tpc_remove(const tpc_ops_t* ops, void* ctx, uint8_t* sector, tpc_dir_t* d, int type)
+{
+    if (type < 0 || type >= TPK_TYPES) return TPK_ERR_TYPE;
+    if (!d->have[type]) return TPK_OK; /* nothing held: nothing written */
+    tpc_dir_t next  = *d;
+    next.have[type] = 0;
+    const tpk_err_t w = tpc_write_dir(ops, ctx, sector, &next);
+    if (w != TPK_OK) return w;
+    *d = next;
+    return TPK_OK;
+}
+
+/* 1 when the cache already holds exactly this pack (same SHA-256): a resend then writes nothing. */
+static inline int tpc_holds(const tpc_dir_t* d, int type, const uint8_t sha[32])
+{
+    return type >= 0 && type < TPK_TYPES && d->have[type] && memcmp(d->e[type].sha, sha, 32) == 0;
+}
+
+/* Reads a held pack back (for a consumer that wants it in memory). `out` holds at least e->size bytes. */
+static inline int tpc_read_pack(const tpc_ops_t* ops, void* ctx, const tpc_entry_t* e, uint8_t* out)
+{
+    const uint32_t base = TPC_DIR_SECTORS * TPC_SECTOR + (uint32_t)e->first * TPC_SECTOR;
+    return ops->read(ctx, base, out, e->size) == 0;
+}
+
+#endif /* MAIPAI_PACKCACHE_CORE_H */
diff --git a/firmware/main/hal/maipai_packs.h b/firmware/main/hal/maipai_packs.h
new file mode 100644
index 0000000..798adca
--- /dev/null
+++ b/firmware/main/hal/maipai_packs.h
@@ -0,0 +1,16 @@
+/*
+ * SPDX-License-Identifier: MIT
+ *
+ * The shared pack loader, device side (patch TB02). Logic: maipai_pack_core.h (format) and maipai_packcache_core.h (flash).
+ */
+#pragma once
+#include <cstddef>
+#include <cstdint>
+
+// Registers self.pack.status, begin, data, commit and remove, opens the flash cache and, in a background task, applies the
+// cached pack of each type that has a user (look, filler) once the face is up. Steady internal RAM: about 0.9 KB.
+void maipai_packs_register_tools();
+
+// The cached or sent pack of a type held in memory for its user, or null. For the types that have no user yet (language,
+// sound, dance, game) a consumer calls this when it needs the bytes; the pointer stays valid until the pack changes.
+const uint8_t* maipai_pack_bytes(int type, size_t* len);
diff --git a/firmware/main/hal/maipai_packs.cc b/firmware/main/hal/maipai_packs.cc
new file mode 100644
index 0000000..49a4a1a
--- /dev/null
+++ b/firmware/main/hal/maipai_packs.cc
@@ -0,0 +1,346 @@
+/*
+ * SPDX-License-Identifier: MIT
+ *
+ * The shared pack loader (patch TB02). The host sends the pack the person picked: begin (type, name, version, size, SHA-256),
+ * data (in order, base64), commit. The unit checks the checksum, gives the pack to its user (the picture-face look, the filler
+ * sounds), and writes it to the flash cache in a low-priority task, only when it differs from what the cache holds. At boot
+ * the cache is scanned (checksum of every held pack) and each held pack of a type that has a user is applied; a missing
+ * or damaged pack means the built-in set and the status says why. remove puts a type back to the built-in set.
+ * Memory: PSRAM only for the pack in flight (up to its type's gate, 1,000,000 bytes at most) and a 4 KB scratch while the
+ * flash is written; internal RAM about 0.9 KB (directory, report, receiver, flags).
+ */
+#include "maipai_packs.h"
+#include "maipai_pack_core.h"
+#include "maipai_packcache_core.h"
+#include "maipai_filler.h"
+#include "maipai_picface.h"
+#include "board/hal_bridge.h"
+#include <esp_heap_caps.h>
+#include <esp_log.h>
+#include <esp_partition.h>
+#include <freertos/FreeRTOS.h>
+#include <freertos/idf_additions.h>
+#include <freertos/task.h>
+#include <mbedtls/base64.h>
+#include <mcp_server.h>
+#include <stackchan/stackchan.h>
+#include <atomic>
+#include <cstdio>
+#include <cstring>
+#include <mutex>
+#include <string>
+
+static const char* TAG = "MAIPAI-PACKS";
+
+namespace {
+
+const esp_partition_t* s_part = nullptr;  // the assets partition; the cache is its tail
+std::mutex s_mu;
+tpc_dir_t s_dir;                 // ~0.6 KB
+tpc_report_t s_rep;
+tpk_rx_t s_rx;                   // ~0.2 KB
+uint8_t* s_buf = nullptr;        // PSRAM: the pack in flight
+uint8_t* s_user_buf[TPK_TYPES] = {};  // PSRAM: the pack a user holds
+uint32_t s_user_len[TPK_TYPES] = {};
+uint8_t s_have_user[TPK_TYPES] = {};  // the type's pack is applied (sha in s_user_sha)
+uint8_t s_user_sha[TPK_TYPES][32];
+char s_user_name[TPK_TYPES][TPK_NAME_MAX + 1];
+std::atomic<bool> s_writing{false};
+std::atomic<bool> s_cache_ok{false};
+std::atomic<uint8_t> s_cached[TPK_TYPES];       // 1 once this type's held pack is in the flash cache
+std::atomic<int> s_last_write_err{0};
+std::atomic<bool> s_booted{false};
+
+bool has_user(int type) { return type == TPK_LOOK || type == TPK_FILLER; }
+
+std::string err_json(tpk_err_t e)
+{
+    return std::string("{\"ok\":false,\"code\":\"") + TPK_ERR_CODES[e] + "\",\"error\":\"" + tpk_say(e, 0) + "\",\"error_es\":\"" + tpk_say(e, 1) + "\"}";
+}
+
+// the flash, as the cache core sees it: offsets inside the region at the tail of the partition
+int f_read(void*, uint32_t off, uint8_t* buf, size_t len) { return esp_partition_read(s_part, TPC_REGION_START + off, buf, len) == ESP_OK ? 0 : -1; }
+int f_erase(void*, uint32_t off, size_t len) { return esp_partition_erase_range(s_part, TPC_REGION_START + off, len) == ESP_OK ? 0 : -1; }
+int f_write(void*, uint32_t off, const uint8_t* buf, size_t len) { return esp_partition_write(s_part, TPC_REGION_START + off, buf, len) == ESP_OK ? 0 : -1; }
+void f_pause(void*) { vTaskDelay(pdMS_TO_TICKS(8)); }  // between sectors: the animation and the audio go first
+const tpc_ops_t OPS = {f_read, f_erase, f_write, f_pause};
+
+void free_user_locked(int type)
+{
+    if (s_user_buf[type] != nullptr) heap_caps_free(s_user_buf[type]);
+    s_user_buf[type] = nullptr;
+    s_user_len[type] = 0;
+    s_have_user[type] = 0;
+}
+
+// Gives a checked payload to its user. Returns an empty string on success, else a plain reason.
+std::string apply(int type, const uint8_t* data, size_t len)
+{
+    const char* why = "";
+    if (type == TPK_LOOK) {
+#if CONFIG_MAIPAI_PICTURE_FACES
+        if (!maipai_picface_apply_look(data, len, &why)) return why;
+#endif
+    } else if (type == TPK_FILLER) {
+        if (!maipai_filler_load_pack(data, len, &why)) return why;
+    }
+    return "";
+}
+
+void unapply(int type)
+{
+    const char* why = "";
+    if (type == TPK_LOOK) {
+#if CONFIG_MAIPAI_PICTURE_FACES
+        maipai_picface_apply_look(nullptr, 0, &why);
+#endif
+    } else if (type == TPK_FILLER) {
+        maipai_filler_load_pack(nullptr, 0, &why);
+    }
+}
+
+// the background writer: takes the pack buffer, writes it, frees what it does not keep
+struct WriteJob {
+    int type;
+    char name[TPK_NAME_MAX + 1];
+    uint32_t version, size;
+    uint8_t sha[32];
+    uint8_t* data;  // PSRAM
+    bool owns;      // the job frees it
+};
+
+void writer_task(void* arg)
+{
+    WriteJob* j = static_cast<WriteJob*>(arg);
+    uint8_t* sector = static_cast<uint8_t*>(heap_caps_malloc(TPC_SECTOR, MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT));
+    tpk_err_t e = TPK_ERR_MEMORY;
+    if (sector != nullptr && s_cache_ok.load()) {
+        std::lock_guard<std::mutex> lock(s_mu);
+        if (tpc_holds(&s_dir, j->type, j->sha)) {
+            e = TPK_OK;  // unchanged: no write, no wear
+        } else {
+            e = tpc_store(&OPS, nullptr, sector, &s_dir, j->type, j->name, j->version, j->data, j->size, j->sha);
+        }
+    } else if (!s_cache_ok.load()) {
+        e = TPK_ERR_FLASH;
+    }
+    s_last_write_err.store(e);
+    s_cached[j->type].store(e == TPK_OK ? 1 : 0);
+    if (e != TPK_OK) ESP_LOGW(TAG, "pack cache write failed: %s", TPK_ERR_CODES[e]);
+    if (sector != nullptr) heap_caps_free(sector);
+    if (j->owns) heap_caps_free(j->data);
+    delete j;
+    s_writing.store(false);
+    vTaskDelete(nullptr);
+}
+
+// boot: scan the cache, apply what has a user, once the face is up
+void boot_task(void*)
+{
+    s_part = esp_partition_find_first(ESP_PARTITION_TYPE_DATA, ESP_PARTITION_SUBTYPE_ANY, "assets");
+    uint8_t* sector = static_cast<uint8_t*>(heap_caps_malloc(TPC_SECTOR, MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT));
+    if (s_part != nullptr && sector != nullptr && s_part->size >= TPC_ASSETS_PARTITION_BYTES) {
+        {
+            std::lock_guard<std::mutex> lock(s_mu);
+            tpc_scan(&OPS, nullptr, sector, &s_dir, &s_rep);
+        }
+        s_cache_ok.store(true);
+        ESP_LOGI(TAG, "pack cache: look %s, filler %s", TPC_ST_NAMES[s_rep.status[TPK_LOOK]], TPC_ST_NAMES[s_rep.status[TPK_FILLER]]);
+    } else {
+        ESP_LOGW(TAG, "pack cache off: the assets partition is %s", s_part == nullptr ? "missing" : "too small");
+        tpc_dir_t blank;
+        memset(&blank, 0, sizeof(blank));
+        blank.slot = 2;
+        s_dir = blank;
+    }
+    if (sector != nullptr) heap_caps_free(sector);
+    // wait for the face (the look needs it), at most a minute
+    for (int i = 0; i < 120 && !hal_bridge::is_xiaozhi_ready(); i++) vTaskDelay(pdMS_TO_TICKS(500));
+    for (int t = 0; t < TPK_TYPES; t++) {
+        if (!has_user(t)) continue;
+        std::lock_guard<std::mutex> lock(s_mu);
+        if (!s_dir.have[t] || s_have_user[t]) continue;  // nothing held, or a pack already arrived from the host meanwhile
+        uint8_t* buf = static_cast<uint8_t*>(heap_caps_malloc(s_dir.e[t].size, MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT));
+        if (buf == nullptr || !tpc_read_pack(&OPS, nullptr, &s_dir.e[t], buf)) {
+            if (buf != nullptr) heap_caps_free(buf);
+            continue;
+        }
+        const std::string why = apply(t, buf, s_dir.e[t].size);
+        if (!why.empty()) {
+            ESP_LOGW(TAG, "cached %s pack not usable: %s", TPK_TYPE_NAMES[t], why.c_str());
+            heap_caps_free(buf);
+            continue;
+        }
+        s_user_buf[t] = buf;
+        s_user_len[t] = s_dir.e[t].size;
+        s_have_user[t] = 1;
+        memcpy(s_user_sha[t], s_dir.e[t].sha, 32);
+        strncpy(s_user_name[t], s_dir.e[t].name, TPK_NAME_MAX);
+        s_cached[t].store(1);
+    }
+    s_booted.store(true);
+    vTaskDelete(nullptr);
+}
+
+}  // namespace
+
+const uint8_t* maipai_pack_bytes(int type, size_t* len)
+{
+    std::lock_guard<std::mutex> lock(s_mu);
+    if (type < 0 || type >= TPK_TYPES || !s_have_user[type]) return nullptr;
+    if (len != nullptr) *len = s_user_len[type];
+    return s_user_buf[type];
+}
+
+void maipai_packs_register_tools()
+{
+    tpk_rx_init(&s_rx);
+    memset(&s_dir, 0, sizeof(s_dir));
+    s_dir.slot = 2;
+    xTaskCreate(boot_task, "pack_boot", 6144, nullptr, 1, nullptr);  // transient: ends when the cache is applied
+    auto& mcp = McpServer::GetInstance();
+
+    mcp.AddTool("self.pack.status",
+                "What pack of a type the unit holds: held, name, version, size, sha256, whether it is in the flash cache, and the cache's "
+                "state at boot (empty, ok, damaged: a damaged one means the built-in set). Types: look, language, filler, sound, "
+                "dance, game. Answers {ok, held, ...}.",
+                PropertyList({Property("type", kPropertyTypeString, std::string("look"))}),
+                [](const PropertyList& properties) -> ReturnValue {
+                    const int t = tpk_type_by_name(properties["type"].value<std::string>().c_str());
+                    if (t < 0) return err_json(TPK_ERR_TYPE);
+                    std::lock_guard<std::mutex> lock(s_mu);
+                    const bool held = s_have_user[t] || (!has_user(t) && s_dir.have[t]);
+                    char hex[65] = "";
+                    const uint8_t* sha = s_have_user[t] ? s_user_sha[t] : (s_dir.have[t] ? s_dir.e[t].sha : nullptr);
+                    if (held && sha != nullptr) tpk_sha_hex(sha, hex);
+                    const char* name = s_have_user[t] ? s_user_name[t] : (s_dir.have[t] ? s_dir.e[t].name : "");
+                    char out[560];
+                    snprintf(out, sizeof(out),
+                             "{\"ok\":true,\"type\":\"%s\",\"held\":%s,\"name\":\"%s\",\"sha256\":\"%s\",\"size\":%u,\"cached\":%s,"
+                             "\"cache\":\"%s\",\"cache_on\":%s,\"writing\":%s,\"fallback\":%s,\"booted\":%s}",
+                             TPK_TYPE_NAMES[t], held ? "true" : "false", name, hex,
+                             static_cast<unsigned>(s_have_user[t] ? s_user_len[t] : (s_dir.have[t] ? s_dir.e[t].size : 0)),
+                             s_cached[t].load() ? "true" : "false", TPC_ST_NAMES[s_rep.status[t]], s_cache_ok.load() ? "true" : "false",
+                             s_writing.load() ? "true" : "false", held ? "false" : "true", s_booted.load() ? "true" : "false");
+                    return std::string(out);
+                });
+
+    mcp.AddTool("self.pack.begin",
+                "Start sending a pack: type, name, version, size (bytes of the payload) and sha256 (64 hex digits of the payload). "
+                "Then self.pack.data in order and self.pack.commit. Answers {ok, max_bytes} or {ok:false,code,error,error_es}.",
+                PropertyList({Property("type", kPropertyTypeString, std::string("look")), Property("name", kPropertyTypeString, std::string("Pack")),
+                              Property("version", kPropertyTypeInteger, 1, 0, 1000000), Property("size", kPropertyTypeInteger, 0, 0, 1000000),
+                              Property("sha256", kPropertyTypeString, std::string(""))}),
+                [](const PropertyList& properties) -> ReturnValue {
+                    if (s_writing.load()) return err_json(TPK_ERR_BUSY);
+                    std::lock_guard<std::mutex> lock(s_mu);
+                    if (s_buf != nullptr) { heap_caps_free(s_buf); s_buf = nullptr; }
+                    const std::string type = properties["type"].value<std::string>();
+                    tpk_err_t e = tpk_rx_begin(&s_rx, type.c_str(), properties["name"].value<std::string>().c_str(),
+                                               static_cast<uint32_t>(properties["version"].value<int>()),
+                                               static_cast<uint32_t>(properties["size"].value<int>()),
+                                               properties["sha256"].value<std::string>().c_str());
+                    if (e != TPK_OK) return err_json(e);
+                    s_buf = static_cast<uint8_t*>(heap_caps_malloc(s_rx.size, MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT));
+                    if (s_buf == nullptr) { tpk_rx_abort(&s_rx); return err_json(TPK_ERR_MEMORY); }
+                    return std::string("{\"ok\":true,\"max_bytes\":") + std::to_string(TPK_MAX_BYTES[s_rx.type]) + "}";
+                });
+
+    mcp.AddTool("self.pack.data",
+                "Send the next piece of the pack: at (the byte offset, which must equal what the unit already has) and b64 (the bytes as "
+                "base64). Answers {ok, got} or {ok:false,code,error,error_es}.",
+                PropertyList({Property("at", kPropertyTypeInteger, 0, 0, 1000000), Property("b64", kPropertyTypeString, std::string(""))}),
+                [](const PropertyList& properties) -> ReturnValue {
+                    const std::string text = properties["b64"].value<std::string>();
+                    std::string raw(text.size() * 3 / 4 + 4, '\0');
+                    size_t n = 0;
+                    if (mbedtls_base64_decode(reinterpret_cast<uint8_t*>(raw.data()), raw.size(), &n, reinterpret_cast<const uint8_t*>(text.data()), text.size()) != 0) {
+                        return err_json(TPK_ERR_ORDER);
+                    }
+                    std::lock_guard<std::mutex> lock(s_mu);
+                    if (s_buf == nullptr) return err_json(TPK_ERR_NOT_STARTED);
+                    const uint32_t at = static_cast<uint32_t>(properties["at"].value<int>());
+                    const tpk_err_t e = tpk_rx_data(&s_rx, at, reinterpret_cast<const uint8_t*>(raw.data()), n);
+                    if (e != TPK_OK) return err_json(e);
+                    memcpy(s_buf + at, raw.data(), n);
+                    return std::string("{\"ok\":true,\"got\":") + std::to_string(s_rx.got) + "}";
+                });
+
+    mcp.AddTool("self.pack.commit",
+                "Finish the pack: the unit checks every byte against the checksum, gives the pack to its user, and saves it to its flash "
+                "cache in the background (status.cached turns true). Answers {ok, cached:\"pending\"} or {ok:false,code,error,error_es}.",
+                PropertyList(), [](const PropertyList&) -> ReturnValue {
+                    std::unique_lock<std::mutex> lock(s_mu);
+                    if (s_buf == nullptr) return err_json(TPK_ERR_NOT_STARTED);
+                    const int type = s_rx.type;
+                    char name[TPK_NAME_MAX + 1];
+                    strncpy(name, s_rx.name, TPK_NAME_MAX);
+                    name[TPK_NAME_MAX] = 0;
+                    const uint32_t version = s_rx.version, size = s_rx.size;
+                    uint8_t sha[32];
+                    memcpy(sha, s_rx.want, 32);
+                    const tpk_err_t e = tpk_rx_commit(&s_rx);
+                    if (e != TPK_OK) {
+                        if (e == TPK_ERR_MISMATCH) { heap_caps_free(s_buf); s_buf = nullptr; }
+                        return err_json(e);
+                    }
+                    uint8_t* data = s_buf;
+                    s_buf = nullptr;
+                    lock.unlock();
+                    const std::string why = apply(type, data, size);  // may take a second (the look proves each picture opens)
+                    lock.lock();
+                    if (!why.empty()) {
+                        heap_caps_free(data);
+                        return std::string("{\"ok\":false,\"code\":\"zip\",\"error\":\"") + why + "\",\"error_es\":\"" + tpk_say(TPK_ERR_ZIP, 1) + "\"}";
+                    }
+                    // keep a copy for the writer; the user keeps its own (the look copies its pictures, the filler its sounds)
+                    free_user_locked(type);
+                    s_have_user[type] = 1;
+                    memcpy(s_user_sha[type], sha, 32);
+                    strncpy(s_user_name[type], name, TPK_NAME_MAX);
+                    s_user_name[type][TPK_NAME_MAX] = 0;
+                    s_user_len[type] = size;
+                    s_cached[type].store(0);
+                    WriteJob* j = new WriteJob();
+                    j->type = type;
+                    strncpy(j->name, name, TPK_NAME_MAX);
+                    j->version = version;
+                    j->size = size;
+                    memcpy(j->sha, sha, 32);
+                    j->data = data;
+                    j->owns = true;
+                    if (!has_user(type)) {  // no user yet: the held bytes stay for a later user, and the writer only reads them
+                        s_user_buf[type] = data;
+                        j->owns = false;
+                    }
+                    s_writing.store(true);
+                    if (xTaskCreate(writer_task, "pack_write", 6144, j, 1, nullptr) != pdPASS) {
+                        s_writing.store(false);
+                        if (j->owns) heap_caps_free(j->data);
+                        delete j;
+                        return err_json(TPK_ERR_MEMORY);
+                    }
+                    return std::string("{\"ok\":true,\"type\":\"") + TPK_TYPE_NAMES[type] + "\",\"cached\":\"pending\"}";
+                });
+
+    mcp.AddTool("self.pack.remove",
+                "Remove the held pack of a type: the unit goes back to its built-in set, and the flash cache forgets it. Answers {ok}.",
+                PropertyList({Property("type", kPropertyTypeString, std::string("look"))}),
+                [](const PropertyList& properties) -> ReturnValue {
+                    const int t = tpk_type_by_name(properties["type"].value<std::string>().c_str());
+                    if (t < 0) return err_json(TPK_ERR_TYPE);
+                    if (s_writing.load()) return err_json(TPK_ERR_BUSY);
+                    unapply(t);
+                    std::lock_guard<std::mutex> lock(s_mu);
+                    free_user_locked(t);
+                    s_cached[t].store(0);
+                    if (s_cache_ok.load()) {
+                        uint8_t* sector = static_cast<uint8_t*>(heap_caps_malloc(TPC_SECTOR, MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT));
+                        if (sector == nullptr) return err_json(TPK_ERR_MEMORY);
+                        const tpk_err_t e = tpc_remove(&OPS, nullptr, sector, &s_dir, t);
+                        heap_caps_free(sector);
+                        if (e != TPK_OK) return err_json(e);
+                    }
+                    return std::string("{\"ok\":true}");
+                });
+}
