+
+// ---- the shared pack loader's look (patch TB02) ----
+// A look pack of the picture kind is a zip with look.json and one file per frame:
+//   {"kind":"picture","mode":"picture|overlay|sequence","fps":6,"overlay":{...as self.facepic.begin...},
+//    "frames":[{"slot":"neutral","index":0,"file":"neutral_0.bin","raw":false,"crc":"1a2b3c4d"}, ...]}
+// The files should be stored (not deflated) in the zip; they are zlib streams, or 153,600 raw RGB565 bytes when raw is true. The
+// unit copies each into its own PSRAM block (as the older facepic tools did), so the pack buffer can be given back at once.
+static long look_inflate(const uint8_t* in, size_t inlen, uint8_t* out, size_t cap)
+{
+    const size_t n = tinfl_decompress_mem_to_mem(out, cap, in, inlen, 0);
+    return n == TINFL_DECOMPRESS_MEM_TO_MEM_FAILED ? -1 : static_cast<long>(n);
+}
+
+bool maipai_picface_apply_look(const uint8_t* payload, size_t len, const char** why)
+{
+    *why = "";
+    if (payload == nullptr || len == 0) {  // back to the drawn face
+        LvglLockGuard lock;
+        xSemaphoreTake(s_mu, portMAX_DELAY);
+        teardown_ui();
+        free_pack_locked();
+        xSemaphoreGive(s_mu);
+        return true;
+    }
+    tpz_t* z = static_cast<tpz_t*>(heap_caps_malloc(sizeof(tpz_t), MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT));
+    if (z == nullptr) { *why = tpk_say(TPK_ERR_MEMORY, 0); return false; }
+    struct Free { void* p; ~Free() { heap_caps_free(p); } } free_z{z};
+    if (tpz_open(z, payload, len) != TPK_OK) { *why = tpk_say(TPK_ERR_ZIP, 0); return false; }
+    const tpz_entry_t* je = tpz_find(z, "look.json");
+    if (je == nullptr || je->usize > 8192) { *why = tpk_say(TPK_ERR_ZIP, 0); return false; }
+    char* json = static_cast<char*>(heap_caps_malloc(je->usize + 1, MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT));
+    if (json == nullptr) { *why = tpk_say(TPK_ERR_MEMORY, 0); return false; }
+    struct Free2 { void* p; ~Free2() { heap_caps_free(p); } } free_j{json};
+    if (tpz_extract(z, je, reinterpret_cast<uint8_t*>(json), je->usize, look_inflate) != TPK_OK) { *why = tpk_say(TPK_ERR_ZIP, 0); return false; }
+    json[je->usize] = 0;
+    cJSON* root = cJSON_Parse(json);
+    if (root == nullptr) { *why = tpk_say(TPK_ERR_ZIP, 0); return false; }
+    struct Root { cJSON* r; ~Root() { cJSON_Delete(r); } } free_root{root};
+    const cJSON* kind = cJSON_GetObjectItem(root, "kind");
+    if (!cJSON_IsString(kind) || strcmp(kind->valuestring, "picture") != 0) { *why = tpk_say(TPK_ERR_ZIP, 0); return false; }
+    const cJSON* mode_j = cJSON_GetObjectItem(root, "mode");
+    const cJSON* fps_j  = cJSON_GetObjectItem(root, "fps");
+    const int mode = cJSON_IsString(mode_j) ? pf_mode_by_name(mode_j->valuestring) : -1;
+    const int fps  = cJSON_IsNumber(fps_j) ? fps_j->valueint : PF_DEFAULT_FPS;
+    pf_err_t e = pf_start_ok(mode, fps);
+    if (e != PF_OK) { *why = pf_say(e, false); return false; }
+    pf_overlay_t ov = pf_overlay_default();
+    const cJSON* ov_j = cJSON_GetObjectItem(root, "overlay");
+    if (cJSON_IsObject(ov_j)) {
+        char* text = cJSON_PrintUnformatted(ov_j);
+        const bool ok = text != nullptr && parse_overlay(text, &ov) && pf_overlay_ok(&ov);
+        if (text != nullptr) cJSON_free(text);
+        if (!ok) { *why = pf_say(PF_ERR_OVERLAY, false); return false; }
+    }
+    const cJSON* frames = cJSON_GetObjectItem(root, "frames");
+    if (!cJSON_IsArray(frames) || cJSON_GetArraySize(frames) < 1 || cJSON_GetArraySize(frames) > PF_MAX_FRAMES) { *why = pf_say(PF_ERR_TOO_MANY_FRAMES, false); return false; }
+
+    Pack* np = static_cast<Pack*>(heap_caps_calloc(1, sizeof(Pack), MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT));
+    if (np == nullptr) { *why = pf_say(PF_ERR_MEMORY, false); return false; }
+    new (np) Pack();
+    pf_plan_init(&np->plan, mode, fps);
+    np->ov = ov;
+    auto fail = [&](pf_err_t err) {
+        for (int s = 0; s < PF_SLOTS; s++) for (int i = 0; i < PF_MAX_FRAMES_PER_SLOT; i++) free_frame(np->fr[s][i]);
+        heap_caps_free(np);
+        *why = pf_say(err, false);
+        return false;
+    };
+    const cJSON* fj = nullptr;
+    cJSON_ArrayForEach(fj, frames)
+    {
+        const cJSON* slot_j = cJSON_GetObjectItem(fj, "slot");
+        const cJSON* idx_j  = cJSON_GetObjectItem(fj, "index");
+        const cJSON* file_j = cJSON_GetObjectItem(fj, "file");
+        const cJSON* raw_j  = cJSON_GetObjectItem(fj, "raw");
+        const cJSON* crc_j  = cJSON_GetObjectItem(fj, "crc");
+        if (!cJSON_IsString(slot_j) || !cJSON_IsNumber(idx_j) || !cJSON_IsString(file_j) || !cJSON_IsString(crc_j)) return fail(PF_ERR_SLOT);
+        const int slot  = pf_slot_by_name(slot_j->valuestring);
+        const int index = idx_j->valueint;
+        const tpz_entry_t* fe = tpz_find(z, file_j->valuestring);
+        if (fe == nullptr || fe->usize == 0) return fail(PF_ERR_MISSING);
+        pf_err_t ae = pf_admit(&np->plan, slot, index, fe->usize, 0);
+        if (ae != PF_OK) return fail(ae);
+        Frame& f = np->fr[slot][index];
+        f.data   = static_cast<uint8_t*>(heap_caps_malloc(fe->usize, MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT));
+        if (f.data == nullptr) return fail(PF_ERR_MEMORY);
+        f.comp = fe->usize;
+        f.flags = cJSON_IsTrue(raw_j) ? PF_FLAG_RAW : PF_FLAG_ZLIB;
+        if (tpz_extract(z, fe, f.data, fe->usize, look_inflate) != TPK_OK) return fail(PF_ERR_CRC);
+        f.crc_want = static_cast<uint32_t>(strtoul(crc_j->valuestring, nullptr, 16));
+        f.crc_run  = pf_crc32(0, f.data, f.comp);
+        if (f.crc_run != f.crc_want) return fail(PF_ERR_CRC);
+        f.got  = f.comp;
+        f.done = true;
+        np->plan.bytes += f.comp;
+        if (index >= np->plan.frames[slot]) np->plan.frames[slot] = static_cast<uint8_t>(index + 1);
+        np->plan.received[slot][index] = 1;
+        np->plan.total_frames = total_frames(np->plan);
+    }
+    // swap it in, then finish exactly like the older commit (prove every picture opens, then show)
+    {
+        LvglLockGuard lock;
+        xSemaphoreTake(s_mu, portMAX_DELAY);
+        teardown_ui();
+        free_pack_locked();
+        s_pack = np;
+        xSemaphoreGive(s_mu);
+    }
+    const std::string out = commit_pack();
+    if (out.find("\"ok\":true") == std::string::npos) {
+        LvglLockGuard lock;
+        xSemaphoreTake(s_mu, portMAX_DELAY);
+        teardown_ui();
+        free_pack_locked();
+        xSemaphoreGive(s_mu);
+        *why = "The robot could not open one of the pictures. Send the pack again, or use a simpler picture.";
+        return false;
+    }
+    return true;
+}
