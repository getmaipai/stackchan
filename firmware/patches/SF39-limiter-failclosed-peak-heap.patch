+// Patch SF39: the speed the head is actually driven at, from one written angle to the next on the real clock, kept as a peak.
+void Servo::note_written(int angle, uint32_t now_ms)
+{
+    if (_written_valid) {
+        const uint32_t dt = now_ms - _written_ms;
+        if (dt > 0 && dt < 500) {
+            const int d = angle > _written ? angle - _written : _written - angle;
+            const int rate = static_cast<int>(static_cast<uint64_t>(d) * 1000u / dt);
+            if (rate > _peak_tenth_dps) _peak_tenth_dps = rate;
+        }
+    }
+    _written = angle;
+    _written_ms = now_ms;
+    _written_valid = true;
+}
