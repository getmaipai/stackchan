+
+#if CONFIG_MAIPAI_SERIAL_TOOLS
+// Patch SF27 (bench): opens and closes the first-run screen n times and reports the free internal RAM before and after (a leak in the screen's
+// objects shows as a drop that does not come back). The record is not touched.
+void maipai_firstrun_bench_cycle(int n, int* free_before, int* free_after)
+{
+    static const maipai_firstrun_host_t host = {wifi_set, hub_known, apply_language, open_wifi_setup, finished};
+    LvglLockGuard lock;
+    maipai_firstrun_init(&host);
+    maipai_firstrun_close();
+    *free_before = static_cast<int>(heap_caps_get_free_size(MALLOC_CAP_INTERNAL));
+    for (int i = 0; i < n; i++) {
+        maipai_firstrun_start();
+        maipai_firstrun_close();
+    }
+    *free_after = static_cast<int>(heap_caps_get_free_size(MALLOC_CAP_INTERNAL));
+}
+#endif
