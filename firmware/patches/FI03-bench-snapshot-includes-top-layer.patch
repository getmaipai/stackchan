+                "self.face.snapshot can capture the subtitle strip or the banner caption. An empty text clears it.",
+                PropertyList({Property("text", kPropertyTypeString, std::string(""))}),
+                [](const PropertyList& properties) -> ReturnValue {
+                    const std::string text = properties["text"].value<std::string>();
+                    LvglLockGuard lock;
+                    auto& chan = GetStackChan();
+                    if (!chan.hasAvatar()) {
+                        return std::string("{\"ok\":false,\"error\":\"no face\"}");
+                    }
+                    chan.avatar().setSpeech(text.c_str());
+                    return std::string("{\"ok\":true}");
+                });
     mcp.AddTool("self.face.bench_emotion",
