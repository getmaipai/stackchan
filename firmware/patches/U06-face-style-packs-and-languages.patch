diff --git a/firmware/main/hal/maipai_pack_core.h b/firmware/main/hal/maipai_pack_core.h
new file mode 100644
--- /dev/null
+++ b/firmware/main/hal/maipai_pack_core.h
@@ -0,0 +1,104 @@
+/*
+ * SPDX-License-Identifier: MIT
+ *
+ * Face style packs (patch U06): each face style is a row of data, not code. A row says how round the eyes are, how far
+ * apart, how far the lids may open and which drawn extras the style has (cat ears and whiskers, a robot's antenna and
+ * bolts, heart eyes). The pure logic: the table and the geometry of the extras. Header-only plain C99 so a host
+ * compiler can test it; the device side draws them in maipai_face.cc. The eye size offset of each style is in
+ * maipai_face_core.h (mf_style_eye_offset). Extras are plain rounded rectangles (the part shape of maipai_decor_core.h):
+ * no image, no font, no new flash.
+ */
+#ifndef MAIPAI_PACK_CORE_H
+#define MAIPAI_PACK_CORE_H
+
+#include "maipai_face_core.h"
+#include "maipai_decor_core.h"
+
+#define MP_X_NONE 0
+#define MP_X_CAT 1
+#define MP_X_ROBOT 2
+#define MP_X_HEARTS 3
+#define MP_MAX_EXTRA_PARTS 12
+
+typedef struct {
+    uint8_t radius_pct; /* 100 a circle, 0 a square */
+    int8_t gap_off;     /* pixels added to each eye's distance from the middle (negative is closer) */
+    uint8_t lid_cap;    /* how far the lids may open, in percent (100 is no limit) */
+    uint8_t extras;     /* MP_X_* */
+} mp_pack_t;
+
+/* Indexed by MF_STYLE_*. */
+static const mp_pack_t MP_PACKS[MF_STYLE_COUNT] = {
+    {100, 0, 100, MP_X_NONE},  /* classic */
+    {100, 0, 100, MP_X_NONE},  /* big_eyes */
+    {100, 0, 100, MP_X_NONE},  /* minimal */
+    {100, -6, 100, MP_X_NONE}, /* round: big round eyes, close together */
+    {100, 8, 100, MP_X_CAT},   /* cat */
+    {22, 12, 100, MP_X_ROBOT}, /* robot: squared eyes */
+    {100, 0, 55, MP_X_NONE},   /* sleepy: heavy lids */
+    {0, 10, 100, MP_X_NONE},   /* retro_pixel: square eyes */
+    {100, 0, 100, MP_X_HEARTS} /* heart_eyes */
+};
+
+static inline const mp_pack_t* mp_pack(int style)
+{
+    return &MP_PACKS[(style >= 0 && style < MF_STYLE_COUNT) ? style : MF_STYLE_CLASSIC];
+}
+
+/* The corner radius in pixels for an eye of `size` pixels. */
+static inline int mp_eye_radius(int radius_pct, int size)
+{
+    if (radius_pct >= 100) {
+        return 0x7FFF; /* LV_RADIUS_CIRCLE */
+    }
+    return size * radius_pct / 200;
+}
+
+/* The lid limit the face uses: the smaller of the style's and the time-of-day band's. */
+static inline int mp_lid_cap(int style, int band_cap)
+{
+    const int own = mp_pack(style)->lid_cap;
+    return own < band_cap ? own : band_cap;
+}
+
+/* The drawn extras of a style, in pixels from the screen centre. Returns how many parts were written. */
+static inline int mp_extra_parts(int extras, md_part_t* out, int cap)
+{
+    int n = 0;
+    if (cap < MP_MAX_EXTRA_PARTS) {
+        return 0;
+    }
+    switch (extras) {
+        case MP_X_CAT:
+            for (int side = -1; side <= 1; side += 2) {
+                /* an ear is two thin bars leaning together, like a roof */
+                out[n++] = md_part(side * 98 - 9, -100, 4, 34, 300, 0, 255);
+                out[n++] = md_part(side * 98 + 9, -100, 4, 34, -300, 0, 255);
+                /* three whiskers a side */
+                for (int k = 0; k < 3; k++) {
+                    out[n++] = md_part(side * 116, 30 + k * 9, 44, 3, side * (k - 1) * 120, 0, 255);
+                }
+            }
+            return n; /* 10 parts */
+        case MP_X_ROBOT:
+            out[n++] = md_part(0, -96, 4, 24, 0, 0, 255);   /* the antenna */
+            out[n++] = md_part(0, -112, 12, 12, 0, 1, 255); /* its ball */
+            out[n++] = md_part(-148, 0, 10, 10, 0, 0, 255); /* two bolts */
+            out[n++] = md_part(148, 0, 10, 10, 0, 0, 255);
+            return n;
+        case MP_X_HEARTS:
+            for (int side = -1; side <= 1; side += 2) {
+                const int cx = side * 70, cy = -16;
+                out[n++] = md_part(cx - 7, cy - 6, 22, 22, 0, 1, 255);
+                out[n++] = md_part(cx + 7, cy - 6, 22, 22, 0, 1, 255);
+                out[n++] = md_part(cx, cy + 4, 22, 22, 450, 0, 255);
+            }
+            return n; /* 6 parts */
+        default: return 0;
+    }
+}
+
+/* Whether the extras of a style cover the eyes (they must then be hidden in a mute, vision-off or quiet look). */
+static inline int mp_extras_cover_eyes(int extras) { return extras == MP_X_HEARTS; }
+
+#endif
