+#if CONFIG_MAIPAI_FACE_PACKS
+lv_obj_t* s_pack_root = nullptr;
+int s_pack_extras     = MP_X_NONE;
+
+// Draws the extras of the style (cat ears and whiskers, robot antenna, heart eyes) as plain rounded bars in the face
+// colour, children of the face. Rebuilt on each apply (a style, colour or band change): a handful of objects.
+void pack_draw(DefaultAvatar* face, const mf_config_t& c, uint8_t r, uint8_t g, uint8_t b)
+{
+    if (s_pack_root != nullptr) {
+        lv_obj_delete(s_pack_root);
+        s_pack_root = nullptr;
+    }
+    s_pack_extras = mp_pack(c.style)->extras;
+    if (s_pack_extras == MP_X_NONE || face->getPanel() == nullptr) {
+        return;
+    }
+    md_part_t parts[MP_MAX_EXTRA_PARTS];
+    const int n = mp_extra_parts(s_pack_extras, parts, MP_MAX_EXTRA_PARTS);
+    s_pack_root = lv_obj_create(face->getPanel()->get());
+    lv_obj_remove_style_all(s_pack_root);
+    lv_obj_remove_flag(s_pack_root, LV_OBJ_FLAG_SCROLLABLE);
+    lv_obj_remove_flag(s_pack_root, LV_OBJ_FLAG_CLICKABLE);  // a touch on an extra is a touch on the face
+    lv_obj_set_size(s_pack_root, 320, 240);
+    lv_obj_set_pos(s_pack_root, 0, 0);
+    for (int i = 0; i < n; i++) {
+        lv_obj_t* o = lv_obj_create(s_pack_root);
+        lv_obj_remove_style_all(o);
+        lv_obj_remove_flag(o, LV_OBJ_FLAG_CLICKABLE);
+        lv_obj_set_size(o, parts[i].w, parts[i].h);
+        lv_obj_set_pos(o, 160 + parts[i].x - parts[i].w / 2, 120 + parts[i].y - parts[i].h / 2);
+        lv_obj_set_style_bg_color(o, lv_color_make(r, g, b), 0);
+        lv_obj_set_style_bg_opa(o, parts[i].opa, 0);
+        lv_obj_set_style_radius(o, parts[i].round ? LV_RADIUS_CIRCLE : 1, 0);
+        lv_obj_set_style_transform_pivot_x(o, parts[i].w / 2, 0);
+        lv_obj_set_style_transform_pivot_y(o, parts[i].h / 2, 0);
+        lv_obj_set_style_transform_rotation(o, parts[i].rot_deg10, 0);
+    }
+}
+
+// Once a second: extras that sit over the eyes (heart eyes) never cover a mute, vision-off or quiet look.
+void pack_tick()
+{
+    if (s_pack_root == nullptr || !mp_extras_cover_eyes(s_pack_extras)) {
+        return;
+    }
+    if (maipai_privacy_bits() != 0) {
+        lv_obj_add_flag(s_pack_root, LV_OBJ_FLAG_HIDDEN);
+    } else {
+        lv_obj_remove_flag(s_pack_root, LV_OBJ_FLAG_HIDDEN);
+    }
+}
