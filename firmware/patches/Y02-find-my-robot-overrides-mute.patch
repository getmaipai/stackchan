# Intent: find-my-robot must make sound even when sounds or the mic are muted, in quiet hours or full quiet. self.audio.play_sound gets an integer property find: 1 plays this chirp through mute, quiet hours and "sounds off" and raises a speaker volume below 70 for it (not saved); 2 ends the find and puts the volume back (also put back five seconds after the last chirp if the host never says). Speaker only: the microphone and the privacy state are never touched.
# Placement: unit (the speaker gate lives on the robot)
# Upstream: firmware/main/hal/maipai_sounds.cc, maipai_sounds_core.h, MIT
# Check after a flash: self.audio.play_sound {name:exclamation,find:1} sounds with the unit muted and volume 0 and the volume reads 0 again after find:2; mute stays on.

diff --git a/firmware/main/hal/maipai_sounds_core.h b/firmware/main/hal/maipai_sounds_core.h
index 1bd154d..690f96f 100644
--- a/firmware/main/hal/maipai_sounds_core.h
+++ b/firmware/main/hal/maipai_sounds_core.h
@@ -127,12 +127,17 @@ static inline int ms_safety(int snd, int urgent)
     return snd == MS_SND_SHUTTER || (snd == MS_SND_NEEDS_YOU && urgent);
 }
 
-/* The one gate. `bypass` is the self-test: it skips "off" and the night rule, never the mute. */
+/* The one gate. `bypass` 1 is the self-test: it skips "off" and the night rule, never the mute. `bypass` 2 is
+ * find-my-robot (patch Y02): the person is locating the unit, so it sounds through mute, quiet hours and "off". */
+#define MS_BYPASS_FIND 2
 static inline ms_reason_t ms_decide(const ms_policy_t* p, int snd, int urgent, int night_now, int bypass)
 {
     if (snd < 0 || snd >= MS_SND_COUNT) {
         return MS_NO_SUCH_SOUND;
     }
+    if (bypass == MS_BYPASS_FIND) {
+        return MS_OK;
+    }
     if (p->muted) {
         return MS_MUTED;
     }
