@@ -0,0 +1,80 @@
+// SPDX-License-Identifier: MIT
+// The Pong screen (patch UX24; spec docs/design/pong.md). Header only, so the host renderer compiles the very same drawing code. The court is drawn by ONE object and one draw callback, redrawn
+// by the caller on every step (the unit redraws only the strip the ball and paddles moved through, as SF78 does for the grid games). The firmware track wires the drag (pg_drag), the 33 ms tick,
+// the sounds and the game-over call (You won or You lost, with the score). No ESP call here.
+#ifndef MAIPAI_PONG_H
+#define MAIPAI_PONG_H
+
+#include <lvgl.h>
+#include <stdio.h>
+#include "maipai_pong_core.h"
+
+namespace pgs {
+
+inline void rect(lv_layer_t* layer, int x, int y, int w, int h, int radius, uint32_t color, lv_opa_t opa = LV_OPA_COVER)
+{
+    lv_draw_rect_dsc_t d;
+    lv_draw_rect_dsc_init(&d);
+    d.bg_color = lv_color_hex(color);
+    d.bg_opa = opa;
+    d.radius = radius;
+    lv_area_t a = {static_cast<lv_coord_t>(x), static_cast<lv_coord_t>(y), static_cast<lv_coord_t>(x + w - 1), static_cast<lv_coord_t>(y + h - 1)};
+    lv_draw_rect(layer, &d, &a);
+}
+
+inline void draw_court(lv_event_t* e)
+{
+    const pg_t* g = static_cast<const pg_t*>(lv_event_get_user_data(e));
+    if (g == nullptr) return;
+    lv_layer_t* layer = lv_event_get_layer(e);
+    rect(layer, PG_X0 - 2, PG_Y0 - 2, PG_W + 4, PG_H + 4, 4, 0x1B3A5C);                               // the frame
+    rect(layer, PG_X0, PG_Y0, PG_W, PG_H, 2, 0x0B1626);                                              // the court
+    for (int y = PG_Y0 + 4; y < PG_Y0 + PG_H - 8; y += 16) rect(layer, PG_X0 + PG_W / 2 - 1, y, 3, 8, 1, 0x35506F);   // the net
+    rect(layer, PG_X0 + PG_PAD_X, PG_Y0 + g->py, PG_PAD_W, PG_PAD_H, 3, 0xF2B24A);                  // the person's paddle (amber)
+    rect(layer, PG_X0 + PG_W - PG_PAD_X - PG_PAD_W, PG_Y0 + g->uy, PG_PAD_W, PG_PAD_H, 3, 0x8FB4DA);   // the unit's paddle (pale blue)
+    int bx, by;
+    pg_ball_px(g, &bx, &by);
+    rect(layer, bx, by, PG_BALL, PG_BALL, LV_RADIUS_CIRCLE, 0xF1EEE4);
+}
+
+inline lv_obj_t* words(lv_obj_t* parent, const char* t, const lv_font_t* font, uint32_t rgb, int x, int y, int w, lv_text_align_t align)
+{
+    lv_obj_t* l = lv_label_create(parent);
+    lv_label_set_text(l, t);
+    lv_obj_set_style_text_font(l, font, 0);
+    lv_obj_set_style_text_color(l, lv_color_hex(rgb), 0);
+    lv_obj_set_style_text_align(l, align, 0);
+    lv_obj_set_width(l, w);
+    lv_obj_set_pos(l, x, y);
+    return l;
+}
+
+// `g` must outlive the screen. The score is above the court: the person's points left, the unit's right.
+inline lv_obj_t* screen(lv_obj_t* parent, const pg_t* g, bool es)
+{
+    lv_obj_t* r = lv_obj_create(parent);
+    lv_obj_remove_style_all(r);
+    lv_obj_remove_flag(r, LV_OBJ_FLAG_SCROLLABLE);
+    lv_obj_set_size(r, 320, 240);
+    lv_obj_set_style_bg_color(r, lv_color_black(), 0);
+    lv_obj_set_style_bg_opa(r, LV_OPA_COVER, 0);
+    lv_obj_t* court = lv_obj_create(r);
+    lv_obj_remove_style_all(court);
+    lv_obj_remove_flag(court, LV_OBJ_FLAG_CLICKABLE);
+    lv_obj_remove_flag(court, LV_OBJ_FLAG_SCROLLABLE);
+    lv_obj_set_size(court, 320, 240);
+    lv_obj_set_pos(court, 0, 0);
+    lv_obj_add_event_cb(court, draw_court, LV_EVENT_DRAW_MAIN, const_cast<pg_t*>(g));
+    char a[16], b[16];
+    snprintf(a, sizeof(a), "%d", g->sp);
+    snprintf(b, sizeof(b), "%d", g->su);
+    words(r, es ? "Tu" : "You", &lv_font_montserrat_16, 0xF2B24A, 8, 10, 100, LV_TEXT_ALIGN_LEFT);
+    words(r, a, &lv_font_montserrat_20, 0xF2B24A, 112, 8, 40, LV_TEXT_ALIGN_RIGHT);
+    words(r, b, &lv_font_montserrat_20, 0x8FB4DA, 168, 8, 40, LV_TEXT_ALIGN_LEFT);
+    words(r, es ? "Unidad" : "Unit", &lv_font_montserrat_16, 0x8FB4DA, 212, 10, 100, LV_TEXT_ALIGN_RIGHT);
+    return r;
+}
+
+}  // namespace pgs
+
+#endif
