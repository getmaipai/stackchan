+/*
+ * SPDX-License-Identifier: MIT
+ *
+ * The asset store, the pure logic (patch SF89; design docs/plan/installed-set.md sections B and G). One shelf of flash for every kind
+ * of installed asset (language, font, style, look, game, sound, phrase and later kinds): a typed 128 byte header, a content id (the
+ * first 8 bytes of the body's SHA-256), a directory ring that makes every change atomic, and reference counts that are computed from
+ * the directory, never stored. Plain C99, no heap; the flash is reached through the three functions of tpc_ops_t, so a host test can
+ * cut the power at every step (host/tests/firmware/assets_core_test.c).
+ *
+ * Region (offsets inside the store's own flash region; the device layer places it): sectors 0 to 7 are the directory ring (the newest
+ * valid sector by sequence number wins, so a cut write leaves the older one standing and each change wears the next sector); the data
+ * sectors follow. An item is one run of whole data sectors. Order of every change: data first, read back and hash, then the directory
+ * sector that points at it. A cut at any step leaves the old set or the new set, never a mixture. Space is handed out first fit from
+ * a rotating start (after the end of the last run written), so the wear spreads over the free sectors.
+ *
+ * Nothing in the store is code: a consumer validates its own kind of body before it loads it.
+ */
+#ifndef MAIPAI_ASSETS_CORE_H
+#define MAIPAI_ASSETS_CORE_H
+
+#include <stdint.h>
+#include <string.h>
+#include "maipai_packcache_core.h"   /* tpc_ops_t, tpk_crc32, tpk_name_ok, tpz_u16/u32 */
+#include "maipai_updatehdr_core.h"   /* the streaming SHA-256 (muh_sha_*) */
+
+#define MAS_SECTOR 4096u
+#define MAS_RING 8u                   /* directory sectors */
+#define MAS_MAGIC 0x31534150u          /* "PAS1" little endian: Pack Asset Store 1 */
+#define MAS_FORMAT 1u
+#define MAS_HDR_BYTES 32u              /* magic, format, count, seq, crc, rotating start, reserved */
+#define MAS_ENTRY_BYTES 128u
+#define MAS_MAX_ENTRIES 31u            /* (4096 - 32) / 128 */
+#define MAS_COVERED (MAS_HDR_BYTES + MAS_MAX_ENTRIES * MAS_ENTRY_BYTES)
+#define MAS_DEPS 4
+#define MAS_NAME_MAX 40
+#define MAS_ASSET_HDR 128u             /* the signed asset header */
+#define MAS_SIG_LEN 64u
+
+/* ---- kinds: the table of schema/asset-kinds.json (a test checks they agree; the index is the position) ---- */
+typedef struct { const char* name; uint8_t max_slots; uint32_t max_bytes; uint8_t owner_trust; } mas_kind_t;
+#define MAS_KINDS 7
+static const mas_kind_t MAS_KIND[MAS_KINDS] = {
+    {"language", 2, 16384u, 0}, {"font", 1, 800000u, 0},   {"style", 8, 256u, 0},   {"look", 2, 1000000u, 1},
+    {"game", 8, 16384u, 0},     {"sound", 2, 400000u, 0}, {"phrase", 1, 150000u, 0},
+};
+#define MAS_MAX_SLOTS 8
+
+/* ---- errors: what went wrong, in plain words, with the Spanish twin (every refusal names the next step) ---- */
+enum {
+    MAS_OK = 0, MAS_E_SHORT, MAS_E_MAGIC, MAS_E_BOARD_ZERO, MAS_E_BOARD_OTHER, MAS_E_KIND, MAS_E_NAME, MAS_E_LENGTH, MAS_E_LICENSE,
+    MAS_E_NEWER_FIRMWARE, MAS_E_RESERVED, MAS_E_SLOT, MAS_E_VERSION, MAS_E_FULL, MAS_E_FLASH, MAS_E_HASH, MAS_E_NO_ITEM, MAS_E_DIR, MAS_E_COUNT
+};
+static const char* const MAS_ERR_EN[MAS_E_COUNT] = {
+    "ok", "The asset header is not 128 bytes. Send the whole .mah file.", "The asset header does not start with MPAH1. Send a file made for the asset store.",
+    "The asset header has no board id. Rebuild the asset for this board.", "The asset is for another board. Download the one for this unit.",
+    "The asset kind is not one this unit knows. Update the unit, then install it again.", "The asset name is not 1 to 40 letters, digits, spaces, dots, dashes or underscores. Rename it and rebuild.",
+    "The asset is empty or larger than its kind allows. Make it smaller.", "The asset has no license. Add a license id and rebuild.",
+    "The asset needs a newer firmware. Update the unit first.", "The reserved bytes of the asset header are not zero. Rebuild the asset.",
+    "That slot does not exist for this kind. Pick a slot inside the kind's limit.", "A newer version of this asset is already installed. Remove it first to go back.",
+    "There is no room for this asset. Remove something you do not use, then install it again.", "The flash could not be written. Try again; if it repeats, restart the unit.",
+    "The asset's bytes do not match its header. Download it again.", "There is no such asset on this unit. List the installed assets first.", "The asset directory is damaged. Restart the unit; it will use the built-in set."};
+static const char* const MAS_ERR_ES[MAS_E_COUNT] = {
+    "ok", "El encabezado del recurso no tiene 128 bytes. Envia el archivo .mah completo.", "El encabezado del recurso no empieza con MPAH1. Envia un archivo hecho para el almacen.",
+    "El encabezado no tiene id de placa. Reconstruye el recurso para esta placa.", "El recurso es para otra placa. Descarga el de esta unidad.",
+    "La unidad no conoce ese tipo de recurso. Actualizala e instalalo otra vez.", "El nombre del recurso no tiene de 1 a 40 letras, digitos, espacios, puntos, guiones o guiones bajos. Cambialo y reconstruye.",
+    "El recurso esta vacio o es mas grande de lo que permite su tipo. Hazlo mas pequeno.", "El recurso no tiene licencia. Anade un id de licencia y reconstruye.",
+    "El recurso necesita un firmware mas nuevo. Actualiza la unidad primero.", "Los bytes reservados del encabezado no son cero. Reconstruye el recurso.",
+    "Esa ranura no existe para este tipo. Elige una dentro del limite.", "Ya hay una version mas nueva instalada. Quitala primero para volver atras.",
+    "No hay espacio para este recurso. Quita algo que no uses e instalalo otra vez.", "No se pudo escribir la memoria. Intentalo otra vez; si se repite, reinicia la unidad.",
+    "Los bytes del recurso no coinciden con su encabezado. Descargalo otra vez.", "No hay ese recurso en esta unidad. Mira primero la lista de instalados.", "El directorio de recursos esta danado. Reinicia la unidad; usara el conjunto incorporado."};
+
+/* ---- the asset header (installed-set.md B4, G2), 128 bytes little endian ---- */
+typedef struct {
+    uint32_t version, body_len, min_build, ram_bytes, flash_bytes;
+    uint8_t sha[32];
+    uint8_t kind, format;
+    uint16_t flags, license, author;
+    char name[MAS_NAME_MAX + 1];
+    char code[9];
+} mah_t;
+
+/* Checks the header's shape (not the signature: the device verifies that first, with the release key, except for the owner kinds). board: this unit's board id.
+ * 0 on success, else a MAS_E_* code. */
+static inline int mah_parse(const uint8_t* h, size_t len, const char* board, uint32_t fw_build, mah_t* out)
+{
+    if (h == NULL || len != MAS_ASSET_HDR) return MAS_E_SHORT;
+    if (memcmp(h, "MPAH1\0\0\0", 8) != 0) return MAS_E_MAGIC;
+    int zero = 1;
+    for (int i = 48; i < 56; i++) if (h[i] != 0) zero = 0;
+    if (zero) return MAS_E_BOARD_ZERO;
+    size_t bl = 0;
+    while (bl < 8 && h[48 + bl] != 0) bl++;
+    if (board == NULL || strlen(board) != bl || memcmp(board, h + 48, bl) != 0) return MAS_E_BOARD_OTHER;
+    memset(out, 0, sizeof(*out));
+    out->kind = h[56];
+    if (out->kind >= MAS_KINDS) return MAS_E_KIND;
+    out->version = tpz_u32(h + 8);
+    out->body_len = tpz_u32(h + 12);
+    memcpy(out->sha, h + 16, 32);
+    out->format = h[57];
+    out->flags = tpz_u16(h + 58);
+    out->min_build = tpz_u32(h + 60);
+    memcpy(out->name, h + 64, MAS_NAME_MAX);
+    out->name[MAS_NAME_MAX] = '\0';
+    if (!tpk_name_ok(out->name)) return MAS_E_NAME;
+    memcpy(out->code, h + 104, 8);
+    out->code[8] = '\0';
+    out->ram_bytes = tpz_u32(h + 112);
+    out->flash_bytes = tpz_u32(h + 116);
+    out->license = tpz_u16(h + 120);
+    out->author = tpz_u16(h + 122);
+    for (int i = 124; i < 128; i++) if (h[i] != 0) return MAS_E_RESERVED;
+    if (out->body_len == 0 || out->body_len > MAS_KIND[out->kind].max_bytes || out->version == 0) return MAS_E_LENGTH;
+    if (out->license == 0) return MAS_E_LICENSE;
+    if (out->min_build > fw_build) return MAS_E_NEWER_FIRMWARE;
+    return MAS_OK;
+}
+
+/* ---- the directory ---- */
+typedef struct {
+    uint8_t kind;        /* 0xFF: empty */
+    uint8_t slot;
+    uint8_t active;      /* the kind's consumer uses this one */
+    uint8_t name_len;
+    uint16_t first;      /* first data sector */
+    uint16_t nsect;
+    uint32_t version, size;
+    uint8_t sha[32];
+    char name[MAS_NAME_MAX + 1];
+    char code[9];
+    uint8_t deps[MAS_DEPS][8];   /* ids (first 8 bytes of the body hash) this item needs; all zero: none */
+} mas_entry_t;
+
+typedef struct {
+    mas_entry_t e[MAS_MAX_ENTRIES];
+    uint8_t used[MAS_MAX_ENTRIES];
+    uint32_t seq;
+    uint16_t rot;         /* where the next search for free sectors starts: after the last run written */
+    uint8_t pos;          /* ring sector of the current directory (MAS_RING when none) */
+    uint16_t data_sectors;
+} mas_dir_t;
+
+typedef struct { uint8_t dir_found; uint8_t dir_corrupt; uint8_t damaged[MAS_MAX_ENTRIES]; } mas_report_t;
+
+static inline void mas_encode(const mas_dir_t* d, uint8_t out[MAS_SECTOR])
+{
+    memset(out, 0xFF, MAS_SECTOR);
+    uint16_t count = 0;
+    for (unsigned i = 0; i < MAS_MAX_ENTRIES; i++) count += d->used[i] ? 1 : 0;
+    tpc_put32(out, MAS_MAGIC);
+    tpc_put16(out + 4, (uint16_t)MAS_FORMAT);
+    tpc_put16(out + 6, count);
+    tpc_put32(out + 8, d->seq);
+    tpc_put32(out + 12, 0);
+    tpc_put16(out + 16, d->rot);
+    memset(out + 18, 0, MAS_HDR_BYTES - 18);
+    for (unsigned i = 0; i < MAS_MAX_ENTRIES; i++) {
+        uint8_t* p = out + MAS_HDR_BYTES + (size_t)i * MAS_ENTRY_BYTES;
+        memset(p, 0xFF, MAS_ENTRY_BYTES);
+        if (!d->used[i]) continue;
+        const mas_entry_t* e = &d->e[i];
+        p[0] = e->kind; p[1] = e->slot; p[2] = e->active; p[3] = e->name_len;
+        tpc_put16(p + 4, e->first); tpc_put16(p + 6, e->nsect);
+        tpc_put32(p + 8, e->version); tpc_put32(p + 12, e->size);
+        memcpy(p + 16, e->sha, 32);
+        memset(p + 48, 0, MAS_NAME_MAX);
+        memcpy(p + 48, e->name, e->name_len);
+        memcpy(p + 88, e->code, 8);
+        memcpy(p + 96, e->deps, 32);
+    }
+    tpc_put32(out + 12, tpk_crc32(0, out, MAS_COVERED));
+}
+
+/* 1 when the sector is a valid directory; fills d (its data_sectors is the caller's). */
+static inline int mas_decode(const uint8_t* in, mas_dir_t* d)
+{
+    if (tpz_u32(in) != MAS_MAGIC || tpz_u16(in + 4) != MAS_FORMAT) return 0;
+    uint8_t tmp[MAS_COVERED];
+    memcpy(tmp, in, MAS_COVERED);
+    const uint32_t want = tpz_u32(tmp + 12);
+    tpc_put32(tmp + 12, 0);
+    if (tpk_crc32(0, tmp, MAS_COVERED) != want) return 0;
+    const uint16_t ds = d->data_sectors;
+    memset(d, 0, sizeof(*d));
+    d->data_sectors = ds;
+    d->seq = tpz_u32(in + 8);
+    d->rot = tpz_u16(in + 16);
+    for (unsigned i = 0; i < MAS_MAX_ENTRIES; i++) {
+        const uint8_t* p = in + MAS_HDR_BYTES + (size_t)i * MAS_ENTRY_BYTES;
+        if (p[0] == 0xFF) continue;
+        mas_entry_t* e = &d->e[i];
+        e->kind = p[0]; e->slot = p[1]; e->active = p[2]; e->name_len = p[3];
+        e->first = tpz_u16(p + 4); e->nsect = tpz_u16(p + 6);
+        e->version = tpz_u32(p + 8); e->size = tpz_u32(p + 12);
+        memcpy(e->sha, p + 16, 32);
+        memcpy(e->name, p + 48, MAS_NAME_MAX);
+        e->name[MAS_NAME_MAX] = '\0';
+        memcpy(e->code, p + 88, 8);
+        e->code[8] = '\0';
+        memcpy(e->deps, p + 96, 32);
+        d->used[i] = 1;
+    }
+    return 1;
+}
+
+static inline uint32_t mas_sectors_for(uint32_t bytes) { return (bytes + MAS_SECTOR - 1u) / MAS_SECTOR; }
+
+static inline int mas_entry_sane(const mas_entry_t* e, uint16_t data_sectors)
+{
+    if (e->kind >= MAS_KINDS || e->slot >= MAS_KIND[e->kind].max_slots) return 0;
+    if (e->name_len == 0 || e->name_len > MAS_NAME_MAX || e->size == 0 || e->size > MAS_KIND[e->kind].max_bytes) return 0;
+    if (e->nsect != mas_sectors_for(e->size) || e->first + (uint32_t)e->nsect > data_sectors) return 0;
+    return 1;
+}
+
+static inline int mas_overlap(const mas_entry_t* a, const mas_entry_t* b)
+{
+    return a->first < b->first + b->nsect && b->first < a->first + a->nsect;
+}
+
+/* Reads a data sector range's hash and compares it with the entry: 0 when the bytes match. */
+static inline int mas_verify(const tpc_ops_t* ops, void* ctx, uint8_t* sector, const mas_entry_t* e)
+{
+    muh_sha_t s;
+    muh_sha_begin(&s);
+    uint32_t left = e->size;
+    for (uint32_t i = 0; i < e->nsect; i++) {
+        if (ops->read(ctx, (MAS_RING + e->first + i) * MAS_SECTOR, sector, MAS_SECTOR) != 0) return MAS_E_FLASH;
+        const uint32_t take = left < MAS_SECTOR ? left : MAS_SECTOR;
+        muh_sha_update(&s, sector, take);
+        left -= take;
+        if (ops->pause != NULL) ops->pause(ctx);
+    }
+    uint8_t out[32];
+    muh_sha_end(&s, out);
+    return memcmp(out, e->sha, 32) == 0 ? MAS_OK : MAS_E_HASH;
+}
+
+/* Reads the ring and takes the newest valid directory. An entry whose bytes do not match is reported damaged (the consumer uses its fallback). */
+static inline void mas_scan(const tpc_ops_t* ops, void* ctx, uint8_t* sector, uint16_t data_sectors, mas_dir_t* out, mas_report_t* rep)
+{
+    memset(out, 0, sizeof(*out));
+    memset(rep, 0, sizeof(*rep));
+    out->data_sectors = data_sectors;
+    out->pos = (uint8_t)MAS_RING;
+    mas_dir_t cand;
+    for (unsigned s = 0; s < MAS_RING; s++) {
+        memset(&cand, 0, sizeof(cand));
+        cand.data_sectors = data_sectors;
+        if (ops->read(ctx, s * MAS_SECTOR, sector, MAS_SECTOR) != 0) continue;
+        if (tpz_u32(sector) == MAS_MAGIC && !mas_decode(sector, &cand)) rep->dir_corrupt = 1;
+        else if (tpz_u32(sector) == MAS_MAGIC) {
+            if (!rep->dir_found || cand.seq > out->seq) {
+                *out = cand;
+                out->pos = (uint8_t)s;
+                rep->dir_found = 1;
+            }
+        }
+    }
+    for (unsigned i = 0; i < MAS_MAX_ENTRIES; i++) {
+        if (!out->used[i]) continue;
+        if (!mas_entry_sane(&out->e[i], data_sectors)) { out->used[i] = 0; rep->damaged[i] = 1; continue; }
+        if (mas_verify(ops, ctx, sector, &out->e[i]) != MAS_OK) rep->damaged[i] = 1;
+    }
+}
+
+/* The next free run of nsect data sectors that overlaps nothing listed (and not `replacing`'s run, so the old item stays intact until the directory flips),
+ * searching from the rotating start and wrapping. Returns the first sector or -1. */
+static inline int mas_find_run(const mas_dir_t* d, uint32_t nsect)
+{
+    if (nsect == 0 || nsect > d->data_sectors) return -1;
+    for (uint32_t k = 0; k < d->data_sectors; k++) {
+        const uint32_t first = (d->rot + k) % d->data_sectors;
+        if (first + nsect > d->data_sectors) continue;   /* a run never wraps */
+        mas_entry_t probe;
+        memset(&probe, 0, sizeof(probe));
+        probe.first = (uint16_t)first;
+        probe.nsect = (uint16_t)nsect;
+        int clash = 0;
+        for (unsigned i = 0; i < MAS_MAX_ENTRIES && !clash; i++) {
+            if (d->used[i] && mas_overlap(&probe, &d->e[i])) clash = 1;
+        }
+        if (!clash) return (int)first;
+    }
+    return -1;
+}
+
+static inline int mas_write_dir(const tpc_ops_t* ops, void* ctx, uint8_t* sector, mas_dir_t* d)
+{
+    d->seq++;
+    const uint8_t next = (uint8_t)(d->pos >= MAS_RING ? 0 : (d->pos + 1) % MAS_RING);
+    mas_encode(d, sector);
+    if (ops->erase(ctx, (uint32_t)next * MAS_SECTOR, MAS_SECTOR) != 0) return MAS_E_FLASH;
+    if (ops->write(ctx, (uint32_t)next * MAS_SECTOR, sector, MAS_SECTOR) != 0) return MAS_E_FLASH;
+    d->pos = next;
+    return MAS_OK;
+}
+
+static inline int mas_find(const mas_dir_t* d, int kind, int slot)
+{
+    for (unsigned i = 0; i < MAS_MAX_ENTRIES; i++) {
+        if (d->used[i] && d->e[i].kind == kind && d->e[i].slot == slot) return (int)i;
+    }
+    return -1;
+}
+
+/* What an install will do: where it goes, and which entry it replaces. begin checks the header against the directory (slot, version, room). */
+typedef struct { mah_t h; int first; uint32_t nsect; int replaces; int index; uint32_t written; muh_sha_t sha; } mas_plan_t;
+
+/* slot -1: the first free slot of the kind. */
+static inline int mas_begin(const mas_dir_t* d, const mah_t* h, int slot, mas_plan_t* p)
+{
+    memset(p, 0, sizeof(*p));
+    p->h = *h;
+    const mas_kind_t* k = &MAS_KIND[h->kind];
+    if (slot < 0) {
+        for (int s = 0; s < k->max_slots && slot < 0; s++) if (mas_find(d, h->kind, s) < 0) slot = s;
+        if (slot < 0) return MAS_E_FULL;
+    }
+    if (slot >= k->max_slots) return MAS_E_SLOT;
+    p->replaces = mas_find(d, h->kind, slot);
+    if (p->replaces >= 0 && d->e[p->replaces].version > h->version && strcmp(d->e[p->replaces].name, h->name) == 0) return MAS_E_VERSION;
+    p->nsect = mas_sectors_for(h->body_len);
+    p->first = mas_find_run(d, p->nsect);   /* the old run is still listed, so the new one never touches it */
+    if (p->first < 0) return MAS_E_FULL;
+    p->index = slot;
+    muh_sha_begin(&p->sha);
+    return MAS_OK;
+}
+
+/* One piece of the body (at most one sector, in order): writes it into the run and feeds the hash. Pieces are whole sectors except the last. */
+static inline int mas_data(const tpc_ops_t* ops, void* ctx, uint8_t* sector, mas_plan_t* p, const uint8_t* data, size_t len)
+{
+    if (len == 0 || len > MAS_SECTOR || p->written + len > p->h.body_len) return MAS_E_LENGTH;
+    const uint32_t idx = p->written / MAS_SECTOR;
+    memset(sector, 0xFF, MAS_SECTOR);
+    memcpy(sector, data, len);
+    const uint32_t off = (MAS_RING + (uint32_t)p->first + idx) * MAS_SECTOR;
+    if (ops->erase(ctx, off, MAS_SECTOR) != 0 || ops->write(ctx, off, sector, MAS_SECTOR) != 0) return MAS_E_FLASH;
+    muh_sha_update(&p->sha, data, len);
+    p->written += (uint32_t)len;
+    if (ops->pause != NULL) ops->pause(ctx);
+    return MAS_OK;
+}
+
+/* All the body streamed: the length and hash must equal the header's, the run is read back and hashed, then the directory flips. */
+static inline int mas_commit(const tpc_ops_t* ops, void* ctx, uint8_t* sector, mas_dir_t* d, mas_plan_t* p, const uint8_t deps[MAS_DEPS][8])
+{
+    if (p->written != p->h.body_len) return MAS_E_LENGTH;
+    uint8_t got[32];
+    muh_sha_end(&p->sha, got);
+    if (memcmp(got, p->h.sha, 32) != 0) return MAS_E_HASH;
+    mas_entry_t e;
+    memset(&e, 0, sizeof(e));
+    e.kind = p->h.kind; e.slot = (uint8_t)p->index;
+    e.first = (uint16_t)p->first; e.nsect = (uint16_t)p->nsect;
+    e.version = p->h.version; e.size = p->h.body_len;
+    memcpy(e.sha, p->h.sha, 32);
+    e.name_len = (uint8_t)strlen(p->h.name);
+    memcpy(e.name, p->h.name, e.name_len);
+    memcpy(e.code, p->h.code, 8);
+    if (deps != NULL) memcpy(e.deps, deps, 32);
+    const int v = mas_verify(ops, ctx, sector, &e);
+    if (v != MAS_OK) return v;
+    mas_dir_t next = *d;
+    int slot_i = p->replaces;
+    if (slot_i < 0) {
+        for (unsigned i = 0; i < MAS_MAX_ENTRIES && slot_i < 0; i++) if (!next.used[i]) slot_i = (int)i;
+        if (slot_i < 0) return MAS_E_FULL;
+    } else {
+        e.active = next.e[slot_i].active;   /* a replaced item keeps its place as the active one */
+    }
+    int any_active = 0;
+    for (unsigned i = 0; i < MAS_MAX_ENTRIES; i++) if (next.used[i] && (int)i != slot_i && next.e[i].kind == e.kind && next.e[i].active) any_active = 1;
+    if (!any_active) e.active = 1;   /* the first item of a kind becomes the active one */
+    next.e[slot_i] = e;
+    next.used[slot_i] = 1;
+    next.rot = (uint16_t)((e.first + e.nsect) % (next.data_sectors ? next.data_sectors : 1u));
+    const int w = mas_write_dir(ops, ctx, sector, &next);
+    if (w != MAS_OK) return w;
+    *d = next;
+    return MAS_OK;
+}
+
+/* The whole body at once (the host tests and small installs). */
+static inline int mas_store(const tpc_ops_t* ops, void* ctx, uint8_t* sector, mas_dir_t* d, const mah_t* h, int slot, const uint8_t* body, const uint8_t deps[MAS_DEPS][8])
+{
+    mas_plan_t p;
+    int r = mas_begin(d, h, slot, &p);
+    if (r != MAS_OK) return r;
+    for (uint32_t at = 0; at < h->body_len; at += MAS_SECTOR) {
+        const uint32_t take = h->body_len - at < MAS_SECTOR ? h->body_len - at : MAS_SECTOR;
+        r = mas_data(ops, ctx, sector, &p, body + at, take);
+        if (r != MAS_OK) return r;
+    }
+    return mas_commit(ops, ctx, sector, d, &p, deps);
+}
+
+/* One directory write, no erase of data: the space is free at the next install. If the removed item was active, another of its kind takes over (the lowest slot). */
+static inline int mas_remove(const tpc_ops_t* ops, void* ctx, uint8_t* sector, mas_dir_t* d, int kind, int slot)
+{
+    const int i = mas_find(d, kind, slot);
+    if (i < 0) return MAS_E_NO_ITEM;
+    mas_dir_t next = *d;
+    const int was_active = next.e[i].active;
+    next.used[i] = 0;
+    if (was_active) {
+        int best = -1;
+        for (unsigned j = 0; j < MAS_MAX_ENTRIES; j++) {
+            if (next.used[j] && next.e[j].kind == kind && (best < 0 || next.e[j].slot < next.e[best].slot)) best = (int)j;
+        }
+        if (best >= 0) next.e[best].active = 1;
+    }
+    const int w = mas_write_dir(ops, ctx, sector, &next);
+    if (w != MAS_OK) return w;
+    *d = next;
+    return MAS_OK;
+}
+
+/* Makes this slot the kind's active item: one directory write; nothing else is written. */
+static inline int mas_swap(const tpc_ops_t* ops, void* ctx, uint8_t* sector, mas_dir_t* d, int kind, int slot)
+{
+    const int i = mas_find(d, kind, slot);
+    if (i < 0) return MAS_E_NO_ITEM;
+    mas_dir_t next = *d;
+    for (unsigned j = 0; j < MAS_MAX_ENTRIES; j++) if (next.used[j] && next.e[j].kind == kind) next.e[j].active = (j == (unsigned)i) ? 1 : 0;
+    const int w = mas_write_dir(ops, ctx, sector, &next);
+    if (w != MAS_OK) return w;
+    *d = next;
+    return MAS_OK;
+}
+
+/* The active item of a kind, or -1. */
+static inline int mas_active(const mas_dir_t* d, int kind)
+{
+    for (unsigned i = 0; i < MAS_MAX_ENTRIES; i++) if (d->used[i] && d->e[i].kind == kind && d->e[i].active) return (int)i;
+    return -1;
+}
+
+/* The reference count of an asset id (the first 8 bytes of its hash): the entries that list it as a dependency, plus the active consumers. Never stored. */
+static inline int mas_refs(const mas_dir_t* d, const uint8_t id[8])
+{
+    int n = 0;
+    for (unsigned i = 0; i < MAS_MAX_ENTRIES; i++) {
+        if (!d->used[i]) continue;
+        for (int k = 0; k < MAS_DEPS; k++) if (memcmp(d->e[i].deps[k], id, 8) == 0) n++;
+        if (d->e[i].active && memcmp(d->e[i].sha, id, 8) == 0) n++;
+    }
+    return n;
+}
+
+/* Free data sectors (those no listed item holds). */
+static inline uint32_t mas_free_sectors(const mas_dir_t* d)
+{
+    uint32_t used = 0;
+    for (unsigned i = 0; i < MAS_MAX_ENTRIES; i++) if (d->used[i]) used += d->e[i].nsect;
+    return d->data_sectors - used;
+}
+
+#endif
