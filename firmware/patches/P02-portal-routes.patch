+WifiConfigurationAp::WifiConfigurationAp()
+{
+    event_group_ = xEventGroupCreate();
+    language_ = "en-US";
+    sleep_mode_ = false;
+    instance_any_id_ = nullptr;
+    instance_got_ip_ = nullptr;
+    max_tx_power_ = 0;
+    remember_bssid_ = false;
+}
+
+WifiConfigurationAp::~WifiConfigurationAp()
+{
+    Stop();
+    if (event_group_) {
+        vEventGroupDelete(event_group_);
+        event_group_ = nullptr;
+    }
+}
