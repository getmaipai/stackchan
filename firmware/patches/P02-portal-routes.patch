+void WifiConfigurationAp::StartWebServer()
+{
+    httpd_config_t config = HTTPD_DEFAULT_CONFIG();
+    config.max_uri_handlers = 8;
+    config.max_open_sockets = 4;
+    config.lru_purge_enable = true;
+    config.uri_match_fn = httpd_uri_match_wildcard;
+    config.recv_wait_timeout = 15;
+    config.send_wait_timeout = 15;
+    ESP_ERROR_CHECK(httpd_start(&server_, &config));
+
+    // The page, in the language of the unit.
+    httpd_uri_t page = {
+        .uri = "/",
+        .method = HTTP_GET,
+        .handler = [](httpd_req_t* req) -> esp_err_t {
+            const char* marker = strstr(mp_page, MP_PAGE_MARKER);
+            std::unique_ptr<char[]> table(new (std::nothrow) char[1792]);
+            if (!marker || !table || mp_table_json(s_lang, table.get(), 1792) == 0) {
+                httpd_resp_send_err(req, HTTPD_500_INTERNAL_SERVER_ERROR, "Setup page unavailable. Restart StackChan and try again.");
+                return ESP_FAIL;
+            }
+            httpd_resp_set_type(req, "text/html; charset=utf-8");
+            set_common_headers(req);
+            httpd_resp_set_hdr(req, "Content-Security-Policy",
+                               "default-src 'none'; style-src 'unsafe-inline'; script-src 'unsafe-inline'; "
+                               "connect-src 'self'; frame-ancestors 'none'");
+            httpd_resp_send_chunk(req, mp_page, marker - mp_page);
+            httpd_resp_sendstr_chunk(req, table.get());
+            httpd_resp_sendstr_chunk(req, marker + strlen(MP_PAGE_MARKER));
+            httpd_resp_sendstr_chunk(req, NULL);
+            return ESP_OK;
+        },
+        .user_ctx = NULL,
+    };
+    ESP_ERROR_CHECK(httpd_register_uri_handler(server_, &page));
+
+    // Nearby networks only, strongest first. Saved networks are never listed.
+    httpd_uri_t scan = {
+        .uri = "/scan",
+        .method = HTTP_GET,
+        .handler = [](httpd_req_t* req) -> esp_err_t {
+            auto* self = static_cast<WifiConfigurationAp*>(req->user_ctx);
+            std::vector<mp_net_t> nets;
+            {
+                std::lock_guard<std::mutex> lock(self->mutex_);
+                for (const auto& r : self->ap_records_) {
+                    if (nets.size() >= kMaxScan) break;
+                    mp_net_t n = {};
+                    strlcpy(n.ssid, reinterpret_cast<const char*>(r.ssid), sizeof(n.ssid));
+                    n.rssi = r.rssi;
+                    n.secure = r.authmode != WIFI_AUTH_OPEN;
+                    nets.push_back(n);
+                }
+            }
+            int count = mp_nets_tidy(nets.data(), (int)nets.size());
+            std::unique_ptr<char[]> buf(new (std::nothrow) char[1280]);
+            if (!buf) {
+                httpd_resp_send_err(req, HTTPD_500_INTERNAL_SERVER_ERROR, "Out of memory. Try again in a moment.");
+                return ESP_FAIL;
+            }
+            mp_nets_json(nets.data(), count, buf.get(), 1280);
+            httpd_resp_set_type(req, "application/json");
+            set_common_headers(req);
+            httpd_resp_send(req, buf.get(), HTTPD_RESP_USE_STRLEN);
+            return ESP_OK;
+        },
+        .user_ctx = this,
+    };
+    ESP_ERROR_CHECK(httpd_register_uri_handler(server_, &scan));
+
+    // Code, network, password and optional host address in one JSON object.
+    httpd_uri_t submit = {
+        .uri = "/submit",
+        .method = HTTP_POST,
+        .handler = [](httpd_req_t* req) -> esp_err_t {
+            auto* self = static_cast<WifiConfigurationAp*>(req->user_ctx);
+            size_t len = req->content_len;
+            if (len == 0 || len > kMaxBody) {
+                httpd_resp_send_err(req, HTTPD_400_BAD_REQUEST, "Request too large. Reload the page and try again.");
+                return ESP_FAIL;
+            }
+            std::unique_ptr<char[]> body(new (std::nothrow) char[len + 1]);
+            if (!body) {
+                httpd_resp_send_err(req, HTTPD_500_INTERNAL_SERVER_ERROR, "Out of memory. Try again in a moment.");
+                return ESP_FAIL;
+            }
+            size_t got = 0;
+            while (got < len) {
+                int r = httpd_req_recv(req, body.get() + got, len - got);
+                if (r <= 0) {
+                    if (r == HTTPD_SOCK_ERR_TIMEOUT) continue;
+                    return ESP_FAIL;
+                }
+                got += r;
+            }
+            body[len] = 0;
+
+            cJSON* json = cJSON_Parse(body.get());
+            body.reset();
+            if (!json) {
+                httpd_resp_send_err(req, HTTPD_400_BAD_REQUEST, "Could not read the form. Reload the page and try again.");
+                return ESP_FAIL;
+            }
+            auto text = [&](const char* key) -> const char* {
+                cJSON* it = cJSON_GetObjectItemCaseSensitive(json, key);
+                return (cJSON_IsString(it) && it->valuestring) ? it->valuestring : "";
+            };
+
+            // The fields.
+            std::string ssid = text("ssid");
+            std::string password = text("password");
+            char host_url[80];
+            int host = mp_host_url(text("host"), host_url, sizeof(host_url));
+            cJSON_Delete(json);
+            if (host < 0) {
+                send_json_status(req, false, MP_S_BADHOST);
+                return ESP_OK;
+            }
+            if (!mp_ssid_ok(ssid.c_str()) || password.size() > 64) {
+                send_json_status(req, false, MP_S_FAIL);
+                return ESP_OK;
+            }
+            // Join first; save only what worked.
+            if (!self->ConnectToWifi(ssid, password)) {
+                send_json_status(req, false, MP_S_FAIL);
+                return ESP_OK;
+            }
+            self->Save(ssid, password);
+            if (host > 0) {
+                nvs_handle_t h;
+                if (nvs_open("websocket", NVS_READWRITE, &h) == ESP_OK) {
+                    nvs_set_str(h, "url", host_url);
+                    nvs_commit(h);
+                    nvs_close(h);
+                }
+            }
+            send_json_status(req, true, 0);
+            // Close the portal a little later so the answer reaches the phone first.
+            request_exit_later(
+                self, [](WifiConfigurationAp* s) {
+                    if (s->on_exit_requested_) s->on_exit_requested_();
+                }, 3000);
+            return ESP_OK;
+        },
+        .user_ctx = this,
+    };
+    ESP_ERROR_CHECK(httpd_register_uri_handler(server_, &submit));
+
+    // Everything else, including the "is there internet" probes of phones and PCs, goes to the page. Registered
+    // last so the three routes above win.
+    httpd_uri_t catch_all = {
+        .uri = "/*",
+        .method = HTTP_GET,
+        .handler = [](httpd_req_t* req) -> esp_err_t {
+            httpd_resp_set_status(req, "302 Found");
+            httpd_resp_set_hdr(req, "Location", kPortalUrl);
+            set_common_headers(req);
+            httpd_resp_send(req, NULL, 0);
+            return ESP_OK;
+        },
+        .user_ctx = NULL,
+    };
+    ESP_ERROR_CHECK(httpd_register_uri_handler(server_, &catch_all));
+    ESP_LOGI(TAG, "Setup page ready");
+}
+
+bool WifiConfigurationAp::ConnectToWifi(const std::string& ssid, const std::string& password)
+{
+    if (!mp_ssid_ok(ssid.c_str()) || password.length() > 64) {
+        ESP_LOGE(TAG, "Network name or password has an unusable length");
+        return false;
+    }
+    is_connecting_ = true;
+    last_connected_channel_ = 0;
+
+    // Two tries, 3 s apart: the first association after the channel switch is often refused for a moment.
+    constexpr int kMaxAttempts = 2;
+    constexpr int kRetryDelayMs = 3000;
+    bool connected = false;
+
+    for (int attempt = 1; attempt <= kMaxAttempts && !connected; ++attempt) {
+        if (attempt > 1) {
+            vTaskDelay(pdMS_TO_TICKS(kRetryDelayMs));
+        }
+        xEventGroupClearBits(event_group_, WIFI_CONNECTED_BIT | WIFI_FAIL_BIT);
+        esp_wifi_scan_stop();
+
+        wifi_config_t wifi_config;
+        bzero(&wifi_config, sizeof(wifi_config));
+        memcpy(wifi_config.sta.ssid, ssid.data(), ssid.size());
+        memcpy(wifi_config.sta.password, password.data(), password.size());
+        wifi_config.sta.scan_method = WIFI_ALL_CHANNEL_SCAN;
+        wifi_config.sta.failure_retry_cnt = 1;
+
+        ESP_ERROR_CHECK(esp_wifi_set_config(WIFI_IF_STA, &wifi_config));
+        if (esp_wifi_connect() != ESP_OK) {
+            continue;
+        }
+        EventBits_t bits = xEventGroupWaitBits(event_group_, WIFI_CONNECTED_BIT | WIFI_FAIL_BIT, pdTRUE, pdFALSE,
+#ifdef CONFIG_SOC_WIFI_SUPPORT_5G
+                                               pdMS_TO_TICKS(25000)
+#else
+                                               pdMS_TO_TICKS(10000)
+#endif
+        );
+        if (bits & WIFI_CONNECTED_BIT) {
+            connected = true;
+        } else if (bits == 0) {
+            esp_wifi_disconnect();  // cancel a try still in flight before the next one
+        }
+    }
+    is_connecting_ = false;
+
+    if (connected) {
+        wifi_ap_record_t ap_info;
+        if (esp_wifi_sta_get_ap_info(&ap_info) == ESP_OK) {
+            last_connected_channel_ = ap_info.primary;
+        }
+        esp_wifi_disconnect();
+        ESP_LOGI(TAG, "Joined the home network on channel %u", last_connected_channel_);
+        return true;
+    }
+    ESP_LOGW(TAG, "Could not join the network after %d tries", kMaxAttempts);
+    return false;
+}
+
+void WifiConfigurationAp::Save(const std::string& ssid, const std::string& password)
+{
+    uint8_t channel = last_connected_channel_;
+    if (channel == 0) {
+        std::lock_guard<std::mutex> lock(mutex_);
+        for (const auto& rec : ap_records_) {
+            if (ssid == reinterpret_cast<const char*>(rec.ssid)) {
+                channel = rec.primary;
+                break;
+            }
+        }
+    }
+    SsidManager::GetInstance().AddSsid(ssid, password, channel);
+}
+
+void WifiConfigurationAp::OnExitRequested(std::function<void()> callback)
+{
+    on_exit_requested_ = callback;
+}
+
+void WifiConfigurationAp::WifiEventHandler(void* arg, esp_event_base_t event_base, int32_t event_id, void* event_data)
+{
+    auto* self = static_cast<WifiConfigurationAp*>(arg);
+    if (event_id == WIFI_EVENT_STA_CONNECTED) {
+        xEventGroupSetBits(self->event_group_, WIFI_CONNECTED_BIT);
+    } else if (event_id == WIFI_EVENT_STA_DISCONNECTED) {
+        xEventGroupSetBits(self->event_group_, WIFI_FAIL_BIT);
+    } else if (event_id == WIFI_EVENT_SCAN_DONE) {
+        std::lock_guard<std::mutex> lock(self->mutex_);
+        uint16_t found = 0;
+        esp_wifi_scan_get_ap_num(&found);
+        uint16_t keep = found > kMaxScan ? kMaxScan : found;  // the driver frees the rest
+        self->ap_records_.resize(keep);
+        esp_wifi_scan_get_ap_records(&keep, self->ap_records_.data());
+        self->ap_records_.resize(keep);
+        if (self->scan_timer_) {
+            esp_timer_start_once(self->scan_timer_, 10 * 1000000);
+        }
+    }
+}
+
+void WifiConfigurationAp::IpEventHandler(void* arg, esp_event_base_t event_base, int32_t event_id, void* event_data)
+{
+    auto* self = static_cast<WifiConfigurationAp*>(arg);
+    if (event_id == IP_EVENT_STA_GOT_IP) {
+        xEventGroupSetBits(self->event_group_, WIFI_CONNECTED_BIT);
+    }
+}
+
+// Ends setup and gives the memory back: timers, web server, DNS responder, scan list and the code.
+void WifiConfigurationAp::Stop()
+{
+    if (scan_timer_) {
+        esp_timer_stop(scan_timer_);
+        esp_timer_delete(scan_timer_);
+        scan_timer_ = nullptr;
+    }
+    if (server_) {
+        httpd_stop(server_);
+        server_ = nullptr;
+    }
+    if (dns_server_) {
+        dns_server_->Stop();
+        dns_server_.reset();
+    }
+    if (instance_any_id_) {
+        esp_event_handler_instance_unregister(WIFI_EVENT, ESP_EVENT_ANY_ID, instance_any_id_);
+        instance_any_id_ = nullptr;
+    }
+    if (instance_got_ip_) {
+        esp_event_handler_instance_unregister(IP_EVENT, IP_EVENT_STA_GOT_IP, instance_got_ip_);
+        instance_got_ip_ = nullptr;
+    }
+    esp_wifi_stop();
+    if (ap_netif_) {
+        esp_netif_destroy_default_wifi(ap_netif_);
+        ap_netif_ = nullptr;
+    }
+    {
+        std::lock_guard<std::mutex> lock(mutex_);
+        std::vector<wifi_ap_record_t>().swap(ap_records_);
+    }
+    ESP_LOGI(TAG, "Setup portal closed");
+}
