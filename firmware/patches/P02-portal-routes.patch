+void WifiConfigurationAp::Start()
+{
+    s_lang = mp_lang_from_code(language_.c_str());
+
+    ESP_ERROR_CHECK(esp_event_handler_instance_register(WIFI_EVENT, ESP_EVENT_ANY_ID,
+                                                        &WifiConfigurationAp::WifiEventHandler, this,
+                                                        &instance_any_id_));
+    ESP_ERROR_CHECK(esp_event_handler_instance_register(IP_EVENT, IP_EVENT_STA_GOT_IP,
+                                                        &WifiConfigurationAp::IpEventHandler, this,
+                                                        &instance_got_ip_));
+
+    StartAccessPoint();
+    StartWebServer();
+
+    esp_wifi_scan_start(nullptr, false);
+    esp_timer_create_args_t scan_args = {
+        .callback = [](void* arg) {
+            auto* self = static_cast<WifiConfigurationAp*>(arg);
+            if (!self->is_connecting_) {
+                esp_wifi_scan_start(nullptr, false);
+            }
+        },
+        .arg = this,
+        .dispatch_method = ESP_TIMER_TASK,
+        .name = "wifi_scan_timer",
+        .skip_unhandled_events = false,
+    };
+    ESP_ERROR_CHECK(esp_timer_create(&scan_args, &scan_timer_));
+}
