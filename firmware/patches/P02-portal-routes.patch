+function(maipai_portal_swap)
+    idf_component_get_property(wifi_lib 78__esp-wifi-connect COMPONENT_LIB)
+    if(NOT wifi_lib)
+        return()
+    endif()
+    get_target_property(srcs ${wifi_lib} SOURCES)
+    list(FILTER srcs EXCLUDE REGEX "wifi_configuration_ap\\.cc$")
+    list(FILTER srcs EXCLUDE REGEX "wifi_configuration(_done)?\\.html")
+    list(APPEND srcs "${maipai_portal_dir}/maipai_wifi_configuration_ap.cc")
+    set_property(TARGET ${wifi_lib} PROPERTY SOURCES ${srcs})
+endfunction()
+
+cmake_language(DEFER DIRECTORY "${CMAKE_SOURCE_DIR}" CALL maipai_portal_swap)
