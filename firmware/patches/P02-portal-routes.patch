# Intent: Replace the setup component's access point source file (24 handlers, a 78 KB page, saved-network and advanced routes) with firmware/portal/maipai_wifi_configuration_ap.cc, without forking the component: firmware/portal/portal.cmake (one include line in firmware/CMakeLists.txt) swaps the one source in the component's build target, deferred until project() has made it, so managed_components stays pristine and its checksums and dependencies.lock still match. Four handlers: GET / (page with the string table of the unit's language swapped in), GET /scan (nearby networks only, strongest first, never saved ones), POST /submit (network, password, optional host address; joins first and saves only what worked; the host address is stored as the voice URL), GET on any other path (302 to the page, which covers the phone and PC captive-check addresses). Stop frees the server, DNS responder, timers and scan list.
# Placement: unit (the robot's own setup access point and web server)
# Upstream: firmware/managed_components/78__esp-wifi-connect/wifi_configuration_ap.cc (MIT) is the file replaced; the join retry rule is kept from it
# Check after a flash: none until P05 turns it on
diff --git a/firmware/CMakeLists.txt b/firmware/CMakeLists.txt
--- a/firmware/CMakeLists.txt
+++ b/firmware/CMakeLists.txt
@@ -13,6 +13,9 @@ add_definitions(-DFIRMWARE_VERSION=\"${PROJECT_VER}\")
 # Add this line to disable the specific warning
 add_compile_options(-Wno-missing-field-initializers)
 
+# MaiPai Wi-Fi portal (patch P02): see portal/portal.cmake.
+include("${CMAKE_CURRENT_LIST_DIR}/portal/portal.cmake")
+
 # Auto-load a local sdkconfig overlay (git-ignored) when present. Lets
 # self-hosted / custom deployments pin CONFIG_STACKCHAN_SERVER_URL,
 # CONFIG_OTA_URL, etc. without touching committed defaults.
diff --git a/firmware/portal/maipai_wifi_configuration_ap.cc b/firmware/portal/maipai_wifi_configuration_ap.cc
new file mode 100644
--- /dev/null
+++ b/firmware/portal/maipai_wifi_configuration_ap.cc
@@ -0,0 +1,529 @@
+/*
+ * SPDX-License-Identifier: MIT
+ *
+ * The StackChan Wi-Fi setup portal (patches P02 to P04). It replaces the setup component's access point source
+ * file at build time (portal/portal.cmake, patch P02); the component itself stays untouched in
+ * managed_components, so its checksums and the lock file still match. Logic that needs no ESP-IDF is in
+ * maipai_portal_core.h; the page is in maipai_portal_page.h.
+ *
+ * Routes (4 handlers): GET / (the page), GET /scan (nearby networks, strongest first), POST /submit (code, network,
+ * password, optional host address), GET on any other address (including the phone and PC "is the internet
+ * there" probes) redirects to the page. Nothing here lists saved networks.
+ */
+#include "wifi_configuration_ap.h"
+#include <atomic>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <memory>
+#include <vector>
+#include <freertos/FreeRTOS.h>
+#include <freertos/event_groups.h>
+#include <esp_err.h>
+#include <esp_event.h>
+#include <esp_wifi.h>
+#include <esp_log.h>
+#include <esp_mac.h>
+#include <esp_netif.h>
+#include <esp_random.h>
+#include <lwip/ip_addr.h>
+#include <nvs.h>
+#include <nvs_flash.h>
+#include <cJSON.h>
+#include "ssid_manager.h"
+#include "sdkconfig.h"
+#include "maipai_portal_core.h"
+#include "maipai_portal_page.h"
+
+#define TAG "MaiPaiPortal"
+
+#define WIFI_CONNECTED_BIT BIT0
+#define WIFI_FAIL_BIT      BIT1
+
+namespace {
+int s_lang = MP_LANG_EN;
+
+constexpr const char* kPortalUrl = "http://192.168.4.1/";
+constexpr size_t kMaxBody = 640;
+constexpr int kMaxScan = 24;
+
+void set_common_headers(httpd_req_t* req)
+{
+    httpd_resp_set_hdr(req, "Connection", "close");
+    httpd_resp_set_hdr(req, "Cache-Control", "no-store");
+    httpd_resp_set_hdr(req, "Referrer-Policy", "no-referrer");
+    httpd_resp_set_hdr(req, "X-Frame-Options", "DENY");
+}
+
+void send_json_status(httpd_req_t* req, bool ok, int error_slot)
+{
+    char buf[40];
+    if (ok) {
+        snprintf(buf, sizeof(buf), "{\"ok\":true}");
+    } else {
+        snprintf(buf, sizeof(buf), "{\"ok\":false,\"e\":%d}", error_slot);
+    }
+    httpd_resp_set_type(req, "application/json");
+    set_common_headers(req);
+    httpd_resp_send(req, buf, HTTPD_RESP_USE_STRLEN);
+}
+
+// Leaves setup from a task: stopping the web server from inside one of its own handlers would wait on itself.
+void request_exit_later(WifiConfigurationAp* self, void (*call)(WifiConfigurationAp*), uint32_t delay_ms)
+{
+    struct Job {
+        WifiConfigurationAp* self;
+        void (*call)(WifiConfigurationAp*);
+        uint32_t delay_ms;
+    };
+    auto* job = new Job{self, call, delay_ms};
+    if (xTaskCreate(
+            [](void* arg) {
+                auto* j = static_cast<Job*>(arg);
+                vTaskDelay(pdMS_TO_TICKS(j->delay_ms));
+                j->call(j->self);
+                delete j;
+                vTaskDelete(NULL);
+            },
+            "portal_exit", 4096, job, 5, NULL) != pdPASS) {
+        delete job;
+    }
+}
+}  // namespace
