+// Patch LK02: locked, the face sleeps (the same look as full quiet, drawn dimmed by the lock screen's padlock); unlocked, it wakes.
+void StackChanAvatarDisplay::ApplyLockFace(bool locked)
+{
+    auto& stackchan = GetStackChan();
+    if (!stackchan.hasAvatar() || lock_face_ == locked) {
+        return;
+    }
+    DisplayLockGuard lock(this);
+    lock_face_ = locked;
+    if (locked) {
+        SetEmotion("sleeping");
+    } else if (!quiet_face_) {
+        is_sleeping_ = false;
+        SetEmotion("neutral");
+        if (hal_bridge::is_xiaozhi_idle() && idle_expression_modifier_id_ < 0) {
+            idle_expression_modifier_id_ = stackchan.addModifier(std::make_unique<IdleExpressionModifier>());
+        }
+    }
+}
+
+void hal_bridge::lock_face(bool locked)
+{
+    auto display = static_cast<StackChanAvatarDisplay*>(Board::GetInstance().GetDisplay());
+    if (display != nullptr) {
+        display->ApplyLockFace(locked);
+    }
+}
