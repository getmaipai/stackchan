     }
 }
 
+#if CONFIG_MAIPAI_GAMES_BENCH
+// Patch SF75 (bench only): one sample per game tick while recording. t is the time since the recording began; act the tweens running; fall_y the highest falling disc's top (-1 none);
+// flip_w the narrowest flipping card in permille (1000 none); flags bit 0 the unit is thinking, 1 a result is pending, 2 pulses running, 3 the win is lit, 4 the board shakes.
+struct Sample { uint16_t t; uint8_t act; uint8_t flags; int16_t fall_y; int16_t flip_w; };
+constexpr int kSamples = 160;  // 4.8 s of 30 ms ticks
+Sample s_samples[kSamples];
+int s_sample_n = 0;
+bool s_recording = false;
+uint32_t s_rec_t0 = 0;
+
+void record(Grid* g, uint32_t now)
+{
+    if (!s_recording || s_sample_n >= kSamples) return;
+    Sample& s = s_samples[s_sample_n++];
+    s.t = static_cast<uint16_t>(now - s_rec_t0);
+    int act = 0;
+    for (int i = 0; i < GAN_MAX; i++) act += g->anim.t[i].kind != GAN_NONE;
+    s.act = static_cast<uint8_t>(act);
+    int fall_y = -1, flip_w = 1000;
+    const int cells = g->kind == kC4 ? GC4_CELLS : (g->kind == kMatch ? g->mem.n : 0);
+    for (int i = 0; i < cells; i++) {
+        const int y = gan_fall_y(&g->anim, i, now);
+        if (y >= 0 && (fall_y < 0 || y < fall_y)) fall_y = y;
+        const int w = gan_flip_width(&g->anim, i, now);
+        if (w < flip_w) flip_w = w;
+    }
+    s.fall_y = static_cast<int16_t>(fall_y);
+    s.flip_w = static_cast<int16_t>(flip_w);
+    s.flags = static_cast<uint8_t>((g->unit_thinking ? 1 : 0) | (g->result_pending != GR_PLAYING ? 2 : 0) | (g->flash_left > 0 ? 4 : 0) | (g->win_lit ? 8 : 0) | (g->anim.shaking ? 16 : 0));
+}
+#else
+inline void record(Grid*, uint32_t) {}
+#endif
+
 void tick_cb(lv_timer_t*)
 {
     Grid* g = s_grid;
@@ -517,6 +552,7 @@ void tick_cb(lv_timer_t*)
         return;
     }
     const uint32_t now = now_ms();
+    record(g, now);
     if (now - g->last_input_ms >= kIdleMs) {
         end_locked("idle");
         return;
@@ -724,4 +760,42 @@ const char* maipai_grid_scores_json(const char* id)
     else snprintf(out, sizeof(out), "[]");
     return out;
 }
+
+#if CONFIG_MAIPAI_GAMES_BENCH
+bool maipai_grid_bench_touch(int x, int y)
+{
+    if (s_grid == nullptr) return false;
+    maipai_grid_touch(x, y);
+    return true;
+}
+
+void maipai_grid_register_bench_tools()
+{
+    auto& mcp = McpServer::GetInstance();
+    mcp.AddTool("self.game.bench_record", "Bench only: starts (on 1) or stops (on 0) recording one sample per 30 ms game tick of the running grid game (up to 4.8 s), so an animation can be read afterwards. "
+                "Starting clears the samples. Answers {ok}.", PropertyList({Property("on", kPropertyTypeInteger, 1, 0, 1)}), [](const PropertyList& properties) -> ReturnValue {
+                    LvglLockGuard lock;
+                    s_recording = properties["on"].value<int>() != 0;
+                    if (s_recording) { s_sample_n = 0; s_rec_t0 = now_ms(); }
+                    return std::string("{\"ok\":true}");
+                });
+    mcp.AddTool("self.game.bench_frames", "Bench only: the samples recorded since self.game.bench_record, one row per game tick: [t_ms, tweens running, top of the highest falling disc (-1 none), "
+                "narrowest flipping card in permille (1000 none), flags (1 the unit thinks, 2 result pending, 4 pulses, 8 win lit, 16 shake)]. Answers {ok, n, rows, gaps_ms} where gaps_ms "
+                "is the biggest gap between two ticks.", std::vector<Property>{}, [](const PropertyList&) -> ReturnValue {
+                    LvglLockGuard lock;
+                    std::string rows = "[";
+                    int worst = 0;
+                    for (int i = 0; i < s_sample_n; i++) {
+                        char b[60];
+                        snprintf(b, sizeof(b), "%s[%u,%u,%d,%d,%u]", i ? "," : "", s_samples[i].t, s_samples[i].act, s_samples[i].fall_y, s_samples[i].flip_w, s_samples[i].flags);
+                        rows += b;
+                        if (i > 0 && s_samples[i].t - s_samples[i - 1].t > worst) worst = s_samples[i].t - s_samples[i - 1].t;
+                    }
+                    rows += "]";
+                    char head[80];
+                    snprintf(head, sizeof(head), "{\"ok\":true,\"n\":%d,\"gaps_ms\":%d,\"rows\":", s_sample_n, worst);
+                    return std::string(head) + rows + "}";
+                });
+}
 #endif
+#endif
