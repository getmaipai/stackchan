@@ -29,6 +29,12 @@ const char* maipai_grid_id(int index);
 const char* maipai_grid_title(int index, bool es);
 int maipai_grid_best(int index);
 bool maipai_grid_lower_is_better(int index);
+#if CONFIG_MAIPAI_GAMES_BENCH
+// Patch SF75 (bench only): a frame recorder for the grid games' animations, because a serial snapshot takes seconds and an animation lasts hundreds of milliseconds. Records one sample per
+// 30 ms game tick in memory; the frames are read afterwards. Registers self.game.bench_record and self.game.bench_frames.
+void maipai_grid_register_bench_tools();
+bool maipai_grid_bench_touch(int x, int y);  // a tap for self.game.bench_tap: true when a grid game took it
+#endif
 // {"scores":[...]} content for one game id: "[]" or "[n]".
 const char* maipai_grid_scores_json(const char* id);
 #else
@@ -45,4 +51,6 @@ inline const char* maipai_grid_title(int, bool) { return ""; }
 inline int maipai_grid_best(int) { return 0; }
 inline bool maipai_grid_lower_is_better(int) { return false; }
 inline const char* maipai_grid_scores_json(const char*) { return "[]"; }
+inline void maipai_grid_register_bench_tools() {}
+inline bool maipai_grid_bench_touch(int, int) { return false; }
 #endif
