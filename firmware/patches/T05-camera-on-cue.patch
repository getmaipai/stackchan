+// ---- the camera-on cue (patch T05) ----
+// A rounded outline with a filled lens, top right, on the top layer so it shows over the face and the clock alike.
+static std::mutex s_cue_mutex;
+static mc_cue_t s_cue;
+static lv_obj_t* s_cue_glyph = nullptr;
+static lv_timer_t* s_cue_timer = nullptr;
+
+static void cue_build()
+{
+    lv_color_t colour = lv_color_white();
+    if (auto* face = dynamic_cast<DefaultAvatar*>(&GetStackChan().avatar())) {
+        colour = face->primaryColor;
+    }
+    s_cue_glyph = lv_obj_create(lv_layer_top());
+    lv_obj_remove_style_all(s_cue_glyph);
+    lv_obj_remove_flag(s_cue_glyph, LV_OBJ_FLAG_SCROLLABLE);
+    lv_obj_remove_flag(s_cue_glyph, LV_OBJ_FLAG_CLICKABLE);
+    lv_obj_set_size(s_cue_glyph, 26, 20);
+    lv_obj_align(s_cue_glyph, LV_ALIGN_TOP_RIGHT, -8, 8);
+    lv_obj_set_style_radius(s_cue_glyph, 5, 0);
+    lv_obj_set_style_border_width(s_cue_glyph, 2, 0);
+    lv_obj_set_style_border_color(s_cue_glyph, colour, 0);
+    lv_obj_set_style_bg_opa(s_cue_glyph, LV_OPA_TRANSP, 0);
+    lv_obj_t* lens = lv_obj_create(s_cue_glyph);
+    lv_obj_remove_style_all(lens);
+    lv_obj_remove_flag(lens, LV_OBJ_FLAG_CLICKABLE);
+    lv_obj_set_size(lens, 8, 8);
+    lv_obj_center(lens);
+    lv_obj_set_style_radius(lens, LV_RADIUS_CIRCLE, 0);
+    lv_obj_set_style_bg_opa(lens, LV_OPA_COVER, 0);
+    lv_obj_set_style_bg_color(lens, colour, 0);
+}
+
+void hal_bridge::monitor_cue_begin(int hold_ms)
+{
+    auto display = static_cast<StackChanAvatarDisplay*>(Board::GetInstance().GetDisplay());
+    if (display == nullptr || !GetStackChan().hasAvatar()) {
+        return;
+    }
+    bool draw = false;
+    {
+        std::lock_guard<std::mutex> lock(s_cue_mutex);
+        draw = mc_begin(&s_cue, static_cast<uint32_t>(esp_timer_get_time() / 1000), hold_ms > 0 ? hold_ms : MC_HOLD_PHOTO_MS) != 0;
+    }
+    if (!draw) {
+        return;  // already showing: the hold was extended, no drawing
+    }
+    display->LvglLock();
+    if (s_cue_glyph == nullptr) {
+        cue_build();
+    }
+    lv_obj_remove_flag(s_cue_glyph, LV_OBJ_FLAG_HIDDEN);
+    if (s_cue_timer == nullptr) {
+        s_cue_timer = lv_timer_create(
+            [](lv_timer_t* timer) {
+                bool hide = false;
+                {
+                    std::lock_guard<std::mutex> lock(s_cue_mutex);
+                    hide = mc_poll(&s_cue, static_cast<uint32_t>(esp_timer_get_time() / 1000)) != 0;
+                }
+                if (hide) {
+                    lv_obj_add_flag(s_cue_glyph, LV_OBJ_FLAG_HIDDEN);
+                    lv_timer_pause(timer);
+                }
+            },
+            250, nullptr);
+    } else {
+        lv_timer_resume(s_cue_timer);
+    }
+    display->LvglUnlock();
+}
