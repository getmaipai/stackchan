diff --git a/firmware/main/hal/maipai_cue_core.h b/firmware/main/hal/maipai_cue_core.h
new file mode 100644
--- /dev/null
+++ b/firmware/main/hal/maipai_cue_core.h
@@ -0,0 +1,45 @@
+/*
+ * SPDX-License-Identifier: MIT
+ *
+ * The pure logic of the camera-on cue (patch T05). Whenever a picture is taken or video frames are read, a small
+ * camera glyph shows on the face and stays for a while after the last frame, so a quick photo is still seen.
+ * No setting, tool or host command turns the cue off: the only thing that hides it is time. Vision off never
+ * reaches it because no picture is taken then. Times are milliseconds on any steady clock; the arithmetic is wrap
+ * safe. Plain C99, no hardware: compiled by a host test.
+ */
+#pragma once
+#include <stdint.h>
+#include <string.h>
+
+#define MC_HOLD_PHOTO_MS 3000u
+#define MC_HOLD_STREAM_MS 2500u
+
+typedef struct {
+    uint32_t until_ms;
+    uint8_t shown;
+} mc_cue_t;
+
+static inline void mc_init(mc_cue_t* c) { memset(c, 0, sizeof(*c)); }
+
+/* A picture or a frame is being read. Returns 1 when the glyph must be drawn now (it was hidden). The hold only
+ * ever grows: a later short hold never cuts an earlier long one. */
+static inline int mc_begin(mc_cue_t* c, uint32_t now_ms, uint32_t hold_ms)
+{
+    const uint32_t until = now_ms + hold_ms;
+    if (!c->shown || (int32_t)(until - c->until_ms) > 0) {
+        c->until_ms = until;
+    }
+    const int draw = !c->shown;
+    c->shown = 1;
+    return draw;
+}
+
+/* Poll while shown. Returns 1 when the hold has run out and the glyph must be hidden now. */
+static inline int mc_poll(mc_cue_t* c, uint32_t now_ms)
+{
+    if (c->shown && (int32_t)(now_ms - c->until_ms) >= 0) {
+        c->shown = 0;
+        return 1;
+    }
+    return 0;
+}
