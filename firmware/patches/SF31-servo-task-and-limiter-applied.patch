+// Patch SF31: servo stepping at a fixed 20 ms, independent of the screen lock. The servo layer has its own lock (patch SF08).
+static TaskHandle_t s_servo_task = nullptr;
+static void _servo_step_task(void*)
+{
+    TickType_t last = xTaskGetTickCount();
+    while (1) {
+        vTaskDelayUntil(&last, pdMS_TO_TICKS(20));
+        GetStackChan().updateBody();
+    }
+}
+#if CONFIG_MAIPAI_SERIAL_TOOLS
+unsigned maipai_servo_task_stack_min() { return s_servo_task != nullptr ? static_cast<unsigned>(uxTaskGetStackHighWaterMark(s_servo_task)) : 0u; }
