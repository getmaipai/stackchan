diff --git a/firmware/main/hal/maipai_banner.cc b/firmware/main/hal/maipai_banner.cc
--- a/firmware/main/hal/maipai_banner.cc
+++ b/firmware/main/hal/maipai_banner.cc
@@ -27,6 +27,7 @@
 namespace {
 
 std::mutex s_mu;
+bool s_wifi_screen = false;  // patch WF01: a Wi-Fi screen is up (connecting, setup, the Wi-Fi page); mu held
 mb_t* s_b = nullptr;
 lv_obj_t* s_row = nullptr;    // the one rectangle (the background)
 bool s_chip_row = false;      // patch UI10: the row is filled violet as a whole while the remote chip shows
@@ -326,7 +327,9 @@ void render()
     int icon = 0, prio = 0;
     const int kind = mb_content(s_b, &text, &icon, &prio);
     uint32_t strip = mb_strip_visible(s_b);
-    if (icon == MB_ICON_WIFI_OFF) strip &= ~(1u << MB_FLAG_WIFI);  // the message already shows that glyph
+    // Patch WF01: a Wi-Fi glyph is never drawn where the screen or the message is already about Wi-Fi: the wifi-off and the bars message icons, and the
+    // connecting, setup, retry and Wi-Fi screens (which draw their own link icon).
+    if (icon == MB_ICON_WIFI_OFF || icon == MB_ICON_BARS || s_wifi_screen) strip &= ~(1u << MB_FLAG_WIFI);
     if (icon == MB_ICON_BATTERY) strip &= ~(1u << MB_FLAG_BATTERY);
     const lv_color_t fg = fg_color();
     if (kind != 0 && s_row != nullptr) {  // with nothing to say the old content stays while the row fades out
@@ -585,6 +588,14 @@ void maipai_banner_status(int kind, bool spanish)
     maipai_banner_post(mst_text(kind, spanish ? 1 : 0), mst_icon(kind), MB_PRIO_PRIVACY, MB_TAG_STATUS, mst_hold_ms(kind));
 }
 
+void maipai_banner_wifi_screen(bool on)
+{
+    std::lock_guard<std::mutex> lock(s_mu);
+    if (s_wifi_screen == on) return;
+    s_wifi_screen = on;
+    s_b->rev++;  // the next tick draws the strip again without (or with) the Wi-Fi glyph
+}
