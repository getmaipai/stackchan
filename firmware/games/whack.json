     -1
    ]
   ]
  },
  {
   "state": "intro",
   "on": "timer",
   "go": "down"
  },
  {
   "state": "intro",
   "on": "tap",
   "go": "down"
  },
  {
   "state": "down",
   "on": "enter",
   "go": "stay",
   "do": [
    [
     "set",
     "cell",
     -1
    ]
   ]
  },
  {
   "state": "down",
   "on": "timer",
   "if": [
    "ctr_ge",
    "moles",
    15
   ],
   "go": "over"
  },
  {
   "state": "down",
   "on": "timer",
   "go": "up",
   "do": [
    [
     "rand",
     "cell",
     9
    ],
    [
     "add",
     "moles",
     1
    ]
   ]
  },
  {
   "state": "up",
   "on": "tap",
   "region": "any_region",
   "if": [
    "reg_eq_ctr",
    "cell"
   ],
   "go": "down",
   "do": [
    [
     "add",
     "score",
     1
    ],
    [
     "tone",
     "popup"
    ]
   ]
  },
  {
   "state": "up",
   "on": "timer",
   "go": "down"
  },
  {
   "state": "over",
   "on": "enter",
   "go": "stay",
   "do": [
    [
     "tone",
     "success"
    ],
    [
     "save"
    ]
   ]
  },
  {
   "state": "over",
   "on": "timer",
   "go": "end"
  },
